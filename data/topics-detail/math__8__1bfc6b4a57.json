[{"id":"cnm_156","description":"形如 A/B（A、B 为整式且 B 含字母）的式子叫分式，分母不为 0 时分式有意义，分子为 0 且分母不为 0 时值为 0。","mastery_criteria":["能判断分式","会求分式有意义与值为 0 的条件"],"diagnostic_question":{"question":"x 取何值时 1/(x-2) 有意义？","answer":"x≠2"},"standards":[{"id":"cms-2022:4.NA.21","confidence":"exact"}]},{"id":"cnm_157","description":"分式的分子分母同乘（除以）同一个不为 0 的整式，分式值不变。","mastery_criteria":["能叙述性质","能做符号变形"],"diagnostic_question":{"question":"把 -a/(-b) 化简。","answer":"a/b"},"standards":[{"id":"cms-2022:4.NA.21","confidence":"exact"}]},{"id":"cnm_158","description":"把分子分母的公因式约去，化为最简分式，必要时先因式分解。","mastery_criteria":["能找出公因式并约分","结果为最简分式"],"diagnostic_question":{"question":"约分 (x²-1)/(x²+x)。","answer":"(x-1)/x"},"standards":[{"id":"cms-2022:4.NA.21","confidence":"exact"}]},{"id":"cnm_159","description":"把异分母分式化为同分母分式，需要确定最简公分母。","mastery_criteria":["能找最简公分母","能完成通分"],"diagnostic_question":{"question":"把 1/x 与 1/(x+1) 通分。","answer":"(x+1)/[x(x+1)]，x/[x(x+1)]"},"standards":[{"id":"cms-2022:4.NA.21","confidence":"exact"}]}]
