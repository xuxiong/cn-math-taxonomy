[{"id":"cnm_022_q1","topicId":"cnm_022","difficulty":"basic","type":"choice","prompt":"把 3 450 000 用科学记数法表示。（选择正确的一项）","choices":[{"key":"A","text":"3.45×10^5"},{"key":"B","text":"34.5×10^5"},{"key":"C","text":"3.45×10^6"},{"key":"D","text":"0.345×10^7"}],"answer":"C","explanation":"科学记数法 a×10^n 要求 1≤|a|<10。3 450 000 小数点向左移 6 位得 3.45，所以是 3.45×10^6。"},{"id":"cnm_022_q2","topicId":"cnm_022","difficulty":"basic","type":"numeric","prompt":"把 8 600 000 用科学记数法写成 a×10^n（1≤a<10）的形式，则 n 等于多少？","answer":"6","explanation":"8 600 000=8.6×10^6，所以 n=6。","verify":"floor(log10(8600000))"},{"id":"cnm_022_q3","topicId":"cnm_022","difficulty":"standard","type":"numeric","prompt":"把科学记数法 5.2×10^4 还原成原数。","answer":"52000","explanation":"5.2×10^4=5.2×10000=52000。","verify":"Fraction(52,10)*10**4"},{"id":"cnm_022_q4","topicId":"cnm_022","difficulty":"standard","type":"choice","prompt":"地球到太阳的平均距离约为 150 000 000 km，用科学记数法表示为哪一个？","choices":[{"key":"A","text":"15×10^7 km"},{"key":"B","text":"1.5×10^8 km"},{"key":"C","text":"1.5×10^7 km"},{"key":"D","text":"0.15×10^9 km"}],"answer":"B","explanation":"150 000 000 小数点向左移 8 位得 1.5，所以是 1.5×10^8；15×10^7 与 0.15×10^9 的系数不在 1 到 10 之间。"},{"id":"cnm_022_q5","topicId":"cnm_022","difficulty":"advanced","type":"numeric","prompt":"把 -720 000 000 写成 a×10^n（1≤|a|<10）的形式，求 a+n 的值。","answer":"0.8","explanation":"-720 000 000=-7.2×10^8，所以 a=-7.2，n=8，a+n=0.8。","verify":"Fraction(-72,10)+8"}]
