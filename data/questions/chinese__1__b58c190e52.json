[{"id":"cnc_p048_q1","topicId":"cnc_p048","difficulty":"basic","type":"choice","prompt":"《热爱中国共产党》主要表达什么？","choices":[{"key":"A","text":"怎样包粽子"},{"key":"B","text":"对中国共产党的热爱"},{"key":"C","text":"小壁虎向谁借尾巴"},{"key":"D","text":"荷叶像摇篮"}],"answer":"B","explanation":"题目和课文都在说热爱中国共产党，不是包粽子或借尾巴。","verify":"\"对中国共产党的热爱\""},{"id":"cnc_p048_q2","topicId":"cnc_p048","difficulty":"basic","type":"choice","prompt":"哪一句和这篇课文要说的意思一致？","choices":[{"key":"A","text":"我们不要认识中国共产党"},{"key":"B","text":"这篇是在写小鸭子游泳"},{"key":"C","text":"我们热爱中国共产党"},{"key":"D","text":"这篇是一首写月亮的古诗"}],"answer":"C","explanation":"课文要表达的是热爱。写小鸭子的是《小公鸡和小鸭子》，写月亮的是《静夜思》。","verify":"\"我们热爱中国共产党\""},{"id":"cnc_p048_q3","topicId":"cnc_p048","difficulty":"standard","type":"choice","prompt":"它和《吃水不忘挖井人》哪一点不同？","choices":[{"key":"A","text":"两篇都在写荷叶和蜻蜓"},{"key":"B","text":"两篇都是骆宾王的《咏鹅》"},{"key":"C","text":"两篇都只写操场上的游戏"},{"key":"D","text":"这篇表达对党的热爱；那篇写沙洲坝的井和石碑"}],"answer":"D","explanation":"《吃水不忘挖井人》写的是井和石碑上的话。这一篇的题目就是热爱中国共产党。","verify":"\"这篇表达对党的热爱；那篇写沙洲坝的井和石碑\""},{"id":"cnc_p048_q4","topicId":"cnc_p048","difficulty":"standard","type":"choice","prompt":"下面哪一种理解不对？","choices":[{"key":"A","text":"课文是让读者讨厌中国共产党"},{"key":"B","text":"课文表达的是热爱"},{"key":"C","text":"从题目就能看出写的是热爱"},{"key":"D","text":"它和《吃水不忘挖井人》不是同一篇"}],"answer":"A","explanation":"课文的意思是热爱，不是讨厌。另外三种说法都和课文一致。","verify":"\"课文是让读者讨厌中国共产党\""},{"id":"cnc_p049_q1","topicId":"cnc_p049","difficulty":"basic","type":"choice","prompt":"这口井在什么地方？","choices":[{"key":"A","text":"北京的学校"},{"key":"B","text":"江南的荷塘"},{"key":"C","text":"瑞金城外的沙洲坝"},{"key":"D","text":"井里没有村子"}],"answer":"C","explanation":"课文写瑞金城外有个村子叫沙洲坝，井就挖在那里。","verify":"\"瑞金城外的沙洲坝\""},{"id":"cnc_p049_q2","topicId":"cnc_p049","difficulty":"basic","type":"choice","prompt":"是谁带领乡亲们挖井的？","choices":[{"key":"A","text":"小公鸡"},{"key":"B","text":"诗人李白"},{"key":"C","text":"卖货的人"},{"key":"D","text":"毛主席"}],"answer":"D","explanation":"毛主席在沙洲坝领导革命时，带领乡亲们挖了一口井。","verify":"\"毛主席\""},{"id":"cnc_p049_q3","topicId":"cnc_p049","difficulty":"standard","type":"choice","prompt":"乡亲们在井旁立了石碑，上面刻着哪一句？","choices":[{"key":"A","text":"吃水不忘挖井人，时刻想念毛主席"},{"key":"B","text":"小时不识月，呼作白玉盘"},{"key":"C","text":"鹅，鹅，鹅，曲项向天歌"},{"key":"D","text":"弯弯的月儿小小的船"}],"answer":"A","explanation":"石碑上的话是吃水不忘挖井人，时刻想念毛主席。","verify":"\"吃水不忘挖井人，时刻想念毛主席\""},{"id":"cnc_p049_q4","topicId":"cnc_p049","difficulty":"standard","type":"choice","prompt":"乡亲们为什么不忘挖井的人？","choices":[{"key":"A","text":"因为井里长出了荷花"},{"key":"B","text":"因为喝到了清甜的井水"},{"key":"C","text":"因为井水是咸的"},{"key":"D","text":"因为他们把井填上了"}],"answer":"B","explanation":"乡亲们喝到了清甜的井水，所以记得带领大家挖井的人。","verify":"\"因为喝到了清甜的井水\""},{"id":"cnc_p050_q1","topicId":"cnc_p050","difficulty":"basic","type":"choice","prompt":"妈妈说，沿着弯弯的小路会走出哪里？","choices":[{"key":"A","text":"走出北京"},{"key":"B","text":"走出荷塘"},{"key":"C","text":"走出操场"},{"key":"D","text":"走出天山"}],"answer":"D","explanation":"妈妈说沿着弯弯的小路就会走出天山，远处是北京。","verify":"\"走出天山\""},{"id":"cnc_p050_q2","topicId":"cnc_p050","difficulty":"basic","type":"choice","prompt":"「我」想去北京看什么？","choices":[{"key":"A","text":"雄伟的天安门和升旗仪式"},{"key":"B","text":"天山的雪莲"},{"key":"C","text":"沙洲坝的水井"},{"key":"D","text":"池塘里的白莲"}],"answer":"A","explanation":"北京有雄伟的天安门，广场上的升旗仪式非常壮观。雪莲在天山，不在北京。","verify":"\"雄伟的天安门和升旗仪式\""},{"id":"cnc_p050_q3","topicId":"cnc_p050","difficulty":"standard","type":"choice","prompt":"爸爸说，沿着宽宽的公路走出北京，能看到什么？","choices":[{"key":"A","text":"天安门的升旗仪式"},{"key":"B","text":"遥远的天山雪莲"},{"key":"C","text":"端午节的粽子"},{"key":"D","text":"操场上的足球"}],"answer":"B","explanation":"走出北京，去的是遥远的天山，那里有洁白的雪莲。升旗在北京。","verify":"\"遥远的天山雪莲\""},{"id":"cnc_p050_q4","topicId":"cnc_p050","difficulty":"standard","type":"choice","prompt":"「我」对爸爸妈妈反复说的是哪一句？","choices":[{"key":"A","text":"我一点儿也不想看"},{"key":"B","text":"床前明月光"},{"key":"C","text":"我多想去看看"},{"key":"D","text":"小娃撑小艇"}],"answer":"C","explanation":"课文里「我」说了两次：我多想去看看。后两句是古诗，不是这篇课文的话。","verify":"\"我多想去看看\""},{"id":"cnc_p051_q1","topicId":"cnc_p051","difficulty":"basic","type":"choice","prompt":"「河水很清」该用哪个字？","choices":[{"key":"A","text":"清"},{"key":"B","text":"青"},{"key":"C","text":"请"},{"key":"D","text":"晴"}],"answer":"A","explanation":"清水的清是三点水。青草的青没有三点水，请是言字旁，晴是日字旁。","verify":"\"清\""},{"id":"cnc_p051_q2","topicId":"cnc_p051","difficulty":"basic","type":"choice","prompt":"「今天天气真晴朗」该用哪个字？","choices":[{"key":"A","text":"清"},{"key":"B","text":"晴"},{"key":"C","text":"请"},{"key":"D","text":"情"}],"answer":"B","explanation":"晴天和太阳有关，是日字旁。清是三点水，请是言字旁，情是竖心旁。","verify":"\"晴\""},{"id":"cnc_p051_q3","topicId":"cnc_p051","difficulty":"standard","type":"choice","prompt":"「请你进来」该用哪个字？","choices":[{"key":"A","text":"清"},{"key":"B","text":"晴"},{"key":"C","text":"请"},{"key":"D","text":"青"}],"answer":"C","explanation":"请别人做事，用言字旁的请。","verify":"\"请\""},{"id":"cnc_p051_q4","topicId":"cnc_p051","difficulty":"standard","type":"choice","prompt":"「心情很好」该用哪个字？","choices":[{"key":"A","text":"请"},{"key":"B","text":"晴"},{"key":"C","text":"清"},{"key":"D","text":"情"}],"answer":"D","explanation":"心情和心有关，是竖心旁的情。请是言字旁，晴是日字旁。","verify":"\"情\""}]
