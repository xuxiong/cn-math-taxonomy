[{"id":"cnm_h070_q1","topicId":"cnm_h070","difficulty":"basic","type":"numeric","prompt":"计算 sin60°cos30°−cos60°sin30°。已知 sin60°=cos30°=√3/2，cos60°=sin30°=1/2。","answer":"1/2","explanation":"(√3/2)·(√3/2)−(1/2)·(1/2)=3/4−1/4=1/2。这就是 sin30°。","verify":"Fraction(3,4)-Fraction(1,4)"},{"id":"cnm_h070_q2","topicId":"cnm_h070","difficulty":"basic","type":"numeric","prompt":"sin(90°−30°) 等于 cos 多少度？只写这个角度数。","answer":"30","explanation":"sin(90°−α)=cosα，这里 α=30°。","verify":"30"},{"id":"cnm_h070_q3","topicId":"cnm_h070","difficulty":"standard","type":"numeric","prompt":"计算 sin45°cos45°−cos45°sin45°。","answer":"0","explanation":"两项相同，差是 0。这也是 sin0°。","verify":"0"},{"id":"cnm_h070_q4","topicId":"cnm_h070","difficulty":"standard","type":"choice","prompt":"sin(α−β) 等于？","choices":[{"key":"A","text":"sinα cosβ + cosα sinβ"},{"key":"B","text":"cosα cosβ − sinα sinβ"},{"key":"C","text":"sinα cosβ − cosα sinβ"},{"key":"D","text":"sinα sinβ − cosα cosβ"}],"answer":"C","explanation":"差角的正弦是正弦余弦交叉相乘再相减。和角才是中间的加号。","verify":"\"sinα cosβ − cosα sinβ\""},{"id":"cnm_h071_q1","topicId":"cnm_h071","difficulty":"basic","type":"numeric","prompt":"计算 sin30°cos60°+cos30°sin60°。已知 sin30°=cos60°=1/2，cos30°=sin60°=√3/2。","answer":"1","explanation":"(1/2)·(1/2)+(√3/2)·(√3/2)=1/4+3/4=1。这就是 sin90°。","verify":"Fraction(1,4)+Fraction(3,4)"},{"id":"cnm_h071_q2","topicId":"cnm_h071","difficulty":"basic","type":"numeric","prompt":"计算 cos60°cos0°+sin60°sin0°。已知 cos0°=1，sin0°=0，cos60°=1/2。","answer":"1/2","explanation":"第二项是 0，第一项是 1/2。结果等于 cos60°。","verify":"Fraction(1,2)*1+0"},{"id":"cnm_h071_q3","topicId":"cnm_h071","difficulty":"standard","type":"numeric","prompt":"求 sin(45°+45°)。","answer":"1","explanation":"45°+45°=90°，sin90°=1。","verify":"1"},{"id":"cnm_h071_q4","topicId":"cnm_h071","difficulty":"standard","type":"choice","prompt":"sin(α+β) 等于？","choices":[{"key":"A","text":"sinα cosβ − cosα sinβ"},{"key":"B","text":"cosα cosβ − sinα sinβ"},{"key":"C","text":"cosα cosβ + sinα sinβ"},{"key":"D","text":"sinα cosβ + cosα sinβ"}],"answer":"D","explanation":"和角的正弦是两项都带正弦余弦、中间为加号。减号是差角公式。","verify":"\"sinα cosβ + cosα sinβ\""},{"id":"cnm_h072_q1","topicId":"cnm_h072","difficulty":"basic","type":"numeric","prompt":"计算 (tan45°−tan0°)/(1+tan45°·tan0°)。","answer":"1","explanation":"tan45°=1，tan0°=0，分子分母都是 1，结果是 1。这就是 tan45°。","verify":"(1-0)/(1+1*0)"},{"id":"cnm_h072_q2","topicId":"cnm_h072","difficulty":"basic","type":"numeric","prompt":"求 tan(45°−45°)。","answer":"0","explanation":"0° 的正切是 0。","verify":"0"},{"id":"cnm_h072_q3","topicId":"cnm_h072","difficulty":"standard","type":"numeric","prompt":"计算 1+tan45°·tan0°。","answer":"1","explanation":"tan0°=0，所以积是 0，和是 1。分母不为 0，公式可以用。","verify":"1+1*0"},{"id":"cnm_h072_q4","topicId":"cnm_h072","difficulty":"standard","type":"choice","prompt":"tan(α+β) 的公式在什么时候不能用？","choices":[{"key":"A","text":"分母 1−tanα tanβ 等于 0"},{"key":"B","text":"分子等于 0"},{"key":"C","text":"α 是锐角"},{"key":"D","text":"β=0°"}],"answer":"A","explanation":"分母为 0 时和角的正切没有定义，或公式不能直接除。","verify":"\"分母 1−tanα tanβ 等于 0\""},{"id":"cnm_h073_q1","topicId":"cnm_h073","difficulty":"basic","type":"numeric","prompt":"计算 2cos²60°−1。","answer":"-1/2","explanation":"cos60°=1/2，2×(1/2)²−1=1/2−1=−1/2。这就是 cos120°。","verify":"2*Fraction(1,2)**2-1"},{"id":"cnm_h073_q2","topicId":"cnm_h073","difficulty":"basic","type":"numeric","prompt":"计算 1−2sin²30°。","answer":"1/2","explanation":"sin30°=1/2，1−2×(1/4)=1/2。这就是 cos60°。","verify":"1-2*Fraction(1,2)**2"},{"id":"cnm_h073_q3","topicId":"cnm_h073","difficulty":"standard","type":"numeric","prompt":"求 cos(2×0°)。","answer":"1","explanation":"0° 的二倍仍是 0°，余弦是 1。","verify":"1"},{"id":"cnm_h073_q4","topicId":"cnm_h073","difficulty":"standard","type":"choice","prompt":"cos2α 不可以写成？","choices":[{"key":"A","text":"2cos²α−1"},{"key":"B","text":"2sinα cosα"},{"key":"C","text":"1−2sin²α"},{"key":"D","text":"cos²α−sin²α"}],"answer":"B","explanation":"2sinα cosα 是 sin2α，不是 cos2α。","verify":"\"2sinα cosα\""},{"id":"cnm_h074_q1","topicId":"cnm_h074","difficulty":"basic","type":"numeric","prompt":"计算 1+cos60°。","answer":"3/2","explanation":"cos60°=1/2，1+1/2=3/2。","verify":"1+cos(radians(60))"},{"id":"cnm_h074_q2","topicId":"cnm_h074","difficulty":"basic","type":"numeric","prompt":"计算 1−cos180°。","answer":"2","explanation":"cos180°=−1，1−(−1)=2。","verify":"1-cos(radians(180))"},{"id":"cnm_h074_q3","topicId":"cnm_h074","difficulty":"standard","type":"numeric","prompt":"计算 sin²0°+cos²0°。","answer":"1","explanation":"平方和恒为 1。","verify":"sin(radians(0))**2+cos(radians(0))**2"},{"id":"cnm_h074_q4","topicId":"cnm_h074","difficulty":"standard","type":"choice","prompt":"求值时如果出现 sin²α+cos²α，应先？","choices":[{"key":"A","text":"换成 0"},{"key":"B","text":"换成 2α"},{"key":"C","text":"换成 1"},{"key":"D","text":"换成 tanα"}],"answer":"C","explanation":"同角关系可以直接化简，不必再分别求正弦和余弦。","verify":"\"换成 1\""}]
