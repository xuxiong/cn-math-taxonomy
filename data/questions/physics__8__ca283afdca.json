[{"id":"cnp_036_q1","topicId":"cnp_036","difficulty":"basic","type":"choice","prompt":"压强的单位是什么？","choices":[{"key":"A","text":"帕斯卡（Pa）"},{"key":"B","text":"牛顿（N）"},{"key":"C","text":"千克（kg）"},{"key":"D","text":"焦耳（J）"}],"answer":"A","explanation":"压强的单位是帕斯卡，1 Pa = 1 N/m²。","verify":"\"帕斯卡（Pa）\""},{"id":"cnp_036_q2","topicId":"cnp_036","difficulty":"basic","type":"choice","prompt":"下列做法中，为了增大压强的是哪一个？","choices":[{"key":"A","text":"书包带做得较宽"},{"key":"B","text":"菜刀的刀刃磨得很薄"},{"key":"C","text":"铁轨下铺枕木"},{"key":"D","text":"坦克装有宽大的履带"}],"answer":"B","explanation":"压力一定时，减小受力面积可以增大压强；其余三项都是增大受力面积、减小压强。","verify":"\"菜刀的刀刃磨得很薄\""},{"id":"cnp_036_q3","topicId":"cnp_036","difficulty":"standard","type":"numeric","prompt":"一个重 600 N 的人双脚站在水平地面上，每只脚与地面的接触面积为 0.02 m²，他对地面的压强是多少 Pa？（只填数值）","answer":"15000","explanation":"受力面积 S = 2 × 0.02 = 0.04 m²，p = F/S = 600 ÷ 0.04 = 15000 Pa。只算一只脚会得到 30000 Pa。","verify":"600/(2*0.02)"},{"id":"cnp_036_q4","topicId":"cnp_036","difficulty":"advanced","type":"choice","prompt":"压力 50 N 作用在 100 cm² 的面积上，压强是多少？","choices":[{"key":"A","text":"5000 Pa"},{"key":"B","text":"0.5 Pa"},{"key":"C","text":"50 Pa"},{"key":"D","text":"5000 N"}],"answer":"A","explanation":"100 cm² = 0.01 m²，p = 50 ÷ 0.01 = 5000 Pa。不换算面积会算成 0.5 Pa。","verify":"50/0.01"}]
