[{"id":"cnp_076_q1","topicId":"cnp_076","difficulty":"basic","type":"numeric","prompt":"一台 100 W 的电视机每天待机和观看共 5 h，一个月（30 天）消耗多少 kW·h 的电能？（只填数值）","answer":"15","explanation":"W = Pt = 0.1 kW × 5 h × 30 = 15 kW·h。","verify":"0.1*5*30"},{"id":"cnp_076_q2","topicId":"cnp_076","difficulty":"basic","type":"choice","prompt":"下列做法中，有利于节约用电的是哪一个？","choices":[{"key":"A","text":"夏天空调温度调到 16 ℃"},{"key":"B","text":"用 LED 灯替换白炽灯"},{"key":"C","text":"电视长时间待机"},{"key":"D","text":"冰箱门经常打开"}],"answer":"B","explanation":"LED 灯发光效率高，相同亮度下功率小。","verify":"\"用 LED 灯替换白炽灯\""},{"id":"cnp_076_q3","topicId":"cnp_076","difficulty":"standard","type":"numeric","prompt":"把 40 W 的白炽灯换成亮度相当的 8 W LED 灯，每天用 5 h，每天可以节约多少 kW·h 的电能？（只填数值）","answer":"0.16","explanation":"节约 = (0.04 - 0.008) kW × 5 h = 0.16 kW·h。","verify":"(0.04-0.008)*5"},{"id":"cnp_076_q4","topicId":"cnp_076","difficulty":"standard","type":"choice","prompt":"从 W = Pt 看，节约用电可以从哪两方面入手？","choices":[{"key":"A","text":"增大功率和延长时间"},{"key":"B","text":"提高电压"},{"key":"C","text":"减小用电器功率和缩短用电时间"},{"key":"D","text":"增大电流"}],"answer":"C","explanation":"W = Pt，减小 P 或减小 t 都能减少消耗的电能。","verify":"\"减小用电器功率和缩短用电时间\""}]
