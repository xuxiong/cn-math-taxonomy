[{"id":"cnm_h224_q1","topicId":"cnm_h224","difficulty":"basic","type":"numeric","prompt":"f(x)=x²，f'(x)=2x。f'(−1) 等于多少？","answer":"-2","explanation":"−2<0，所以 x² 在 x=−1 附近是递减的。","verify":"2*(-1)"},{"id":"cnm_h224_q2","topicId":"cnm_h224","difficulty":"basic","type":"choice","prompt":"在一个开区间上恒有 f'(x)>0，函数在这个区间上怎样？","choices":[{"key":"A","text":"递减"},{"key":"B","text":"是常函数"},{"key":"C","text":"递增"},{"key":"D","text":"没有单调性"}],"answer":"C","explanation":"导数为正，函数值随自变量增大而增大。","verify":"\"递增\""},{"id":"cnm_h224_q3","topicId":"cnm_h224","difficulty":"standard","type":"numeric","prompt":"f'(x)=−2x。f'(3) 等于多少？","answer":"-6","explanation":"−6<0，函数在 x=3 附近递减。","verify":"-2*3"},{"id":"cnm_h224_q4","topicId":"cnm_h224","difficulty":"standard","type":"choice","prompt":"f'(x) 在区间上为负，函数图象从左到右怎样？","choices":[{"key":"A","text":"下降"},{"key":"B","text":"上升"},{"key":"C","text":"保持水平"},{"key":"D","text":"变成圆"}],"answer":"A","explanation":"导数为负对应递减，图象下降。","verify":"\"下降\""},{"id":"cnm_h225_q1","topicId":"cnm_h225","difficulty":"basic","type":"numeric","prompt":"f(x)=x²−4x。f'(x)=0 时，x 等于多少？","answer":"2","explanation":"f'(x)=2x−4=0，x=2。左边递减，右边递增。","verify":"2"},{"id":"cnm_h225_q2","topicId":"cnm_h225","difficulty":"basic","type":"numeric","prompt":"f(x)=x³−3x。f'(1) 等于多少？","answer":"0","explanation":"f'(x)=3x²−3=3(x²−1)，在 x=1 处是 0。","verify":"3*1*1-3"},{"id":"cnm_h225_q3","topicId":"cnm_h225","difficulty":"standard","type":"numeric","prompt":"f(x)=x³−3x。f'(2) 等于多少？","answer":"9","explanation":"3×4−3=9>0，所以在 x=2 附近递增。","verify":"3*4-3"},{"id":"cnm_h225_q4","topicId":"cnm_h225","difficulty":"standard","type":"choice","prompt":"f'(x)=2x−4。f'(x)>0 的解是？","choices":[{"key":"A","text":"x<2"},{"key":"B","text":"x>2"},{"key":"C","text":"x=2"},{"key":"D","text":"任意实数"}],"answer":"B","explanation":"2x−4>0，得 x>2，这就是递增区间。","verify":"\"x>2\""},{"id":"cnm_h226_q1","topicId":"cnm_h226","difficulty":"basic","type":"numeric","prompt":"f(x)=x²−4x+1。可能的极值点横坐标是多少？","answer":"2","explanation":"f'(x)=2x−4=0，x=2。左侧导数为负、右侧为正，是极小值点。","verify":"2"},{"id":"cnm_h226_q2","topicId":"cnm_h226","difficulty":"basic","type":"numeric","prompt":"f(x)=x²−4x+1 在 x=2 处的函数值是多少？","answer":"-3","explanation":"4−8+1=−3。","verify":"2*2-4*2+1"},{"id":"cnm_h226_q3","topicId":"cnm_h226","difficulty":"standard","type":"choice","prompt":"可导函数在极值点处，导数通常怎样？","choices":[{"key":"A","text":"一定大于 0"},{"key":"B","text":"等于 0"},{"key":"C","text":"一定小于 0"},{"key":"D","text":"一定不存在"}],"answer":"B","explanation":"极值的必要条件是导数为 0。反过来，导数为 0 不一定是极值，还要看两侧是否变号。","verify":"\"等于 0\""},{"id":"cnm_h226_q4","topicId":"cnm_h226","difficulty":"standard","type":"choice","prompt":"左侧导数为正、右侧导数为负的点是？","choices":[{"key":"A","text":"极小值点"},{"key":"B","text":"一定不是极值"},{"key":"C","text":"极大值点"},{"key":"D","text":"间断点"}],"answer":"C","explanation":"函数先增后减，这个点是极大值点。","verify":"\"极大值点\""},{"id":"cnm_h227_q1","topicId":"cnm_h227","difficulty":"basic","type":"numeric","prompt":"f(x)=x²−2x 在 [0，3] 上的最大值是多少？","answer":"3","explanation":"f'(x)=2x−2，驻点 x=1。f(0)=0，f(1)=−1，f(3)=3，最大值是 3。","verify":"max(0*0-2*0, 1*1-2*1, 3*3-2*3)"},{"id":"cnm_h227_q2","topicId":"cnm_h227","difficulty":"basic","type":"numeric","prompt":"f(x)=x²−2x 在 [0，3] 上的最小值是多少？","answer":"-1","explanation":"三个候选值是 0、−1、3，最小值是 −1。","verify":"min(0, 1-2, 9-6)"},{"id":"cnm_h227_q3","topicId":"cnm_h227","difficulty":"standard","type":"numeric","prompt":"f(x)=−x²+4 在 [−1，1] 上，端点 x=1 的函数值是多少？","answer":"3","explanation":"−1+4=3。顶点 x=0 的函数值是 4，更大。","verify":"-(1*1)+4"},{"id":"cnm_h227_q4","topicId":"cnm_h227","difficulty":"standard","type":"choice","prompt":"闭区间上求最值，除了导数为 0 的点，还要比较什么？","choices":[{"key":"A","text":"只比较原点"},{"key":"B","text":"只比较导数为 1 的点"},{"key":"C","text":"不用再比较"},{"key":"D","text":"区间的两个端点"}],"answer":"D","explanation":"最值可能出现在端点，不能只看驻点。","verify":"\"区间的两个端点\""},{"id":"cnm_h228_q1","topicId":"cnm_h228","difficulty":"basic","type":"numeric","prompt":"矩形周长是 20。当长和宽相等时面积最大。这个最大面积是多少？","answer":"25","explanation":"正方形边长是 5，面积是 25。","verify":"(20//4)**2"},{"id":"cnm_h228_q2","topicId":"cnm_h228","difficulty":"basic","type":"numeric","prompt":"矩形周长是 20，一边长 x，另一边长 10−x。面积 S=x(10−x)。S'(x)=0 时 x 等于多少？","answer":"5","explanation":"S=10x−x²，S'=10−2x=0，x=5。","verify":"5"},{"id":"cnm_h228_q3","topicId":"cnm_h228","difficulty":"standard","type":"numeric","prompt":"一边靠墙，另外三边总长 24 米围矩形。垂直于墙的边长是 x，平行于墙的边长是 24−2x。面积最大时 x 等于多少？","answer":"6","explanation":"S=x(24−2x)=24x−2x²，S'=24−4x=0，x=6。","verify":"6"},{"id":"cnm_h228_q4","topicId":"cnm_h228","difficulty":"standard","type":"choice","prompt":"用导数做优化，最后一步要做什么？","choices":[{"key":"A","text":"比较驻点和定义域端点的函数值"},{"key":"B","text":"只把导数设为 1"},{"key":"C","text":"只看定义域的长度"},{"key":"D","text":"把函数换成它的导数后不再计算"}],"answer":"A","explanation":"实际问题的最值要落在允许的范围内，驻点还要检验是不是最大或最小。","verify":"\"比较驻点和定义域端点的函数值\""},{"id":"cnm_h229_q1","topicId":"cnm_h229","difficulty":"basic","type":"numeric","prompt":"f(x)=x³−3x+1。f'(0) 等于多少？","answer":"-3","explanation":"f'(x)=3x²−3，在 0 处是 −3。","verify":"0-3"},{"id":"cnm_h229_q2","topicId":"cnm_h229","difficulty":"basic","type":"numeric","prompt":"f(x)=x³−3x。f'(x)=0 时，正的那个 x 是多少？","answer":"1","explanation":"3x²−3=0，x²=1，正根是 1。","verify":"1"},{"id":"cnm_h229_q3","topicId":"cnm_h229","difficulty":"standard","type":"numeric","prompt":"f(x)=2x³。f'(1) 等于多少？","answer":"6","explanation":"(2x³)'=6x²，在 x=1 处是 6。","verify":"6*1*1"},{"id":"cnm_h229_q4","topicId":"cnm_h229","difficulty":"standard","type":"choice","prompt":"三次多项式的导函数是几次多项式？","choices":[{"key":"A","text":"三次"},{"key":"B","text":"二次"},{"key":"C","text":"一次"},{"key":"D","text":"常数"}],"answer":"B","explanation":"求导后次数降 1，三次变成二次。","verify":"\"二次\""}]
