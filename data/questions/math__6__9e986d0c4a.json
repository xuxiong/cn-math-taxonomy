[{"difficulty":"basic","type":"choice","prompt":"圆柱的两个底面是什么形状？","choices":[{"key":"A","text":"是完全相同的圆"},{"key":"B","text":"是两个三角形"},{"key":"C","text":"是一底一大的两个圆"}],"answer":"A","explanation":"两个底面半径相等。","id":"cnm_p206_q1","topicId":"cnm_p206"},{"difficulty":"basic","type":"numeric","prompt":"一个圆柱的一个底面半径是 3 厘米，它的另一个底面的直径是多少厘米？","answer":"6","explanation":"两个底面完全相同，直径＝3×2＝6。","verify":"3*2","id":"cnm_p206_q2","topicId":"cnm_p206"},{"difficulty":"standard","type":"choice","prompt":"下面哪个物体的形状是圆柱？","choices":[{"key":"A","text":"篮球"},{"key":"B","text":"易拉罐"},{"key":"C","text":"魔方"},{"key":"D","text":"漏斗"}],"answer":"B","explanation":"易拉罐有两个完全相同的圆形底面和一个侧面，是圆柱。","id":"cnm_p206_q3","topicId":"cnm_p206"},{"difficulty":"challenge","type":"numeric","prompt":"把一张长 12.56 厘米、宽 5 厘米的长方形纸围成圆柱的侧面（宽作高）。底面直径大约是多少厘米？圆周率按 314/100。（用小数作答）","answer":"4","explanation":"侧面的长等于底面周长 12.56 厘米，直径＝12.56÷3.14＝4。","verify":"1256/100 / (314/100)","id":"cnm_p206_q4","topicId":"cnm_p206"},{"difficulty":"basic","type":"numeric","prompt":"底面半径 2 厘米、高 5 厘米的圆柱，体积是多少立方厘米？圆周率按 314/100。（用小数作答）","answer":"62.8","explanation":"体积＝3.14×2×2×5＝62.8。","verify":"314/100*2*2*5","id":"cnm_p207_q1","topicId":"cnm_p207"},{"difficulty":"basic","type":"numeric","prompt":"底面半径 1 厘米、高 10 厘米的圆柱，体积是多少立方厘米？圆周率按 314/100。（用小数作答）","answer":"31.4","explanation":"3.14×1×1×10＝31.4。","verify":"314/100*1*1*10","id":"cnm_p207_q2","topicId":"cnm_p207"},{"difficulty":"standard","type":"numeric","prompt":"底面积 12 平方厘米、高 4 厘米的圆柱，体积是多少立方厘米？","answer":"48","explanation":"体积＝底面积×高＝12×4＝48。","verify":"12*4","id":"cnm_p207_q3","topicId":"cnm_p207"},{"difficulty":"challenge","type":"numeric","prompt":"底面直径 6 厘米、高 2 厘米的圆柱，体积是多少立方厘米？圆周率按 314/100。（用小数作答）","answer":"56.52","explanation":"半径＝3 厘米，体积＝3.14×3×3×2＝56.52。","verify":"314/100*3*3*2","id":"cnm_p207_q4","topicId":"cnm_p207"},{"difficulty":"basic","type":"choice","prompt":"圆柱的表面积包括哪几个面？","choices":[{"key":"A","text":"两个底面和一个侧面"},{"key":"B","text":"只有两个底面"},{"key":"C","text":"只有一个侧面"},{"key":"D","text":"四个侧面"}],"answer":"A","explanation":"表面积＝两个底面积＋侧面积。","id":"cnm_p208_q1","topicId":"cnm_p208"},{"difficulty":"basic","type":"numeric","prompt":"底面半径 2 厘米的圆柱，一个底面的面积是多少平方厘米？圆周率按 314/100。（用小数作答）","answer":"12.56","explanation":"3.14×2×2＝12.56。","verify":"314/100*2*2","id":"cnm_p208_q2","topicId":"cnm_p208"},{"difficulty":"standard","type":"numeric","prompt":"圆柱的侧面展开是长 6.28 厘米、宽 5 厘米的长方形。侧面积是多少平方厘米？（用小数作答）","answer":"31.4","explanation":"侧面积＝底面周长×高＝6.28×5＝31.4。","verify":"628/100*5","id":"cnm_p208_q3","topicId":"cnm_p208"},{"difficulty":"challenge","type":"numeric","prompt":"底面半径 2 厘米、高 5 厘米的圆柱，表面积是多少平方厘米？圆周率按 314/100。（用小数作答）","answer":"87.92","explanation":"2×3.14×2×(2＋5)＝12.56×7＝87.92。","verify":"2*314/100*2*(2+5)","id":"cnm_p208_q4","topicId":"cnm_p208"},{"difficulty":"basic","type":"choice","prompt":"等底等高的圆锥体积是同底同高圆柱体积的几分之几？","choices":[{"key":"A","text":"三分之一"},{"key":"B","text":"二分之一"},{"key":"C","text":"两倍"}],"answer":"A","explanation":"等底等高时，圆锥体积是圆柱的三分之一。","id":"cnm_p209_q1","topicId":"cnm_p209"},{"difficulty":"basic","type":"numeric","prompt":"一个圆柱的体积是 30 立方厘米。与它等底等高的圆锥体积是多少立方厘米？","answer":"10","explanation":"30÷3＝10。","verify":"30/3","id":"cnm_p209_q2","topicId":"cnm_p209"},{"difficulty":"standard","type":"numeric","prompt":"底面积 12 平方厘米、高 6 厘米的圆锥，体积是多少立方厘米？","answer":"24","explanation":"体积＝1/3×底面积×高＝1/3×12×6＝24。","verify":"12*6/3","id":"cnm_p209_q3","topicId":"cnm_p209"},{"difficulty":"challenge","type":"numeric","prompt":"底面半径 3 厘米、高 6 厘米的圆锥，体积是多少立方厘米？圆周率按 314/100。（用小数作答）","answer":"56.52","explanation":"1/3×3.14×3×3×6＝56.52。","verify":"314/100*3*3*6/3","id":"cnm_p209_q4","topicId":"cnm_p209"},{"difficulty":"basic","type":"choice","prompt":"圆锥的底面是什么形状？","choices":[{"key":"A","text":"是一个圆"},{"key":"B","text":"是一个正方形"},{"key":"C","text":"是两个圆"}],"answer":"A","explanation":"圆锥有一个圆形底面和一个顶点。","id":"cnm_p248_q1","topicId":"cnm_p248"},{"difficulty":"basic","type":"choice","prompt":"圆锥有几个顶点？","choices":[{"key":"A","text":"1 个"},{"key":"B","text":"2 个"},{"key":"C","text":"0 个"}],"answer":"A","explanation":"圆锥只有一个顶点。","id":"cnm_p248_q2","topicId":"cnm_p248"},{"difficulty":"standard","type":"choice","prompt":"圆锥的高是指哪一段距离？","choices":[{"key":"A","text":"从顶点到底面圆心的距离"},{"key":"B","text":"底面圆的直径"},{"key":"C","text":"侧面母线的长度"},{"key":"D","text":"底面圆的周长"}],"answer":"A","explanation":"高是顶点到底面圆心的垂直距离。","id":"cnm_p248_q3","topicId":"cnm_p248"},{"difficulty":"challenge","type":"choice","prompt":"把一个圆锥的侧面展开，得到的是什么图形？","choices":[{"key":"A","text":"扇形"},{"key":"B","text":"长方形"},{"key":"C","text":"三角形"},{"key":"D","text":"圆"}],"answer":"A","explanation":"圆锥侧面展开是扇形；圆柱侧面展开才是长方形。","id":"cnm_p248_q4","topicId":"cnm_p248"}]
