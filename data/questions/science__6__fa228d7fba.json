[{"id":"cns_p202_q1","topicId":"cns_p202","difficulty":"basic","type":"choice","prompt":"古人用什么现象计量一天？","choices":[{"key":"A","text":"风的大小"},{"key":"B","text":"下雨的次数"},{"key":"C","text":"人的心情"},{"key":"D","text":"太阳的东升西落"}],"answer":"D","explanation":"昼夜交替是有规律的现象。","verify":"\"太阳的东升西落\""},{"id":"cns_p202_q2","topicId":"cns_p202","difficulty":"basic","type":"choice","prompt":"能用来计时的现象，最重要的特点是什么？","choices":[{"key":"A","text":"有规律、可重复"},{"key":"B","text":"越快越好"},{"key":"C","text":"越漂亮越好"},{"key":"D","text":"随机变化"}],"answer":"A","explanation":"规律的现象才能计量时间。","verify":"\"有规律、可重复\""},{"id":"cns_p202_q3","topicId":"cns_p202","difficulty":"standard","type":"choice","prompt":"日晷是利用什么计时的？","choices":[{"key":"A","text":"水的流动"},{"key":"B","text":"太阳下影子的位置变化"},{"key":"C","text":"沙子的流动"},{"key":"D","text":"电池"}],"answer":"B","explanation":"日晷靠晷针影子的方向计时。","verify":"\"太阳下影子的位置变化\""},{"id":"cns_p202_q4","topicId":"cns_p202","difficulty":"challenge","type":"choice","prompt":"一分钟内脉搏跳动的次数大致稳定，用它计时有什么缺点？","choices":[{"key":"A","text":"太准确了"},{"key":"B","text":"没有缺点"},{"key":"C","text":"运动或紧张时会变化，不够准确"},{"key":"D","text":"脉搏不会跳"}],"answer":"C","explanation":"计时工具要求稳定，脉搏易受影响。","verify":"\"运动或紧张时会变化，不够准确\""},{"id":"cns_p203_q1","topicId":"cns_p203","difficulty":"basic","type":"choice","prompt":"滴漏（水钟）利用了什么来计时？","choices":[{"key":"A","text":"水均匀地流动"},{"key":"B","text":"太阳的影子"},{"key":"C","text":"钟摆的摆动"},{"key":"D","text":"沙子的颜色"}],"answer":"A","explanation":"水钟靠水流计时。","verify":"\"水均匀地流动\""},{"id":"cns_p203_q2","topicId":"cns_p203","difficulty":"basic","type":"choice","prompt":"用一个装满水的瓶子底部开小孔滴水，水越来越少时，滴水速度会怎样？","choices":[{"key":"A","text":"越来越快"},{"key":"B","text":"越来越慢"},{"key":"C","text":"不变"},{"key":"D","text":"停止后又加快"}],"answer":"B","explanation":"水位降低，水压变小，流速变慢。","verify":"\"越来越慢\""},{"id":"cns_p203_q3","topicId":"cns_p203","difficulty":"standard","type":"choice","prompt":"要让水钟滴水速度保持稳定，可以怎么做？","choices":[{"key":"A","text":"让水位越来越低"},{"key":"B","text":"把小孔开大"},{"key":"C","text":"让上方容器的水位保持不变"},{"key":"D","text":"加入颜料"}],"answer":"C","explanation":"水位不变，流速就稳定。","verify":"\"让上方容器的水位保持不变\""},{"id":"cns_p203_q4","topicId":"cns_p203","difficulty":"challenge","type":"choice","prompt":"自制水钟 1 分钟收集到 30 毫升水，那么 10 分钟大约能收集多少？","choices":[{"key":"A","text":"30 毫升"},{"key":"B","text":"3 毫升"},{"key":"C","text":"3000 毫升"},{"key":"D","text":"300 毫升"}],"answer":"D","explanation":"速度稳定时，30 × 10 = 300 毫升。","verify":"\"300 毫升\""},{"id":"cns_p204_q1","topicId":"cns_p204","difficulty":"basic","type":"choice","prompt":"一个摆，摆动一次所用的时间与摆幅大小有关吗？","choices":[{"key":"A","text":"摆幅越大越慢很多"},{"key":"B","text":"基本无关（摆幅不太大时）"},{"key":"C","text":"摆幅越大越快很多"},{"key":"D","text":"摆幅为零时最快"}],"answer":"B","explanation":"这叫摆的等时性。","verify":"\"基本无关（摆幅不太大时）\""},{"id":"cns_p204_q2","topicId":"cns_p204","difficulty":"basic","type":"choice","prompt":"摆长越长，摆动一次的时间怎样？","choices":[{"key":"A","text":"越短"},{"key":"B","text":"不变"},{"key":"C","text":"越长（摆得越慢）"},{"key":"D","text":"不摆动"}],"answer":"C","explanation":"摆的快慢主要与摆长有关。","verify":"\"越长（摆得越慢）\""},{"id":"cns_p204_q3","topicId":"cns_p204","difficulty":"standard","type":"choice","prompt":"摆钟走得太快了，应该怎样调节？","choices":[{"key":"A","text":"缩短摆长"},{"key":"B","text":"加重摆锤"},{"key":"C","text":"把钟放倒"},{"key":"D","text":"把摆锤向下调，增加摆长"}],"answer":"D","explanation":"摆长加长，摆动变慢。","verify":"\"把摆锤向下调，增加摆长\""},{"id":"cns_p204_q4","topicId":"cns_p204","difficulty":"challenge","type":"choice","prompt":"一个摆 15 秒内摆动 30 次，那么 1 分钟大约摆动多少次？","choices":[{"key":"A","text":"120 次"},{"key":"B","text":"30 次"},{"key":"C","text":"60 次"},{"key":"D","text":"450 次"}],"answer":"A","explanation":"1 分钟是 15 秒的 4 倍，30 × 4 = 120 次。","verify":"\"120 次\""},{"id":"cns_p205_q1","topicId":"cns_p205","difficulty":"basic","type":"choice","prompt":"下面哪种计时工具最精确？","choices":[{"key":"A","text":"日晷"},{"key":"B","text":"沙漏"},{"key":"C","text":"原子钟"},{"key":"D","text":"水钟"}],"answer":"C","explanation":"原子钟误差极小。","verify":"\"原子钟\""},{"id":"cns_p205_q2","topicId":"cns_p205","difficulty":"basic","type":"choice","prompt":"计时工具的发展大致经过了怎样的顺序？","choices":[{"key":"A","text":"原子钟→日晷→水钟"},{"key":"B","text":"石英钟→日晷→机械钟"},{"key":"C","text":"机械钟→原子钟→日晷"},{"key":"D","text":"日晷→水钟→机械钟→石英钟→原子钟"}],"answer":"D","explanation":"计时越来越精确。","verify":"\"日晷→水钟→机械钟→石英钟→原子钟\""},{"id":"cns_p205_q3","topicId":"cns_p205","difficulty":"standard","type":"choice","prompt":"下面哪种变化需要的时间最长？","choices":[{"key":"A","text":"高山被风化变低"},{"key":"B","text":"冰块融化"},{"key":"C","text":"种子发芽"},{"key":"D","text":"水烧开"}],"answer":"A","explanation":"地表的变化需要极长的时间。","verify":"\"高山被风化变低\""},{"id":"cns_p205_q4","topicId":"cns_p205","difficulty":"challenge","type":"choice","prompt":"为什么现代交通、通信需要非常精确的计时？","choices":[{"key":"A","text":"为了好看"},{"key":"B","text":"很多系统需要同步运行，差一点就会出错"},{"key":"C","text":"没有必要"},{"key":"D","text":"只是习惯"}],"answer":"B","explanation":"卫星导航等需要精确的时间。","verify":"\"很多系统需要同步运行，差一点就会出错\""}]
