[{"id":"cnp_041_q1","topicId":"cnp_041","difficulty":"basic","type":"choice","prompt":"浮力的方向是怎样的？","choices":[{"key":"A","text":"垂直向上"},{"key":"B","text":"竖直向上"},{"key":"C","text":"与重力方向相同"},{"key":"D","text":"指向液体流动方向"}],"answer":"B","explanation":"浮力方向总是竖直向上。","verify":"\"竖直向上\""},{"id":"cnp_041_q2","topicId":"cnp_041","difficulty":"basic","type":"choice","prompt":"一个物体在空气中称重 8 N，浸没在水中时测力计示数为 5 N，它受到的浮力是多少？","choices":[{"key":"A","text":"13 N"},{"key":"B","text":"3 N"},{"key":"C","text":"8 N"},{"key":"D","text":"5 N"}],"answer":"B","explanation":"称重法：F浮 = G - F示 = 8 - 5 = 3 N。","verify":"8-5"},{"id":"cnp_041_q3","topicId":"cnp_041","difficulty":"standard","type":"choice","prompt":"物体浸没在水中后继续往下移动（未触底），它受到的浮力怎样变化？","choices":[{"key":"A","text":"变大"},{"key":"B","text":"变小"},{"key":"C","text":"先变大后变小"},{"key":"D","text":"不变"}],"answer":"D","explanation":"浸没后排开水的体积不变，浮力不变，浮力与浸没的深度无关。","verify":"\"不变\""},{"id":"cnp_041_q4","topicId":"cnp_041","difficulty":"standard","type":"choice","prompt":"浮力产生的原因是什么？","choices":[{"key":"A","text":"液体对物体向上和向下的压力差"},{"key":"B","text":"物体排开了液体"},{"key":"C","text":"液体有重力"},{"key":"D","text":"物体有质量"}],"answer":"A","explanation":"下表面受到向上的压力大于上表面受到向下的压力，压力差就是浮力。","verify":"\"液体对物体向上和向下的压力差\""}]
