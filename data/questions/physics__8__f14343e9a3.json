[{"id":"cnp_019_q1","topicId":"cnp_019","difficulty":"basic","type":"choice","prompt":"光的三原色是哪三种？","choices":[{"key":"A","text":"红、绿、蓝"},{"key":"B","text":"红、黄、蓝"},{"key":"C","text":"红、绿、黄"},{"key":"D","text":"黄、绿、蓝"}],"answer":"A","explanation":"色光的三原色是红、绿、蓝；红、黄、蓝是颜料的三原色。","verify":"\"红、绿、蓝\""},{"id":"cnp_019_q2","topicId":"cnp_019","difficulty":"basic","type":"choice","prompt":"雨后天空出现彩虹，属于什么现象？","choices":[{"key":"A","text":"光的反射"},{"key":"B","text":"光的色散"},{"key":"C","text":"光的直线传播"},{"key":"D","text":"平面镜成像"}],"answer":"B","explanation":"太阳光经过空中的小水珠折射后分解成各种色光，是色散。","verify":"\"光的色散\""},{"id":"cnp_019_q3","topicId":"cnp_019","difficulty":"standard","type":"choice","prompt":"电视机遥控器发出的是什么光？","choices":[{"key":"A","text":"紫外线"},{"key":"B","text":"红光"},{"key":"C","text":"红外线"},{"key":"D","text":"X 射线"}],"answer":"C","explanation":"遥控器利用看不见的红外线传递信号；验钞机用紫外线。","verify":"\"红外线\""},{"id":"cnp_019_q4","topicId":"cnp_019","difficulty":"standard","type":"choice","prompt":"在暗室里用红光照一件白色衬衫，看到衬衫是什么颜色？","choices":[{"key":"A","text":"白色"},{"key":"B","text":"黑色"},{"key":"C","text":"绿色"},{"key":"D","text":"红色"}],"answer":"D","explanation":"白色物体反射所有色光，红光照射时只反射红光，看起来是红色。","verify":"\"红色\""}]
