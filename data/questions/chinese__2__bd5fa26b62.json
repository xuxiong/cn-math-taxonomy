[{"id":"cnc_p095_q1","topicId":"cnc_p095","difficulty":"basic","type":"choice","prompt":"「白日依山尽」的下一句是哪一句？","choices":[{"key":"A","text":"黄河入海流"},{"key":"B","text":"欲穷千里目"},{"key":"C","text":"更上一层楼"},{"key":"D","text":"黄河入海去"}],"answer":"A","explanation":"先写太阳靠着山落下，黄河流向大海，后面才是欲穷千里目。","verify":"\"黄河入海流\""},{"id":"cnc_p095_q2","topicId":"cnc_p095","difficulty":"basic","type":"choice","prompt":"「欲穷千里目」的下一句是哪一句？","choices":[{"key":"A","text":"黄河入海流"},{"key":"B","text":"更上一层楼"},{"key":"C","text":"白日依山尽"},{"key":"D","text":"更上一层台"}],"answer":"B","explanation":"想看到更远的地方，就要再上一层楼。","verify":"\"更上一层楼\""},{"id":"cnc_p095_q3","topicId":"cnc_p095","difficulty":"standard","type":"choice","prompt":"《登鹳雀楼》的作者是谁？","choices":[{"key":"A","text":"李白"},{"key":"B","text":"杜甫"},{"key":"C","text":"王之涣"},{"key":"D","text":"白居易"}],"answer":"C","explanation":"这首诗是王之涣写的。李白写过《望庐山瀑布》，不要记混。","verify":"\"王之涣\""},{"id":"cnc_p095_q4","topicId":"cnc_p095","difficulty":"standard","type":"choice","prompt":"「更上一层楼」是在说什么道理？","choices":[{"key":"A","text":"楼越高越危险，不要上去"},{"key":"B","text":"只要站在楼上看黄河就够了"},{"key":"C","text":"太阳落山就该回家"},{"key":"D","text":"站得高才能看得远"}],"answer":"D","explanation":"欲穷千里目，更上一层楼。想看得更远，就要站到更高的地方。","verify":"\"站得高才能看得远\""},{"id":"cnc_p096_q1","topicId":"cnc_p096","difficulty":"basic","type":"choice","prompt":"「日照香炉生紫烟」的下一句是哪一句？","choices":[{"key":"A","text":"飞流直下三千尺"},{"key":"B","text":"遥看瀑布挂前川"},{"key":"C","text":"疑是银河落九天"},{"key":"D","text":"遥看瀑布挂前山"}],"answer":"B","explanation":"先写远远看见瀑布挂在山前，后面才写飞流直下。","verify":"\"遥看瀑布挂前川\""},{"id":"cnc_p096_q2","topicId":"cnc_p096","difficulty":"basic","type":"choice","prompt":"「飞流直下三千尺」的下一句是哪一句？","choices":[{"key":"A","text":"疑是银河落九川"},{"key":"B","text":"白发三千丈"},{"key":"C","text":"疑是银河落九天"},{"key":"D","text":"黄河入海流"}],"answer":"C","explanation":"瀑布像银河从九天上落下来。白发三千丈是另一首诗，不要装进来。","verify":"\"疑是银河落九天\""},{"id":"cnc_p096_q3","topicId":"cnc_p096","difficulty":"standard","type":"choice","prompt":"《望庐山瀑布》的作者是谁？","choices":[{"key":"A","text":"王之涣"},{"key":"B","text":"杜甫"},{"key":"C","text":"杨万里"},{"key":"D","text":"李白"}],"answer":"D","explanation":"这首诗是李白写的。《登鹳雀楼》才是王之涣的。","verify":"\"李白\""},{"id":"cnc_p096_q4","topicId":"cnc_p096","difficulty":"standard","type":"choice","prompt":"「疑是银河落九天」把瀑布比作什么？","choices":[{"key":"A","text":"从天上落下的银河"},{"key":"B","text":"香炉里的紫烟"},{"key":"C","text":"山上的一条小路"},{"key":"D","text":"门前的一条小溪"}],"answer":"A","explanation":"诗人觉得瀑布好像银河从九天落下来。香炉峰上的紫烟是第一句。","verify":"\"从天上落下的银河\""},{"id":"cnc_p097_q1","topicId":"cnc_p097","difficulty":"basic","type":"choice","prompt":"仙桃石像什么？","choices":[{"key":"A","text":"一只猴子"},{"key":"B","text":"一位仙人"},{"key":"C","text":"一个巨大的桃子"},{"key":"D","text":"一只金鸡"}],"answer":"C","explanation":"飞来石上好像有一只巨大的桃子，那就是仙桃石。","verify":"\"一个巨大的桃子\""},{"id":"cnc_p097_q2","topicId":"cnc_p097","difficulty":"basic","type":"choice","prompt":"「猴子观海」是一块怎样的石头？","choices":[{"key":"A","text":"像猴子在海里游泳"},{"key":"B","text":"像金鸡对着天都峰叫"},{"key":"C","text":"像仙人伸着手指路"},{"key":"D","text":"像猴子蹲着看翻滚的云海"}],"answer":"D","explanation":"石头像猴子蹲在山头，望着翻滚的云海。","verify":"\"像猴子蹲着看翻滚的云海\""},{"id":"cnc_p097_q3","topicId":"cnc_p097","difficulty":"standard","type":"choice","prompt":"「仙人指路」奇在哪里？","choices":[{"key":"A","text":"像一位仙人伸着手臂指向前方"},{"key":"B","text":"像一盘桃子滚下来"},{"key":"C","text":"像公鸡站在峰顶"},{"key":"D","text":"像一座石桥"}],"answer":"A","explanation":"那块石头很像仙人伸出手臂，在给别人指路。","verify":"\"像一位仙人伸着手臂指向前方\""},{"id":"cnc_p097_q4","topicId":"cnc_p097","difficulty":"standard","type":"choice","prompt":"课文写这些石头，是为了说明什么？","choices":[{"key":"A","text":"黄山没有石头"},{"key":"B","text":"黄山的石头奇形怪状，很有趣"},{"key":"C","text":"这些石头都是同一种样子"},{"key":"D","text":"石头比山更高"}],"answer":"B","explanation":"黄山奇石有的像桃子，有的像猴子、仙人和金鸡，样子很奇。","verify":"\"黄山的石头奇形怪状，很有趣\""},{"id":"cnc_p098_q1","topicId":"cnc_p098","difficulty":"basic","type":"choice","prompt":"日月潭在哪里？","choices":[{"key":"A","text":"新疆吐鲁番"},{"key":"B","text":"井冈山茅坪"},{"key":"C","text":"黄山天都峰"},{"key":"D","text":"我国台湾省的高山上"}],"answer":"D","explanation":"课文写日月潭是台湾省最大的一个湖，在台中附近的高山上。","verify":"\"我国台湾省的高山上\""},{"id":"cnc_p098_q2","topicId":"cnc_p098","difficulty":"basic","type":"choice","prompt":"湖中央的小岛叫什么？它把湖分成什么样？","choices":[{"key":"A","text":"光华岛。北边像圆圆的太阳，叫日潭；南边像弯弯的月亮，叫月潭"},{"key":"B","text":"仙桃石。两边都叫日潭"},{"key":"C","text":"光华岛。北边是月潭，南边是日潭"},{"key":"D","text":"北斗星。湖被分成七块"}],"answer":"A","explanation":"小岛把湖水分成两半。圆的一边是日潭，弯的一边是月潭。不要把南北记反。","verify":"\"光华岛。北边像圆圆的太阳，叫日潭；南边像弯弯的月亮，叫月潭\""},{"id":"cnc_p098_q3","topicId":"cnc_p098","difficulty":"standard","type":"choice","prompt":"清晨和细雨中的日月潭，课文怎样写？","choices":[{"key":"A","text":"清晨湖水全部干了"},{"key":"B","text":"清晨湖面飘着薄雾；下雨时像披上轻纱"},{"key":"C","text":"一下雨石头就变成桃子"},{"key":"D","text":"清晨只能看见军舰"}],"answer":"B","explanation":"薄雾、阳光、蒙蒙细雨，写出不同时候的湖。","verify":"\"清晨湖面飘着薄雾；下雨时像披上轻纱\""},{"id":"cnc_p098_q4","topicId":"cnc_p098","difficulty":"standard","type":"choice","prompt":"课文为什么说日月潭吸引许多人？","choices":[{"key":"A","text":"因为那里不让人去"},{"key":"B","text":"因为湖里没有水"},{"key":"C","text":"风光秀丽，有很多中外游客来看"},{"key":"D","text":"因为只有冬天才能看见湖"}],"answer":"C","explanation":"群山环绕，湖水碧绿，风光秀丽，所以吸引了许许多多中外游客。","verify":"\"风光秀丽，有很多中外游客来看\""},{"id":"cnc_p099_q1","topicId":"cnc_p099","difficulty":"basic","type":"choice","prompt":"葡萄沟在哪里？","choices":[{"key":"A","text":"新疆吐鲁番"},{"key":"B","text":"台湾日月潭"},{"key":"C","text":"江西井冈山"},{"key":"D","text":"安徽黄山"}],"answer":"A","explanation":"新疆吐鲁番有个地方叫葡萄沟。不要把它写成台湾或黄山。","verify":"\"新疆吐鲁番\""},{"id":"cnc_p099_q2","topicId":"cnc_p099","difficulty":"basic","type":"choice","prompt":"成熟的葡萄有哪些颜色？","choices":[{"key":"A","text":"只有一种黑色"},{"key":"B","text":"红的、白的、紫的、暗红的、淡绿的，一大串一大串"},{"key":"C","text":"全部是雪白色"},{"key":"D","text":"没有颜色，因为还没结果"}],"answer":"B","explanation":"五颜六色的葡萄五大串五大串地挂在架子上。","verify":"\"红的、白的、紫的、暗红的、淡绿的，一大串一大串\""},{"id":"cnc_p099_q3","topicId":"cnc_p099","difficulty":"standard","type":"choice","prompt":"收下来的葡萄，有一种怎样做成葡萄干？","choices":[{"key":"A","text":"放在太阳底下晒成焦炭"},{"key":"B","text":"丢进湖里泡软"},{"key":"C","text":"运到阴房里，制成颜色鲜、味道甜的葡萄干"},{"key":"D","text":"挂在彩虹桥上"}],"answer":"C","explanation":"阴房四壁有孔，葡萄在里面慢慢变成葡萄干。葡萄沟的葡萄干很有名。","verify":"\"运到阴房里，制成颜色鲜、味道甜的葡萄干\""},{"id":"cnc_p099_q4","topicId":"cnc_p099","difficulty":"standard","type":"choice","prompt":"五月和七八月，葡萄沟分别有什么水果熟了？","choices":[{"key":"A","text":"五月只有雪，七八月才有杏子"},{"key":"B","text":"两个月都没有水果"},{"key":"C","text":"五月葡萄干已经吃完，七八月不再结果"},{"key":"D","text":"五月有杏子，七八月葡萄熟了"}],"answer":"D","explanation":"维吾尔族老乡的院子里，五月杏子熟，七八月葡萄熟。","verify":"\"五月有杏子，七八月葡萄熟了\""},{"id":"cnc_p100_q1","topicId":"cnc_p100","difficulty":"basic","type":"choice","prompt":"「雪白、米白、奶白」都是在写什么？","choices":[{"key":"A","text":"不同样子的红"},{"key":"B","text":"不同样子的白"},{"key":"C","text":"三种动物的名字"},{"key":"D","text":"三座山的名字"}],"answer":"B","explanation":"白字前面加上雪、米、奶，写出不一样的白。","verify":"\"不同样子的白\""},{"id":"cnc_p100_q2","topicId":"cnc_p100","difficulty":"basic","type":"choice","prompt":"「火红、桃红、枣红」是在写哪一种颜色？","choices":[{"key":"A","text":"绿"},{"key":"B","text":"蓝"},{"key":"C","text":"红"},{"key":"D","text":"黑"}],"answer":"C","explanation":"火、桃、枣都用来形容不同的红。草绿、翠绿才是绿。","verify":"\"红\""},{"id":"cnc_p100_q3","topicId":"cnc_p100","difficulty":"standard","type":"choice","prompt":"「小椅子像翘起尾巴的小猫」把椅子比作什么？","choices":[{"key":"A","text":"士兵排队"},{"key":"B","text":"一块黑板"},{"key":"C","text":"一条小溪"},{"key":"D","text":"小猫"}],"answer":"D","explanation":"翘起的椅背像小猫的尾巴。这是在打比方。","verify":"\"小猫\""},{"id":"cnc_p100_q4","topicId":"cnc_p100","difficulty":"standard","type":"choice","prompt":"「有山皆图画」常和哪一句一起读？","choices":[{"key":"A","text":"无水不文章"},{"key":"B","text":"更上一层楼"},{"key":"C","text":"飞流直下三千尺"},{"key":"D","text":"独钓寒江雪"}],"answer":"A","explanation":"有山皆图画，无水不文章。这是园地里积累的句子，不是古诗课文里的下一句。","verify":"\"无水不文章\""}]
