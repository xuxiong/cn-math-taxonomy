[{"id":"cnp_078_q1","topicId":"cnp_078","difficulty":"basic","type":"choice","prompt":"对人体安全的电压是多少？","choices":[{"key":"A","text":"220 V"},{"key":"B","text":"不高于 36 V"},{"key":"C","text":"380 V"},{"key":"D","text":"不高于 360 V"}],"answer":"B","explanation":"一般情况下对人体安全的电压不高于 36 V。","verify":"\"不高于 36 V\""},{"id":"cnp_078_q2","topicId":"cnp_078","difficulty":"basic","type":"choice","prompt":"发现有人触电，首先应该怎样做？","choices":[{"key":"A","text":"立即切断电源"},{"key":"B","text":"用手把人拉开"},{"key":"C","text":"用湿木棍挑开电线"},{"key":"D","text":"大声呼救后等待"}],"answer":"A","explanation":"首先切断电源，或用干燥的绝缘棒挑开电线，不能直接用手去拉。","verify":"\"立即切断电源\""},{"id":"cnp_078_q3","topicId":"cnp_078","difficulty":"standard","type":"choice","prompt":"下列做法中符合安全用电原则的是哪一个？","choices":[{"key":"A","text":"用湿手拔插头"},{"key":"B","text":"更换灯泡前先断开开关"},{"key":"C","text":"在高压线附近放风筝"},{"key":"D","text":"多个大功率用电器同时用一个插座"}],"answer":"B","explanation":"更换灯泡、维修电器前要先断开电源。","verify":"\"更换灯泡前先断开开关\""},{"id":"cnp_078_q4","topicId":"cnp_078","difficulty":"standard","type":"choice","prompt":"雷雨天不能在大树下避雨，原因是什么？","choices":[{"key":"A","text":"大树会倒"},{"key":"B","text":"大树容易遭雷击，电流可能经过人体"},{"key":"C","text":"大树挡不住雨"},{"key":"D","text":"大树会吸收热量"}],"answer":"B","explanation":"高大的树木容易被雷击中，强大的电流可能通过人体造成伤害。","verify":"\"大树容易遭雷击，电流可能经过人体\""}]
