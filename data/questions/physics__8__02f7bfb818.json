[{"id":"cnp_039_q1","topicId":"cnp_039","difficulty":"basic","type":"choice","prompt":"活塞式抽水机是利用什么把水抽上来的？","choices":[{"key":"A","text":"大气压"},{"key":"B","text":"水的重力"},{"key":"C","text":"活塞的推力"},{"key":"D","text":"水的浮力"}],"answer":"A","explanation":"活塞上提时下方气压减小，外界大气压把水压入圆筒。","verify":"\"大气压\""},{"id":"cnp_039_q2","topicId":"cnp_039","difficulty":"basic","type":"choice","prompt":"在 1 个标准大气压下，活塞式抽水机最多能把水抽到大约多高？","choices":[{"key":"A","text":"76 cm"},{"key":"B","text":"100 m"},{"key":"C","text":"10 m"},{"key":"D","text":"1 m"}],"answer":"C","explanation":"1 个标准大气压能支持约 10.3 m 高的水柱，所以抽水高度约 10 m。","verify":"10"},{"id":"cnp_039_q3","topicId":"cnp_039","difficulty":"standard","type":"choice","prompt":"自制抽水机的活塞与筒壁间漏气，会出现什么问题？","choices":[{"key":"A","text":"抽得更快"},{"key":"B","text":"水会变热"},{"key":"C","text":"抽不上水或抽水高度变小"},{"key":"D","text":"没有影响"}],"answer":"C","explanation":"漏气时活塞下方气压不能足够减小，大气压压上来的水就少，甚至抽不上来。","verify":"\"抽不上水或抽水高度变小\""},{"id":"cnp_039_q4","topicId":"cnp_039","difficulty":"standard","type":"choice","prompt":"在高原上使用同一台活塞式抽水机，最大抽水高度会怎样？","choices":[{"key":"A","text":"变大"},{"key":"B","text":"不变"},{"key":"C","text":"变小"},{"key":"D","text":"先变大后变小"}],"answer":"C","explanation":"高原上大气压较小，能支持的水柱高度变小。","verify":"\"变小\""}]
