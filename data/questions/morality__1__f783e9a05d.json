[{"id":"cnd_p021_q1","topicId":"cnd_p021","difficulty":"basic","type":"choice","prompt":"家人之所以珍贵，是因为？","choices":[{"key":"A","text":"家里东西最多"},{"key":"B","text":"家人从不提要求"},{"key":"C","text":"互相关爱、共同生活"},{"key":"D","text":"家人只会批评"}],"answer":"C","explanation":"家是互相关爱的地方。","verify":"\"互相关爱、共同生活\""},{"id":"cnd_p021_q2","topicId":"cnd_p021","difficulty":"basic","type":"choice","prompt":"父母辛苦工作，我们可以？","choices":[{"key":"A","text":"故意添乱"},{"key":"B","text":"什么家务都不做"},{"key":"C","text":"只顾要礼物"},{"key":"D","text":"体贴他们，少让他们操心"}],"answer":"D","explanation":"体贴父母是爱家的表现。","verify":"\"体贴他们，少让他们操心\""},{"id":"cnd_p021_q3","topicId":"cnd_p021","difficulty":"standard","type":"choice","prompt":"和家人意见不同，较好做法？","choices":[{"key":"A","text":"心平气和说明想法，一起商量"},{"key":"B","text":"摔门而出"},{"key":"C","text":"完全不说话冷战"},{"key":"D","text":"大声骂人"}],"answer":"A","explanation":"家庭矛盾也要好好沟通。","verify":"\"心平气和说明想法，一起商量\""},{"id":"cnd_p021_q4","topicId":"cnd_p021","difficulty":"challenge","type":"choice","prompt":"为什么要弘扬家庭美德？","choices":[{"key":"A","text":"家庭美德过时了"},{"key":"B","text":"尊敬长辈、相亲相爱，家庭更和睦"},{"key":"C","text":"只顾自己最重要"},{"key":"D","text":"美德只在学校需要"}],"answer":"B","explanation":"家庭美德让家更温暖。","verify":"\"尊敬长辈、相亲相爱，家庭更和睦\""},{"id":"cnd_p022_q1","topicId":"cnd_p022","difficulty":"basic","type":"choice","prompt":"同学搬不动椅子，你可以？","choices":[{"key":"A","text":"站着看笑话"},{"key":"B","text":"故意把椅子踢远"},{"key":"C","text":"嘲笑他力气小"},{"key":"D","text":"主动过去帮忙"}],"answer":"D","explanation":"力所能及帮助他人。","verify":"\"主动过去帮忙\""},{"id":"cnd_p022_q2","topicId":"cnd_p022","difficulty":"basic","type":"choice","prompt":"需要帮助时，有礼貌的说法是？","choices":[{"key":"A","text":"请帮我一下，谢谢"},{"key":"B","text":"喂，过来干活"},{"key":"C","text":"你必须帮我"},{"key":"D","text":"不说话直接抢东西"}],"answer":"A","explanation":"求助要有礼貌。","verify":"\"请帮我一下，谢谢\""},{"id":"cnd_p022_q3","topicId":"cnd_p022","difficulty":"standard","type":"choice","prompt":"帮助别人后对方道谢，你应？","choices":[{"key":"A","text":"说你欠我人情"},{"key":"B","text":"说不客气或没关系"},{"key":"C","text":"翻白眼走开"},{"key":"D","text":"要求立刻送礼"}],"answer":"B","explanation":"接受感谢要谦逊。","verify":"\"说不客气或没关系\""},{"id":"cnd_p022_q4","topicId":"cnd_p022","difficulty":"challenge","type":"choice","prompt":"为什么同学间要互相帮助？","choices":[{"key":"A","text":"帮助别人总吃亏"},{"key":"B","text":"只帮对自己有用的人"},{"key":"C","text":"大家共同进步，集体更温暖"},{"key":"D","text":"有困难只能自己扛"}],"answer":"C","explanation":"互助让集体更温暖。","verify":"\"大家共同进步，集体更温暖\""},{"id":"cnd_p023_q1","topicId":"cnd_p023","difficulty":"basic","type":"choice","prompt":"有好吃的点心，较好的做法是？","choices":[{"key":"A","text":"和同伴一起分享"},{"key":"B","text":"自己全吃完不给别人"},{"key":"C","text":"故意炫耀却不给"},{"key":"D","text":"把点心扔掉"}],"answer":"A","explanation":"分享能让快乐翻倍。","verify":"\"和同伴一起分享\""},{"id":"cnd_p023_q2","topicId":"cnd_p023","difficulty":"basic","type":"choice","prompt":"分享时应注意？","choices":[{"key":"A","text":"强行抢别人的来“分享”"},{"key":"B","text":"征得同意，注意卫生和公平"},{"key":"C","text":"只分给成绩好的人"},{"key":"D","text":"把不好的留给别人"}],"answer":"B","explanation":"分享要自愿、卫生、公平。","verify":"\"征得同意，注意卫生和公平\""},{"id":"cnd_p023_q3","topicId":"cnd_p023","difficulty":"standard","type":"choice","prompt":"为什么要学会分享？","choices":[{"key":"A","text":"分享就是吃亏"},{"key":"B","text":"好东西只能自己要"},{"key":"C","text":"关心他人，集体更友好"},{"key":"D","text":"分享只是大人说说"}],"answer":"C","explanation":"分享是友好相处的表现。","verify":"\"关心他人，集体更友好\""},{"id":"cnd_p023_q4","topicId":"cnd_p023","difficulty":"challenge","type":"choice","prompt":"同学没有彩色笔，你可以？","choices":[{"key":"A","text":"嘲笑他没有"},{"key":"B","text":"把笔藏起来"},{"key":"C","text":"要求他用零食来换"},{"key":"D","text":"借给他用，用完再还"}],"answer":"D","explanation":"把文具借给有需要的同学。","verify":"\"借给他用，用完再还\""},{"id":"cnd_p024_q1","topicId":"cnd_p024","difficulty":"basic","type":"choice","prompt":"小组完成任务，正确做法是？","choices":[{"key":"A","text":"一个人包办不让别人动手"},{"key":"B","text":"分工合作，互相配合"},{"key":"C","text":"各自干各自的不沟通"},{"key":"D","text":"把困难都推给别人"}],"answer":"B","explanation":"合作要分工配合。","verify":"\"分工合作，互相配合\""},{"id":"cnd_p024_q2","topicId":"cnd_p024","difficulty":"basic","type":"choice","prompt":"合作中意见不同，应？","choices":[{"key":"A","text":"大声争吵不听别人"},{"key":"B","text":"立刻退出小组"},{"key":"C","text":"商量讨论，找到合适办法"},{"key":"D","text":"强迫别人接受自己"}],"answer":"C","explanation":"有分歧要协商。","verify":"\"商量讨论，找到合适办法\""},{"id":"cnd_p024_q3","topicId":"cnd_p024","difficulty":"standard","type":"choice","prompt":"为什么要学会合作？","choices":[{"key":"A","text":"合作总是浪费时间"},{"key":"B","text":"强者不必合作"},{"key":"C","text":"合作只适合大人"},{"key":"D","text":"很多事一个人做不好，一起做更顺利"}],"answer":"D","explanation":"合作能更好完成任务。","verify":"\"很多事一个人做不好，一起做更顺利\""},{"id":"cnd_p024_q4","topicId":"cnd_p024","difficulty":"challenge","type":"choice","prompt":"大扫除时你擦黑板，同伴搬桌子，这叫？","choices":[{"key":"A","text":"分工合作"},{"key":"B","text":"一个人偷懒"},{"key":"C","text":"互相妨碍"},{"key":"D","text":"没有合作"}],"answer":"A","explanation":"各负其责就是分工合作。","verify":"\"分工合作\""}]
