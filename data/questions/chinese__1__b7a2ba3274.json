[{"id":"cnc_p038_q1","topicId":"cnc_p038","difficulty":"basic","type":"choice","prompt":"谁的尾巴长？","choices":[{"key":"A","text":"兔子"},{"key":"B","text":"松鼠"},{"key":"C","text":"鸭子"},{"key":"D","text":"猴子"}],"answer":"D","explanation":"猴子的尾巴长。兔子的尾巴短，松鼠的尾巴好像一把伞。","verify":"\"猴子\""},{"id":"cnc_p038_q2","topicId":"cnc_p038","difficulty":"basic","type":"choice","prompt":"谁的尾巴好像一把伞？","choices":[{"key":"A","text":"松鼠"},{"key":"B","text":"猴子"},{"key":"C","text":"孔雀"},{"key":"D","text":"公鸡"}],"answer":"A","explanation":"松鼠的尾巴又大又蓬松，课文说好像一把伞。孔雀的尾巴是最好看。","verify":"\"松鼠\""},{"id":"cnc_p038_q3","topicId":"cnc_p038","difficulty":"standard","type":"choice","prompt":"鸭子的尾巴和公鸡的尾巴，课文怎么说？","choices":[{"key":"A","text":"鸭子的尾巴弯，公鸡的尾巴扁"},{"key":"B","text":"鸭子的尾巴扁，公鸡的尾巴弯"},{"key":"C","text":"鸭子的尾巴长，公鸡的尾巴短"},{"key":"D","text":"鸭子的尾巴最好看"}],"answer":"B","explanation":"鸭子的尾巴扁，公鸡的尾巴弯。最好看的是孔雀的尾巴。","verify":"\"鸭子的尾巴扁，公鸡的尾巴弯\""},{"id":"cnc_p038_q4","topicId":"cnc_p038","difficulty":"standard","type":"choice","prompt":"谁的尾巴最好看？","choices":[{"key":"A","text":"公鸡"},{"key":"B","text":"松鼠"},{"key":"C","text":"孔雀"},{"key":"D","text":"猴子"}],"answer":"C","explanation":"课文最后说孔雀的尾巴最好看。公鸡的尾巴只是弯。","verify":"\"孔雀\""},{"id":"cnc_p039_q1","topicId":"cnc_p039","difficulty":"basic","type":"choice","prompt":"乌鸦为什么一开始喝不着水？","choices":[{"key":"A","text":"瓶里水不多，瓶口又小"},{"key":"B","text":"瓶子里一滴水也没有"},{"key":"C","text":"瓶口太大，水都洒了"},{"key":"D","text":"水是热的，不能喝"}],"answer":"A","explanation":"瓶子里有水，但是水不多，瓶口又小，嘴伸不进去。","verify":"\"瓶里水不多，瓶口又小\""},{"id":"cnc_p039_q2","topicId":"cnc_p039","difficulty":"basic","type":"choice","prompt":"乌鸦想出了什么办法？","choices":[{"key":"A","text":"把瓶子踢倒"},{"key":"B","text":"把小石子一颗一颗放进瓶子"},{"key":"C","text":"请别人把水倒出来"},{"key":"D","text":"把瓶子埋进土里"}],"answer":"B","explanation":"它看见旁边有许多小石子，就一颗一颗放进瓶子。","verify":"\"把小石子一颗一颗放进瓶子\""},{"id":"cnc_p039_q3","topicId":"cnc_p039","difficulty":"standard","type":"choice","prompt":"石子放进去以后，瓶子里的水怎样了？","choices":[{"key":"A","text":"全部漏光了"},{"key":"B","text":"结成了冰"},{"key":"C","text":"渐渐升高，乌鸦喝着了"},{"key":"D","text":"一点没变，还是喝不着"}],"answer":"C","explanation":"石子占了地方，水就渐渐升高，乌鸦终于喝着水了。","verify":"\"渐渐升高，乌鸦喝着了\""},{"id":"cnc_p039_q4","topicId":"cnc_p039","difficulty":"standard","type":"choice","prompt":"这个故事主要说什么？","choices":[{"key":"A","text":"喝不到水就放弃"},{"key":"B","text":"石子不能放进瓶子"},{"key":"C","text":"瓶子里的水不能喝"},{"key":"D","text":"遇到困难可以想办法"}],"answer":"D","explanation":"乌鸦没有放弃，想出放石子的办法，才喝到了水。","verify":"\"遇到困难可以想办法\""},{"id":"cnc_p040_q1","topicId":"cnc_p040","difficulty":"basic","type":"choice","prompt":"小雨点儿要到哪里去？","choices":[{"key":"A","text":"没有花没有草的地方"},{"key":"B","text":"有花有草的地方"},{"key":"C","text":"雪地里"},{"key":"D","text":"瓶子里"}],"answer":"B","explanation":"小雨点儿说：我要去有花有草的地方。没有花草的地方是大雨点儿去的。","verify":"\"有花有草的地方\""},{"id":"cnc_p040_q2","topicId":"cnc_p040","difficulty":"basic","type":"choice","prompt":"大雨点儿要到哪里去？","choices":[{"key":"A","text":"有花有草的地方"},{"key":"B","text":"云彩上面，不再下来"},{"key":"C","text":"没有花没有草的地方"},{"key":"D","text":"小雨点儿的家里"}],"answer":"C","explanation":"大雨点儿说：我要去没有花没有草的地方。","verify":"\"没有花没有草的地方\""},{"id":"cnc_p040_q3","topicId":"cnc_p040","difficulty":"standard","type":"choice","prompt":"有花有草的地方，雨后怎样了？","choices":[{"key":"A","text":"花和草都不见了"},{"key":"B","text":"开出了第一朵花"},{"key":"C","text":"长出了石头"},{"key":"D","text":"花更红了，草更绿了"}],"answer":"D","explanation":"原来就有花有草的地方，花更红了，草更绿了。","verify":"\"花更红了，草更绿了\""},{"id":"cnc_p040_q4","topicId":"cnc_p040","difficulty":"standard","type":"choice","prompt":"没有花没有草的地方，雨后怎样了？","choices":[{"key":"A","text":"开出了红的花，长出了绿的草"},{"key":"B","text":"仍然什么也没有"},{"key":"C","text":"花更红了，草更绿了"},{"key":"D","text":"变成了一片雪地"}],"answer":"A","explanation":"原来没有花草的地方，这时候才开出红花、长出绿草。","verify":"\"开出了红的花，长出了绿的草\""},{"id":"cnc_p041_q1","topicId":"cnc_p041","difficulty":"basic","type":"choice","prompt":"看图：小朋友先洗手，再吃饭。哪一种说法有顺序？","choices":[{"key":"A","text":"他吃饭洗手。"},{"key":"B","text":"吃饭。"},{"key":"C","text":"他先洗手，然后吃饭。"},{"key":"D","text":"先吃饭，洗手没有说"}],"answer":"C","explanation":"先、然后把两件事的次序说清楚。只说一个词还不清楚。","verify":"\"他先洗手，然后吃饭。\""},{"id":"cnc_p041_q2","topicId":"cnc_p041","difficulty":"basic","type":"choice","prompt":"看图：小鸟在树上唱歌。哪一句符合图意？","choices":[{"key":"A","text":"小鸟在河里游泳。"},{"key":"B","text":"小鸟把树砍倒了。"},{"key":"C","text":"只写「树」。"},{"key":"D","text":"小鸟站在树上唱歌。"}],"answer":"D","explanation":"要照着图说出谁在哪里做什么，不能改成另一件事。","verify":"\"小鸟站在树上唱歌。\""},{"id":"cnc_p041_q3","topicId":"cnc_p041","difficulty":"standard","type":"choice","prompt":"哪一种说法别人最容易听明白？","choices":[{"key":"A","text":"妈妈在厨房里洗碗。"},{"key":"B","text":"妈妈碗。"},{"key":"C","text":"厨房洗碗妈妈。"},{"key":"D","text":"洗。"}],"answer":"A","explanation":"谁、在哪里、做什么，按这个次序说，句子就清楚。","verify":"\"妈妈在厨房里洗碗。\""},{"id":"cnc_p041_q4","topicId":"cnc_p041","difficulty":"standard","type":"choice","prompt":"看图说话，下面哪一种不合适？","choices":[{"key":"A","text":"小明在操场上跑步。"},{"key":"B","text":"只说一个「跑」字"},{"key":"C","text":"小猫在沙发上睡觉。"},{"key":"D","text":"雨停了，天晴了。"}],"answer":"B","explanation":"一个字看不出谁在跑、在哪里跑。另外三句都把事情说完整了。","verify":"\"只说一个「跑」字\""}]
