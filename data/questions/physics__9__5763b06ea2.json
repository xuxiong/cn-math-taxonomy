[{"id":"cnp_083_q1","topicId":"cnp_083","difficulty":"basic","type":"choice","prompt":"下列方法中，能增强电磁铁磁性的是哪一个？","choices":[{"key":"A","text":"减小线圈中的电流"},{"key":"B","text":"增加线圈匝数"},{"key":"C","text":"抽出铁芯"},{"key":"D","text":"改变电流方向"}],"answer":"B","explanation":"电流越大、匝数越多（有铁芯），电磁铁磁性越强；改变电流方向只改变磁极。","verify":"\"增加线圈匝数\""},{"id":"cnp_083_q2","topicId":"cnp_083","difficulty":"basic","type":"choice","prompt":"电磁铁与永磁体相比，优点是什么？","choices":[{"key":"A","text":"磁性有无和强弱可以控制"},{"key":"B","text":"磁性永远不消失"},{"key":"C","text":"不需要电"},{"key":"D","text":"没有磁极"}],"answer":"A","explanation":"电磁铁通电有磁性、断电无磁性，磁性强弱可以通过电流调节。","verify":"\"磁性有无和强弱可以控制\""},{"id":"cnp_083_q3","topicId":"cnp_083","difficulty":"standard","type":"choice","prompt":"电磁继电器的实质是什么？","choices":[{"key":"A","text":"利用电磁铁控制工作电路通断的开关"},{"key":"B","text":"一种电源"},{"key":"C","text":"一种用电器"},{"key":"D","text":"一种电阻"}],"answer":"A","explanation":"电磁继电器用低电压、弱电流的控制电路控制高电压、强电流的工作电路。","verify":"\"利用电磁铁控制工作电路通断的开关\""},{"id":"cnp_083_q4","topicId":"cnp_083","difficulty":"standard","type":"choice","prompt":"电磁铁的铁芯一般用什么材料？","choices":[{"key":"A","text":"钢"},{"key":"B","text":"铜"},{"key":"C","text":"铝"},{"key":"D","text":"软铁"}],"answer":"D","explanation":"软铁断电后磁性立即消失；钢会被磁化后保留磁性，铜、铝不能被磁化。","verify":"\"软铁\""}]
