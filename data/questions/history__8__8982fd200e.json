[{"id":"cnh_j080_q1","topicId":"cnh_j080","difficulty":"basic","type":"choice","prompt":"中国加入世界贸易组织是在？","choices":[{"key":"A","text":"1997年"},{"key":"B","text":"2001年"},{"key":"C","text":"1992年"},{"key":"D","text":"2008年"}],"answer":"B","explanation":"2001年12月11日中国成为世界贸易组织成员。","verify":"\"2001年\""},{"id":"cnh_j080_q2","topicId":"cnh_j080","difficulty":"basic","type":"choice","prompt":"2002年中共十六大提出的奋斗目标是？","choices":[{"key":"A","text":"解决温饱"},{"key":"B","text":"建立经济特区"},{"key":"C","text":"全面建设小康社会"},{"key":"D","text":"完成三大改造"}],"answer":"C","explanation":"十六大把全面建设小康社会定为新世纪最初二十年的目标。","verify":"\"全面建设小康社会\""},{"id":"cnh_j080_q3","topicId":"cnh_j080","difficulty":"standard","type":"choice","prompt":"中共十六大把什么确立为党的指导思想？","choices":[{"key":"A","text":"邓小平理论首次提出"},{"key":"B","text":"科学发展观"},{"key":"C","text":"习近平新时代中国特色社会主义思想"},{"key":"D","text":"三个代表重要思想"}],"answer":"D","explanation":"三个代表重要思想被写入党章。","verify":"\"三个代表重要思想\""},{"id":"cnh_j080_q4","topicId":"cnh_j080","difficulty":"challenge","type":"choice","prompt":"加入世贸组织对中国经济的直接影响是？","choices":[{"key":"A","text":"更深地参与经济全球化"},{"key":"B","text":"退出联合国"},{"key":"C","text":"取消所有关税且不再有任何规则"},{"key":"D","text":"关闭沿海城市"}],"answer":"A","explanation":"入世使中国市场与世界市场的联系更加紧密。","verify":"\"更深地参与经济全球化\""},{"id":"cnh_j081_q1","topicId":"cnh_j081","difficulty":"basic","type":"choice","prompt":"2007年中共十七大把什么写入党章？","choices":[{"key":"A","text":"三个代表首次提出"},{"key":"B","text":"邓小平理论首次提出"},{"key":"C","text":"科学发展观"},{"key":"D","text":"人民公社章程"}],"answer":"C","explanation":"科学发展观被确立为党的指导思想之一。","verify":"\"科学发展观\""},{"id":"cnh_j081_q2","topicId":"cnh_j081","difficulty":"basic","type":"choice","prompt":"2003年10月杨利伟乘坐的飞船是？","choices":[{"key":"A","text":"东方红一号"},{"key":"B","text":"神舟一号"},{"key":"C","text":"嫦娥五号"},{"key":"D","text":"神舟五号"}],"answer":"D","explanation":"神舟五号任务使中国成为世界上第三个独立掌握载人航天技术的国家。","verify":"\"神舟五号\""},{"id":"cnh_j081_q3","topicId":"cnh_j081","difficulty":"standard","type":"choice","prompt":"2006年全线通车的铁路是？","choices":[{"key":"A","t