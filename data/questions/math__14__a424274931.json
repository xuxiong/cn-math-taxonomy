[{"id":"cnm_h233_q1","topicId":"cnm_h233","difficulty":"basic","type":"choice","prompt":"下面哪一项是排列？","choices":[{"key":"A","text":"从 4 名同学中选 2 名组成一组，不计顺序"},{"key":"B","text":"把 4 本书并成一堆，不区分左右"},{"key":"C","text":"从 4 名同学中选 2 名排成先后顺序"},{"key":"D","text":"只关心选出了哪些人"}],"answer":"C","explanation":"排列要排成顺序。只分组、不计顺序，是组合。","verify":"\"从 4 名同学中选 2 名排成先后顺序\""},{"id":"cnm_h233_q2","topicId":"cnm_h233","difficulty":"basic","type":"numeric","prompt":"从 4 个不同元素中取出 2 个排成一列。有多少种排法？","answer":"12","explanation":"先选第一个有 4 种，再选第二个有 3 种，4×3=12。","verify":"perm(4,2)"},{"id":"cnm_h233_q3","topicId":"cnm_h233","difficulty":"standard","type":"numeric","prompt":"字母 A、B、C 都不相同，把它们全部排成一列。有多少种排法？","answer":"6","explanation":"3×2×1=6。","verify":"perm(3,3)"},{"id":"cnm_h233_q4","topicId":"cnm_h233","difficulty":"standard","type":"choice","prompt":"两个排列相同，需要满足什么？","choices":[{"key":"A","text":"只要取出的元素相同"},{"key":"B","text":"取出的元素相同，而且顺序也相同"},{"key":"C","text":"只要元素个数相同"},{"key":"D","text":"只要第一个位置相同"}],"answer":"B","explanation":"排列既看元素，也看每个位置上是谁。","verify":"\"取出的元素相同，而且顺序也相同\""},{"id":"cnm_h234_q1","topicId":"cnm_h234","difficulty":"basic","type":"numeric","prompt":"A(6,2) 等于多少？","answer":"30","explanation":"6×5=30。","verify":"perm(6,2)"},{"id":"cnm_h234_q2","topicId":"cnm_h234","difficulty":"basic","type":"numeric","prompt":"A(5,1) 等于多少？","answer":"5","explanation":"只取 1 个，有 5 种。","verify":"perm(5,1)"},{"id":"cnm_h234_q3","topicId":"cnm_h234","difficulty":"standard","type":"numeric","prompt":"A(4,4) 等于多少？","answer":"24","explanation":"4 个元素全排列：4×3×2×1=24。","verify":"factorial(4)"},{"id":"cnm_h234_q4","topicId":"cnm_h234","difficulty":"standard","type":"choice","prompt":"A(n,k) 的一种写法是什么？","choices":[{"key":"A","text":"n 的阶乘乘以 k 的阶乘"},{"key":"B","text":"k 的阶乘除以 n 的阶乘"},{"key":"C","text":"n 的阶乘除以 (n−k) 的阶乘"},{"key":"D","text":"n 与 k 的和"}],"answer":"C","explanation":"A(n,k)=n!/(n−k)!，其中 k 不能大于 n。","verify":"\"n 的阶乘除以 (n−k) 的阶乘\""},{"id":"cnm_h235_q1","topicId":"cnm_h235","difficulty":"basic","type":"numeric","prompt":"5 名同学站成一排拍照，每人都要站。有多少种站法？","answer":"120","explanation":"5 人全排列：5×4×3×2×1=120。","verify":"factorial(5)"},{"id":"cnm_h235_q2","topicId":"cnm_h235","difficulty":"basic","type":"numeric","prompt":"7 本不同的书分给甲、乙、丙三人，每人 1 本。有多少种分法？","answer":"210","explanation":"人不同，书的分配有顺序，A(7,3)=7×6×5=210。","verify":"perm(7,3)"},{"id":"cnm_h235_q3","topicId":"cnm_h235","difficulty":"standard","type":"numeric","prompt":"用数字 1、2、3、4，每个数字最多用一次，能组成多少个三位数？","answer":"24","explanation":"百位、十位、个位是排列，A(4,3)=24。","verify":"perm(4,3)"},{"id":"cnm_h235_q4","topicId":"cnm_h235","difficulty":"standard","type":"choice","prompt":"把 3 本不同的书分给 3 个不同的人，每人 1 本。这是哪一种计数？","choices":[{"key":"A","text":"从 3 本里选 1 本的组合"},{"key":"B","text":"把 3 本书的数目相加"},{"key":"C","text":"不计谁拿到哪一本"},{"key":"D","text":"3 个元素的全排列"}],"answer":"D","explanation":"人不同，谁拿哪一本要区分，所以是全排列。","verify":"\"3 个元素的全排列\""},{"id":"cnm_h236_q1","topicId":"cnm_h236","difficulty":"basic","type":"choice","prompt":"下面哪一项是组合？","choices":[{"key":"A","text":"从 4 名同学中选 2 名排成一队"},{"key":"B","text":"从 4 名同学中选 2 名参加会议，不计先后"},{"key":"C","text":"用 3 个不同数字组成三位数"},{"key":"D","text":"5 个人站成前后不同的一排"}],"answer":"B","explanation":"组合只关心选了哪些人，不排列顺序。","verify":"\"从 4 名同学中选 2 名参加会议，不计先后\""},{"id":"cnm_h236_q2","topicId":"cnm_h236","difficulty":"basic","type":"numeric","prompt":"从 4 个不同元素中取出 2 个，不计顺序。有多少种取法？","answer":"6","explanation":"有顺序时是 12 种，去掉顺序后每种组合对应 2 种排列，12/2=6。","verify":"comb(4,2)"},{"id":"cnm_h236_q3","topicId":"cnm_h236","difficulty":"standard","type":"numeric","prompt":"从 5 名同学中选 2 名值日，不计谁先谁后。有多少种选法？","answer":"10","explanation":"C(5,2)=10。","verify":"comb(5,2)"},{"id":"cnm_h236_q4","topicId":"cnm_h236","difficulty":"standard","type":"choice","prompt":"一组元素如果只是交换顺序，作为组合应当怎样算？","choices":[{"key":"A","text":"仍然是同一种组合"},{"key":"B","text":"变成另一种组合"},{"key":"C","text":"变成排列数的阶乘"},{"key":"D","text":"不能再称为组合"}],"answer":"A","explanation":"组合不区分顺序。交换顺序不产生新的组合。","verify":"\"仍然是同一种组合\""},{"id":"cnm_h237_q1","topicId":"cnm_h237","difficulty":"basic","type":"numeric","prompt":"C(6,2) 等于多少？","answer":"15","explanation":"6×5/2=15。","verify":"comb(6,2)"},{"id":"cnm_h237_q2","topicId":"cnm_h237","difficulty":"basic","type":"numeric","prompt":"C(5,0) 等于多少？","answer":"1","explanation":"一个都不取，只有 1 种空的取法。","verify":"comb(5,0)"},{"id":"cnm_h237_q3","topicId":"cnm_h237","difficulty":"standard","type":"numeric","prompt":"C(10,3) 等于多少？","answer":"120","explanation":"10×9×8/(3×2×1)=120。","verify":"comb(10,3)"},{"id":"cnm_h237_q4","topicId":"cnm_h237","difficulty":"standard","type":"choice","prompt":"C(n,k) 和 A(n,k) 的关系是什么？","choices":[{"key":"A","text":"组合数等于排列数乘以 k"},{"key":"B","text":"组合数等于排列数除以 k 的阶乘"},{"key":"C","text":"组合数等于 n 的阶乘"},{"key":"D","text":"两者总是相等"}],"answer":"B","explanation":"每种组合内部还有 k! 种排列，所以 C(n,k)=A(n,k)/k!。","verify":"\"组合数等于排列数除以 k 的阶乘\""},{"id":"cnm_h238_q1","topicId":"cnm_h238","difficulty":"basic","type":"numeric","prompt":"已知 C(8,3)=C(8,5)。C(8,5) 等于多少？","answer":"56","explanation":"C(8,5)=C(8,3)=56。","verify":"comb(8,5)"},{"id":"cnm_h238_q2","topicId":"cnm_h238","difficulty":"basic","type":"numeric","prompt":"C(6,2)+C(6,3) 等于多少？","answer":"35","explanation":"15+20=35，也等于 C(7,3)。","verify":"comb(6,2)+comb(6,3)"},{"id":"cnm_h238_q3","topicId":"cnm_h238","difficulty":"standard","type":"choice","prompt":"C(n,k) 等于下面哪一个？","choices":[{"key":"A","text":"C(k,n)"},{"key":"B","text":"C(n,n−k)"},{"key":"C","text":"C(n,k)+n"},{"key":"D","text":"A(n,n−k)"}],"answer":"B","explanation":"取出 k 个和留下 k 个是同一件事的两面，所以 C(n,k)=C(n,n−k)。","verify":"\"C(n,n−k)\""},{"id":"cnm_h238_q4","topicId":"cnm_h238","difficulty":"standard","type":"numeric","prompt":"C(5,1)+C(5,2) 等于多少？","answer":"15","explanation":"5+10=15。","verify":"comb(5,1)+comb(5,2)"},{"id":"cnm_h239_q1","topicId":"cnm_h239","difficulty":"basic","type":"numeric","prompt":"从 6 名同学中选 3 人参加活动，不计顺序。有多少种选法？","answer":"20","explanation":"C(6,3)=20。","verify":"comb(6,3)"},{"id":"cnm_h239_q2","topicId":"cnm_h239","difficulty":"basic","type":"numeric","prompt":"5 名男生、4 名女生中，选 2 名男生和 1 名女生。有多少种选法？","answer":"40","explanation":"男生 C(5,2)=10，女生 C(4,1)=4，相乘得 40。","verify":"comb(5,2)*comb(4,1)"},{"id":"cnm_h239_q3","topicId":"cnm_h239","difficulty":"standard","type":"numeric","prompt":"10 件产品里有 2 件次品。抽 3 件，恰有 1 件次品的抽法有多少种？","answer":"56","explanation":"次品里选 1 件有 2 种，合格品里选 2 件有 28 种，2×28=56。","verify":"comb(2,1)*comb(8,2)"},{"id":"cnm_h239_q4","topicId":"cnm_h239","difficulty":"standard","type":"choice","prompt":"从 8 人中选 3 人组成小组，不设职务。应该用什么？","choices":[{"key":"A","text":"排列数 A(8,3)"},{"key":"B","text":"8+3"},{"key":"C","text":"8 的阶乘"},{"key":"D","text":"组合数 C(8,3)"}],"answer":"D","explanation":"小组内部不计顺序，也不设不同职务，所以用组合。","verify":"\"组合数 C(8,3)\""}]
