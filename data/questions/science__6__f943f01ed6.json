[{"id":"cns_p191_q1","topicId":"cns_p191","difficulty":"basic","type":"choice","prompt":"下面哪一个是光源？","choices":[{"key":"A","text":"太阳"},{"key":"B","text":"月亮"},{"key":"C","text":"镜子"},{"key":"D","text":"黑板"}],"answer":"A","explanation":"自己能发光的物体叫光源。月亮反射太阳光。","verify":"\"太阳\""},{"id":"cns_p191_q2","topicId":"cns_p191","difficulty":"basic","type":"choice","prompt":"我们能看到书本，是因为什么？","choices":[{"key":"A","text":"眼睛发出光照亮书"},{"key":"B","text":"书本反射的光进入了眼睛"},{"key":"C","text":"书本自己发光"},{"key":"D","text":"书本是透明的"}],"answer":"B","explanation":"物体反射的光进入眼睛才能看到。","verify":"\"书本反射的光进入了眼睛\""},{"id":"cns_p191_q3","topicId":"cns_p191","difficulty":"standard","type":"choice","prompt":"在完全没有光的密室中，能看见红色的苹果吗？","choices":[{"key":"A","text":"能，看得很清楚"},{"key":"B","text":"只能看见红色"},{"key":"C","text":"不能"},{"key":"D","text":"能看见轮廓"}],"answer":"C","explanation":"没有光进入眼睛，就看不见。","verify":"\"不能\""},{"id":"cns_p191_q4","topicId":"cns_p191","difficulty":"challenge","type":"choice","prompt":"下面哪一组都是光源？","choices":[{"key":"A","text":"月亮、镜子"},{"key":"B","text":"钻石、玻璃"},{"key":"C","text":"没点亮的灯泡、萤火虫"},{"key":"D","text":"点亮的电灯、燃烧的蜡烛"}],"answer":"D","explanation":"电灯亮时、蜡烛燃烧时自己发光。","verify":"\"点亮的电灯、燃烧的蜡烛\""},{"id":"cns_p192_q1","topicId":"cns_p192","difficulty":"basic","type":"choice","prompt":"光在空气中是怎样传播的？","choices":[{"key":"A","text":"沿曲线"},{"key":"B","text":"沿直线"},{"key":"C","text":"绕着走"},{"key":"D","text":"不传播"}],"answer":"B","explanation":"光在均匀介质中沿直线传播。","verify":"\"沿直线\""},{"id":"cns_p192_q2","topicId":"cns_p192","difficulty":"basic","type":"choice","prompt":"影子的形成说明了什么？","choices":[{"key":"A","text":"光会拐弯"},{"key":"B","text":"光是黑色的"},{"key":"C","text":"光沿直线传播，被不透明物体挡住"},{"key":"D","text":"物体会发黑光"}],"answer":"C","explanation":"光被挡住，后面就形成影子。","verify":"\"光沿直线传播，被不透明物体挡住\""},{"id":"cns_p192_q3","topicId":"cns_p192","difficulty":"standard","type":"choice","prompt":"把三张打了小孔的卡片排成一排，只有小孔怎样时，才能看到后面的烛光？","choices":[{"key":"A","text":"孔随便放"},{"key":"B","text":"孔越大越好就行"},{"key":"C","text":"卡片越多越好"},{"key":"D","text":"三个小孔在同一条直线上"}],"answer":"D","explanation":"光沿直线传播。","verify":"\"三个小孔在同一条直线上\""},{"id":"cns_p192_q4","topicId":"cns_p192","difficulty":"challenge","type":"choice","prompt":"小孔成像中，屏幕上的烛焰像是怎样的？","choices":[{"key":"A","text":"倒立的"},{"key":"B","text":"正立的"},{"key":"C","text":"没有像"},{"key":"D","text":"横着的"}],"answer":"A","explanation":"光沿直线穿过小孔，上下交换，形成倒像。","verify":"\"倒立的\""},{"id":"cns_p193_q1","topicId":"cns_p193","difficulty":"basic","type":"choice","prompt":"下面哪样物体是透明的？","choices":[{"key":"A","text":"木板"},{"key":"B","text":"铁片"},{"key":"C","text":"干净的玻璃"},{"key":"D","text":"书本"}],"answer":"C","explanation":"光能大量穿过透明物体。","verify":"\"干净的玻璃\""},{"id":"cns_p193_q2","topicId":"cns_p193","difficulty":"basic","type":"choice","prompt":"磨砂玻璃让光透过，但看不清后面的东西，它属于什么？","choices":[{"key":"A","text":"透明物体"},{"key":"B","text":"不透明物体"},{"key":"C","text":"光源"},{"key":"D","text":"半透明物体"}],"answer":"D","explanation":"部分光透过，看不清后面。","verify":"\"半透明物体\""},{"id":"cns_p193_q3","topicId":"cns_p193","difficulty":"standard","type":"choice","prompt":"下面哪种物体会形成清晰的影子？","choices":[{"key":"A","text":"不透明的木块"},{"key":"B","text":"透明的玻璃"},{"key":"C","text":"清水"},{"key":"D","text":"空气"}],"answer":"A","explanation":"不透明物体完全挡住光。","verify":"\"不透明的木块\""},{"id":"cns_p193_q4","topicId":"cns_p193","difficulty":"challenge","type":"choice","prompt":"为什么教室的窗户用透明玻璃，而浴室窗户多用磨砂玻璃？","choices":[{"key":"A","text":"磨砂玻璃更结实"},{"key":"B","text":"教室要明亮通透，浴室要透光又保护隐私"},{"key":"C","text":"透明玻璃不透光"},{"key":"D","text":"没有原因"}],"answer":"B","explanation":"不同需要选择不同透光性能的材料。","verify":"\"教室要明亮通透，浴室要透光又保护隐私\""},{"id":"cns_p194_q1","topicId":"cns_p194","difficulty":"basic","type":"choice","prompt":"光照到镜子上会怎样？","choices":[{"key":"A","text":"被吃掉"},{"key":"B","text":"穿过镜子"},{"key":"C","text":"停在镜面上"},{"key":"D","text":"被反射回来"}],"answer":"D","explanation":"镜面能很好地反射光。","verify":"\"被反射回来\""},{"id":"cns_p194_q2","topicId":"cns_p194","difficulty":"basic","type":"choice","prompt":"用镜子把阳光反射到墙上，光斑会随镜子转动而怎样？","choices":[{"key":"A","text":"移动"},{"key":"B","text":"不动"},{"key":"C","text":"消失"},{"key":"D","text":"变黑"}],"answer":"A","explanation":"转动镜子改变了反射方向。","verify":"\"移动\""},{"id":"cns_p194_q3","topicId":"cns_p194","difficulty":"standard","type":"choice","prompt":"下面哪种现象和光的反射有关？","choices":[{"key":"A","text":"影子的形成"},{"key":"B","text":"平静的湖面映出岸边的树"},{"key":"C","text":"日食"},{"key":"D","text":"小孔成像"}],"answer":"B","explanation":"倒影是光的反射形成的。","verify":"\"平静的湖面映出岸边的树\""},{"id":"cns_p194_q4","topicId":"cns_p194","difficulty":"challenge","type":"choice","prompt":"为了不让开车的人被路边强光晃眼，玻璃幕墙会造成什么问题？","choices":[{"key":"A","text":"让光变直"},{"key":"B","text":"使光消失"},{"key":"C","text":"反射强光，形成光污染"},{"key":"D","text":"让夜晚变暗"}],"answer":"C","explanation":"大面积镜面反射会造成光污染。","verify":"\"反射强光，形成光污染\""},{"id":"cns_p195_q1","topicId":"cns_p195","difficulty":"basic","type":"choice","prompt":"潜望镜里用到了几面平面镜？","choices":[{"key":"A","text":"两面"},{"key":"B","text":"一面"},{"key":"C","text":"三面"},{"key":"D","text":"不用镜子"}],"answer":"A","explanation":"两面镜子把光反射两次。","verify":"\"两面\""},{"id":"cns_p195_q2","topicId":"cns_p195","difficulty":"basic","type":"choice","prompt":"潜望镜中的平面镜与镜筒大约成多少度角？","choices":[{"key":"A","text":"90 度"},{"key":"B","text":"45 度"},{"key":"C","text":"30 度"},{"key":"D","text":"0 度"}],"answer":"B","explanation":"45 度能把光转折 90 度。","verify":"\"45 度\""},{"id":"cns_p195_q3","topicId":"cns_p195","difficulty":"standard","type":"choice","prompt":"潜望镜主要利用了光的什么性质？","choices":[{"key":"A","text":"折射"},{"key":"B","text":"直线传播"},{"key":"C","text":"反射"},{"key":"D","text":"色散"}],"answer":"C","explanation":"平面镜反射改变光的方向。","verify":"\"反射\""},{"id":"cns_p195_q4","topicId":"cns_p195","difficulty":"challenge","type":"choice","prompt":"自制潜望镜里只能看到一片模糊的亮光，最可能的原因是？","choices":[{"key":"A","text":"纸筒太长"},{"key":"B","text":"颜色太深"},{"key":"C","text":"镜子太干净"},{"key":"D","text":"镜子的角度没调好"}],"answer":"D","explanation":"两面镜子平行且都成 45 度，才能看清景物。","verify":"\"镜子的角度没调好\""},{"id":"cns_p196_q1","topicId":"cns_p196","difficulty":"basic","type":"choice","prompt":"雨后天空出现彩虹，说明阳光怎样？","choices":[{"key":"A","text":"只有白色"},{"key":"B","text":"由多种颜色的光组成"},{"key":"C","text":"只有红色"},{"key":"D","text":"是黑色的"}],"answer":"B","explanation":"阳光经过小水滴被分解成多种色光。","verify":"\"由多种颜色的光组成\""},{"id":"cns_p196_q2","topicId":"cns_p196","difficulty":"basic","type":"choice","prompt":"用什么可以把阳光分解成彩色光带？","choices":[{"key":"A","text":"平面镜"},{"key":"B","text":"木板"},{"key":"C","text":"三棱镜"},{"key":"D","text":"放大镜"}],"answer":"C","explanation":"三棱镜能使阳光色散。","verify":"\"三棱镜\""},{"id":"cns_p196_q3","topicId":"cns_p196","difficulty":"standard","type":"choice","prompt":"彩虹通常出现在什么时候？","choices":[{"key":"A","text":"半夜"},{"key":"B","text":"阴天无阳光"},{"key":"C","text":"大雪时"},{"key":"D","text":"雨后天晴，太阳在观察者背后"}],"answer":"D","explanation":"有阳光、空中有小水滴才能形成。","verify":"\"雨后天晴，太阳在观察者背后\""},{"id":"cns_p196_q4","topicId":"cns_p196","difficulty":"challenge","type":"choice","prompt":"背对太阳，用喷壶向空中喷水雾，可能看到什么？","choices":[{"key":"A","text":"彩虹"},{"key":"B","text":"日食"},{"key":"C","text":"月食"},{"key":"D","text":"流星"}],"answer":"A","explanation":"细小水滴把阳光分解，形成人造彩虹。","verify":"\"彩虹\""}]
