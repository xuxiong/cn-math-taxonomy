[{"id":"cnm_h001_q1","topicId":"cnm_h001","difficulty":"basic","type":"choice","prompt":"下面哪一组对象可以组成集合？","choices":[{"key":"A","text":"比较高的同学"},{"key":"B","text":"漂亮的花"},{"key":"C","text":"全体正整数"},{"key":"D","text":"很大的数"}],"answer":"C","explanation":"组成集合的对象必须确定。全体正整数有明确标准；另外三组没有明确标准，不能组成集合。","verify":"\"全体正整数\""},{"id":"cnm_h001_q2","topicId":"cnm_h001","difficulty":"basic","type":"numeric","prompt":"把 1，2，2，3 写成集合后，不同元素有几个？","answer":"3","explanation":"集合里的元素互不相同，1，2，2，3 只保留 1、2、3，共 3 个。","verify":"len([1,2,3])"},{"id":"cnm_h001_q3","topicId":"cnm_h001","difficulty":"standard","type":"choice","prompt":"空集是怎样的集合？","choices":[{"key":"A","text":"不含任何元素的集合"},{"key":"B","text":"只含 0 的集合"},{"key":"C","text":"只含一个元素的集合"},{"key":"D","text":"元素都相等的集合"}],"answer":"A","explanation":"空集一个元素都没有。只含 0 的集合有一个元素，不是空集。","verify":"\"不含任何元素的集合\""},{"id":"cnm_h001_q4","topicId":"cnm_h001","difficulty":"standard","type":"choice","prompt":"「很小的正数」能不能组成集合？","choices":[{"key":"A","text":"能，正数都是确定的"},{"key":"B","text":"不能，因为「很小」没有明确标准"},{"key":"C","text":"能，但只能是有限集"},{"key":"D","text":"不能，因为正数有无穷多个"}],"answer":"B","explanation":"集合要求对象确定。无穷多个可以组成集合，例如全体正整数；「很小」标准不明，所以不能。","verify":"\"不能，因为「很小」没有明确标准\""},{"id":"cnm_h002_q1","topicId":"cnm_h002","difficulty":"basic","type":"numeric","prompt":"集合 {0，2，4，6} 中的偶数个数是多少？","answer":"4","explanation":"0、2、4、6 都是偶数，4 个元素全部计入。","verify":"len([0,2,4,6])"},{"id":"cnm_h002_q2","topicId":"cnm_h002","difficulty":"basic","type":"choice","prompt":"2 与集合 {1，2，3} 的关系是？","choices":[{"key":"A","text":"2 属于这个集合"},{"key":"B","text":"2 不属于这个集合"},{"key":"C","text":"{2} 属于这个集合"},{"key":"D","text":"2 是这个集合的子集"}],"answer":"A","explanation":"2 是集合里的一个元素，所以 2 属于该集合。元素和子集不是同一种关系。","verify":"\"2 属于这个集合\""},{"id":"cnm_h002_q3","topicId":"cnm_h002","difficulty":"standard","type":"numeric","prompt":"集合 {1，3，5，7，9} 中大于 6 的元素有几个？","answer":"2","explanation":"大于 6 的元素是 7 和 9，共 2 个。","verify":"len([7,9])"},{"id":"cnm_h002_q4","topicId":"cnm_h002","difficulty":"standard","type":"choice","prompt":"集合 {1，2，2} 里，元素 2 写了两次。按互异性，它能否算成两个不同的元素？","choices":[{"key":"A","text":"能，只要都写出来"},{"key":"B","text":"能，但要加括号"},{"key":"C","text":"不能，元素互不相同"},{"key":"D","text":"只有无限集才不能"}],"answer":"C","explanation":"集合中的元素互异。{1，2，2} 与 {1，2} 是同一个集合，重复写出的 2 只算一个元素。","verify":"\"不能，元素互不相同\""},{"id":"cnm_h003_q1","topicId":"cnm_h003","difficulty":"basic","type":"numeric","prompt":"用列举法写出小于 6 的正整数，元素有几个？","answer":"5","explanation":"小于 6 的正整数是 1、2、3、4、5，共 5 个。","verify":"len([1,2,3,4,5])"},{"id":"cnm_h003_q2","topicId":"cnm_h003","difficulty":"basic","type":"numeric","prompt":"集合 {1，2，3} 的元素个数是多少？","answer":"3","explanation":"列举出来的三个数互不相同，元素个数是 3。","verify":"len([1,2,3])"},{"id":"cnm_h003_q3","topicId":"cnm_h003","difficulty":"standard","type":"numeric","prompt":"不超过 10 的正偶数有几个？","answer":"5","explanation":"正偶数 2、4、6、8、10 都不超过 10，共 5 个。","verify":"len([2,4,6,8,10])"},{"id":"cnm_h003_q4","topicId":"cnm_h003","difficulty":"standard","type":"choice","prompt":"用列举法表示集合时，下面哪种说法正确？","choices":[{"key":"A","text":"必须从小到大写"},{"key":"B","text":"每个元素至少写两遍"},{"key":"C","text":"只能表示无限集"},{"key":"D","text":"元素次序可以交换，集合不变"}],"answer":"D","explanation":"列举法不关心书写顺序。{1，2} 和 {2，1} 是同一个集合。","verify":"\"元素次序可以交换，集合不变\""},{"id":"cnm_h004_q1","topicId":"cnm_h004","difficulty":"basic","type":"numeric","prompt":"集合 {x | x 是小于 4 的正整数} 有几个元素？","answer":"3","explanation":"小于 4 的正整数是 1、2、3，共 3 个。","verify":"len([1,2,3])"},{"id":"cnm_h004_q2","topicId":"cnm_h004","difficulty":"basic","type":"numeric","prompt":"集合 {x | x 是 12 的正约数} 有几个元素？","answer":"6","explanation":"12 的正约数是 1、2、3、4、6、12，共 6 个。","verify":"len([1,2,3,4,6,12])"},{"id":"cnm_h004_q3","topicId":"cnm_h004","difficulty":"standard","type":"choice","prompt":"全体整数更适合用哪种方法表示？","choices":[{"key":"A","text":"列举法"},{"key":"B","text":"只能画图"},{"key":"C","text":"只能写空集"},{"key":"D","text":"描述法"}],"answer":"D","explanation":"整数有无限多个，不能一一列举完，适合用描述法。","verify":"\"描述法\""},{"id":"cnm_h004_q4","topicId":"cnm_h004","difficulty":"standard","type":"choice","prompt":"{x | x>0} 里的 x 表示什么？","choices":[{"key":"A","text":"满足 x>0 的数"},{"key":"B","text":"只有 1 这一个数"},{"key":"C","text":"大于 0 的集合的个数"},{"key":"D","text":"方程的解的个数"}],"answer":"A","explanation":"描述法里竖线右边是元素要满足的条件，x 代表所有满足条件的元素。","verify":"\"满足 x>0 的数\""}]
