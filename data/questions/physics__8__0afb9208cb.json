[{"id":"cnp_038_q1","topicId":"cnp_038","difficulty":"basic","type":"choice","prompt":"首先证明大气压存在的著名实验是什么？","choices":[{"key":"A","text":"托里拆利实验"},{"key":"B","text":"伽利略斜面实验"},{"key":"C","text":"奥斯特实验"},{"key":"D","text":"马德堡半球实验"}],"answer":"D","explanation":"马德堡半球实验证明了大气压的存在；托里拆利实验测出了大气压的值。","verify":"\"马德堡半球实验\""},{"id":"cnp_038_q2","topicId":"cnp_038","difficulty":"basic","type":"choice","prompt":"用吸管吸饮料，饮料是被什么压进嘴里的？","choices":[{"key":"A","text":"嘴的吸力"},{"key":"B","text":"饮料的重力"},{"key":"C","text":"吸管的弹力"},{"key":"D","text":"大气压"}],"answer":"D","explanation":"吸气使管内气压减小，外界大气压把饮料压进嘴里。","verify":"\"大气压\""},{"id":"cnp_038_q3","topicId":"cnp_038","difficulty":"standard","type":"choice","prompt":"1 个标准大气压能支持多高的水银柱？","choices":[{"key":"A","text":"76 mm"},{"key":"B","text":"10.3 m"},{"key":"C","text":"760 mm"},{"key":"D","text":"1 m"}],"answer":"C","explanation":"托里拆利实验中标准大气压能支持约 760 mm 高的水银柱（能支持约 10.3 m 高的水柱）。","verify":"760"},{"id":"cnp_038_q4","topicId":"cnp_038","difficulty":"standard","type":"choice","prompt":"登山运动员登上高山后，大气压会怎样变化？","choices":[{"key":"A","text":"增大"},{"key":"B","text":"不变"},{"key":"C","text":"减小"},{"key":"D","text":"先减小后增大"}],"answer":"C","explanation":"大气压随海拔高度增加而减小。","verify":"\"减小\""}]
