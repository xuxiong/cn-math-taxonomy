[{"id":"cnp_050_q1","topicId":"cnp_050","difficulty":"basic","type":"choice","prompt":"杆秤是利用什么原理称量物体质量的？","choices":[{"key":"A","text":"二力平衡"},{"key":"B","text":"阿基米德原理"},{"key":"C","text":"连通器原理"},{"key":"D","text":"杠杆平衡条件"}],"answer":"D","explanation":"杆秤是一种杠杆，秤砣移动改变力臂，使杆秤平衡。","verify":"\"杠杆平衡条件\""},{"id":"cnp_050_q2","topicId":"cnp_050","difficulty":"basic","type":"choice","prompt":"杆秤的刻度分布有什么特点？","choices":[{"key":"A","text":"均匀"},{"key":"B","text":"越往外越密"},{"key":"C","text":"越往外越疏"},{"key":"D","text":"没有规律"}],"answer":"A","explanation":"被称物体质量与秤砣到提纽的距离成一次关系，所以刻度均匀。","verify":"\"均匀\""},{"id":"cnp_050_q3","topicId":"cnp_050","difficulty":"standard","type":"choice","prompt":"如果秤砣被磨损掉一些，用这杆秤称物体，读数会怎样？","choices":[{"key":"A","text":"偏大"},{"key":"B","text":"偏小"},{"key":"C","text":"不变"},{"key":"D","text":"无法读数"}],"answer":"A","explanation":"秤砣变轻，要平衡同一物体需把秤砣往外移，读数偏大。","verify":"\"偏大\""},{"id":"cnp_050_q4","topicId":"cnp_050","difficulty":"standard","type":"numeric","prompt":"简易杆秤的提纽到挂钩的距离为 5 cm，秤砣质量 100 g，称某物体时秤砣挂在提纽另一侧 20 cm 处平衡（不计秤杆自重），物体质量是多少 g？（只填数值）","answer":"400","explanation":"m物 × 5 = 100 × 20，m物 = 400 g。","verify":"100*20/5"}]
