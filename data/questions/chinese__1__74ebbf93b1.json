[{"id":"cnc_p034_q1","topicId":"cnc_p034","difficulty":"basic","type":"choice","prompt":"弯弯的月儿被比作什么？","choices":[{"key":"A","text":"小小的桥"},{"key":"B","text":"圆圆的盘"},{"key":"C","text":"高高的树"},{"key":"D","text":"小小的船"}],"answer":"D","explanation":"课文说弯弯的月儿小小的船。桥、树都不是这篇课文的比方。","verify":"\"小小的船\""},{"id":"cnc_p034_q2","topicId":"cnc_p034","difficulty":"basic","type":"choice","prompt":"「小小的船儿两头尖」写的是月儿的什么样子？","choices":[{"key":"A","text":"两头尖尖的"},{"key":"B","text":"四四方方的"},{"key":"C","text":"圆得像皮球"},{"key":"D","text":"尖的一头朝下"}],"answer":"A","explanation":"弯弯的月儿两头尖，所以说小小的船儿两头尖。","verify":"\"两头尖尖的\""},{"id":"cnc_p034_q3","topicId":"cnc_p034","difficulty":"standard","type":"choice","prompt":"「我」坐在小小的船里，看见了什么？","choices":[{"key":"A","text":"红红的太阳"},{"key":"B","text":"闪闪的星星和蓝蓝的天"},{"key":"C","text":"绿绿的荷叶"},{"key":"D","text":"黄黄的落叶"}],"answer":"B","explanation":"课文写只看见闪闪的星星蓝蓝的天，没有写太阳和荷叶。","verify":"\"闪闪的星星和蓝蓝的天\""},{"id":"cnc_p034_q4","topicId":"cnc_p034","difficulty":"standard","type":"choice","prompt":"《小小的船》的作者是谁？","choices":[{"key":"A","text":"骆宾王"},{"key":"B","text":"李白"},{"key":"C","text":"叶圣陶"},{"key":"D","text":"杜甫"}],"answer":"C","explanation":"《小小的船》是叶圣陶的课文。骆宾王写《咏鹅》，李白写《静夜思》。","verify":"\"叶圣陶\""},{"id":"cnc_p035_q1","topicId":"cnc_p035","difficulty":"basic","type":"choice","prompt":"课文把影子比作什么？","choices":[{"key":"A","text":"一条小黑狗"},{"key":"B","text":"一只小白兔"},{"key":"C","text":"一艘小船"},{"key":"D","text":"一棵大树"}],"answer":"A","explanation":"影子常常跟着我，就像一条小黑狗。","verify":"\"一条小黑狗\""},{"id":"cnc_p035_q2","topicId":"cnc_p035","difficulty":"basic","type":"choice","prompt":"影子在前、影子在后，是为了说明什么？","choices":[{"key":"A","text":"影子会自己回家"},{"key":"B","text":"影子老跟着「我」"},{"key":"C","text":"影子只在中午出现"},{"key":"D","text":"影子是真的小狗"}],"answer":"B","explanation":"影子在前也在后，还在左在右，都是说它常常跟着人、陪着人。","verify":"\"影子老跟着「我」\""},{"id":"cnc_p035_q3","topicId":"cnc_p035","difficulty":"standard","type":"choice","prompt":"「它是我的好朋友」里的「它」指谁？","choices":[{"key":"A","text":"小狗"},{"key":"B","text":"太阳"},{"key":"C","text":"影子"},{"key":"D","text":"同学"}],"answer":"C","explanation":"课文把影子当成好朋友来写，不是真的去找一只小狗。","verify":"\"影子\""},{"id":"cnc_p035_q4","topicId":"cnc_p035","difficulty":"standard","type":"choice","prompt":"哪一句和课文意思一致？","choices":[{"key":"A","text":"影子天亮以后就不见，再也不来"},{"key":"B","text":"影子只会走在我左边"},{"key":"C","text":"影子要牵着绳子才跟着走"},{"key":"D","text":"影子常常跟着我、陪着我"}],"answer":"D","explanation":"课文写影子常常跟着我，也常常陪着我，像好朋友。","verify":"\"影子常常跟着我、陪着我\""},{"id":"cnc_p036_q1","topicId":"cnc_p036","difficulty":"basic","type":"choice","prompt":"人的两件宝是什么？","choices":[{"key":"A","text":"书包和铅笔"},{"key":"B","text":"双手和大脑"},{"key":"C","text":"太阳和月亮"},{"key":"D","text":"影子和小狗"}],"answer":"B","explanation":"课文说人有两件宝，双手和大脑。书包、太阳和影子都不是这两件宝。","verify":"\"双手和大脑\""},{"id":"cnc_p036_q2","topicId":"cnc_p036","difficulty":"basic","type":"choice","prompt":"双手和大脑各会做什么？","choices":[{"key":"A","text":"双手会思考，大脑会做工"},{"key":"B","text":"双手会睡觉，大脑会跑步"},{"key":"C","text":"双手会做工，大脑会思考"},{"key":"D","text":"双手会飞翔，大脑会游泳"}],"answer":"C","explanation":"双手会做工，大脑会思考。不要把两样对换。","verify":"\"双手会做工，大脑会思考\""},{"id":"cnc_p036_q3","topicId":"cnc_p036","difficulty":"standard","type":"choice","prompt":"「用手不用脑」会怎样？","choices":[{"key":"A","text":"才能有创造"},{"key":"B","text":"事情一定做得更好"},{"key":"C","text":"啥都能办到"},{"key":"D","text":"事情做不好"}],"answer":"D","explanation":"只用手、不用脑，事情做不好。创造要手和脑一起用。","verify":"\"事情做不好\""},{"id":"cnc_p036_q4","topicId":"cnc_p036","difficulty":"standard","type":"choice","prompt":"怎样才能有创造？","choices":[{"key":"A","text":"用手又用脑"},{"key":"B","text":"只用手不用脑"},{"key":"C","text":"只用脑不用手"},{"key":"D","text":"手和脑都不用"}],"answer":"A","explanation":"课文最后说：用手又用脑，才能有创造。只用一样，办不好。","verify":"\"用手又用脑\""},{"id":"cnc_p037_q1","topicId":"cnc_p037","difficulty":"basic","type":"choice","prompt":"在图书馆里，应该怎样说话？","choices":[{"key":"A","text":"大声喊叫"},{"key":"B","text":"敲着桌子说话"},{"key":"C","text":"小声说"},{"key":"D","text":"对着别人的耳朵大叫"}],"answer":"C","explanation":"图书馆里要安静，说话用小声。喊叫会打扰别人看书。","verify":"\"小声说\""},{"id":"cnc_p037_q2","topicId":"cnc_p037","difficulty":"basic","type":"choice","prompt":"同学在操场远处，想叫他过来，应该怎样？","choices":[{"key":"A","text":"小声嘀咕，不让他听见"},{"key":"B","text":"完全不出声"},{"key":"C","text":"等走到他面前才许发出声音"},{"key":"D","text":"大声叫，让他听见"}],"answer":"D","explanation":"人离得远，声音太小就叫不应。这时候要大声。","verify":"\"大声叫，让他听见\""},{"id":"cnc_p037_q3","topicId":"cnc_p037","difficulty":"standard","type":"choice","prompt":"课堂上回答问题，声音应当怎样？","choices":[{"key":"A","text":"清楚响亮，让老师和同学听见"},{"key":"B","text":"小到只有自己听见"},{"key":"C","text":"比喊叫更大，盖过老师"},{"key":"D","text":"低头不回答"}],"answer":"A","explanation":"回答问题要让大家听见，所以要清楚响亮，但不是盖过别人乱喊。","verify":"\"清楚响亮，让老师和同学听见\""},{"id":"cnc_p037_q4","topicId":"cnc_p037","difficulty":"standard","type":"choice","prompt":"爷爷正在睡觉，说话应当怎样？","choices":[{"key":"A","text":"大声唱歌"},{"key":"B","text":"小声，免得吵醒他"},{"key":"C","text":"敲鼓叫醒他"},{"key":"D","text":"在他耳边喊"}],"answer":"B","explanation":"别人休息时要小声。唱歌、敲鼓、对着耳朵喊，都会吵醒人。","verify":"\"小声，免得吵醒他\""}]
