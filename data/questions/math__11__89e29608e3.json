[{"id":"cnm_h127_q1","topicId":"cnm_h127","difficulty":"basic","type":"numeric","prompt":"组距为 5，频率除以组距等于 0.04，样本容量为 50。这一组的频数是多少？","answer":"10","explanation":"频率=0.04×5=0.2，频数=0.2×50=10。","verify":"Fraction(4,100)*5*50"},{"id":"cnm_h127_q2","topicId":"cnm_h127","difficulty":"basic","type":"numeric","prompt":"两组的频率分别是 0.3 和 0.7。频率之和是多少？","answer":"1","explanation":"全部小长方形的面积之和是 1。","verify":"Fraction(3,10)+Fraction(7,10)"},{"id":"cnm_h127_q3","topicId":"cnm_h127","difficulty":"standard","type":"numeric","prompt":"组距为 10，某一组频数为 20，样本容量为 100。这一组的频率除以组距，结果用分数表示。","answer":"1/50","explanation":"频率=20/100=1/5，再除以组距 10，得到 1/50。","verify":"Fraction(20,100)/10"},{"id":"cnm_h127_q4","topicId":"cnm_h127","difficulty":"standard","type":"choice","prompt":"直方图中小长方形的高表示？","choices":[{"key":"A","text":"频数本身"},{"key":"B","text":"样本容量"},{"key":"C","text":"组距"},{"key":"D","text":"频率除以组距"}],"answer":"D","explanation":"用面积表示频率，所以高必须是频率/组距。组距不同时不能直接比高度当频率。","verify":"\"频率除以组距\""},{"id":"cnm_h128_q1","topicId":"cnm_h128","difficulty":"basic","type":"numeric","prompt":"样本容量 40，某组频率 0.25。这一组的频数是多少？","answer":"10","explanation":"0.25×40=10。","verify":"Fraction(1,4)*40"},{"id":"cnm_h128_q2","topicId":"cnm_h128","difficulty":"basic","type":"numeric","prompt":"甲组频率 0.2，乙组频率 0.35。乙组比甲组多出的频率是多少？","answer":"3/20","explanation":"0.35−0.20=0.15。","verify":"Fraction(35,100)-Fraction(20,100)"},{"id":"cnm_h128_q3","topicId":"cnm_h128","difficulty":"standard","type":"numeric","prompt":"样本容量 80，频率 1/5 的组有多少个数据？","answer":"16","explanation":"80/5=16。","verify":"Fraction(1,5)*80"},{"id":"cnm_h128_q4","topicId":"cnm_h128","difficulty":"standard","type":"choice","prompt":"组距相同的直方图里，更高的小长方形表示？","choices":[{"key":"A","text":"这一组的频率更大"},{"key":"B","text":"这一组的数据更小"},{"key":"C","text":"样本容量更大"},{"key":"D","text":"平均数更大"}],"answer":"A","explanation":"组距相同，高度与频率成正比。","verify":"\"这一组的频率更大\""},{"id":"cnm_h129_q1","topicId":"cnm_h129","difficulty":"basic","type":"numeric","prompt":"数据 1，2，3，4 已按从小到大排列，n=4。求第 50 百分位数。规则：i=n×50%；i 是整数时取第 i 个和第 i+1 个的平均数。","answer":"5/2","explanation":"i=2，取第 2 个和第 3 个，即 2 和 3，平均数是 5/2。","verify":"(sorted([1,2,3,4])[1]+sorted([1,2,3,4])[2])/2"},{"id":"cnm_h129_q2","topicId":"cnm_h129","difficulty":"basic","type":"numeric","prompt":"数据 2，4，6，8，10 已排好，n=5。求第 20 百分位数。i=n×20% 若是整数，取第 i 个和第 i+1 个的平均数。","answer":"3","explanation":"i=1，取第 1 个和第 2 个，即 2 和 4，平均数是 3。","verify":"(sorted([2,4,6,8,10])[0]+sorted([2,4,6,8,10])[1])/2"},{"id":"cnm_h129_q3","topicId":"cnm_h129","difficulty":"standard","type":"numeric","prompt":"数据 1，3，5，7，9 已排好，n=5。求第 50 百分位数。i=2.5 不是整数，取它后的第一个整数位置，也就是第 3 个。","answer":"5","explanation":"第 3 个是 5。","verify":"sorted([1,3,5,7,9])[2]"},{"id":"cnm_h129_q4","topicId":"cnm_h129","difficulty":"standard","type":"choice","prompt":"百分位数描述的是？","choices":[{"key":"A","text":"一定是平均数"},{"key":"B","text":"样本中处于某个百分比位置的数值"},{"key":"C","text":"一定是众数"},{"key":"D","text":"样本容量"}],"answer":"B","explanation":"它看的是排序后的位置，不是把所有数加起来平均。","verify":"\"样本中处于某个百分比位置的数值\""},{"id":"cnm_h130_q1","topicId":"cnm_h130","difficulty":"basic","type":"numeric","prompt":"样本 2，4，6，8 的平均数是多少？","answer":"5","explanation":"(2+4+6+8)/4=5。","verify":"mean([2,4,6,8])"},{"id":"cnm_h130_q2","topicId":"cnm_h130","difficulty":"basic","type":"numeric","prompt":"样本 1，3，3，7 的中位数是多少？","answer":"3","explanation":"排序后中间两个数都是 3，中位数是 3。","verify":"median([1,3,3,7])"},{"id":"cnm_h130_q3","topicId":"cnm_h130","difficulty":"standard","type":"numeric","prompt":"样本 1，2，9 的平均数是多少？","answer":"4","explanation":"(1+2+9)/3=4。","verify":"mean([1,2,9])"},{"id":"cnm_h130_q4","topicId":"cnm_h130","difficulty":"standard","type":"choice","prompt":"数据里有一个特别大的数时，估计总体中心更稳健的常常是？","choices":[{"key":"A","text":"一定改用极差"},{"key":"B","text":"只看最大数"},{"key":"C","text":"中位数"},{"key":"D","text":"样本容量"}],"answer":"C","explanation":"中位数不受两端极端值的拉动，平均数会被拉开。","verify":"\"中位数\""},{"id":"cnm_h131_q1","topicId":"cnm_h131","difficulty":"basic","type":"numeric","prompt":"数据 2，4，4，6 的极差是多少？","answer":"4","explanation":"最大减最小，6−2=4。","verify":"6-2"},{"id":"cnm_h131_q2","topicId":"cnm_h131","difficulty":"basic","type":"numeric","prompt":"数据 2，4，4，6 的方差是多少？按除以 n 计算。","answer":"2","explanation":"平均数是 4，偏差平方和是 8，除以 4 得 2。","verify":"pvariance([2,4,4,6])"},{"id":"cnm_h131_q3","topicId":"cnm_h131","difficulty":"standard","type":"numeric","prompt":"数据 5，5，5 的方差是多少？按除以 n 计算。","answer":"0","explanation":"每个数都等于平均数，方差是 0。","verify":"pvariance([5,5,5])"},{"id":"cnm_h131_q4","topicId":"cnm_h131","difficulty":"standard","type":"choice","prompt":"方差越大，表示？","choices":[{"key":"A","text":"平均数越大"},{"key":"B","text":"数据个数越多"},{"key":"C","text":"中位数越大"},{"key":"D","text":"数据波动越大"}],"answer":"D","explanation":"方差衡量离开平均数的程度，不直接等于平均数。","verify":"\"数据波动越大\""},{"id":"cnm_h132_q1","topicId":"cnm_h132","difficulty":"basic","type":"choice","prompt":"要看各部分占总体的百分比，更合适的是？","choices":[{"key":"A","text":"折线图"},{"key":"B","text":"扇形图"},{"key":"C","text":"茎叶图不必、这里用扇形"},{"key":"D","text":"只写方差"}],"answer":"B","explanation":"扇形图用扇形的大小表示比例。","verify":"\"扇形图\""},{"id":"cnm_h132_q2","topicId":"cnm_h132","difficulty":"basic","type":"choice","prompt":"要看一个月内每天气温的变化，更合适的是？","choices":[{"key":"A","text":"扇形图"},{"key":"B","text":"一个只画总数的条形"},{"key":"C","text":"折线图"},{"key":"D","text":"只写众数"}],"answer":"C","explanation":"折线图能看出随时间的升降。","verify":"\"折线图\""},{"id":"cnm_h132_q3","topicId":"cnm_h132","difficulty":"standard","type":"numeric","prompt":"扇形图中三类的百分比是 20、30、50。它们的和是多少？","answer":"100","explanation":"全部类别应占 100%。","verify":"20+30+50"},{"id":"cnm_h132_q4","topicId":"cnm_h132","difficulty":"standard","type":"choice","prompt":"比较几个连续区间上的数据分布，用？","choices":[{"key":"A","text":"频率分布直方图"},{"key":"B","text":"只画一个扇形"},{"key":"C","text":"只算一个平均数"},{"key":"D","text":"不分组"}],"answer":"A","explanation":"直方图专门表示分组后的频率分布。","verify":"\"频率分布直方图\""}]
