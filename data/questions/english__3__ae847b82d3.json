[{"id":"cne_p013_q1","topicId":"cne_p013","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「脸」？","choices":[{"key":"A","text":"eye"},{"key":"B","text":"nose"},{"key":"C","text":"face"},{"key":"D","text":"mouth"}],"answer":"C","explanation":"face 的意思是脸。","verify":"\"face\""},{"id":"cne_p013_q2","topicId":"cne_p013","difficulty":"basic","type":"choice","prompt":"「eye」的中文意思是哪一个？","choices":[{"key":"A","text":"脸"},{"key":"B","text":"鼻子"},{"key":"C","text":"嘴巴"},{"key":"D","text":"眼睛"}],"answer":"D","explanation":"eye 的意思是眼睛。","verify":"\"眼睛\""},{"id":"cne_p013_q3","topicId":"cne_p013","difficulty":"standard","type":"choice","prompt":"选择表示「鼻子」的单词。","choices":[{"key":"A","text":"nose"},{"key":"B","text":"face"},{"key":"C","text":"eye"},{"key":"D","text":"mouth"}],"answer":"A","explanation":"表示鼻子的单词是 nose。","verify":"\"nose\""},{"id":"cne_p013_q4","topicId":"cne_p013","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「嘴巴」？","choices":[{"key":"A","text":"face"},{"key":"B","text":"mouth"},{"key":"C","text":"eye"},{"key":"D","text":"nose"}],"answer":"B","explanation":"mouth 的意思是嘴巴。","verify":"\"mouth\""},{"id":"cne_p015_q1","topicId":"cne_p015","difficulty":"basic","type":"choice","prompt":"指着自己的眼睛，应说哪一句？","choices":[{"key":"A","text":"This is my eye."},{"key":"B","text":"This is my nose."},{"key":"C","text":"This is my mouth."},{"key":"D","text":"This is my face."}],"answer":"A","explanation":"眼睛是 eye。","verify":"\"This is my eye.\""},{"id":"cne_p015_q2","topicId":"cne_p015","difficulty":"basic","type":"choice","prompt":"This is my mouth. 这句在介绍什么？","choices":[{"key":"A","text":"眼睛"},{"key":"B","text":"嘴巴"},{"key":"C","text":"鼻子"},{"key":"D","text":"脸"}],"answer":"B","explanation":"mouth 是嘴巴。","verify":"\"嘴巴\""},{"id":"cne_p015_q3","topicId":"cne_p015","difficulty":"standard","type":"choice","prompt":"Look at me. This is my face. 这句在看什么？","choices":[{"key":"A","text":"书"},{"key":"B","text":"苹果"},{"key":"C","text":"脸"},{"key":"D","text":"书包"}],"answer":"C","explanation":"face 是脸。","verify":"\"脸\""},{"id":"cne_p015_q4","topicId":"cne_p015","difficulty":"standard","type":"choice","prompt":"想请对方看自己的鼻子，应说哪一句？","choices":[{"key":"A","text":"Look at my ear."},{"key":"B","text":"Look at my hand."},{"key":"C","text":"Look at my foot."},{"key":"D","text":"Look at my nose."}],"answer":"D","explanation":"鼻子是 nose。","verify":"\"Look at my nose.\""},{"id":"cne_p016_q1","topicId":"cne_p016","difficulty":"basic","type":"choice","prompt":"文字：This is my face. It is red. 脸是什么颜色？","choices":[{"key":"A","text":"黄色"},{"key":"B","text":"红色"},{"key":"C","text":"绿色"},{"key":"D","text":"蓝色"}],"answer":"B","explanation":"文字写 It is red。","verify":"\"红色\""},{"id":"cne_p016_q2","topicId":"cne_p016","difficulty":"basic","type":"choice","prompt":"文字：This is my nose. 哪一句和文字一致？","choices":[{"key":"A","text":"这是我的嘴巴。"},{"key":"B","text":"这是我的眼睛。"},{"key":"C","text":"这是我的鼻子。"},{"key":"D","text":"这是我的耳朵。"}],"answer":"C","explanation":"nose 是鼻子。","verify":"\"这是我的鼻子。\""},{"id":"cne_p016_q3","topicId":"cne_p016","difficulty":"standard","type":"choice","prompt":"文字：Look at my eye. It is blue. 蓝色的是什么？","choices":[{"key":"A","text":"鼻子"},{"key":"B","text":"嘴巴"},{"key":"C","text":"脸"},{"key":"D","text":"眼睛"}],"answer":"D","explanation":"eye 是眼睛，颜色是 blue。","verify":"\"眼睛\""},{"id":"cne_p016_q4","topicId":"cne_p016","difficulty":"standard","type":"choice","prompt":"文字：This is my mouth. 哪一句是文字里有的？","choices":[{"key":"A","text":"This is my mouth."},{"key":"B","text":"This is my nose."},{"key":"C","text":"This is my eye."},{"key":"D","text":"This is my face."}],"answer":"A","explanation":"文字写的是 mouth。","verify":"\"This is my mouth.\""},{"id":"cne_p039_q1","topicId":"cne_p039","difficulty":"basic","type":"choice","prompt":"哪个单词含有短元音 i？","choices":[{"key":"A","text":"big"},{"key":"B","text":"cake"},{"key":"C","text":"he"},{"key":"D","text":"nose"}],"answer":"A","explanation":"big 含有短元音 i。","verify":"\"big\""},{"id":"cne_p039_q2","topicId":"cne_p039","difficulty":"basic","type":"choice","prompt":"哪个单词不含短元音 i？","choices":[{"key":"A","text":"big"},{"key":"B","text":"cake"},{"key":"C","text":"pig"},{"key":"D","text":"sit"}],"answer":"B","explanation":"cake 不含短元音 i。","verify":"\"cake\""},{"id":"cne_p039_q3","topicId":"cne_p039","difficulty":"standard","type":"choice","prompt":"pig 和哪个词的元音相同？","choices":[{"key":"A","text":"cake"},{"key":"B","text":"he"},{"key":"C","text":"sit"},{"key":"D","text":"nose"}],"answer":"C","explanation":"pig 和 sit 都含有短元音 i。","verify":"\"sit\""},{"id":"cne_p039_q4","topicId":"cne_p039","difficulty":"standard","type":"choice","prompt":"选择含有短元音 i的单词。","choices":[{"key":"A","text":"he"},{"key":"B","text":"nose"},{"key":"C","text":"cat"},{"key":"D","text":"fish"}],"answer":"D","explanation":"fish 含有短元音 i。","verify":"\"fish\""},{"id":"cne_p062_q1","topicId":"cne_p062","difficulty":"basic","type":"choice","prompt":"哪个单词含有i-e 的读音？","choices":[{"key":"A","text":"big"},{"key":"B","text":"pig"},{"key":"C","text":"sit"},{"key":"D","text":"like"}],"answer":"D","explanation":"like 含有i-e 的读音。","verify":"\"like\""},{"id":"cne_p062_q2","topicId":"cne_p062","difficulty":"basic","type":"choice","prompt":"哪个单词不含i-e 的读音？","choices":[{"key":"A","text":"big"},{"key":"B","text":"like"},{"key":"C","text":"kite"},{"key":"D","text":"five"}],"answer":"A","explanation":"big 不含i-e 的读音。","verify":"\"big\""},{"id":"cne_p062_q3","topicId":"cne_p062","difficulty":"standard","type":"choice","prompt":"kite 和哪个词的元音相同？","choices":[{"key":"A","text":"big"},{"key":"B","text":"five"},{"key":"C","text":"pig"},{"key":"D","text":"sit"}],"answer":"B","explanation":"kite 和 five 都含有i-e 的读音。","verify":"\"five\""},{"id":"cne_p062_q4","topicId":"cne_p062","difficulty":"standard","type":"choice","prompt":"选择含有i-e 的读音的单词。","choices":[{"key":"A","text":"pig"},{"key":"B","text":"sit"},{"key":"C","text":"bike"},{"key":"D","text":"fish"}],"answer":"C","explanation":"bike 含有i-e 的读音。","verify":"\"bike\""}]
