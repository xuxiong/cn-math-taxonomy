":"cnm_p055"},{"difficulty":"standard","type":"numeric","prompt":"1600 的百位是几？","answer":"6","explanation":"1600 是 1 个千和 6 个百，百位是 6。","verify":"6","id":"cnm_p055_q3","topicId":"cnm_p055"},{"difficulty":"challenge","type":"numeric","prompt":"由 3 个千和 5 个十组成的数是多少？","answer":"3050","explanation":"3 个千是 3000，5 个十是 50，合起来是 3050。","verify":"3000+50","id":"cnm_p055_q4","topicId":"cnm_p055"},{"difficulty":"basic","type":"numeric","prompt":"9999 的后面一个数是几？","answer":"10000","explanation":"9999 再添 1 是 10000，也就是 1 万。","verify":"9999+1","id":"cnm_p269_q1","topicId":"cnm_p269"},{"difficulty":"basic","type":"numeric","prompt":"10000 里面有几个千？","answer":"10","explanation":"1 万＝10 个千。","verify":"10000//1000","id":"cnm_p269_q2","topicId":"cnm_p269"},{"difficulty":"standard","type":"numeric","prompt":"7080 的千位是几？","answer":"7","explanation":"7080 是 7 个千、0 个百、8 个十、0 个一。","verify":"7","id":"cnm_p269_q3","topicId":"cnm_p269"},{"difficulty":"challenge","type":"numeric","prompt":"由 9 个千、9 个百、9 个十和 9 个一组成的数再添 1，是多少？","answer":"10000","explanation":"先组成 9999，再添 1 是 10000。","verify":"9999+1","id":"cnm_p269_q4","topicId":"cnm_p269"},{"difficulty":"basic","type":"numeric","prompt":"图书馆运来 3000 本故事书，又运来 2000 本。一共多少本？","answer":"5000","explanation":"3 个千加 2 个千是 5 个千，等于 5000。","verify":"3000+2000","id":"cnm_p270_q1","topicId":"cnm_p270"},{"difficulty":"basic","type":"numeric","prompt":"仓库有 8000 箱，运走 3000 箱。还剩多少箱？","answer":"5000","explanation":"8 个千减 3 个千是 5 个千。","verify":"8000-3000","id":"cnm_p270_q2","topicId":"cnm_p270"},{"difficulty":"standard","type":"numeric","prompt":"操场上有 4500 人，又来了 300 人。现在有多少人？","answer":"4800","explanation":"4500 再加 3 个百是 4800。","verify":"4500+300","id":"cnm_p270_q3","topicId":"cnm_p270"},{"difficulty":"challenge","type":"numeric","prompt":"停车场有 6000 辆车，先开走 500 辆，又开来 1000 辆。现在有多少辆？","answer":"6500","explanation":"先算 6000－500＝5500，再加 1000 得 6500。","verify":"6000-500+1000","id":"cnm_p270_q4","topicId":"cnm_p270"}]
