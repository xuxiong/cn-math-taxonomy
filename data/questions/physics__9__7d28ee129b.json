[{"id":"cnp_090_q1","topicId":"cnp_090","difficulty":"basic","type":"choice","prompt":"下列能源中属于不可再生能源的是哪一个？","choices":[{"key":"A","text":"石油"},{"key":"B","text":"太阳能"},{"key":"C","text":"风能"},{"key":"D","text":"水能"}],"answer":"A","explanation":"煤、石油、天然气等化石能源短期内不能再生，是不可再生能源。","verify":"\"石油\""},{"id":"cnp_090_q2","topicId":"cnp_090","difficulty":"basic","type":"choice","prompt":"下列能源中属于二次能源的是哪一个？","choices":[{"key":"A","text":"煤"},{"key":"B","text":"电能"},{"key":"C","text":"太阳能"},{"key":"D","text":"风能"}],"answer":"B","explanation":"电能由其他能源转化而来，是二次能源。","verify":"\"电能\""},{"id":"cnp_090_q3","topicId":"cnp_090","difficulty":"standard","type":"choice","prompt":"大量燃烧化石燃料带来的主要环境问题是什么？","choices":[{"key":"A","text":"臭氧增多"},{"key":"B","text":"噪声减少"},{"key":"C","text":"水资源增加"},{"key":"D","text":"温室效应和大气污染"}],"answer":"D","explanation":"燃烧化石燃料产生大量二氧化碳和有害气体，加剧温室效应、造成大气污染。","verify":"\"温室效应和大气污染\""},{"id":"cnp_090_q4","topicId":"cnp_090","difficulty":"standard","type":"choice","prompt":"能量守恒，为什么还要节约能源？","choices":[{"key":"A","text":"能量会被消灭"},{"key":"B","text":"能量总量在减少"},{"key":"C","text":"能量的转化和转移具有方向性，可利用的能源会减少"},{"key":"D","text":"节约能源能创造能量"}],"answer":"C","explanation":"能量总量不变，但转化有方向性，散失的内能难以再利用，可利用的能源会越来越少。","verify":"\"能量的转化和转移具有方向性，可利用的能源会减少\""}]
