[{"id":"cnp_027_q1","topicId":"cnp_027","difficulty":"basic","type":"choice","prompt":"用量筒测水的体积，读数时视线应怎样？","choices":[{"key":"A","text":"与凹液面的顶部相平"},{"key":"B","text":"与凹液面的底部相平"},{"key":"C","text":"从上往下俯视"},{"key":"D","text":"从下往上仰视"}],"answer":"B","explanation":"量筒读数时视线要与凹液面最低处相平；俯视读数偏大，仰视读数偏小。","verify":"\"与凹液面的底部相平\""},{"id":"cnp_027_q2","topicId":"cnp_027","difficulty":"standard","type":"numeric","prompt":"量筒中原有水 40 mL，放入一块小石块后水面到 60 mL，石块质量 52 g。石块密度是多少 g/cm³？（只填数值）","answer":"2.6","explanation":"V = 60 - 40 = 20 mL = 20 cm³，ρ = 52 ÷ 20 = 2.6 g/cm³。","verify":"52/(60-40)"},{"id":"cnp_027_q3","topicId":"cnp_027","difficulty":"standard","type":"choice","prompt":"测盐水密度时，下列步骤顺序误差最小的是哪一个？","choices":[{"key":"A","text":"先测空烧杯质量→再测烧杯和盐水总质量→全部倒入量筒读体积"},{"key":"B","text":"先用量筒测体积→再倒入空烧杯测质量"},{"key":"C","text":"只测烧杯和盐水总质量"},{"key":"D","text":"测烧杯和盐水总质量→倒一部分入量筒读体积→测剩余盐水和烧杯质量"}],"answer":"D","explanation":"前两种做法中烧杯或量筒壁会残留盐水，使体积或质量偏小；用剩余法算倒出部分的质量和体积，误差最小。","verify":"\"测烧杯和盐水总质量→倒一部分入量筒读体积→测剩余盐水和烧杯质量\""},{"id":"cnp_027_q4","topicId":"cnp_027","difficulty":"basic","type":"choice","prompt":"1 mL 等于多少 cm³？","choices":[{"key":"A","text":"1 cm³"},{"key":"B","text":"1000 cm³"},{"key":"C","text":"0.001 cm³"},{"key":"D","text":"10 cm³"}],"answer":"A","explanation":"1 mL = 1 cm³，1 L = 1000 mL = 1 dm³。","verify":"1"}]
