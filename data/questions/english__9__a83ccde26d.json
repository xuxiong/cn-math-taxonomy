[{"id":"cne_j216_q1","topicId":"cne_j216","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「谁的」？","choices":[{"key":"A","text":"attend"},{"key":"B","text":"whose"},{"key":"C","text":"valuable"},{"key":"D","text":"picnic"}],"answer":"B","explanation":"whose 的意思是谁的。","verify":"\"whose\""},{"id":"cne_j216_q2","topicId":"cne_j216","difficulty":"basic","type":"choice","prompt":"「attend」的中文意思是哪一个？","choices":[{"key":"A","text":"谁的"},{"key":"B","text":"贵重的"},{"key":"C","text":"参加"},{"key":"D","text":"野餐"}],"answer":"C","explanation":"attend 的意思是参加。","verify":"\"参加\""},{"id":"cne_j216_q3","topicId":"cne_j216","difficulty":"standard","type":"choice","prompt":"选择表示「贵重的」的单词。","choices":[{"key":"A","text":"whose"},{"key":"B","text":"attend"},{"key":"C","text":"picnic"},{"key":"D","text":"valuable"}],"answer":"D","explanation":"表示贵重的的单词是 valuable。","verify":"\"valuable\""},{"id":"cne_j216_q4","topicId":"cne_j216","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「野餐」？","choices":[{"key":"A","text":"picnic"},{"key":"B","text":"whose"},{"key":"C","text":"attend"},{"key":"D","text":"valuable"}],"answer":"A","explanation":"picnic 的意思是野餐。","verify":"\"picnic\""},{"id":"cne_j217_q1","topicId":"cne_j217","difficulty":"basic","type":"choice","prompt":"吉他上面有 Carla 的名字，一定是她的。哪一句正确？","choices":[{"key":"A","text":"The guitar must is Carla's."},{"key":"B","text":"The guitar must be Carla."},{"key":"C","text":"The guitar must be Carla's."},{"key":"D","text":"The guitar can be Carla's as a weak guess in this sure case."}],"answer":"C","explanation":"把握大时用 must be。","verify":"\"The guitar must be Carla's.\""},{"id":"cne_j217_q2","topicId":"cne_j217","difficulty":"basic","type":"choice","prompt":"他不可能在野餐，我看见他在图书馆。哪一句正确？","choices":[{"key":"A","text":"He must be at the picnic although I see him in the library."},{"key":"B","text":"He can't is at the picnic."},{"key":"C","text":"He must not to be at the picnic."},{"key":"D","text":"He can't be at the picnic."}],"answer":"D","explanation":"有相反证据时用 can't be。","verify":"\"He can't be at the picnic.\""},{"id":"cne_j217_q3","topicId":"cne_j217","difficulty":"standard","type":"choice","prompt":"must 在这里表示什么？","choices":[{"key":"A","text":"很有把握的推测"},{"key":"B","text":"过去的义务已经完成"},{"key":"C","text":"礼貌的请求"},{"key":"D","text":"正在进行的被动"}],"answer":"A","explanation":"must be 表示一定是。","verify":"\"很有把握的推测\""},{"id":"cne_j217_q4","topicId":"cne_j217","difficulty":"standard","type":"choice","prompt":"这本贵重的书是谁的？名字是 Tom。哪一句合适？","choices":[{"key":"A","text":"It must belongs to Tom."},{"key":"B","text":"It must belong to Tom."},{"key":"C","text":"It must belong Tom."},{"key":"D","text":"It can't belong to Tom because the name is Tom."}],"answer":"B","explanation":"must belong to。","verify":"\"It must belong to Tom.\""},{"id":"cne_j218_q1","topicId":"cne_j218","difficulty":"basic","type":"choice","prompt":"想问这是谁的书包，哪一句合适？","choices":[{"key":"A","text":"Who's backpack is this owner?"},{"key":"B","text":"Whose backpack this is?"},{"key":"C","text":"Who backpack is this?"},{"key":"D","text":"Whose backpack is this?"}],"answer":"D","explanation":"Whose backpack is this。","verify":"\"Whose backpack is this?\""},{"id":"cne_j218_q2","topicId":"cne_j218","difficulty":"basic","type":"choice","prompt":"你很确定是 Mary 的，应怎么说？","choices":[{"key":"A","text":"It must be Mary's."},{"key":"B","text":"It must Mary's."},{"key":"C","text":"It can be Mary's if we are completely sure."},{"key":"D","text":"It must is Mary's."}],"answer":"A","explanation":"must be Mary's。","verify":"\"It must be Mary's.\""},{"id":"cne_j218_q3","topicId":"cne_j218","difficulty":"standard","type":"choice","prompt":"CD 上是流行乐，Mary 喜欢流行乐。哪一句合适？","choices":[{"key":"A","text":"It must belong Mary."},{"key":"B","text":"It must belong to Mary."},{"key":"C","text":"It must belongs to Mary."},{"key":"D","text":"It can't belong to Mary because she likes pop."}],"answer":"B","explanation":"must belong to Mary。","verify":"\"It must belong to Mary.\""},{"id":"cne_j218_q4","topicId":"cne_j218","difficulty":"standard","type":"choice","prompt":"想说他在参加野餐，所以不在这里，哪一句合适？","choices":[{"key":"A","text":"He must attending the picnic."},{"key":"B","text":"He must be attend the picnic."},{"key":"C","text":"He must be attending the picnic."},{"key":"D","text":"He can be attending the picnic as a certain fact."}],"answer":"C","explanation":"must be attending。","verify":"\"He must be attending the picnic.\""},{"id":"cne_j219_q1","topicId":"cne_j219","difficulty":"basic","type":"choice","prompt":"The notebook has Anna's name on it. It must be hers. 笔记本是谁的？","choices":[{"key":"A","text":"Anna 的"},{"key":"B","text":"Tom 的"},{"key":"C","text":"老师的"},{"key":"D","text":"无人认领"}],"answer":"A","explanation":"Anna's name，must be hers。","verify":"\"Anna 的\""},{"id":"cne_j219_q2","topicId":"cne_j219","difficulty":"basic","type":"choice","prompt":"The toy truck can't be Mary's. She does not like trucks. 玩具卡车是 Mary 的吗？","choices":[{"key":"A","text":"一定是"},{"key":"B","text":"不是"},{"key":"C","text":"可能是因为她喜欢"},{"key":"D","text":"短文没说"}],"answer":"B","explanation":"can't be Mary's。","verify":"\"不是\""},{"id":"cne_j219_q3","topicId":"cne_j219","difficulty":"standard","type":"choice","prompt":"Somebody is attending a picnic. The volleyball must belong to that person. 排球和谁有关？","choices":[{"key":"A","text":"Anna 的笔记本"},{"key":"B","text":"Mary 的卡车"},{"key":"C","text":"正在参加野餐的那个人"},{"key":"D","text":"图书馆"}],"answer":"C","explanation":"belong to that person。","verify":"\"正在参加野餐的那个人\""},{"id":"cne_j219_q4","topicId":"cne_j219","difficulty":"standard","type":"choice","prompt":"The notebook has Anna's name on it. 哪一句和短文一致？","choices":[{"key":"A","text":"Mary owns the toy truck."},{"key":"B","text":"The volleyball is Anna's notebook."},{"key":"C","text":"The notebook has no name."},{"key":"D","text":"Anna owns the notebook."}],"answer":"D","explanation":"名字在笔记本上。","verify":"\"Anna owns the notebook.\""}]
