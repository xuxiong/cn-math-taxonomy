[{"id":"cnp_014_q1","topicId":"cnp_014","difficulty":"basic","type":"choice","prompt":"揭开蒸锅盖时，被锅里出来的水蒸气烫伤往往比被同温度的开水烫伤更严重，原因是什么？","choices":[{"key":"A","text":"水蒸气温度一定更高"},{"key":"B","text":"水蒸气液化时还要放出大量热"},{"key":"C","text":"水蒸气凝华放热"},{"key":"D","text":"开水不会放热"}],"answer":"B","explanation":"100 ℃ 的水蒸气先液化放热，再以 100 ℃ 的水继续放热，所以烫伤更重。","verify":"\"水蒸气液化时还要放出大量热\""},{"id":"cnp_014_q2","topicId":"cnp_014","difficulty":"basic","type":"choice","prompt":"从冰箱冷冻室拿出的冻肉表面有一层白霜，霜是怎么形成的？","choices":[{"key":"A","text":"水凝固"},{"key":"B","text":"水蒸气液化"},{"key":"C","text":"水蒸气凝华"},{"key":"D","text":"冰升华"}],"answer":"C","explanation":"冷冻室里的水蒸气遇冷直接凝华成小冰晶，形成霜。","verify":"\"水蒸气凝华\""},{"id":"cnp_014_q3","topicId":"cnp_014","difficulty":"standard","type":"choice","prompt":"炖汤时，汤沸腾后把大火改成小火，汤的温度会怎样？","choices":[{"key":"A","text":"明显降低"},{"key":"B","text":"继续升高"},{"key":"C","text":"基本不变，仍保持沸腾"},{"key":"D","text":"马上停止沸腾"}],"answer":"C","explanation":"只要能继续吸热保持沸腾，温度就保持在沸点；改小火可以节约燃料。","verify":"\"基本不变，仍保持沸腾\""},{"id":"cnp_014_q4","topicId":"cnp_014","difficulty":"standard","type":"choice","prompt":"冷冻的饮料瓶放在桌上，外壁先出现霜，后来霜变成水珠，后一过程是什么？","choices":[{"key":"A","text":"液化"},{"key":"B","text":"凝华"},{"key":"C","text":"熔化"},{"key":"D","text":"汽化"}],"answer":"C","explanation":"霜是固态，变成水是固态→液态，属于熔化。","verify":"\"熔化\""}]
