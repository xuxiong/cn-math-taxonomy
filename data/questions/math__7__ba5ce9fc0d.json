[{"id":"cnm_014_q1","topicId":"cnm_014","difficulty":"basic","type":"numeric","prompt":"计算 (-3)×(-4) 和 (-5)×2。（依次作答，用逗号隔开）","answer":"12，-10","explanation":"同号两数相乘得正，绝对值相乘：(-3)×(-4)=12；异号得负：(-5)×2=-10。","verify":"[(-3)*(-4), (-5)*2]"},{"id":"cnm_014_q2","topicId":"cnm_014","difficulty":"basic","type":"choice","prompt":"下列各式中，结果为正数的是哪一个？","choices":[{"key":"A","text":"(-2)×3"},{"key":"B","text":"2×(-3)"},{"key":"C","text":"0×(-3)"},{"key":"D","text":"(-2)×(-3)"}],"answer":"D","explanation":"同号两数相乘得正数，(-2)×(-3)=6；(-2)×3 与 2×(-3) 异号得负，0×(-3)=0。"},{"id":"cnm_014_q3","topicId":"cnm_014","difficulty":"standard","type":"numeric","prompt":"计算 (-3/4)×(8/9)，结果写成最简分数。","answer":"-2/3","explanation":"异号得负，绝对值相乘：3/4×8/9=24/36=2/3，所以结果是 -2/3。","verify":"Fraction(-3,4)*Fraction(8,9)"},{"id":"cnm_014_q4","topicId":"cnm_014","difficulty":"standard","type":"numeric","prompt":"当 a=-3，b=-4 时，求 ab-a 的值。","answer":"15","explanation":"ab=(-3)×(-4)=12，ab-a=12-(-3)=12+3=15。","verify":"(-3)*(-4)-(-3)"},{"id":"cnm_014_q5","topicId":"cnm_014","difficulty":"advanced","type":"numeric","prompt":"已知 |a|=3，|b|=5，且 ab<0，求 ab 的值。","answer":"-15","explanation":"ab<0 说明 a、b 异号，|ab|=|a|×|b|=15，积为负，所以 ab=-15。","verify":"-(3*5)"},{"id":"cnm_015_q1","topicId":"cnm_015","difficulty":"standard","type":"numeric","prompt":"用分配律计算 (-12)×(1/2-2/3+1/4)。","answer":"-1","explanation":"(-12)×1/2+(-12)×(-2/3)+(-12)×1/4=-6+8-3=-1。","verify":"-12*(Fraction(1,2)-Fraction(2,3)+Fraction(1,4))"},{"id":"cnm_015_q2","topicId":"cnm_015","difficulty":"basic","type":"choice","prompt":"(-2)×3×(-4)×(-5) 的积是什么？","choices":[{"key":"A","text":"正数"},{"key":"B","text":"0"},{"key":"C","text":"负数"}],"answer":"C","explanation":"几个非零因数相乘，负因数有 3 个（奇数个），积为负数；绝对值 2×3×4×5=120，所以积为 -120。"},{"id":"cnm_015_q3","topicId":"cnm_015","difficulty":"basic","type":"numeric","prompt":"计算 (-2)×7×(-5)。","answer":"70","explanation":"两个负因数（偶数个）积为正：先把 (-2)×(-5)=10，再 10×7=70。","verify":"(-2)*7*(-5)"},{"id":"cnm_015_q4","topicId":"cnm_015","difficulty":"standard","type":"numeric","prompt":"计算 (-5/9)×13+(-5/9)×(-4)。","answer":"-5","explanation":"逆用分配律提取公因数：(-5/9)×[13+(-4)]=(-5/9)×9=-5。","verify":"Fraction(-5,9)*13+Fraction(-5,9)*(-4)"},{"id":"cnm_015_q5","topicId":"cnm_015","difficulty":"advanced","type":"choice","prompt":"5 个不等于 0 的有理数相乘，积为正数，则其中负因数的个数可能是几个？","choices":[{"key":"A","text":"4"},{"key":"B","text":"1"},{"key":"C","text":"3"},{"key":"D","text":"5"}],"answer":"A","explanation":"积为正，负因数个数必须是偶数。选项中只有 4 是偶数（共 5 个因数，另一个为正数）。"}]
