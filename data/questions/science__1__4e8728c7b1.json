[{"id":"cns_p024_q1","topicId":"cns_p024","difficulty":"basic","type":"choice","prompt":"下面哪一个是动物？","choices":[{"key":"A","text":"小草"},{"key":"B","text":"蚂蚁"},{"key":"C","text":"石头"},{"key":"D","text":"白云"}],"answer":"B","explanation":"蚂蚁会动、会吃东西，是动物。","verify":"\"蚂蚁\""},{"id":"cns_p024_q2","topicId":"cns_p024","difficulty":"basic","type":"choice","prompt":"下面哪一项是所有动物都需要的？","choices":[{"key":"A","text":"衣服和鞋子"},{"key":"B","text":"电和网络"},{"key":"C","text":"食物和水"},{"key":"D","text":"书本"}],"answer":"C","explanation":"动物要吃东西、喝水才能活下去。","verify":"\"食物和水\""},{"id":"cns_p024_q3","topicId":"cns_p024","difficulty":"standard","type":"choice","prompt":"哪一种动物生活在水里？","choices":[{"key":"A","text":"小猫"},{"key":"B","text":"麻雀"},{"key":"C","text":"蜗牛"},{"key":"D","text":"金鱼"}],"answer":"D","explanation":"金鱼用鳃在水中呼吸。","verify":"\"金鱼\""},{"id":"cns_p024_q4","topicId":"cns_p024","difficulty":"challenge","type":"choice","prompt":"「玩具小狗会叫会走，所以它是动物」，这句话为什么不对？","choices":[{"key":"A","text":"玩具不会吃东西、不会长大，没有生命"},{"key":"B","text":"它的毛不够多"},{"key":"C","text":"它太小了"},{"key":"D","text":"它不会说话"}],"answer":"A","explanation":"动物有生命，会吃食物、会生长，玩具没有这些特征。","verify":"\"玩具不会吃东西、不会长大，没有生命\""},{"id":"cns_p025_q1","topicId":"cns_p025","difficulty":"basic","type":"choice","prompt":"蜗牛背上硬硬的是什么？","choices":[{"key":"A","text":"翅膀"},{"key":"B","text":"鳞片"},{"key":"C","text":"壳"},{"key":"D","text":"羽毛"}],"answer":"C","explanation":"蜗牛背着一个螺旋形的壳。","verify":"\"壳\""},{"id":"cns_p025_q2","topicId":"cns_p025","difficulty":"basic","type":"choice","prompt":"观察蜗牛时，可以用什么工具看清细节？","choices":[{"key":"A","text":"温度计"},{"key":"B","text":"尺子"},{"key":"C","text":"锤子"},{"key":"D","text":"放大镜"}],"answer":"D","explanation":"放大镜能把小东西放大。","verify":"\"放大镜\""},{"id":"cns_p025_q3","topicId":"cns_p025","difficulty":"standard","type":"choice","prompt":"蜗牛的触角有什么作用？","choices":[{"key":"A","text":"帮助它感知周围"},{"key":"B","text":"帮助它飞"},{"key":"C","text":"用来吃东西"},{"key":"D","text":"用来走路"}],"answer":"A","explanation":"蜗牛用触角感知周围环境，长触角顶端有眼。","verify":"\"帮助它感知周围\""},{"id":"cns_p025_q4","topicId":"cns_p025","difficulty":"challenge","type":"choice","prompt":"蜗牛爬过的玻璃上留下一条亮亮的痕迹，这是什么？","choices":[{"key":"A","text":"它掉的毛"},{"key":"B","text":"它分泌的黏液"},{"key":"C","text":"雨水"},{"key":"D","text":"它的壳碎了"}],"answer":"B","explanation":"蜗牛分泌黏液帮助爬行。","verify":"\"它分泌的黏液\""},{"id":"cns_p026_q1","topicId":"cns_p026","difficulty":"basic","type":"choice","prompt":"给蜗牛建家，盒子里应该放什么？","choices":[{"key":"A","text":"干沙子和石头"},{"key":"B","text":"一杯热水"},{"key":"C","text":"塑料玩具"},{"key":"D","text":"湿润的泥土和新鲜菜叶"}],"answer":"D","explanation":"蜗牛喜欢潮湿，吃菜叶。","verify":"\"湿润的泥土和新鲜菜叶\""},{"id":"cns_p026_q2","topicId":"cns_p026","difficulty":"basic","type":"choice","prompt":"蜗牛喜欢什么样的环境？","choices":[{"key":"A","text":"阴暗潮湿"},{"key":"B","text":"干燥炎热"},{"key":"C","text":"阳光暴晒"},{"key":"D","text":"冰冷结冰"}],"answer":"A","explanation":"蜗牛怕干、怕晒，喜欢阴暗潮湿的地方。","verify":"\"阴暗潮湿\""},{"id":"cns_p026_q3","topicId":"cns_p026","difficulty":"standard","type":"choice","prompt":"蜗牛的饲养盒为什么要留小孔？","choices":[{"key":"A","text":"让蜗牛跑出来"},{"key":"B","text":"让空气进去"},{"key":"C","text":"让光线更亮"},{"key":"D","text":"为了好看"}],"answer":"B","explanation":"蜗牛需要呼吸空气。","verify":"\"让空气进去\""},{"id":"cns_p026_q4","topicId":"cns_p026","difficulty":"challenge","type":"choice","prompt":"连续晴天，盒中的蜗牛都缩进壳里不出来，可能缺少什么？","choices":[{"key":"A","text":"阳光"},{"key":"B","text":"玩具"},{"key":"C","text":"水分"},{"key":"D","text":"石头"}],"answer":"C","explanation":"环境太干，蜗牛会缩进壳里，应给泥土喷点水。","verify":"\"水分\""},{"id":"cns_p027_q1","topicId":"cns_p027","difficulty":"basic","type":"choice","prompt":"鱼在水里用什么呼吸？","choices":[{"key":"A","text":"鳃"},{"key":"B","text":"鼻子"},{"key":"C","text":"肺"},{"key":"D","text":"嘴巴里的牙"}],"answer":"A","explanation":"鱼用鳃从水里获得氧气。","verify":"\"鳃\""},{"id":"cns_p027_q2","topicId":"cns_p027","difficulty":"basic","type":"choice","prompt":"鱼靠什么在水中游动？","choices":[{"key":"A","text":"翅膀"},{"key":"B","text":"鳍和尾巴"},{"key":"C","text":"四条腿"},{"key":"D","text":"触角"}],"answer":"B","explanation":"鱼摆动尾巴和鳍游动。","verify":"\"鳍和尾巴\""},{"id":"cns_p027_q3","topicId":"cns_p027","difficulty":"standard","type":"choice","prompt":"下面哪种动物不是生活在水里的？","choices":[{"key":"A","text":"金鱼"},{"key":"B","text":"虾"},{"key":"C","text":"兔子"},{"key":"D","text":"螃蟹"}],"answer":"C","explanation":"兔子生活在陆地上。","verify":"\"兔子\""},{"id":"cns_p027_q4","topicId":"cns_p027","difficulty":"challenge","type":"choice","prompt":"把鱼长时间捞出水面放在岸上，会怎样？","choices":[{"key":"A","text":"会长出腿"},{"key":"B","text":"会更活泼"},{"key":"C","text":"会变成青蛙"},{"key":"D","text":"无法呼吸，会死亡"}],"answer":"D","explanation":"鱼的鳃只能在水中呼吸。","verify":"\"无法呼吸，会死亡\""},{"id":"cns_p028_q1","topicId":"cns_p028","difficulty":"basic","type":"choice","prompt":"兔子最喜欢吃什么？","choices":[{"key":"A","text":"小鱼"},{"key":"B","text":"青草和萝卜"},{"key":"C","text":"肉骨头"},{"key":"D","text":"沙子"}],"answer":"B","explanation":"兔子吃植物。","verify":"\"青草和萝卜\""},{"id":"cns_p028_q2","topicId":"cns_p028","difficulty":"basic","type":"choice","prompt":"下面哪种动物主要吃别的动物？","choices":[{"key":"A","text":"牛"},{"key":"B","text":"羊"},{"key":"C","text":"老虎"},{"key":"D","text":"兔子"}],"answer":"C","explanation":"老虎吃其他动物。","verify":"\"老虎\""},{"id":"cns_p028_q3","topicId":"cns_p028","difficulty":"standard","type":"choice","prompt":"鸡既吃米粒，又吃小虫，它属于哪一类？","choices":[{"key":"A","text":"只吃植物"},{"key":"B","text":"只吃动物"},{"key":"C","text":"什么都不吃"},{"key":"D","text":"植物和动物都吃"}],"answer":"D","explanation":"米是植物，虫是动物，鸡两样都吃。","verify":"\"植物和动物都吃\""},{"id":"cns_p028_q4","topicId":"cns_p028","difficulty":"challenge","type":"choice","prompt":"一种动物的牙齿又尖又锋利，它最可能吃什么？","choices":[{"key":"A","text":"其他动物的肉"},{"key":"B","text":"树叶"},{"key":"C","text":"青草"},{"key":"D","text":"种子"}],"answer":"A","explanation":"尖利的牙齿适合撕咬肉。","verify":"\"其他动物的肉\""},{"id":"cns_p029_q1","topicId":"cns_p029","difficulty":"basic","type":"choice","prompt":"小鸟身上长的是什么？","choices":[{"key":"A","text":"鳞片"},{"key":"B","text":"壳"},{"key":"C","text":"羽毛"},{"key":"D","text":"长毛"}],"answer":"C","explanation":"鸟类有羽毛。","verify":"\"羽毛\""},{"id":"cns_p029_q2","topicId":"cns_p029","difficulty":"basic","type":"choice","prompt":"鱼的身体表面一般覆盖着什么？","choices":[{"key":"A","text":"羽毛"},{"key":"B","text":"长毛"},{"key":"C","text":"硬壳"},{"key":"D","text":"鳞片"}],"answer":"D","explanation":"多数鱼体表有鳞片。","verify":"\"鳞片\""},{"id":"cns_p029_q3","topicId":"cns_p029","difficulty":"standard","type":"choice","prompt":"小猫身上长的是什么？","choices":[{"key":"A","text":"毛"},{"key":"B","text":"羽毛"},{"key":"C","text":"鳞片"},{"key":"D","text":"壳"}],"answer":"A","explanation":"猫的身上长满毛，能保暖。","verify":"\"毛\""},{"id":"cns_p029_q4","topicId":"cns_p029","difficulty":"challenge","type":"choice","prompt":"乌龟遇到危险时会把头缩进去，这主要靠身体的哪个特征保护自己？","choices":[{"key":"A","text":"长长的尾巴"},{"key":"B","text":"坚硬的壳"},{"key":"C","text":"漂亮的花纹"},{"key":"D","text":"锋利的牙齿"}],"answer":"B","explanation":"乌龟用硬壳保护身体。","verify":"\"坚硬的壳\""},{"id":"cns_p030_q1","topicId":"cns_p030","difficulty":"basic","type":"choice","prompt":"按生活的地方分，下面哪种动物和鲤鱼是一类？","choices":[{"key":"A","text":"老鹰"},{"key":"B","text":"猴子"},{"key":"C","text":"骆驼"},{"key":"D","text":"虾"}],"answer":"D","explanation":"虾和鲤鱼都生活在水里。老鹰、猴子、骆驼生活在陆地或天空。","verify":"\"虾\""},{"id":"cns_p030_q2","topicId":"cns_p030","difficulty":"basic","type":"choice","prompt":"下面哪种动物身上长着羽毛？","choices":[{"key":"A","text":"鸽子"},{"key":"B","text":"小狗"},{"key":"C","text":"青蛙"},{"key":"D","text":"鲤鱼"}],"answer":"A","explanation":"鸟类身上长着羽毛。","verify":"\"鸽子\""},{"id":"cns_p030_q3","topicId":"cns_p030","difficulty":"standard","type":"choice","prompt":"会飞的动物有哪一组？","choices":[{"key":"A","text":"小猫、小狗"},{"key":"B","text":"蝴蝶、麻雀"},{"key":"C","text":"鲤鱼、虾"},{"key":"D","text":"蜗牛、蚯蚓"}],"answer":"B","explanation":"蝴蝶和麻雀都有翅膀，会飞。","verify":"\"蝴蝶、麻雀\""},{"id":"cns_p030_q4","topicId":"cns_p030","difficulty":"challenge","type":"choice","prompt":"把蝴蝶、蜻蜓、蜜蜂分到一起，这三种动物的共同点是什么？","choices":[{"key":"A","text":"都生活在水里"},{"key":"B","text":"都有羽毛"},{"key":"C","text":"都有翅膀和六条腿"},{"key":"D","text":"都没有腿"}],"answer":"C","explanation":"它们都是昆虫，有六条腿、有翅膀。","verify":"\"都有翅膀和六条腿\""}]
