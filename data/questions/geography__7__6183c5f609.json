[{"id":"cng_j014_q1","topicId":"cng_j014","difficulty":"basic","type":"choice","prompt":"目前世界人口最多的大洲是？","choices":[{"key":"A","text":"欧洲"},{"key":"B","text":"大洋洲"},{"key":"C","text":"南极洲"},{"key":"D","text":"亚洲"}],"answer":"D","explanation":"亚洲人口占世界一半以上。","verify":"\"亚洲\""},{"id":"cng_j014_q2","topicId":"cng_j014","difficulty":"basic","type":"choice","prompt":"世界人口分布稠密区多位于？","choices":[{"key":"A","text":"中低纬度的近海平原"},{"key":"B","text":"高山高原内部"},{"key":"C","text":"热带沙漠腹地"},{"key":"D","text":"南极大陆"}],"answer":"A","explanation":"自然条件较好、开发较早的沿海平原人口密集。","verify":"\"中低纬度的近海平原\""},{"id":"cng_j014_q3","topicId":"cng_j014","difficulty":"standard","type":"choice","prompt":"黄色人种主要分布在？","choices":[{"key":"A","text":"欧洲西部"},{"key":"B","text":"亚洲东部和东南部"},{"key":"C","text":"非洲中部"},{"key":"D","text":"澳大利亚中部沙漠"}],"answer":"B","explanation":"东亚、东南亚以黄色人种为主。","verify":"\"亚洲东部和东南部\""},{"id":"cng_j014_q4","topicId":"cng_j014","difficulty":"challenge","type":"choice","prompt":"人口自然增长率最高的大洲通常是？","choices":[{"key":"A","text":"欧洲"},{"key":"B","text":"北美洲"},{"key":"C","text":"非洲"},{"key":"D","text":"大洋洲"}],"answer":"C","explanation":"非洲许多国家出生率高，人口增长快。","verify":"\"非洲\""},{"id":"cng_j015_q1","topicId":"cng_j015","difficulty":"basic","type":"choice","prompt":"聚落通常分为？","choices":[{"key":"A","text":"乡村和城镇"},{"key":"B","text":"只有首都和港口"},{"key":"C","text":"只有工厂和农田"},{"key":"D","text":"只有高原和盆地"}],"answer":"A","explanation":"人类集中居住的地方称为聚落，主要分为乡村和城镇。","verify":"\"乡村和城镇\""},{"id":"cng_j015_q2","topicId":"cng_j015","difficulty":"basic","type":"choice","prompt":"乡村聚落的居民一般主要从事？","choices":[{"key":"A","text":"国际贸易结算"},{"key":"B","text":"农业生产"},{"key":"C","text":"航天发射"},{"key":"D","text":"深海钻探"}],"answer":"B","explanation":"乡村以农业活动为主，城镇以非农业活动为主。","verify":"\"农业生产\""},{"id":"cng_j015_q3","topicId":"cng_j015","difficulty":"standard","type":"choice","prompt":"沿河或沿交通线呈条带状分布的聚落，形态上属于？","choices":[{"key":"A","text":"团块状聚落"},{"key":"B","text":"完全没有形态"},{"key":"C","text":"带状聚落"},{"key":"D","text":"只出现在沙漠腹地"}],"answer":"C","explanation":"受河流、山谷或交通线限制，聚落常沿线延伸。","verify":"\"带状聚落\""},{"id":"cng_j015_q4","topicId":"cng_j015","difficulty":"challenge","type":"choice","prompt":"早期城市多出现在河流中下游平原，主要是因为？","choices":[{"key":"A","text":"完全没有水患风险"},{"key":"B","text":"这里一定没有农业"},{"key":"C","text":"海拔越高越适合建城"},{"key":"D","text":"水源充足、交通便利、农业基础好"}],"answer":"D","explanation":"平原土壤肥沃、用水方便、便于运输，有利于城市形成。","verify":"\"水源充足、交通便利、农业基础好\""},{"id":"cng_j016_q1","topicId":"cng_j016","difficulty":"basic","type":"choice","prompt":"使用人数最多的语言是？","choices":[{"key":"A","text":"英语"},{"key":"B","text":"汉语"},{"key":"C","text":"阿拉伯语"},{"key":"D","text":"西班牙语"}],"answer":"B","explanation":"汉语是世界上使用人数最多的语言；英语是使用最广泛的语言之一。","verify":"\"汉语\""},{"id":"cng_j016_q2","topicId":"cng_j016","difficulty":"basic","type":"choice","prompt":"基督教、伊斯兰教、佛教通常并称为？","choices":[{"key":"A","text":"亚洲仅有的方言"},{"key":"B","text":"四大洋的别称"},{"key":"C","text":"世界三大宗教"},{"key":"D","text":"七大洲的别称"}],"answer":"C","explanation":"这三大宗教信徒多、分布广，是世界主要宗教。","verify":"\"世界三大宗教\""},{"id":"cng_j016_q3","topicId":"cng_j016","difficulty":"standard","type":"choice","prompt":"佛教发源于？","choices":[{"key":"A","text":"古代希腊"},{"key":"B","text":"古代埃及"},{"key":"C","text":"古代罗马"},{"key":"D","text":"古代印度"}],"answer":"D","explanation":"佛教起源于南亚的古代印度，后传到东亚、东南亚等地。","verify":"\"古代印度\""},{"id":"cng_j016_q4","topicId":"cng_j016","difficulty":"challenge","type":"choice","prompt":"语言和宗教的分布差异，说明世界文化具有？","choices":[{"key":"A","text":"多样性"},{"key":"B","text":"完全同一性"},{"key":"C","text":"只存在于城市"},{"key":"D","text":"与地理位置无关"}],"answer":"A","explanation":"不同地区的语言、宗教、建筑和习俗不同，体现文化多样性。","verify":"\"多样性\""}]
