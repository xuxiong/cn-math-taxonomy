[{"id":"cnm_163_q1","topicId":"cnm_163","difficulty":"basic","type":"choice","prompt":"计算 x⁸÷x³。","answer":"C","choices":[{"key":"A","text":"x¹¹"},{"key":"B","text":"x²⁴"},{"key":"C","text":"x⁵"}],"explanation":"同底数幂相除，底数不变、指数相减：8-3=5，结果为 x⁵。"},{"id":"cnm_163_q2","topicId":"cnm_163","difficulty":"basic","type":"numeric","prompt":"计算 2^7÷2^4 的值。","answer":"8","explanation":"2^7÷2^4=2^(7-4)=2^3=8。","verify":"2**7//2**4"},{"id":"cnm_163_q3","topicId":"cnm_163","difficulty":"standard","type":"numeric","prompt":"已知 a^m=12，a^n=3（a≠0），则 a^(m-n) 的值是多少？","answer":"4","explanation":"a^(m-n)=a^m÷a^n=12÷3=4。","verify":"12//3"},{"id":"cnm_163_q4","topicId":"cnm_163","difficulty":"standard","type":"choice","prompt":"下列计算正确的是","answer":"D","choices":[{"key":"A","text":"a^6÷a^2=a^3"},{"key":"B","text":"a^5÷a=a^5"},{"key":"C","text":"a^4÷a^4=0"},{"key":"D","text":"a^9÷a^3=a^6"}],"explanation":"指数应相减：a^6÷a^2=a^4，a^5÷a=a^4，a^4÷a^4=1；只有 a^9÷a^3=a^6 正确。"},{"id":"cnm_163_q5","topicId":"cnm_163","difficulty":"advanced","type":"numeric","prompt":"若 x^(2m+1)÷x^m=x^5（x≠0），则 m 等于多少？","answer":"4","explanation":"左边 =x^(2m+1-m)=x^(m+1)，由 m+1=5 得 m=4。","verify":"[m for m in range(0,20) if (2*m+1)-m==5]"},{"id":"cnm_164_q1","topicId":"cnm_164","difficulty":"standard","type":"choice","prompt":"计算 2⁻³ 并把 0.00032 用科学记数法表示。","answer":"A","choices":[{"key":"A","text":"1/8；3.2×10⁻⁴"},{"key":"B","text":"-8；3.2×10⁻⁴"},{"key":"C","text":"1/8；3.2×10⁻³"},{"key":"D","text":"1/6；32×10⁻⁵"}],"explanation":"2⁻³=1/2³=1/8；0.00032 的第一个非零数字 3 前面有 4 个 0，所以是 3.2×10⁻⁴。"},{"id":"cnm_164_q2","topicId":"cnm_164","difficulty":"basic","type":"numeric","prompt":"计算 5^0 + 2^(-2)，结果写成最简分数。","answer":"5/4","explanation":"5^0=1，2^(-2)=1/4，和为 5/4。","verify":"1+Fraction(1,2**2)"},{"id":"cnm_164_q3","topicId":"cnm_164","difficulty":"standard","type":"numeric","prompt":"把 0.00025 用科学记数法表示为 2.5×10^(-n)，则 n 等于多少？","answer":"4","explanation":"0.00025=2.5×0.0001=2.5×10^(-4)，所以 n=4。","verify":"-floor(log10(0.00025))"},{"id":"cnm_164_q4","topicId":"cnm_164","difficulty":"advanced","type":"numeric","prompt":"计算 (-1/2)^(-3) + 2024^0 + 2^(-2)×4。","answer":"-6","explanation":"(-1/2)^(-3)=(-2)^3=-8，2024^0=1，2^(-2)×4=1/4×4=1，和为 -8+1+1=-6。","verify":"Fraction(-1,2)**-3 + 1 + Fraction(1,4)*4"}]
