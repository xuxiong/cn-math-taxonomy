[{"id":"cne_h001_q1","topicId":"cne_h001","difficulty":"basic","type":"choice","prompt":"The boy likes music. 这句的主语是哪一个？","choices":[{"key":"A","text":"likes"},{"key":"B","text":"music"},{"key":"C","text":"The boy"},{"key":"D","text":"the full stop"}],"answer":"C","explanation":"The boy 是动作的发出者，作主语。","verify":"\"The boy\""},{"id":"cne_h001_q2","topicId":"cne_h001","difficulty":"basic","type":"choice","prompt":"The boy likes music. 这句的谓语是哪一个？","choices":[{"key":"A","text":"The boy"},{"key":"B","text":"music"},{"key":"C","text":"a comma"},{"key":"D","text":"likes"}],"answer":"D","explanation":"likes 表示动作，作谓语。","verify":"\"likes\""},{"id":"cne_h001_q3","topicId":"cne_h001","difficulty":"standard","type":"choice","prompt":"She reads English every day. 这句的宾语是哪一个？","choices":[{"key":"A","text":"English"},{"key":"B","text":"She"},{"key":"C","text":"reads"},{"key":"D","text":"every day"}],"answer":"A","explanation":"reads 是及物动词，English 是宾语。every day 是状语。","verify":"\"English\""},{"id":"cne_h001_q4","topicId":"cne_h001","difficulty":"standard","type":"choice","prompt":"哪一句里的 music 作宾语？","choices":[{"key":"A","text":"Music sounds good"},{"key":"B","text":"We love music"},{"key":"C","text":"The music is loud"},{"key":"D","text":"They are students"}],"answer":"B","explanation":"love 后面的 music 是宾语。其余三句是主系表。","verify":"\"We love music\""},{"id":"cne_h002_q1","topicId":"cne_h002","difficulty":"basic","type":"choice","prompt":"Birds fly. 这句属于哪一种基本句型？","choices":[{"key":"A","text":"主谓宾"},{"key":"B","text":"主系表"},{"key":"C","text":"双宾语"},{"key":"D","text":"主谓"}],"answer":"D","explanation":"fly 是不及物动词，后面没有宾语。","verify":"\"主谓\""},{"id":"cne_h002_q2","topicId":"cne_h002","difficulty":"basic","type":"choice","prompt":"She gave me a book. 这句属于哪一种基本句型？","choices":[{"key":"A","text":"双宾语"},{"key":"B","text":"主谓"},{"key":"C","text":"主系表"},{"key":"D","text":"只有一个宾语"}],"answer":"A","explanation":"gave 后面有 me 和 a book 两个宾语。","verify":"\"双宾语\""},{"id":"cne_h002_q3","topicId":"cne_h002","difficulty":"standard","type":"choice","prompt":"The soup tastes good. 这句属于哪一种基本句型？","choices":[{"key":"A","text":"主谓宾"},{"key":"B","text":"主系表"},{"key":"C","text":"双宾语"},{"key":"D","text":"宾语补足语"}],"answer":"B","explanation":"tastes 是系动词，good 是表语。","verify":"\"主系表\""},{"id":"cne_h002_q4","topicId":"cne_h002","difficulty":"standard","type":"choice","prompt":"哪一句是主谓宾？","choices":[{"key":"A","text":"The baby cried"},{"key":"B","text":"He is a doctor"},{"key":"C","text":"They play basketball"},{"key":"D","text":"She looks happy"}],"answer":"C","explanation":"play 是及物动词，basketball 是宾语。","verify":"\"They play basketball\""},{"id":"cne_h003_q1","topicId":"cne_h003","difficulty":"basic","type":"choice","prompt":"We call him Tom. 句中 Tom 是什么成分？","choices":[{"key":"A","text":"宾语补足语"},{"key":"B","text":"主语"},{"key":"C","text":"定语"},{"key":"D","text":"状语"}],"answer":"A","explanation":"Tom 补充说明宾语 him，是宾补。","verify":"\"宾语补足语\""},{"id":"cne_h003_q2","topicId":"cne_h003","difficulty":"basic","type":"choice","prompt":"I found the film interesting. interesting 是什么成分？","choices":[{"key":"A","text":"主语"},{"key":"B","text":"宾语补足语"},{"key":"C","text":"谓语"},{"key":"D","text":"间接宾语"}],"answer":"B","explanation":"interesting 补充说明宾语 the film。","verify":"\"宾语补足语\""},{"id":"cne_h003_q3","topicId":"cne_h003","difficulty":"standard","type":"choice","prompt":"哪一句含有宾语补足语？","choices":[{"key":"A","text":"She gave me a pen"},{"key":"B","text":"They are friends"},{"key":"C","text":"The news made her happy"},{"key":"D","text":"Birds can fly"}],"answer":"C","explanation":"happy 补充说明宾语 her。gave me a pen 是双宾语。","verify":"\"The news made her happy\""},{"id":"cne_h003_q4","topicId":"cne_h003","difficulty":"standard","type":"choice","prompt":"Please keep the room clean. clean 修饰说明的是哪一个？","choices":[{"key":"A","text":"Please"},{"key":"B","text":"keep"},{"key":"C","text":"句末的句号"},{"key":"D","text":"the room"}],"answer":"D","explanation":"clean 是宾补，说明宾语 the room 的状态。","verify":"\"the room\""},{"id":"cne_h004_q1","topicId":"cne_h004","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「校园」？","choices":[{"key":"A","text":"lecture"},{"key":"B","text":"campus"},{"key":"C","text":"locker"},{"key":"D","text":"freshman"}],"answer":"B","explanation":"campus 的意思是校园。","verify":"\"campus\""},{"id":"cne_h004_q2","topicId":"cne_h004","difficulty":"basic","type":"choice","prompt":"「lecture」的中文意思是哪一个？","choices":[{"key":"A","text":"校园"},{"key":"B","text":"储物柜"},{"key":"C","text":"讲座"},{"key":"D","text":"新生"}],"answer":"C","explanation":"lecture 的意思是讲座。","verify":"\"讲座\""},{"id":"cne_h004_q3","topicId":"cne_h004","difficulty":"standard","type":"choice","prompt":"选择表示「储物柜」的单词。","choices":[{"key":"A","text":"campus"},{"key":"B","text":"lecture"},{"key":"C","text":"freshman"},{"key":"D","text":"locker"}],"answer":"D","explanation":"表示储物柜的单词是 locker。","verify":"\"locker\""},{"id":"cne_h004_q4","topicId":"cne_h004","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「新生」？","choices":[{"key":"A","text":"freshman"},{"key":"B","text":"campus"},{"key":"C","text":"lecture"},{"key":"D","text":"locker"}],"answer":"A","explanation":"freshman 的意思是新生。","verify":"\"freshman\""},{"id":"cne_h005_q1","topicId":"cne_h005","difficulty":"basic","type":"choice","prompt":"开学第一天，想问好并说出自己的名字，哪一句合适？","choices":[{"key":"A","text":"Hi, my name are Lin"},{"key":"B","text":"Hi, your name is Lin"},{"key":"C","text":"Hi, my name is Lin"},{"key":"D","text":"Hi, my name Lin is"}],"answer":"C","explanation":"问候并自报姓名用 Hi, my name is。","verify":"\"Hi, my name is Lin\""},{"id":"cne_h005_q2","topicId":"cne_h005","difficulty":"basic","type":"choice","prompt":"对方说 Nice to meet you. 你应回答什么？","choices":[{"key":"A","text":"See you yesterday"},{"key":"B","text":"Nice to meeting you too"},{"key":"C","text":"Nice to meets you too"},{"key":"D","text":"Nice to meet you too"}],"answer":"D","explanation":"回应 Nice to meet you 时加上 too。","verify":"\"Nice to meet you too\""},{"id":"cne_h005_q3","topicId":"cne_h005","difficulty":"standard","type":"choice","prompt":"想告诉同学自己在三班，哪一句合适？","choices":[{"key":"A","text":"I am in Class 3"},{"key":"B","text":"I am at Class 3"},{"key":"C","text":"I is in Class 3"},{"key":"D","text":"He is in Class 3"}],"answer":"A","explanation":"说明自己的班级用 I am in Class 3。","verify":"\"I am in Class 3\""},{"id":"cne_h005_q4","topicId":"cne_h005","difficulty":"standard","type":"choice","prompt":"早上在教学楼遇见老师，哪一句是问候？","choices":[{"key":"A","text":"Good mornings"},{"key":"B","text":"Good morning"},{"key":"C","text":"Goodbye"},{"key":"D","text":"Good afternoon"}],"answer":"B","explanation":"Good morning 用来问候早晨。","verify":"\"Good morning\""},{"id":"cne_h006_q1","topicId":"cne_h006","difficulty":"basic","type":"choice","prompt":"Lin is a new student. She is in Class 3. Her first lecture is on Monday. Lin 是什么身份？","choices":[{"key":"A","text":"老师"},{"key":"B","text":"医生"},{"key":"C","text":"司机"},{"key":"D","text":"新生"}],"answer":"D","explanation":"短文写 She is a new student。","verify":"\"新生\""},{"id":"cne_h006_q2","topicId":"cne_h006","difficulty":"basic","type":"choice","prompt":"Lin is a new student. She is in Class 3. Her first lecture is on Monday. 她在哪个班？","choices":[{"key":"A","text":"三班"},{"key":"B","text":"一班"},{"key":"C","text":"五班"},{"key":"D","text":"九班"}],"answer":"A","explanation":"短文写 She is in Class 3。","verify":"\"三班\""},{"id":"cne_h006_q3","topicId":"cne_h006","difficulty":"standard","type":"choice","prompt":"Lin is a new student. She is in Class 3. Her first lecture is on Monday. 她的第一堂讲座在哪一天？","choices":[{"key":"A","text":"星期二"},{"key":"B","text":"星期一"},{"key":"C","text":"星期五"},{"key":"D","text":"星期日"}],"answer":"B","explanation":"短文写 on Monday。","verify":"\"星期一\""},{"id":"cne_h006_q4","topicId":"cne_h006","difficulty":"standard","type":"choice","prompt":"Lin is a new student. She is in Class 3. Her first lecture is on Monday. 哪一句和短文一致？","choices":[{"key":"A","text":"Lin is a teacher"},{"key":"B","text":"Lin is in Class 9"},{"key":"C","text":"Lin has a lecture on Monday"},{"key":"D","text":"The lecture is on Friday"}],"answer":"C","explanation":"短文只说她是新生，周一有讲座。","verify":"\"Lin has a lecture on Monday\""},{"id":"cne_h007_q1","topicId":"cne_h007","difficulty":"basic","type":"choice","prompt":"要点：姓名林晓、三班、喜欢音乐。哪一句三个要点都有？","choices":[{"key":"A","text":"I am Lin Xiao in Class 3, and I like music"},{"key":"B","text":"I am Lin Xiao in Class 3"},{"key":"C","text":"I like music and football"},{"key":"D","text":"I am Lin Xiao in Class 3, and I like football"}],"answer":"A","explanation":"姓名、班级和音乐三个要点都要出现。","verify":"\"I am Lin Xiao in Class 3, and I like music\""},{"id":"cne_h007_q2","topicId":"cne_h007","difficulty":"basic","type":"choice","prompt":"想用邮件向笔友介绍自己是新生，哪一句合适？","choices":[{"key":"A","text":"I is a new student at this school"},{"key":"B","text":"I am a new student at this school"},{"key":"C","text":"I am an new student at this school"},{"key":"D","text":"I not am a new student at this school"}],"answer":"B","explanation":"介绍自己的身份用 I am a new student。","verify":"\"I am a new student at this school\""},{"id":"cne_h007_q3","topicId":"cne_h007","difficulty":"standard","type":"choice","prompt":"自我介绍要写爱好，哪一句在写爱好？","choices":[{"key":"A","text":"The campus is large"},{"key":"B","text":"Monday is a day"},{"key":"C","text":"I enjoy playing basketball"},{"key":"D","text":"Class 3 is a room"}],"answer":"C","explanation":"enjoy playing basketball 是在说爱好。","verify":"\"I enjoy playing basketball\""},{"id":"cne_h007_q4","topicId":"cne_h007","difficulty":"standard","type":"choice","prompt":"哪一句适合放在自我介绍的开头？","choices":[{"key":"A","text":"Hello, let me to introduce myself"},{"key":"B","text":"Hello, let me introducing myself"},{"key":"C","text":"Hello, let me introduce me"},{"key":"D","text":"Hello, let me introduce myself"}],"answer":"D","explanation":"自我介绍开头常用 Hello, let me introduce myself。","verify":"\"Hello, let me introduce myself\""},{"id":"cne_h008_q1","topicId":"cne_h008","difficulty":"basic","type":"choice","prompt":"一般疑问句 Are you in Class 3? 句末通常用什么语调？","choices":[{"key":"A","text":"降调"},{"key":"B","text":"升调"},{"key":"C","text":"每个词都重读"},{"key":"D","text":"没有语调"}],"answer":"B","explanation":"一般疑问句句末通常用升调。","verify":"\"升调\""},{"id":"cne_h008_q2","topicId":"cne_h008","difficulty":"basic","type":"choice","prompt":"陈述句 I am a new student. 句末通常用什么语调？","choices":[{"key":"A","text":"升调"},{"key":"B","text":"先升后降再升"},{"key":"C","text":"降调"},{"key":"D","text":"只在 student 上不停"}],"answer":"C","explanation":"陈述句句末通常用降调。","verify":"\"降调\""},{"id":"cne_h008_q3","topicId":"cne_h008","difficulty":"standard","type":"choice","prompt":"特殊疑问句 Where is the lecture? 句末通常用什么语调？","choices":[{"key":"A","text":"升调"},{"key":"B","text":"和一般疑问句相同的升调"},{"key":"C","text":"只在 where 上上升"},{"key":"D","text":"降调"}],"answer":"D","explanation":"特殊疑问句句末通常用降调。","verify":"\"降调\""},{"id":"cne_h008_q4","topicId":"cne_h008","difficulty":"standard","type":"choice","prompt":"哪一句朗读时句末通常用升调？","choices":[{"key":"A","text":"Is the locker yours"},{"key":"B","text":"The locker is mine"},{"key":"C","text":"Where is the locker"},{"key":"D","text":"She is a freshman"}],"answer":"A","explanation":"Is the locker yours 是一般疑问句，句末用升调。","verify":"\"Is the locker yours\""}]
