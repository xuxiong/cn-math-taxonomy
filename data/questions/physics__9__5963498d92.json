[{"id":"cnp_075_q1","topicId":"cnp_075","difficulty":"basic","type":"numeric","prompt":"一盏灯两端电压 220 V，通过的电流为 0.2 A，它的电功率是多少 W？（只填数值）","answer":"44","explanation":"P = UI = 220 × 0.2 = 44 W。","verify":"220*0.2"},{"id":"cnp_075_q2","topicId":"cnp_075","difficulty":"basic","type":"numeric","prompt":"一个 1000 W 的电热水壶正常工作 0.5 h，消耗多少 kW·h 的电能？（只填数值）","answer":"0.5","explanation":"W = Pt = 1 kW × 0.5 h = 0.5 kW·h。","verify":"1*0.5"},{"id":"cnp_075_q3","topicId":"cnp_075","difficulty":"standard","type":"choice","prompt":"灯泡的亮暗由什么决定？","choices":[{"key":"A","text":"实际功率"},{"key":"B","text":"额定功率"},{"key":"C","text":"额定电压"},{"key":"D","text":"通过的电流方向"}],"answer":"A","explanation":"灯泡亮度由实际功率决定，实际功率越大越亮。","verify":"\"实际功率\""},{"id":"cnp_075_q4","topicId":"cnp_075","difficulty":"advanced","type":"choice","prompt":"标有“220 V 100 W”的灯泡，正常发光时的电阻是多少？","choices":[{"key":"A","text":"2.2 Ω"},{"key":"B","text":"0.45 Ω"},{"key":"C","text":"484 Ω"},{"key":"D","text":"22000 Ω"}],"answer":"C","explanation":"R = U²/P = 220² ÷ 100 = 484 Ω。","verify":"220**2/100"}]
