[{"id":"cnm_h088_q1","topicId":"cnm_h088","difficulty":"basic","type":"numeric","prompt":"求 (1，2)·(3，4)。","answer":"11","explanation":"1×3+2×4=11。","verify":"1*3+2*4"},{"id":"cnm_h088_q2","topicId":"cnm_h088","difficulty":"basic","type":"numeric","prompt":"求 (1，0)·(0，1)。","answer":"0","explanation":"坐标基向量互相垂直，数量积是 0。","verify":"1*0+0*1"},{"id":"cnm_h088_q3","topicId":"cnm_h088","difficulty":"standard","type":"numeric","prompt":"a=(2，−1)，求 a·a。","answer":"5","explanation":"4+1=5，等于模的平方。","verify":"2*2+(-1)*(-1)"},{"id":"cnm_h088_q4","topicId":"cnm_h088","difficulty":"standard","type":"choice","prompt":"数量积的结果是？","choices":[{"key":"A","text":"一个实数"},{"key":"B","text":"一个向量"},{"key":"C","text":"一条直线"},{"key":"D","text":"一个点"}],"answer":"A","explanation":"数量积又叫点积，结果是数，不是向量。","verify":"\"一个实数\""},{"id":"cnm_h089_q1","topicId":"cnm_h089","difficulty":"basic","type":"numeric","prompt":"a=(3，4)。|a|²=a·a，|a| 是多少？","answer":"5","explanation":"3²+4²=25，模是 5。","verify":"isqrt(3*3+4*4)"},{"id":"cnm_h089_q2","topicId":"cnm_h089","difficulty":"basic","type":"numeric","prompt":"a=(1，2)，b=(3，0)，c=(1，1)。先算 a·c 与 b·c 再相加，结果是多少？","answer":"6","explanation":"(a+b)·c=a·c+b·c，1+2+3=6。","verify":"(1*1+2*1)+(3*1+0*1)"},{"id":"cnm_h089_q3","topicId":"cnm_h089","difficulty":"standard","type":"numeric","prompt":"若 a·b=4，则 (2a)·b 是多少？","answer":"8","explanation":"数可以提到数量积外面，2×4=8。","verify":"2*4"},{"id":"cnm_h089_q4","topicId":"cnm_h089","difficulty":"standard","type":"choice","prompt":"一般地，a·b 是否等于 b·a？","choices":[{"key":"A","text":"不等于"},{"key":"B","text":"等于"},{"key":"C","text":"只有垂直时等于"},{"key":"D","text":"只有平行时等于"}],"answer":"B","explanation":"数量积满足交换律，坐标相乘的顺序不影响和。","verify":"\"等于\""},{"id":"cnm_h090_q1","topicId":"cnm_h090","difficulty":"basic","type":"numeric","prompt":"求向量 (3，4) 的模。","answer":"5","explanation":"√(9+16)=√25=5。","verify":"isqrt(3**2+4**2)"},{"id":"cnm_h090_q2","topicId":"cnm_h090","difficulty":"basic","type":"numeric","prompt":"求向量 (5，12) 的模。","answer":"13","explanation":"√(25+144)=√169=13。","verify":"isqrt(5**2+12**2)"},{"id":"cnm_h090_q3","topicId":"cnm_h090","difficulty":"standard","type":"numeric","prompt":"a=(1，2)，b=(2，−1)。a·b 是多少？由此判断是否垂直。","answer":"0","explanation":"2−2=0，数量积为 0，两个向量垂直。","verify":"1*2+2*(-1)"},{"id":"cnm_h090_q4","topicId":"cnm_h090","difficulty":"standard","type":"choice","prompt":"两个非零向量垂直的充要条件是？","choices":[{"key":"A","text":"模相等"},{"key":"B","text":"和是零向量"},{"key":"C","text":"数量积等于 0"},{"key":"D","text":"坐标分别相等"}],"answer":"C","explanation":"a·b=|a||b|cosθ=0，模都不为 0，所以 cosθ=0。","verify":"\"数量积等于 0\""},{"id":"cnm_h091_q1","topicId":"cnm_h091","difficulty":"basic","type":"numeric","prompt":"两边为 2 和 3，夹角的余弦是 1/2。第三边的平方是多少？","answer":"7","explanation":"c²=a²+b²−2ab cosC=4+9−6=7。","verify":"2**2+3**2-2*2*3*Fraction(1,2)"},{"id":"cnm_h091_q2","topicId":"cnm_h091","difficulty":"basic","type":"numeric","prompt":"两边为 3 和 4，夹角为 90°，余弦是 0。第三边的平方是多少？","answer":"25","explanation":"直角时余弦项为 0，3²+4²=25。","verify":"3**2+4**2-0"},{"id":"cnm_h091_q3","topicId":"cnm_h091","difficulty":"standard","type":"numeric","prompt":"上一问中第三边的长是多少？","answer":"5","explanation":"√25=5，这就是勾股定理。","verify":"isqrt(25)"},{"id":"cnm_h091_q4","topicId":"cnm_h091","difficulty":"standard","type":"choice","prompt":"余弦定理在夹角为锐角时，−2ab cosC 这一项？","choices":[{"key":"A","text":"一定是正数"},{"key":"B","text":"一定是 0"},{"key":"C","text":"与夹角无关"},{"key":"D","text":"是负数，第三边平方小于两平方和"}],"answer":"D","explanation":"锐角余弦为正，减去正数，所以比两平方和更小。","verify":"\"是负数，第三边平方小于两平方和\""},{"id":"cnm_h092_q1","topicId":"cnm_h092","difficulty":"basic","type":"numeric","prompt":"a=2，A=30°，sin30°=1/2。a/sinA 等于多少？","answer":"4","explanation":"2÷(1/2)=4。这个值等于外接圆直径 2R。","verify":"2/sin(radians(30))"},{"id":"cnm_h092_q2","topicId":"cnm_h092","difficulty":"basic","type":"numeric","prompt":"在直角三角形中，斜边对 90°，sin90°=1。若斜边 c=6，则 c/sinC 是多少？","answer":"6","explanation":"6/1=6，也就是斜边本身，因为斜边是外接圆直径。","verify":"6/sin(radians(90))"},{"id":"cnm_h092_q3","topicId":"cnm_h092","difficulty":"standard","type":"numeric","prompt":"A=90°，a=10。外接圆半径 R 满足 2R=a/sinA。R 是多少？","answer":"5","explanation":"sin90°=1，2R=10，R=5。","verify":"10/2"},{"id":"cnm_h092_q4","topicId":"cnm_h092","difficulty":"standard","type":"choice","prompt":"正弦定理适合用来？","choices":[{"key":"A","text":"已知两角和一边，或已知两边及其中一边的对角"},{"key":"B","text":"只用来求向量的模"},{"key":"C","text":"代替所有余弦定理"},{"key":"D","text":"只在等边三角形中成立"}],"answer":"A","explanation":"正弦定理把边和它所对的角的正弦联系起来。","verify":"\"已知两角和一边，或已知两边及其中一边的对角\""},{"id":"cnm_h093_q1","topicId":"cnm_h093","difficulty":"basic","type":"numeric","prompt":"三角形两边为 6 和 8，夹角 90°。第三边是多少？","answer":"10","explanation":"直角，第三边 √(36+64)=10。","verify":"isqrt(6**2+8**2)"},{"id":"cnm_h093_q2","topicId":"cnm_h093","difficulty":"basic","type":"numeric","prompt":"等边三角形边长为 2，每个内角是多少度？","answer":"60","explanation":"三边相等则三角相等，每个角是 60°。","verify":"60"},{"id":"cnm_h093_q3","topicId":"cnm_h093","difficulty":"standard","type":"numeric","prompt":"三角形内角和是多少度？","answer":"180","explanation":"解三角形时，已知两角就可以用内角和求第三角。","verify":"180"},{"id":"cnm_h093_q4","topicId":"cnm_h093","difficulty":"standard","type":"choice","prompt":"已知三边求角，优先用？","choices":[{"key":"A","text":"正弦定理"},{"key":"B","text":"余弦定理"},{"key":"C","text":"只量一次量角器"},{"key":"D","text":"向量加法"}],"answer":"B","explanation":"三边都知道时，余弦定理可以直接求出一个角的余弦。","verify":"\"余弦定理\""},{"id":"cnm_h094_q1","topicId":"cnm_h094","difficulty":"basic","type":"numeric","prompt":"船从岸边垂直驶出 12 千米，再沿垂直方向驶 5 千米。离出发点的直线距离是多少千米？","answer":"13","explanation":"两段互相垂直，距离 √(144+25)=13。","verify":"isqrt(12**2+5**2)"},{"id":"cnm_h094_q2","topicId":"cnm_h094","difficulty":"basic","type":"numeric","prompt":"斜坡的垂直高度是 3 米，水平距离是 4 米。坡面长度是多少米？","answer":"5","explanation":"直角三角形的斜边是 5 米。","verify":"isqrt(3**2+4**2)"},{"id":"cnm_h094_q3","topicId":"cnm_h094","difficulty":"standard","type":"numeric","prompt":"直角三角形的斜边为 2，一个锐角为 30°。这个角的对边是多少？","answer":"1","explanation":"对边等于斜边乘正弦，2×1/2=1。","verify":"2*sin(radians(30))"},{"id":"cnm_h094_q4","topicId":"cnm_h094","difficulty":"standard","type":"choice","prompt":"把实际测量化成解三角形时，首先要？","choices":[{"key":"A","text":"直接套正弦定理、不看是哪条边"},{"key":"B","text":"只测量一次长度"},{"key":"C","text":"画示意图并标出已知的边和角"},{"key":"D","text":"忽略直角"}],"answer":"C","explanation":"先看清已知元素是边还是角，再选择定理。","verify":"\"画示意图并标出已知的边和角\""},{"id":"cnm_h095_q1","topicId":"cnm_h095","difficulty":"basic","type":"numeric","prompt":"平行四边形邻边向量为 (2，1) 和 (1，−2)。它们的数量积是多少？","answer":"0","explanation":"2−2=0，所以这两条邻边垂直。","verify":"2*1+1*(-2)"},{"id":"cnm_h095_q2","topicId":"cnm_h095","difficulty":"basic","type":"numeric","prompt":"向量 (6，8) 的模是多少？","answer":"10","explanation":"√(36+64)=10。","verify":"isqrt(6**2+8**2)"},{"id":"cnm_h095_q3","topicId":"cnm_h095","difficulty":"standard","type":"numeric","prompt":"A(0，0)，B(3，4)。线段 AB 的长是多少？","answer":"5","explanation":"向量 AB=(3，4)，模是 5。","verify":"isqrt(3**2+4**2)"},{"id":"cnm_h095_q4","topicId":"cnm_h095","difficulty":"standard","type":"choice","prompt":"用向量证明两线垂直，只要证明对应向量？","choices":[{"key":"A","text":"模相等"},{"key":"B","text":"和为零向量"},{"key":"C","text":"坐标都是正数"},{"key":"D","text":"数量积为 0"}],"answer":"D","explanation":"非零向量数量积为 0 就是垂直。","verify":"\"数量积为 0\""}]
