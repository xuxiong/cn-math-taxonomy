[{"id":"cnm_h221_q1","topicId":"cnm_h221","difficulty":"basic","type":"numeric","prompt":"f(x)=x³ 的导函数在 x=2 的值是多少？","answer":"12","explanation":"(x³)'=3x²，在 x=2 处是 12。","verify":"3*2**2"},{"id":"cnm_h221_q2","topicId":"cnm_h221","difficulty":"basic","type":"numeric","prompt":"f(x)=x^4。f'(1) 等于多少？","answer":"4","explanation":"4x³ 在 x=1 处是 4。","verify":"4*1**3"},{"id":"cnm_h221_q3","topicId":"cnm_h221","difficulty":"standard","type":"numeric","prompt":"f(x)=7。f'(5) 等于多少？","answer":"0","explanation":"常数的导数是 0。","verify":"0"},{"id":"cnm_h221_q4","topicId":"cnm_h221","difficulty":"standard","type":"choice","prompt":"(x²)' 等于哪一个函数？","choices":[{"key":"A","text":"x²"},{"key":"B","text":"2x"},{"key":"C","text":"2"},{"key":"D","text":"x"}],"answer":"B","explanation":"幂的指数放到前面，指数再减 1：2x。","verify":"\"2x\""},{"id":"cnm_h222_q1","topicId":"cnm_h222","difficulty":"basic","type":"numeric","prompt":"f(x)=x²+3x。f'(1) 等于多少？","answer":"5","explanation":"f'(x)=2x+3，在 x=1 处是 5。","verify":"2*1+3"},{"id":"cnm_h222_q2","topicId":"cnm_h222","difficulty":"basic","type":"numeric","prompt":"f(x)=4x³−x。f'(1) 等于多少？","answer":"11","explanation":"f'(x)=12x²−1，在 x=1 处是 11。","verify":"12*1**2-1"},{"id":"cnm_h222_q3","topicId":"cnm_h222","difficulty":"standard","type":"numeric","prompt":"f(x)=5x²。f'(2) 等于多少？","answer":"20","explanation":"(5x²)'=10x，在 x=2 处是 20。","verify":"10*2"},{"id":"cnm_h222_q4","topicId":"cnm_h222","difficulty":"standard","type":"choice","prompt":"和的导数等于什么？","choices":[{"key":"A","text":"导数的积"},{"key":"B","text":"导数的商"},{"key":"C","text":"导数的和"},{"key":"D","text":"原来两个函数的积"}],"answer":"C","explanation":"(u+v)'=u'+v'。","verify":"\"导数的和\""},{"id":"cnm_h223_q1","topicId":"cnm_h223","difficulty":"basic","type":"numeric","prompt":"y=(2x+1)²。在 x=1 处的导数是多少？","answer":"12","explanation":"外层 2(2x+1)，再乘内层导数 2。x=1 时是 2×3×2=12。","verify":"2*(2*1+1)*2"},{"id":"cnm_h223_q2","topicId":"cnm_h223","difficulty":"basic","type":"numeric","prompt":"y=(3x−1)²。在 x=1 处的导数是多少？","answer":"12","explanation":"2×2×3=12。","verify":"2*(3*1-1)*3"},{"id":"cnm_h223_q3","topicId":"cnm_h223","difficulty":"standard","type":"numeric","prompt":"f(x)=x²，y=f(2x)。y 在 x=1 处的导数是多少？","answer":"8","explanation":"(x²)' 在 2x 处是 2×(2x)，再乘 2。x=1 时是 8。","verify":"2*(2*1)*2"},{"id":"cnm_h223_q4","topicId":"cnm_h223","difficulty":"standard","type":"choice","prompt":"求 (ax+b) 的平方的导数时，最后还要乘上什么？","choices":[{"key":"A","text":"一定乘 0"},{"key":"B","text":"一定除以 a"},{"key":"C","text":"不用再乘"},{"key":"D","text":"内层的系数 a"}],"answer":"D","explanation":"复合函数求导要把内层导数乘上去，这里内层导数是 a。","verify":"\"内层的系数 a\""}]
