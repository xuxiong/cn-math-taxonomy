[{"id":"cnm_h078_q1","topicId":"cnm_h078","difficulty":"basic","type":"numeric","prompt":"温度按 y=10+8sin(ωt) 变化。最高温度是多少？","answer":"18","explanation":"正弦最大是 1，最高温度是 10+8=18。","verify":"10+8"},{"id":"cnm_h078_q2","topicId":"cnm_h078","difficulty":"basic","type":"numeric","prompt":"温度按 y=10+8sin(ωt) 变化。最低温度是多少？","answer":"2","explanation":"正弦的最小值是 −1，最低温度是 10+8×(−1)=10−8=2。","verify":"10-8"},{"id":"cnm_h078_q3","topicId":"cnm_h078","difficulty":"standard","type":"numeric","prompt":"摩天轮半径 2 米，中心离地 3 米。最高点离地多少米？","answer":"5","explanation":"最高点比中心再高一个半径，3+2=5。","verify":"3+2"},{"id":"cnm_h078_q4","topicId":"cnm_h078","difficulty":"standard","type":"choice","prompt":"用 y=Asin(ωt+φ)+b 描述周期现象时，b 表示？","choices":[{"key":"A","text":"最高点"},{"key":"B","text":"周期"},{"key":"C","text":"平衡位置"},{"key":"D","text":"起步的时间"}],"answer":"C","explanation":"b 是上下波动的中心。最高是 b+|A|，最低是 b−|A|。","verify":"\"平衡位置\""}]
