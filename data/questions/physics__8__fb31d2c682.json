[{"id":"cnp_011_q1","topicId":"cnp_011","difficulty":"basic","type":"choice","prompt":"物质从固态变成液态叫什么？","choices":[{"key":"A","text":"凝固"},{"key":"B","text":"液化"},{"key":"C","text":"升华"},{"key":"D","text":"熔化"}],"answer":"D","explanation":"固态→液态是熔化，液态→固态是凝固。","verify":"\"熔化\""},{"id":"cnp_011_q2","topicId":"cnp_011","difficulty":"basic","type":"choice","prompt":"下列物质中属于晶体的是哪一个？","choices":[{"key":"A","text":"松香"},{"key":"B","text":"玻璃"},{"key":"C","text":"冰"},{"key":"D","text":"沥青"}],"answer":"C","explanation":"冰有固定的熔点，是晶体；松香、玻璃、沥青没有固定熔点，是非晶体。","verify":"\"冰\""},{"id":"cnp_011_q3","topicId":"cnp_011","difficulty":"standard","type":"choice","prompt":"某晶体熔化图像中，温度在 48 ℃ 保持不变共 6 min。这段时间内物质怎样？","choices":[{"key":"A","text":"不吸热，温度不变"},{"key":"B","text":"放出热量"},{"key":"C","text":"继续吸热，温度不变"},{"key":"D","text":"温度不变，所以没有在熔化"}],"answer":"C","explanation":"晶体熔化过程中要持续吸热，但温度保持在熔点不变。","verify":"\"继续吸热，温度不变\""},{"id":"cnp_011_q4","topicId":"cnp_011","difficulty":"standard","type":"choice","prompt":"北方冬天在菜窖里放几桶水，可以防止菜冻坏，利用了什么？","choices":[{"key":"A","text":"水凝固时吸热"},{"key":"B","text":"水蒸发时吸热"},{"key":"C","text":"水汽化时放热"},{"key":"D","text":"水凝固时放热"}],"answer":"D","explanation":"水结冰（凝固）时放出热量，使菜窖温度不会太低。","verify":"\"水凝固时放热\""}]
