[{"difficulty":"basic","type":"numeric","prompt":"正三角形每个内角是 60 度。围绕一个点拼正三角形，几个正好拼满一周？","answer":"6","explanation":"拼满一周要 360 度：360÷60＝6。","verify":"360//60","id":"cnm_p239_q1","topicId":"cnm_p239"},{"difficulty":"basic","type":"numeric","prompt":"正方形每个内角是 90 度。一个点周围要拼几个正方形才能密铺？","answer":"4","explanation":"360÷90＝4。","verify":"360//90","id":"cnm_p239_q2","topicId":"cnm_p239"},{"difficulty":"standard","type":"numeric","prompt":"正六边形每个内角是 120 度。一个点周围要拼几个正六边形才能密铺？","answer":"3","explanation":"360÷120＝3。","verify":"360//120","id":"cnm_p239_q3","topicId":"cnm_p239"},{"difficulty":"challenge","type":"choice","prompt":"正五边形每个内角是 108 度。只用正五边形能不能密铺？","choices":[{"key":"A","text":"不能，108 度不能整除 360 度"},{"key":"B","text":"能，因为边数是 5"},{"key":"C","text":"只能铺成一行"},{"key":"D","text":"能，因为 108 大于 90"}],"answer":"A","explanation":"108×3＝324，不到 360；108×4＝432，又超过 360。不能正好拼满一周，所以不能密铺。","verify":"'不能，108 度不能整除 360 度'","id":"cnm_p239_q4","topicId":"cnm_p239"}]
