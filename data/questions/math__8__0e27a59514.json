[{"id":"cnm_161_q1","topicId":"cnm_161","difficulty":"standard","type":"choice","prompt":"计算 1/(x-1) - 1/(x+1)。","answer":"C","choices":[{"key":"A","text":"-2/(x²-1)"},{"key":"B","text":"0"},{"key":"C","text":"2/(x²-1)"}],"explanation":"通分：[(x+1)-(x-1)]/[(x-1)(x+1)]=2/(x²-1)。"},{"id":"cnm_161_q2","topicId":"cnm_161","difficulty":"basic","type":"numeric","prompt":"化简 (5x+1)/x - (2x+1)/x（x≠0），结果是一个常数，这个常数是多少？","answer":"3","explanation":"同分母相减，分母不变：(5x+1-2x-1)/x=3x/x=3。","verify":"Fraction(5*1+1,1)-Fraction(2*1+1,1)"},{"id":"cnm_161_q3","topicId":"cnm_161","difficulty":"standard","type":"choice","prompt":"计算 a/(a-b) + b/(b-a)（a≠b），结果是","answer":"A","choices":[{"key":"A","text":"1"},{"key":"B","text":"(a+b)/(a-b)"},{"key":"C","text":"(a+b)/(a^2-b^2)"}],"explanation":"b/(b-a)=-b/(a-b)，所以原式=(a-b)/(a-b)=1。","verify":"Fraction(7,7-3)+Fraction(3,3-7)"},{"id":"cnm_161_q4","topicId":"cnm_161","difficulty":"standard","type":"numeric","prompt":"化简 2/(x^2-4) + 1/(x+2)，再求 x=4 时的值（写成最简分数）。","answer":"1/3","explanation":"通分得 [2+(x-2)]/(x^2-4)=x/(x^2-4)，x=4 时为 4/12=1/3。","verify":"Fraction(2,4**2-4)+Fraction(1,4+2)"},{"id":"cnm_162_q1","topicId":"cnm_162","difficulty":"standard","type":"choice","prompt":"化简 (1+1/x)÷((x+1)/x²)。","answer":"B","choices":[{"key":"A","text":"1/x"},{"key":"B","text":"x"},{"key":"C","text":"(x+1)^2/x^3"}],"explanation":"括号内 1+1/x=(x+1)/x，除以 (x+1)/x² 即乘 x²/(x+1)，得 x。"},{"id":"cnm_162_q2","topicId":"cnm_162","difficulty":"basic","type":"numeric","prompt":"当 x=2 时，求 (1+1/x)·x 的值。","answer":"3","explanation":"先算括号：1+1/2=3/2，再乘 2 得 3。","verify":"(1+Fraction(1,2))*2"},{"id":"cnm_162_q3","topicId":"cnm_162","difficulty":"standard","type":"numeric","prompt":"化简 (1 - 1/(x+1)) ÷ (x/(x^2-1))，再求 x=5 时的值。","answer":"4","explanation":"括号内 1-1/(x+1)=x/(x+1)，除以 x/(x^2-1) 即乘 (x^2-1)/x，得 (x-1)，x=5 时为 4。","verify":"(1-Fraction(1,6))/Fraction(5,24)"},{"id":"cnm_162_q4","topicId":"cnm_162","difficulty":"advanced","type":"numeric","prompt":"先化简再求值：(a+2-5/(a-2)) ÷ ((a-3)/(2a-4))，其中 a=1。","answer":"8","explanation":"括号内 =(a^2-9)/(a-2)，除以 (a-3)/(2(a-2)) 得 2(a+3)，a=1 时为 8。","verify":"(1+2-Fraction(5,1-2))/Fraction(1-3,2*1-4)"}]
