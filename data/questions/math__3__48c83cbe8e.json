[{"difficulty":"basic","type":"choice","prompt":"电梯上下运动，属于哪一种运动现象？","choices":[{"key":"A","text":"旋转"},{"key":"B","text":"轴对称"},{"key":"C","text":"平移"}],"answer":"C","explanation":"电梯沿直线上下移动，是平移。","verify":"'平移'","id":"cnm_p228_q1","topicId":"cnm_p228"},{"difficulty":"basic","type":"choice","prompt":"风车转动，属于哪一种运动现象？","choices":[{"key":"A","text":"轴对称"},{"key":"B","text":"旋转"},{"key":"C","text":"平移"}],"answer":"B","explanation":"风车绕中心转动，是旋转。","verify":"'旋转'","id":"cnm_p228_q2","topicId":"cnm_p228"},{"difficulty":"standard","type":"choice","prompt":"把一张纸对折后剪出一个图案，展开后折痕两边的图案怎样？","choices":[{"key":"A","text":"两边完全一样"},{"key":"B","text":"左边大"},{"key":"C","text":"右边大"}],"answer":"A","explanation":"对折剪开再展开，折痕两边一样，这是轴对称。","verify":"'两边完全一样'","id":"cnm_p228_q3","topicId":"cnm_p228"},{"difficulty":"challenge","type":"numeric","prompt":"一个小方块先向右平移 5 格，再向左平移 2 格。和原来的位置比，向右移动了几格？","answer":"3","explanation":"向右 5 格、向左 2 格，实际向右 5－2＝3 格。","verify":"5-2","id":"cnm_p228_q4","topicId":"cnm_p228"},{"difficulty":"basic","type":"choice","prompt":"把一张纸对折后再剪图案，展开后两边一样。这种剪纸主要用到哪种现象？","choices":[{"key":"A","text":"轴对称"},{"key":"B","text":"平移"},{"key":"C","text":"旋转"}],"answer":"A","explanation":"对折剪纸展开后两边一样，是轴对称。","verify":"'轴对称'","id":"cnm_p281_q1","topicId":"cnm_p281"},{"difficulty":"basic","type":"numeric","prompt":"一张正方形纸对折 1 次再剪，展开后折痕把纸分成几部分？","answer":"2","explanation":"对折 1 次分成 2 部分。","verify":"2","id":"cnm_p281_q2","topicId":"cnm_p281"},{"difficulty":"standard","type":"numeric","prompt":"把纸对折 2 次（每次都对齐），展开后一共有几条折痕？","answer":"2","explanation":"对折两次留下 2 条折痕。","verify":"2","id":"cnm_p281_q3","topicId":"cnm_p281"},{"difficulty":"challenge","type":"choice","prompt":"剪出一个左右完全一样的窗花，下面哪一步最关键？","choices":[{"key":"A","text":"先对折再剪"},{"key":"B","text":"只剪一边、不对称"},{"key":"C","text":"随便撕开"}],"answer":"A","explanation":"先对折再剪，展开后两边才会一样。","verify":"'先对折再剪'","id":"cnm_p281_q4","topicId":"cnm_p281"}]
