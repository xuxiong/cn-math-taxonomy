[{"id":"cnp_005_q1","topicId":"cnp_005","difficulty":"basic","type":"choice","prompt":"声音是怎样产生的？","choices":[{"key":"A","text":"由物体振动产生"},{"key":"B","text":"由物体运动产生"},{"key":"C","text":"由空气流动产生"},{"key":"D","text":"由物体发热产生"}],"answer":"A","explanation":"一切正在发声的物体都在振动，振动停止，发声也停止。","verify":"\"由物体振动产生\""},{"id":"cnp_005_q2","topicId":"cnp_005","difficulty":"basic","type":"choice","prompt":"宇航员在太空舱外不能直接对话，原因是什么？","choices":[{"key":"A","text":"太空太冷"},{"key":"B","text":"真空不能传声"},{"key":"C","text":"声音传得太快"},{"key":"D","text":"宇航员发声太小"}],"answer":"B","explanation":"声音的传播需要介质，太空中接近真空，所以要用无线电交流。","verify":"\"真空不能传声\""},{"id":"cnp_005_q3","topicId":"cnp_005","difficulty":"standard","type":"choice","prompt":"一般情况下，声音在下列哪种介质中传播得最快？","choices":[{"key":"A","text":"钢铁"},{"key":"B","text":"空气"},{"key":"C","text":"水"},{"key":"D","text":"真空"}],"answer":"A","explanation":"一般情况下声速 v固 > v液 > v气，真空不能传声。","verify":"\"钢铁\""},{"id":"cnp_005_q4","topicId":"cnp_005","difficulty":"standard","type":"choice","prompt":"敲鼓时在鼓面上放些纸屑，纸屑跳动。这个实验运用了什么方法？","choices":[{"key":"A","text":"转换法"},{"key":"B","text":"控制变量法"},{"key":"C","text":"等效替代法"},{"key":"D","text":"理想模型法"}],"answer":"A","explanation":"鼓面振动不易直接看到，用纸屑跳动把微小振动显示出来，这是转换法。","verify":"\"转换法\""}]
