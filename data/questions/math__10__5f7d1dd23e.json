[{"id":"cnm_h060_q1","topicId":"cnm_h060","difficulty":"basic","type":"numeric","prompt":"求 sin90°。","answer":"1","explanation":"终边在 y 轴正方向，单位圆交点是 (0，1)，正弦是 1。","verify":"sin(radians(90))"},{"id":"cnm_h060_q2","topicId":"cnm_h060","difficulty":"basic","type":"numeric","prompt":"求 sin30°。","answer":"1/2","explanation":"sin30°=1/2。","verify":"sin(radians(30))"},{"id":"cnm_h060_q3","topicId":"cnm_h060","difficulty":"standard","type":"numeric","prompt":"求 cos0°。","answer":"1","explanation":"终边在 x 轴正方向，交点是 (1，0)，余弦是 1。","verify":"cos(radians(0))"},{"id":"cnm_h060_q4","topicId":"cnm_h060","difficulty":"standard","type":"choice","prompt":"单位圆上，正弦对应该点的？","choices":[{"key":"A","text":"纵坐标"},{"key":"B","text":"横坐标"},{"key":"C","text":"到原点的距离"},{"key":"D","text":"圆心角的度数"}],"answer":"A","explanation":"余弦是横坐标，正弦是纵坐标。单位圆上这点到原点的距离是 1。","verify":"\"纵坐标\""},{"id":"cnm_h061_q1","topicId":"cnm_h061","difficulty":"basic","type":"numeric","prompt":"求 sin180°。","answer":"0","explanation":"终边在 x 轴负方向，交点 (−1，0)，正弦是 0。","verify":"sin(radians(180))"},{"id":"cnm_h061_q2","topicId":"cnm_h061","difficulty":"basic","type":"numeric","prompt":"求 cos180°。","answer":"-1","explanation":"交点的横坐标是 −1。","verify":"cos(radians(180))"},{"id":"cnm_h061_q3","topicId":"cnm_h061","difficulty":"standard","type":"numeric","prompt":"求 sin270°。","answer":"-1","explanation":"终边在 y 轴负方向，纵坐标是 −1。","verify":"sin(radians(270))"},{"id":"cnm_h061_q4","topicId":"cnm_h061","difficulty":"standard","type":"choice","prompt":"第二象限内，正弦和余弦的符号是？","choices":[{"key":"A","text":"都为正"},{"key":"B","text":"正弦为正，余弦为负"},{"key":"C","text":"正弦为负，余弦为正"},{"key":"D","text":"都为负"}],"answer":"B","explanation":"第二象限的点横坐标为负、纵坐标为正。","verify":"\"正弦为正，余弦为负\""},{"id":"cnm_h062_q1","topicId":"cnm_h062","difficulty":"basic","type":"numeric","prompt":"计算 sin²30°+cos²30°。","answer":"1","explanation":"同角的正弦平方与余弦平方之和恒为 1。","verify":"sin(radians(30))**2+cos(radians(30))**2"},{"id":"cnm_h062_q2","topicId":"cnm_h062","difficulty":"basic","type":"numeric","prompt":"sinθ=3/5，求 25cos²θ。","answer":"16","explanation":"cos²θ=1−(3/5)²=1−9/25=16/25，所以 25cos²θ=16。","verify":"25*(1-Fraction(9,25))"},{"id":"cnm_h062_q3","topicId":"cnm_h062","difficulty":"standard","type":"numeric","prompt":"cosθ=0 时，sin²θ 是多少？","answer":"1","explanation":"由平方和为 1，sin²θ=1。","verify":"1"},{"id":"cnm_h062_q4","topicId":"cnm_h062","difficulty":"standard","type":"choice","prompt":"sin²θ+cos²θ 恒等于？","choices":[{"key":"A","text":"0"},{"key":"B","text":"θ"},{"key":"C","text":"1"},{"key":"D","text":"2"}],"answer":"C","explanation":"这是同角三角函数的基本关系，对使式子有意义的角都成立。","verify":"\"1\""},{"id":"cnm_h063_q1","topicId":"cnm_h063","difficulty":"basic","type":"numeric","prompt":"θ 为锐角，sinθ=1/2。求 2sinθ。","answer":"1","explanation":"2×1/2=1。","verify":"2*Fraction(1,2)"},{"id":"cnm_h063_q2","topicId":"cnm_h063","difficulty":"basic","type":"numeric","prompt":"求 tan45°。","answer":"1","explanation":"45° 时正弦和余弦相等，正切是 1。","verify":"tan(radians(45))"},{"id":"cnm_h063_q3","topicId":"cnm_h063","difficulty":"standard","type":"numeric","prompt":"θ 在 0° 到 90° 之间（含端点），且 cosθ=1。求 sinθ。","answer":"0","explanation":"在这个范围内 cosθ=1 只有 θ=0°，正弦是 0。","verify":"0"},{"id":"cnm_h063_q4","topicId":"cnm_h063","difficulty":"standard","type":"choice","prompt":"已知 sinθ=1/2，且 θ 在第二象限。cosθ 的符号是？","choices":[{"key":"A","text":"正"},{"key":"B","text":"零"},{"key":"C","text":"可正可负"},{"key":"D","text":"负"}],"answer":"D","explanation":"第二象限余弦为负。余弦的绝对值由平方关系决定，符号由象限决定。","verify":"\"负\""}]
