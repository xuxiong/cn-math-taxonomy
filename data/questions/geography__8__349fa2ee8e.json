[{"id":"cng_j031_q1","topicId":"cng_j031","difficulty":"basic","type":"choice","prompt":"我国领土面积大约是？","choices":[{"key":"A","text":"960 万平方千米"},{"key":"B","text":"90 万平方千米"},{"key":"C","text":"9.6 万平方千米"},{"key":"D","text":"1700 万平方千米"}],"answer":"A","explanation":"我国陆地领土面积约 960 万平方千米，居世界第三位。","verify":"\"960 万平方千米\""},{"id":"cng_j031_q2","topicId":"cng_j031","difficulty":"basic","type":"choice","prompt":"我国最东端在黑龙江与乌苏里江主航道中心线的相交处，最西端在？","choices":[{"key":"A","text":"曾母暗沙"},{"key":"B","text":"新疆帕米尔高原"},{"key":"C","text":"漠河以北的黑龙江主航道中心线"},{"key":"D","text":"海南岛南部"}],"answer":"B","explanation":"东西端经度差大，最西端位于帕米尔高原。","verify":"\"新疆帕米尔高原\""},{"id":"cng_j031_q3","topicId":"cng_j031","difficulty":"standard","type":"choice","prompt":"我国大陆海岸线漫长，濒临的海洋自北向南依次是？","choices":[{"key":"A","text":"南海、东海、黄海、渤海"},{"key":"B","text":"北海、地中海、红海、阿拉伯海"},{"key":"C","text":"渤海、黄海、东海、南海"},{"key":"D","text":"北冰洋、大西洋、印度洋、太平洋"}],"answer":"C","explanation":"东部自北向南濒临渤海、黄海、东海、南海。","verify":"\"渤海、黄海、东海、南海\""},{"id":"cng_j031_q4","topicId":"cng_j031","difficulty":"challenge","type":"choice","prompt":"我国陆上邻国有 14 个，与韩国、日本等是？","choices":[{"key":"A","text":"陆上接壤的邻国"},{"key":"B","text":"没有海洋相隔的内陆国"},{"key":"C","text":"位于南美洲的国家"},{"key":"D","text":"隔海相望的国家"}],"answer":"D","explanation":"朝鲜、韩国、日本、菲律宾、马来西亚、文莱、印度尼西亚等隔海相望（教材常列 6 个隔海相望国家）。","verify":"\"隔海相望的国家\""},{"id":"cng_j032_q1","topicId":"cng_j032","difficulty":"basic","type":"choice","prompt":"我国是世界上人口最多的国家之一，人口分布的基本特点是？","choices":[{"key":"A","text":"西北多、东南少"},{"key":"B","text":"东南多、西北少"},{"key":"C","text":"均匀分布"},{"key":"D","text":"只集中在青藏高原"}],"answer":"B","explanation":"黑河—腾冲一线以东人口稠密，以西稀疏。","verify":"\"东南多、西北少\""},{"id":"cng_j032_q2","topicId":"cng_j032","difficulty":"basic","type":"choice","prompt":"黑河—腾冲一线是我国重要的？","choices":[{"key":"A","text":"赤道"},{"key":"B","text":"北回归线"},{"key":"C","text":"人口地理分界线"},{"key":"D","text":"地势第一、二级阶梯分界线"}],"answer":"C","explanation":"该线以东面积约占 43%，人口占 90% 以上。","verify":"\"人口地理分界线\""},{"id":"cng_j032_q3","topicId":"cng_j032","difficulty":"standard","type":"choice","prompt":"人口过多会带来的突出问题是？","choices":[{"key":"A","text":"耕地会自动增加"},{"key":"B","text":"所有资源都变得取之不尽"},{"key":"C","text":"自然灾害完全消失"},{"key":"D","text":"就业、教育和资源环境压力增大"}],"answer":"D","explanation":"人口基数大，资源、环境和公共服务压力大。","verify":"\"就业、教育和资源环境压力增大\""},{"id":"cng_j032_q4","topicId":"cng_j032","difficulty":"challenge","type":"choice","prompt":"我国把计划生育作为基本国策后，近年来又调整生育政策，主要是为了？","choices":[{"key":"A","text":"促进人口长期均衡发展"},{"key":"B","text":"使人口无限增长"},{"key":"C","text":"完全停止人口流动"},{"key":"D","text":"取消所有公共服务"}],"answer":"A","explanation":"政策随人口形势调整，既要控制过快增长，也要应对老龄化等问题。","verify":"\"促进人口长期均衡发展\""},{"id":"cng_j033_q1","topicId":"cng_j033","difficulty":"basic","type":"choice","prompt":"我国共有多少个民族？","choices":[{"key":"A","text":"55 个"},{"key":"B","text":"16 个"},{"key":"C","text":"56 个"},{"key":"D","text":"1 个"}],"answer":"C","explanation":"汉族和 55 个少数民族，共 56 个民族。","verify":"\"56 个\""},{"id":"cng_j033_q2","topicId":"cng_j033","difficulty":"basic","type":"choice","prompt":"汉族人口最多，少数民族主要分布在？","choices":[{"key":"A","text":"只有东南沿海大城市"},{"key":"B","text":"全部集中在华北平原中部"},{"key":"C","text":"只分布在海南岛"},{"key":"D","text":"西南、西北和东北等地"}],"answer":"D","explanation":"少数民族多分布在边疆的西南、西北和东北地区。","verify":"\"西南、西北和东北等地\""},{"id":"cng_j033_q3","topicId":"cng_j033","difficulty":"standard","type":"choice","prompt":"我国民族分布的特点常概括为？","choices":[{"key":"A","text":"大杂居、小聚居、交错居住"},{"key":"B","text":"完全按省界隔离"},{"key":"C","text":"汉族只住西部"},{"key":"D","text":"少数民族只住东部沿海"}],"answer":"A","explanation":"各民族既有相对集中的聚居区，又广泛交错居住。","verify":"\"大杂居、小聚居、交错居住\""},{"id":"cng_j033_q4","topicId":"cng_j033","difficulty":"challenge","type":"choice","prompt":"各少数民族都有使用和发展自己语言文字的自由，体现了？","choices":[{"key":"A","text":"只允许一种语言存在"},{"key":"B","text":"民族平等和民族团结"},{"key":"C","text":"民族文化必须全部消失"},{"key":"D","text":"民族区域与国家无关"}],"answer":"B","explanation":"宪法保障各民族的平等权利和文化传承。","verify":"\"民族平等和民族团结\""}]
