[{"id":"cnm_151_q1","topicId":"cnm_151","difficulty":"basic","type":"choice","prompt":"分解因式 6a²b-9ab²。","answer":"B","choices":[{"key":"A","text":"3ab(2a+3b)"},{"key":"B","text":"3ab(2a-3b)"},{"key":"C","text":"3ab(2a-3b²)"},{"key":"D","text":"6ab(a-b)"}],"explanation":"系数 6 与 9 的最大公约数 3，相同字母最低次幂 ab，公因式 3ab；提出后 6a²b÷3ab=2a，9ab²÷3ab=3b。"},{"id":"cnm_151_q2","topicId":"cnm_151","difficulty":"basic","type":"numeric","prompt":"多项式 12x²y 与 18xy² 的公因式中，数字系数是多少？","answer":"6","explanation":"公因式的系数取各项系数的最大公约数，12 与 18 的最大公约数是 6。","verify":"gcd(12,18)"},{"id":"cnm_151_q3","topicId":"cnm_151","difficulty":"standard","type":"choice","prompt":"分解因式 2x²+2x（要求分解彻底），结果是：","answer":"C","choices":[{"key":"A","text":"2x·x"},{"key":"B","text":"x(2x+2)"},{"key":"C","text":"2x(x+1)"},{"key":"D","text":"2(x²+x)"}],"explanation":"公因式是 2x，提出后括号内是 x+1，项数不变（不能漏掉 1）；A 的结果不等于原式，B、D 没有提尽公因式。"},{"id":"cnm_151_q4","topicId":"cnm_151","difficulty":"standard","type":"numeric","prompt":"已知 a+b=5，ab=4，求 a²b+ab² 的值。","answer":"20","explanation":"a²b+ab²=ab(a+b)=4×5=20。","verify":"4*5"},{"id":"cnm_151_q5","topicId":"cnm_151","difficulty":"advanced","type":"numeric","prompt":"计算 (-2)^11+(-2)^10 的值。","answer":"-1024","explanation":"提公因式 (-2)^10：(-2)^10×(-2+1)=1024×(-1)=-1024。","verify":"(-2)**11+(-2)**10"}]
