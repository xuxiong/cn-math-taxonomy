[{"id":"cns_p175_q1","topicId":"cns_p175","difficulty":"basic","type":"choice","prompt":"目前已知唯一存在生命的星球是哪一颗？","choices":[{"key":"A","text":"地球"},{"key":"B","text":"火星"},{"key":"C","text":"月球"},{"key":"D","text":"金星"}],"answer":"A","explanation":"目前只在地球上发现生命。","verify":"\"地球\""},{"id":"cns_p175_q2","topicId":"cns_p175","difficulty":"basic","type":"choice","prompt":"地球上有液态水，主要因为什么？","choices":[{"key":"A","text":"地球很大"},{"key":"B","text":"地球离太阳距离适中，温度适宜"},{"key":"C","text":"地球不会转"},{"key":"D","text":"地球上石头多"}],"answer":"B","explanation":"温度适宜，水才能保持液态。","verify":"\"地球离太阳距离适中，温度适宜\""},{"id":"cns_p175_q3","topicId":"cns_p175","difficulty":"standard","type":"choice","prompt":"地球的大气层对生命有什么作用？","choices":[{"key":"A","text":"让地球更重"},{"key":"B","text":"把水全部带走"},{"key":"C","text":"提供氧气，阻挡部分有害辐射"},{"key":"D","text":"没有作用"}],"answer":"C","explanation":"大气层保护着地球生命。","verify":"\"提供氧气，阻挡部分有害辐射\""},{"id":"cns_p175_q4","topicId":"cns_p175","difficulty":"challenge","type":"choice","prompt":"下面哪一项不是地球适合生命存在的条件？","choices":[{"key":"A","text":"适宜的温度"},{"key":"B","text":"液态水"},{"key":"C","text":"大气"},{"key":"D","text":"表面全被岩石覆盖、没有水"}],"answer":"D","explanation":"没有水，生命无法存在。","verify":"\"表面全被岩石覆盖、没有水\""},{"id":"cns_p176_q1","topicId":"cns_p176","difficulty":"basic","type":"choice","prompt":"工厂向河流排放未处理的废水，会造成什么问题？","choices":[{"key":"A","text":"空气更清新"},{"key":"B","text":"水污染"},{"key":"C","text":"土壤更肥沃"},{"key":"D","text":"没有影响"}],"answer":"B","explanation":"废水会污染河流。","verify":"\"水污染\""},{"id":"cns_p176_q2","topicId":"cns_p176","difficulty":"basic","type":"choice","prompt":"汽车尾气和燃烧煤炭主要会造成什么污染？","choices":[{"key":"A","text":"土壤盐碱化"},{"key":"B","text":"水变清"},{"key":"C","text":"空气污染"},{"key":"D","text":"噪声消失"}],"answer":"C","explanation":"尾气和燃煤排放有害气体和颗粒。","verify":"\"空气污染\""},{"id":"cns_p176_q3","topicId":"cns_p176","difficulty":"standard","type":"choice","prompt":"「白色污染」指的是什么？","choices":[{"key":"A","text":"白色油漆"},{"key":"B","text":"雪太多"},{"key":"C","text":"白云"},{"key":"D","text":"废弃塑料造成的污染"}],"answer":"D","explanation":"塑料袋、塑料餐盒等难以降解。","verify":"\"废弃塑料造成的污染\""},{"id":"cns_p176_q4","topicId":"cns_p176","difficulty":"challenge","type":"choice","prompt":"全球变暖与人类的哪种活动关系最大？","choices":[{"key":"A","text":"大量燃烧煤、石油等排放二氧化碳"},{"key":"B","text":"种树"},{"key":"C","text":"节约用水"},{"key":"D","text":"垃圾分类"}],"answer":"A","explanation":"二氧化碳增多使全球温度升高。","verify":"\"大量燃烧煤、石油等排放二氧化碳\""},{"id":"cns_p177_q1","topicId":"cns_p177","difficulty":"basic","type":"choice","prompt":"下面哪种做法是节约用水？","choices":[{"key":"A","text":"边刷牙边开着水龙头"},{"key":"B","text":"用长流水洗菜"},{"key":"C","text":"用淘米水浇花"},{"key":"D","text":"水龙头滴水不管"}],"answer":"C","explanation":"一水多用能节约水。","verify":"\"用淘米水浇花\""},{"id":"cns_p177_q2","topicId":"cns_p177","difficulty":"basic","type":"choice","prompt":"地球上能直接利用的淡水约占全部水的多少？","choices":[{"key":"A","text":"约 50%"},{"key":"B","text":"约 71%"},{"key":"C","text":"约 97%"},{"key":"D","text":"不到 1%（约 0.3%）"}],"answer":"D","explanation":"可直接利用的淡水非常少。","verify":"\"不到 1%（约 0.3%）\""},{"id":"cns_p177_q3","topicId":"cns_p177","difficulty":"standard","type":"choice","prompt":"污水处理厂处理污水，第一步通常是什么？","choices":[{"key":"A","text":"用格栅和沉淀除去大颗粒杂质"},{"key":"B","text":"直接饮用"},{"key":"C","text":"直接排入河中"},{"key":"D","text":"加糖"}],"answer":"A","explanation":"先过滤沉淀，再进一步处理。","verify":"\"用格栅和沉淀除去大颗粒杂质\""},{"id":"cns_p177_q4","topicId":"cns_p177","difficulty":"challenge","type":"choice","prompt":"一个水龙头每秒滴 1 滴水，每滴约 0.05 毫升，1 小时大约浪费多少毫升水？","choices":[{"key":"A","text":"60 毫升"},{"key":"B","text":"180 毫升"},{"key":"C","text":"1800 毫升"},{"key":"D","text":"3.6 毫升"}],"answer":"B","explanation":"3600 × 0.05 = 180 毫升。","verify":"\"180 毫升\""},{"id":"cns_p178_q1","topicId":"cns_p178","difficulty":"basic","type":"choice","prompt":"废旧电池应该投放到哪类垃圾桶？","choices":[{"key":"A","text":"可回收物"},{"key":"B","text":"厨余垃圾"},{"key":"C","text":"其他垃圾"},{"key":"D","text":"有害垃圾"}],"answer":"D","explanation":"电池含有害物质，属于有害垃圾。","verify":"\"有害垃圾\""},{"id":"cns_p178_q2","topicId":"cns_p178","difficulty":"basic","type":"choice","prompt":"吃剩的菜叶、果皮属于哪类垃圾？","choices":[{"key":"A","text":"厨余垃圾（湿垃圾）"},{"key":"B","text":"有害垃圾"},{"key":"C","text":"可回收物"},{"key":"D","text":"其他垃圾"}],"answer":"A","explanation":"易腐烂的食物残渣是厨余垃圾。","verify":"\"厨余垃圾（湿垃圾）\""},{"id":"cns_p178_q3","topicId":"cns_p178","difficulty":"standard","type":"choice","prompt":"废旧报纸、塑料瓶属于哪类垃圾？","choices":[{"key":"A","text":"有害垃圾"},{"key":"B","text":"可回收物"},{"key":"C","text":"厨余垃圾"},{"key":"D","text":"其他垃圾"}],"answer":"B","explanation":"纸、塑料、金属、玻璃可回收再利用。","verify":"\"可回收物\""},{"id":"cns_p178_q4","topicId":"cns_p178","difficulty":"challenge","type":"choice","prompt":"下面哪种做法能从源头上减少垃圾？","choices":[{"key":"A","text":"多用一次性筷子"},{"key":"B","text":"把垃圾全部焚烧"},{"key":"C","text":"购物自带布袋，少用一次性用品"},{"key":"D","text":"把垃圾倒进河里"}],"answer":"C","explanation":"减少使用是减少垃圾最有效的方法。","verify":"\"购物自带布袋，少用一次性用品\""},{"id":"cns_p179_q1","topicId":"cns_p179","difficulty":"basic","type":"choice","prompt":"下面哪种是可再生能源？","choices":[{"key":"A","text":"太阳能"},{"key":"B","text":"煤"},{"key":"C","text":"石油"},{"key":"D","text":"天然气"}],"answer":"A","explanation":"太阳能、风能、水能可以不断再生。","verify":"\"太阳能\""},{"id":"cns_p179_q2","topicId":"cns_p179","difficulty":"basic","type":"choice","prompt":"煤、石油属于哪类能源？","choices":[{"key":"A","text":"可再生能源"},{"key":"B","text":"不可再生能源"},{"key":"C","text":"清洁的新能源"},{"key":"D","text":"取之不尽的能源"}],"answer":"B","explanation":"化石能源形成需要几百万年，用完就没有了。","verify":"\"不可再生能源\""},{"id":"cns_p179_q3","topicId":"cns_p179","difficulty":"standard","type":"choice","prompt":"下面哪种做法最节约能源？","choices":[{"key":"A","text":"电视长时间待机"},{"key":"B","text":"开着空调开窗"},{"key":"C","text":"随手关灯，多步行或骑车"},{"key":"D","text":"白天开灯"}],"answer":"C","explanation":"减少浪费就是节约能源。","verify":"\"随手关灯，多步行或骑车\""},{"id":"cns_p179_q4","topicId":"cns_p179","difficulty":"challenge","type":"choice","prompt":"下面哪一组都是可再生能源？","choices":[{"key":"A","text":"煤、石油和天然气"},{"key":"B","text":"石油和煤"},{"key":"C","text":"天然气和石油"},{"key":"D","text":"太阳能、风能和水能"}],"answer":"D","explanation":"太阳、风和水可以持续获得，属于可再生能源。","verify":"\"太阳能、风能和水能\""},{"id":"cns_p239_q1","topicId":"cns_p239","difficulty":"basic","type":"choice","prompt":"废纸回收后可以做成什么？","choices":[{"key":"A","text":"再生纸"},{"key":"B","text":"新的石油"},{"key":"C","text":"新的大树"},{"key":"D","text":"铁块"}],"answer":"A","explanation":"废纸经过处理能做成再生纸。","verify":"\"再生纸\""},{"id":"cns_p239_q2","topicId":"cns_p239","difficulty":"basic","type":"choice","prompt":"把用过的玻璃瓶收集起来再制成玻璃制品，这是在做什么？","choices":[{"key":"A","text":"把玻璃扔掉不再使用"},{"key":"B","text":"让资源再生"},{"key":"C","text":"把玻璃变成石油"},{"key":"D","text":"停止使用任何玻璃"}],"answer":"B","explanation":"回收后再制成可用物品，就是让资源再生。","verify":"\"让资源再生\""},{"id":"cns_p239_q3","topicId":"cns_p239","difficulty":"standard","type":"choice","prompt":"下面哪种做法属于废物再利用？","choices":[{"key":"A","text":"把还能用的纸全部烧掉"},{"key":"B","text":"把空瓶扔进河里"},{"key":"C","text":"用旧衣服改成抹布"},{"key":"D","text":"把金属罐埋起来不管"}],"answer":"C","explanation":"旧物经过处理后还能使用，就是再利用。","verify":"\"用旧衣服改成抹布\""},{"id":"cns_p239_q4","topicId":"cns_p239","difficulty":"challenge","type":"choice","prompt":"让资源再生的主要意义是什么？","choices":[{"key":"A","text":"制造更多无法处理的垃圾"},{"key":"B","text":"加快用完矿产"},{"key":"C","text":"把所有废物直接倒掉"},{"key":"D","text":"减少浪费，让废物变成可再用的资源"}],"answer":"D","explanation":"再生利用能让废物重新派上用场。","verify":"\"减少浪费，让废物变成可再用的资源\""},{"id":"cns_p240_q1","topicId":"cns_p240","difficulty":"basic","type":"choice","prompt":"分析一个实际的环境问题，第一步通常要做什么？","choices":[{"key":"A","text":"先随便找一个人责备"},{"key":"B","text":"弄清问题是什么、发生在哪里"},{"key":"C","text":"先编一组没有依据的数据"},{"key":"D","text":"先宣布问题已经解决"}],"answer":"B","explanation":"先把问题本身说清楚，后面才能查原因、想办法。","verify":"\"弄清问题是什么、发生在哪里\""},{"id":"cns_p240_q2","topicId":"cns_p240","difficulty":"basic","type":"choice","prompt":"查找环境问题的原因时，比较合理的做法是什么？","choices":[{"key":"A","text":"只凭一次猜测下结论"},{"key":"B","text":"不看现场只看心情"},{"key":"C","text":"观察现象，收集相关事实再判断"},{"key":"D","text":"把原因写成与问题无关的事"}],"answer":"C","explanation":"原因要依据观察到的事实来找。","verify":"\"观察现象，收集相关事实再判断\""},{"id":"cns_p240_q3","topicId":"cns_p240","difficulty":"standard","type":"choice","prompt":"针对一个环境问题提出办法时，要注意什么？","choices":[{"key":"A","text":"办法与原因完全无关"},{"key":"B","text":"只说以后再说"},{"key":"C","text":"提出无法做到的空话"},{"key":"D","text":"办法要针对查到的原因，并且可以实行"}],"answer":"D","explanation":"办法要对准原因，并且能够去做。","verify":"\"办法要针对查到的原因，并且可以实行\""},{"id":"cns_p240_q4","topicId":"cns_p240","difficulty":"challenge","type":"choice","prompt":"分析环境问题比较完整的思路是哪一种？","choices":[{"key":"A","text":"弄清问题、查找原因、提出办法"},{"key":"B","text":"只记一个口号"},{"key":"C","text":"只抱怨不查原因"},{"key":"D","text":"不看问题直接结束"}],"answer":"A","explanation":"先弄清问题，再找原因，然后想办法。","verify":"\"弄清问题、查找原因、提出办法\""}]
