[{"id":"cnd_p005_q1","topicId":"cnd_p005","difficulty":"basic","type":"choice","prompt":"见到老师，有礼貌的做法是？","choices":[{"key":"A","text":"假装没看见走开"},{"key":"B","text":"大声喊外号"},{"key":"C","text":"主动说“老师好”"},{"key":"D","text":"躲起来"}],"answer":"C","explanation":"见到老师要主动问好。","verify":"\"主动说“老师好”\""},{"id":"cnd_p005_q2","topicId":"cnd_p005","difficulty":"basic","type":"choice","prompt":"上课想发言，应该怎么做？","choices":[{"key":"A","text":"直接打断老师大喊"},{"key":"B","text":"摔书表示不满"},{"key":"C","text":"离开座位乱跑"},{"key":"D","text":"先举手，得到允许再讲"}],"answer":"D","explanation":"发言要先举手。","verify":"\"先举手，得到允许再讲\""},{"id":"cnd_p005_q3","topicId":"cnd_p005","difficulty":"standard","type":"choice","prompt":"为什么要尊敬老师？","choices":[{"key":"A","text":"老师教导我们学习、帮助我们成长"},{"key":"B","text":"因为老师会发零食"},{"key":"C","text":"只是害怕批评"},{"key":"D","text":"老师与我们无关"}],"answer":"A","explanation":"老师传授知识、关心成长。","verify":"\"老师教导我们学习、帮助我们成长\""},{"id":"cnd_p005_q4","topicId":"cnd_p005","difficulty":"challenge","type":"choice","prompt":"向老师表达感谢，合适的方式是？","choices":[{"key":"A","text":"逃课去玩"},{"key":"B","text":"真诚地说声谢谢或送一张手工贺卡"},{"key":"C","text":"把作业撕掉"},{"key":"D","text":"在黑板乱画"}],"answer":"B","explanation":"真诚的话语或小卡片最合适。","verify":"\"真诚地说声谢谢或送一张手工贺卡\""},{"id":"cnd_p006_q1","topicId":"cnd_p006","difficulty":"basic","type":"choice","prompt":"交新朋友时，比较好的做法是？","choices":[{"key":"A","text":"抢别人玩具强迫对方"},{"key":"B","text":"只和一个人说话不理他人"},{"key":"C","text":"嘲笑新同学的口音"},{"key":"D","text":"微笑、自我介绍、一起玩"}],"answer":"D","explanation":"友好介绍自己更容易交到朋友。","verify":"\"微笑、自我介绍、一起玩\""},{"id":"cnd_p006_q2","topicId":"cnd_p006","difficulty":"basic","type":"choice","prompt":"好朋友之间最重要的是？","choices":[{"key":"A","text":"互相尊重、诚实、友爱"},{"key":"B","text":"谁玩具多谁说了算"},{"key":"C","text":"永远不能有不同意见"},{"key":"D","text":"只能一个人说了算"}],"answer":"A","explanation":"友谊建立在尊重和诚实上。","verify":"\"互相尊重、诚实、友爱\""},{"id":"cnd_p006_q3","topicId":"cnd_p006","difficulty":"standard","type":"choice","prompt":"新同学一个人坐着，你可以？","choices":[{"key":"A","text":"假装没看见"},{"key":"B","text":"主动邀请他一起玩"},{"key":"C","text":"偷偷议论他"},{"key":"D","text":"挪走他的座位"}],"answer":"B","explanation":"主动关心新同学。","verify":"\"主动邀请他一起玩\""},{"id":"cnd_p006_q4","topicId":"cnd_p006","difficulty":"challenge","type":"choice","prompt":"和朋友闹小矛盾，较好做法是？","choices":[{"key":"A","text":"立刻绝交说坏话"},{"key":"B","text":"动手打人"},{"key":"C","text":"心平气和说清楚，必要时道歉"},{"key":"D","text":"联合别人孤立对方"}],"answer":"C","explanation":"有矛盾要沟通，不能伤害对方。","verify":"\"心平气和说清楚，必要时道歉\""},{"id":"cnd_p007_q1","topicId":"cnd_p007","difficulty":"basic","type":"choice","prompt":"上课铃响了，应该？","choices":[{"key":"A","text":"迅速回教室坐好准备上课"},{"key":"B","text":"继续在操场玩"},{"key":"C","text":"走廊里追逐"},{"key":"D","text":"故意迟到"}],"answer":"A","explanation":"铃响要尽快回教室。","verify":"\"迅速回教室坐好准备上课\""},{"id":"cnd_p007_q2","topicId":"cnd_p007","difficulty":"basic","type":"choice","prompt":"听老师讲课，正确做法是？","choices":[{"key":"A","text":"偷偷玩橡皮"},{"key":"B","text":"认真听讲，做好必要记录"},{"key":"C","text":"说悄悄话"},{"key":"D","text":"睡觉"}],"answer":"B","explanation":"认真听讲才能学好。","verify":"\"认真听讲，做好必要记录\""},{"id":"cnd_p007_q3","topicId":"cnd_p007","difficulty":"standard","type":"choice","prompt":"为什么要好好学习？","choices":[{"key":"A","text":"只为零食奖励"},{"key":"B","text":"学习没用"},{"key":"C","text":"增长本领，为将来打基础"},{"key":"D","text":"只为炫耀"}],"answer":"C","explanation":"学习增长知识和本领。","verify":"\"增长本领，为将来打基础\""},{"id":"cnd_p007_q4","topicId":"cnd_p007","difficulty":"challenge","type":"choice","prompt":"听不懂一个问题，较好做法是？","choices":[{"key":"A","text":"装作已经懂了"},{"key":"B","text":"合上书不听"},{"key":"C","text":"责怪老师"},{"key":"D","text":"下课请教老师或同学"}],"answer":"D","explanation":"有疑问要及时请教。","verify":"\"下课请教老师或同学\""},{"id":"cnd_p008_q1","topicId":"cnd_p008","difficulty":"basic","type":"choice","prompt":"课余时间适合做什么？","choices":[{"key":"A","text":"整天打游戏不休息"},{"key":"B","text":"阅读、运动或参加兴趣活动"},{"key":"C","text":"楼道疯跑撞人"},{"key":"D","text":"打扰正在学习的同学"}],"answer":"B","explanation":"课余应选择有益活动。","verify":"\"阅读、运动或参加兴趣活动\""},{"id":"cnd_p008_q2","topicId":"cnd_p008","difficulty":"basic","type":"choice","prompt":"课间比较安全的活动是？","choices":[{"key":"A","text":"爬窗看外面"},{"key":"B","text":"楼梯口推挤"},{"key":"C","text":"上厕所、喝水、做放松活动"},{"key":"D","text":"危险追逐"}],"answer":"C","explanation":"课间注意安全。","verify":"\"上厕所、喝水、做放松活动\""},{"id":"cnd_p008_q3","topicId":"cnd_p008","difficulty":"standard","type":"choice","prompt":"参加兴趣小组应注意？","choices":[{"key":"A","text":"只顾自己不协作"},{"key":"B","text":"损坏器材"},{"key":"C","text":"嘲笑别人"},{"key":"D","text":"遵守规则，团结合作"}],"answer":"D","explanation":"活动也要守规则、会合作。","verify":"\"遵守规则，团结合作\""},{"id":"cnd_p008_q4","topicId":"cnd_p008","difficulty":"challenge","type":"choice","prompt":"为什么课余生活重要？","choices":[{"key":"A","text":"能放松身心、发展兴趣"},{"key":"B","text":"课余只该看电视"},{"key":"C","text":"课余没有意义"},{"key":"D","text":"只有上课才有价值"}],"answer":"A","explanation":"丰富课余有助全面发展。","verify":"\"能放松身心、发展兴趣\""}]
