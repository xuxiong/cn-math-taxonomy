[{"id":"cns_p001_q1","topicId":"cns_p001","difficulty":"basic","type":"choice","prompt":"下面哪一个是植物？","choices":[{"key":"A","text":"小狗"},{"key":"B","text":"石头"},{"key":"C","text":"小草"},{"key":"D","text":"铅笔"}],"answer":"C","explanation":"小草会生长，是植物。小狗是动物，石头和铅笔没有生命。","verify":"\"小草\""},{"id":"cns_p001_q2","topicId":"cns_p001","difficulty":"basic","type":"choice","prompt":"植物和石头最大的不同是什么？","choices":[{"key":"A","text":"植物是绿色的"},{"key":"B","text":"植物很重"},{"key":"C","text":"植物摸起来硬"},{"key":"D","text":"植物会生长"}],"answer":"D","explanation":"植物是有生命的，会长大；石头不会长大。不是所有植物都绿，也不是都硬。","verify":"\"植物会生长\""},{"id":"cns_p001_q3","topicId":"cns_p001","difficulty":"standard","type":"choice","prompt":"下面哪一组都是植物？","choices":[{"key":"A","text":"大树、青菜、小草"},{"key":"B","text":"大树、小鸟、小草"},{"key":"C","text":"青菜、蝴蝶、大树"},{"key":"D","text":"石头、小草、青菜"}],"answer":"A","explanation":"小鸟、蝴蝶是动物，石头没有生命，只有大树、青菜、小草都是植物。","verify":"\"大树、青菜、小草\""},{"id":"cns_p001_q4","topicId":"cns_p001","difficulty":"challenge","type":"choice","prompt":"小明说「塑料花也是植物」，这个说法对吗？","choices":[{"key":"A","text":"对，它有花朵"},{"key":"B","text":"不对，塑料花不会生长，不是植物"},{"key":"C","text":"对，它是绿色的"},{"key":"D","text":"对，它放在花盆里"}],"answer":"B","explanation":"判断是不是植物要看有没有生命、会不会生长。塑料花是人做的，不会长大。","verify":"\"不对，塑料花不会生长，不是植物\""},{"id":"cns_p002_q1","topicId":"cns_p002","difficulty":"basic","type":"choice","prompt":"植物长在土里的部分通常叫什么？","choices":[{"key":"A","text":"叶"},{"key":"B","text":"花"},{"key":"C","text":"果实"},{"key":"D","text":"根"}],"answer":"D","explanation":"根一般长在土里，吸水并固定植物。","verify":"\"根\""},{"id":"cns_p002_q2","topicId":"cns_p002","difficulty":"basic","type":"choice","prompt":"观察植物时，不应该做的是哪一项？","choices":[{"key":"A","text":"随便尝一尝叶子"},{"key":"B","text":"用眼睛看"},{"key":"C","text":"用手轻轻摸"},{"key":"D","text":"用放大镜看"}],"answer":"A","explanation":"不认识的植物可能有毒，不能随便尝。","verify":"\"随便尝一尝叶子\""},{"id":"cns_p002_q3","topicId":"cns_p002","difficulty":"standard","type":"choice","prompt":"一棵大树的树干，是植物的哪一部分？","choices":[{"key":"A","text":"根"},{"key":"B","text":"茎"},{"key":"C","text":"叶"},{"key":"D","text":"花"}],"answer":"B","explanation":"树干是大树的茎，连接根和枝叶。","verify":"\"茎\""},{"id":"cns_p002_q4","topicId":"cns_p002","difficulty":"challenge","type":"choice","prompt":"观察一株小草，下面哪一种记录方法最好？","choices":[{"key":"A","text":"只看一眼就走"},{"key":"B","text":"把小草拔下来带回家"},{"key":"C","text":"画下来并写上看到的特点"},{"key":"D","text":"只记住小草的名字"}],"answer":"C","explanation":"观察要仔细，并把看到的特点记录下来。随便拔草会伤害植物。","verify":"\"画下来并写上看到的特点\""},{"id":"cns_p003_q1","topicId":"cns_p003","difficulty":"basic","type":"choice","prompt":"荷花通常长在哪里？","choices":[{"key":"A","text":"池塘里"},{"key":"B","text":"沙漠里"},{"key":"C","text":"树枝上"},{"key":"D","text":"石头里"}],"answer":"A","explanation":"荷花是水生植物，长在池塘、湖泊中。","verify":"\"池塘里\""},{"id":"cns_p003_q2","topicId":"cns_p003","difficulty":"basic","type":"choice","prompt":"下面哪种植物通常长在水里？","choices":[{"key":"A","text":"仙人掌"},{"key":"B","text":"浮萍"},{"key":"C","text":"松树"},{"key":"D","text":"向日葵"}],"answer":"B","explanation":"浮萍漂在水面上生活。仙人掌、松树、向日葵长在陆地上。","verify":"\"浮萍\""},{"id":"cns_p003_q3","topicId":"cns_p003","difficulty":"standard","type":"choice","prompt":"仙人掌多生长在哪种地方？","choices":[{"key":"A","text":"深水里"},{"key":"B","text":"很潮湿的地方"},{"key":"C","text":"干旱的地方"},{"key":"D","text":"冰面上"}],"answer":"C","explanation":"仙人掌能储存水分，适合在干旱的地方生活。","verify":"\"干旱的地方\""},{"id":"cns_p003_q4","topicId":"cns_p003","difficulty":"challenge","type":"choice","prompt":"为什么不同地方长着不同的植物？","choices":[{"key":"A","text":"植物喜欢搬家"},{"key":"B","text":"植物是人随便放的"},{"key":"C","text":"所有地方的植物都一样"},{"key":"D","text":"植物要适应它生活的环境"}],"answer":"D","explanation":"不同环境水分、阳光不同，适应那里环境的植物才能在那里生长。","verify":"\"植物要适应它生活的环境\""},{"id":"cns_p004_q1","topicId":"cns_p004","difficulty":"basic","type":"choice","prompt":"给植物画像时，先要做什么？","choices":[{"key":"A","text":"随便画一棵树"},{"key":"B","text":"仔细观察植物"},{"key":"C","text":"先涂颜色"},{"key":"D","text":"先写名字再走开"}],"answer":"B","explanation":"画像前要认真观察植物的样子。","verify":"\"仔细观察植物\""},{"id":"cns_p004_q2","topicId":"cns_p004","difficulty":"basic","type":"choice","prompt":"一株完整的植物画像里，最下面一般画什么？","choices":[{"key":"A","text":"花"},{"key":"B","text":"果实"},{"key":"C","text":"根"},{"key":"D","text":"叶"}],"answer":"C","explanation":"根长在最下面的土里。","verify":"\"根\""},{"id":"cns_p004_q3","topicId":"cns_p004","difficulty":"standard","type":"choice","prompt":"给一片叶子画像时，最需要画准的是什么？","choices":[{"key":"A","text":"叶子旁边的小鸟"},{"key":"B","text":"天上的云"},{"key":"C","text":"叶子的价格"},{"key":"D","text":"叶子的形状和边缘"}],"answer":"D","explanation":"叶子的形状、边缘是它的重要特征。","verify":"\"叶子的形状和边缘\""},{"id":"cns_p004_q4","topicId":"cns_p004","difficulty":"challenge","type":"choice","prompt":"小红画的向日葵有 10 片叶子，可实际只有 6 片，她应该怎么做？","choices":[{"key":"A","text":"再观察一次，按实际改正"},{"key":"B","text":"不用管它"},{"key":"C","text":"再多画几片更好看"},{"key":"D","text":"把真的向日葵摘几片叶子"}],"answer":"A","explanation":"科学的画像要和实物一致，画错了要重新观察并改正。","verify":"\"再观察一次，按实际改正\""},{"id":"cns_p005_q1","topicId":"cns_p005","difficulty":"basic","type":"choice","prompt":"一棵小树苗过了几年，通常会怎样？","choices":[{"key":"A","text":"变成石头"},{"key":"B","text":"越来越小"},{"key":"C","text":"长高长大"},{"key":"D","text":"一点也不变"}],"answer":"C","explanation":"植物是有生命的，会生长。","verify":"\"长高长大\""},{"id":"cns_p005_q2","topicId":"cns_p005","difficulty":"basic","type":"choice","prompt":"秋天，很多树的叶子会怎样？","choices":[{"key":"A","text":"变成红色的花"},{"key":"B","text":"长得更绿更多"},{"key":"C","text":"变成果实"},{"key":"D","text":"变黄并落下"}],"answer":"D","explanation":"很多树到了秋天叶子变黄、落下。","verify":"\"变黄并落下\""},{"id":"cns_p005_q3","topicId":"cns_p005","difficulty":"standard","type":"choice","prompt":"要知道一株植物有没有长高，最好的办法是什么？","choices":[{"key":"A","text":"隔几天量一量并记录"},{"key":"B","text":"看一眼就猜"},{"key":"C","text":"问同学"},{"key":"D","text":"把它拔出来看"}],"answer":"A","explanation":"定期测量并记录，才能比较出变化。","verify":"\"隔几天量一量并记录\""},{"id":"cns_p005_q4","topicId":"cns_p005","difficulty":"challenge","type":"choice","prompt":"植物发生变化，说明了什么？","choices":[{"key":"A","text":"植物是人造的"},{"key":"B","text":"植物是有生命的"},{"key":"C","text":"植物会走路"},{"key":"D","text":"植物不需要水"}],"answer":"B","explanation":"生长变化是生命的特征。","verify":"\"植物是有生命的\""},{"id":"cns_p006_q1","topicId":"cns_p006","difficulty":"basic","type":"choice","prompt":"在校园里看到漂亮的花，应该怎么做？","choices":[{"key":"A","text":"摘下来带回家"},{"key":"B","text":"踩一踩"},{"key":"C","text":"折一枝送人"},{"key":"D","text":"只看不摘"}],"answer":"D","explanation":"要爱护花草，只观察不摘。","verify":"\"只看不摘\""},{"id":"cns_p006_q2","topicId":"cns_p006","difficulty":"basic","type":"choice","prompt":"调查校园植物时，需要记录什么？","choices":[{"key":"A","text":"植物的名称、样子和位置"},{"key":"B","text":"同学的生日"},{"key":"C","text":"天气预报"},{"key":"D","text":"教室的门牌"}],"answer":"A","explanation":"记录植物的名称、样子和长在哪里，便于比较。","verify":"\"植物的名称、样子和位置\""},{"id":"cns_p006_q3","topicId":"cns_p006","difficulty":"standard","type":"choice","prompt":"校园里的大树和小草，都需要什么才能活下去？","choices":[{"key":"A","text":"电和玩具"},{"key":"B","text":"水和阳光"},{"key":"C","text":"水和石头"},{"key":"D","text":"糖果"}],"answer":"B","explanation":"植物生长需要水和阳光。","verify":"\"水和阳光\""},{"id":"cns_p006_q4","topicId":"cns_p006","difficulty":"challenge","type":"choice","prompt":"小明发现草坪上有块地方的草枯黄了，最可能的原因是什么？","choices":[{"key":"A","text":"那里阳光太好"},{"key":"B","text":"那里的草太多了"},{"key":"C","text":"那里的草被人常常踩踏"},{"key":"D","text":"草喜欢变黄"}],"answer":"C","explanation":"草被反复踩踏会受伤枯黄，所以要走小路，不踩草坪。","verify":"\"那里的草被人常常踩踏\""},{"id":"cns_p007_q1","topicId":"cns_p007","difficulty":"basic","type":"choice","prompt":"植物从土里吸水靠的是什么？","choices":[{"key":"A","text":"根"},{"key":"B","text":"花"},{"key":"C","text":"果实"},{"key":"D","text":"叶"}],"answer":"A","explanation":"根把水从土里吸上来。","verify":"\"根\""},{"id":"cns_p007_q2","topicId":"cns_p007","difficulty":"basic","type":"choice","prompt":"把水从根运送到叶子的部分是什么？","choices":[{"key":"A","text":"花"},{"key":"B","text":"茎"},{"key":"C","text":"种子"},{"key":"D","text":"果实"}],"answer":"B","explanation":"茎连接根和叶，运送水分。","verify":"\"茎\""},{"id":"cns_p007_q3","topicId":"cns_p007","difficulty":"standard","type":"choice","prompt":"下面哪一样我们吃的是植物的叶？","choices":[{"key":"A","text":"胡萝卜"},{"key":"B","text":"土豆"},{"key":"C","text":"青菜"},{"key":"D","text":"苹果"}],"answer":"C","explanation":"青菜吃的是叶；胡萝卜吃根，土豆吃茎，苹果是果实。","verify":"\"青菜\""},{"id":"cns_p007_q4","topicId":"cns_p007","difficulty":"challenge","type":"choice","prompt":"大风吹来，大树没有倒下，主要靠哪部分？","choices":[{"key":"A","text":"绿绿的叶子"},{"key":"B","text":"漂亮的花"},{"key":"C","text":"树上的果实"},{"key":"D","text":"深深扎在土里的根"}],"answer":"D","explanation":"根扎得深，能把植物牢牢固定在土里。","verify":"\"深深扎在土里的根\""}]
