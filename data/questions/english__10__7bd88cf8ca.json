[{"id":"cne_h009_q1","topicId":"cne_h009","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「课程」？","choices":[{"key":"A","text":"homework"},{"key":"B","text":"quiz"},{"key":"C","text":"course"},{"key":"D","text":"grade"}],"answer":"C","explanation":"course 的意思是课程。","verify":"\"course\""},{"id":"cne_h009_q2","topicId":"cne_h009","difficulty":"basic","type":"choice","prompt":"「homework」的中文意思是哪一个？","choices":[{"key":"A","text":"课程"},{"key":"B","text":"小测验"},{"key":"C","text":"成绩"},{"key":"D","text":"家庭作业"}],"answer":"D","explanation":"homework 的意思是家庭作业。","verify":"\"家庭作业\""},{"id":"cne_h009_q3","topicId":"cne_h009","difficulty":"standard","type":"choice","prompt":"选择表示「小测验」的单词。","choices":[{"key":"A","text":"quiz"},{"key":"B","text":"course"},{"key":"C","text":"homework"},{"key":"D","text":"grade"}],"answer":"A","explanation":"表示小测验的单词是 quiz。","verify":"\"quiz\""},{"id":"cne_h009_q4","topicId":"cne_h009","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「成绩」？","choices":[{"key":"A","text":"course"},{"key":"B","text":"grade"},{"key":"C","text":"homework"},{"key":"D","text":"quiz"}],"answer":"B","explanation":"grade 的意思是成绩。","verify":"\"grade\""},{"id":"cne_h010_q1","topicId":"cne_h010","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「挑战」？","choices":[{"key":"A","text":"debate"},{"key":"B","text":"volunteer"},{"key":"C","text":"confident"},{"key":"D","text":"challenge"}],"answer":"D","explanation":"challenge 的意思是挑战。","verify":"\"challenge\""},{"id":"cne_h010_q2","topicId":"cne_h010","difficulty":"basic","type":"choice","prompt":"「debate」的中文意思是哪一个？","choices":[{"key":"A","text":"辩论"},{"key":"B","text":"挑战"},{"key":"C","text":"志愿者"},{"key":"D","text":"自信的"}],"answer":"A","explanation":"debate 的意思是辩论。","verify":"\"辩论\""},{"id":"cne_h010_q3","topicId":"cne_h010","difficulty":"standard","type":"choice","prompt":"选择表示「志愿者」的单词。","choices":[{"key":"A","text":"challenge"},{"key":"B","text":"volunteer"},{"key":"C","text":"debate"},{"key":"D","text":"confident"}],"answer":"B","explanation":"表示志愿者的单词是 volunteer。","verify":"\"volunteer\""},{"id":"cne_h010_q4","topicId":"cne_h010","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「自信的」？","choices":[{"key":"A","text":"challenge"},{"key":"B","text":"debate"},{"key":"C","text":"confident"},{"key":"D","text":"volunteer"}],"answer":"C","explanation":"confident 的意思是自信的。","verify":"\"confident\""},{"id":"cne_h011_q1","topicId":"cne_h011","difficulty":"basic","type":"choice","prompt":"The tall boy in blue 是什么短语？","choices":[{"key":"A","text":"名词短语"},{"key":"B","text":"动词短语"},{"key":"C","text":"介词单独成句"},{"key":"D","text":"副词短语"}],"answer":"A","explanation":"中心词 boy 是名词，前面有限定和形容词。","verify":"\"名词短语\""},{"id":"cne_h011_q2","topicId":"cne_h011","difficulty":"basic","type":"choice","prompt":"My new schoolbag 在句中常作什么？","choices":[{"key":"A","text":"谓语"},{"key":"B","text":"主语或宾语"},{"key":"C","text":"系动词"},{"key":"D","text":"助动词"}],"answer":"B","explanation":"名词短语可以作主语或宾语，不能单独作谓语。","verify":"\"主语或宾语\""},{"id":"cne_h011_q3","topicId":"cne_h011","difficulty":"standard","type":"choice","prompt":"哪一个是名词短语？","choices":[{"key":"A","text":"runs quickly"},{"key":"B","text":"very carefully"},{"key":"C","text":"a difficult maths course"},{"key":"D","text":"looks happy"}],"answer":"C","explanation":"course 是名词中心词，前面有冠词和形容词。","verify":"\"a difficult maths course\""},{"id":"cne_h011_q4","topicId":"cne_h011","difficulty":"standard","type":"choice","prompt":"She joined the school debate team. 宾语是哪一个？","choices":[{"key":"A","text":"She"},{"key":"B","text":"joined"},{"key":"C","text":"school 这个单词单独"},{"key":"D","text":"the school debate team"}],"answer":"D","explanation":"the school debate team 是名词短语，作 joined 的宾语。","verify":"\"the school debate team\""},{"id":"cne_h012_q1","topicId":"cne_h012","difficulty":"basic","type":"choice","prompt":"The question is very difficult. very difficult 是什么？","choices":[{"key":"A","text":"名词短语作主语"},{"key":"B","text":"形容词短语作表语"},{"key":"C","text":"动词短语作谓语"},{"key":"D","text":"介词短语作宾语"}],"answer":"B","explanation":"difficult 是形容词，very 修饰它，放在系动词后面作表语。","verify":"\"形容词短语作表语\""},{"id":"cne_h012_q2","topicId":"cne_h012","difficulty":"basic","type":"choice","prompt":"He spoke quite clearly. quite clearly 是什么？","choices":[{"key":"A","text":"名词短语作宾语"},{"key":"B","text":"形容词短语作表语"},{"key":"C","text":"副词短语作状语"},{"key":"D","text":"双宾语"}],"answer":"C","explanation":"clearly 是副词，修饰 spoke，作状语。","verify":"\"副词短语作状语\""},{"id":"cne_h012_q3","topicId":"cne_h012","difficulty":"standard","type":"choice","prompt":"哪一个是形容词短语？","choices":[{"key":"A","text":"the maths course"},{"key":"B","text":"speak English"},{"key":"C","text":"in the morning"},{"key":"D","text":"good at maths"}],"answer":"D","explanation":"good 是形容词，at maths 补充说明它。","verify":"\"good at maths\""},{"id":"cne_h012_q4","topicId":"cne_h012","difficulty":"standard","type":"choice","prompt":"She is afraid of the quiz. afraid of the quiz 说明的是哪一个？","choices":[{"key":"A","text":"She"},{"key":"B","text":"is"},{"key":"C","text":"the 这个词"},{"key":"D","text":"句号"}],"answer":"A","explanation":"表语说明主语 She 的状态。","verify":"\"She\""},{"id":"cne_h013_q1","topicId":"cne_h013","difficulty":"basic","type":"choice","prompt":"想说自己最喜欢英语课，哪一句合适？","choices":[{"key":"A","text":"Your favourite course is English"},{"key":"B","text":"My favourite course are English"},{"key":"C","text":"My favourite course is English"},{"key":"D","text":"My favorites course is English"}],"answer":"C","explanation":"说最喜欢的课程用 My favourite course is。","verify":"\"My favourite course is English\""},{"id":"cne_h013_q2","topicId":"cne_h013","difficulty":"basic","type":"choice","prompt":"同学建议你参加辩论社，你愿意，应回答什么？","choices":[{"key":"A","text":"That sounds good. I will joined"},{"key":"B","text":"That sounds good. I will to join"},{"key":"C","text":"That sounds good. I will joins"},{"key":"D","text":"That sounds good. I will join"}],"answer":"D","explanation":"接受建议可以说 That sounds good。","verify":"\"That sounds good. I will join\""},{"id":"cne_h013_q3","topicId":"cne_h013","difficulty":"standard","type":"choice","prompt":"想问对方有没有加入社团，哪一句合适？","choices":[{"key":"A","text":"Have you joined a club"},{"key":"B","text":"Have you joined an club"},{"key":"C","text":"Have you join a club"},{"key":"D","text":"Have you joinned a club"}],"answer":"A","explanation":"询问对方用 Have you joined a club。","verify":"\"Have you joined a club\""},{"id":"cne_h013_q4","topicId":"cne_h013","difficulty":"standard","type":"choice","prompt":"想说明参加志愿者活动让自己更自信，哪一句合适？","choices":[{"key":"A","text":"Volunteering make me more confident"},{"key":"B","text":"Volunteering makes me more confident"},{"key":"C","text":"Vollunteering makes me more confident"},{"key":"D","text":"Volunteering makes I more confident"}],"answer":"B","explanation":"makes me more confident 说明活动带来的变化。","verify":"\"Volunteering makes me more confident\""},{"id":"cne_h014_q1","topicId":"cne_h014","difficulty":"basic","type":"choice","prompt":"Chen likes his English course, but the maths quiz is a challenge. He also joins the debate club. Chen 喜欢哪一门课？","choices":[{"key":"A","text":"数学"},{"key":"B","text":"历史"},{"key":"C","text":"音乐"},{"key":"D","text":"英语"}],"answer":"D","explanation":"短文写 likes his English course。","verify":"\"英语\""},{"id":"cne_h014_q2","topicId":"cne_h014","difficulty":"basic","type":"choice","prompt":"Chen likes his English course, but the maths quiz is a challenge. He also joins the debate club. 什么对他来说是挑战？","choices":[{"key":"A","text":"数学小测验"},{"key":"B","text":"英语课"},{"key":"C","text":"辩论社"},{"key":"D","text":"校园"}],"answer":"A","explanation":"短文写 the maths quiz is a challenge。","verify":"\"数学小测验\""},{"id":"cne_h014_q3","topicId":"cne_h014","difficulty":"standard","type":"choice","prompt":"Chen likes his English course, but the maths quiz is a challenge. He also joins the debate club. 他参加了什么社团？","choices":[{"key":"A","text":"音乐社"},{"key":"B","text":"辩论社"},{"key":"C","text":"篮球队"},{"key":"D","text":"科学社"}],"answer":"B","explanation":"短文写 the debate club。","verify":"\"辩论社\""},{"id":"cne_h014_q4","topicId":"cne_h014","difficulty":"standard","type":"choice","prompt":"Chen likes his English course, but the maths quiz is a challenge. He also joins the debate club. 哪一句和短文一致？","choices":[{"key":"A","text":"Chen hates English"},{"key":"B","text":"The English quiz is a challenge"},{"key":"C","text":"Chen joins the debate club"},{"key":"D","text":"Chen joins the music club"}],"answer":"C","explanation":"挑战的是数学小测验，不是英语课。","verify":"\"Chen joins the debate club\""},{"id":"cne_h015_q1","topicId":"cne_h015","difficulty":"basic","type":"choice","prompt":"要点：想加入辩论社、喜欢讨论、每周五有空。哪一句三个要点都有？","choices":[{"key":"A","text":"I want to join the debate club because I like discussion and I am free on Friday"},{"key":"B","text":"I want to join the debate club"},{"key":"C","text":"I am free on Friday"},{"key":"D","text":"I like music on Monday"}],"answer":"A","explanation":"三个要点要同时出现。","verify":"\"I want to join the debate club because I like discussion and I am free on Friday\""},{"id":"cne_h015_q2","topicId":"cne_h015","difficulty":"basic","type":"choice","prompt":"申请句要说明理由，哪一句有理由？","choices":[{"key":"A","text":"The club is a room"},{"key":"B","text":"I want to join because I like debate"},{"key":"C","text":"Friday is a day"},{"key":"D","text":"Please open the door"}],"answer":"B","explanation":"because 后面是加入的理由。","verify":"\"I want to join because I like debate\""},{"id":"cne_h015_q3","topicId":"cne_h015","difficulty":"standard","type":"choice","prompt":"哪一句适合作为申请的开头？","choices":[{"key":"A","text":"I would liked to join the debate club"},{"key":"B","text":"I would like to joining the debate club"},{"key":"C","text":"I would like to join the debate club"},{"key":"D","text":"I would like to joins the debate club"}],"answer":"C","explanation":"申请开头可以直接说 I would like to join。","verify":"\"I would like to join the debate club\""},{"id":"cne_h015_q4","topicId":"cne_h015","difficulty":"standard","type":"choice","prompt":"老师要求用现在时介绍自己的空闲时间，哪一句符合？","choices":[{"key":"A","text":"I was free in 1990 only"},{"key":"B","text":"I will was free"},{"key":"C","text":"I am free in Friday afternoon"},{"key":"D","text":"I am free on Friday afternoon"}],"answer":"D","explanation":"现在的空闲时间用 I am free。","verify":"\"I am free on Friday afternoon\""}]
