[{"id":"cng_j034_q1","topicId":"cng_j034","difficulty":"basic","type":"choice","prompt":"我国地势的基本特征是？","choices":[{"key":"A","text":"东高西低，呈一级斜坡"},{"key":"B","text":"南北高、中间低"},{"key":"C","text":"四周高、中间是海洋"},{"key":"D","text":"西高东低，呈三级阶梯"}],"answer":"D","explanation":"青藏高原为第一级阶梯，向东逐级降低。","verify":"\"西高东低，呈三级阶梯\""},{"id":"cng_j034_q2","topicId":"cng_j034","difficulty":"basic","type":"choice","prompt":"第一级阶梯和第二级阶梯的分界山脉包括？","choices":[{"key":"A","text":"昆仑山、祁连山、横断山脉"},{"key":"B","text":"大兴安岭、太行山、巫山、雪峰山"},{"key":"C","text":"长白山、武夷山"},{"key":"D","text":"喜马拉雅山南坡全部"}],"answer":"A","explanation":"昆仑—祁连—横断一线是一、二级阶梯分界。","verify":"\"昆仑山、祁连山、横断山脉\""},{"id":"cng_j034_q3","topicId":"cng_j034","difficulty":"standard","type":"choice","prompt":"我国面积最大的高原是？","choices":[{"key":"A","text":"黄土高原"},{"key":"B","text":"青藏高原"},{"key":"C","text":"云贵高原"},{"key":"D","text":"内蒙古高原"}],"answer":"B","explanation":"青藏高原有“世界屋脊”之称，面积最大、海拔最高。","verify":"\"青藏高原\""},{"id":"cng_j034_q4","topicId":"cng_j034","difficulty":"challenge","type":"choice","prompt":"西高东低的地势对河流的影响是？","choices":[{"key":"A","text":"所有河流都向西流入内陆"},{"key":"B","text":"没有落差，不能发电"},{"key":"C","text":"许多大河东流入海，水能资源丰富"},{"key":"D","text":"河流无法形成"}],"answer":"C","explanation":"地势使长江、黄河等东流入海，在阶梯交界处落差大、水能丰富。","verify":"\"许多大河东流入海，水能资源丰富\""},{"id":"cng_j035_q1","topicId":"cng_j035","difficulty":"basic","type":"choice","prompt":"我国气候的显著特征之一是？","choices":[{"key":"A","text":"季风气候显著"},{"key":"B","text":"全年受西风带控制"},{"key":"C","text":"没有季节变化"},{"key":"D","text":"全国都是热带雨林气候"}],"answer":"A","explanation":"冬夏季风交替，大多数地方雨热同期。","verify":"\"季风气候显著\""},{"id":"cng_j035_q2","topicId":"cng_j035","difficulty":"basic","type":"choice","prompt":"我国冬季南北温差很大，主要因为？","choices":[{"key":"A","text":"地势完全平坦"},{"key":"B","text":"纬度差异大，北方正午太阳高度小、白昼短"},{"key":"C","text":"没有冬季风"},{"key":"D","text":"南方一定没有阳光"}],"answer":"B","explanation":"冬季太阳直射南半球，北方正午太阳高度更低、白昼更短，又受冬季风影响。","verify":"\"纬度差异大，北方正午太阳高度小、白昼短\""},{"id":"cng_j035_q3","topicId":"cng_j035","difficulty":"standard","type":"choice","prompt":"夏季风从海洋吹向陆地，使我国东部？","choices":[{"key":"A","text":"全年滴雨没有"},{"key":"B","text":"只有冬季下雨"},{"key":"C","text":"降水较多，且集中在夏季"},{"key":"D","text":"降水与季风无关"}],"answer":"C","explanation":"夏季风带来水汽，形成雨季；冬季风来自内陆，降水少。","verify":"\"降水较多，且集中在夏季\""},{"id":"cng_j035_q4","topicId":"cng_j035","difficulty":"challenge","type":"choice","prompt":"西北内陆气候干旱，主要因为？","choices":[{"key":"A","text":"纬度一定比海南更低"},{"key":"B","text":"海拔一定低于海平面"},{"key":"C","text":"全年受台风控制"},{"key":"D","text":"距海远，湿润气流难以到达"}],"answer":"D","explanation":"海陆位置使水汽递减，加上山脉阻挡，降水稀少。","verify":"\"距海远，湿润气流难以到达\""},{"id":"cng_j036_q1","topicId":"cng_j036","difficulty":"basic","type":"choice","prompt":"我国最长的河流是？","choices":[{"key":"A","text":"黄河"},{"key":"B","text":"长江"},{"key":"C","text":"珠江"},{"key":"D","text":"塔里木河"}],"answer":"B","explanation":"长江全长约 6300 千米，是我国第一大河。","verify":"\"长江\""},{"id":"cng_j036_q2","topicId":"cng_j036","difficulty":"basic","type":"choice","prompt":"黄河中游流经黄土高原，突出的水文特征是？","choices":[{"key":"A","text":"流量比长江更大"},{"key":"B","text":"没有结冰期"},{"key":"C","text":"含沙量很大"},{"key":"D","text":"是淡水湖"}],"answer":"C","explanation":"黄土土质疏松，水土流失严重，使黄河成为含沙量最大的河流之一。","verify":"\"含沙量很大\""},{"id":"cng_j036_q3","topicId":"cng_j036","difficulty":"standard","type":"choice","prompt":"长江水能资源主要集中在？","choices":[{"key":"A","text":"入海口附近的三角洲"},{"key":"B","text":"下游平原的所有河段"},{"key":"C","text":"没有落差的河段"},{"key":"D","text":"上游河段"}],"answer":"D","explanation":"上游流经地势阶梯交界处，落差大、水流急。","verify":"\"上游河段\""},{"id":"cng_j036_q4","topicId":"cng_j036","difficulty":"challenge","type":"choice","prompt":"鄱阳湖、洞庭湖等属于？","choices":[{"key":"A","text":"外流区的淡水湖"},{"key":"B","text":"内流区的咸水湖"},{"key":"C","text":"海洋的一部分"},{"key":"D","text":"人工运河"}],"answer":"A","explanation":"它们位于东部外流区，湖水最终注入海洋，是淡水湖。","verify":"\"外流区的淡水湖\""}]
