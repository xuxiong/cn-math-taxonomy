[{"id":"cns_p138_q1","topicId":"cns_p138","difficulty":"basic","type":"choice","prompt":"放大镜的镜片有什么特点？","choices":[{"key":"A","text":"中间薄、边缘厚"},{"key":"B","text":"完全平的"},{"key":"C","text":"不透明"},{"key":"D","text":"中间厚、边缘薄、透明"}],"answer":"D","explanation":"放大镜是凸透镜。","verify":"\"中间厚、边缘薄、透明\""},{"id":"cns_p138_q2","topicId":"cns_p138","difficulty":"basic","type":"choice","prompt":"使用放大镜观察时，正确的方法是？","choices":[{"key":"A","text":"放大镜靠近眼睛，移动物体直到看清"},{"key":"B","text":"把放大镜放在离眼睛一米外"},{"key":"C","text":"对着太阳看"},{"key":"D","text":"闭眼看"}],"answer":"A","explanation":"调整物体与镜片的距离，直到图像清晰。","verify":"\"放大镜靠近眼睛，移动物体直到看清\""},{"id":"cns_p138_q3","topicId":"cns_p138","difficulty":"standard","type":"choice","prompt":"为什么绝对不能用放大镜看太阳？","choices":[{"key":"A","text":"会看不清"},{"key":"B","text":"会聚的强光会灼伤眼睛"},{"key":"C","text":"镜片会碎"},{"key":"D","text":"太阳会变小"}],"answer":"B","explanation":"凸透镜会聚阳光，非常危险。","verify":"\"会聚的强光会灼伤眼睛\""},{"id":"cns_p138_q4","topicId":"cns_p138","difficulty":"challenge","type":"choice","prompt":"下面哪样东西也能起到放大作用？","choices":[{"key":"A","text":"一块木板"},{"key":"B","text":"一张白纸"},{"key":"C","text":"装满水的圆形透明玻璃杯"},{"key":"D","text":"一面平面镜"}],"answer":"C","explanation":"装水的圆形杯子中间厚边缘薄，相当于凸透镜。","verify":"\"装满水的圆形透明玻璃杯\""},{"id":"cns_p139_q1","topicId":"cns_p139","difficulty":"basic","type":"choice","prompt":"凸透镜越凸，放大倍数怎样？","choices":[{"key":"A","text":"越大"},{"key":"B","text":"越小"},{"key":"C","text":"不变"},{"key":"D","text":"变成零"}],"answer":"A","explanation":"镜片越凸，放大作用越强。","verify":"\"越大\""},{"id":"cns_p139_q2","topicId":"cns_p139","difficulty":"basic","type":"choice","prompt":"把两个放大镜适当组合起来观察，会怎样？","choices":[{"key":"A","text":"变成缩小"},{"key":"B","text":"能放得更大"},{"key":"C","text":"什么都看不见"},{"key":"D","text":"和一个放大镜一样"}],"answer":"B","explanation":"两个凸透镜组合可以进一步放大，这是显微镜的原理。","verify":"\"能放得更大\""},{"id":"cns_p139_q3","topicId":"cns_p139","difficulty":"standard","type":"choice","prompt":"放大镜下看到的物体比实际大，物体本身变大了吗？","choices":[{"key":"A","text":"变大了"},{"key":"B","text":"变小了"},{"key":"C","text":"没有，只是看到的像变大了"},{"key":"D","text":"颜色变了"}],"answer":"C","explanation":"放大的是像，不是物体本身。","verify":"\"没有，只是看到的像变大了\""},{"id":"cns_p139_q4","topicId":"cns_p139","difficulty":"challenge","type":"choice","prompt":"用 10 倍放大镜看一只 2 毫米长的蚂蚁，看起来大约有多长？","choices":[{"key":"A","text":"约 2 毫米"},{"key":"B","text":"约 12 毫米"},{"key":"C","text":"约 200 毫米"},{"key":"D","text":"约 20 毫米"}],"answer":"D","explanation":"2 × 10 = 20 毫米。","verify":"\"约 20 毫米\""},{"id":"cns_p140_q1","topicId":"cns_p140","difficulty":"basic","type":"choice","prompt":"显微镜里，眼睛靠近观察的镜头叫什么？","choices":[{"key":"A","text":"物镜"},{"key":"B","text":"目镜"},{"key":"C","text":"反光镜"},{"key":"D","text":"载物台"}],"answer":"B","explanation":"目镜靠近眼睛，物镜靠近标本。","verify":"\"目镜\""},{"id":"cns_p140_q2","topicId":"cns_p140","difficulty":"basic","type":"choice","prompt":"目镜是 10 倍、物镜是 10 倍，显微镜总共放大多少倍？","choices":[{"key":"A","text":"20 倍"},{"key":"B","text":"10 倍"},{"key":"C","text":"100 倍"},{"key":"D","text":"1000 倍"}],"answer":"C","explanation":"放大倍数＝目镜倍数 × 物镜倍数。","verify":"\"100 倍\""},{"id":"cns_p140_q3","topicId":"cns_p140","difficulty":"standard","type":"choice","prompt":"显微镜中放标本的地方叫什么？","choices":[{"key":"A","text":"镜筒"},{"key":"B","text":"镜臂"},{"key":"C","text":"目镜"},{"key":"D","text":"载物台"}],"answer":"D","explanation":"玻片放在载物台上。","verify":"\"载物台\""},{"id":"cns_p140_q4","topicId":"cns_p140","difficulty":"challenge","type":"choice","prompt":"如图，显微镜视野里的物像在左下方，要把它移到中央，玻片应向哪个方向移动？","choices":[{"key":"A","text":"左下方"},{"key":"B","text":"右上方"},{"key":"C","text":"左上方"},{"key":"D","text":"右下方"}],"answer":"A","explanation":"显微镜成倒像，物像在哪就往哪边移玻片。","verify":"\"左下方\"","figure":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 340 210\"><g transform=\"translate(60,0)\"><circle cx=\"110\" cy=\"100\" r=\"80\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><path d=\"M55 140 Q65 120 85 130 Q95 150 70 155 Q52 152 55 140 Z\" fill=\"currentColor\" fill-opacity=\"0.45\" stroke=\"none\"/><text x=\"110\" y=\"200\" fill=\"currentColor\" font-family=\"Noto Sans CJK SC, Noto Sans SC, sans-serif\" font-weight=\"650\" font-size=\"13\" text-anchor=\"middle\">显微镜视野</text></g></svg>"},{"id":"cns_p141_q1","topicId":"cns_p141","difficulty":"basic","type":"choice","prompt":"生物体基本的结构单位是什么？","choices":[{"key":"A","text":"原子"},{"key":"B","text":"叶子"},{"key":"C","text":"细胞"},{"key":"D","text":"骨骼"}],"answer":"C","explanation":"除病毒外，生物都由细胞构成。","verify":"\"细胞\""},{"id":"cns_p141_q2","topicId":"cns_p141","difficulty":"basic","type":"choice","prompt":"观察洋葱表皮细胞时，常滴加什么让细胞更清楚？","choices":[{"key":"A","text":"盐水"},{"key":"B","text":"糖水"},{"key":"C","text":"墨水"},{"key":"D","text":"碘液"}],"answer":"D","explanation":"碘液能把细胞核染色。","verify":"\"碘液\""},{"id":"cns_p141_q3","topicId":"cns_p141","difficulty":"standard","type":"choice","prompt":"洋葱表皮细胞看起来像什么？","choices":[{"key":"A","text":"一个个排列整齐的小格子"},{"key":"B","text":"一团圆圆的棉花"},{"key":"C","text":"一根长长的线"},{"key":"D","text":"透明的水泡乱糟糟"}],"answer":"A","explanation":"植物细胞有细胞壁，形状较规则。","verify":"\"一个个排列整齐的小格子\""},{"id":"cns_p141_q4","topicId":"cns_p141","difficulty":"challenge","type":"choice","prompt":"最早用自制显微镜观察到软木中「细胞」的科学家是谁？","choices":[{"key":"A","text":"牛顿"},{"key":"B","text":"胡克"},{"key":"C","text":"爱迪生"},{"key":"D","text":"达尔文"}],"answer":"B","explanation":"1665 年英国科学家胡克提出「细胞」一词。","verify":"\"胡克\""},{"id":"cns_p142_q1","topicId":"cns_p142","difficulty":"basic","type":"choice","prompt":"池塘水里用显微镜能看到下面哪种生物？","choices":[{"key":"A","text":"金鱼"},{"key":"B","text":"青蛙"},{"key":"C","text":"荷叶"},{"key":"D","text":"草履虫"}],"answer":"D","explanation":"草履虫只有一个细胞，肉眼几乎看不见。","verify":"\"草履虫\""},{"id":"cns_p142_q2","topicId":"cns_p142","difficulty":"basic","type":"choice","prompt":"草履虫由多少个细胞组成？","choices":[{"key":"A","text":"一个"},{"key":"B","text":"两个"},{"key":"C","text":"成千上万个"},{"key":"D","text":"没有细胞"}],"answer":"A","explanation":"草履虫是单细胞生物。","verify":"\"一个\""},{"id":"cns_p142_q3","topicId":"cns_p142","difficulty":"standard","type":"choice","prompt":"取池塘水观察时，应从哪里取水样更容易找到微小生物？","choices":[{"key":"A","text":"水最深处的清水"},{"key":"B","text":"靠近水草的水面附近"},{"key":"C","text":"自来水管里"},{"key":"D","text":"刚烧开的水"}],"answer":"B","explanation":"水草附近微小生物多。","verify":"\"靠近水草的水面附近\""},{"id":"cns_p142_q4","topicId":"cns_p142","difficulty":"challenge","type":"choice","prompt":"观察草履虫时，在载玻片上放几丝棉纤维，目的是？","choices":[{"key":"A","text":"给它吃"},{"key":"B","text":"让水变干净"},{"key":"C","text":"限制它游动，便于观察"},{"key":"D","text":"让视野更亮"}],"answer":"C","explanation":"草履虫游得快，棉丝能减慢它的运动。","verify":"\"限制它游动，便于观察\""},{"id":"cns_p143_q1","topicId":"cns_p143","difficulty":"basic","type":"choice","prompt":"做面包、蒸馒头要用到哪种微生物？","choices":[{"key":"A","text":"酵母菌"},{"key":"B","text":"病毒"},{"key":"C","text":"蚯蚓"},{"key":"D","text":"草履虫"}],"answer":"A","explanation":"酵母菌使面团发起来。","verify":"\"酵母菌\""},{"id":"cns_p143_q2","topicId":"cns_p143","difficulty":"basic","type":"choice","prompt":"制作酸奶用到的微生物是什么？","choices":[{"key":"A","text":"酵母菌"},{"key":"B","text":"乳酸菌"},{"key":"C","text":"霉菌"},{"key":"D","text":"病毒"}],"answer":"B","explanation":"乳酸菌把牛奶变成酸奶。","verify":"\"乳酸菌\""},{"id":"cns_p143_q3","topicId":"cns_p143","difficulty":"standard","type":"choice","prompt":"面包放久了长出的「毛」是什么？","choices":[{"key":"A","text":"面粉"},{"key":"B","text":"细胞壁"},{"key":"C","text":"霉菌"},{"key":"D","text":"盐"}],"answer":"C","explanation":"霉菌在潮湿温暖处容易繁殖。","verify":"\"霉菌\""},{"id":"cns_p143_q4","topicId":"cns_p143","difficulty":"challenge","type":"choice","prompt":"饭前便后要洗手，主要是为了什么？","choices":[{"key":"A","text":"让手变白"},{"key":"B","text":"让手变香"},{"key":"C","text":"没有原因"},{"key":"D","text":"减少有害病菌进入身体"}],"answer":"D","explanation":"洗手能除去大部分病菌。","verify":"\"减少有害病菌进入身体\""}]
