[{"id":"cnm_235_q1","topicId":"cnm_235","difficulty":"basic","type":"numeric","prompt":"求 y=-x²+4x+1 的最大值。","answer":"5","explanation":"配方得 y=-(x-2)²+5，开口向下，x=2 时取最大值 5。","verify":"Fraction(4*(-1)*1-4**2,4*(-1))"},{"id":"cnm_235_q2","topicId":"cnm_235","difficulty":"basic","type":"numeric","prompt":"求 y=2(x+1)²-4 的最小值。","answer":"-4","explanation":"a=2>0，开口向上，顶点 (-1,-4) 是最低点，最小值为 -4。"},{"id":"cnm_235_q3","topicId":"cnm_235","difficulty":"standard","type":"numeric","prompt":"求 y=x²-6x+10 的最小值。","answer":"1","explanation":"配方得 y=(x-3)²+1，开口向上，x=3 时取最小值 1。","verify":"Fraction(4*1*10-(-6)**2,4*1)"},{"id":"cnm_235_q4","topicId":"cnm_235","difficulty":"advanced","type":"numeric","prompt":"当 2≤x≤4 时，求 y=x²-2x-3 的最大值和最小值。（依次作答，先最大值后最小值，用逗号隔开）","answer":"5，-3","explanation":"对称轴 x=1 不在区间内，区间在对称轴右侧，y 随 x 增大而增大。x=4 时最大值 16-8-3=5，x=2 时最小值 4-4-3=-3。","verify":"[max([x*x-2*x-3 for x in range(2,5)]), min([x*x-2*x-3 for x in range(2,5)])]"},{"id":"cnm_236_q1","topicId":"cnm_236","difficulty":"standard","type":"numeric","prompt":"进价 20 元，售价 x 元时日销量为 100-2x 件，求日利润的最大值。（单位：元）","answer":"450","explanation":"日利润 y=(x-20)(100-2x)=-2x²+140x-2000=-2(x-35)²+450，x=35 时最大利润为 450 元。","verify":"max([(x-20)*(100-2*x) for x in range(20,51)])"},{"id":"cnm_236_q2","topicId":"cnm_236","difficulty":"basic","type":"numeric","prompt":"一个球从地面被抛出，t 秒时的高度 h=-5t²+20t（单位：m），球能达到的最大高度是多少 m？","answer":"20","explanation":"h=-5(t-2)²+20，t=2 时最大，最大高度 20 m。","verify":"max([-5*t*t+20*t for t in range(0,5)])"},{"id":"cnm_236_q3","topicId":"cnm_236","difficulty":"standard","type":"numeric","prompt":"用 30 m 长的篱笆，一面靠墙（墙足够长）围成矩形菜园，设垂直于墙的边长为 x m，求菜园面积的最大值。（单位：m²，可写成小数）","answer":"112.5","explanation":"平行于墙的边为 30-2x，面积 S=x(30-2x)=-2(x-7.5)²+112.5，x=7.5 在允许范围 0<x<15 内，最大面积 112.5。","verify":"max([Fraction(k,2)*(30-k) for k in range(0,31)])"},{"id":"cnm_236_q4","topicId":"cnm_236","difficulty":"advanced","type":"numeric","prompt":"某商品进价 30 元/件，售价 x 元（30≤x≤50），日销量为 160-2x 件，求日利润的最大值。（单位：元）","answer":"1200","explanation":"w=(x-30)(160-2x)=-2(x-55)²+1250，顶点 x=55 不在 30≤x≤50 内。区间内 w 随 x 增大而增大，x=50 时最大，w=20×60=1200。","verify":"max([(x-30)*(160-2*x) for x in range(30,51)])"},{"id":"cnm_236_q5","topicId":"cnm_236","difficulty":"standard","type":"numeric","prompt":"抛物线型拱桥，以拱顶为原点建立坐标系，拱桥所在抛物线为 y=-x²/8（单位：m）。当水面在拱顶下方 8 m 时，水面宽多少 m？","answer":"16","explanation":"令 y=-8，-x²/8=-8，x²=64，x=±8，水面宽 8-(-8)=16 m。","verify":"2*isqrt(8*8)"}]
