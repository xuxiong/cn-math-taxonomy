[{"id":"cnm_h142_q1","topicId":"cnm_h142","difficulty":"basic","type":"numeric","prompt":"做了 200 次试验，事件出现 40 次。频率是多少？","answer":"1/5","explanation":"40/200=1/5。","verify":"Fraction(40,200)"},{"id":"cnm_h142_q2","topicId":"cnm_h142","difficulty":"basic","type":"numeric","prompt":"又做了 100 次，出现 20 次。这一批的频率是多少？","answer":"1/5","explanation":"20/100=1/5。","verify":"Fraction(20,100)"},{"id":"cnm_h142_q3","topicId":"cnm_h142","difficulty":"standard","type":"choice","prompt":"频率稳定在 1/5 附近，说明？","choices":[{"key":"A","text":"概率已经变成频率的下一个值"},{"key":"B","text":"可以把概率估计为 1/5"},{"key":"C","text":"下一次一定发生"},{"key":"D","text":"试验可以停止且结果不再变化"}],"answer":"B","explanation":"频率是估计。下一次仍是随机的。","verify":"\"可以把概率估计为 1/5\""},{"id":"cnm_h142_q4","topicId":"cnm_h142","difficulty":"standard","type":"choice","prompt":"频率和概率的差别是？","choices":[{"key":"A","text":"两者永远相等"},{"key":"B","text":"频率可以大于 1"},{"key":"C","text":"频率来自已做的试验，概率是事件本身的规律"},{"key":"D","text":"概率会随试验次数改变"}],"answer":"C","explanation":"概率是确定的模型值，频率会波动并逐渐稳定。","verify":"\"频率来自已做的试验，概率是事件本身的规律\""},{"id":"cnm_h143_q1","topicId":"cnm_h143","difficulty":"basic","type":"numeric","prompt":"1000 次试验中事件出现 320 次。用频率估计的概率是多少？","answer":"8/25","explanation":"320/1000=8/25。","verify":"Fraction(320,1000)"},{"id":"cnm_h143_q2","topicId":"cnm_h143","difficulty":"basic","type":"numeric","prompt":"另一次只做了 10 次，出现 8 次。这 10 次的频率是多少？","answer":"4/5","explanation":"8/10=4/5。次数少，波动会更大。","verify":"Fraction(8,10)"},{"id":"cnm_h143_q3","topicId":"cnm_h143","difficulty":"standard","type":"choice","prompt":"同样的试验，哪一次估计通常更可信？","choices":[{"key":"A","text":"频率更大的那一次"},{"key":"B","text":"次数更少的那一次"},{"key":"C","text":"试验次数更多的那一次"},{"key":"D","text":"最先做的那一次"}],"answer":"C","explanation":"次数越多，频率越稳定。","verify":"\"试验次数更多的那一次\""},{"id":"cnm_h143_q4","topicId":"cnm_h143","difficulty":"standard","type":"numeric","prompt":"若估计的概率是 1/4，在 40 次试验中大约期望出现多少次？","answer":"10","explanation":"期望次数是 40×1/4=10。实际次数仍会有波动。","verify":"40*Fraction(1,4)"}]
