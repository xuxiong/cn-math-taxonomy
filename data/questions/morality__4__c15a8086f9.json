[{"id":"cnd_p093_q1","topicId":"cnd_p093","difficulty":"basic","type":"choice","prompt":"保持身心健康，应当？","choices":[{"key":"A","text":"长期熬夜"},{"key":"B","text":"从不运动"},{"key":"C","text":"适度运动、充足睡眠、心态积极"},{"key":"D","text":"遇到挫折就放弃一切"}],"answer":"C","explanation":"健康需要多方面维护。","verify":"\"适度运动、充足睡眠、心态积极\""},{"id":"cnd_p093_q2","topicId":"cnd_p093","difficulty":"basic","type":"choice","prompt":"遇到失败时，较好做法是？","choices":[{"key":"A","text":"立刻放弃并责怪所有人"},{"key":"B","text":"欺骗自己说已经成功"},{"key":"C","text":"打击同样失败的同学"},{"key":"D","text":"调整情绪，总结原因再试"}],"answer":"D","explanation":"失败是成长的一部分。","verify":"\"调整情绪，总结原因再试\""},{"id":"cnd_p093_q3","topicId":"cnd_p093","difficulty":"standard","type":"choice","prompt":"坚持才会有收获，意思是？","choices":[{"key":"A","text":"做事情要持之以恒"},{"key":"B","text":"坚持错误不改正"},{"key":"C","text":"只坚持玩不坚持学"},{"key":"D","text":"一天努力就够了"}],"answer":"A","explanation":"持之以恒才能有收获。","verify":"\"做事情要持之以恒\""},{"id":"cnd_p093_q4","topicId":"cnd_p093","difficulty":"challenge","type":"choice","prompt":"有梦想时，现在可以怎么做？","choices":[{"key":"A","text":"只幻想不行动"},{"key":"B","text":"从身边小事做起，一步一步努力"},{"key":"C","text":"嘲笑别人的梦想"},{"key":"D","text":"把梦想藏着永不行动"}],"answer":"B","explanation":"梦想要从现在做起。","verify":"\"从身边小事做起，一步一步努力\""},{"id":"cnd_p094_q1","topicId":"cnd_p094","difficulty":"basic","type":"choice","prompt":"生命为什么最宝贵？","choices":[{"key":"A","text":"生命可以随便浪费"},{"key":"B","text":"别人的生命不重要"},{"key":"C","text":"只有成绩比生命重要"},{"key":"D","text":"生命只有一次，是做好一切事情的前提"}],"answer":"D","explanation":"要珍爱生命。","verify":"\"生命只有一次，是做好一切事情的前提\""},{"id":"cnd_p094_q2","topicId":"cnd_p094","difficulty":"basic","type":"choice","prompt":"有人诱骗你去偏僻处，应？","choices":[{"key":"A","text":"拒绝，尽快离开并告诉信任的大人"},{"key":"B","text":"跟着去看看"},{"key":"C","text":"把家庭情况详细告诉对方"},{"key":"D","text":"独自赴约不告知家人"}],"answer":"A","explanation":"自我保护，远离危险。","verify":"\"拒绝，尽快离开并告诉信任的大人\""},{"id":"cnd_p094_q3","topicId":"cnd_p094","difficulty":"standard","type":"choice","prompt":"发生火灾初起且可逃生时，应？","choices":[{"key":"A","text":"坐电梯下楼"},{"key":"B","text":"用湿毛巾捂口鼻，低姿迅速撤离并报警"},{"key":"C","text":"躲进柜子不出来也不呼救"},{"key":"D","text":"返回火场拿玩具"}],"answer":"B","explanation":"火场逃生有正确方法。","verify":"\"用湿毛巾捂口鼻，低姿迅速撤离并报警\""},{"id":"cnd_p094_q4","topicId":"cnd_p094","difficulty":"challenge","type":"choice","prompt":"网络安全方面，不应做的是？","choices":[{"key":"A","text":"不随意添加陌生好友"},{"key":"B","text":"上网时间适度"},{"key":"C","text":"把家庭住址、密码发给网友"},{"key":"D","text":"遇到欺凌告知家长老师"}],"answer":"C","explanation":"保护个人信息不随意泄露。","verify":"\"把家庭住址、密码发给网友\""},{"id":"cnd_p095_q1","topicId":"cnd_p095","difficulty":"basic","type":"choice","prompt":"生命为什么最宝贵？","choices":[{"key":"A","text":"生命只有一次，是做好一切事情的前提"},{"key":"B","text":"生命可以随便浪费"},{"key":"C","text":"别人的生命不重要"},{"key":"D","text":"只有成绩比生命重要"}],"answer":"A","explanation":"要珍爱生命。","verify":"\"生命只有一次，是做好一切事情的前提\""},{"id":"cnd_p095_q2","topicId":"cnd_p095","difficulty":"basic","type":"choice","prompt":"有人诱骗你去偏僻处，应？","choices":[{"key":"A","text":"跟着去看看"},{"key":"B","text":"拒绝，尽快离开并告诉信任的大人"},{"key":"C","text":"把家庭情况详细告诉对方"},{"key":"D","text":"独自赴约不告知家人"}],"answer":"B","explanation":"自我保护，远离危险。","verify":"\"拒绝，尽快离开并告诉信任的大人\""},{"id":"cnd_p095_q3","topicId":"cnd_p095","difficulty":"standard","type":"choice","prompt":"发生火灾初起且可逃生时，应？","choices":[{"key":"A","text":"坐电梯下楼"},{"key":"B","text":"躲进柜子不出来也不呼救"},{"key":"C","text":"用湿毛巾捂口鼻，低姿迅速撤离并报警"},{"key":"D","text":"返回火场拿玩具"}],"answer":"C","explanation":"火场逃生有正确方法。","verify":"\"用湿毛巾捂口鼻，低姿迅速撤离并报警\""},{"id":"cnd_p095_q4","topicId":"cnd_p095","difficulty":"challenge","type":"choice","prompt":"网络安全方面，不应做的是？","choices":[{"key":"A","text":"不随意添加陌生好友"},{"key":"B","text":"上网时间适度"},{"key":"C","text":"遇到欺凌告知家长老师"},{"key":"D","text":"把家庭住址、密码发给网友"}],"answer":"D","explanation":"保护个人信息不随意泄露。","verify":"\"把家庭住址、密码发给网友\""}]
