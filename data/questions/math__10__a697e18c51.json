[{"id":"cnm_h012_q1","topicId":"cnm_h012","difficulty":"basic","type":"choice","prompt":"对实数 x，「x>2」是「x>0」的什么条件？","choices":[{"key":"A","text":"必要不充分条件"},{"key":"B","text":"充分不必要条件"},{"key":"C","text":"充要条件"},{"key":"D","text":"既不充分也不必要"}],"answer":"B","explanation":"x>2 一定能推出 x>0，所以充分；x>0 不能推出 x>2，所以不必要。","verify":"\"充分不必要条件\""},{"id":"cnm_h012_q2","topicId":"cnm_h012","difficulty":"basic","type":"choice","prompt":"对实数 x，「x>0」是「x>2」的什么条件？","choices":[{"key":"A","text":"充分不必要条件"},{"key":"B","text":"充要条件"},{"key":"C","text":"必要不充分条件"},{"key":"D","text":"既不充分也不必要"}],"answer":"C","explanation":"x>2 必须先有 x>0，所以必要；只知道 x>0 推不出 x>2，所以不充分。","verify":"\"必要不充分条件\""},{"id":"cnm_h012_q3","topicId":"cnm_h012","difficulty":"standard","type":"numeric","prompt":"集合 A={1，2}，B={1，2，3}。若「x∈A」可以推出「x∈B」，这种推出关系记为 1；不能记为 0。这里应记为多少？","answer":"1","explanation":"A 是 B 的子集，x 属于 A 就一定属于 B，推得出，记 1。","verify":"1"},{"id":"cnm_h012_q4","topicId":"cnm_h012","difficulty":"standard","type":"choice","prompt":"「x=1」是「x²=1」的什么条件？","choices":[{"key":"A","text":"充分不必要条件"},{"key":"B","text":"必要不充分条件"},{"key":"C","text":"充要条件"},{"key":"D","text":"既不充分也不必要"}],"answer":"A","explanation":"x=1 能推出 x²=1；但 x²=1 时 x 还可能是 −1，所以不是必要。","verify":"\"充分不必要条件\""},{"id":"cnm_h013_q1","topicId":"cnm_h013","difficulty":"basic","type":"choice","prompt":"对实数 x，「x²=4」是「x=2 或 x=−2」的什么条件？","choices":[{"key":"A","text":"充分不必要条件"},{"key":"B","text":"必要不充分条件"},{"key":"C","text":"充要条件"},{"key":"D","text":"既不充分也不必要"}],"answer":"C","explanation":"两边互相推出：平方等于 4 正好就是这两个实数。","verify":"\"充要条件\""},{"id":"cnm_h013_q2","topicId":"cnm_h013","difficulty":"basic","type":"choice","prompt":"「三角形两边相等」是「三角形有两个角相等」的什么条件？","choices":[{"key":"A","text":"充分不必要条件"},{"key":"B","text":"必要不充分条件"},{"key":"C","text":"既不充分也不必要"},{"key":"D","text":"充要条件"}],"answer":"D","explanation":"等腰对等角，等角对等边，两边互相推出。","verify":"\"充要条件\""},{"id":"cnm_h013_q3","topicId":"cnm_h013","difficulty":"standard","type":"numeric","prompt":"若 p 是 q 的充要条件，则「p 推出 q」记 1、「q 推出 p」也记 1。两件都成立时，把两个数相加得多少？","answer":"2","explanation":"充要表示两个方向都能推出，1+1=2。","verify":"1+1"},{"id":"cnm_h013_q4","topicId":"cnm_h013","difficulty":"standard","type":"choice","prompt":"「x>1」是「x≥1」的什么条件？","choices":[{"key":"A","text":"充要条件"},{"key":"B","text":"充分不必要条件"},{"key":"C","text":"必要不充分条件"},{"key":"D","text":"既不充分也不必要"}],"answer":"B","explanation":"x>1 能推出 x≥1；x≥1 还包括 x=1，推不出 x>1。","verify":"\"充分不必要条件\""}]
