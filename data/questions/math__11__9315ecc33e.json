[{"id":"cnm_h108_q1","topicId":"cnm_h108","difficulty":"basic","type":"numeric","prompt":"水平放置的图形中，平行于横轴的线段长 6。直观图上这条线段画成多长？","answer":"6","explanation":"平行于横轴的线段长度不变。","verify":"6"},{"id":"cnm_h108_q2","topicId":"cnm_h108","difficulty":"basic","type":"numeric","prompt":"平行于纵轴的线段长 8。按斜二测，直观图上画成多长？","answer":"4","explanation":"平行于纵轴的线段长度画成原来的一半，是 4。","verify":"8/2"},{"id":"cnm_h108_q3","topicId":"cnm_h108","difficulty":"standard","type":"numeric","prompt":"原图形里平行于纵轴的线段在直观图上长 3。它原来的长度是多少？","answer":"6","explanation":"画出来是一半，原来是 6。","verify":"3*2"},{"id":"cnm_h108_q4","topicId":"cnm_h108","difficulty":"standard","type":"choice","prompt":"斜二测画法中，横轴与纵轴的夹角通常画成？","choices":[{"key":"A","text":"45° 或 135°"},{"key":"B","text":"必须是 90°"},{"key":"C","text":"必须是 30°"},{"key":"D","text":"可以是 0°"}],"answer":"A","explanation":"直观图里原来垂直的两条轴不再画成直角，常用 45°。","verify":"\"45° 或 135°\""},{"id":"cnm_h109_q1","topicId":"cnm_h109","difficulty":"basic","type":"numeric","prompt":"正方形边长为 4，放在水平面上，一条边平行于横轴。这条边在直观图上的长度是多少？","answer":"4","explanation":"平行于横轴，长度仍是 4。","verify":"4"},{"id":"cnm_h109_q2","topicId":"cnm_h109","difficulty":"basic","type":"numeric","prompt":"这个正方形中垂直于它的另一条边，在直观图上的长度是多少？","answer":"2","explanation":"平行于纵轴的边画成一半，是 2。","verify":"4/2"},{"id":"cnm_h109_q3","topicId":"cnm_h109","difficulty":"standard","type":"choice","prompt":"原来互相平行的线段，在斜二测直观图中？","choices":[{"key":"A","text":"仍然平行"},{"key":"B","text":"变成垂直"},{"key":"C","text":"一定等长"},{"key":"D","text":"不能再画"}],"answer":"A","explanation":"斜二测保持平行关系，但纵方向的长度减半。","verify":"\"仍然平行\""},{"id":"cnm_h109_q4","topicId":"cnm_h109","difficulty":"standard","type":"numeric","prompt":"直观图上两条都平行于横轴的线段，原来长 5 和 5。它们在直观图上的长度之和是多少？","answer":"10","explanation":"两条长度都不变，和是 10。","verify":"5+5"}]
