[{"difficulty":"basic","type":"choice","prompt":"公顷和平方千米是什么单位？","choices":[{"key":"A","text":"面积单位"},{"key":"B","text":"质量单位"},{"key":"C","text":"时间单位"}],"answer":"A","explanation":"公顷、平方千米和平方米一样，都是面积单位。","verify":"'面积单位'","id":"cnm_p098_q1","topicId":"cnm_p098"},{"difficulty":"basic","type":"numeric","prompt":"1 公顷等于多少平方米？","answer":"10000","explanation":"1 公顷＝10000 平方米。","verify":"10000","id":"cnm_p098_q2","topicId":"cnm_p098"},{"difficulty":"standard","type":"numeric","prompt":"1 平方千米等于 100 公顷。3 平方千米是多少公顷？","answer":"300","explanation":"3×100＝300（公顷）。","verify":"3*100","id":"cnm_p098_q3","topicId":"cnm_p098"},{"difficulty":"challenge","type":"numeric","prompt":"一块地 2 公顷，另一块地 5000 平方米。两块地一共多少平方米？","answer":"25000","explanation":"2 公顷＝20000 平方米，20000＋5000＝25000（平方米）。","verify":"2*10000+5000","id":"cnm_p098_q4","topicId":"cnm_p098"},{"difficulty":"basic","type":"numeric","prompt":"底 7 厘米、高 4 厘米的平行四边形，面积是多少平方厘米？","answer":"28","explanation":"平行四边形面积＝底×高＝7×4＝28。","verify":"7*4","id":"cnm_p147_q1","topicId":"cnm_p147"},{"difficulty":"basic","type":"numeric","prompt":"底 9 厘米、高 5 厘米的平行四边形，面积是多少平方厘米？","answer":"45","explanation":"9×5＝45（平方厘米）。","verify":"9*5","id":"cnm_p147_q2","topicId":"cnm_p147"},{"difficulty":"standard","type":"numeric","prompt":"一块平行四边形草地底 12 米、高 6 米。面积是多少平方米？","answer":"72","explanation":"12×6＝72（平方米）。","verify":"12*6","id":"cnm_p147_q3","topicId":"cnm_p147"},{"difficulty":"challenge","type":"numeric","prompt":"一个平行四边形底 10 厘米、高 4 厘米，另一个底 8 厘米、高 6 厘米。第二个比第一个大多少平方厘米？","answer":"8","explanation":"第一个 10×4＝40，第二个 8×6＝48，48－40＝8。","verify":"8*6-10*4","id":"cnm_p147_q4","topicId":"cnm_p147"},{"difficulty":"basic","type":"numeric","prompt":"底 8 厘米、高 5 厘米的三角形，面积是多少平方厘米？","answer":"20","explanation":"三角形面积＝底×高÷2＝8×5÷2＝20。","verify":"8*5/2","id":"cnm_p148_q1","topicId":"cnm_p148"},{"difficulty":"basic","type":"numeric","prompt":"底 6 厘米、高 4 厘米的三角形，面积是多少平方厘米？","answer":"12","explanation":"6×4÷2＝12（平方厘米）。","verify":"6*4/2","id":"cnm_p148_q2","topicId":"cnm_p148"},{"difficulty":"standard","type":"numeric","prompt":"一块三角形布料底 10 厘米、高 6 厘米。面积是多少平方厘米？","answer":"30","explanation":"10×6÷2＝30（平方厘米）。","verify":"10*6/2","id":"cnm_p148_q3","topicId":"cnm_p148"},{"difficulty":"challenge","type":"numeric","prompt":"一个平行四边形底 12 厘米、高 8 厘米，沿对角线分成两个完全一样的三角形。其中一个三角形的面积是多少平方厘米？","answer":"48","explanation":"平行四边形面积 12×8＝96，每个三角形是它的一半：96÷2＝48。","verify":"12*8/2","id":"cnm_p148_q4","topicId":"cnm_p148"},{"difficulty":"basic","type":"numeric","prompt":"上底 2 厘米、下底 6 厘米、高 4 厘米的梯形，面积是多少平方厘米？","answer":"16","explanation":"（2＋6）×4÷2＝16（平方厘米）。","verify":"(2+6)*4/2","id":"cnm_p149_q1","topicId":"cnm_p149"},{"difficulty":"basic","type":"numeric","prompt":"上底 3 厘米、下底 7 厘米、高 4 厘米的梯形，面积是多少平方厘米？","answer":"20","explanation":"（3＋7）×4÷2＝20（平方厘米）。","verify":"(3+7)*4/2","id":"cnm_p149_q2","topicId":"cnm_p149"},{"difficulty":"standard","type":"numeric","prompt":"一块梯形田上底 4 米、下底 8 米、高 5 米。面积是多少平方米？","answer":"30","explanation":"（4＋8）×5÷2＝30（平方米）。","verify":"(4+8)*5/2","id":"cnm_p149_q3","topicId":"cnm_p149"},{"difficulty":"challenge","type":"numeric","prompt":"梯形上底 5 厘米、下底 9 厘米，面积是 28 平方厘米。高是多少厘米？","answer":"4","explanation":"（上底＋下底）×高÷2＝28，所以 14×高÷2＝28，高＝4 厘米。","verify":"28*2/(5+9)","id":"cnm_p149_q4","topicId":"cnm_p149"},{"difficulty":"basic","type":"numeric","prompt":"一个组合图形分成两个长方形，面积分别是 12 平方厘米和 8 平方厘米。这个组合图形的面积是多少平方厘米？","answer":"20","explanation":"两部分相加：12＋8＝20（平方厘米）。","verify":"12+8","id":"cnm_p150_q1","topicId":"cnm_p150"},{"difficulty":"basic","type":"numeric","prompt":"在面积 30 平方厘米的长方形纸上剪掉一个 6 平方厘米的小正方形。剩下多少平方厘米？","answer":"24","explanation":"从总面积里减去剪掉的：30－6＝24。","verify":"30-6","id":"cnm_p150_q2","topicId":"cnm_p150"},{"difficulty":"standard","type":"numeric","prompt":"一个长方形面积 24 平方厘米，旁边拼上一个面积 10 平方厘米的三角形。一共多少平方厘米？","answer":"34","explanation":"24＋10＝34（平方厘米）。","verify":"24+10","id":"cnm_p150_q3","topicId":"cnm_p150"},{"difficulty":"challenge","type":"numeric","prompt":"一个长 10 厘米、宽 6 厘米的长方形，从一个角剪掉边长 2 厘米的正方形。剩下的面积是多少平方厘米？","answer":"56","explanation":"长方形 10×6＝60，剪掉 2×2＝4，剩下 60－4＝56（平方厘米）。","verify":"10*6-2*2","id":"cnm_p150_q4","topicId":"cnm_p150"},{"difficulty":"basic","type":"choice","prompt":"平行四边形的高是哪一种线段？","choices":[{"key":"A","text":"从一边上一点到对边的垂直线段"},{"key":"B","text":"任意一条斜边"},{"key":"C","text":"连接对角的线段"}],"answer":"A","explanation":"高是底和它的对边之间的垂直线段。","verify":"'从一边上一点到对边的垂直线段'","id":"cnm_p240_q1","topicId":"cnm_p240"},{"difficulty":"basic","type":"choice","prompt":"同一条底上的几条高，长度怎样？","choices":[{"key":"A","text":"都相等"},{"key":"B","text":"有的长有的短"},{"key":"C","text":"一定等于这条底"}],"answer":"A","explanation":"同一条底上的高都相等。","verify":"'都相等'","id":"cnm_p240_q2","topicId":"cnm_p240"},{"difficulty":"standard","type":"numeric","prompt":"长方形长 8 厘米、宽 5 厘米。以长为底，对应的高是多少厘米？","answer":"5","explanation":"长方形是特殊的平行四边形，以长为底时，对应的高就是宽，5 厘米。","verify":"5","id":"cnm_p240_q3","topicId":"cnm_p240"},{"difficulty":"challenge","type":"numeric","prompt":"一个长方形长 8 厘米、宽 5 厘米。把上面那条边沿底边的方向平移，变成平行四边形，底边仍是 8 厘米。以这条底为底，对应的高是多少厘米？","answer":"5","explanation":"上面那条边沿底边方向平移，它到这条底的垂直距离不变，高仍是 5 厘米。","verify":"5","id":"cnm_p240_q4","topicId":"cnm_p240"}]
