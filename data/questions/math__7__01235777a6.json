[{"id":"cnm_101_q1","topicId":"cnm_101","difficulty":"basic","type":"numeric","prompt":"某人每天通勤 10 km，公交每公里排放 0.05 kg，私家车每公里排放 0.2 kg，改乘公交一天少排放多少 kg？","answer":"1.5","explanation":"每公里少排放 0.2-0.05=0.15 kg，10 km 共少排放 10×0.15=1.5 kg。","verify":"10*(Fraction(2,10)-Fraction(5,100))"},{"id":"cnm_101_q2","topicId":"cnm_101","difficulty":"basic","type":"numeric","prompt":"改乘公交一天少排放 1.5 kg，一年按 200 个出行日计算，共少排放多少 kg？","answer":"300","explanation":"200×1.5=300 kg。","verify":"200*Fraction(3,2)"},{"id":"cnm_101_q3","topicId":"cnm_101","difficulty":"standard","type":"numeric","prompt":"某人每天通勤 x km。私家车每公里排放 0.2 kg，公交每公里排放 0.05 kg。要使改乘公交一天至少少排放 3 kg，x 至少是多少 km？","answer":"20","explanation":"列不等式 (0.2-0.05)x≥3，即 0.15x≥3，x≥20，所以 x 至少为 20 km。","verify":"Fraction(3)/(Fraction(2,10)-Fraction(5,100))"},{"id":"cnm_101_q4","topicId":"cnm_101","difficulty":"advanced","type":"choice","prompt":"方案 A：每月固定排放 30 kg，另每行驶 1 km 排放 0.1 kg；方案 B：每行驶 1 km 排放 0.25 kg，无固定排放。每月行驶超过多少 km 时，方案 A 的排放量更少？（单位：km）","answer":"A","choices":[{"key":"A","text":"200"},{"key":"B","text":"120"},{"key":"C","text":"150"},{"key":"D","text":"300"}],"explanation":"设行驶 x km，A 更少即 30+0.1x<0.25x，0.15x>30，x>200，所以超过 200 km 时 A 更少。","verify":"Fraction(30)/(Fraction(1,4)-Fraction(1,10))"}]
