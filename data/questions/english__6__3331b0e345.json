[{"id":"cne_p176_q1","topicId":"cne_p176","difficulty":"basic","type":"choice","prompt":"哪一句表示「你应该去看医生」？","choices":[{"key":"A","text":"You should sees a doctor."},{"key":"B","text":"You should see a doctor."},{"key":"C","text":"You are should see a doctor."},{"key":"D","text":"You see should a doctor."}],"answer":"B","explanation":"should 后面用动词原形 see。","verify":"\"You should see a doctor.\""},{"id":"cne_p176_q2","topicId":"cne_p176","difficulty":"basic","type":"choice","prompt":"I feel ill. 这句的意思是？","choices":[{"key":"A","text":"我很高兴"},{"key":"B","text":"我很生气"},{"key":"C","text":"我感到不舒服"},{"key":"D","text":"我很害怕"}],"answer":"C","explanation":"ill 是不舒服。","verify":"\"我感到不舒服\""},{"id":"cne_p176_q3","topicId":"cne_p176","difficulty":"standard","type":"choice","prompt":"You should wear warm clothes. 这是在做什么？","choices":[{"key":"A","text":"描述过去"},{"key":"B","text":"询问价格"},{"key":"C","text":"问路"},{"key":"D","text":"提出建议"}],"answer":"D","explanation":"should 用来提建议。","verify":"\"提出建议\""},{"id":"cne_p176_q4","topicId":"cne_p176","difficulty":"standard","type":"choice","prompt":"Do not be sad. 这句的意思是？","choices":[{"key":"A","text":"别难过"},{"key":"B","text":"别生气"},{"key":"C","text":"别害怕"},{"key":"D","text":"别高兴"}],"answer":"A","explanation":"sad 是难过。","verify":"\"别难过\""},{"id":"cne_p178_q1","topicId":"cne_p178","difficulty":"basic","type":"choice","prompt":"读一读：Sarah is sad. She should talk to her friends. Sarah 感觉怎样？","choices":[{"key":"A","text":"生气"},{"key":"B","text":"害怕"},{"key":"C","text":"高兴"},{"key":"D","text":"难过"}],"answer":"D","explanation":"sad。","verify":"\"难过\""},{"id":"cne_p178_q2","topicId":"cne_p178","difficulty":"basic","type":"choice","prompt":"读一读：I am ill. I should see a doctor. 哪一句和短文一致？","choices":[{"key":"A","text":"我不舒服，应该去看医生。"},{"key":"B","text":"我很高兴。"},{"key":"C","text":"我不应该看医生。"},{"key":"D","text":"我很害怕猫。"}],"answer":"A","explanation":"ill，should see a doctor。","verify":"\"我不舒服，应该去看医生。\""},{"id":"cne_p178_q3","topicId":"cne_p178","difficulty":"standard","type":"choice","prompt":"读一读：He is angry. He should take a deep breath. 他应该做什么？","choices":[{"key":"A","text":"去旅行"},{"key":"B","text":"深呼吸"},{"key":"C","text":"买词典"},{"key":"D","text":"骑自行车"}],"answer":"B","explanation":"take a deep breath。","verify":"\"深呼吸\""},{"id":"cne_p178_q4","topicId":"cne_p178","difficulty":"standard","type":"choice","prompt":"读一读：The cat is happy. The mouse is afraid. 谁很高兴？","choices":[{"key":"A","text":"老鼠"},{"key":"B","text":"医生"},{"key":"C","text":"猫"},{"key":"D","text":"两个都高兴"}],"answer":"C","explanation":"The cat is happy。","verify":"\"猫\""},{"id":"cne_p235_q1","topicId":"cne_p235","difficulty":"basic","type":"choice","prompt":"healthy 的意思是？","choices":[{"key":"A","text":"健康的"},{"key":"B","text":"生病的"},{"key":"C","text":"忙碌的"},{"key":"D","text":"懒惰的"}],"answer":"A","explanation":"healthy 是健康的。","verify":"\"健康的\""},{"id":"cne_p235_q2","topicId":"cne_p235","difficulty":"basic","type":"choice","prompt":"exercise 的意思是？","choices":[{"key":"A","text":"睡觉"},{"key":"B","text":"饮食"},{"key":"C","text":"习惯"},{"key":"D","text":"锻炼"}],"answer":"D","explanation":"exercise 是锻炼。","verify":"\"锻炼\""},{"id":"cne_p235_q3","topicId":"cne_p235","difficulty":"standard","type":"choice","prompt":"「习惯」用哪个词？","choices":[{"key":"A","text":"sleep"},{"key":"B","text":"party"},{"key":"C","text":"habit"},{"key":"D","text":"diet"}],"answer":"C","explanation":"habit 是习惯。","verify":"\"habit\""},{"id":"cne_p235_q4","topicId":"cne_p235","difficulty":"standard","type":"choice","prompt":"A good ____ helps you grow.","choices":[{"key":"A","text":"fight"},{"key":"B","text":"diet"},{"key":"C","text":"noise"},{"key":"D","text":"mess"}],"answer":"B","explanation":"diet 可指饮食。","verify":"\"diet\""},{"id":"cne_p236_q1","topicId":"cne_p236","difficulty":"basic","type":"choice","prompt":"想建议多锻炼，应选哪一句？","choices":[{"key":"A","text":"You should exercise more."},{"key":"B","text":"You should exercising more."},{"key":"C","text":"You shouldn't exercise more."},{"key":"D","text":"You should exercises more."}],"answer":"A","explanation":"should + 动词原形。","verify":"\"You should exercise more.\""},{"id":"cne_p236_q2","topicId":"cne_p236","difficulty":"basic","type":"choice","prompt":"You shouldn't stay up late. 这句建议是？","choices":[{"key":"A","text":"应该熬夜"},{"key":"B","text":"必须熬夜"},{"key":"C","text":"可以不睡觉"},{"key":"D","text":"不该熬夜"}],"answer":"D","explanation":"shouldn't 表示不该。","verify":"\"不该熬夜\""},{"id":"cne_p236_q3","topicId":"cne_p236","difficulty":"standard","type":"choice","prompt":"哪一句是健康建议？","choices":[{"key":"A","text":"You shouldn't drink water."},{"key":"B","text":"You should never exercise."},{"key":"C","text":"You should sleep early."},{"key":"D","text":"You should eat junk food every day."}],"answer":"C","explanation":"早睡是健康建议。","verify":"\"You should sleep early.\""},{"id":"cne_p236_q4","topicId":"cne_p236","difficulty":"standard","type":"choice","prompt":"To keep healthy, you ____ eat fruit.","choices":[{"key":"A","text":"don't can"},{"key":"B","text":"should"},{"key":"C","text":"shouldn't"},{"key":"D","text":"aren't"}],"answer":"B","explanation":"should 表示建议。","verify":"\"should\""},{"id":"cne_p237_q1","topicId":"cne_p237","difficulty":"basic","type":"choice","prompt":"读一读：Tom exercises every day. He sleeps early. 汤姆有什么好习惯？","choices":[{"key":"A","text":"天天锻炼、早睡"},{"key":"B","text":"从不锻炼"},{"key":"C","text":"天天熬夜"},{"key":"D","text":"只吃零食"}],"answer":"A","explanation":"exercises every day … sleeps early。","verify":"\"天天锻炼、早睡\""},{"id":"cne_p237_q2","topicId":"cne_p237","difficulty":"basic","type":"choice","prompt":"读一读：You should eat more vegetables. 短文建议吃什么？","choices":[{"key":"A","text":"更多糖果"},{"key":"B","text":"更少水"},{"key":"C","text":"不吃饭"},{"key":"D","text":"更多蔬菜"}],"answer":"D","explanation":"more vegetables。","verify":"\"更多蔬菜\""},{"id":"cne_p237_q3","topicId":"cne_p237","difficulty":"standard","type":"choice","prompt":"读一读：A healthy life needs good habits. Amy has a good diet. 哪一句一致？","choices":[{"key":"A","text":"健康生活不需要习惯。"},{"key":"B","text":"艾米从不吃饭。"},{"key":"C","text":"艾米饮食较好。"},{"key":"D","text":"艾米没有好习惯。"}],"answer":"C","explanation":"good diet。","verify":"\"艾米饮食较好。\""},{"id":"cne_p237_q4","topicId":"cne_p237","difficulty":"standard","type":"choice","prompt":"读一读：Don't sit too long. Go out and exercise. 短文建议？","choices":[{"key":"A","text":"只在室内睡觉"},{"key":"B","text":"别久坐，出去锻炼"},{"key":"C","text":"一直坐着"},{"key":"D","text":"不要锻炼"}],"answer":"B","explanation":"Don't sit too long. Go out and exercise。","verify":"\"别久坐，出去锻炼\""}]
