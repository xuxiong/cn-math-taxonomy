[{"id":"cnm_144_q1","topicId":"cnm_144","difficulty":"basic","type":"choice","prompt":"计算 3a²b·(-2ab³)。","answer":"D","choices":[{"key":"A","text":"-6a²b³"},{"key":"B","text":"6a³b⁴"},{"key":"C","text":"-5a³b⁴"},{"key":"D","text":"-6a³b⁴"}],"explanation":"系数 3×(-2)=-6；a：a²·a=a³；b：b·b³=b⁴；结果 -6a³b⁴。"},{"id":"cnm_144_q2","topicId":"cnm_144","difficulty":"basic","type":"numeric","prompt":"计算 2a·3a^2，并求当 a=2 时的值。","answer":"48","explanation":"2a·3a^2=6a^3，当 a=2 时，6×2^3=48。","verify":"6*2**3"},{"id":"cnm_144_q3","topicId":"cnm_144","difficulty":"standard","type":"numeric","prompt":"已知 x=1，y=-1，求 (-2x^2y)·(3xy^2) 的值。","answer":"6","explanation":"(-2x^2y)·(3xy^2)=-6x^3y^3，代入得 -6×1×(-1)=6。","verify":"(-2*1**2*(-1))*(3*1*(-1)**2)"},{"id":"cnm_144_q4","topicId":"cnm_144","difficulty":"advanced","type":"numeric","prompt":"若 3x^m y^3·(-2x^2 y^n)=-6x^5 y^4，求 m、n 的值（依次作答，用逗号隔开）。","answer":"3，1","explanation":"左边=-6x^(m+2)y^(3+n)，所以 m+2=5，3+n=4，得 m=3，n=1。","verify":"[5-2, 4-3]"},{"id":"cnm_145_q1","topicId":"cnm_145","difficulty":"basic","type":"choice","prompt":"计算 2x(3x-y)。","answer":"C","choices":[{"key":"A","text":"6x²-y"},{"key":"B","text":"6x-2xy"},{"key":"C","text":"6x²-2xy"},{"key":"D","text":"5x²-2xy"}],"explanation":"用分配律：2x·3x=6x²，2x·(-y)=-2xy。"},{"id":"cnm_145_q2","topicId":"cnm_145","difficulty":"basic","type":"choice","prompt":"计算 -3x(2x-4)，结果是：","answer":"B","choices":[{"key":"A","text":"-6x²-12x"},{"key":"B","text":"-6x²+12x"},{"key":"C","text":"6x²+12x"},{"key":"D","text":"-6x²-4"}],"explanation":"-3x·2x=-6x²，-3x·(-4)=+12x，注意符号。"},{"id":"cnm_145_q3","topicId":"cnm_145","difficulty":"standard","type":"numeric","prompt":"化简 x(2x-3)-2x(x-1)，并求当 x=5 时的值。","answer":"-5","explanation":"x(2x-3)-2x(x-1)=2x²-3x-2x²+2x=-x，x=5 时值为 -5。","verify":"5*(2*5-3)-2*5*(5-1)"},{"id":"cnm_145_q4","topicId":"cnm_145","difficulty":"advanced","type":"numeric","prompt":"若 (-2x)(x^2-ax+1) 展开后 x^2 项的系数为 6，求 a 的值。","answer":"3","explanation":"展开式中的 x^2 项来自 (-2x)·(-ax)=2a x^2，所以 2a=6，a=3。","verify":"Fraction(6,2)"},{"id":"cnm_146_q1","topicId":"cnm_146","difficulty":"basic","type":"choice","prompt":"计算 (x+2)(x-3)。","answer":"B","choices":[{"key":"A","text":"x²+x-6"},{"key":"B","text":"x²-x-6"},{"key":"C","text":"x²-6"},{"key":"D","text":"x²-5x-6"}],"explanation":"x·x=x²，x·(-3)=-3x，2·x=2x，2·(-3)=-6，合并得 x²-x-6。"},{"id":"cnm_146_q2","topicId":"cnm_146","difficulty":"basic","type":"numeric","prompt":"展开 (x+1)(x+2)，求结果中 x 的系数。","answer":"3","explanation":"(x+1)(x+2)=x²+2x+x+2=x²+3x+2，x 的系数为 3。","verify":"1+2"},{"id":"cnm_146_q3","topicId":"cnm_146","difficulty":"standard","type":"numeric","prompt":"展开 (2x-1)(3x+4)，依次写出 x 项系数和常数项，用逗号隔开。","answer":"5，-4","explanation":"(2x-1)(3x+4)=6x²+8x-3x-4=6x²+5x-4。","verify":"[2*4+(-1)*3, -1*4]"},{"id":"cnm_146_q4","topicId":"cnm_146","difficulty":"standard","type":"choice","prompt":"计算 (a+2b)(a-b)。","answer":"B","choices":[{"key":"A","text":"a²-2b²"},{"key":"B","text":"a²+ab-2b²"},{"key":"C","text":"a²+3ab-2b²"},{"key":"D","text":"a²+ab+2b²"}],"explanation":"a·a=a²，a·(-b)=-ab，2b·a=2ab，2b·(-b)=-2b²，合并得 a²+ab-2b²。"},{"id":"cnm_146_q5","topicId":"cnm_146","difficulty":"advanced","type":"numeric","prompt":"若 (x+2)(x^2+ax+b) 的展开式中不含 x^2 项和 x 项，求 a、b 的值（依次作答，用逗号隔开）。","answer":"-2，4","explanation":"展开得 x^3+(a+2)x^2+(b+2a)x+2b。x^2 项系数 a+2=0，得 a=-2；x 项系数 b+2a=0，得 b=4。","verify":"[-2, -2*(-2)]"}]
