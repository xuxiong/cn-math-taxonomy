[{"id":"cns_p150_q1","topicId":"cns_p150","difficulty":"basic","type":"choice","prompt":"小车的车轮通常装在什么上转动？","choices":[{"key":"A","text":"车顶"},{"key":"B","text":"车窗"},{"key":"C","text":"方向灯"},{"key":"D","text":"车轴"}],"answer":"D","explanation":"车轮绕车轴转动。","verify":"\"车轴\""},{"id":"cns_p150_q2","topicId":"cns_p150","difficulty":"basic","type":"choice","prompt":"让小车动起来需要什么？","choices":[{"key":"A","text":"力"},{"key":"B","text":"颜色"},{"key":"C","text":"名字"},{"key":"D","text":"光线"}],"answer":"A","explanation":"物体运动状态的改变需要力。","verify":"\"力\""},{"id":"cns_p150_q3","topicId":"cns_p150","difficulty":"standard","type":"choice","prompt":"车架的主要作用是什么？","choices":[{"key":"A","text":"产生动力"},{"key":"B","text":"支撑和连接各个部件"},{"key":"C","text":"发出声音"},{"key":"D","text":"照明"}],"answer":"B","explanation":"车架是小车的骨架。","verify":"\"支撑和连接各个部件\""},{"id":"cns_p150_q4","topicId":"cns_p150","difficulty":"challenge","type":"choice","prompt":"小车的轮子总是歪着走，最可能的原因是？","choices":[{"key":"A","text":"小车颜色不对"},{"key":"B","text":"地面太平"},{"key":"C","text":"车轴装歪了或轮子没装正"},{"key":"D","text":"车太新"}],"answer":"C","explanation":"车轴不平行或轮子歪，小车会跑偏。","verify":"\"车轴装歪了或轮子没装正\""},{"id":"cns_p151_q1","topicId":"cns_p151","difficulty":"basic","type":"choice","prompt":"地球对物体的吸引力叫什么？","choices":[{"key":"A","text":"重力"},{"key":"B","text":"弹力"},{"key":"C","text":"摩擦力"},{"key":"D","text":"磁力"}],"answer":"A","explanation":"重力使物体向下落。","verify":"\"重力\""},{"id":"cns_p151_q2","topicId":"cns_p151","difficulty":"basic","type":"choice","prompt":"重力的方向是怎样的？","choices":[{"key":"A","text":"水平向前"},{"key":"B","text":"竖直向下"},{"key":"C","text":"竖直向上"},{"key":"D","text":"随便哪个方向"}],"answer":"B","explanation":"重力总是竖直向下。","verify":"\"竖直向下\""},{"id":"cns_p151_q3","topicId":"cns_p151","difficulty":"standard","type":"choice","prompt":"用垂在桌边的重物通过绳子拉小车，重物越重，小车怎样？","choices":[{"key":"A","text":"运动越慢"},{"key":"B","text":"一动不动"},{"key":"C","text":"运动越快"},{"key":"D","text":"向后退"}],"answer":"C","explanation":"拉力越大，小车速度越快。","verify":"\"运动越快\""},{"id":"cns_p151_q4","topicId":"cns_p151","difficulty":"challenge","type":"choice","prompt":"研究「拉力大小对小车运动的影响」，应该改变什么、不变什么？","choices":[{"key":"A","text":"同时换小车和重物"},{"key":"B","text":"只换路面"},{"key":"C","text":"什么都改变"},{"key":"D","text":"只改变重物多少，小车和路面都不变"}],"answer":"D","explanation":"对比实验只改变一个条件。","verify":"\"只改变重物多少，小车和路面都不变\""},{"id":"cns_p152_q1","topicId":"cns_p152","difficulty":"basic","type":"choice","prompt":"橡皮筋被拉长后想恢复原状，产生的力叫什么？","choices":[{"key":"A","text":"重力"},{"key":"B","text":"弹力"},{"key":"C","text":"摩擦力"},{"key":"D","text":"浮力"}],"answer":"B","explanation":"形变的物体恢复原状产生弹力。","verify":"\"弹力\""},{"id":"cns_p152_q2","topicId":"cns_p152","difficulty":"basic","type":"choice","prompt":"橡皮筋缠绕的圈数越多，小车会怎样？","choices":[{"key":"A","text":"跑得越近"},{"key":"B","text":"不动"},{"key":"C","text":"跑得越远"},{"key":"D","text":"倒退"}],"answer":"C","explanation":"形变越大，弹力越大。","verify":"\"跑得越远\""},{"id":"cns_p152_q3","topicId":"cns_p152","difficulty":"standard","type":"choice","prompt":"下面哪样东西利用了弹力？","choices":[{"key":"A","text":"铁锤"},{"key":"B","text":"木头桌"},{"key":"C","text":"石块"},{"key":"D","text":"弹簧床垫"}],"answer":"D","explanation":"弹簧被压缩后产生弹力。","verify":"\"弹簧床垫\""},{"id":"cns_p152_q4","topicId":"cns_p152","difficulty":"challenge","type":"choice","prompt":"一根橡皮筋拉得太长断掉了，说明什么？","choices":[{"key":"A","text":"物体的形变有一定限度"},{"key":"B","text":"弹力无限大"},{"key":"C","text":"橡皮筋越拉越结实"},{"key":"D","text":"橡皮筋没有弹性"}],"answer":"A","explanation":"超过限度，物体会损坏或失去弹性。","verify":"\"物体的形变有一定限度\""},{"id":"cns_p153_q1","topicId":"cns_p153","difficulty":"basic","type":"choice","prompt":"力的单位是什么？","choices":[{"key":"A","text":"千克"},{"key":"B","text":"米"},{"key":"C","text":"牛顿（牛）"},{"key":"D","text":"秒"}],"answer":"C","explanation":"力的单位是牛顿，简称牛，符号 N。","verify":"\"牛顿（牛）\""},{"id":"cns_p153_q2","topicId":"cns_p153","difficulty":"basic","type":"choice","prompt":"测量力的大小，常用什么工具？","choices":[{"key":"A","text":"天平"},{"key":"B","text":"温度计"},{"key":"C","text":"量筒"},{"key":"D","text":"弹簧测力计"}],"answer":"D","explanation":"弹簧测力计利用弹簧伸长测力。","verify":"\"弹簧测力计\""},{"id":"cns_p153_q3","topicId":"cns_p153","difficulty":"standard","type":"choice","prompt":"使用弹簧测力计前，第一步要做什么？","choices":[{"key":"A","text":"检查指针是否指在零刻度"},{"key":"B","text":"直接挂重物"},{"key":"C","text":"用力拉到最大"},{"key":"D","text":"把弹簧拆下来"}],"answer":"A","explanation":"先校零，读数才准确。","verify":"\"检查指针是否指在零刻度\""},{"id":"cns_p153_q4","topicId":"cns_p153","difficulty":"challenge","type":"choice","prompt":"弹簧测力计的量程是 5 牛，挂上一个约 8 牛的物体会怎样？","choices":[{"key":"A","text":"读数 8 牛很准"},{"key":"B","text":"超过量程，可能损坏测力计"},{"key":"C","text":"弹簧变短"},{"key":"D","text":"读数为 0"}],"answer":"B","explanation":"不能超过量程使用。","verify":"\"超过量程，可能损坏测力计\""},{"id":"cns_p154_q1","topicId":"cns_p154","difficulty":"basic","type":"choice","prompt":"在冰面上走路容易滑倒，是因为什么？","choices":[{"key":"A","text":"冰面摩擦力很大"},{"key":"B","text":"冰很冷"},{"key":"C","text":"冰太硬"},{"key":"D","text":"冰面光滑，摩擦力小"}],"answer":"D","explanation":"接触面越光滑，摩擦力越小。","verify":"\"冰面光滑，摩擦力小\""},{"id":"cns_p154_q2","topicId":"cns_p154","difficulty":"basic","type":"choice","prompt":"下面哪种做法是增大摩擦力？","choices":[{"key":"A","text":"鞋底刻上花纹"},{"key":"B","text":"给自行车链条加油"},{"key":"C","text":"在冰面上撒水"},{"key":"D","text":"把地面拖得更光滑"}],"answer":"A","explanation":"花纹使接触面更粗糙。","verify":"\"鞋底刻上花纹\""},{"id":"cns_p154_q3","topicId":"cns_p154","difficulty":"standard","type":"choice","prompt":"拉同一个木块，在木块上再放一本书，摩擦力会怎样？","choices":[{"key":"A","text":"变小"},{"key":"B","text":"变大"},{"key":"C","text":"不变"},{"key":"D","text":"变为零"}],"answer":"B","explanation":"压力越大，摩擦力越大。","verify":"\"变大\""},{"id":"cns_p154_q4","topicId":"cns_p154","difficulty":"challenge","type":"choice","prompt":"下面哪个例子是减小摩擦力？","choices":[{"key":"A","text":"雪天给车轮装防滑链"},{"key":"B","text":"运动员手上擦镁粉"},{"key":"C","text":"在轴承里加润滑油、装滚珠"},{"key":"D","text":"拔河时穿花纹鞋"}],"answer":"C","explanation":"加润滑油、变滑动为滚动都能减小摩擦。","verify":"\"在轴承里加润滑油、装滚珠\""},{"id":"cns_p155_q1","topicId":"cns_p155","difficulty":"basic","type":"choice","prompt":"设计「月球小车」时，最先要做的是什么？","choices":[{"key":"A","text":"明确小车要完成的任务和限制条件"},{"key":"B","text":"马上动手粘"},{"key":"C","text":"先涂颜色"},{"key":"D","text":"先比赛"}],"answer":"A","explanation":"工程设计先明确问题。","verify":"\"明确小车要完成的任务和限制条件\""},{"id":"cns_p155_q2","topicId":"cns_p155","difficulty":"basic","type":"choice","prompt":"模拟月面是松软的沙土，小车轮子做成什么样更好？","choices":[{"key":"A","text":"细窄光滑"},{"key":"B","text":"宽大且有花纹"},{"key":"C","text":"方形"},{"key":"D","text":"越小越好"}],"answer":"B","explanation":"宽大有花纹的轮子不易陷，抓地好。","verify":"\"宽大且有花纹\""},{"id":"cns_p155_q3","topicId":"cns_p155","difficulty":"standard","type":"choice","prompt":"测试小车时，小车总在斜坡上打滑，可以怎样改进？","choices":[{"key":"A","text":"把车轮涂上油"},{"key":"B","text":"去掉动力"},{"key":"C","text":"增大车轮的摩擦，如加花纹或换材料"},{"key":"D","text":"让坡更陡"}],"answer":"C","explanation":"增大摩擦能防止打滑。","verify":"\"增大车轮的摩擦，如加花纹或换材料\""},{"id":"cns_p155_q4","topicId":"cns_p155","difficulty":"challenge","type":"choice","prompt":"评价各组的小车，下面哪种方法最合理？","choices":[{"key":"A","text":"看谁的颜色最好看"},{"key":"B","text":"看谁的组人多"},{"key":"C","text":"看谁说话声音大"},{"key":"D","text":"按事先定好的标准逐项打分"}],"answer":"D","explanation":"用统一标准评价才公平。","verify":"\"按事先定好的标准逐项打分\""}]
