[{"id":"cnc_p281_q1","topicId":"cnc_p281","difficulty":"basic","type":"choice","prompt":"「昼出耘田夜绩麻」的下一句是哪一句？","choices":[{"key":"A","text":"童孙未解供耕织"},{"key":"B","text":"也傍桑阴学种瓜"},{"key":"C","text":"村庄儿女各当家"},{"key":"D","text":"村庄儿女各回家"}],"answer":"C","explanation":"白天耕田、夜里绩麻之后，写村里的孩子各做各的事。","verify":"\"村庄儿女各当家\""},{"id":"cnc_p281_q2","topicId":"cnc_p281","difficulty":"basic","type":"choice","prompt":"「童孙未解供耕织」的下一句是哪一句？","choices":[{"key":"A","text":"村庄儿女各当家"},{"key":"B","text":"也傍桑荫学种瓜"},{"key":"C","text":"也傍桑阴学摘瓜"},{"key":"D","text":"也傍桑阴学种瓜"}],"answer":"D","explanation":"小孩还不懂耕织，也在桑树荫下学着种瓜。诗中是种瓜，不是摘瓜。","verify":"\"也傍桑阴学种瓜\""},{"id":"cnc_p281_q3","topicId":"cnc_p281","difficulty":"standard","type":"choice","prompt":"《四时田园杂兴》（昼出耘田）的作者是谁？","choices":[{"key":"A","text":"范成大"},{"key":"B","text":"杨万里"},{"key":"C","text":"辛弃疾"},{"key":"D","text":"白居易"}],"answer":"A","explanation":"这首田园诗是范成大写的。杨万里写的是《宿新市徐公店》，不要记混。","verify":"\"范成大\""},{"id":"cnc_p281_q4","topicId":"cnc_p281","difficulty":"standard","type":"choice","prompt":"「昼出耘田夜绩麻」写的是怎样劳动？","choices":[{"key":"A","text":"白天绩麻，夜里耕田"},{"key":"B","text":"白天耕田，夜里绩麻"},{"key":"C","text":"白天睡觉，夜里种瓜"},{"key":"D","text":"只在桑树下看别人干活"}],"answer":"B","explanation":"昼是白天，夜是夜里。耘田和绩麻的顺序不能对调。","verify":"\"白天耕田，夜里绩麻\""},{"id":"cnc_p282_q1","topicId":"cnc_p282","difficulty":"basic","type":"choice","prompt":"「篱落疏疏一径深」的下一句是哪一句？","choices":[{"key":"A","text":"儿童急走追黄蝶"},{"key":"B","text":"树头新绿未成荫"},{"key":"C","text":"飞入菜花无处寻"},{"key":"D","text":"树头新绿未成阴"}],"answer":"D","explanation":"篱笆稀疏，小路深远，树头的新叶还没有成荫。儿童急走是第三句。","verify":"\"树头新绿未成阴\""},{"id":"cnc_p282_q2","topicId":"cnc_p282","difficulty":"basic","type":"choice","prompt":"「儿童急走追黄蝶」的下一句是哪一句？","choices":[{"key":"A","text":"飞入菜花无处寻"},{"key":"B","text":"树头新绿未成阴"},{"key":"C","text":"飞入菜花无处找"},{"key":"D","text":"也傍桑阴学种瓜"}],"answer":"A","explanation":"蝴蝶飞进黄菜花里，就找不到了。学种瓜是范成大那首诗。","verify":"\"飞入菜花无处寻\""},{"id":"cnc_p282_q3","topicId":"cnc_p282","difficulty":"standard","type":"choice","prompt":"《宿新市徐公店》的作者是谁？","choices":[{"key":"A","text":"范成大"},{"key":"B","text":"杨万里"},{"key":"C","text":"辛弃疾"},{"key":"D","text":"杜甫"}],"answer":"B","explanation":"追黄蝶这首是杨万里的。《四时田园杂兴》才是范成大的。","verify":"\"杨万里\""},{"id":"cnc_p282_q4","topicId":"cnc_p282","difficulty":"standard","type":"choice","prompt":"黄蝶为什么难找了？","choices":[{"key":"A","text":"它飞出了这首诗"},{"key":"B","text":"儿童没有去追"},{"key":"C","text":"它飞进同样是黄色的菜花里"},{"key":"D","text":"菜花是红色的，蝴蝶是白的"}],"answer":"C","explanation":"菜花和黄蝶颜色一样，所以无处寻。","verify":"\"它飞进同样是黄色的菜花里\""},{"id":"cnc_p283_q1","topicId":"cnc_p283","difficulty":"basic","type":"choice","prompt":"「最喜小儿亡赖」的下一句是哪一句？","choices":[{"key":"A","text":"溪头卧剥莲蓬"},{"key":"B","text":"溪头卧剥莲花"},{"key":"C","text":"大儿锄豆溪东"},{"key":"D","text":"中儿正织鸡笼"}],"answer":"A","explanation":"最小的孩子躺在溪边剥莲蓬。不是莲花。","verify":"\"溪头卧剥莲蓬\""},{"id":"cnc_p283_q2","topicId":"cnc_p283","difficulty":"basic","type":"choice","prompt":"词里的「亡赖」是什么意思？","choices":[{"key":"A","text":"不诚实"},{"key":"B","text":"顽皮"},{"key":"C","text":"没有朋友"},{"key":"D","text":"很可怜"}],"answer":"B","explanation":"这里的亡赖就是顽皮、淘气，不是说他品德不好。","verify":"\"顽皮\""},{"id":"cnc_p283_q3","topicId":"cnc_p283","difficulty":"standard","type":"choice","prompt":"大儿和中儿分别在做什么？","choices":[{"key":"A","text":"大儿织鸡笼，中儿锄豆"},{"key":"B","text":"两个都在剥莲蓬"},{"key":"C","text":"大儿锄豆，中儿织鸡笼"},{"key":"D","text":"两个都在睡觉"}],"answer":"C","explanation":"大儿在溪东锄豆，中儿在编鸡笼。","verify":"\"大儿锄豆，中儿织鸡笼\""},{"id":"cnc_p283_q4","topicId":"cnc_p283","difficulty":"standard","type":"choice","prompt":"这首词写的是什么地方的生活？","choices":[{"key":"A","text":"皇宫"},{"key":"B","text":"战场"},{"key":"C","text":"学校课堂"},{"key":"D","text":"农家"}],"answer":"D","explanation":"茅檐、锄豆、鸡笼和莲蓬，都是农家生活。作者是辛弃疾。","verify":"\"农家\""},{"id":"cnc_p284_q1","topicId":"cnc_p284","difficulty":"basic","type":"choice","prompt":"屋前的瓜藤是怎样的？","choices":[{"key":"A","text":"全部枯萎了"},{"key":"B","text":"攀上屋檐，花和藤构成一幅图画"},{"key":"C","text":"长在河里"},{"key":"D","text":"开在皇宫的墙上"}],"answer":"B","explanation":"青、红的瓜，碧绿的藤和叶子，把屋子装饰起来。","verify":"\"攀上屋檐，花和藤构成一幅图画\""},{"id":"cnc_p284_q2","topicId":"cnc_p284","difficulty":"basic","type":"choice","prompt":"花是怎样开的？","choices":[{"key":"A","text":"一年只在同一天一起开"},{"key":"B","text":"只开在夜里的潮水上"},{"key":"C","text":"依着时令，顺序开放"},{"key":"D","text":"开完就再也不开了"}],"answer":"C","explanation":"课文写花依着时令，春天、夏天各有各的花。","verify":"\"依着时令，顺序开放\""},{"id":"cnc_p284_q3","topicId":"cnc_p284","difficulty":"standard","type":"choice","prompt":"傍晚，人们常常在哪里？","choices":[{"key":"A","text":"在潮水里游泳"},{"key":"B","text":"在煤矿里"},{"key":"C","text":"在桅杆上"},{"key":"D","text":"在门前吃饭、聊天"}],"answer":"D","explanation":"纺织娘叫起来的时候，人们在门前的场地上吃饭、闲话。","verify":"\"在门前吃饭、聊天\""},{"id":"cnc_p284_q4","topicId":"cnc_p284","difficulty":"standard","type":"choice","prompt":"作者觉得乡下人家怎样？","choices":[{"key":"A","text":"有独特、迷人的风景"},{"key":"B","text":"和城里的楼完全一样"},{"key":"C","text":"没有一点生气"},{"key":"D","text":"只适合写成说明文里的数字"}],"answer":"A","explanation":"无论白天晚上，屋前屋后都有自己的景象，所以说独特、迷人。","verify":"\"有独特、迷人的风景\""},{"id":"cnc_p285_q1","topicId":"cnc_p285","difficulty":"basic","type":"choice","prompt":"《天窗》的作者是谁？","choices":[{"key":"A","text":"陈醉云"},{"key":"B","text":"刘湛秋"},{"key":"C","text":"茅盾"},{"key":"D","text":"巴金"}],"answer":"C","explanation":"这篇是茅盾写的。《乡下人家》是陈醉云的，《三月桃花水》是刘湛秋的。","verify":"\"茅盾\""},{"id":"cnc_p285_q2","topicId":"cnc_p285","difficulty":"basic","type":"choice","prompt":"夏天阵雨来了，孩子们被关在屋里，唯一的慰藉是什么？","choices":[{"key":"A","text":"门前攀上屋檐的瓜藤"},{"key":"B","text":"三月的桃花水"},{"key":"C","text":"钱塘江的大潮"},{"key":"D","text":"那扇小小的天窗"}],"answer":"D","explanation":"木板窗关上以后，屋子像地洞。他们只能从天窗看出去。瓜藤是《乡下人家》里的。","verify":"\"那扇小小的天窗\""},{"id":"cnc_p285_q3","topicId":"cnc_p285","difficulty":"standard","type":"choice","prompt":"透过天窗，孩子们会怎样？","choices":[{"key":"A","text":"由一点雨、一粒星，想象出更广大的世界"},{"key":"B","text":"只数有几块玻璃，不再想别的"},{"key":"C","text":"把天窗看成琥珀里的蜘蛛"},{"key":"D","text":"天窗外什么也没有，所以不能想"}],"answer":"A","explanation":"看雨、看闪电、看星星，都会想得很远。想象比实际看见的更广阔。","verify":"\"由一点雨、一粒星，想象出更广大的世界\""},{"id":"cnc_p285_q4","topicId":"cnc_p285","difficulty":"standard","type":"choice","prompt":"课文为什么说发明天窗的人应得感谢？","choices":[{"key":"A","text":"天窗可以代替所有的灯"},{"key":"B","text":"孩子们能从「无」中看出「有」，从「虚」中看出「实」"},{"key":"C","text":"有了天窗就不用再读书"},{"key":"D","text":"天窗是用来堆瓜的"}],"answer":"B","explanation":"看见的也许很少，想出来的却又真切又广大。这是课文要说的。","verify":"\"孩子们能从「无」中看出「有」，从「虚」中看出「实」\""},{"id":"cnc_p286_q1","topicId":"cnc_p286","difficulty":"basic","type":"choice","prompt":"《三月桃花水》的作者是谁？","choices":[{"key":"A","text":"茅盾"},{"key":"B","text":"陈醉云"},{"key":"C","text":"艾青"},{"key":"D","text":"刘湛秋"}],"answer":"D","explanation":"这篇散文诗是刘湛秋的。《天窗》才是茅盾的。","verify":"\"刘湛秋\""},{"id":"cnc_p286_q2","topicId":"cnc_p286","difficulty":"basic","type":"choice","prompt":"课文把三月的桃花水比作什么？","choices":[{"key":"A","text":"春天的竖琴，也是春天的明镜"},{"key":"B","text":"一块包着苍蝇的琥珀"},{"key":"C","text":"一扇只能看见雨点的天窗"},{"key":"D","text":"一堵把孩子挡在外面的墙"}],"answer":"A","explanation":"水声像琴，水面像镜子。琥珀和天窗是另外两篇。","verify":"\"春天的竖琴，也是春天的明镜\""},{"id":"cnc_p286_q3","topicId":"cnc_p286","difficulty":"standard","type":"choice","prompt":"「竖琴」主要在写什么？","choices":[{"key":"A","text":"河底真的放着一张琴"},{"key":"B","text":"流水发出的声音"},{"key":"C","text":"孩子们在河边上课"},{"key":"D","text":"雨点打在天窗上"}],"answer":"B","explanation":"水声有时大有时小，应和着村里的声音，所以说它是竖琴。","verify":"\"流水发出的声音\""},{"id":"cnc_p286_q4","topicId":"cnc_p286","difficulty":"standard","type":"choice","prompt":"「明镜」主要在写什么？","choices":[{"key":"A","text":"河水黑得什么也照不见"},{"key":"B","text":"作者在批评春天的河水太吵"},{"key":"C","text":"河水映出燕子、柳枝和来到河边的人"},{"key":"D","text":"水面结了冰，人不能靠近"}],"answer":"C","explanation":"明镜写的是水里的倒影。整篇都在赞美这河水，不是在嫌它吵。","verify":"\"河水映出燕子、柳枝和来到河边的人\""},{"id":"cnc_p287_q1","topicId":"cnc_p287","difficulty":"basic","type":"choice","prompt":"和水有关的是哪一个字？","choices":[{"key":"A","text":"清"},{"key":"B","text":"晴"},{"key":"C","text":"情"},{"key":"D","text":"请"}],"answer":"A","explanation":"清是三点水，和水有关。晴是日字旁，情是竖心旁，请是言字旁。","verify":"\"清\""},{"id":"cnc_p287_q2","topicId":"cnc_p287","difficulty":"basic","type":"choice","prompt":"「今天是____天」横线处该写哪一个？","choices":[{"key":"A","text":"清"},{"key":"B","text":"晴"},{"key":"C","text":"情"},{"key":"D","text":"请"}],"answer":"B","explanation":"晴天和太阳有关，用日字旁的晴。","verify":"\"晴\""},{"id":"cnc_p287_q3","topicId":"cnc_p287","difficulty":"standard","type":"choice","prompt":"「事____」横线处该写哪一个？","choices":[{"key":"A","text":"清"},{"key":"B","text":"晴"},{"key":"C","text":"情"},{"key":"D","text":"请"}],"answer":"C","explanation":"事情和心情有关，用竖心旁的情。","verify":"\"情\""},{"id":"cnc_p287_q4","topicId":"cnc_p287","difficulty":"standard","type":"choice","prompt":"「____客」横线处该写哪一个？","choices":[{"key":"A","text":"清"},{"key":"B","text":"晴"},{"key":"C","text":"情"},{"key":"D","text":"请"}],"answer":"D","explanation":"请客要用语言邀请，是言字旁的请。","verify":"\"请\""}]
