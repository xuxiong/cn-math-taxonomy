[{"id":"cnp_017_q1","topicId":"cnp_017","difficulty":"basic","type":"choice","prompt":"人站在平面镜前 2 m 处，人与镜中像的距离是多少？","choices":[{"key":"A","text":"2 m"},{"key":"B","text":"1 m"},{"key":"C","text":"0 m"},{"key":"D","text":"4 m"}],"answer":"D","explanation":"像到镜面的距离等于人到镜面的距离 2 m，人与像相距 2 + 2 = 4 m。","verify":"2*2"},{"id":"cnp_017_q2","topicId":"cnp_017","difficulty":"basic","type":"choice","prompt":"人走近平面镜时，镜中像的大小会怎样？","choices":[{"key":"A","text":"变大"},{"key":"B","text":"变小"},{"key":"C","text":"先变大后变小"},{"key":"D","text":"不变"}],"answer":"D","explanation":"平面镜所成的像与物体大小相等，与距离无关；看起来变大只是视角变大。","verify":"\"不变\""},{"id":"cnp_017_q3","topicId":"cnp_017","difficulty":"standard","type":"choice","prompt":"探究平面镜成像特点时，用玻璃板代替平面镜，主要目的是什么？","choices":[{"key":"A","text":"使像更清晰"},{"key":"B","text":"便于确定像的位置"},{"key":"C","text":"使像变大"},{"key":"D","text":"能成实像"}],"answer":"B","explanation":"玻璃板既能成像又能透光，可以看到后面的蜡烛，从而确定像的位置。","verify":"\"便于确定像的位置\""},{"id":"cnp_017_q4","topicId":"cnp_017","difficulty":"standard","type":"choice","prompt":"在像的位置放一块光屏，光屏上能看到像吗？","choices":[{"key":"A","text":"能，成的是实像"},{"key":"B","text":"能，但像是倒立的"},{"key":"C","text":"只有在暗室里能"},{"key":"D","text":"不能，平面镜成的是虚像"}],"answer":"D","explanation":"平面镜成的是虚像，不是实际光线会聚而成，光屏承接不到。","verify":"\"不能，平面镜成的是虚像\""}]
