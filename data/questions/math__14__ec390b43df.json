[{"id":"cnm_h240_q1","topicId":"cnm_h240","difficulty":"basic","type":"numeric","prompt":"(1+x)^3 的展开式中，x² 的系数是多少？","answer":"3","explanation":"对应 k=2 的二项式系数 C(3,2)=3。","verify":"comb(3,2)"},{"id":"cnm_h240_q2","topicId":"cnm_h240","difficulty":"basic","type":"numeric","prompt":"(a+b)^4 的展开式一共有多少项？","answer":"5","explanation":"k 从 0 到 4，共 5 项。","verify":"4+1"},{"id":"cnm_h240_q3","topicId":"cnm_h240","difficulty":"standard","type":"choice","prompt":"二项式定理展开 (a+b)^n，一般项是什么？","choices":[{"key":"A","text":"a 的 n 次方加上 b 的 n 次方"},{"key":"B","text":"n 乘以 a 乘以 b"},{"key":"C","text":"只有 a 的 n 次方和 b 的 n 次方两项"},{"key":"D","text":"C(n,k) 乘以 a 的 (n−k) 次方再乘以 b 的 k 次方"}],"answer":"D","explanation":"每一项都带一个组合数，a、b 的指数之和是 n。","verify":"\"C(n,k) 乘以 a 的 (n−k) 次方再乘以 b 的 k 次方\""},{"id":"cnm_h240_q4","topicId":"cnm_h240","difficulty":"standard","type":"numeric","prompt":"(a+b)^2 展开后，ab 的系数是多少？","answer":"2","explanation":"(a+b)^2=a²+2ab+b²，ab 的系数是 2。","verify":"comb(2,1)"},{"id":"cnm_h241_q1","topicId":"cnm_h241","difficulty":"basic","type":"numeric","prompt":"(a+b)^5 按 a 的降幂排列，第 3 项的二项式系数是多少？","answer":"10","explanation":"第 3 项对应 k=2，C(5,2)=10。","verify":"comb(5,2)"},{"id":"cnm_h241_q2","topicId":"cnm_h241","difficulty":"basic","type":"numeric","prompt":"(2x+1)^4 的展开式中，x² 的系数是多少？","answer":"24","explanation":"x 的指数为 2 时，(2x) 的指数是 2，k=2。C(4,2)×2²=6×4=24。","verify":"comb(4,2)*2**2"},{"id":"cnm_h241_q3","topicId":"cnm_h241","difficulty":"standard","type":"numeric","prompt":"(x+1)^6 的展开式中，常数项是多少？","answer":"1","explanation":"常数项不含 x，即 x 的指数为 0，系数 C(6,6)=1。","verify":"comb(6,6)"},{"id":"cnm_h241_q4","topicId":"cnm_h241","difficulty":"standard","type":"choice","prompt":"通项 T_(k+1) 里，a 和 b 的指数有什么关系？","choices":[{"key":"A","text":"两个指数都等于 k"},{"key":"B","text":"两个指数相加等于 n"},{"key":"C","text":"两个指数相乘等于 n"},{"key":"D","text":"两个指数相加等于 k"}],"answer":"B","explanation":"a 的指数是 n−k，b 的指数是 k，和为 n。","verify":"\"两个指数相加等于 n\""},{"id":"cnm_h242_q1","topicId":"cnm_h242","difficulty":"basic","type":"numeric","prompt":"(a+b)^4 的全部二项式系数之和是多少？","answer":"16","explanation":"令 a=b=1，左边是 2^4=16。","verify":"2**4"},{"id":"cnm_h242_q2","topicId":"cnm_h242","difficulty":"basic","type":"numeric","prompt":"(a+b)^6 的全部二项式系数之和是多少？","answer":"64","explanation":"2^6=64。","verify":"2**6"},{"id":"cnm_h242_q3","topicId":"cnm_h242","difficulty":"standard","type":"choice","prompt":"把 (1+1)^n 展开，左边等于什么？","choices":[{"key":"A","text":"n 的阶乘"},{"key":"B","text":"2 的 n 次方"},{"key":"C","text":"n"},{"key":"D","text":"0"}],"answer":"B","explanation":"(1+1)^n=2^n，右边正好是全部二项式系数的和。","verify":"\"2 的 n 次方\""},{"id":"cnm_h242_q4","topicId":"cnm_h242","difficulty":"standard","type":"numeric","prompt":"C(4,0)+C(4,1)+C(4,2)+C(4,3)+C(4,4) 等于多少？","answer":"16","explanation":"这是 (a+b)^4 的系数和，等于 16。","verify":"sum(comb(4,k) for k in range(5))"}]
