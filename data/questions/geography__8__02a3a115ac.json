[{"id":"cng_j047_q1","topicId":"cng_j047","difficulty":"basic","type":"choice","prompt":"北方地区主要位于？","choices":[{"key":"A","text":"秦岭—淮河以北的东部季风区"},{"key":"B","text":"青藏高原内部"},{"key":"C","text":"华南沿海的全部岛屿"},{"key":"D","text":"西北沙漠腹地"}],"answer":"A","explanation":"包括东北、华北和黄土高原等。","verify":"\"秦岭—淮河以北的东部季风区\""},{"id":"cng_j047_q2","topicId":"cng_j047","difficulty":"basic","type":"choice","prompt":"北方地区的耕地以什么为主？","choices":[{"key":"A","text":"水田"},{"key":"B","text":"旱地"},{"key":"C","text":"高寒牧场"},{"key":"D","text":"无法耕作的石山"}],"answer":"B","explanation":"降水较少，耕地多为旱地，主要种植小麦、玉米等。","verify":"\"旱地\""},{"id":"cng_j047_q3","topicId":"cng_j047","difficulty":"standard","type":"choice","prompt":"华北平原春旱较严重，主要因为？","choices":[{"key":"A","text":"夏季完全没有雨"},{"key":"B","text":"冬季气温过高"},{"key":"C","text":"春季降水少、升温快、蒸发旺，又正值作物需水期"},{"key":"D","text":"没有河流和地下水"}],"answer":"C","explanation":"春旱是华北农业的重要限制因素。","verify":"\"春季降水少、升温快、蒸发旺，又正值作物需水期\""},{"id":"cng_j047_q4","topicId":"cng_j047","difficulty":"challenge","type":"choice","prompt":"东北平原可以大规模机械化耕作，有利条件是？","choices":[{"key":"A","text":"地块极其破碎"},{"key":"B","text":"全部是陡坡梯田"},{"key":"C","text":"劳动力比土地还密集且无法使用机器"},{"key":"D","text":"地势平坦、耕地连片、人均耕地多"}],"answer":"D","explanation":"平原开阔，适合大型农机作业。","verify":"\"地势平坦、耕地连片、人均耕地多\""},{"id":"cng_j048_q1","topicId":"cng_j048","difficulty":"basic","type":"choice","prompt":"东北三省是指？","choices":[{"key":"A","text":"河北、山西、山东"},{"key":"B","text":"黑龙江、吉林、辽宁"},{"key":"C","text":"江苏、浙江、上海"},{"key":"D","text":"新疆、西藏、青海"}],"answer":"B","explanation":"三省合称东北三省，白山黑水是其代称。","verify":"\"黑龙江、吉林、辽宁\""},{"id":"cng_j048_q2","topicId":"cng_j048","difficulty":"basic","type":"choice","prompt":"东北平原土壤肥沃，典型土壤是？","choices":[{"key":"A","text":"红壤"},{"key":"B","text":"荒漠土"},{"key":"C","text":"黑土"},{"key":"D","text":"水稻土遍布所有山地"}],"answer":"C","explanation":"冷湿环境下形成的黑土有机质含量高。","verify":"\"黑土\""},{"id":"cng_j048_q3","topicId":"cng_j048","difficulty":"standard","type":"choice","prompt":"传统上，辽中南工业基地依赖的资源主要是？","choices":[{"key":"A","text":"热带经济作物"},{"key":"B","text":"海洋渔业以外没有任何资源"},{"key":"C","text":"高寒草场"},{"key":"D","text":"煤、铁等矿产资源"}],"answer":"D","explanation":"鞍山、抚顺等地煤铁资源促进了重工业发展。","verify":"\"煤、铁等矿产资源\""},{"id":"cng_j048_q4","topicId":"cng_j048","difficulty":"challenge","type":"choice","prompt":"过度开垦和黑土流失会使东北商品粮基地？","choices":[{"key":"A","text":"土壤肥力下降，需要保护性耕作"},{"key":"B","text":"黑土自动增厚"},{"key":"C","text":"气候变成热带雨林"},{"key":"D","text":"与生态保护无关"}],"answer":"A","explanation":"黑土退化是东北农业可持续发展的突出问题。","verify":"\"土壤肥力下降，需要保护性耕作\""},{"id":"cng_j049_q1","topicId":"cng_j049","difficulty":"basic","type":"choice","prompt":"黄土高原是世界上最大的黄土堆积区，主要位于？","choices":[{"key":"A","text":"长江入海口"},{"key":"B","text":"珠江三角洲"},{"key":"C","text":"黄河中游"},{"key":"D","text":"塔里木盆地"}],"answer":"C","explanation":"山西、陕西、宁夏、甘肃等省区的大部分属于黄土高原。","verify":"\"黄河中游\""},{"id":"cng_j049_q2","topicId":"cng_j049","difficulty":"basic","type":"choice","prompt":"黄土高原千沟万壑的地表，主要是因为？","choices":[{"key":"A","text":"全年没有降水"},{"key":"B","text":"冰川覆盖全部地表"},{"key":"C","text":"海水长期浸泡"},{"key":"D","text":"水土流失严重"}],"answer":"D","explanation":"土质疏松、夏季暴雨、植被破坏导致沟谷发育。","verify":"\"水土流失严重\""},{"id":"cng_j049_q3","topicId":"cng_j049","difficulty":"standard","type":"choice","prompt":"治理黄土高原水土流失的生物措施是？","choices":[{"key":"A","text":"植树种草"},{"key":"B","text":"把所有坡地改成陡坡耕种"},{"key":"C","text":"砍伐全部植被"},{"key":"D","text":"填平黄河"}],"answer":"A","explanation":"恢复植被可以保持水土；工程措施还有修梯田、打坝淤地等。","verify":"\"植树种草\""},{"id":"cng_j049_q4","topicId":"cng_j049","difficulty":"challenge","type":"choice","prompt":"黄土土质疏松、直立性强，传统民居是？","choices":[{"key":"A","text":"吊脚楼"},{"key":"B","text":"窑洞"},{"key":"C","text":"冰屋"},{"key":"D","text":"竹楼"}],"answer":"B","explanation":"黄土便于开挖窑洞，冬暖夏凉。","verify":"\"窑洞\""},{"id":"cng_j050_q1","topicId":"cng_j050","difficulty":"basic","type":"choice","prompt":"北京是我国的？","choices":[{"key":"A","text":"最大的海港城市"},{"key":"B","text":"位于南海的经济特区"},{"key":"C","text":"西北的石油基地"},{"key":"D","text":"首都，也是政治、文化中心和国际交往中心"}],"answer":"D","explanation":"北京是中华人民共和国的首都。","verify":"\"首都，也是政治、文化中心和国际交往中心\""},{"id":"cng_j050_q2","topicId":"cng_j050","difficulty":"basic","type":"choice","prompt":"北京的地势特点是？","choices":[{"key":"A","text":"西北高、东南低"},{"key":"B","text":"东南高、西北低"},{"key":"C","text":"完全平坦且四周是海"},{"key":"D","text":"中部是世界最高峰"}],"answer":"A","explanation":"西面是西山，北面是军都山，东南是平原。","verify":"\"西北高、东南低\""},{"id":"cng_j050_q3","topicId":"cng_j050","difficulty":"standard","type":"choice","prompt":"为减轻交通和环境压力，北京在城市建设中注重？","choices":[{"key":"A","text":"无限扩大高耗能工业"},{"key":"B","text":"发展公共交通、保护历史文化名城、疏解非首都功能"},{"key":"C","text":"拆除全部文物"},{"key":"D","text":"填平所有绿地"}],"answer":"B","explanation":"北京既要保障首都功能，也要治理“大城市病”。","verify":"\"发展公共交通、保护历史文化名城、疏解非首都功能\""},{"id":"cng_j050_q4","topicId":"cng_j050","difficulty":"challenge","type":"choice","prompt":"北京的水资源紧张，可行的措施包括？","choices":[{"key":"A","text":"鼓励浪费用水"},{"key":"B","text":"把密云水库排空"},{"key":"C","text":"节约用水、污水回用，并接受南水北调供水"},{"key":"D","text":"停止所有绿化"}],"answer":"C","explanation":"开源节流并重，是缺水城市的共同选择。","verify":"\"节约用水、污水回用，并接受南水北调供水\""}]
