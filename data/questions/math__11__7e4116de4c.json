[{"id":"cnm_h079_q1","topicId":"cnm_h079","difficulty":"basic","type":"choice","prompt":"向量和数量的差别是？","choices":[{"key":"A","text":"向量有方向，数量没有方向"},{"key":"B","text":"向量没有大小"},{"key":"C","text":"数量必须带方向"},{"key":"D","text":"两者完全相同"}],"answer":"A","explanation":"向量用有向线段表示，大小是模，另外还要方向。","verify":"\"向量有方向，数量没有方向\""},{"id":"cnm_h079_q2","topicId":"cnm_h079","difficulty":"basic","type":"numeric","prompt":"一个向量的模是 5。它的长度是多少？","answer":"5","explanation":"模就是向量的长度，这里是 5。","verify":"5"},{"id":"cnm_h079_q3","topicId":"cnm_h079","difficulty":"standard","type":"choice","prompt":"零向量的模是？","choices":[{"key":"A","text":"1"},{"key":"B","text":"不能确定"},{"key":"C","text":"0"},{"key":"D","text":"等于单位向量"}],"answer":"C","explanation":"零向量的长度是 0。它的方向不定，不拿来和别的向量比方向。","verify":"\"0\""},{"id":"cnm_h079_q4","topicId":"cnm_h079","difficulty":"standard","type":"choice","prompt":"有向线段表示向量时，必须指出？","choices":[{"key":"A","text":"只写长度"},{"key":"B","text":"只写起点"},{"key":"C","text":"只写所在直线"},{"key":"D","text":"起点、终点和方向"}],"answer":"D","explanation":"没有方向就只剩下长度，不再是确定的向量。","verify":"\"起点、终点和方向\""},{"id":"cnm_h080_q1","topicId":"cnm_h080","difficulty":"basic","type":"choice","prompt":"两个向量相等，是指？","choices":[{"key":"A","text":"只要模相等"},{"key":"B","text":"模相等并且方向相同"},{"key":"C","text":"只要方向相同"},{"key":"D","text":"起点必须相同"}],"answer":"B","explanation":"相等与起点无关。平行移动后仍然可以相等。","verify":"\"模相等并且方向相同\""},{"id":"cnm_h080_q2","topicId":"cnm_h080","difficulty":"basic","type":"choice","prompt":"方向相反、模相等的两个向量？","choices":[{"key":"A","text":"相等"},{"key":"B","text":"既不相等也不共线"},{"key":"C","text":"共线但不相等"},{"key":"D","text":"一定是零向量"}],"answer":"C","explanation":"共线包括同向和反向。反向就不相等。","verify":"\"共线但不相等\""},{"id":"cnm_h080_q3","topicId":"cnm_h080","difficulty":"standard","type":"numeric","prompt":"向量 a 的模是 4，与 a 相等的向量模是多少？","answer":"4","explanation":"相等向量的模必须相同。","verify":"4"},{"id":"cnm_h080_q4","topicId":"cnm_h080","difficulty":"standard","type":"choice","prompt":"单位向量是指？","choices":[{"key":"A","text":"模为 1 的向量"},{"key":"B","text":"模为 0 的向量"},{"key":"C","text":"与坐标轴平行的向量"},{"key":"D","text":"任意非零向量"}],"answer":"A","explanation":"单位向量只限制长度为 1，方向可以不同。","verify":"\"模为 1 的向量\""}]
