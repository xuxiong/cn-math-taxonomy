[{"id":"cnc_p013_q1","topicId":"cnc_p013","difficulty":"basic","type":"choice","prompt":"「哥」的声母是哪一个？","choices":[{"key":"A","text":"声母 k（科）"},{"key":"B","text":"声母 h（喝）"},{"key":"C","text":"声母 g（哥）"},{"key":"D","text":"声母 d（得）"}],"answer":"C","explanation":"哥是 gē，声母是不送气的 g。科才是送气的 k。","verify":"\"声母 g（哥）\""},{"id":"cnc_p013_q2","topicId":"cnc_p013","difficulty":"basic","type":"choice","prompt":"「科」的声母是哪一个？","choices":[{"key":"A","text":"声母 g（哥）"},{"key":"B","text":"声母 h（喝）"},{"key":"C","text":"声母 b（玻）"},{"key":"D","text":"声母 k（科）"}],"answer":"D","explanation":"科是 kē，声母是送气的 k。哥的声母才是 g。","verify":"\"声母 k（科）\""},{"id":"cnc_p013_q3","topicId":"cnc_p013","difficulty":"standard","type":"choice","prompt":"「河」的声母是哪一个？","choices":[{"key":"A","text":"声母 h（喝）"},{"key":"B","text":"声母 g（哥）"},{"key":"C","text":"声母 k（科）"},{"key":"D","text":"声母 f（佛）"}],"answer":"A","explanation":"河是 hé，声母是 h。g 和 k 都不是这个音。","verify":"\"声母 h（喝）\""},{"id":"cnc_p013_q4","topicId":"cnc_p013","difficulty":"standard","type":"choice","prompt":"「瓜」的声母是哪一个？","choices":[{"key":"A","text":"声母 k（科）"},{"key":"B","text":"声母 g（哥）"},{"key":"C","text":"声母 h（喝）"},{"key":"D","text":"声母 p（坡）"}],"answer":"B","explanation":"瓜是 guā，声母是 g。夸才是 kuā，声母是 k。","verify":"\"声母 g（哥）\""},{"id":"cnc_p014_q1","topicId":"cnc_p014","difficulty":"basic","type":"choice","prompt":"「鸡」的声母是哪一个？","choices":[{"key":"A","text":"声母 q（欺）"},{"key":"B","text":"声母 x（希）"},{"key":"C","text":"声母 g（哥）"},{"key":"D","text":"声母 j（基）"}],"answer":"D","explanation":"鸡是 jī，声母是 j。七的声母才是 q。","verify":"\"声母 j（基）\""},{"id":"cnc_p014_q2","topicId":"cnc_p014","difficulty":"basic","type":"choice","prompt":"「七」的声母是哪一个？","choices":[{"key":"A","text":"声母 q（欺）"},{"key":"B","text":"声母 j（基）"},{"key":"C","text":"声母 x（希）"},{"key":"D","text":"声母 c（雌）"}],"answer":"A","explanation":"七是 qī，声母是 q。鸡的声母是 j，西的声母是 x。","verify":"\"声母 q（欺）\""},{"id":"cnc_p014_q3","topicId":"cnc_p014","difficulty":"standard","type":"choice","prompt":"「西」的声母是哪一个？","choices":[{"key":"A","text":"平舌声母 s"},{"key":"B","text":"声母 x（希）"},{"key":"C","text":"翘舌声母 sh"},{"key":"D","text":"声母 j（基）"}],"answer":"B","explanation":"西是 xī，声母是 x。读成 s 会像「私」，读成 sh 会像「师」。","verify":"\"声母 x（希）\""},{"id":"cnc_p014_q4","topicId":"cnc_p014","difficulty":"standard","type":"choice","prompt":"「下」的声母是哪一个？","choices":[{"key":"A","text":"声母 q（欺）"},{"key":"B","text":"声母 j（基）"},{"key":"C","text":"声母 x（希）"},{"key":"D","text":"平舌声母 s"}],"answer":"C","explanation":"下是 xià，声母是 x。请是 q，家是 j，撒才是 s。","verify":"\"声母 x（希）\""},{"id":"cnc_p015_q1","topicId":"cnc_p015","difficulty":"basic","type":"choice","prompt":"「字」的声母是哪一个？","choices":[{"key":"A","text":"平舌声母 z"},{"key":"B","text":"翘舌声母 zh"},{"key":"C","text":"平舌声母 c"},{"key":"D","text":"平舌声母 s"}],"answer":"A","explanation":"字是平舌音 zì。翘舌音 zh 会读成「知」一类。","verify":"\"平舌声母 z\""},{"id":"cnc_p015_q2","topicId":"cnc_p015","difficulty":"basic","type":"choice","prompt":"「草」的声母是哪一个？","choices":[{"key":"A","text":"翘舌声母 ch"},{"key":"B","text":"平舌声母 c"},{"key":"C","text":"平舌声母 z"},{"key":"D","text":"平舌声母 s"}],"answer":"B","explanation":"草是平舌音 cǎo。读成翘舌音 ch，就不对了。","verify":"\"平舌声母 c\""},{"id":"cnc_p015_q3","topicId":"cnc_p015","difficulty":"standard","type":"choice","prompt":"「四」的声母是哪一个？","choices":[{"key":"A","text":"翘舌声母 sh"},{"key":"B","text":"平舌声母 z"},{"key":"C","text":"平舌声母 s"},{"key":"D","text":"平舌声母 c"}],"answer":"C","explanation":"四是平舌音 sì。十才是翘舌音 shí。","verify":"\"平舌声母 s\""},{"id":"cnc_p015_q4","topicId":"cnc_p015","difficulty":"standard","type":"choice","prompt":"读 z、c、s 时，舌头应当怎样？","choices":[{"key":"A","text":"向上翘起"},{"key":"B","text":"完全不用舌头"},{"key":"C","text":"堵在鼻子里"},{"key":"D","text":"放平"}],"answer":"D","explanation":"z、c、s 是平舌音，舌尖放平。翘起来的是 zh、ch、sh。","verify":"\"放平\""},{"id":"cnc_p016_q1","topicId":"cnc_p016","difficulty":"basic","type":"choice","prompt":"「中国」的「中」，声母是哪一个？","choices":[{"key":"A","text":"平舌声母 z"},{"key":"B","text":"翘舌声母 zh"},{"key":"C","text":"翘舌声母 ch"},{"key":"D","text":"翘舌声母 sh"}],"answer":"B","explanation":"中的声母是翘舌音 zh。平舌音 z 舌头放平，ch 和 sh 也不是 zh。","verify":"\"翘舌声母 zh\""},{"id":"cnc_p016_q2","topicId":"cnc_p016","difficulty":"basic","type":"choice","prompt":"「书」的声母是哪一个？","choices":[{"key":"A","text":"平舌声母 s"},{"key":"B","text":"翘舌声母 zh"},{"key":"C","text":"翘舌声母 sh"},{"key":"D","text":"翘舌声母 ch"}],"answer":"C","explanation":"书是翘舌音 sh。读成平舌音 s，就会像「苏」。","verify":"\"翘舌声母 sh\""},{"id":"cnc_p016_q3","topicId":"cnc_p016","difficulty":"standard","type":"choice","prompt":"「吃」的声母是哪一个？","choices":[{"key":"A","text":"平舌声母 c"},{"key":"B","text":"翘舌声母 zh"},{"key":"C","text":"翘舌声母 sh"},{"key":"D","text":"翘舌声母 ch"}],"answer":"D","explanation":"吃的声母是翘舌音 ch。平舌音 c、翘舌音 zh 和 sh 都不是这个音。","verify":"\"翘舌声母 ch\""},{"id":"cnc_p016_q4","topicId":"cnc_p016","difficulty":"standard","type":"choice","prompt":"下面哪个是整体认读音节，不用再拼？","choices":[{"key":"A","text":"整体认读音节 zhī"},{"key":"B","text":"声母 zh"},{"key":"C","text":"拼读音节 mā"},{"key":"D","text":"拼读音节 bā"}],"answer":"A","explanation":"zhī 看到就整读。声母 zh 还要再拼，mā 和 bā 也要把声母和韵母拼出来。","verify":"\"整体认读音节 zhī\""},{"id":"cnc_p017_q1","topicId":"cnc_p017","difficulty":"basic","type":"choice","prompt":"「鸭」的声母是哪一个？","choices":[{"key":"A","text":"声母 w（乌）"},{"key":"B","text":"声母 n（讷）"},{"key":"C","text":"声母 y（衣）"},{"key":"D","text":"声母 l（勒）"}],"answer":"C","explanation":"鸭是 yā，声母是 y。蛙才是 wā。","verify":"\"声母 y（衣）\""},{"id":"cnc_p017_q2","topicId":"cnc_p017","difficulty":"basic","type":"choice","prompt":"「蛙」的声母是哪一个？","choices":[{"key":"A","text":"声母 y（衣）"},{"key":"B","text":"声母 f（佛）"},{"key":"C","text":"声母 h（喝）"},{"key":"D","text":"声母 w（乌）"}],"answer":"D","explanation":"蛙是 wā，声母是 w。鸭的声母才是 y。","verify":"\"声母 w（乌）\""},{"id":"cnc_p017_q3","topicId":"cnc_p017","difficulty":"standard","type":"choice","prompt":"「衣」写成哪一个，而且不用再拼？","choices":[{"key":"A","text":"整体认读音节 yī"},{"key":"B","text":"单韵母 i 再拼一次"},{"key":"C","text":"拼读音节 yá"},{"key":"D","text":"声母 w"}],"answer":"A","explanation":"衣是整体认读 yī，看到就整读。yá 是第二声，不是衣。","verify":"\"整体认读音节 yī\""},{"id":"cnc_p017_q4","topicId":"cnc_p017","difficulty":"standard","type":"choice","prompt":"「鱼」写成 yu 时，里面的 u 怎样读？","choices":[{"key":"A","text":"改读成乌的 u"},{"key":"B","text":"两点去掉，仍读 ü"},{"key":"C","text":"改读成 i"},{"key":"D","text":"改读成 e"}],"answer":"B","explanation":"yú 是鱼。yu、yue、yun 里写的 u，实际读 ü。","verify":"\"两点去掉，仍读 ü\""},{"id":"cnc_p018_q1","topicId":"cnc_p018","difficulty":"basic","type":"choice","prompt":"下面哪个看到就整读，不用再拼？","choices":[{"key":"A","text":"拼读音节 bā（八）"},{"key":"B","text":"拼读音节 mā（妈）"},{"key":"C","text":"拼读音节 dà（大）"},{"key":"D","text":"整体认读音节 yī（衣）"}],"answer":"D","explanation":"yī 是整体认读。bā、mā、dà 都要把声母和韵母拼出来。","verify":"\"整体认读音节 yī（衣）\""},{"id":"cnc_p018_q2","topicId":"cnc_p018","difficulty":"basic","type":"choice","prompt":"「四」的音节 sì 应当怎样读？","choices":[{"key":"A","text":"整体认读，不用再拼"},{"key":"B","text":"先读 s 再拼上 i"},{"key":"C","text":"读成翘舌音 shì"},{"key":"D","text":"只读声母 s 就停住"}],"answer":"A","explanation":"sì 是整体认读音节。十才是翘舌音 shí。","verify":"\"整体认读，不用再拼\""},{"id":"cnc_p018_q3","topicId":"cnc_p018","difficulty":"standard","type":"choice","prompt":"「日」的音节 rì 是哪一种？","choices":[{"key":"A","text":"声母 r 再拼 i"},{"key":"B","text":"整体认读音节 ri"},{"key":"C","text":"整体认读音节 yi"},{"key":"D","text":"拼读音节 bá"}],"answer":"B","explanation":"日是整体认读 rì。衣才是 yī，八才是 bā。","verify":"\"整体认读音节 ri\""},{"id":"cnc_p018_q4","topicId":"cnc_p018","difficulty":"standard","type":"choice","prompt":"下面哪个必须把声母和韵母拼起来读？","choices":[{"key":"A","text":"整体认读音节 yī（衣）"},{"key":"B","text":"整体认读音节 wū（乌）"},{"key":"C","text":"拼读音节 bā（八）"},{"key":"D","text":"整体认读音节 sī（丝）"}],"answer":"C","explanation":"八要拼。衣、乌、丝都是整体认读，看到就整读。","verify":"\"拼读音节 bā（八）\""}]
