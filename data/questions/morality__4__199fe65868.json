[{"id":"cnd_p096_q1","topicId":"cnd_p096","difficulty":"basic","type":"choice","prompt":"信息社会给生活带来的便利有？","choices":[{"key":"A","text":"信息社会没有任何好处"},{"key":"B","text":"查资料、通信、购物更方便"},{"key":"C","text":"可以完全不学习"},{"key":"D","text":"可以无视所有规则"}],"answer":"B","explanation":"信息社会带来便利也需正确使用。","verify":"\"查资料、通信、购物更方便\""},{"id":"cnd_p096_q2","topicId":"cnd_p096","difficulty":"basic","type":"choice","prompt":"使用电子设备时应注意？","choices":[{"key":"A","text":"通宵使用"},{"key":"B","text":"走路过马路时盯着屏幕"},{"key":"C","text":"控制时长，保护视力和作息"},{"key":"D","text":"吃饭时长时间连续看"}],"answer":"C","explanation":"合理使用电子设备。","verify":"\"控制时长，保护视力和作息\""},{"id":"cnd_p096_q3","topicId":"cnd_p096","difficulty":"standard","type":"choice","prompt":"网上看到不实信息，应？","choices":[{"key":"A","text":"立刻转发给所有人"},{"key":"B","text":"按信息去危险地点"},{"key":"C","text":"嘲笑相信科学的人"},{"key":"D","text":"不盲目转发，告诉家长或老师"}],"answer":"D","explanation":"不传播谣言。","verify":"\"不盲目转发，告诉家长或老师\""},{"id":"cnd_p096_q4","topicId":"cnd_p096","difficulty":"challenge","type":"choice","prompt":"“别让它抢走太多”提醒我们？","choices":[{"key":"A","text":"电子设备不能占用全部时间"},{"key":"B","text":"电子产品完全不能碰"},{"key":"C","text":"越玩越好"},{"key":"D","text":"学习可以全部放弃"}],"answer":"A","explanation":"合理分配时间。","verify":"\"电子设备不能占用全部时间\""},{"id":"cnd_p097_q1","topicId":"cnd_p097","difficulty":"basic","type":"choice","prompt":"学习「别让它抢走太多」一课，最重要的是？","choices":[{"key":"A","text":"只背诵标题应付提问"},{"key":"B","text":"听过就算与己无关"},{"key":"C","text":"把正确的做法落实到日常生活中"},{"key":"D","text":"专门跟正确做法对着干"}],"answer":"C","explanation":"道德与法治课重在践行。","verify":"\"把正确的做法落实到日常生活中\""},{"id":"cnd_p097_q2","topicId":"cnd_p097","difficulty":"basic","type":"choice","prompt":"遇到本课相关情境，应优先选择？","choices":[{"key":"A","text":"图省事就违规"},{"key":"B","text":"伤害他人成全自己"},{"key":"C","text":"隐瞒错误逃避责任"},{"key":"D","text":"安全、文明、友善且守规则的做法"}],"answer":"D","explanation":"安全文明守规则。","verify":"\"安全、文明、友善且守规则的做法\""},{"id":"cnd_p097_q3","topicId":"cnd_p097","difficulty":"standard","type":"choice","prompt":"本课所属主题更接近？","choices":[{"key":"A","text":"生活与安全"},{"key":"B","text":"完全无关的娱乐八卦"},{"key":"C","text":"与学习生活无关的事"},{"key":"D","text":"鼓励违法的行为"}],"answer":"A","explanation":"本课围绕「生活与安全」展开。","verify":"\"生活与安全\""},{"id":"cnd_p097_q4","topicId":"cnd_p097","difficulty":"challenge","type":"choice","prompt":"学完本课后，较好的行动是？","choices":[{"key":"A","text":"一切照旧不愿改变"},{"key":"B","text":"对照自己改掉不良习惯，坚持正确行为"},{"key":"C","text":"只要求别人做自己不做"},{"key":"D","text":"把课本丢在一边再也不看"}],"answer":"B","explanation":"学了就要用。","verify":"\"对照自己改掉不良习惯，坚持正确行为\""},{"id":"cnd_p098_q1","topicId":"cnd_p098","difficulty":"basic","type":"choice","prompt":"生命为什么最宝贵？","choices":[{"key":"A","text":"生命可以随便浪费"},{"key":"B","text":"别人的生命不重要"},{"key":"C","text":"只有成绩比生命重要"},{"key":"D","text":"生命只有一次，是做好一切事情的前提"}],"answer":"D","explanation":"要珍爱生命。","verify":"\"生命只有一次，是做好一切事情的前提\""},{"id":"cnd_p098_q2","topicId":"cnd_p098","difficulty":"basic","type":"choice","prompt":"有人诱骗你去偏僻处，应？","choices":[{"key":"A","text":"拒绝，尽快离开并告诉信任的大人"},{"key":"B","text":"跟着去看看"},{"key":"C","text":"把家庭情况详细告诉对方"},{"key":"D","text":"独自赴约不告知家人"}],"answer":"A","explanation":"自我保护，远离危险。","verify":"\"拒绝，尽快离开并告诉信任的大人\""},{"id":"cnd_p098_q3","topicId":"cnd_p098","difficulty":"standard","type":"choice","prompt":"发生火灾初起且可逃生时，应？","choices":[{"key":"A","text":"坐电梯下楼"},{"key":"B","text":"用湿毛巾捂口鼻，低姿迅速撤离并报警"},{"key":"C","text":"躲进柜子不出来也不呼救"},{"key":"D","text":"返回火场拿玩具"}],"answer":"B","explanation":"火场逃生有正确方法。","verify":"\"用湿毛巾捂口鼻，低姿迅速撤离并报警\""},{"id":"cnd_p098_q4","topicId":"cnd_p098","difficulty":"challenge","type":"choice","prompt":"网络安全方面，不应做的是？","choices":[{"key":"A","text":"不随意添加陌生好友"},{"key":"B","text":"上网时间适度"},{"key":"C","text":"把家庭住址、密码发给网友"},{"key":"D","text":"遇到欺凌告知家长老师"}],"answer":"C","explanation":"保护个人信息不随意泄露。","verify":"\"把家庭住址、密码发给网友\""}]
