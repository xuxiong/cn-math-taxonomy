[{"id":"cne_p020_q1","topicId":"cne_p020","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「面包」？","choices":[{"key":"A","text":"egg"},{"key":"B","text":"bread"},{"key":"C","text":"rice"},{"key":"D","text":"milk"}],"answer":"B","explanation":"bread 的意思是面包。","verify":"\"bread\""},{"id":"cne_p020_q2","topicId":"cne_p020","difficulty":"basic","type":"choice","prompt":"「egg」的中文意思是哪一个？","choices":[{"key":"A","text":"面包"},{"key":"B","text":"米饭"},{"key":"C","text":"鸡蛋"},{"key":"D","text":"牛奶"}],"answer":"C","explanation":"egg 的意思是鸡蛋。","verify":"\"鸡蛋\""},{"id":"cne_p020_q3","topicId":"cne_p020","difficulty":"standard","type":"choice","prompt":"选择表示「米饭」的单词。","choices":[{"key":"A","text":"bread"},{"key":"B","text":"egg"},{"key":"C","text":"milk"},{"key":"D","text":"rice"}],"answer":"D","explanation":"表示米饭的单词是 rice。","verify":"\"rice\""},{"id":"cne_p020_q4","topicId":"cne_p020","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「牛奶」？","choices":[{"key":"A","text":"milk"},{"key":"B","text":"bread"},{"key":"C","text":"egg"},{"key":"D","text":"rice"}],"answer":"A","explanation":"milk 的意思是牛奶。","verify":"\"milk\""},{"id":"cne_p022_q1","topicId":"cne_p022","difficulty":"basic","type":"choice","prompt":"想说自己喜欢鸡蛋，应说哪一句？","choices":[{"key":"A","text":"I like milk."},{"key":"B","text":"I like rice."},{"key":"C","text":"I like bread."},{"key":"D","text":"I like eggs."}],"answer":"D","explanation":"鸡蛋是 egg，复数是 eggs。","verify":"\"I like eggs.\""},{"id":"cne_p022_q2","topicId":"cne_p022","difficulty":"basic","type":"choice","prompt":"Have some bread. 这句是在说什么？","choices":[{"key":"A","text":"吃些面包吧"},{"key":"B","text":"吃些米饭吧"},{"key":"C","text":"喝些牛奶吧"},{"key":"D","text":"吃些鸡蛋吧"}],"answer":"A","explanation":"bread 是面包。","verify":"\"吃些面包吧\""},{"id":"cne_p022_q3","topicId":"cne_p022","difficulty":"standard","type":"choice","prompt":"Can I have some milk? 这句是在问什么？","choices":[{"key":"A","text":"我可以吃些面包吗"},{"key":"B","text":"我可以喝些牛奶吗"},{"key":"C","text":"牛奶在哪里"},{"key":"D","text":"你喜欢牛奶吗"}],"answer":"B","explanation":"have some milk 是要一些牛奶。","verify":"\"我可以喝些牛奶吗\""},{"id":"cne_p022_q4","topicId":"cne_p022","difficulty":"standard","type":"choice","prompt":"哪一句表示「我喜欢米饭」？","choices":[{"key":"A","text":"I like bread."},{"key":"B","text":"I like eggs."},{"key":"C","text":"I like rice."},{"key":"D","text":"I like milk."}],"answer":"C","explanation":"米饭是 rice。","verify":"\"I like rice.\""},{"id":"cne_p023_q1","topicId":"cne_p023","difficulty":"basic","type":"choice","prompt":"读一读：Sarah says, \"I like bananas.\" Sarah 喜欢什么？","choices":[{"key":"A","text":"香蕉"},{"key":"B","text":"苹果"},{"key":"C","text":"面包"},{"key":"D","text":"米饭"}],"answer":"A","explanation":"引号里写的是 bananas。","verify":"\"香蕉\""},{"id":"cne_p023_q2","topicId":"cne_p023","difficulty":"basic","type":"choice","prompt":"读一读：Mike says, \"I like milk.\" 哪一句和短文一致？","choices":[{"key":"A","text":"Mike 喜欢米饭。"},{"key":"B","text":"Mike 喜欢牛奶。"},{"key":"C","text":"Mike 不喜欢牛奶。"},{"key":"D","text":"Sarah 喜欢牛奶。"}],"answer":"B","explanation":"说话的是 Mike，喜欢的是 milk。","verify":"\"Mike 喜欢牛奶。\""},{"id":"cne_p023_q3","topicId":"cne_p023","difficulty":"standard","type":"choice","prompt":"读一读：I like bread. I do not like eggs. 这个人不喜欢什么？","choices":[{"key":"A","text":"面包"},{"key":"B","text":"牛奶"},{"key":"C","text":"鸡蛋"},{"key":"D","text":"米饭"}],"answer":"C","explanation":"do not like eggs 是不喜欢鸡蛋。","verify":"\"鸡蛋\""},{"id":"cne_p023_q4","topicId":"cne_p023","difficulty":"standard","type":"choice","prompt":"读一读：Chen Jie says, \"I like rice.\" 哪一句是短文里的意思？","choices":[{"key":"A","text":"Chen Jie 喜欢面包。"},{"key":"B","text":"Chen Jie 喜欢牛奶。"},{"key":"C","text":"Chen Jie 不喜欢米饭。"},{"key":"D","text":"Chen Jie 喜欢米饭。"}],"answer":"D","explanation":"引号里是 I like rice。","verify":"\"Chen Jie 喜欢米饭。\""},{"id":"cne_p048_q1","topicId":"cne_p048","difficulty":"basic","type":"choice","prompt":"哪个单词含有短元音 u？","choices":[{"key":"A","text":"use"},{"key":"B","text":"fun"},{"key":"C","text":"cute"},{"key":"D","text":"cake"}],"answer":"B","explanation":"fun 含有短元音 u。","verify":"\"fun\""},{"id":"cne_p048_q2","topicId":"cne_p048","difficulty":"basic","type":"choice","prompt":"哪个单词不含短元音 u？","choices":[{"key":"A","text":"fun"},{"key":"B","text":"run"},{"key":"C","text":"use"},{"key":"D","text":"cup"}],"answer":"C","explanation":"use 不含短元音 u。","verify":"\"use\""},{"id":"cne_p048_q3","topicId":"cne_p048","difficulty":"standard","type":"choice","prompt":"run 和哪个词的元音相同？","choices":[{"key":"A","text":"use"},{"key":"B","text":"cute"},{"key":"C","text":"cake"},{"key":"D","text":"cup"}],"answer":"D","explanation":"run 和 cup 都含有短元音 u。","verify":"\"cup\""},{"id":"cne_p048_q4","topicId":"cne_p048","difficulty":"standard","type":"choice","prompt":"选择含有短元音 u的单词。","choices":[{"key":"A","text":"sun"},{"key":"B","text":"cute"},{"key":"C","text":"cake"},{"key":"D","text":"he"}],"answer":"A","explanation":"sun 含有短元音 u。","verify":"\"sun\""},{"id":"cne_p071_q1","topicId":"cne_p071","difficulty":"basic","type":"choice","prompt":"哪个单词含有u-e 的读音？","choices":[{"key":"A","text":"use"},{"key":"B","text":"fun"},{"key":"C","text":"run"},{"key":"D","text":"cup"}],"answer":"A","explanation":"use 含有u-e 的读音。","verify":"\"use\""},{"id":"cne_p071_q2","topicId":"cne_p071","difficulty":"basic","type":"choice","prompt":"哪个单词不含u-e 的读音？","choices":[{"key":"A","text":"use"},{"key":"B","text":"fun"},{"key":"C","text":"cute"},{"key":"D","text":"tube"}],"answer":"B","explanation":"fun 不含u-e 的读音。","verify":"\"fun\""},{"id":"cne_p071_q3","topicId":"cne_p071","difficulty":"standard","type":"choice","prompt":"cute 和哪个词的元音相同？","choices":[{"key":"A","text":"fun"},{"key":"B","text":"run"},{"key":"C","text":"tube"},{"key":"D","text":"cup"}],"answer":"C","explanation":"cute 和 tube 都含有u-e 的读音。","verify":"\"tube\""},{"id":"cne_p071_q4","topicId":"cne_p071","difficulty":"standard","type":"choice","prompt":"选择含有u-e 的读音的单词。","choices":[{"key":"A","text":"run"},{"key":"B","text":"cup"},{"key":"C","text":"sun"},{"key":"D","text":"huge"}],"answer":"D","explanation":"huge 含有u-e 的读音。","verify":"\"huge\""},{"id":"cne_p077_q1","topicId":"cne_p077","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「牛肉」？","choices":[{"key":"A","text":"chicken"},{"key":"B","text":"noodles"},{"key":"C","text":"beef"},{"key":"D","text":"soup"}],"answer":"C","explanation":"beef 的意思是牛肉。","verify":"\"beef\""},{"id":"cne_p077_q2","topicId":"cne_p077","difficulty":"basic","type":"choice","prompt":"「chicken」的中文意思是哪一个？","choices":[{"key":"A","text":"牛肉"},{"key":"B","text":"面条"},{"key":"C","text":"汤"},{"key":"D","text":"鸡肉"}],"answer":"D","explanation":"chicken 的意思是鸡肉。","verify":"\"鸡肉\""},{"id":"cne_p077_q3","topicId":"cne_p077","difficulty":"standard","type":"choice","prompt":"选择表示「面条」的单词。","choices":[{"key":"A","text":"noodles"},{"key":"B","text":"beef"},{"key":"C","text":"chicken"},{"key":"D","text":"soup"}],"answer":"A","explanation":"表示面条的单词是 noodles。","verify":"\"noodles\""},{"id":"cne_p077_q4","topicId":"cne_p077","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「汤」？","choices":[{"key":"A","text":"beef"},{"key":"B","text":"soup"},{"key":"C","text":"chicken"},{"key":"D","text":"noodles"}],"answer":"B","explanation":"soup 的意思是汤。","verify":"\"soup\""},{"id":"cne_p078_q1","topicId":"cne_p078","difficulty":"basic","type":"choice","prompt":"想问对方要不要一些汤，应说哪一句？","choices":[{"key":"A","text":"Do you like some soup?"},{"key":"B","text":"Where is the soup?"},{"key":"C","text":"I like soup."},{"key":"D","text":"Would you like some soup?"}],"answer":"D","explanation":"邀请对方用 Would you like some。","verify":"\"Would you like some soup?\""},{"id":"cne_p078_q2","topicId":"cne_p078","difficulty":"basic","type":"choice","prompt":"Would you like some beef? 若想要，应回答哪一句？","choices":[{"key":"A","text":"Yes, please."},{"key":"B","text":"No, I do not."},{"key":"C","text":"Yes, I do."},{"key":"D","text":"Here you are."}],"answer":"A","explanation":"接受邀请常说 Yes, please。","verify":"\"Yes, please.\""},{"id":"cne_p078_q3","topicId":"cne_p078","difficulty":"standard","type":"choice","prompt":"What would you like? 若想吃面条，应说哪一句？","choices":[{"key":"A","text":"I would like some soup."},{"key":"B","text":"I would like some noodles."},{"key":"C","text":"I would like some beef."},{"key":"D","text":"I would like some chicken."}],"answer":"B","explanation":"面条是 noodles。","verify":"\"I would like some noodles.\""},{"id":"cne_p078_q4","topicId":"cne_p078","difficulty":"standard","type":"choice","prompt":"Help yourself. 这句是在说什么？","choices":[{"key":"A","text":"请坐下"},{"key":"B","text":"请开门"},{"key":"C","text":"请随便吃"},{"key":"D","text":"请看黑板"}],"answer":"C","explanation":"Help yourself 是请对方随便吃。","verify":"\"请随便吃\""},{"id":"cne_p079_q1","topicId":"cne_p079","difficulty":"basic","type":"choice","prompt":"读一读：Would you like some soup? Yes, please. 这个人想要汤吗？","choices":[{"key":"A","text":"想要"},{"key":"B","text":"不想要"},{"key":"C","text":"没说"},{"key":"D","text":"想要米饭"}],"answer":"A","explanation":"回答是 Yes, please。","verify":"\"想要\""},{"id":"cne_p079_q2","topicId":"cne_p079","difficulty":"basic","type":"choice","prompt":"读一读：I would like some noodles and beef. 想吃什么？","choices":[{"key":"A","text":"汤和鸡肉"},{"key":"B","text":"面条和牛肉"},{"key":"C","text":"只面条"},{"key":"D","text":"只牛肉"}],"answer":"B","explanation":"noodles and beef。","verify":"\"面条和牛肉\""},{"id":"cne_p079_q3","topicId":"cne_p079","difficulty":"standard","type":"choice","prompt":"读一读：Dinner is ready. Have some chicken. 哪一句和文字一致？","choices":[{"key":"A","text":"请喝些汤。"},{"key":"B","text":"晚饭还没好。"},{"key":"C","text":"请吃些鸡肉。"},{"key":"D","text":"请吃些面条。"}],"answer":"C","explanation":"Have some chicken。","verify":"\"请吃些鸡肉。\""},{"id":"cne_p079_q4","topicId":"cne_p079","difficulty":"standard","type":"choice","prompt":"读一读：Sarah says, \"I would like some soup.\" Sarah 想要什么？","choices":[{"key":"A","text":"牛肉"},{"key":"B","text":"鸡肉"},{"key":"C","text":"面条"},{"key":"D","text":"汤"}],"answer":"D","explanation":"引号里是 soup。","verify":"\"汤\""}]
