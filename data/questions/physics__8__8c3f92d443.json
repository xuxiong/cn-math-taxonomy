[{"id":"cnp_023_q1","topicId":"cnp_023","difficulty":"basic","type":"choice","prompt":"近视眼应该配戴什么透镜矫正？","choices":[{"key":"A","text":"凸透镜"},{"key":"B","text":"平面镜"},{"key":"C","text":"三棱镜"},{"key":"D","text":"凹透镜"}],"answer":"D","explanation":"近视眼晶状体太厚、折光能力太强，像成在视网膜前方，用发散的凹透镜矫正。","verify":"\"凹透镜\""},{"id":"cnp_023_q2","topicId":"cnp_023","difficulty":"basic","type":"choice","prompt":"物体在正常眼睛的视网膜上成什么像？","choices":[{"key":"A","text":"倒立、缩小的实像"},{"key":"B","text":"正立、缩小的实像"},{"key":"C","text":"倒立、放大的实像"},{"key":"D","text":"正立、放大的虚像"}],"answer":"A","explanation":"眼睛相当于照相机，在视网膜上成倒立、缩小的实像。","verify":"\"倒立、缩小的实像\""},{"id":"cnp_023_q3","topicId":"cnp_023","difficulty":"standard","type":"choice","prompt":"远视眼看近处物体时，像成在什么位置？","choices":[{"key":"A","text":"视网膜前方"},{"key":"B","text":"视网膜上"},{"key":"C","text":"视网膜后方"},{"key":"D","text":"晶状体上"}],"answer":"C","explanation":"远视眼晶状体折光能力太弱，近处物体的像成在视网膜后方，用凸透镜矫正。","verify":"\"视网膜后方\""},{"id":"cnp_023_q4","topicId":"cnp_023","difficulty":"standard","type":"choice","prompt":"长时间近距离看手机，容易使晶状体怎样变化而形成近视？","choices":[{"key":"A","text":"变厚，折光能力变强"},{"key":"B","text":"变薄，折光能力变弱"},{"key":"C","text":"变厚，折光能力变弱"},{"key":"D","text":"不发生变化"}],"answer":"A","explanation":"长时间看近处，睫状体疲劳，晶状体变厚、折光能力变强，远处物体的像成在视网膜前。","verify":"\"变厚，折光能力变强\""}]
