[{"id":"cne_p001_q1","topicId":"cne_p001","difficulty":"basic","type":"numeric","prompt":"英语字母表一共有多少个字母？","answer":"26","explanation":"英语字母表从 A 到 Z，一共 26 个字母。","verify":"26"},{"id":"cne_p001_q2","topicId":"cne_p001","difficulty":"basic","type":"choice","prompt":"字母表里，紧挨在 D 后面的是哪一个？","choices":[{"key":"A","text":"the letter C"},{"key":"B","text":"the letter F"},{"key":"C","text":"the letter B"},{"key":"D","text":"the letter E"}],"answer":"D","explanation":"D 的下一个字母是 E。","verify":"\"the letter E\""},{"id":"cne_p001_q3","topicId":"cne_p001","difficulty":"standard","type":"choice","prompt":"下面哪一组是按字母表顺序排列的？","choices":[{"key":"A","text":"A, B, C, D"},{"key":"B","text":"A, C, B, D"},{"key":"C","text":"B, A, D, C"},{"key":"D","text":"D, C, B, A"}],"answer":"A","explanation":"字母表开头是 A、B、C、D。","verify":"\"A, B, C, D\""},{"id":"cne_p001_q4","topicId":"cne_p001","difficulty":"standard","type":"choice","prompt":"哪个是字母表的最后一个字母？","choices":[{"key":"A","text":"the letter Y"},{"key":"B","text":"the letter Z"},{"key":"C","text":"the letter X"},{"key":"D","text":"the letter A"}],"answer":"B","explanation":"字母表的最后一个字母是 Z。","verify":"\"the letter Z\""},{"id":"cne_p002_q1","topicId":"cne_p002","difficulty":"basic","type":"choice","prompt":"哪一组是同一个字母的大写和小写？","choices":[{"key":"A","text":"Dp"},{"key":"B","text":"Bt"},{"key":"C","text":"Qm"},{"key":"D","text":"Gg"}],"answer":"D","explanation":"G 的大写是 G，小写是 g，所以是 Gg。","verify":"\"Gg\""},{"id":"cne_p002_q2","topicId":"cne_p002","difficulty":"basic","type":"choice","prompt":"哪个是小写字母？","choices":[{"key":"A","text":"the small letter h"},{"key":"B","text":"the capital letter H"},{"key":"C","text":"the capital letter B"},{"key":"D","text":"the capital letter M"}],"answer":"A","explanation":"h 是小写，H、B、M 是大写。","verify":"\"the small letter h\""},{"id":"cne_p002_q3","topicId":"cne_p002","difficulty":"standard","type":"numeric","prompt":"英语大写字母有多少个？","answer":"26","explanation":"大写字母从 A 到 Z，一共 26 个。","verify":"26"},{"id":"cne_p002_q4","topicId":"cne_p002","difficulty":"standard","type":"choice","prompt":"单词 bag 的第一个字母是哪一种写法？","choices":[{"key":"A","text":"the capital letter B"},{"key":"B","text":"the small letter d"},{"key":"C","text":"the small letter b"},{"key":"D","text":"the capital letter D"}],"answer":"C","explanation":"bag 以小写 b 开头。","verify":"\"the small letter b\""},{"id":"cne_p004_q1","topicId":"cne_p004","difficulty":"basic","type":"choice","prompt":"哪个单词含有字母 b 的开头音？","choices":[{"key":"A","text":"cat"},{"key":"B","text":"bag"},{"key":"C","text":"dog"},{"key":"D","text":"pen"}],"answer":"B","explanation":"bag 含有字母 b 的开头音。","verify":"\"bag\""},{"id":"cne_p004_q2","topicId":"cne_p004","difficulty":"basic","type":"choice","prompt":"哪个单词不含字母 b 的开头音？","choices":[{"key":"A","text":"bag"},{"key":"B","text":"bed"},{"key":"C","text":"cat"},{"key":"D","text":"bus"}],"answer":"C","explanation":"cat 不含字母 b 的开头音。","verify":"\"cat\""},{"id":"cne_p004_q3","topicId":"cne_p004","difficulty":"standard","type":"choice","prompt":"bed 和哪个词的开头音相同？","choices":[{"key":"A","text":"cat"},{"key":"B","text":"dog"},{"key":"C","text":"pen"},{"key":"D","text":"bus"}],"answer":"D","explanation":"bed 和 bus 的开头都是字母 b 的开头音。","verify":"\"bus\""},{"id":"cne_p004_q4","topicId":"cne_p004","difficulty":"standard","type":"choice","prompt":"选择含有字母 b 的开头音的单词。","choices":[{"key":"A","text":"box"},{"key":"B","text":"dog"},{"key":"C","text":"pen"},{"key":"D","text":"sun"}],"answer":"A","explanation":"box 含有字母 b 的开头音。","verify":"\"box\""},{"id":"cne_p005_q1","topicId":"cne_p005","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「你好」？","choices":[{"key":"A","text":"goodbye"},{"key":"B","text":"thanks"},{"key":"C","text":"hello"},{"key":"D","text":"sorry"}],"answer":"C","explanation":"hello 的意思是你好。","verify":"\"hello\""},{"id":"cne_p005_q2","topicId":"cne_p005","difficulty":"basic","type":"choice","prompt":"「hi」是打招呼的词，它的中文意思是哪一个？","choices":[{"key":"A","text":"你好"},{"key":"B","text":"再见"},{"key":"C","text":"谢谢"},{"key":"D","text":"对不起"}],"answer":"A","explanation":"hi 的意思是你好。","verify":"\"你好\""},{"id":"cne_p005_q3","topicId":"cne_p005","difficulty":"standard","type":"choice","prompt":"选择表示「再见」的单词。","choices":[{"key":"A","text":"goodbye"},{"key":"B","text":"hello"},{"key":"C","text":"hi"},{"key":"D","text":"thanks"}],"answer":"A","explanation":"表示再见的单词是 goodbye。","verify":"\"goodbye\""},{"id":"cne_p005_q4","topicId":"cne_p005","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「谢谢」？","choices":[{"key":"A","text":"hello"},{"key":"B","text":"thanks"},{"key":"C","text":"hi"},{"key":"D","text":"goodbye"}],"answer":"B","explanation":"thanks 的意思是谢谢。","verify":"\"thanks\""},{"id":"cne_p006_q1","topicId":"cne_p006","difficulty":"basic","type":"choice","prompt":"I ____ ten. 横线上应填哪个词？","choices":[{"key":"A","text":"is"},{"key":"B","text":"are"},{"key":"C","text":"be"},{"key":"D","text":"am"}],"answer":"D","explanation":"I 和 am 搭配，所以是 I am ten。","verify":"\"am\""},{"id":"cne_p006_q2","topicId":"cne_p006","difficulty":"basic","type":"choice","prompt":"You ____ a student. 横线上应填哪个词？","choices":[{"key":"A","text":"are"},{"key":"B","text":"am"},{"key":"C","text":"is"},{"key":"D","text":"be"}],"answer":"A","explanation":"You 和 are 搭配。","verify":"\"are\""},{"id":"cne_p006_q3","topicId":"cne_p006","difficulty":"standard","type":"choice","prompt":"哪一句是正确的？","choices":[{"key":"A","text":"I are Amy."},{"key":"B","text":"I am Amy."},{"key":"C","text":"I be Amy."},{"key":"D","text":"Am I Amy name."}],"answer":"B","explanation":"介绍自己要说 I am Amy。","verify":"\"I am Amy.\""},{"id":"cne_p006_q4","topicId":"cne_p006","difficulty":"standard","type":"choice","prompt":"My name ____ Chen Jie. 横线上应填哪个词？","choices":[{"key":"A","text":"am"},{"key":"B","text":"are"},{"key":"C","text":"is"},{"key":"D","text":"be"}],"answer":"C","explanation":"name 和 is 搭配。","verify":"\"is\""},{"id":"cne_p007_q1","topicId":"cne_p007","difficulty":"basic","type":"choice","prompt":"见到老师，应说哪一句？","choices":[{"key":"A","text":"Hello!"},{"key":"B","text":"Goodbye!"},{"key":"C","text":"Thank you!"},{"key":"D","text":"I am ten."}],"answer":"A","explanation":"见面时说 Hello。","verify":"\"Hello!\""},{"id":"cne_p007_q2","topicId":"cne_p007","difficulty":"basic","type":"choice","prompt":"要离开了，应说哪一句？","choices":[{"key":"A","text":"Hello!"},{"key":"B","text":"Goodbye!"},{"key":"C","text":"Thank you!"},{"key":"D","text":"I am Amy."}],"answer":"B","explanation":"告别说 Goodbye。","verify":"\"Goodbye!\""},{"id":"cne_p007_q3","topicId":"cne_p007","difficulty":"standard","type":"choice","prompt":"别人帮了你，应说哪一句？","choices":[{"key":"A","text":"Hello!"},{"key":"B","text":"Goodbye!"},{"key":"C","text":"Thank you!"},{"key":"D","text":"I am five."}],"answer":"C","explanation":"致谢说 Thank you。","verify":"\"Thank you!\""},{"id":"cne_p007_q4","topicId":"cne_p007","difficulty":"standard","type":"choice","prompt":"想告诉对方自己的名字，应说哪一句？","choices":[{"key":"A","text":"Goodbye, Mike."},{"key":"B","text":"Thank you, Mike."},{"key":"C","text":"Hello is Mike."},{"key":"D","text":"I am Mike."}],"answer":"D","explanation":"介绍名字说 I am Mike。","verify":"\"I am Mike.\""},{"id":"cne_p008_q1","topicId":"cne_p008","difficulty":"basic","type":"choice","prompt":"读一读：Hello! I am Sarah. 这个人叫什么？","choices":[{"key":"A","text":"Mike"},{"key":"B","text":"Sarah"},{"key":"C","text":"Amy"},{"key":"D","text":"John"}],"answer":"B","explanation":"句子写的是 I am Sarah。","verify":"\"Sarah\""},{"id":"cne_p008_q2","topicId":"cne_p008","difficulty":"basic","type":"choice","prompt":"读一读：Hi! I am John. 哪一句和短文意思相同？","choices":[{"key":"A","text":"他叫 Sarah。"},{"key":"B","text":"他要告别。"},{"key":"C","text":"他叫 John。"},{"key":"D","text":"他在说谢谢。"}],"answer":"C","explanation":"短文说 I am John。","verify":"\"他叫 John。\""},{"id":"cne_p008_q3","topicId":"cne_p008","difficulty":"standard","type":"choice","prompt":"读一读：Goodbye, Amy! Amy 在做什么？","choices":[{"key":"A","text":"问候"},{"key":"B","text":"致谢"},{"key":"C","text":"介绍年龄"},{"key":"D","text":"告别"}],"answer":"D","explanation":"Goodbye 是告别。","verify":"\"告别\""},{"id":"cne_p008_q4","topicId":"cne_p008","difficulty":"standard","type":"choice","prompt":"读一读：I am Chen Jie. Thank you! 哪一句是短文里有的？","choices":[{"key":"A","text":"I am Chen Jie."},{"key":"B","text":"I am Sarah."},{"key":"C","text":"I am Mike."},{"key":"D","text":"I am John."}],"answer":"A","explanation":"短文写的名字是 Chen Jie。","verify":"\"I am Chen Jie.\""}]
