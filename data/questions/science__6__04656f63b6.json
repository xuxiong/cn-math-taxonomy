[{"id":"cns_p206_q1","topicId":"cns_p206","difficulty":"basic","type":"choice","prompt":"古代人最早住在哪里？","choices":[{"key":"A","text":"高楼大厦"},{"key":"B","text":"钢结构房"},{"key":"C","text":"玻璃房"},{"key":"D","text":"天然洞穴"}],"answer":"D","explanation":"原始人类利用天然洞穴居住。","verify":"\"天然洞穴\""},{"id":"cns_p206_q2","topicId":"cns_p206","difficulty":"basic","type":"choice","prompt":"现代高楼大厦主要用什么材料建造？","choices":[{"key":"A","text":"钢筋混凝土"},{"key":"B","text":"稻草"},{"key":"C","text":"泥土"},{"key":"D","text":"木头"}],"answer":"A","explanation":"钢筋混凝土坚固，可以建高楼。","verify":"\"钢筋混凝土\""},{"id":"cns_p206_q3","topicId":"cns_p206","difficulty":"standard","type":"choice","prompt":"房屋建造材料的变化说明了什么？","choices":[{"key":"A","text":"房子越来越差"},{"key":"B","text":"技术进步使住房更安全舒适"},{"key":"C","text":"人越来越懒"},{"key":"D","text":"没有变化"}],"answer":"B","explanation":"技术发展推动住房改善。","verify":"\"技术进步使住房更安全舒适\""},{"id":"cns_p206_q4","topicId":"cns_p206","difficulty":"challenge","type":"choice","prompt":"我国南方傣族的竹楼底层架空，主要是为了什么？","choices":[{"key":"A","text":"为了好看"},{"key":"B","text":"为了省钱"},{"key":"C","text":"防潮、通风、防虫兽"},{"key":"D","text":"为了放更多东西"}],"answer":"C","explanation":"这种设计适应了湿热多雨的环境。","verify":"\"防潮、通风、防虫兽\""},{"id":"cns_p207_q1","topicId":"cns_p207","difficulty":"basic","type":"choice","prompt":"下面哪个是工程？","choices":[{"key":"A","text":"修建一座大桥"},{"key":"B","text":"吃一顿饭"},{"key":"C","text":"睡一觉"},{"key":"D","text":"看一场电影"}],"answer":"A","explanation":"工程是有计划地建造、解决实际问题。","verify":"\"修建一座大桥\""},{"id":"cns_p207_q2","topicId":"cns_p207","difficulty":"basic","type":"choice","prompt":"工程的核心是什么？","choices":[{"key":"A","text":"变得好看"},{"key":"B","text":"解决实际问题"},{"key":"C","text":"花更多钱"},{"key":"D","text":"让人更累"}],"answer":"B","explanation":"工程为了满足人们的需求。","verify":"\"解决实际问题\""},{"id":"cns_p207_q3","topicId":"cns_p207","difficulty":"standard","type":"choice","prompt":"工程师在建造前通常要做什么？","choices":[{"key":"A","text":"直接开工"},{"key":"B","text":"先拆掉"},{"key":"C","text":"调查需求、设计方案"},{"key":"D","text":"先庆祝"}],"answer":"C","explanation":"先设计再建造。","verify":"\"调查需求、设计方案\""},{"id":"cns_p207_q4","topicId":"cns_p207","difficulty":"challenge","type":"choice","prompt":"工程中「科学」和「技术」的关系是？","choices":[{"key":"A","text":"两者毫无关系"},{"key":"B","text":"科学就是技术"},{"key":"C","text":"技术不需要科学"},{"key":"D","text":"科学发现原理，技术把原理用于解决问题"}],"answer":"D","explanation":"工程综合运用科学和技术。","verify":"\"科学发现原理，技术把原理用于解决问题\""},{"id":"cns_p208_q1","topicId":"cns_p208","difficulty":"basic","type":"choice","prompt":"下面哪种塔台结构最稳定？","choices":[{"key":"A","text":"底部窄、顶部宽"},{"key":"B","text":"底部宽、顶部窄"},{"key":"C","text":"上下一样细"},{"key":"D","text":"顶部最重"}],"answer":"B","explanation":"上小下大，重心低，更稳。","verify":"\"底部宽、顶部窄\""},{"id":"cns_p208_q2","topicId":"cns_p208","difficulty":"basic","type":"choice","prompt":"塔台框架中加入三角形结构，主要是为了什么？","choices":[{"key":"A","text":"更好看"},{"key":"B","text":"更轻"},{"key":"C","text":"更稳固，不易变形"},{"key":"D","text":"更省材料"}],"answer":"C","explanation":"三角形结构稳定。","verify":"\"更稳固，不易变形\""},{"id":"cns_p208_q3","topicId":"cns_p208","difficulty":"standard","type":"choice","prompt":"塔台越高越容易倒，主要原因是什么？","choices":[{"key":"A","text":"高的颜色更深"},{"key":"B","text":"高处风小"},{"key":"C","text":"高处没空气"},{"key":"D","text":"重心越高越不稳"}],"answer":"D","explanation":"重心升高会降低稳定性。","verify":"\"重心越高越不稳\""},{"id":"cns_p208_q4","topicId":"cns_p208","difficulty":"challenge","type":"choice","prompt":"埃菲尔铁塔采用镂空的钢架结构，主要好处是？","choices":[{"key":"A","text":"既轻又坚固，还能减少风的阻力"},{"key":"B","text":"为了省电"},{"key":"C","text":"为了晒衣服"},{"key":"D","text":"为了能长树"}],"answer":"A","explanation":"镂空结构减重并减少受风面积。","verify":"\"既轻又坚固，还能减少风的阻力\""},{"id":"cns_p209_q1","topicId":"cns_p209","difficulty":"basic","type":"choice","prompt":"设计塔台模型时，首先要明确什么？","choices":[{"key":"A","text":"颜色"},{"key":"B","text":"名字"},{"key":"C","text":"高度、承重、材料等要求"},{"key":"D","text":"谁做得最快"}],"answer":"C","explanation":"工程设计先明确要求和限制。","verify":"\"高度、承重、材料等要求\""},{"id":"cns_p209_q2","topicId":"cns_p209","difficulty":"basic","type":"choice","prompt":"测试塔台时，用风扇吹塔台是测试它的什么？","choices":[{"key":"A","text":"美观程度"},{"key":"B","text":"重量"},{"key":"C","text":"高度"},{"key":"D","text":"抗风能力（稳定性）"}],"answer":"D","explanation":"抗风测试检查稳定性。","verify":"\"抗风能力（稳定性）\""},{"id":"cns_p209_q3","topicId":"cns_p209","difficulty":"standard","type":"choice","prompt":"测试中塔台摇晃得很厉害，可以怎样改进？","choices":[{"key":"A","text":"加宽底座，增加斜撑"},{"key":"B","text":"把底座变窄"},{"key":"C","text":"把顶部加重"},{"key":"D","text":"减少连接"}],"answer":"A","explanation":"扩大底面和加斜撑能增加稳定性。","verify":"\"加宽底座，增加斜撑\""},{"id":"cns_p209_q4","topicId":"cns_p209","difficulty":"challenge","type":"choice","prompt":"评估塔台模型时，下面哪一项不是合理的评价标准？","choices":[{"key":"A","text":"高度是否达标"},{"key":"B","text":"制作者的个子高不高"},{"key":"C","text":"是否稳固"},{"key":"D","text":"是否节约材料"}],"answer":"B","explanation":"评价应针对作品本身。","verify":"\"制作者的个子高不高\""}]
