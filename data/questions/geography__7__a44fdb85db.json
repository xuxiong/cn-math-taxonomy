[{"id":"cng_j001_q1","topicId":"cng_j001","difficulty":"basic","type":"choice","prompt":"地球在太阳系中属于哪一类天体？","choices":[{"key":"A","text":"恒星"},{"key":"B","text":"卫星"},{"key":"C","text":"行星"},{"key":"D","text":"彗星"}],"answer":"C","explanation":"地球围绕太阳公转，是太阳系中的一颗行星。","verify":"\"行星\""},{"id":"cng_j001_q2","topicId":"cng_j001","difficulty":"basic","type":"choice","prompt":"月球属于哪一类天体？","choices":[{"key":"A","text":"恒星"},{"key":"B","text":"行星"},{"key":"C","text":"星云"},{"key":"D","text":"卫星"}],"answer":"D","explanation":"月球围绕地球运转，是地球的天然卫星。","verify":"\"卫星\""},{"id":"cng_j001_q3","topicId":"cng_j001","difficulty":"standard","type":"choice","prompt":"太阳系八大行星按距太阳由近及远，地球排在第几位？","choices":[{"key":"A","text":"第三位"},{"key":"B","text":"第一位"},{"key":"C","text":"第五位"},{"key":"D","text":"第八位"}],"answer":"A","explanation":"顺序是水星、金星、地球、火星、木星、土星、天王星、海王星。","verify":"\"第三位\""},{"id":"cng_j001_q4","topicId":"cng_j001","difficulty":"challenge","type":"choice","prompt":"可观测宇宙中，地球所在的天体系统由小到大依次是？","choices":[{"key":"A","text":"太阳系、地月系、银河系、可观测宇宙"},{"key":"B","text":"地月系、太阳系、银河系、可观测宇宙"},{"key":"C","text":"银河系、太阳系、地月系、可观测宇宙"},{"key":"D","text":"地月系、银河系、太阳系、可观测宇宙"}],"answer":"B","explanation":"地球和月球组成地月系，地月系属于太阳系，太阳系属于银河系。","verify":"\"地月系、太阳系、银河系、可观测宇宙\""},{"id":"cng_j002_q1","topicId":"cng_j002","difficulty":"basic","type":"choice","prompt":"地球的平均半径大约是？","choices":[{"key":"A","text":"40000千米"},{"key":"B","text":"5.1亿千米"},{"key":"C","text":"384000千米"},{"key":"D","text":"6371千米"}],"answer":"D","explanation":"教材给出地球平均半径约6371千米。","verify":"\"6371千米\""},{"id":"cng_j002_q2","topicId":"cng_j002","difficulty":"basic","type":"choice","prompt":"0°经线又称为？","choices":[{"key":"A","text":"本初子午线"},{"key":"B","text":"赤道"},{"key":"C","text":"国际日期变更线"},{"key":"D","text":"北回归线"}],"answer":"A","explanation":"0°经线穿过英国格林尼治，称为本初子午线。","verify":"\"本初子午线\""},{"id":"cng_j002_q3","topicId":"cng_j002","difficulty":"standard","type":"choice","prompt":"纬线指示的方向是？","choices":[{"key":"A","text":"南北方向"},{"key":"B","text":"东西方向"},{"key":"C","text":"上下方向"},{"key":"D","text":"西北—东南方向"}],"answer":"B","explanation":"纬线与经线垂直，指示东西方向；经线指示南北方向。","verify":"\"东西方向\""},{"id":"cng_j002_q4","topicId":"cng_j002","difficulty":"challenge","type":"choice","prompt":"北纬40°、东经116°大致对应的城市是？","choices":[{"key":"A","text":"新加坡"},{"key":"B","text":"开普敦"},{"key":"C","text":"北京"},{"key":"D","text":"纽约"}],"answer":"C","explanation":"北京大约位于40°N、116°E附近。","verify":"\"北京\""},{"id":"cng_j003_q1","topicId":"cng_j003","difficulty":"basic","type":"choice","prompt":"地球自转的方向是？","choices":[{"key":"A","text":"自西向东"},{"key":"B","text":"自东向西"},{"key":"C","text":"自北向南"},{"key":"D","text":"自南向北"}],"answer":"A","explanation":"从北极上空看，地球自转呈逆时针，即自西向东。","verify":"\"自西向东\""},{"id":"cng_j003_q2","topicId":"cng_j003","difficulty":"basic","type":"choice","prompt":"昼夜交替主要是由哪一种运动引起的？","choices":[{"key":"A","text":"地球公转"},{"key":"B","text":"地球自转"},{"key":"C","text":"月球绕地球运动"},{"key":"D","text":"太阳黑子活动"}],"answer":"B","explanation":"地球不停自转，朝向太阳的一面是白天，背向太阳的一面是黑夜。","verify":"\"地球自转\""},{"id":"cng_j003_q3","topicId":"cng_j003","difficulty":"standard","type":"choice","prompt":"北半球夏至日，太阳直射的纬线是？","choices":[{"key":"A","text":"赤道"},{"key":"B","text":"南回归线"},{"key":"C","text":"北回归线"},{"key":"D","text":"北极圈"}],"answer":"C","explanation":"夏至日太阳直射北回归线（约23.5°N），北半球昼最长。","verify":"\"北回归线\""},{"id":"cng_j003_q4","topicId":"cng_j003","difficulty":"challenge","type":"choice","prompt":"地球公转产生的地理现象是？","choices":[{"key":"A","text":"昼夜更替"},{"key":"B","text":"地方时差异"},{"key":"C","text":"物体水平运动方向偏转"},{"key":"D","text":"四季更替和五带划分"}],"answer":"D","explanation":"公转使太阳直射点在南北回归线之间移动，从而形成四季和五带。","verify":"\"四季更替和五带划分\""}]
