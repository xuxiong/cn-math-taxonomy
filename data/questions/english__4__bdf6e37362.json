[{"id":"cne_p092_q1","topicId":"cne_p092","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「温暖的」？","choices":[{"key":"A","text":"cold"},{"key":"B","text":"warm"},{"key":"C","text":"cool"},{"key":"D","text":"hot"}],"answer":"B","explanation":"warm 的意思是温暖的。","verify":"\"warm\""},{"id":"cne_p092_q2","topicId":"cne_p092","difficulty":"basic","type":"choice","prompt":"「cold」的中文意思是哪一个？","choices":[{"key":"A","text":"温暖的"},{"key":"B","text":"凉爽的"},{"key":"C","text":"寒冷的"},{"key":"D","text":"炎热的"}],"answer":"C","explanation":"cold 的意思是寒冷的。","verify":"\"寒冷的\""},{"id":"cne_p092_q3","topicId":"cne_p092","difficulty":"standard","type":"choice","prompt":"选择表示「凉爽的」的单词。","choices":[{"key":"A","text":"warm"},{"key":"B","text":"cold"},{"key":"C","text":"hot"},{"key":"D","text":"cool"}],"answer":"D","explanation":"表示凉爽的的单词是 cool。","verify":"\"cool\""},{"id":"cne_p092_q4","topicId":"cne_p092","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「炎热的」？","choices":[{"key":"A","text":"hot"},{"key":"B","text":"warm"},{"key":"C","text":"cold"},{"key":"D","text":"cool"}],"answer":"A","explanation":"hot 的意思是炎热的。","verify":"\"hot\""},{"id":"cne_p093_q1","topicId":"cne_p093","difficulty":"basic","type":"choice","prompt":"想问天气，应选哪一句？","choices":[{"key":"A","text":"What is the weather is?"},{"key":"B","text":"How the weather like?"},{"key":"C","text":"What is the weather like?"},{"key":"D","text":"Where is the weather?"}],"answer":"C","explanation":"问天气说 What is the weather like?","verify":"\"What is the weather like?\""},{"id":"cne_p093_q2","topicId":"cne_p093","difficulty":"basic","type":"choice","prompt":"It is cold. 天气怎么样？","choices":[{"key":"A","text":"很热"},{"key":"B","text":"很暖和"},{"key":"C","text":"很凉爽"},{"key":"D","text":"很冷"}],"answer":"D","explanation":"cold 是冷。","verify":"\"很冷\""},{"id":"cne_p093_q3","topicId":"cne_p093","difficulty":"standard","type":"choice","prompt":"It is sunny in Beijing. 北京的天气怎么样？","choices":[{"key":"A","text":"晴朗"},{"key":"B","text":"下雨"},{"key":"C","text":"下雪"},{"key":"D","text":"有风"}],"answer":"A","explanation":"sunny 是晴朗。","verify":"\"晴朗\""},{"id":"cne_p093_q4","topicId":"cne_p093","difficulty":"standard","type":"choice","prompt":"哪一句表示「今天很热」？","choices":[{"key":"A","text":"It is cold today."},{"key":"B","text":"It is hot today."},{"key":"C","text":"It is cool today."},{"key":"D","text":"It is warm today."}],"answer":"B","explanation":"热是 hot。","verify":"\"It is hot today.\""},{"id":"cne_p094_q1","topicId":"cne_p094","difficulty":"basic","type":"choice","prompt":"外面很冷，应说哪一句？","choices":[{"key":"A","text":"It is hot outside."},{"key":"B","text":"It is warm outside."},{"key":"C","text":"It is cool outside."},{"key":"D","text":"It is cold outside."}],"answer":"D","explanation":"冷是 cold。","verify":"\"It is cold outside.\""},{"id":"cne_p094_q2","topicId":"cne_p094","difficulty":"basic","type":"choice","prompt":"It is warm. We can fly a kite. 为什么可以放风筝？","choices":[{"key":"A","text":"因为天气暖和"},{"key":"B","text":"因为很冷"},{"key":"C","text":"因为在下雨"},{"key":"D","text":"因为是夜晚"}],"answer":"A","explanation":"It is warm 是天气暖和。","verify":"\"因为天气暖和\""},{"id":"cne_p094_q3","topicId":"cne_p094","difficulty":"standard","type":"choice","prompt":"Can I go outside? 这句是在问什么？","choices":[{"key":"A","text":"天气怎么样"},{"key":"B","text":"我可以出去吗"},{"key":"C","text":"现在几点"},{"key":"D","text":"你喜欢冷天吗"}],"answer":"B","explanation":"go outside 是出去。","verify":"\"我可以出去吗\""},{"id":"cne_p094_q4","topicId":"cne_p094","difficulty":"standard","type":"choice","prompt":"It is hot. Have some water. 这句建议做什么？","choices":[{"key":"A","text":"穿上外套"},{"key":"B","text":"放风筝"},{"key":"C","text":"喝些水"},{"key":"D","text":"关窗"}],"answer":"C","explanation":"Have some water 是喝些水。","verify":"\"喝些水\""},{"id":"cne_p095_q1","topicId":"cne_p095","difficulty":"basic","type":"choice","prompt":"读一读：It is cold and snowy in Harbin. 哈尔滨的天气怎么样？","choices":[{"key":"A","text":"又冷又下雪"},{"key":"B","text":"很热"},{"key":"C","text":"很暖和"},{"key":"D","text":"只是有风"}],"answer":"A","explanation":"cold and snowy。","verify":"\"又冷又下雪\""},{"id":"cne_p095_q2","topicId":"cne_p095","difficulty":"basic","type":"choice","prompt":"读一读：It is sunny in Beijing. It is rainy in Shanghai. 哪里下雨？","choices":[{"key":"A","text":"北京"},{"key":"B","text":"上海"},{"key":"C","text":"哈尔滨"},{"key":"D","text":"两个城市都下雨"}],"answer":"B","explanation":"rainy 写在 Shanghai。","verify":"\"上海\""},{"id":"cne_p095_q3","topicId":"cne_p095","difficulty":"standard","type":"choice","prompt":"读一读：It is warm today. Let's fly a kite. 哪一句和短文一致？","choices":[{"key":"A","text":"今天很冷。"},{"key":"B","text":"今天在下雨。"},{"key":"C","text":"今天暖和，建议放风筝。"},{"key":"D","text":"不建议出去。"}],"answer":"C","explanation":"warm，并且 Let's fly a kite。","verify":"\"今天暖和，建议放风筝。\""},{"id":"cne_p095_q4","topicId":"cne_p095","difficulty":"standard","type":"choice","prompt":"读一读：Here is the world weather. It is cool in London. 伦敦怎么样？","choices":[{"key":"A","text":"炎热"},{"key":"B","text":"寒冷"},{"key":"C","text":"下雪"},{"key":"D","text":"凉爽"}],"answer":"D","explanation":"cool 是凉爽。","verify":"\"凉爽\""},{"id":"cne_p218_q1","topicId":"cne_p218","difficulty":"basic","type":"choice","prompt":"下雨天适合做什么？","choices":[{"key":"A","text":"stay inside"},{"key":"B","text":"fly a kite"},{"key":"C","text":"have a picnic"},{"key":"D","text":"swim outside"}],"answer":"A","explanation":"rainy → stay inside。","verify":"\"stay inside\""},{"id":"cne_p218_q2","topicId":"cne_p218","difficulty":"basic","type":"choice","prompt":"It's sunny. We can ____.","choices":[{"key":"A","text":"stay in bed all day"},{"key":"B","text":"take an umbrella only"},{"key":"C","text":"close all windows forever"},{"key":"D","text":"play outside"}],"answer":"D","explanation":"晴天可 outdoors 玩。","verify":"\"play outside\""},{"id":"cne_p218_q3","topicId":"cne_p218","difficulty":"standard","type":"choice","prompt":"哪一句适合大风天？","choices":[{"key":"A","text":"Let's go swimming outside."},{"key":"B","text":"Open all the windows."},{"key":"C","text":"Don't fly a kite."},{"key":"D","text":"Let's have a picnic."}],"answer":"C","explanation":"大风不宜放风筝。","verify":"\"Don't fly a kite.\""},{"id":"cne_p218_q4","topicId":"cne_p218","difficulty":"standard","type":"choice","prompt":"It's snowy. We can make a snowman. 天气怎么样？","choices":[{"key":"A","text":"多云"},{"key":"B","text":"下雪"},{"key":"C","text":"下雨"},{"key":"D","text":"晴天"}],"answer":"B","explanation":"snowy 是下雪。","verify":"\"下雪\""},{"id":"cne_p219_q1","topicId":"cne_p219","difficulty":"basic","type":"choice","prompt":"读一读：Rainy day! Take an umbrella. 下雨天要带什么？","choices":[{"key":"A","text":"雨伞"},{"key":"B","text":"太阳镜"},{"key":"C","text":"风筝"},{"key":"D","text":"雪人"}],"answer":"A","explanation":"umbrella 是雨伞。","verify":"\"雨伞\""},{"id":"cne_p219_q2","topicId":"cne_p219","difficulty":"basic","type":"choice","prompt":"读一读：Windy! Don't fly a kite near the road. 大风天不要做什么？","choices":[{"key":"A","text":"待在家里"},{"key":"B","text":"带雨伞"},{"key":"C","text":"穿外套"},{"key":"D","text":"在路边放风筝"}],"answer":"D","explanation":"Don't fly a kite near the road。","verify":"\"在路边放风筝\""},{"id":"cne_p219_q3","topicId":"cne_p219","difficulty":"standard","type":"choice","prompt":"读一读：Hot day! Drink water. Wear a hat. 哪一句和提醒一致？","choices":[{"key":"A","text":"要关窗睡觉。"},{"key":"B","text":"不要喝水。"},{"key":"C","text":"要喝水、戴帽子。"},{"key":"D","text":"要放风筝。"}],"answer":"C","explanation":"Drink water. Wear a hat。","verify":"\"要喝水、戴帽子。\""},{"id":"cne_p219_q4","topicId":"cne_p219","difficulty":"standard","type":"choice","prompt":"读一读：Snowy! Put on a coat. 下雪天要穿什么？","choices":[{"key":"A","text":"雨伞"},{"key":"B","text":"外套"},{"key":"C","text":"短裤"},{"key":"D","text":"凉鞋"}],"answer":"B","explanation":"coat 是外套。","verify":"\"外套\""}]
