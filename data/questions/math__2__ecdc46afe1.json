[{"difficulty":"basic","type":"numeric","prompt":"图书馆运来 300 本和 400 本。两批一共多少本？","answer":"700","explanation":"3 个百加 4 个百是 7 个百，等于 700。","verify":"300+400","id":"cnm_p064_q1","topicId":"cnm_p064"},{"difficulty":"basic","type":"numeric","prompt":"250 本故事书，又放进 30 本。现在有多少本？","answer":"280","explanation":"250＋30＝280。","verify":"250+30","id":"cnm_p064_q2","topicId":"cnm_p064"},{"difficulty":"standard","type":"numeric","prompt":"一箱 180 本，另一箱 140 本。两箱一共多少本？","answer":"320","explanation":"180＋140＝320。","verify":"180+140","id":"cnm_p064_q3","topicId":"cnm_p064"},{"difficulty":"challenge","type":"numeric","prompt":"一箱 180 本，另一箱 140 本，后来又运来 50 本。现在一共多少本？","answer":"370","explanation":"180＋140＝320，再加 50 得 370。","verify":"180+140+50","id":"cnm_p064_q4","topicId":"cnm_p064"},{"difficulty":"basic","type":"numeric","prompt":"书架上有 800 本书，搬走 300 本。还剩多少本？","answer":"500","explanation":"800－300＝500。","verify":"800-300","id":"cnm_p065_q1","topicId":"cnm_p065"},{"difficulty":"basic","type":"numeric","prompt":"有 560 本，借出 40 本。还剩多少本？","answer":"520","explanation":"560－40＝520。","verify":"560-40","id":"cnm_p065_q2","topicId":"cnm_p065"},{"difficulty":"standard","type":"numeric","prompt":"图书馆有 730 本书，借出 280 本。还剩多少本？","answer":"450","explanation":"730－280＝450。","verify":"730-280","id":"cnm_p065_q3","topicId":"cnm_p065"},{"difficulty":"challenge","type":"numeric","prompt":"图书馆有 730 本书，借出 280 本，后来又还回 50 本。现在有多少本？","answer":"500","explanation":"730－280＝450，再加 50 得 500。","verify":"730-280+50","id":"cnm_p065_q4","topicId":"cnm_p065"},{"difficulty":"basic","type":"choice","prompt":"估算是为了什么？","choices":[{"key":"A","text":"很快知道大约是多少"},{"key":"B","text":"一定算出精确得数"},{"key":"C","text":"只用于减法"}],"answer":"A","explanation":"估算是把数看成整十或整百，先知道大约是多少。","verify":"'很快知道大约是多少'","id":"cnm_p066_q1","topicId":"cnm_p066"},{"difficulty":"basic","type":"numeric","prompt":"估算 198＋102 时，把 198 看作多少？","answer":"200","explanation":"198 接近 200。","verify":"200","id":"cnm_p066_q2","topicId":"cnm_p066"},{"difficulty":"standard","type":"numeric","prompt":"一件衣服 198 元，一顶帽子 102 元。把它们看成 200 元和 100 元，大约一共多少元？","answer":"300","explanation":"200＋100＝300。","verify":"200+100","id":"cnm_p066_q3","topicId":"cnm_p066"},{"difficulty":"challenge","type":"numeric","prompt":"43＋28，把 43 看作 40、28 看作 30，估算是 70。实际是 71。估算比实际少多少？","answer":"1","explanation":"71－70＝1。","verify":"43+28-(40+30)","id":"cnm_p066_q4","topicId":"cnm_p066"},{"difficulty":"basic","type":"numeric","prompt":"两个仓库分别有 234 箱和 125 箱。一共有多少箱？","answer":"359","explanation":"234＋125＝359。","verify":"234+125","id":"cnm_p071_q1","topicId":"cnm_p071"},{"difficulty":"basic","type":"numeric","prompt":"406 箱加上 270 箱。一共有多少箱？","answer":"676","explanation":"406＋270＝676。","verify":"406+270","id":"cnm_p071_q2","topicId":"cnm_p071"},{"difficulty":"standard","type":"numeric","prompt":"两个仓库分别有 368 箱和 475 箱。一共有多少箱？","answer":"843","explanation":"个位、十位连续进位，368＋475＝843。","verify":"368+475","id":"cnm_p071_q3","topicId":"cnm_p071"},{"difficulty":"challenge","type":"numeric","prompt":"498＋357，个位和十位都要进位。得数是多少？","answer":"855","explanation":"个位 8＋7＝15，十位 9＋5＋1＝15，百位 4＋3＋1＝8，得 855。","verify":"498+357","id":"cnm_p071_q4","topicId":"cnm_p071"},{"difficulty":"basic","type":"numeric","prompt":"书架上有 756 本书，搬走 234 本。还剩多少本？","answer":"522","explanation":"756－234＝522。","verify":"756-234","id":"cnm_p072_q1","topicId":"cnm_p072"},{"difficulty":"basic","type":"numeric","prompt":"书架上有 600 本书，搬走 248 本。还剩多少本？","answer":"352","explanation":"个位、十位都要退位，600－248＝352。","verify":"600-248","id":"cnm_p072_q2","topicId":"cnm_p072"},{"difficulty":"standard","type":"numeric","prompt":"803－457，中间有 0，要连续退位。得数是多少？","answer":"346","explanation":"803－457＝346。","verify":"803-457","id":"cnm_p072_q3","topicId":"cnm_p072"},{"difficulty":"challenge","type":"numeric","prompt":"702－468，十位是 0，要连续退位。得数是多少？","answer":"234","explanation":"个位借位后，十位 0 也要再向百位借，702－468＝234。","verify":"702-468","id":"cnm_p072_q4","topicId":"cnm_p072"},{"difficulty":"basic","type":"numeric","prompt":"□＋250＝600，□是多少？","answer":"350","explanation":"一个加数＝和－另一个加数：600－250＝350。","verify":"600-250","id":"cnm_p220_q1","topicId":"cnm_p220"},{"difficulty":"basic","type":"numeric","prompt":"□－180＝320，□是多少？","answer":"500","explanation":"被减数＝差＋减数：320＋180＝500。","verify":"320+180","id":"cnm_p220_q2","topicId":"cnm_p220"},{"difficulty":"standard","type":"numeric","prompt":"760－□＝430，□是多少？","answer":"330","explanation":"减数＝被减数－差：760－430＝330。","verify":"760-430","id":"cnm_p220_q3","topicId":"cnm_p220"},{"difficulty":"challenge","type":"numeric","prompt":"和是 600，一个加数是 250。另一个加数再减去 40，还剩多少？","answer":"310","explanation":"另一个加数是 600－250＝350，再减 40 得 310。","verify":"600-250-40","id":"cnm_p220_q4","topicId":"cnm_p220"},{"difficulty":"basic","type":"choice","prompt":"数独小游戏里，每一行里的数一般要怎样？","choices":[{"key":"A","text":"不重复"},{"key":"B","text":"必须都是偶数"},{"key":"C","text":"必须从小到大排"}],"answer":"A","explanation":"每一行、每一列里的数通常不能重复。","verify":"'不重复'","id":"cnm_p271_q1","topicId":"cnm_p271"},{"difficulty":"basic","type":"numeric","prompt":"一行要填 1、2、3。已经有 1 和 3，空格应填几？","answer":"2","explanation":"1、2、3 里还缺 2。","verify":"2","id":"cnm_p271_q2","topicId":"cnm_p271"},{"difficulty":"standard","type":"numeric","prompt":"一行要填 1 到 4。已经有 1、4、2，空格应填几？","answer":"3","explanation":"1 到 4 里还缺 3。","verify":"3","id":"cnm_p271_q3","topicId":"cnm_p271"},{"difficulty":"challenge","type":"choice","prompt":"小格里已经写了 5。同一行另一个空格还能再填 5 吗？","choices":[{"key":"A","text":"不能，同一行一般不重复"},{"key":"B","text":"能，想填几次都行"},{"key":"C","text":"只能填 0"}],"answer":"A","explanation":"同一行的数一般不能重复，所以不能再填 5。","verify":"'不能，同一行一般不重复'","id":"cnm_p271_q4","topicId":"cnm_p271"}]
