[{"id":"cnm_234_q1","topicId":"cnm_234","difficulty":"basic","type":"numeric","prompt":"求抛物线 y=x²-2x-3 与 x 轴的交点。（只写两个交点的横坐标，用逗号隔开）","answer":"-1，3","unordered":true,"explanation":"令 y=0，x²-2x-3=0，(x+1)(x-3)=0，x=-1 或 3，交点为 (-1,0)、(3,0)。","verify":"roots2(1,-2,-3)"},{"id":"cnm_234_q2","topicId":"cnm_234","difficulty":"basic","type":"choice","prompt":"抛物线 y=x²+2x+5 与 x 轴的交点个数是？","choices":[{"key":"A","text":"2 个"},{"key":"B","text":"1 个"},{"key":"C","text":"0 个"}],"answer":"C","explanation":"方程 x²+2x+5=0 的判别式 Δ=4-20=-16<0，无实根，所以抛物线与 x 轴没有交点。"},{"id":"cnm_234_q3","topicId":"cnm_234","difficulty":"standard","type":"numeric","prompt":"抛物线 y=x²-4x-5 与 x 轴交于 A、B 两点，求线段 AB 的长。（单位长度）","answer":"6","explanation":"令 y=0，x²-4x-5=0，(x-5)(x+1)=0，x=5 或 -1，所以 AB=5-(-1)=6。","verify":"max(roots2(1,-4,-5))-min(roots2(1,-4,-5))"},{"id":"cnm_234_q4","topicId":"cnm_234","difficulty":"advanced","type":"numeric","prompt":"抛物线 y=x²-2x+m 与 x 轴的一个交点是 (3,0)，求 m 的值和另一个交点的横坐标。（依次作答，用逗号隔开）","answer":"-3，-1","explanation":"代入 (3,0)：9-6+m=0，m=-3。方程 x²-2x-3=0 的两根之和为 2，另一根为 2-3=-1。","verify":"[-(3**2-2*3), 2-3]"}]
