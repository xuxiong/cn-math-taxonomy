[{"id":"cne_p009_q1","topicId":"cne_p009","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「红色」？","choices":[{"key":"A","text":"yellow"},{"key":"B","text":"green"},{"key":"C","text":"red"},{"key":"D","text":"blue"}],"answer":"C","explanation":"red 的意思是红色。","verify":"\"red\""},{"id":"cne_p009_q2","topicId":"cne_p009","difficulty":"basic","type":"choice","prompt":"「yellow」的中文意思是哪一个？","choices":[{"key":"A","text":"红色"},{"key":"B","text":"绿色"},{"key":"C","text":"蓝色"},{"key":"D","text":"黄色"}],"answer":"D","explanation":"yellow 的意思是黄色。","verify":"\"黄色\""},{"id":"cne_p009_q3","topicId":"cne_p009","difficulty":"standard","type":"choice","prompt":"选择表示「绿色」的单词。","choices":[{"key":"A","text":"green"},{"key":"B","text":"red"},{"key":"C","text":"yellow"},{"key":"D","text":"blue"}],"answer":"A","explanation":"表示绿色的单词是 green。","verify":"\"green\""},{"id":"cne_p009_q4","topicId":"cne_p009","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「蓝色」？","choices":[{"key":"A","text":"red"},{"key":"B","text":"blue"},{"key":"C","text":"yellow"},{"key":"D","text":"green"}],"answer":"B","explanation":"blue 的意思是蓝色。","verify":"\"blue\""},{"id":"cne_p010_q1","topicId":"cne_p010","difficulty":"basic","type":"choice","prompt":"It ____ red. 横线上应填哪个词？","choices":[{"key":"A","text":"am"},{"key":"B","text":"are"},{"key":"C","text":"be"},{"key":"D","text":"is"}],"answer":"D","explanation":"It 和 is 搭配。","verify":"\"is\""},{"id":"cne_p010_q2","topicId":"cne_p010","difficulty":"basic","type":"choice","prompt":"哪一句是正确的？","choices":[{"key":"A","text":"It is blue."},{"key":"B","text":"It are blue."},{"key":"C","text":"It am blue."},{"key":"D","text":"It be blue."}],"answer":"A","explanation":"说颜色要用 It is blue。","verify":"\"It is blue.\""},{"id":"cne_p010_q3","topicId":"cne_p010","difficulty":"standard","type":"choice","prompt":"The apple ____ green. 横线上应填哪个词？","choices":[{"key":"A","text":"am"},{"key":"B","text":"is"},{"key":"C","text":"are"},{"key":"D","text":"be"}],"answer":"B","explanation":"apple 是单数物品，用 is。","verify":"\"is\""},{"id":"cne_p010_q4","topicId":"cne_p010","difficulty":"standard","type":"choice","prompt":"哪一句用来说明物品是黄色的？","choices":[{"key":"A","text":"I yellow."},{"key":"B","text":"Yellow it."},{"key":"C","text":"It is yellow."},{"key":"D","text":"It yellow is."}],"answer":"C","explanation":"完整的句子是 It is yellow。","verify":"\"It is yellow.\""},{"id":"cne_p011_q1","topicId":"cne_p011","difficulty":"basic","type":"choice","prompt":"想问「它是什么颜色」，应说哪一句？","choices":[{"key":"A","text":"What colour is it?"},{"key":"B","text":"What is your name?"},{"key":"C","text":"How are you?"},{"key":"D","text":"Goodbye!"}],"answer":"A","explanation":"问颜色说 What colour is it?","verify":"\"What colour is it?\""},{"id":"cne_p011_q2","topicId":"cne_p011","difficulty":"basic","type":"choice","prompt":"What colour is it? 若它是红色的，应回答哪一句？","choices":[{"key":"A","text":"It is blue."},{"key":"B","text":"It is red."},{"key":"C","text":"I am red."},{"key":"D","text":"It are red."}],"answer":"B","explanation":"红色是 red，句子是 It is red。","verify":"\"It is red.\""},{"id":"cne_p011_q3","topicId":"cne_p011","difficulty":"standard","type":"choice","prompt":"Show me green. 这句是在说什么？","choices":[{"key":"A","text":"给我看看红色"},{"key":"B","text":"给我看看黄色"},{"key":"C","text":"给我看看绿色"},{"key":"D","text":"给我看看蓝色"}],"answer":"C","explanation":"green 是绿色。","verify":"\"给我看看绿色\""},{"id":"cne_p011_q4","topicId":"cne_p011","difficulty":"standard","type":"choice","prompt":"It is blue and yellow. 这里有几种颜色？","choices":[{"key":"A","text":"红色和绿色"},{"key":"B","text":"只有蓝色"},{"key":"C","text":"只有黄色"},{"key":"D","text":"蓝色和黄色"}],"answer":"D","explanation":"句子写了 blue 和 yellow。","verify":"\"蓝色和黄色\""},{"id":"cne_p012_q1","topicId":"cne_p012","difficulty":"basic","type":"choice","prompt":"文字：Look at the apple. It is blue. 苹果是什么颜色？","choices":[{"key":"A","text":"红色"},{"key":"B","text":"蓝色"},{"key":"C","text":"绿色"},{"key":"D","text":"黄色"}],"answer":"B","explanation":"文字写的是 blue，所以是蓝色。","verify":"\"蓝色\""},{"id":"cne_p012_q2","topicId":"cne_p012","difficulty":"basic","type":"choice","prompt":"文字：The bag is yellow. 哪一句和文字一致？","choices":[{"key":"A","text":"书包是绿色的。"},{"key":"B","text":"书包是红色的。"},{"key":"C","text":"书包是黄色的。"},{"key":"D","text":"书包是蓝色的。"}],"answer":"C","explanation":"yellow 是黄色。","verify":"\"书包是黄色的。\""},{"id":"cne_p012_q3","topicId":"cne_p012","difficulty":"standard","type":"choice","prompt":"文字：I see a red bird. 鸟是什么颜色？","choices":[{"key":"A","text":"黄色"},{"key":"B","text":"绿色"},{"key":"C","text":"蓝色"},{"key":"D","text":"红色"}],"answer":"D","explanation":"文字写的是 red。","verify":"\"红色\""},{"id":"cne_p012_q4","topicId":"cne_p012","difficulty":"standard","type":"choice","prompt":"文字：The pen is green. 哪一句是对的？","choices":[{"key":"A","text":"It is green."},{"key":"B","text":"It is red."},{"key":"C","text":"It is blue."},{"key":"D","text":"It is yellow."}],"answer":"A","explanation":"pen 的颜色写的是 green。","verify":"\"It is green.\""}]
