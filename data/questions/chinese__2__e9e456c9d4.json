[{"id":"cnc_p110_q1","topicId":"cnc_p110","difficulty":"basic","type":"choice","prompt":"「千山鸟飞绝」的下一句是哪一句？","choices":[{"key":"A","text":"孤舟蓑笠翁"},{"key":"B","text":"独钓寒江雪"},{"key":"C","text":"风吹草低见牛羊"},{"key":"D","text":"万径人踪灭"}],"answer":"D","explanation":"先写山和路都没有人鸟，后面才是江上的渔翁。","verify":"\"万径人踪灭\""},{"id":"cnc_p110_q2","topicId":"cnc_p110","difficulty":"basic","type":"choice","prompt":"「孤舟蓑笠翁」的下一句是哪一句？","choices":[{"key":"A","text":"独钓寒江雪"},{"key":"B","text":"万径人踪灭"},{"key":"C","text":"疑是银河落九天"},{"key":"D","text":"天似穹庐"}],"answer":"A","explanation":"一个披蓑戴笠的老人，独自在大雪的江面上钓鱼。","verify":"\"独钓寒江雪\""},{"id":"cnc_p110_q3","topicId":"cnc_p110","difficulty":"standard","type":"choice","prompt":"《江雪》的作者是谁？","choices":[{"key":"A","text":"李白"},{"key":"B","text":"柳宗元"},{"key":"C","text":"王之涣"},{"key":"D","text":"北朝民歌"}],"answer":"B","explanation":"《江雪》是柳宗元的诗。《望庐山瀑布》才是李白的。","verify":"\"柳宗元\""},{"id":"cnc_p110_q4","topicId":"cnc_p110","difficulty":"standard","type":"choice","prompt":"这首诗写的是怎样的景象？","choices":[{"key":"A","text":"草原上风吹草低，露出牛羊"},{"key":"B","text":"楼上伸手能摘到星星"},{"key":"C","text":"大雪盖住山路，鸟和行人都不见了，只剩渔翁独钓"},{"key":"D","text":"黄河向大海流去"}],"answer":"C","explanation":"千山鸟飞绝，万径人踪灭。不要和敕勒川、夜宿山寺装成一首。","verify":"\"大雪盖住山路，鸟和行人都不见了，只剩渔翁独钓\""},{"id":"cnc_p111_q1","topicId":"cnc_p111","difficulty":"basic","type":"choice","prompt":"「敕勒川，阴山下」的下一句是哪一句？","choices":[{"key":"A","text":"天似穹庐，笼盖四野"},{"key":"B","text":"天苍苍，野茫茫"},{"key":"C","text":"风吹草低见牛羊"},{"key":"D","text":"黄河入海流"}],"answer":"A","explanation":"先把天比作毡帐，笼盖着四面的原野，后面才是天苍苍、野茫茫。","verify":"\"天似穹庐，笼盖四野\""},{"id":"cnc_p111_q2","topicId":"cnc_p111","difficulty":"basic","type":"choice","prompt":"「天苍苍，野茫茫」的下一句是哪一句？","choices":[{"key":"A","text":"笼盖四野"},{"key":"B","text":"风吹草低见牛羊"},{"key":"C","text":"天似穹庐"},{"key":"D","text":"风吹草低现牛羊"}],"answer":"B","explanation":"风一吹，草低下去，牛羊就露出来。这里写的是「见」，不是「现」。","verify":"\"风吹草低见牛羊\""},{"id":"cnc_p111_q3","topicId":"cnc_p111","difficulty":"standard","type":"choice","prompt":"《敕勒歌》是怎样流传下来的？","choices":[{"key":"A","text":"李白写的"},{"key":"B","text":"王之涣写的"},{"key":"C","text":"北朝民歌"},{"key":"D","text":"杜甫写的"}],"answer":"C","explanation":"这是北朝民歌，不是唐人的绝句。不要安到李白名下。","verify":"\"北朝民歌\""},{"id":"cnc_p111_q4","topicId":"cnc_p111","difficulty":"standard","type":"choice","prompt":"「风吹草低见牛羊」的「见」在这里是什么意思？","choices":[{"key":"A","text":"只用眼睛看，读作 jiàn"},{"key":"B","text":"见面"},{"key":"C","text":"意见"},{"key":"D","text":"出现，读作 xiàn"}],"answer":"D","explanation":"草被风吹弯，牛羊显露出来。这里的「见」读 xiàn，是出现。","verify":"\"出现，读作 xiàn\""},{"id":"cnc_p112_q1","topicId":"cnc_p112","difficulty":"basic","type":"choice","prompt":"雾飞到海上，把什么藏了起来？","choices":[{"key":"A","text":"把太阳摘下来放进口袋"},{"key":"B","text":"大海，连海水、船只和远处都看不见了"},{"key":"C","text":"把雪山全部搬回家"},{"key":"D","text":"只藏起一块小石头"}],"answer":"B","explanation":"他说我要把大海藏起来。海上的景物就看不见了。","verify":"\"大海，连海水、船只和远处都看不见了\""},{"id":"cnc_p112_q2","topicId":"cnc_p112","difficulty":"basic","type":"choice","prompt":"雾来到城市，藏起了哪些东西？","choices":[{"key":"A","text":"只藏起课本"},{"key":"B","text":"把城市变成葡萄沟"},{"key":"C","text":"房屋、街道、树木、桥梁，还有行人和小黑猫"},{"key":"D","text":"什么也没藏，城市更清楚了"}],"answer":"C","explanation":"城市里原本看得见的，都被雾遮住了。","verify":"\"房屋、街道、树木、桥梁，还有行人和小黑猫\""},{"id":"cnc_p112_q3","topicId":"cnc_p112","difficulty":"standard","type":"choice","prompt":"雾最后说要把谁藏起来？","choices":[{"key":"A","text":"把太阳永远藏住"},{"key":"B","text":"把小黑猫单独留在外面"},{"key":"C","text":"把渔翁藏进井里"},{"key":"D","text":"他自己"}],"answer":"D","explanation":"他躲在上空，说现在该把自己藏起来。","verify":"\"他自己\""},{"id":"cnc_p112_q4","topicId":"cnc_p112","difficulty":"standard","type":"choice","prompt":"太阳出来以后怎样了？","choices":[{"key":"A","text":"雾消失了，大海、海岸和城市又露出来"},{"key":"B","text":"雾变得更厚，什么都不再出现"},{"key":"C","text":"城市被雾搬走了"},{"key":"D","text":"太阳也被雾藏住，再没出来"}],"answer":"A","explanation":"雾一散，船只、房屋、行人和小黑猫都又看见了。","verify":"\"雾消失了，大海、海岸和城市又露出来\""},{"id":"cnc_p113_q1","topicId":"cnc_p113","difficulty":"basic","type":"choice","prompt":"雪孩子是谁堆出来的？","choices":[{"key":"A","text":"小黑猫"},{"key":"B","text":"雾"},{"key":"C","text":"兔妈妈"},{"key":"D","text":"张衡"}],"answer":"C","explanation":"兔妈妈在门外空地上堆了雪孩子，给小白兔做伴。","verify":"\"兔妈妈\""},{"id":"cnc_p113_q2","topicId":"cnc_p113","difficulty":"basic","type":"choice","prompt":"兔妈妈出门前怎样交代？","choices":[{"key":"A","text":"叫小白兔自己去山上砍柴"},{"key":"B","text":"叫雪孩子去海里游泳"},{"key":"C","text":"叫他们把屋子点着"},{"key":"D","text":"雪孩子陪着小白兔，小白兔别出屋"}],"answer":"D","explanation":"她让雪孩子陪伴，还叮嘱小白兔不要出去。","verify":"\"雪孩子陪着小白兔，小白兔别出屋\""},{"id":"cnc_p113_q3","topicId":"cnc_p113","difficulty":"standard","type":"choice","prompt":"屋子着火时，雪孩子怎样做？","choices":[{"key":"A","text":"冲进屋里，把小白兔抱出来"},{"key":"B","text":"站在外面看着"},{"key":"C","text":"把火浇得更旺"},{"key":"D","text":"自己先跑进森林"}],"answer":"A","explanation":"小白兔睡得正香。雪孩子发现火，把他救了出来。","verify":"\"冲进屋里，把小白兔抱出来\""},{"id":"cnc_p113_q4","topicId":"cnc_p113","difficulty":"standard","type":"choice","prompt":"雪孩子后来怎样了？","choices":[{"key":"A","text":"变成一只真的兔子"},{"key":"B","text":"化成水，变成天上的一朵白云"},{"key":"C","text":"变成一块不会化的冰，永远坐在门口"},{"key":"D","text":"飞去摘星星"}],"answer":"B","explanation":"救出小白兔后，雪孩子全身水淋淋的。小白兔后来看见的白云，就是他。","verify":"\"化成水，变成天上的一朵白云\""},{"id":"cnc_p114_q1","topicId":"cnc_p114","difficulty":"basic","type":"choice","prompt":"「危楼高百尺」的下一句是哪一句？","choices":[{"key":"A","text":"不敢高声语"},{"key":"B","text":"恐惊天上人"},{"key":"C","text":"更上一层楼"},{"key":"D","text":"手可摘星辰"}],"answer":"D","explanation":"楼高得好像一伸手就能摘到星星，后面才写不敢高声说话。","verify":"\"手可摘星辰\""},{"id":"cnc_p114_q2","topicId":"cnc_p114","difficulty":"basic","type":"choice","prompt":"「不敢高声语」的下一句是哪一句？","choices":[{"key":"A","text":"恐惊天上人"},{"key":"B","text":"恐惊天上神"},{"key":"C","text":"手可摘星辰"},{"key":"D","text":"疑是银河落九天"}],"answer":"A","explanation":"不敢大声说话，是怕惊动天上的人。不是「天上神」，也不是庐山瀑布那一句。","verify":"\"恐惊天上人\""},{"id":"cnc_p114_q3","topicId":"cnc_p114","difficulty":"standard","type":"choice","prompt":"《夜宿山寺》的作者是谁？","choices":[{"key":"A","text":"王之涣"},{"key":"B","text":"李白"},{"key":"C","text":"柳宗元"},{"key":"D","text":"北朝民歌"}],"answer":"B","explanation":"这首诗是李白写的。《江雪》是柳宗元的，《登鹳雀楼》是王之涣的。","verify":"\"李白\""},{"id":"cnc_p114_q4","topicId":"cnc_p114","difficulty":"standard","type":"choice","prompt":"诗人为什么不敢高声说话？","choices":[{"key":"A","text":"山寺里有人在睡觉，老师不许说话"},{"key":"B","text":"星星会掉下来"},{"key":"C","text":"楼高得像在天上，怕惊动天上的人"},{"key":"D","text":"黄河就在脚下"}],"answer":"C","explanation":"危楼高百尺，手可摘星辰。所以恐惊天上人。","verify":"\"楼高得像在天上，怕惊动天上的人\""}]
