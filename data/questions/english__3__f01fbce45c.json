[{"id":"cne_p043_q1","topicId":"cne_p043","difficulty":"basic","type":"choice","prompt":"哪个单词含有短元音 o？","choices":[{"key":"A","text":"dog"},{"key":"B","text":"note"},{"key":"C","text":"nose"},{"key":"D","text":"cake"}],"answer":"A","explanation":"dog 含有短元音 o。","verify":"\"dog\""},{"id":"cne_p043_q2","topicId":"cne_p043","difficulty":"basic","type":"choice","prompt":"哪个单词不含短元音 o？","choices":[{"key":"A","text":"dog"},{"key":"B","text":"note"},{"key":"C","text":"box"},{"key":"D","text":"hot"}],"answer":"B","explanation":"note 不含短元音 o。","verify":"\"note\""},{"id":"cne_p043_q3","topicId":"cne_p043","difficulty":"standard","type":"choice","prompt":"box 和哪个词的元音相同？","choices":[{"key":"A","text":"note"},{"key":"B","text":"nose"},{"key":"C","text":"hot"},{"key":"D","text":"cake"}],"answer":"C","explanation":"box 和 hot 都含有短元音 o。","verify":"\"hot\""},{"id":"cne_p043_q4","topicId":"cne_p043","difficulty":"standard","type":"choice","prompt":"选择含有短元音 o的单词。","choices":[{"key":"A","text":"nose"},{"key":"B","text":"cake"},{"key":"C","text":"he"},{"key":"D","text":"not"}],"answer":"D","explanation":"not 含有短元音 o。","verify":"\"not\""},{"id":"cne_p058_q1","topicId":"cne_p058","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「教室」？","choices":[{"key":"A","text":"window"},{"key":"B","text":"door"},{"key":"C","text":"blackboard"},{"key":"D","text":"classroom"}],"answer":"D","explanation":"classroom 的意思是教室。","verify":"\"classroom\""},{"id":"cne_p058_q2","topicId":"cne_p058","difficulty":"basic","type":"choice","prompt":"「window」的中文意思是哪一个？","choices":[{"key":"A","text":"窗户"},{"key":"B","text":"教室"},{"key":"C","text":"门"},{"key":"D","text":"黑板"}],"answer":"A","explanation":"window 的意思是窗户。","verify":"\"窗户\""},{"id":"cne_p058_q3","topicId":"cne_p058","difficulty":"standard","type":"choice","prompt":"选择表示「门」的单词。","choices":[{"key":"A","text":"classroom"},{"key":"B","text":"door"},{"key":"C","text":"window"},{"key":"D","text":"blackboard"}],"answer":"B","explanation":"表示门的单词是 door。","verify":"\"door\""},{"id":"cne_p058_q4","topicId":"cne_p058","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「黑板」？","choices":[{"key":"A","text":"classroom"},{"key":"B","text":"window"},{"key":"C","text":"blackboard"},{"key":"D","text":"door"}],"answer":"C","explanation":"blackboard 的意思是黑板。","verify":"\"blackboard\""},{"id":"cne_p059_q1","topicId":"cne_p059","difficulty":"basic","type":"choice","prompt":"建议一起打开书，应选哪一句？","choices":[{"key":"A","text":"Let's open the book."},{"key":"B","text":"Let open the book."},{"key":"C","text":"Let's opens the book."},{"key":"D","text":"Let is open the book."}],"answer":"A","explanation":"建议一起做用 Let's 加动词原形。","verify":"\"Let's open the book.\""},{"id":"cne_p059_q2","topicId":"cne_p059","difficulty":"basic","type":"choice","prompt":"Let's clean the classroom. 这句是在做什么？","choices":[{"key":"A","text":"询问教室在哪里"},{"key":"B","text":"建议一起打扫教室"},{"key":"C","text":"说明教室是谁的"},{"key":"D","text":"询问有多少教室"}],"answer":"B","explanation":"Let's 是在建议一起做。","verify":"\"建议一起打扫教室\""},{"id":"cne_p059_q3","topicId":"cne_p059","difficulty":"standard","type":"choice","prompt":"哪一句是正确的建议句？","choices":[{"key":"A","text":"Let's goes."},{"key":"B","text":"Let we go."},{"key":"C","text":"Let's go."},{"key":"D","text":"Let's going."}],"answer":"C","explanation":"Let's 后面用动词原形 go。","verify":"\"Let's go.\""},{"id":"cne_p059_q4","topicId":"cne_p059","difficulty":"standard","type":"choice","prompt":"Let's be friends. 这句的意思是？","choices":[{"key":"A","text":"我们不是朋友"},{"key":"B","text":"你是我的朋友吗"},{"key":"C","text":"他是朋友"},{"key":"D","text":"我们做朋友吧"}],"answer":"D","explanation":"Let's be friends 是建议做朋友。","verify":"\"我们做朋友吧\""},{"id":"cne_p060_q1","topicId":"cne_p060","difficulty":"basic","type":"choice","prompt":"建议一起擦黑板，应说哪一句？","choices":[{"key":"A","text":"Let's open the door."},{"key":"B","text":"Let's clean the blackboard."},{"key":"C","text":"Let's close the window."},{"key":"D","text":"Let's sit down."}],"answer":"B","explanation":"黑板是 blackboard。","verify":"\"Let's clean the blackboard.\""},{"id":"cne_p060_q2","topicId":"cne_p060","difficulty":"basic","type":"choice","prompt":"Let's open the door. 建议做什么？","choices":[{"key":"A","text":"关门"},{"key":"B","text":"开窗"},{"key":"C","text":"开门"},{"key":"D","text":"擦黑板"}],"answer":"C","explanation":"open the door 是开门。","verify":"\"开门\""},{"id":"cne_p060_q3","topicId":"cne_p060","difficulty":"standard","type":"choice","prompt":"Close the window, please. 这句是在说什么？","choices":[{"key":"A","text":"请打开窗户"},{"key":"B","text":"请打开门"},{"key":"C","text":"请坐下"},{"key":"D","text":"请关上窗户"}],"answer":"D","explanation":"Close the window 是关窗。","verify":"\"请关上窗户\""},{"id":"cne_p060_q4","topicId":"cne_p060","difficulty":"standard","type":"choice","prompt":"We have a new classroom. 这句的意思是？","choices":[{"key":"A","text":"我们有一间新教室"},{"key":"B","text":"我们有一块新黑板"},{"key":"C","text":"请打开门"},{"key":"D","text":"我们做朋友吧"}],"answer":"A","explanation":"classroom 是教室。","verify":"\"我们有一间新教室\""},{"id":"cne_p061_q1","topicId":"cne_p061","difficulty":"basic","type":"choice","prompt":"读一读：Let's clean the classroom. Open the door, please. 建议先提到的是什么？","choices":[{"key":"A","text":"关门"},{"key":"B","text":"开窗"},{"key":"C","text":"打扫教室"},{"key":"D","text":"坐下"}],"answer":"C","explanation":"第一句是 clean the classroom。","verify":"\"打扫教室\""},{"id":"cne_p061_q2","topicId":"cne_p061","difficulty":"basic","type":"choice","prompt":"读一读：The window is blue. The door is yellow. 门是什么颜色？","choices":[{"key":"A","text":"蓝色"},{"key":"B","text":"绿色"},{"key":"C","text":"红色"},{"key":"D","text":"黄色"}],"answer":"D","explanation":"door is yellow。","verify":"\"黄色\""},{"id":"cne_p061_q3","topicId":"cne_p061","difficulty":"standard","type":"choice","prompt":"读一读：This is our classroom. We have a big blackboard. 哪一句和短文一致？","choices":[{"key":"A","text":"教室里有一块大黑板。"},{"key":"B","text":"教室里没有黑板。"},{"key":"C","text":"窗户是黑色的。"},{"key":"D","text":"门是蓝色的。"}],"answer":"A","explanation":"短文写 We have a big blackboard。","verify":"\"教室里有一块大黑板。\""},{"id":"cne_p061_q4","topicId":"cne_p061","difficulty":"standard","type":"choice","prompt":"读一读：Let's close the window. 哪一句和文字意思相同？","choices":[{"key":"A","text":"我们把窗户打开吧。"},{"key":"B","text":"我们把窗户关上吧。"},{"key":"C","text":"我们把门打开吧。"},{"key":"D","text":"我们擦黑板吧。"}],"answer":"B","explanation":"close the window 是关窗。","verify":"\"我们把窗户关上吧。\""},{"id":"cne_p063_q1","topicId":"cne_p063","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「书包」？","choices":[{"key":"A","text":"schoolbag"},{"key":"B","text":"pencil"},{"key":"C","text":"ruler"},{"key":"D","text":"eraser"}],"answer":"A","explanation":"schoolbag 的意思是书包。","verify":"\"schoolbag\""},{"id":"cne_p063_q2","topicId":"cne_p063","difficulty":"basic","type":"choice","prompt":"「pencil」的中文意思是哪一个？","choices":[{"key":"A","text":"书包"},{"key":"B","text":"铅笔"},{"key":"C","text":"尺子"},{"key":"D","text":"橡皮"}],"answer":"B","explanation":"pencil 的意思是铅笔。","verify":"\"铅笔\""},{"id":"cne_p063_q3","topicId":"cne_p063","difficulty":"standard","type":"choice","prompt":"选择表示「尺子」的单词。","choices":[{"key":"A","text":"schoolbag"},{"key":"B","text":"pencil"},{"key":"C","text":"ruler"},{"key":"D","text":"eraser"}],"answer":"C","explanation":"表示尺子的单词是 ruler。","verify":"\"ruler\""},{"id":"cne_p063_q4","topicId":"cne_p063","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「橡皮」？","choices":[{"key":"A","text":"schoolbag"},{"key":"B","text":"pencil"},{"key":"C","text":"ruler"},{"key":"D","text":"eraser"}],"answer":"D","explanation":"eraser 的意思是橡皮。","verify":"\"eraser\""},{"id":"cne_p064_q1","topicId":"cne_p064","difficulty":"basic","type":"choice","prompt":"想问书包里有什么，应说哪一句？","choices":[{"key":"A","text":"Where is your schoolbag?"},{"key":"B","text":"What is in your schoolbag?"},{"key":"C","text":"What colour is your schoolbag?"},{"key":"D","text":"Who is your schoolbag?"}],"answer":"B","explanation":"问里面有什么用 What is in。","verify":"\"What is in your schoolbag?\""},{"id":"cne_p064_q2","topicId":"cne_p064","difficulty":"basic","type":"choice","prompt":"I have a pencil and a ruler. 书包里有什么？","choices":[{"key":"A","text":"铅笔和橡皮"},{"key":"B","text":"尺子和橡皮"},{"key":"C","text":"铅笔和尺子"},{"key":"D","text":"只铅笔"}],"answer":"C","explanation":"pencil 是铅笔，ruler 是尺子。","verify":"\"铅笔和尺子\""},{"id":"cne_p064_q3","topicId":"cne_p064","difficulty":"standard","type":"choice","prompt":"Put your eraser in the schoolbag. 要把什么放进书包？","choices":[{"key":"A","text":"铅笔"},{"key":"B","text":"尺子"},{"key":"C","text":"书"},{"key":"D","text":"橡皮"}],"answer":"D","explanation":"eraser 是橡皮。","verify":"\"橡皮\""},{"id":"cne_p064_q4","topicId":"cne_p064","difficulty":"standard","type":"choice","prompt":"哪一句表示「我有一把尺子」？","choices":[{"key":"A","text":"I have a ruler."},{"key":"B","text":"I have an eraser."},{"key":"C","text":"I have a pencil."},{"key":"D","text":"I have a schoolbag."}],"answer":"A","explanation":"尺子是 ruler。","verify":"\"I have a ruler.\""},{"id":"cne_p065_q1","topicId":"cne_p065","difficulty":"basic","type":"choice","prompt":"读一读：I have a new schoolbag. It is black. 书包是什么颜色？","choices":[{"key":"A","text":"蓝色"},{"key":"B","text":"黄色"},{"key":"C","text":"黑色"},{"key":"D","text":"绿色"}],"answer":"C","explanation":"文字写 It is black。","verify":"\"黑色\""},{"id":"cne_p065_q2","topicId":"cne_p065","difficulty":"basic","type":"choice","prompt":"读一读：What is in your schoolbag? A pencil and an eraser. 里面有什么？","choices":[{"key":"A","text":"尺子和书"},{"key":"B","text":"只铅笔"},{"key":"C","text":"只橡皮"},{"key":"D","text":"铅笔和橡皮"}],"answer":"D","explanation":"a pencil and an eraser。","verify":"\"铅笔和橡皮\""},{"id":"cne_p065_q3","topicId":"cne_p065","difficulty":"standard","type":"numeric","prompt":"读一读：I have three pencils and one ruler. 铅笔有几支？","answer":"3","explanation":"three pencils 是 3 支。","verify":"3"},{"id":"cne_p065_q4","topicId":"cne_p065","difficulty":"standard","type":"choice","prompt":"读一读：The ruler is blue. The eraser is white. 哪一句和文字一致？","choices":[{"key":"A","text":"尺子是白色的。"},{"key":"B","text":"尺子是蓝色的。"},{"key":"C","text":"橡皮是蓝色的。"},{"key":"D","text":"书包是蓝色的。"}],"answer":"B","explanation":"ruler is blue。","verify":"\"尺子是蓝色的。\""},{"id":"cne_p066_q1","topicId":"cne_p066","difficulty":"basic","type":"choice","prompt":"哪个单词含有o-e 的读音？","choices":[{"key":"A","text":"dog"},{"key":"B","text":"box"},{"key":"C","text":"hot"},{"key":"D","text":"nose"}],"answer":"D","explanation":"nose 含有o-e 的读音。","verify":"\"nose\""},{"id":"cne_p066_q2","topicId":"cne_p066","difficulty":"basic","type":"choice","prompt":"哪个单词不含o-e 的读音？","choices":[{"key":"A","text":"dog"},{"key":"B","text":"nose"},{"key":"C","text":"note"},{"key":"D","text":"home"}],"answer":"A","explanation":"dog 不含o-e 的读音。","verify":"\"dog\""},{"id":"cne_p066_q3","topicId":"cne_p066","difficulty":"standard","type":"choice","prompt":"note 和哪个词的元音相同？","choices":[{"key":"A","text":"dog"},{"key":"B","text":"home"},{"key":"C","text":"box"},{"key":"D","text":"hot"}],"answer":"B","explanation":"note 和 home 都含有o-e 的读音。","verify":"\"home\""},{"id":"cne_p066_q4","topicId":"cne_p066","difficulty":"standard","type":"choice","prompt":"选择含有o-e 的读音的单词。","choices":[{"key":"A","text":"box"},{"key":"B","text":"hot"},{"key":"C","text":"rose"},{"key":"D","text":"not"}],"answer":"C","explanation":"rose 含有o-e 的读音。","verify":"\"rose\""}]
