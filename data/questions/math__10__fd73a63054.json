[{"id":"cnm_h041_q1","topicId":"cnm_h041","difficulty":"basic","type":"numeric","prompt":"f(x)=2^x，求 f(5)。","answer":"32","explanation":"2⁵=32。","verify":"2**5"},{"id":"cnm_h041_q2","topicId":"cnm_h041","difficulty":"basic","type":"numeric","prompt":"f(x)=3^x，求 f(0)。","answer":"1","explanation":"非零数的 0 次方是 1。","verify":"3**0"},{"id":"cnm_h041_q3","topicId":"cnm_h041","difficulty":"standard","type":"numeric","prompt":"f(x)=(1/2)^x，求 f(3)。","answer":"1/8","explanation":"(1/2)³=1/8。","verify":"Fraction(1,2)**3"},{"id":"cnm_h041_q4","topicId":"cnm_h041","difficulty":"standard","type":"choice","prompt":"下面哪个是指数函数？","choices":[{"key":"A","text":"y=x²"},{"key":"B","text":"y=2^x"},{"key":"C","text":"y=2·x"},{"key":"D","text":"y=2^x+1"}],"answer":"B","explanation":"指数函数是底数为常数、指数为自变量，并且没有另外的系数和常数项。y=2^x+1 是指数函数的平移。","verify":"\"y=2^x\""},{"id":"cnm_h042_q1","topicId":"cnm_h042","difficulty":"basic","type":"choice","prompt":"y=2^x 在实数集上是？","choices":[{"key":"A","text":"减函数"},{"key":"B","text":"先增后减"},{"key":"C","text":"不单调"},{"key":"D","text":"增函数"}],"answer":"D","explanation":"底数 2 大于 1，指数函数递增。","verify":"\"增函数\""},{"id":"cnm_h042_q2","topicId":"cnm_h042","difficulty":"basic","type":"choice","prompt":"y=(1/2)^x 在实数集上是？","choices":[{"key":"A","text":"减函数"},{"key":"B","text":"增函数"},{"key":"C","text":"先减后增"},{"key":"D","text":"常函数"}],"answer":"A","explanation":"底数在 0 和 1 之间，指数函数递减。","verify":"\"减函数\""},{"id":"cnm_h042_q3","topicId":"cnm_h042","difficulty":"standard","type":"numeric","prompt":"比较 2⁵ 与 2³，计算 2⁵−2³。","answer":"24","explanation":"32−8=24，差为正，所以 2⁵ 更大，与递增一致。","verify":"2**5-2**3"},{"id":"cnm_h042_q4","topicId":"cnm_h042","difficulty":"standard","type":"numeric","prompt":"2^x=8 时，x 是多少？","answer":"3","explanation":"8=2³，所以 x=3。","verify":"3"}]
