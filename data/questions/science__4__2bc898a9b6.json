[{"id":"cns_p107_q1","topicId":"cns_p107","difficulty":"basic","type":"choice","prompt":"人吸入的气体中，身体需要的是什么？","choices":[{"key":"A","text":"氧气"},{"key":"B","text":"二氧化碳"},{"key":"C","text":"水蒸气"},{"key":"D","text":"灰尘"}],"answer":"A","explanation":"人体需要氧气。","verify":"\"氧气\""},{"id":"cns_p107_q2","topicId":"cns_p107","difficulty":"basic","type":"choice","prompt":"人呼出的气体中，什么气体比吸入时多？","choices":[{"key":"A","text":"氧气"},{"key":"B","text":"二氧化碳"},{"key":"C","text":"氮气比原来多很多"},{"key":"D","text":"没有变化"}],"answer":"B","explanation":"呼出气体中二氧化碳增多。","verify":"\"二氧化碳\""},{"id":"cns_p107_q3","topicId":"cns_p107","difficulty":"standard","type":"choice","prompt":"消化的作用是什么？","choices":[{"key":"A","text":"把空气变成食物"},{"key":"B","text":"让身体变重"},{"key":"C","text":"把食物变成身体能吸收的营养"},{"key":"D","text":"把水变成冰"}],"answer":"C","explanation":"消化把食物分解成能被吸收的物质。","verify":"\"把食物变成身体能吸收的营养\""},{"id":"cns_p107_q4","topicId":"cns_p107","difficulty":"challenge","type":"choice","prompt":"人几分钟不呼吸就会有生命危险，而几天不吃饭还能坚持，这说明什么？","choices":[{"key":"A","text":"人不需要食物"},{"key":"B","text":"呼吸不重要"},{"key":"C","text":"吃饭比呼吸更紧迫"},{"key":"D","text":"身体对氧气的需要更加紧迫"}],"answer":"D","explanation":"身体时刻需要氧气，储存很少。","verify":"\"身体对氧气的需要更加紧迫\""},{"id":"cns_p108_q1","topicId":"cns_p108","difficulty":"basic","type":"choice","prompt":"人体进行气体交换的主要器官是什么？","choices":[{"key":"A","text":"胃"},{"key":"B","text":"肺"},{"key":"C","text":"心脏"},{"key":"D","text":"肝"}],"answer":"B","explanation":"肺是气体交换的场所。","verify":"\"肺\""},{"id":"cns_p108_q2","topicId":"cns_p108","difficulty":"basic","type":"choice","prompt":"空气进入肺的顺序是怎样的？","choices":[{"key":"A","text":"口→胃→肺"},{"key":"B","text":"肺→气管→鼻"},{"key":"C","text":"鼻→咽→喉→气管→支气管→肺"},{"key":"D","text":"鼻→胃→肺"}],"answer":"C","explanation":"这是呼吸道的顺序。","verify":"\"鼻→咽→喉→气管→支气管→肺\""},{"id":"cns_p108_q3","topicId":"cns_p108","difficulty":"standard","type":"choice","prompt":"为什么用鼻子呼吸比用嘴呼吸好？","choices":[{"key":"A","text":"鼻子更大"},{"key":"B","text":"嘴不能呼吸"},{"key":"C","text":"鼻子能尝味道"},{"key":"D","text":"鼻腔能温暖、湿润、过滤空气"}],"answer":"D","explanation":"鼻毛和黏液能清洁空气。","verify":"\"鼻腔能温暖、湿润、过滤空气\""},{"id":"cns_p108_q4","topicId":"cns_p108","difficulty":"challenge","type":"choice","prompt":"吸气时，胸腔会怎样变化？","choices":[{"key":"A","text":"扩大"},{"key":"B","text":"缩小"},{"key":"C","text":"不变"},{"key":"D","text":"下降变小"}],"answer":"A","explanation":"吸气时胸腔扩大，空气进入肺。","verify":"\"扩大\""},{"id":"cns_p109_q1","topicId":"cns_p109","difficulty":"basic","type":"choice","prompt":"跑步后，呼吸会怎样？","choices":[{"key":"A","text":"变慢"},{"key":"B","text":"停止"},{"key":"C","text":"加快加深"},{"key":"D","text":"不变"}],"answer":"C","explanation":"运动时身体需要更多氧气。","verify":"\"加快加深\""},{"id":"cns_p109_q2","topicId":"cns_p109","difficulty":"basic","type":"choice","prompt":"测量 1 分钟呼吸次数，最准确的方法是？","choices":[{"key":"A","text":"只数 5 秒随便估"},{"key":"B","text":"跑步时随便数"},{"key":"C","text":"数心跳"},{"key":"D","text":"安静时数 1 分钟内胸部起伏的次数"}],"answer":"D","explanation":"一起一伏为一次呼吸。","verify":"\"安静时数 1 分钟内胸部起伏的次数\""},{"id":"cns_p109_q3","topicId":"cns_p109","difficulty":"standard","type":"choice","prompt":"肺活量是指什么？","choices":[{"key":"A","text":"尽力吸气后，再尽力呼出的气体量"},{"key":"B","text":"一次正常呼吸的气体量"},{"key":"C","text":"一分钟呼吸次数"},{"key":"D","text":"肺的重量"}],"answer":"A","explanation":"这是肺活量的含义。","verify":"\"尽力吸气后，再尽力呼出的气体量\""},{"id":"cns_p109_q4","topicId":"cns_p109","difficulty":"challenge","type":"choice","prompt":"小明三次测肺活量分别是 1800、2000、1900 毫升，他的肺活量通常怎样记录？","choices":[{"key":"A","text":"取最小值 1800 毫升"},{"key":"B","text":"取最大值 2000 毫升"},{"key":"C","text":"三个加起来 5700 毫升"},{"key":"D","text":"只记第一次"}],"answer":"B","explanation":"肺活量测试一般取几次中的最大值。","verify":"\"取最大值 2000 毫升\""},{"id":"cns_p110_q1","topicId":"cns_p110","difficulty":"basic","type":"choice","prompt":"口腔里帮助磨碎食物的是什么？","choices":[{"key":"A","text":"舌头上的味蕾"},{"key":"B","text":"嘴唇"},{"key":"C","text":"鼻子"},{"key":"D","text":"牙齿"}],"answer":"D","explanation":"牙齿切断、撕裂、磨碎食物。","verify":"\"牙齿\""},{"id":"cns_p110_q2","topicId":"cns_p110","difficulty":"basic","type":"choice","prompt":"馒头在嘴里嚼久了会觉得甜，是因为什么？","choices":[{"key":"A","text":"唾液把淀粉变成了有甜味的物质"},{"key":"B","text":"馒头里加了糖"},{"key":"C","text":"牙齿是甜的"},{"key":"D","text":"舌头变了"}],"answer":"A","explanation":"唾液能初步分解淀粉。","verify":"\"唾液把淀粉变成了有甜味的物质\""},{"id":"cns_p110_q3","topicId":"cns_p110","difficulty":"standard","type":"choice","prompt":"门牙主要用来做什么？","choices":[{"key":"A","text":"磨碎食物"},{"key":"B","text":"切断食物"},{"key":"C","text":"撕裂食物"},{"key":"D","text":"吞咽食物"}],"answer":"B","explanation":"门牙切断，犬齿撕裂，臼齿磨碎。","verify":"\"切断食物\""},{"id":"cns_p110_q4","topicId":"cns_p110","difficulty":"challenge","type":"choice","prompt":"吃饭时细嚼慢咽有什么好处？","choices":[{"key":"A","text":"让饭变凉"},{"key":"B","text":"没有好处"},{"key":"C","text":"减轻胃的负担，帮助消化"},{"key":"D","text":"让人吃得更多"}],"answer":"C","explanation":"食物嚼碎后更容易消化。","verify":"\"减轻胃的负担，帮助消化\""},{"id":"cns_p111_q1","topicId":"cns_p111","difficulty":"basic","type":"choice","prompt":"食物离开口腔后，经过什么进入胃？","choices":[{"key":"A","text":"食道"},{"key":"B","text":"气管"},{"key":"C","text":"大肠"},{"key":"D","text":"肺"}],"answer":"A","explanation":"口腔→咽→食道→胃。","verify":"\"食道\""},{"id":"cns_p111_q2","topicId":"cns_p111","difficulty":"basic","type":"choice","prompt":"吸收营养的主要器官是什么？","choices":[{"key":"A","text":"胃"},{"key":"B","text":"小肠"},{"key":"C","text":"大肠"},{"key":"D","text":"食道"}],"answer":"B","explanation":"小肠很长，内壁有许多皱褶，适合吸收营养。","verify":"\"小肠\""},{"id":"cns_p111_q3","topicId":"cns_p111","difficulty":"standard","type":"choice","prompt":"大肠的主要作用是什么？","choices":[{"key":"A","text":"磨碎食物"},{"key":"B","text":"吸收大部分营养"},{"key":"C","text":"吸收部分水分，形成粪便"},{"key":"D","text":"分泌唾液"}],"answer":"C","explanation":"大肠吸收水分，形成并排出粪便。","verify":"\"吸收部分水分，形成粪便\""},{"id":"cns_p111_q4","topicId":"cns_p111","difficulty":"challenge","type":"choice","prompt":"饭后立即剧烈运动为什么不好？","choices":[{"key":"A","text":"会让食物变冷"},{"key":"B","text":"会让人长高"},{"key":"C","text":"没有影响"},{"key":"D","text":"会影响胃肠消化，可能引起腹痛"}],"answer":"D","explanation":"饭后剧烈运动会影响消化。","verify":"\"会影响胃肠消化，可能引起腹痛\""},{"id":"cns_p112_q1","topicId":"cns_p112","difficulty":"basic","type":"choice","prompt":"食物在消化道里的顺序是哪一种？","choices":[{"key":"A","text":"口腔→胃→食道→大肠→小肠"},{"key":"B","text":"口腔→食道→胃→小肠→大肠"},{"key":"C","text":"食道→口腔→胃→小肠"},{"key":"D","text":"口腔→小肠→胃→大肠"}],"answer":"B","explanation":"这是消化道的正确顺序。","verify":"\"口腔→食道→胃→小肠→大肠\""},{"id":"cns_p112_q2","topicId":"cns_p112","difficulty":"basic","type":"choice","prompt":"消化道中最长的部分是什么？","choices":[{"key":"A","text":"食道"},{"key":"B","text":"胃"},{"key":"C","text":"小肠"},{"key":"D","text":"口腔"}],"answer":"C","explanation":"成人小肠长约 5～6 米。","verify":"\"小肠\""},{"id":"cns_p112_q3","topicId":"cns_p112","difficulty":"standard","type":"choice","prompt":"用一根长绳和小袋子做消化道模型，「小袋子」最适合代表什么？","choices":[{"key":"A","text":"牙齿"},{"key":"B","text":"肺"},{"key":"C","text":"心脏"},{"key":"D","text":"胃"}],"answer":"D","explanation":"胃像一个能伸缩的袋子。","verify":"\"胃\""},{"id":"cns_p112_q4","topicId":"cns_p112","difficulty":"challenge","type":"choice","prompt":"下面哪一个不是消化道的一部分？","choices":[{"key":"A","text":"肺"},{"key":"B","text":"胃"},{"key":"C","text":"小肠"},{"key":"D","text":"食道"}],"answer":"A","explanation":"肺属于呼吸系统。","verify":"\"肺\""},{"id":"cns_p113_q1","topicId":"cns_p113","difficulty":"basic","type":"choice","prompt":"下面哪种习惯有利于保护呼吸器官？","choices":[{"key":"A","text":"在灰尘大的地方大口呼吸"},{"key":"B","text":"经常用嘴呼吸"},{"key":"C","text":"不吸烟，远离二手烟"},{"key":"D","text":"在车多的路边跑步"}],"answer":"C","explanation":"吸烟和烟尘伤害呼吸道和肺。","verify":"\"不吸烟，远离二手烟\""},{"id":"cns_p113_q2","topicId":"cns_p113","difficulty":"basic","type":"choice","prompt":"下面哪种饮食习惯有利于消化？","choices":[{"key":"A","text":"饿一顿饱一顿"},{"key":"B","text":"只吃零食"},{"key":"C","text":"吃得越快越好"},{"key":"D","text":"按时吃饭，不暴饮暴食"}],"answer":"D","explanation":"规律饮食有利于胃肠健康。","verify":"\"按时吃饭，不暴饮暴食\""},{"id":"cns_p113_q3","topicId":"cns_p113","difficulty":"standard","type":"choice","prompt":"雾霾严重的天气，外出时应该怎样做？","choices":[{"key":"A","text":"戴好口罩，减少户外运动"},{"key":"B","text":"多在户外跑步"},{"key":"C","text":"张大嘴呼吸"},{"key":"D","text":"不用防护"}],"answer":"A","explanation":"口罩能挡住部分颗粒物。","verify":"\"戴好口罩，减少户外运动\""},{"id":"cns_p113_q4","topicId":"cns_p113","difficulty":"challenge","type":"choice","prompt":"吃饭时说笑打闹为什么危险？","choices":[{"key":"A","text":"食物会变凉"},{"key":"B","text":"食物可能误入气管引起呛咳"},{"key":"C","text":"会吃不饱"},{"key":"D","text":"没有危险"}],"answer":"B","explanation":"吞咽和说话同时进行，食物可能进入气管。","verify":"\"食物可能误入气管引起呛咳\""}]
