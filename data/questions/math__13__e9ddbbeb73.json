[{"id":"cnm_h207_q1","topicId":"cnm_h207","difficulty":"basic","type":"numeric","prompt":"等比数列 2，6，18，54 的公比是多少？","answer":"3","explanation":"后一项除以前一项：6/2=3。","verify":"6//2"},{"id":"cnm_h207_q2","topicId":"cnm_h207","difficulty":"basic","type":"choice","prompt":"数列 5，5，5，5 是不是等比数列？","choices":[{"key":"A","text":"不是，公比不能是 1"},{"key":"B","text":"是，公比为 1"},{"key":"C","text":"不是，因为差是 0"},{"key":"D","text":"是，公比为 5"}],"answer":"B","explanation":"相邻比都是 1，公比为 1，它同时是等差数列和等比数列。","verify":"\"是，公比为 1\""},{"id":"cnm_h207_q3","topicId":"cnm_h207","difficulty":"standard","type":"numeric","prompt":"首项是 3，公比是 −2。第 2 项是多少？","answer":"-6","explanation":"3×(−2)=−6。","verify":"3*(-2)"},{"id":"cnm_h207_q4","topicId":"cnm_h207","difficulty":"standard","type":"choice","prompt":"等比数列的各项可以有 0 吗？","choices":[{"key":"A","text":"可以，公比为 0"},{"key":"B","text":"可以，只要项数有限"},{"key":"C","text":"必须每一项都是 0"},{"key":"D","text":"不可以，否则后一项与前一项的比没有意义或不能保持同一公比"}],"answer":"D","explanation":"若某一项是 0，下一项与它的比不能是固定的非零常数。教材要求公比不为 0，各项也不为 0。","verify":"\"不可以，否则后一项与前一项的比没有意义或不能保持同一公比\""},{"id":"cnm_h208_q1","topicId":"cnm_h208","difficulty":"basic","type":"numeric","prompt":"等比数列 a_1=2，q=3。a_4 等于多少？","answer":"54","explanation":"a_4=2×3³=54。","verify":"2*3**3"},{"id":"cnm_h208_q2","topicId":"cnm_h208","difficulty":"basic","type":"numeric","prompt":"等比数列 a_1=5，q=2。a_3 等于多少？","answer":"20","explanation":"5×4=20。","verify":"5*2**2"},{"id":"cnm_h208_q3","topicId":"cnm_h208","difficulty":"standard","type":"numeric","prompt":"等比数列 a_2=6，a_5=48，公比为正。公比是多少？","answer":"2","explanation":"a_5=a_2·q³，48=6q³，q³=8，q=2。","verify":"2"},{"id":"cnm_h208_q4","topicId":"cnm_h208","difficulty":"standard","type":"choice","prompt":"公比是 −1 的等比数列，相邻两项怎样？","choices":[{"key":"A","text":"互为相反数"},{"key":"B","text":"始终相等"},{"key":"C","text":"每一项都是 0"},{"key":"D","text":"公差是 −1"}],"answer":"A","explanation":"乘 −1 后变号，所以相邻两项互为相反数。","verify":"\"互为相反数\""},{"id":"cnm_h209_q1","topicId":"cnm_h209","difficulty":"basic","type":"numeric","prompt":"2 和 8 的正等比中项是多少？","answer":"4","explanation":"G²=16，取正数 G=4。","verify":"isqrt(2*8)"},{"id":"cnm_h209_q2","topicId":"cnm_h209","difficulty":"basic","type":"numeric","prompt":"正数 3 和 12 的等比中项是多少？","answer":"6","explanation":"G²=36，G=6。","verify":"isqrt(3*12)"},{"id":"cnm_h209_q3","topicId":"cnm_h209","difficulty":"standard","type":"choice","prompt":"两个正数的等比中项满足什么？","choices":[{"key":"A","text":"平方等于这两个数的积"},{"key":"B","text":"二倍等于这两个数的和"},{"key":"C","text":"等于这两个数的差"},{"key":"D","text":"等于这两个数的和"}],"answer":"A","explanation":"G²=ab。二倍等于两端之和的是等差中项。","verify":"\"平方等于这两个数的积\""},{"id":"cnm_h209_q4","topicId":"cnm_h209","difficulty":"standard","type":"numeric","prompt":"三个正数 4，k，16 成等比数列。k 等于多少？","answer":"8","explanation":"k²=64，k=8。","verify":"isqrt(4*16)"},{"id":"cnm_h210_q1","topicId":"cnm_h210","difficulty":"basic","type":"numeric","prompt":"等比数列 a_1=2，q=3。前 4 项和是多少？","answer":"80","explanation":"S_4=2×(81−1)/2=80。","verify":"2*(3**4-1)//(3-1)"},{"id":"cnm_h210_q2","topicId":"cnm_h210","difficulty":"basic","type":"numeric","prompt":"等比数列 a_1=5，q=1。前 4 项和是多少？","answer":"20","explanation":"公比是 1 时每项都是 5，和是 20。","verify":"4*5"},{"id":"cnm_h210_q3","topicId":"cnm_h210","difficulty":"standard","type":"numeric","prompt":"等比数列 a_1=1，q=2。前 5 项和是多少？","answer":"31","explanation":"S_5=1×(32−1)/1=31。","verify":"(2**5-1)//(2-1)"},{"id":"cnm_h210_q4","topicId":"cnm_h210","difficulty":"standard","type":"choice","prompt":"公比 q=1 时，为什么不能直接用 S_n=a1(q^n−1)/(q−1)？","choices":[{"key":"A","text":"公比等于 1 的数列不存在"},{"key":"B","text":"首项必须是 0"},{"key":"C","text":"分母是 0"},{"key":"D","text":"项数必须是无穷"}],"answer":"C","explanation":"q−1=0，公式的分母没有意义，要改用 S_n=na1。","verify":"\"分母是 0\""},{"id":"cnm_h211_q1","topicId":"cnm_h211","difficulty":"basic","type":"numeric","prompt":"a_n=3×2^(n−1)。公比是多少？","answer":"2","explanation":"每一项乘 2 得到下一项，公比是 2。","verify":"2"},{"id":"cnm_h211_q2","topicId":"cnm_h211","difficulty":"basic","type":"numeric","prompt":"a_n=3×2^(n−1)。a_1 等于多少？","answer":"3","explanation":"2^0=1，首项是 3。","verify":"3*2**0"},{"id":"cnm_h211_q3","topicId":"cnm_h211","difficulty":"standard","type":"choice","prompt":"等比数列的项和指数函数 y=a1·q^(x−1) 相比，主要差别是？","choices":[{"key":"A","text":"数列的底数必须是负数"},{"key":"B","text":"指数函数不能取正值"},{"key":"C","text":"数列的自变量只取正整数"},{"key":"D","text":"两者完全没有关系"}],"answer":"C","explanation":"通项公式的形状一样，但 n 只取正整数，图象是孤立的点。","verify":"\"数列的自变量只取正整数\""},{"id":"cnm_h211_q4","topicId":"cnm_h211","difficulty":"standard","type":"numeric","prompt":"公比是 4、首项是 1 的等比数列，a_3 等于多少？","answer":"16","explanation":"a_3=4²=16。","verify":"1*4**2"},{"id":"cnm_h212_q1","topicId":"cnm_h212","difficulty":"basic","type":"numeric","prompt":"一种细菌每小时数量变为原来的 2 倍，开始有 3 个。3 小时后有多少个？","answer":"24","explanation":"经过 3 次加倍，3×2³=24。若把开始记为第 1 项，3 小时后是第 4 项。","verify":"3*2**3"},{"id":"cnm_h212_q2","topicId":"cnm_h212","difficulty":"basic","type":"numeric","prompt":"存款每年变为原来的 2 倍，第 1 年末是 100 元。第 3 年末是多少元？","answer":"400","explanation":"从第 1 年末到第 3 年末乘了两次 2，得 400。","verify":"100*2**2"},{"id":"cnm_h212_q3","topicId":"cnm_h212","difficulty":"standard","type":"numeric","prompt":"纸每次对折，层数变为 2 倍。对折 1 次是 2 层。对折 4 次是多少层？","answer":"16","explanation":"对折 4 次是 16 层。","verify":"2**4"},{"id":"cnm_h212_q4","topicId":"cnm_h212","difficulty":"standard","type":"choice","prompt":"每年都乘同一个增长率，这类问题适合用什么模型？","choices":[{"key":"A","text":"等比数列"},{"key":"B","text":"公差不为 0 的等差数列"},{"key":"C","text":"只用来平均数"},{"key":"D","text":"一次函数的斜率"}],"answer":"A","explanation":"相邻两项的比固定，是等比数列。","verify":"\"等比数列\""}]
