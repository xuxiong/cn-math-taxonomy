[{"id":"cnm_h016_q1","topicId":"cnm_h016","difficulty":"basic","type":"choice","prompt":"3<5 表示的关系是？","choices":[{"key":"A","text":"相等关系"},{"key":"B","text":"不等关系"},{"key":"C","text":"集合的属于关系"},{"key":"D","text":"函数的对应关系"}],"answer":"B","explanation":"小于号表示两个数不相等，而且有大小，是不等关系。","verify":"\"不等关系\""},{"id":"cnm_h016_q2","topicId":"cnm_h016","difficulty":"basic","type":"numeric","prompt":"方程 2x=6 的解是多少？","answer":"3","explanation":"两边同除以 2，x=3。这里用等式性质求唯一解。","verify":"6/2"},{"id":"cnm_h016_q3","topicId":"cnm_h016","difficulty":"standard","type":"numeric","prompt":"若 a=b，则 a+3 与 b+3 的差是多少？","answer":"0","explanation":"等式两边加同一个数仍相等，差是 0。","verify":"0"},{"id":"cnm_h016_q4","topicId":"cnm_h016","difficulty":"standard","type":"choice","prompt":"下面哪个是不等式？","choices":[{"key":"A","text":"x+1>0"},{"key":"B","text":"x+1=0"},{"key":"C","text":"x+1"},{"key":"D","text":"{x | x>0}"}],"answer":"A","explanation":"含有大于、小于等不等号、并且表示大小关系的才是不等式。","verify":"\"x+1>0\""},{"id":"cnm_h017_q1","topicId":"cnm_h017","difficulty":"basic","type":"numeric","prompt":"不等式 x+3>5 的正整数解中，最小的一个是多少？","answer":"3","explanation":"x>2。大于 2 的正整数里最小的是 3。","verify":"3"},{"id":"cnm_h017_q2","topicId":"cnm_h017","difficulty":"basic","type":"numeric","prompt":"不等式 2x−1<5 的最大整数解是多少？","answer":"2","explanation":"2x<6，x<3。小于 3 的最大整数是 2。","verify":"2"},{"id":"cnm_h017_q3","topicId":"cnm_h017","difficulty":"standard","type":"numeric","prompt":"不等式 x≥4 的不大于 7 的整数解有几个？","answer":"4","explanation":"4、5、6、7 共 4 个。","verify":"len([4,5,6,7])"},{"id":"cnm_h017_q4","topicId":"cnm_h017","difficulty":"standard","type":"choice","prompt":"不等式 x>1 的解集是？","choices":[{"key":"A","text":"只有 2"},{"key":"B","text":"所有大于 1 的实数"},{"key":"C","text":"所有大于或等于 1 的实数"},{"key":"D","text":"所有正整数"}],"answer":"B","explanation":"没有写「整数」时，解集是实数范围，而且不含等于 1。","verify":"\"所有大于 1 的实数\""},{"id":"cnm_h018_q1","topicId":"cnm_h018","difficulty":"basic","type":"numeric","prompt":"已知 a>b。a+4 与 b+4 比较，若 a+4 更大则回答 1，更小回答 −1，相等回答 0。","answer":"1","explanation":"两边加同一个数，不等号方向不变，a+4 仍然更大。","verify":"1"},{"id":"cnm_h018_q2","topicId":"cnm_h018","difficulty":"basic","type":"numeric","prompt":"已知 a>b。−2a 与 −2b 比较，若 −2a 更大则回答 1，更小回答 −1。","answer":"-1","explanation":"乘负数要改变不等号方向，所以 −2a < −2b，−2a 更小。","verify":"-1"},{"id":"cnm_h018_q3","topicId":"cnm_h018","difficulty":"standard","type":"choice","prompt":"两边都乘以 −3 时，不等号应该？","choices":[{"key":"A","text":"保持方向"},{"key":"B","text":"改变方向"},{"key":"C","text":"改成等号"},{"key":"D","text":"去掉不等号"}],"answer":"B","explanation":"乘以或除以负数，不等号方向改变。","verify":"\"改变方向\""},{"id":"cnm_h018_q4","topicId":"cnm_h018","difficulty":"standard","type":"numeric","prompt":"若 a−b=5，且 a>b 记为 1，则应回答多少？","answer":"1","explanation":"差是正数，说明 a 大于 b。","verify":"1"},{"id":"cnm_h019_q1","topicId":"cnm_h019","difficulty":"basic","type":"numeric","prompt":"比较 2³ 与 3²：计算 2³−3²。","answer":"-1","explanation":"8−9=−1，差为负，所以 2³ 更小。","verify":"2**3-3**2"},{"id":"cnm_h019_q2","topicId":"cnm_h019","difficulty":"basic","type":"numeric","prompt":"比较 (a+1)² 与 a²+1 时，先计算差里常数项以外的部分。已知差等于 2a。当 a=3 时差是多少？","answer":"6","explanation":"(a+1)²−(a²+1)=2a。a=3 时差是 6，前者更大。","verify":"2*3"},{"id":"cnm_h019_q3","topicId":"cnm_h019","difficulty":"standard","type":"numeric","prompt":"7² 与 50 的差是多少？","answer":"-1","explanation":"49−50=−1，所以 7² 小于 50。","verify":"7**2-50"},{"id":"cnm_h019_q4","topicId":"cnm_h019","difficulty":"standard","type":"choice","prompt":"两式作差得到 0，说明？","choices":[{"key":"A","text":"前者更大"},{"key":"B","text":"后者更大"},{"key":"C","text":"无法比较"},{"key":"D","text":"两式相等"}],"answer":"D","explanation":"差为 0 就是相等；差为正前者大，差为负前者小。","verify":"\"两式相等\""},{"id":"cnm_h020_q1","topicId":"cnm_h020","difficulty":"basic","type":"numeric","prompt":"不等式 1<x<5 的整数解有几个？","answer":"3","explanation":"不含端点，整数解是 2、3、4，共 3 个。","verify":"len([2,3,4])"},{"id":"cnm_h020_q2","topicId":"cnm_h020","difficulty":"basic","type":"numeric","prompt":"不等式 0≤x≤3 的整数解之和是多少？","answer":"6","explanation":"整数解 0、1、2、3，和为 6。","verify":"0+1+2+3"},{"id":"cnm_h020_q3","topicId":"cnm_h020","difficulty":"standard","type":"numeric","prompt":"不等式 −2≤x<2 的整数解有几个？","answer":"4","explanation":"含 −2，不含 2，共 4 个。","verify":"len([-2,-1,0,1])"},{"id":"cnm_h020_q4","topicId":"cnm_h020","difficulty":"standard","type":"choice","prompt":"不等式 x>3 的整数解里，最小的一个是？","choices":[{"key":"A","text":"4"},{"key":"B","text":"3"},{"key":"C","text":"5"},{"key":"D","text":"不存在"}],"answer":"A","explanation":"大于 3 的整数从 4 开始。3 本身不满足大于。","verify":"\"4\""}]
