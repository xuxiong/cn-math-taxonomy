[{"id":"cnm_h096_q1","topicId":"cnm_h096","difficulty":"basic","type":"numeric","prompt":"三角形顶点 A(0，0)、B(4，0)、C(0，3)。边 BC 的长是多少？","answer":"5","explanation":"向量 BC=(4，−3)，模 √(16+9)=5。","verify":"isqrt((4-0)**2+(0-3)**2)"},{"id":"cnm_h096_q2","topicId":"cnm_h096","difficulty":"basic","type":"numeric","prompt":"三角形顶点 A(0，0)、B(4，0)、C(0，3)。边 AB 的长是多少？","answer":"4","explanation":"向量 AB=(4，0)，模 √(16+0)=4。","verify":"isqrt((4-0)**2+(0-0)**2)"},{"id":"cnm_h096_q3","topicId":"cnm_h096","difficulty":"standard","type":"numeric","prompt":"三角形顶点 A(0，0)、B(4，0)、C(0，3)。边 AC 的长是多少？","answer":"3","explanation":"向量 AC=(0，3)，模 √(0+9)=3。","verify":"isqrt((0-0)**2+(3-0)**2)"},{"id":"cnm_h096_q4","topicId":"cnm_h096","difficulty":"standard","type":"choice","prompt":"这项探究主要想说明？","choices":[{"key":"A","text":"向量可以把三角形的边角关系变成坐标运算"},{"key":"B","text":"向量不能用于三角形"},{"key":"C","text":"只能用量角器研究三角形"},{"key":"D","text":"探究不需要具体例子"}],"answer":"A","explanation":"用一个直角三角形就能看到 AB²+AC²=BC²，和余弦定理一致。","verify":"\"向量可以把三角形的边角关系变成坐标运算\""}]
