[{"id":"cnh_j108_q1","topicId":"cnh_j108","difficulty":"basic","type":"choice","prompt":"1765年哈格里夫斯发明的机器是？","choices":[{"key":"A","text":"蒸汽机"},{"key":"B","text":"珍妮机"},{"key":"C","text":"火车"},{"key":"D","text":"轮船"}],"answer":"B","explanation":"珍妮机是手摇纺纱机，大大提高了纺纱效率。","verify":"\"珍妮机\""},{"id":"cnh_j108_q2","topicId":"cnh_j108","difficulty":"basic","type":"choice","prompt":"1785年把改良蒸汽机用作纺织动力的是？","choices":[{"key":"A","text":"史蒂芬森"},{"key":"B","text":"富尔顿"},{"key":"C","text":"瓦特"},{"key":"D","text":"爱迪生"}],"answer":"C","explanation":"瓦特改进蒸汽机，使人类进入蒸汽时代。","verify":"\"瓦特\""},{"id":"cnh_j108_q3","topicId":"cnh_j108","difficulty":"standard","type":"choice","prompt":"1825年史蒂芬森设计的蒸汽机车在英国试车，标志？","choices":[{"key":"A","text":"电气时代的开始"},{"key":"B","text":"航空时代的开始"},{"key":"C","text":"信息时代的开始"},{"key":"D","text":"铁路时代的开始"}],"answer":"D","explanation":"火车机车试车成功。","verify":"\"铁路时代的开始\""},{"id":"cnh_j108_q4","topicId":"cnh_j108","difficulty":"challenge","type":"choice","prompt":"第一次工业革命开始的国家是？","choices":[{"key":"A","text":"英国"},{"key":"B","text":"法国"},{"key":"C","text":"美国"},{"key":"D","text":"德国"}],"answer":"A","explanation":"英国最早具备政治前提、资本、市场和劳动力等条件。","verify":"\"英国\""},{"id":"cnh_j109_q1","topicId":"cnh_j109","difficulty":"basic","type":"choice","prompt":"1848年发表的文献是？","choices":[{"key":"A","text":"《权利法案》"},{"key":"B","text":"《独立宣言》"},{"key":"C","text":"《共产党宣言》"},{"key":"D","text":"《人权宣言》"}],"answer":"C","explanation":"马克思和恩格斯为共产主义者同盟起草了《共产党宣言》。","verify":"\"《共产党宣言》\""},{"id":"cnh_j109_q2","topicId":"cnh_j109","difficulty":"basic","type":"choice","prompt":"《共产党宣言》的作者是？","choices":[{"key":"A","text":"列宁和斯大林"},{"key":"B","text":"欧文和傅立叶"},{"key":"C","text":"华盛顿和杰斐逊"},{"key":"D","text":"马克思和恩格斯"}],"answer":"D","explanation":"宣言分析了阶级斗争，号召无产阶级联合起来。","verify":"\"马克思和恩格斯\""},{"id":"cnh_j109_q3","topicId":"cnh_j109","difficulty":"standard","type":"choice","prompt":"马克思主义诞生的阶级基础是？","choices":[{"key":"A","text":"工业无产阶级登上历史舞台"},{"key":"B","text":"农民成为唯一阶级"},{"key":"C","text":"奴隶主阶级扩大"},{"key":"D","text":"封建贵族复辟"}],"answer":"A","explanation":"工业革命后工人运动发展，需要科学理论指导。","verify":"\"工业无产阶级登上历史舞台\""},{"id":"cnh_j109_q4","topicId":"cnh_j109","difficulty":"challenge","type":"choice","prompt":"为什么说《共产党宣言》标志马克思主义诞生？","choices":[{"key":"A","text":"它只是一部小说"},{"key":"B","text":"它第一次比较完整地阐述了科学社会主义基本原理"},{"key":"C","text":"它恢复了君主制"},{"key":"D","text":"它是英国议会的法律"}],"answer":"B","explanation":"宣言发表后，无产阶级有了科学理论的指导。","verify":"\"它第一次比较完整地阐述了科学社会主义基本原理\""},{"id":"cnh_j110_q1","topicId":"cnh_j110","difficulty":"basic","type":"choice","prompt":"1864年成立的国际工人组织是？","choices":[{"key":"A","text":"第二国际"},{"key":"B","text":"共产国际"},{"key":"C","text":"联合国"},{"key":"D","text":"第一国际"}],"answer":"D","explanation":"第一国际又称国际工人协会，马克思是它的实际领袖。","verify":"\"第一国际\""},{"id":"cnh_j110_q2","topicId":"cnh_j110","difficulty":"basic","type":"choice","prompt":"巴黎公社成立于？","choices":[{"key":"A","text":"1871年3月18日起义之后"},{"key":"B","text":"1848年"},{"key":"C","text":"1789年"},{"key":"D","text":"1917年"}],"answer":"A","explanation":"3月28日公社宣告成立。","verify":"\"1871年3月18日起义之后\""},{"id":"cnh_j110_q3","topicId":"cnh_j110","difficulty":"standard","type":"choice","prompt":"巴黎公社的性质是？","choices":[{"key":"A","text":"资产阶级共和国"},{"key":"B","text":"世界上第一个无产阶级政权"},{"key":"C","text":"封建王朝"},{"key":"D","text":"法西斯政权"}],"answer":"B","explanation":"公社仅存在72天，5月被镇压。","verify":"\"世界上第一个无产阶级政权\""},{"id":"cnh_j110_q4","topicId":"cnh_j110","difficulty":"challenge","type":"choice","prompt":"巴黎公社失败的直接原因是？","choices":[{"key":"A","text":"公社建立了社会主义强国并长期存在"},{"key":"B","text":"第一国际尚未成立"},{"key":"C","text":"敌人强大，公社缺乏经验并被镇压"},{"key":"D","text":"工业革命尚未开始"}],"answer":"C","explanation":"5月下旬流血周之后，公社失败。","verify":"\"敌人强大，公社缺乏经验并被镇压\""},{"id":"cnh_j111_q1","topicId":"cnh_j111","difficulty":"basic","type":"choice","prompt":"《国际歌》的词作者是？","choices":[{"key":"A","text":"欧仁·鲍狄埃"},{"key":"B","text":"比尔·狄盖特是曲作者"},{"key":"C","text":"马克思"},{"key":"D","text":"列宁"}],"answer":"A","explanation":"鲍狄埃是巴黎公社委员，在公社失败后写下歌词。","verify":"\"欧仁·鲍狄埃\""},{"id":"cnh_j111_q2","topicId":"cnh_j111","difficulty":"basic","type":"choice","prompt":"《国际歌》的曲作者是？","choices":[{"key":"A","text":"欧仁·鲍狄埃"},{"key":"B","text":"比尔·狄盖特"},{"key":"C","text":"贝多芬"},{"key":"D","text":"肖邦"}],"answer":"B","explanation":"狄盖特为鲍狄埃的诗谱曲。","verify":"\"比尔·狄盖特\""},{"id":"cnh_j111_q3","topicId":"cnh_j111","difficulty":"standard","type":"choice","prompt":"《国际歌》直接关联的历史事件是？","choices":[{"key":"A","text":"美国独立战争"},{"key":"B","text":"明治维新"},{"key":"C","text":"巴黎公社"},{"key":"D","text":"第一次世界大战"}],"answer":"C","explanation":"歌词表达了公社战士的理想。","verify":"\"巴黎公社\""},{"id":"cnh_j111_q4","topicId":"cnh_j111","difficulty":"challenge","type":"choice","prompt":"活动课唱响《国际歌》，应当先弄清？","choices":[{"key":"A","text":"只记旋律不看历史"},{"key":"B","text":"把它当成宫廷舞曲"},{"key":"C","text":"把它写成古代史诗"},{"key":"D","text":"它产生于哪一次工人政权的斗争"}],"answer":"D","explanation":"把歌曲放回1871年巴黎公社的历史中，才能理解歌词。","verify":"\"它产生于哪一次工人政权的斗争\""}]
