[{"id":"cnp_080_q1","topicId":"cnp_080","difficulty":"basic","type":"numeric","prompt":"某房间同时使用 1100 W 的空调和 220 W 的电视，干路电流是多少 A？（电压 220 V，只填数值）","answer":"6","explanation":"总功率 1320 W，I = P/U = 1320 ÷ 220 = 6 A。","verify":"(1100+220)/220"},{"id":"cnp_080_q2","topicId":"cnp_080","difficulty":"basic","type":"choice","prompt":"设计家庭电路时，房间里的插座和电灯应怎样连接？","choices":[{"key":"A","text":"串联"},{"key":"B","text":"并联"},{"key":"C","text":"插座串联、电灯并联"},{"key":"D","text":"随意连接"}],"answer":"B","explanation":"家用电器和插座都应并联，才能独立工作。","verify":"\"并联\""},{"id":"cnp_080_q3","topicId":"cnp_080","difficulty":"standard","type":"choice","prompt":"电能表上标有“220 V 10 A”，这个家庭电路允许同时使用的用电器总功率最大是多少？","choices":[{"key":"A","text":"2200 W"},{"key":"B","text":"22 W"},{"key":"C","text":"220 W"},{"key":"D","text":"10 W"}],"answer":"A","explanation":"P = UI = 220 × 10 = 2200 W。","verify":"220*10"},{"id":"cnp_080_q4","topicId":"cnp_080","difficulty":"standard","type":"choice","prompt":"为大功率空调单独设计一条线路时，下列做法合理的是哪一个？","choices":[{"key":"A","text":"选用较细的导线"},{"key":"B","text":"去掉保险装置"},{"key":"C","text":"选用较粗的导线并加装合适的空气开关"},{"key":"D","text":"把开关接在零线上"}],"answer":"C","explanation":"大功率用电器电流大，要用较粗的导线减小发热，并有保护装置。","verify":"\"选用较粗的导线并加装合适的空气开关\""}]
