[{"id":"cnm_029_q1","topicId":"cnm_029","difficulty":"standard","type":"numeric","prompt":"当 a=-2 时，求 3a²-a。","answer":"14","explanation":"负数代入要加括号：3×(-2)²-(-2)=3×4+2=14。","verify":"3*(-2)**2-(-2)"},{"id":"cnm_029_q2","topicId":"cnm_029","difficulty":"basic","type":"numeric","prompt":"当 x=3 时，求代数式 2x+5 的值。","answer":"11","explanation":"把 x=3 代入：2×3+5=6+5=11。","verify":"2*3+5"},{"id":"cnm_029_q3","topicId":"cnm_029","difficulty":"standard","type":"numeric","prompt":"当 x=-2/3 时，求 3x²-2x+1 的值。结果写成最简分数。","answer":"11/3","explanation":"3×(-2/3)²-2×(-2/3)+1=3×4/9+4/3+1=4/3+4/3+1=11/3。","verify":"3*Fraction(-2,3)**2-2*Fraction(-2,3)+1"},{"id":"cnm_029_q4","topicId":"cnm_029","difficulty":"advanced","type":"numeric","prompt":"已知 x-2y=3，求代数式 2x-4y+1 的值。","answer":"7","explanation":"把 x-2y 看成整体：2x-4y+1=2(x-2y)+1=2×3+1=7。","verify":"2*3+1"}]
