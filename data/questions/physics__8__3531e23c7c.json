[{"id":"cnp_044_q1","topicId":"cnp_044","difficulty":"basic","type":"choice","prompt":"同一支密度计放在不同液体中都漂浮，它受到的浮力有什么关系？","choices":[{"key":"A","text":"相等"},{"key":"B","text":"在密度大的液体中大"},{"key":"C","text":"在密度小的液体中大"},{"key":"D","text":"无法比较"}],"answer":"A","explanation":"漂浮时浮力都等于密度计的重力，所以相等。","verify":"\"相等\""},{"id":"cnp_044_q2","topicId":"cnp_044","difficulty":"basic","type":"choice","prompt":"密度计在液体中浸入得越深，说明液体密度怎样？","choices":[{"key":"A","text":"越小"},{"key":"B","text":"越大"},{"key":"C","text":"不变"},{"key":"D","text":"与浸入深度无关"}],"answer":"A","explanation":"浮力一定时，由 F浮 = ρ液 g V排，V排 越大，ρ液 越小。","verify":"\"越小\""},{"id":"cnp_044_q3","topicId":"cnp_044","difficulty":"standard","type":"choice","prompt":"密度计上的刻度值，从上到下怎样变化？","choices":[{"key":"A","text":"上小下大"},{"key":"B","text":"上大下小"},{"key":"C","text":"上下一样"},{"key":"D","text":"中间最大"}],"answer":"A","explanation":"液体密度越大，浸入越浅，液面对应的刻度越靠下，所以刻度值上小下大。","verify":"\"上小下大\""},{"id":"cnp_044_q4","topicId":"cnp_044","difficulty":"standard","type":"choice","prompt":"用吸管和铜丝做密度计，在吸管下端缠铜丝的目的是什么？","choices":[{"key":"A","text":"增大浮力"},{"key":"B","text":"降低重心，使吸管能竖直漂浮"},{"key":"C","text":"减小重力"},{"key":"D","text":"让吸管沉底"}],"answer":"B","explanation":"缠铜丝使重心降低，密度计才能竖直漂浮在液体中。","verify":"\"降低重心，使吸管能竖直漂浮\""}]
