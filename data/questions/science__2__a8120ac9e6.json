[{"id":"cns_p038_q1","topicId":"cns_p038","difficulty":"basic","type":"choice","prompt":"下面哪一样不是地球上自然就有的？","choices":[{"key":"A","text":"空气"},{"key":"B","text":"水"},{"key":"C","text":"岩石"},{"key":"D","text":"电视机"}],"answer":"D","explanation":"电视机是人造的。","verify":"\"电视机\""},{"id":"cns_p038_q2","topicId":"cns_p038","difficulty":"basic","type":"choice","prompt":"下面哪一组都是地球上的生物？","choices":[{"key":"A","text":"大树和小鸟"},{"key":"B","text":"石头和水"},{"key":"C","text":"空气和土壤"},{"key":"D","text":"白云和沙子"}],"answer":"A","explanation":"大树、小鸟有生命，是生物。","verify":"\"大树和小鸟\""},{"id":"cns_p038_q3","topicId":"cns_p038","difficulty":"standard","type":"choice","prompt":"植物生长需要地球上的哪些东西？","choices":[{"key":"A","text":"只要阳光"},{"key":"B","text":"阳光、水、空气和土壤"},{"key":"C","text":"只要石头"},{"key":"D","text":"只要电"}],"answer":"B","explanation":"植物生长需要阳光、水、空气和土壤。","verify":"\"阳光、水、空气和土壤\""},{"id":"cns_p038_q4","topicId":"cns_p038","difficulty":"challenge","type":"choice","prompt":"为什么说地球是我们共同的家园？","choices":[{"key":"A","text":"地球上只有人"},{"key":"B","text":"地球是人造的"},{"key":"C","text":"人和动植物都依靠地球上的水、空气等生活"},{"key":"D","text":"地球上没有水"}],"answer":"C","explanation":"地球提供生物生存需要的条件。","verify":"\"人和动植物都依靠地球上的水、空气等生活\""},{"id":"cns_p039_q1","topicId":"cns_p039","difficulty":"basic","type":"choice","prompt":"校园里的下面哪一样是自然物？","choices":[{"key":"A","text":"大树"},{"key":"B","text":"篮球架"},{"key":"C","text":"教学楼"},{"key":"D","text":"课桌"}],"answer":"A","explanation":"大树是自然生长的。","verify":"\"大树\""},{"id":"cns_p039_q2","topicId":"cns_p039","difficulty":"basic","type":"choice","prompt":"校园里的下面哪一样是人造物？","choices":[{"key":"A","text":"小草"},{"key":"B","text":"旗杆"},{"key":"C","text":"蚂蚁"},{"key":"D","text":"泥土"}],"answer":"B","explanation":"旗杆是人做的。","verify":"\"旗杆\""},{"id":"cns_p039_q3","topicId":"cns_p039","difficulty":"standard","type":"choice","prompt":"画校园地图时，最重要的是什么？","choices":[{"key":"A","text":"画得越花越好"},{"key":"B","text":"只画自己的教室"},{"key":"C","text":"把建筑的位置关系画对"},{"key":"D","text":"画上天上的云"}],"answer":"C","explanation":"地图要表示出各处的位置关系。","verify":"\"把建筑的位置关系画对\""},{"id":"cns_p039_q4","topicId":"cns_p039","difficulty":"challenge","type":"choice","prompt":"校园地图上，花坛画在教学楼的东边，实际就该在教学楼的哪边？","choices":[{"key":"A","text":"西边"},{"key":"B","text":"北边"},{"key":"C","text":"南边"},{"key":"D","text":"东边"}],"answer":"D","explanation":"地图和实际的方位应该一致。","verify":"\"东边\""},{"id":"cns_p040_q1","topicId":"cns_p040","difficulty":"basic","type":"choice","prompt":"空气是什么颜色的？","choices":[{"key":"A","text":"白色"},{"key":"B","text":"无色透明"},{"key":"C","text":"蓝色"},{"key":"D","text":"灰色"}],"answer":"B","explanation":"空气看不见，无色透明。","verify":"\"无色透明\""},{"id":"cns_p040_q2","topicId":"cns_p040","difficulty":"basic","type":"choice","prompt":"空瓶子里有没有空气？","choices":[{"key":"A","text":"没有"},{"key":"B","text":"只有水"},{"key":"C","text":"有"},{"key":"D","text":"只有灰尘"}],"answer":"C","explanation":"看起来空的瓶子里其实充满了空气。","verify":"\"有\""},{"id":"cns_p040_q3","topicId":"cns_p040","difficulty":"standard","type":"choice","prompt":"下面哪种现象说明空气在流动？","choices":[{"key":"A","text":"石头静止不动"},{"key":"B","text":"水结成冰"},{"key":"C","text":"灯亮了"},{"key":"D","text":"树叶被风吹动"}],"answer":"D","explanation":"流动的空气就是风。","verify":"\"树叶被风吹动\""},{"id":"cns_p040_q4","topicId":"cns_p040","difficulty":"challenge","type":"choice","prompt":"把一个空杯子倒扣着压进水里，杯里的纸团没有湿，为什么？","choices":[{"key":"A","text":"杯里的空气占据了空间，水进不去"},{"key":"B","text":"纸团防水"},{"key":"C","text":"水太冷了"},{"key":"D","text":"杯子有魔法"}],"answer":"A","explanation":"空气占据空间，挡住了水。","verify":"\"杯里的空气占据了空间，水进不去\""},{"id":"cns_p041_q1","topicId":"cns_p041","difficulty":"basic","type":"choice","prompt":"天空中没有云或云很少，阳光明亮，这是什么天气？","choices":[{"key":"A","text":"阴天"},{"key":"B","text":"雨天"},{"key":"C","text":"晴天"},{"key":"D","text":"雪天"}],"answer":"C","explanation":"云很少、太阳明亮是晴天。","verify":"\"晴天\""},{"id":"cns_p041_q2","topicId":"cns_p041","difficulty":"basic","type":"choice","prompt":"云很多，看不到太阳，但没有下雨，是什么天气？","choices":[{"key":"A","text":"晴天"},{"key":"B","text":"雨天"},{"key":"C","text":"雪天"},{"key":"D","text":"阴天"}],"answer":"D","explanation":"云层厚、不下雨是阴天。","verify":"\"阴天\""},{"id":"cns_p041_q3","topicId":"cns_p041","difficulty":"standard","type":"choice","prompt":"下雨天出门应该带什么？","choices":[{"key":"A","text":"雨伞或雨衣"},{"key":"B","text":"太阳镜"},{"key":"C","text":"扇子"},{"key":"D","text":"游泳圈"}],"answer":"A","explanation":"雨具能挡雨。","verify":"\"雨伞或雨衣\""},{"id":"cns_p041_q4","topicId":"cns_p041","difficulty":"challenge","type":"choice","prompt":"天气记录表上连续三天画了雪花符号，这三天最可能是什么季节？","choices":[{"key":"A","text":"夏季"},{"key":"B","text":"冬季"},{"key":"C","text":"春季"},{"key":"D","text":"秋季"}],"answer":"B","explanation":"下雪多发生在寒冷的冬季。","verify":"\"冬季\""},{"id":"cns_p042_q1","topicId":"cns_p042","difficulty":"basic","type":"choice","prompt":"一年有几个季节？","choices":[{"key":"A","text":"两个"},{"key":"B","text":"三个"},{"key":"C","text":"十二个"},{"key":"D","text":"四个"}],"answer":"D","explanation":"一年有春、夏、秋、冬四个季节。","verify":"\"四个\""},{"id":"cns_p042_q2","topicId":"cns_p042","difficulty":"basic","type":"choice","prompt":"哪个季节天气最热？","choices":[{"key":"A","text":"夏季"},{"key":"B","text":"春季"},{"key":"C","text":"秋季"},{"key":"D","text":"冬季"}],"answer":"A","explanation":"夏季气温最高。","verify":"\"夏季\""},{"id":"cns_p042_q3","topicId":"cns_p042","difficulty":"standard","type":"choice","prompt":"大雁南飞、树叶变黄，通常是哪个季节？","choices":[{"key":"A","text":"春季"},{"key":"B","text":"秋季"},{"key":"C","text":"夏季"},{"key":"D","text":"冬季"}],"answer":"B","explanation":"秋天树叶变黄，很多候鸟飞往南方。","verify":"\"秋季\""},{"id":"cns_p042_q4","topicId":"cns_p042","difficulty":"challenge","type":"choice","prompt":"四季的顺序是哪一种？","choices":[{"key":"A","text":"春、秋、夏、冬"},{"key":"B","text":"夏、春、冬、秋"},{"key":"C","text":"春、夏、秋、冬"},{"key":"D","text":"冬、夏、春、秋"}],"answer":"C","explanation":"春天过后是夏天，然后是秋天、冬天，再回到春天。","verify":"\"春、夏、秋、冬\""},{"id":"cns_p043_q1","topicId":"cns_p043","difficulty":"basic","type":"choice","prompt":"早上，太阳从哪个方向升起？","choices":[{"key":"A","text":"东方"},{"key":"B","text":"西方"},{"key":"C","text":"南方"},{"key":"D","text":"北方"}],"answer":"A","explanation":"太阳东升西落。","verify":"\"东方\""},{"id":"cns_p043_q2","topicId":"cns_p043","difficulty":"basic","type":"choice","prompt":"傍晚，太阳在哪个方向落下？","choices":[{"key":"A","text":"东方"},{"key":"B","text":"西方"},{"key":"C","text":"南方"},{"key":"D","text":"北方"}],"answer":"B","explanation":"太阳从西边落下。","verify":"\"西方\""},{"id":"cns_p043_q3","topicId":"cns_p043","difficulty":"standard","type":"choice","prompt":"白天为什么是亮的？","choices":[{"key":"A","text":"路灯亮了"},{"key":"B","text":"月亮发光"},{"key":"C","text":"有太阳光照着"},{"key":"D","text":"星星很多"}],"answer":"C","explanation":"白天的光主要来自太阳。","verify":"\"有太阳光照着\""},{"id":"cns_p043_q4","topicId":"cns_p043","difficulty":"challenge","type":"choice","prompt":"中午站在操场上，背对太阳，影子在哪边？","choices":[{"key":"A","text":"在自己的背后"},{"key":"B","text":"在太阳那边"},{"key":"C","text":"没有影子"},{"key":"D","text":"在自己的前面"}],"answer":"D","explanation":"影子在背光的一侧，背对太阳时影子在前面。","verify":"\"在自己的前面\""},{"id":"cns_p044_q1","topicId":"cns_p044","difficulty":"basic","type":"choice","prompt":"我们常在什么时候看到月亮？","choices":[{"key":"A","text":"只在中午"},{"key":"B","text":"夜晚"},{"key":"C","text":"从来看不到"},{"key":"D","text":"只在下雨时"}],"answer":"B","explanation":"月亮常在夜晚出现，有时白天也能看到。","verify":"\"夜晚\""},{"id":"cns_p044_q2","topicId":"cns_p044","difficulty":"basic","type":"choice","prompt":"月亮本身会发光吗？","choices":[{"key":"A","text":"会，像灯一样"},{"key":"B","text":"会，像太阳一样"},{"key":"C","text":"不会，它反射太阳光"},{"key":"D","text":"只在冬天发光"}],"answer":"C","explanation":"月亮本身不发光，我们看到的是它反射的太阳光。","verify":"\"不会，它反射太阳光\""},{"id":"cns_p044_q3","topicId":"cns_p044","difficulty":"standard","type":"choice","prompt":"又圆又亮的月亮叫什么？","choices":[{"key":"A","text":"新月"},{"key":"B","text":"月牙"},{"key":"C","text":"半月"},{"key":"D","text":"满月"}],"answer":"D","explanation":"月亮最圆时叫满月。","verify":"\"满月\""},{"id":"cns_p044_q4","topicId":"cns_p044","difficulty":"challenge","type":"choice","prompt":"连续观察一个月，月亮的形状会怎样？","choices":[{"key":"A","text":"从弯到圆，再从圆到弯，不断变化"},{"key":"B","text":"一直是圆的"},{"key":"C","text":"一直是弯的"},{"key":"D","text":"每天一模一样"}],"answer":"A","explanation":"月相有规律地变化，大约一个月一次。","verify":"\"从弯到圆，再从圆到弯，不断变化\""},{"id":"cns_p045_q1","topicId":"cns_p045","difficulty":"basic","type":"choice","prompt":"记录天气时，太阳符号表示什么天气？","choices":[{"key":"A","text":"雨天"},{"key":"B","text":"阴天"},{"key":"C","text":"晴天"},{"key":"D","text":"雪天"}],"answer":"C","explanation":"太阳符号代表晴天。","verify":"\"晴天\""},{"id":"cns_p045_q2","topicId":"cns_p045","difficulty":"basic","type":"choice","prompt":"要知道一个月里晴天多还是雨天多，应该怎么做？","choices":[{"key":"A","text":"只记一天"},{"key":"B","text":"随便猜"},{"key":"C","text":"只看第一天"},{"key":"D","text":"每天记录，月底数一数"}],"answer":"D","explanation":"坚持记录再统计，就能比较。","verify":"\"每天记录，月底数一数\""},{"id":"cns_p045_q3","topicId":"cns_p045","difficulty":"standard","type":"choice","prompt":"小明的天气日历上，15 天是晴，10 天是雨，5 天是阴，哪种天气最多？","choices":[{"key":"A","text":"晴"},{"key":"B","text":"雨"},{"key":"C","text":"阴"},{"key":"D","text":"一样多"}],"answer":"A","explanation":"15 比 10 和 5 都多。","verify":"\"晴\""},{"id":"cns_p045_q4","topicId":"cns_p045","difficulty":"challenge","type":"choice","prompt":"为什么天气要每天在差不多的时间记录？","choices":[{"key":"A","text":"老师喜欢"},{"key":"B","text":"这样比较才公平"},{"key":"C","text":"记录本会变好看"},{"key":"D","text":"天气只有那时才有"}],"answer":"B","explanation":"固定时间观察，结果更便于比较。","verify":"\"这样比较才公平\""}]
