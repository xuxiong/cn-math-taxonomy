[{"id":"cng_j020_q1","topicId":"cng_j020","difficulty":"basic","type":"choice","prompt":"日本是位于亚洲东部的？","choices":[{"key":"A","text":"内陆国"},{"key":"B","text":"岛国"},{"key":"C","text":"半岛国家"},{"key":"D","text":"大陆国家"}],"answer":"B","explanation":"日本由北海道、本州、四国、九州等岛屿组成。","verify":"\"岛国\""},{"id":"cng_j020_q2","topicId":"cng_j020","difficulty":"basic","type":"choice","prompt":"日本多火山地震，主要因为位于？","choices":[{"key":"A","text":"非洲板块内部"},{"key":"B","text":"南极板块中心"},{"key":"C","text":"板块交界地带"},{"key":"D","text":"太平洋正中央且远离海沟"}],"answer":"C","explanation":"日本处在太平洋板块与亚欧板块交界处，地壳活跃。","verify":"\"板块交界地带\""},{"id":"cng_j020_q3","topicId":"cng_j020","difficulty":"standard","type":"choice","prompt":"日本工业集中分布在？","choices":[{"key":"A","text":"北海道内陆山地"},{"key":"B","text":"琉球群岛的最高峰上"},{"key":"C","text":"日本海沿岸的所有高山顶部"},{"key":"D","text":"太平洋沿岸和濑户内海沿岸"}],"answer":"D","explanation":"沿海多优良港湾，便于进口原料、出口产品。","verify":"\"太平洋沿岸和濑户内海沿岸\""},{"id":"cng_j020_q4","topicId":"cng_j020","difficulty":"challenge","type":"choice","prompt":"日本气候的海洋性特征比较明显，表现为？","choices":[{"key":"A","text":"冬季较温和、降水较多"},{"key":"B","text":"全年炎热干燥"},{"key":"C","text":"没有四季变化"},{"key":"D","text":"与大陆内部完全相同"}],"answer":"A","explanation":"四周临海，受海洋调节，气温年较差较小，降水较丰富。","verify":"\"冬季较温和、降水较多\""},{"id":"cng_j021_q1","topicId":"cng_j021","difficulty":"basic","type":"choice","prompt":"东南亚处在亚洲与大洋洲、印度洋与太平洋之间的？","choices":[{"key":"A","text":"大陆内部"},{"key":"B","text":"极地地区"},{"key":"C","text":"“十字路口”"},{"key":"D","text":"世界屋脊"}],"answer":"C","explanation":"中南半岛和马来群岛扼守两洲两洋的交通要道。","verify":"\"“十字路口”\""},{"id":"cng_j021_q2","topicId":"cng_j021","difficulty":"basic","type":"choice","prompt":"马六甲海峡是连接哪两个大洋的重要通道？","choices":[{"key":"A","text":"大西洋和北冰洋"},{"key":"B","text":"印度洋和北冰洋"},{"key":"C","text":"太平洋和大西洋"},{"key":"D","text":"印度洋和太平洋"}],"answer":"D","explanation":"马六甲海峡位于马来半岛与苏门答腊岛之间。","verify":"\"印度洋和太平洋\""},{"id":"cng_j021_q3","topicId":"cng_j021","difficulty":"standard","type":"choice","prompt":"东南亚气候湿热，主要粮食作物是？","choices":[{"key":"A","text":"水稻"},{"key":"B","text":"青稞"},{"key":"C","text":"甜菜"},{"key":"D","text":"燕麦"}],"answer":"A","explanation":"高温多雨适合水稻生长，许多国家以稻米为主食。","verify":"\"水稻\""},{"id":"cng_j021_q4","topicId":"cng_j021","difficulty":"challenge","type":"choice","prompt":"中南半岛的城市多分布在河流沿岸及河口三角洲，主要因为？","choices":[{"key":"A","text":"海拔越高越适合居住"},{"key":"B","text":"地形平坦、水源充足、交通便利"},{"key":"C","text":"这里完全没有洪水"},{"key":"D","text":"远离所有海洋更安全"}],"answer":"B","explanation":"河流提供灌溉、用水和航运，河口三角洲土壤肥沃。","verify":"\"地形平坦、水源充足、交通便利\""},{"id":"cng_j022_q1","topicId":"cng_j022","difficulty":"basic","type":"choice","prompt":"印度大部分地区的气候类型是？","choices":[{"key":"A","text":"温带海洋性气候"},{"key":"B","text":"寒带气候"},{"key":"C","text":"地中海气候"},{"key":"D","text":"热带季风气候"}],"answer":"D","explanation":"印度大部分位于热带，受西南季风影响，分旱雨两季。","verify":"\"热带季风气候\""},{"id":"cng_j022_q2","topicId":"cng_j022","difficulty":"basic","type":"choice","prompt":"印度人口数量在世界上的地位是？","choices":[{"key":"A","text":"居世界前列的人口大国"},{"key":"B","text":"人口最少的国家"},{"key":"C","text":"只有数百万人"},{"key":"D","text":"没有常住人口"}],"answer":"A","explanation":"印度是南亚面积最大、人口极多的国家。","verify":"\"居世界前列的人口大国\""},{"id":"cng_j022_q3","topicId":"cng_j022","difficulty":"standard","type":"choice","prompt":"印度的信息技术产业中心常被称为“印度硅谷”的是？","choices":[{"key":"A","text":"新德里"},{"key":"B","text":"班加罗尔"},{"key":"C","text":"加尔各答"},{"key":"D","text":"孟买港口的渔村"}],"answer":"B","explanation":"班加罗尔集中了软件和服务外包产业。","verify":"\"班加罗尔\""},{"id":"cng_j022_q4","topicId":"cng_j022","difficulty":"challenge","type":"choice","prompt":"西南季风来得晚或退得早，印度容易出现？","choices":[{"key":"A","text":"终年冰冻"},{"key":"B","text":"与季风完全无关的火山喷发"},{"key":"C","text":"旱灾，粮食减产"},{"key":"D","text":"全国同时变成温带海洋性气候"}],"answer":"C","explanation":"农业依赖夏季风带来的降水，季风不稳定会导致旱涝。","verify":"\"旱灾，粮食减产\""},{"id":"cng_j023_q1","topicId":"cng_j023","difficulty":"basic","type":"choice","prompt":"俄罗斯是世界上？","choices":[{"key":"A","text":"面积最大的国家"},{"key":"B","text":"人口最多的国家"},{"key":"C","text":"海拔最高的国家"},{"key":"D","text":"唯一的岛国"}],"answer":"A","explanation":"俄罗斯地跨亚欧大陆，面积约 1700 多万平方千米。","verify":"\"面积最大的国家\""},{"id":"cng_j023_q2","topicId":"cng_j023","difficulty":"basic","type":"choice","prompt":"俄罗斯的亚洲部分气候以什么为主？","choices":[{"key":"A","text":"热带雨林气候"},{"key":"B","text":"温带大陆性气候，冬季漫长严寒"},{"key":"C","text":"全年高温多雨"},{"key":"D","text":"地中海气候"}],"answer":"B","explanation":"纬度高、距海远，冬季寒冷漫长。","verify":"\"温带大陆性气候，冬季漫长严寒\""},{"id":"cng_j023_q3","topicId":"cng_j023","difficulty":"standard","type":"choice","prompt":"西伯利亚大铁路的走向大致是？","choices":[{"key":"A","text":"南北向穿过赤道"},{"key":"B","text":"环绕南极"},{"key":"C","text":"东西向"},{"key":"D","text":"只连接非洲各国"}],"answer":"C","explanation":"铁路横贯亚欧大陆，连接莫斯科与远东港口。","verify":"\"东西向\""},{"id":"cng_j023_q4","topicId":"cng_j023","difficulty":"challenge","type":"choice","prompt":"俄罗斯自然资源丰富，重工业发达，但农业相对薄弱，主要因为？","choices":[{"key":"A","text":"完全没有平原"},{"key":"B","text":"人口全部集中在热带"},{"key":"C","text":"没有铁路和河流"},{"key":"D","text":"纬度高、热量不足，耕地分布不均"}],"answer":"D","explanation":"热量条件限制农作物种类和产量，工业则依托矿产和能源。","verify":"\"纬度高、热量不足，耕地分布不均\""}]
