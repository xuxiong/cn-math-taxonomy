[{"id":"cng_j028_q1","topicId":"cng_j028","difficulty":"basic","type":"choice","prompt":"美国本土位于哪个大洲？","choices":[{"key":"A","text":"南美洲"},{"key":"B","text":"北美洲"},{"key":"C","text":"非洲"},{"key":"D","text":"大洋洲"}],"answer":"B","explanation":"美国主体在北美洲中部，还有阿拉斯加和夏威夷。","verify":"\"北美洲\""},{"id":"cng_j028_q2","topicId":"cng_j028","difficulty":"basic","type":"choice","prompt":"美国农业的突出特点之一是？","choices":[{"key":"A","text":"完全没有种植业"},{"key":"B","text":"只在西部沙漠种水稻"},{"key":"C","text":"地区生产专业化"},{"key":"D","text":"全国只种一种作物"}],"answer":"C","explanation":"不同地区根据自然条件形成小麦带、玉米带、棉花带等。","verify":"\"地区生产专业化\""},{"id":"cng_j028_q3","topicId":"cng_j028","difficulty":"standard","type":"choice","prompt":"美国高新技术产业的代表地区是？","choices":[{"key":"A","text":"墨西哥高原"},{"key":"B","text":"落基山最高峰"},{"key":"C","text":"五大湖湖心岛"},{"key":"D","text":"硅谷"}],"answer":"D","explanation":"旧金山东南的硅谷是全球著名高科技产业区。","verify":"\"硅谷\""},{"id":"cng_j028_q4","topicId":"cng_j028","difficulty":"challenge","type":"choice","prompt":"美国本土降水大致从东南向西北递减，农业带东西差异明显，主要受？","choices":[{"key":"A","text":"气候和地形等因素影响"},{"key":"B","text":"全国气候完全相同"},{"key":"C","text":"没有河流和土壤差异"},{"key":"D","text":"农业布局与自然条件无关"}],"answer":"A","explanation":"中部平原适合商品谷物，西部山地高原降水较少，农业类型不同。","verify":"\"气候和地形等因素影响\""},{"id":"cng_j029_q1","topicId":"cng_j029","difficulty":"basic","type":"choice","prompt":"巴西大部分位于？","choices":[{"key":"A","text":"北美洲西部"},{"key":"B","text":"非洲北部"},{"key":"C","text":"南美洲东部，赤道和南回归线之间"},{"key":"D","text":"欧洲西部"}],"answer":"C","explanation":"巴西是南美洲面积最大的国家，领土主要在热带。","verify":"\"南美洲东部，赤道和南回归线之间\""},{"id":"cng_j029_q2","topicId":"cng_j029","difficulty":"basic","type":"choice","prompt":"世界上面积最大的热带雨林主要分布在巴西的？","choices":[{"key":"A","text":"东南沿海的所有沙漠"},{"key":"B","text":"巴塔哥尼亚高原"},{"key":"C","text":"安第斯山脉山顶"},{"key":"D","text":"亚马孙河流域"}],"answer":"D","explanation":"亚马孙平原高温多雨，发育了世界最大的热带雨林。","verify":"\"亚马孙河流域\""},{"id":"cng_j029_q3","topicId":"cng_j029","difficulty":"standard","type":"choice","prompt":"巴西人口和城市主要集中在？","choices":[{"key":"A","text":"东南沿海"},{"key":"B","text":"亚马孙雨林内部"},{"key":"C","text":"西部安第斯高山"},{"key":"D","text":"赤道正中的原始密林腹地"}],"answer":"A","explanation":"东南沿海气候较温和、开发早、交通便利。","verify":"\"东南沿海\""},{"id":"cng_j029_q4","topicId":"cng_j029","difficulty":"challenge","type":"choice","prompt":"保护亚马孙热带雨林的重要意义是？","choices":[{"key":"A","text":"让雨林完全消失以扩大城市"},{"key":"B","text":"维护全球气候和生物多样性"},{"key":"C","text":"雨林对地球环境没有作用"},{"key":"D","text":"只影响南极冰川、与巴西无关"}],"answer":"B","explanation":"雨林通过光合作用吸收二氧化碳、释放氧气，并保存大量物种。","verify":"\"维护全球气候和生物多样性\""}]
