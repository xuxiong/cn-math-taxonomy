[{"id":"cnp_012_q1","topicId":"cnp_012","difficulty":"basic","type":"choice","prompt":"夏天从冰箱里拿出的饮料瓶外壁会“出汗”，这是什么物态变化？","choices":[{"key":"A","text":"汽化"},{"key":"B","text":"熔化"},{"key":"C","text":"液化"},{"key":"D","text":"升华"}],"answer":"C","explanation":"空气中的水蒸气遇到冷的瓶壁放热，液化成小水珠。","verify":"\"液化\""},{"id":"cnp_012_q2","topicId":"cnp_012","difficulty":"basic","type":"choice","prompt":"下列做法中，能加快蒸发的是哪一个？","choices":[{"key":"A","text":"把湿衣服展开晾在通风向阳处"},{"key":"B","text":"把湿衣服叠起来放在阴凉处"},{"key":"C","text":"给蔬菜套上保鲜袋"},{"key":"D","text":"把酒精瓶盖拧紧"}],"answer":"A","explanation":"增大液体表面积、提高温度、加快液面上方空气流动都能加快蒸发。","verify":"\"把湿衣服展开晾在通风向阳处\""},{"id":"cnp_012_q3","topicId":"cnp_012","difficulty":"standard","type":"choice","prompt":"水沸腾后继续加热，水的温度会怎样？","choices":[{"key":"A","text":"继续升高"},{"key":"B","text":"保持不变"},{"key":"C","text":"先升高后降低"},{"key":"D","text":"降低"}],"answer":"B","explanation":"液体沸腾时继续吸热，但温度保持在沸点不变。","verify":"\"保持不变\""},{"id":"cnp_012_q4","topicId":"cnp_012","difficulty":"standard","type":"choice","prompt":"高山上用普通锅煮饭不易煮熟，原因是什么？","choices":[{"key":"A","text":"气压高，水的沸点高"},{"key":"B","text":"气压低，水的沸点低"},{"key":"C","text":"气压低，水的沸点高"},{"key":"D","text":"高山上火力小"}],"answer":"B","explanation":"海拔越高气压越低，水的沸点越低，锅内温度达不到 100 ℃。","verify":"\"气压低，水的沸点低\""}]
