[{"id":"cnm_h201_q1","topicId":"cnm_h201","difficulty":"basic","type":"numeric","prompt":"等差数列 3，7，11，15 的公差是多少？","answer":"4","explanation":"后一项减前一项：7−3=4。","verify":"7-3"},{"id":"cnm_h201_q2","topicId":"cnm_h201","difficulty":"basic","type":"choice","prompt":"数列 2，5，8，11 是不是等差数列？","choices":[{"key":"A","text":"不是，因为各项都是正数"},{"key":"B","text":"不是，因为项数有限"},{"key":"C","text":"是，公差为 2"},{"key":"D","text":"是，公差为 3"}],"answer":"D","explanation":"相邻差都是 3，所以是公差为 3 的等差数列。","verify":"\"是，公差为 3\""},{"id":"cnm_h201_q3","topicId":"cnm_h201","difficulty":"standard","type":"numeric","prompt":"等差数列的首项是 6，公差是 −2。第 2 项是多少？","answer":"4","explanation":"6−2=4。","verify":"6+(-2)"},{"id":"cnm_h201_q4","topicId":"cnm_h201","difficulty":"standard","type":"choice","prompt":"常数列 5，5，5，5 是不是等差数列？","choices":[{"key":"A","text":"不是，公差必须是正数"},{"key":"B","text":"是，公差为 0"},{"key":"C","text":"不是，因为差是 0"},{"key":"D","text":"是，公差为 5"}],"answer":"B","explanation":"相邻差都是 0，公差为 0，仍然是等差数列。","verify":"\"是，公差为 0\""},{"id":"cnm_h202_q1","topicId":"cnm_h202","difficulty":"basic","type":"numeric","prompt":"等差数列 a_1=3，d=4。a_6 等于多少？","answer":"23","explanation":"a_6=3+(6−1)×4=23。","verify":"3+5*4"},{"id":"cnm_h202_q2","topicId":"cnm_h202","difficulty":"basic","type":"numeric","prompt":"等差数列 a_1=10，d=−3。a_4 等于多少？","answer":"1","explanation":"10+(4−1)×(−3)=1。","verify":"10+3*(-3)"},{"id":"cnm_h202_q3","topicId":"cnm_h202","difficulty":"standard","type":"numeric","prompt":"等差数列 a_3=8，a_7=20。公差是多少？","answer":"3","explanation":"中间隔 4 个公差，(20−8)/4=3。","verify":"Fraction(20-8, 7-3)"},{"id":"cnm_h202_q4","topicId":"cnm_h202","difficulty":"standard","type":"choice","prompt":"等差数列的通项公式是一次式。n 增加 1 时，项怎么变？","choices":[{"key":"A","text":"变成原来的 2 倍"},{"key":"B","text":"一定不变"},{"key":"C","text":"增加一个公差"},{"key":"D","text":"变成平方"}],"answer":"C","explanation":"相邻两项相差 d，序号每增加 1，项就加一个公差。","verify":"\"增加一个公差\""},{"id":"cnm_h203_q1","topicId":"cnm_h203","difficulty":"basic","type":"numeric","prompt":"5 和 11 的等差中项是多少？","answer":"8","explanation":"(5+11)/2=8。","verify":"Fraction(5+11, 2)"},{"id":"cnm_h203_q2","topicId":"cnm_h203","difficulty":"basic","type":"numeric","prompt":"等差中项是 6，前一个数是 2。后一个数是多少？","answer":"10","explanation":"2×6=2+后一个数，后一个数是 10。","verify":"2*6-2"},{"id":"cnm_h203_q3","topicId":"cnm_h203","difficulty":"standard","type":"numeric","prompt":"三个数 4，k，10 成等差数列。k 等于多少？","answer":"7","explanation":"2k=14，k=7。","verify":"Fraction(4+10, 2)"},{"id":"cnm_h203_q4","topicId":"cnm_h203","difficulty":"standard","type":"choice","prompt":"a、b、c 成等差数列，等价于哪一个等式？","choices":[{"key":"A","text":"2b=ac"},{"key":"B","text":"b=a+c"},{"key":"C","text":"b²=ac"},{"key":"D","text":"2b=a+c"}],"answer":"D","explanation":"中间项的 2 倍等于两端之和。b²=ac 是等比中项的关系。","verify":"\"2b=a+c\""},{"id":"cnm_h204_q1","topicId":"cnm_h204","difficulty":"basic","type":"numeric","prompt":"等差数列 a_1=3，a_6=23。前 6 项和是多少？","answer":"78","explanation":"S_6=6×(3+23)/2=78。","verify":"6*(3+23)//2"},{"id":"cnm_h204_q2","topicId":"cnm_h204","difficulty":"basic","type":"numeric","prompt":"等差数列 a_1=2，d=3。前 5 项和是多少？","answer":"40","explanation":"S_5=5×2+5×4×3/2=10+30=40。","verify":"5*2+5*4*3//2"},{"id":"cnm_h204_q3","topicId":"cnm_h204","difficulty":"standard","type":"numeric","prompt":"等差数列前 10 项和是 100，前 9 项和是 81。第 10 项是多少？","answer":"19","explanation":"第 10 项等于 S_10−S_9=19。","verify":"100-81"},{"id":"cnm_h204_q4","topicId":"cnm_h204","difficulty":"standard","type":"choice","prompt":"求等差数列前 n 项和时，首项加末项再乘项数，还要怎样？","choices":[{"key":"A","text":"再除以 2"},{"key":"B","text":"再乘 2"},{"key":"C","text":"再平方"},{"key":"D","text":"不用再运算"}],"answer":"A","explanation":"公式是 n 乘首末两项之和，再除以 2。","verify":"\"再除以 2\""},{"id":"cnm_h205_q1","topicId":"cnm_h205","difficulty":"basic","type":"numeric","prompt":"通项 a_n=4n−1。公差是多少？","answer":"4","explanation":"一次项系数 4 就是公差。","verify":"4"},{"id":"cnm_h205_q2","topicId":"cnm_h205","difficulty":"basic","type":"numeric","prompt":"通项 a_n=4n−1。首项是多少？","answer":"3","explanation":"n=1 时得 3。","verify":"4*1-1"},{"id":"cnm_h205_q3","topicId":"cnm_h205","difficulty":"standard","type":"choice","prompt":"等差数列的图象落在哪一种函数图象上？","choices":[{"key":"A","text":"一次函数的图象"},{"key":"B","text":"指数函数的图象"},{"key":"C","text":"反比例函数的图象"},{"key":"D","text":"一个圆"}],"answer":"A","explanation":"通项是 n 的一次式，这些点在一条直线上。","verify":"\"一次函数的图象\""},{"id":"cnm_h205_q4","topicId":"cnm_h205","difficulty":"standard","type":"numeric","prompt":"公差是 −2、首项是 9 的等差数列，a_n 的一次项系数是多少？","answer":"-2","explanation":"a_n=−2n+常数，一次项系数就是公差 −2。","verify":"-2"},{"id":"cnm_h206_q1","topicId":"cnm_h206","difficulty":"basic","type":"numeric","prompt":"剧场第 1 排 20 个座位，往后每排多 2 个。第 6 排有多少个座位？","answer":"30","explanation":"这是 a_1=20、d=2 的等差数列，a_6=30。","verify":"20+5*2"},{"id":"cnm_h206_q2","topicId":"cnm_h206","difficulty":"basic","type":"numeric","prompt":"剧场第 1 排 20 个座位，往后每排多 2 个。前 6 排一共多少个座位？","answer":"150","explanation":"末项 30，S_6=6×50/2=150。","verify":"6*(20+30)//2"},{"id":"cnm_h206_q3","topicId":"cnm_h206","difficulty":"standard","type":"numeric","prompt":"每月存款比上个月多 10 元，第 1 个月存 100 元。第 4 个月存多少元？","answer":"130","explanation":"a_4=100+3×10=130。","verify":"100+3*10"},{"id":"cnm_h206_q4","topicId":"cnm_h206","difficulty":"standard","type":"choice","prompt":"每天比前一天多走固定的步数，总步数适合用什么求和？","choices":[{"key":"A","text":"等比数列的前 n 项和"},{"key":"B","text":"只把第一天乘天数"},{"key":"C","text":"等差数列的前 n 项和"},{"key":"D","text":"导数的平均值"}],"answer":"C","explanation":"每天增加的量固定，是等差数列。","verify":"\"等差数列的前 n 项和\""}]
