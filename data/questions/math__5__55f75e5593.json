[{"difficulty":"basic","type":"choice","prompt":"图形旋转之后，大小和形状怎样？","choices":[{"key":"A","text":"大小和形状都不变"},{"key":"B","text":"一定变大"},{"key":"C","text":"形状一定改变"}],"answer":"A","explanation":"旋转只改变方向，大小和形状不变。","verify":"'大小和形状都不变'","id":"cnm_p171_q1","topicId":"cnm_p171"},{"difficulty":"basic","type":"numeric","prompt":"风车绕中心点顺时针旋转 90 度，再顺时针旋转 90 度。一共旋转了多少度？","answer":"180","explanation":"方向相同，角度相加：90＋90＝180。","verify":"90+90","id":"cnm_p171_q2","topicId":"cnm_p171"},{"difficulty":"standard","type":"numeric","prompt":"时针从 12 转到 4，转了多少度？钟面上相邻两个数字之间是 30 度。","answer":"120","explanation":"从 12 到 4 经过 4 格：4×30＝120（度）。","verify":"4*30","id":"cnm_p171_q3","topicId":"cnm_p171"},{"difficulty":"challenge","type":"numeric","prompt":"一个图形先顺时针旋转 90 度，再逆时针旋转 35 度。相当于顺时针旋转了多少度？","answer":"55","explanation":"逆时针 35 度要抵消一部分：90－35＝55（度）。","verify":"90-35","id":"cnm_p171_q4","topicId":"cnm_p171"}]
