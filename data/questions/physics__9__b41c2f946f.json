[{"id":"cnp_055_q1","topicId":"cnp_055","difficulty":"basic","type":"choice","prompt":"冬天搓手取暖，是通过什么方式改变手的内能的？","choices":[{"key":"A","text":"热传递"},{"key":"B","text":"热辐射"},{"key":"C","text":"分子扩散"},{"key":"D","text":"做功"}],"answer":"D","explanation":"搓手时克服摩擦做功，机械能转化为内能。","verify":"\"做功\""},{"id":"cnp_055_q2","topicId":"cnp_055","difficulty":"basic","type":"choice","prompt":"下列说法正确的是哪一个？","choices":[{"key":"A","text":"一切物体都有内能"},{"key":"B","text":"0 ℃ 的冰没有内能"},{"key":"C","text":"温度高的物体含有的热量多"},{"key":"D","text":"物体内能增加一定是吸收了热量"}],"answer":"A","explanation":"一切物体都有内能；热量是过程量，不能说“含有”；内能增加也可能是外界做功。","verify":"\"一切物体都有内能\""},{"id":"cnp_055_q3","topicId":"cnp_055","difficulty":"standard","type":"choice","prompt":"用热水袋暖手，是通过什么方式改变内能的？","choices":[{"key":"A","text":"做功"},{"key":"B","text":"摩擦"},{"key":"C","text":"热传递"},{"key":"D","text":"压缩"}],"answer":"C","explanation":"热量从热水袋传给手，属于热传递。","verify":"\"热传递\""},{"id":"cnp_055_q4","topicId":"cnp_055","difficulty":"standard","type":"choice","prompt":"晶体熔化时持续吸热，温度不变，它的内能怎样？","choices":[{"key":"A","text":"不变"},{"key":"B","text":"增大"},{"key":"C","text":"减小"},{"key":"D","text":"先减小后增大"}],"answer":"B","explanation":"吸热使内能增大，温度不变不代表内能不变。","verify":"\"增大\""}]
