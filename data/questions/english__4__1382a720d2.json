[{"id":"cne_p080_q1","topicId":"cne_p080","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「医生」？","choices":[{"key":"A","text":"nurse"},{"key":"B","text":"doctor"},{"key":"C","text":"driver"},{"key":"D","text":"farmer"}],"answer":"B","explanation":"doctor 的意思是医生。","verify":"\"doctor\""},{"id":"cne_p080_q2","topicId":"cne_p080","difficulty":"basic","type":"choice","prompt":"「nurse」的中文意思是哪一个？","choices":[{"key":"A","text":"医生"},{"key":"B","text":"司机"},{"key":"C","text":"护士"},{"key":"D","text":"农民"}],"answer":"C","explanation":"nurse 的意思是护士。","verify":"\"护士\""},{"id":"cne_p080_q3","topicId":"cne_p080","difficulty":"standard","type":"choice","prompt":"选择表示「司机」的单词。","choices":[{"key":"A","text":"doctor"},{"key":"B","text":"nurse"},{"key":"C","text":"farmer"},{"key":"D","text":"driver"}],"answer":"D","explanation":"表示司机的单词是 driver。","verify":"\"driver\""},{"id":"cne_p080_q4","topicId":"cne_p080","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「农民」？","choices":[{"key":"A","text":"farmer"},{"key":"B","text":"doctor"},{"key":"C","text":"nurse"},{"key":"D","text":"driver"}],"answer":"A","explanation":"farmer 的意思是农民。","verify":"\"farmer\""},{"id":"cne_p081_q1","topicId":"cne_p081","difficulty":"basic","type":"choice","prompt":"问「他的职业是什么」，应选哪一句？","choices":[{"key":"A","text":"What is he job?"},{"key":"B","text":"Where is his job?"},{"key":"C","text":"What is his job?"},{"key":"D","text":"Who is his job?"}],"answer":"C","explanation":"询问职业说 What is his job?","verify":"\"What is his job?\""},{"id":"cne_p081_q2","topicId":"cne_p081","difficulty":"basic","type":"choice","prompt":"He is a doctor. 他的职业是？","choices":[{"key":"A","text":"护士"},{"key":"B","text":"司机"},{"key":"C","text":"农民"},{"key":"D","text":"医生"}],"answer":"D","explanation":"doctor 是医生。","verify":"\"医生\""},{"id":"cne_p081_q3","topicId":"cne_p081","difficulty":"standard","type":"choice","prompt":"My father is a driver. 爸爸的职业是？","choices":[{"key":"A","text":"司机"},{"key":"B","text":"医生"},{"key":"C","text":"护士"},{"key":"D","text":"农民"}],"answer":"A","explanation":"driver 是司机。","verify":"\"司机\""},{"id":"cne_p081_q4","topicId":"cne_p081","difficulty":"standard","type":"choice","prompt":"哪一句表示「她的妈妈是护士」？","choices":[{"key":"A","text":"His mother is a nurse."},{"key":"B","text":"Her mother is a nurse."},{"key":"C","text":"Her mother is a doctor."},{"key":"D","text":"His father is a nurse."}],"answer":"B","explanation":"她的用 Her，护士是 nurse。","verify":"\"Her mother is a nurse.\""},{"id":"cne_p082_q1","topicId":"cne_p082","difficulty":"basic","type":"choice","prompt":"想说叔叔是农民，应说哪一句？","choices":[{"key":"A","text":"My uncle is a doctor."},{"key":"B","text":"My uncle is a nurse."},{"key":"C","text":"My uncle is a driver."},{"key":"D","text":"My uncle is a farmer."}],"answer":"D","explanation":"农民是 farmer。","verify":"\"My uncle is a farmer.\""},{"id":"cne_p082_q2","topicId":"cne_p082","difficulty":"basic","type":"choice","prompt":"Is this your baby brother? 这句是在问什么？","choices":[{"key":"A","text":"这是你的小弟弟吗"},{"key":"B","text":"这是你的爸爸吗"},{"key":"C","text":"这是你的叔叔吗"},{"key":"D","text":"这是你的阿姨吗"}],"answer":"A","explanation":"baby brother 是小弟弟。","verify":"\"这是你的小弟弟吗\""},{"id":"cne_p082_q3","topicId":"cne_p082","difficulty":"standard","type":"choice","prompt":"She is a nurse. 哪一句和这句话意思相同？","choices":[{"key":"A","text":"她是医生。"},{"key":"B","text":"她是护士。"},{"key":"C","text":"他是护士。"},{"key":"D","text":"她是司机。"}],"answer":"B","explanation":"She 是她，nurse 是护士。","verify":"\"她是护士。\""},{"id":"cne_p082_q4","topicId":"cne_p082","difficulty":"standard","type":"choice","prompt":"What is your aunt's job? 这句是在问什么？","choices":[{"key":"A","text":"你爸爸做什么工作"},{"key":"B","text":"你妈妈在哪里"},{"key":"C","text":"你姑姑或阿姨做什么工作"},{"key":"D","text":"你几岁了"}],"answer":"C","explanation":"aunt 是姑姑或阿姨，job 是职业。","verify":"\"你姑姑或阿姨做什么工作\""},{"id":"cne_p083_q1","topicId":"cne_p083","difficulty":"basic","type":"choice","prompt":"读一读：This is my father. He is a doctor. 爸爸的职业是？","choices":[{"key":"A","text":"医生"},{"key":"B","text":"护士"},{"key":"C","text":"司机"},{"key":"D","text":"农民"}],"answer":"A","explanation":"He is a doctor。","verify":"\"医生\""},{"id":"cne_p083_q2","topicId":"cne_p083","difficulty":"basic","type":"choice","prompt":"读一读：My mother is a nurse. My uncle is a driver. 谁是司机？","choices":[{"key":"A","text":"妈妈"},{"key":"B","text":"叔叔"},{"key":"C","text":"爸爸"},{"key":"D","text":"阿姨"}],"answer":"B","explanation":"uncle is a driver。","verify":"\"叔叔\""},{"id":"cne_p083_q3","topicId":"cne_p083","difficulty":"standard","type":"choice","prompt":"读一读：She is a farmer. 哪一句和文字一致？","choices":[{"key":"A","text":"他是农民。"},{"key":"B","text":"她是医生。"},{"key":"C","text":"她是农民。"},{"key":"D","text":"她是护士。"}],"answer":"C","explanation":"She 是她，farmer 是农民。","verify":"\"她是农民。\""},{"id":"cne_p083_q4","topicId":"cne_p083","difficulty":"standard","type":"choice","prompt":"读一读：His father is a doctor. Her mother is a teacher. 谁的爸爸是医生？","choices":[{"key":"A","text":"她的爸爸"},{"key":"B","text":"他的妈妈"},{"key":"C","text":"她的妈妈"},{"key":"D","text":"他的爸爸"}],"answer":"D","explanation":"His father 是他的爸爸。","verify":"\"他的爸爸\""},{"id":"cne_p209_q1","topicId":"cne_p209","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「打扫」？","choices":[{"key":"A","text":"clean"},{"key":"B","text":"cook"},{"key":"C","text":"wash"},{"key":"D","text":"sweep"}],"answer":"A","explanation":"clean 是打扫。","verify":"\"clean\""},{"id":"cne_p209_q2","topicId":"cne_p209","difficulty":"basic","type":"choice","prompt":"cook 的意思是？","choices":[{"key":"A","text":"洗碗"},{"key":"B","text":"扫地"},{"key":"C","text":"擦桌子"},{"key":"D","text":"做饭"}],"answer":"D","explanation":"cook 是做饭。","verify":"\"做饭\""},{"id":"cne_p209_q3","topicId":"cne_p209","difficulty":"standard","type":"choice","prompt":"「洗碗」用哪个词最合适？","choices":[{"key":"A","text":"sweep"},{"key":"B","text":"make"},{"key":"C","text":"wash"},{"key":"D","text":"cook"}],"answer":"C","explanation":"wash the dishes 是洗碗。","verify":"\"wash\""},{"id":"cne_p209_q4","topicId":"cne_p209","difficulty":"standard","type":"choice","prompt":"sweep the floor 是在做什么？","choices":[{"key":"A","text":"擦桌子"},{"key":"B","text":"扫地"},{"key":"C","text":"做饭"},{"key":"D","text":"洗碗"}],"answer":"B","explanation":"sweep the floor 是扫地。","verify":"\"扫地\""},{"id":"cne_p210_q1","topicId":"cne_p210","difficulty":"basic","type":"choice","prompt":"想说「我可以帮忙做饭」，应选哪一句？","choices":[{"key":"A","text":"I can help cook."},{"key":"B","text":"I can help cooks."},{"key":"C","text":"I help can cook."},{"key":"D","text":"I am help cook."}],"answer":"A","explanation":"帮忙做某事用 I can help + 动词原形。","verify":"\"I can help cook.\""},{"id":"cne_p210_q2","topicId":"cne_p210","difficulty":"basic","type":"choice","prompt":"Let me wash the dishes. 这句是在说什么？","choices":[{"key":"A","text":"让我来扫地"},{"key":"B","text":"让我来做饭"},{"key":"C","text":"请你洗碗"},{"key":"D","text":"让我来洗碗"}],"answer":"D","explanation":"wash the dishes 是洗碗。","verify":"\"让我来洗碗\""},{"id":"cne_p210_q3","topicId":"cne_p210","difficulty":"standard","type":"choice","prompt":"哪一句表示主动帮忙打扫？","choices":[{"key":"A","text":"I helps clean."},{"key":"B","text":"Can I helping clean?"},{"key":"C","text":"I can help clean."},{"key":"D","text":"I can help cooking."}],"answer":"C","explanation":"help 后用动词原形 clean。","verify":"\"I can help clean.\""},{"id":"cne_p210_q4","topicId":"cne_p210","difficulty":"standard","type":"choice","prompt":"Mum is busy. I can ____. 横线上最合适的是？","choices":[{"key":"A","text":"to help she"},{"key":"B","text":"help her"},{"key":"C","text":"helps her"},{"key":"D","text":"helping her"}],"answer":"B","explanation":"can 后用动词原形 help。","verify":"\"help her\""},{"id":"cne_p211_q1","topicId":"cne_p211","difficulty":"basic","type":"choice","prompt":"读一读：My dad can cook. My mum can clean. 谁会做饭？","choices":[{"key":"A","text":"爸爸"},{"key":"B","text":"妈妈"},{"key":"C","text":"我"},{"key":"D","text":"哥哥"}],"answer":"A","explanation":"dad can cook。","verify":"\"爸爸\""},{"id":"cne_p211_q2","topicId":"cne_p211","difficulty":"basic","type":"choice","prompt":"读一读：I help wash the dishes every day. 我每天做什么？","choices":[{"key":"A","text":"扫地"},{"key":"B","text":"做饭"},{"key":"C","text":"擦桌子"},{"key":"D","text":"洗碗"}],"answer":"D","explanation":"wash the dishes 是洗碗。","verify":"\"洗碗\""},{"id":"cne_p211_q3","topicId":"cne_p211","difficulty":"standard","type":"choice","prompt":"读一读：We are a happy family. Dad cooks. Mum cleans. I sweep. 哪一句和短文一致？","choices":[{"key":"A","text":"爸爸扫地。"},{"key":"B","text":"我不帮忙。"},{"key":"C","text":"我扫地。"},{"key":"D","text":"妈妈做饭。"}],"answer":"C","explanation":"I sweep 是扫地。","verify":"\"我扫地。\""},{"id":"cne_p211_q4","topicId":"cne_p211","difficulty":"standard","type":"choice","prompt":"读一读：Amy helps her family. She can cook and wash. 艾米会做什么？","choices":[{"key":"A","text":"只擦桌子"},{"key":"B","text":"做饭和洗碗"},{"key":"C","text":"只做饭"},{"key":"D","text":"只扫地"}],"answer":"B","explanation":"cook and wash。","verify":"\"做饭和洗碗\""}]
