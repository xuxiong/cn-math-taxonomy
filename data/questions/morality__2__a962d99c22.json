[{"id":"cnd_p045_q1","topicId":"cnd_p045","difficulty":"basic","type":"choice","prompt":"家人之所以珍贵，是因为？","choices":[{"key":"A","text":"家里东西最多"},{"key":"B","text":"家人从不提要求"},{"key":"C","text":"互相关爱、共同生活"},{"key":"D","text":"家人只会批评"}],"answer":"C","explanation":"家是互相关爱的地方。","verify":"\"互相关爱、共同生活\""},{"id":"cnd_p045_q2","topicId":"cnd_p045","difficulty":"basic","type":"choice","prompt":"父母辛苦工作，我们可以？","choices":[{"key":"A","text":"故意添乱"},{"key":"B","text":"什么家务都不做"},{"key":"C","text":"只顾要礼物"},{"key":"D","text":"体贴他们，少让他们操心"}],"answer":"D","explanation":"体贴父母是爱家的表现。","verify":"\"体贴他们，少让他们操心\""},{"id":"cnd_p045_q3","topicId":"cnd_p045","difficulty":"standard","type":"choice","prompt":"和家人意见不同，较好做法？","choices":[{"key":"A","text":"心平气和说明想法，一起商量"},{"key":"B","text":"摔门而出"},{"key":"C","text":"完全不说话冷战"},{"key":"D","text":"大声骂人"}],"answer":"A","explanation":"家庭矛盾也要好好沟通。","verify":"\"心平气和说明想法，一起商量\""},{"id":"cnd_p045_q4","topicId":"cnd_p045","difficulty":"challenge","type":"choice","prompt":"为什么要弘扬家庭美德？","choices":[{"key":"A","text":"家庭美德过时了"},{"key":"B","text":"尊敬长辈、相亲相爱，家庭更和睦"},{"key":"C","text":"只顾自己最重要"},{"key":"D","text":"美德只在学校需要"}],"answer":"B","explanation":"家庭美德让家更温暖。","verify":"\"尊敬长辈、相亲相爱，家庭更和睦\""},{"id":"cnd_p046_q1","topicId":"cnd_p046","difficulty":"basic","type":"choice","prompt":"我们的祖国是？","choices":[{"key":"A","text":"某一个省"},{"key":"B","text":"某一个市"},{"key":"C","text":"某一个学校"},{"key":"D","text":"中华人民共和国"}],"answer":"D","explanation":"我们的祖国是中华人民共和国。","verify":"\"中华人民共和国\""},{"id":"cnd_p046_q2","topicId":"cnd_p046","difficulty":"basic","type":"choice","prompt":"作为中国人，应当？","choices":[{"key":"A","text":"热爱祖国，遵守法律和公德"},{"key":"B","text":"破坏公共财物"},{"key":"C","text":"传播谣言"},{"key":"D","text":"歧视其他民族同学"}],"answer":"A","explanation":"爱国守法、尊重各族同学。","verify":"\"热爱祖国，遵守法律和公德\""},{"id":"cnd_p046_q3","topicId":"cnd_p046","difficulty":"standard","type":"choice","prompt":"我国是统一的多民族国家，正确态度是？","choices":[{"key":"A","text":"只尊重本民族"},{"key":"B","text":"各民族平等团结、互相尊重"},{"key":"C","text":"嘲笑其他民族习俗"},{"key":"D","text":"拒绝与其他民族交往"}],"answer":"B","explanation":"民族团结很重要。","verify":"\"各民族平等团结、互相尊重\""},{"id":"cnd_p046_q4","topicId":"cnd_p046","difficulty":"challenge","type":"choice","prompt":"为祖国自豪，小学生可以怎么做？","choices":[{"key":"A","text":"只喊口号不行动"},{"key":"B","text":"破坏文物"},{"key":"C","text":"努力学习，文明礼貌，爱护环境"},{"key":"D","text":"不遵守公共秩序"}],"answer":"C","explanation":"用实际行动爱国。","verify":"\"努力学习，文明礼貌，爱护环境\""},{"id":"cnd_p047_q1","topicId":"cnd_p047","difficulty":"basic","type":"choice","prompt":"中国年（春节）的传统习俗有？","choices":[{"key":"A","text":"贴春联、吃年夜饭、拜年等"},{"key":"B","text":"只剩睡觉"},{"key":"C","text":"必须出国旅游"},{"key":"D","text":"取消与家人见面"}],"answer":"A","explanation":"春节有丰富的传统习俗。","verify":"\"贴春联、吃年夜饭、拜年等\""},{"id":"cnd_p047_q2","topicId":"cnd_p047","difficulty":"basic","type":"choice","prompt":"过年时拜年的意义是？","choices":[{"key":"A","text":"比谁压岁钱多"},{"key":"B","text":"表达祝福和尊敬"},{"key":"C","text":"比谁烟花响"},{"key":"D","text":"比谁熬夜久"}],"answer":"B","explanation":"拜年是祝福与尊敬。","verify":"\"表达祝福和尊敬\""},{"id":"cnd_p047_q3","topicId":"cnd_p047","difficulty":"standard","type":"choice","prompt":"燃放烟花爆竹要注意？","choices":[{"key":"A","text":"在楼道里放"},{"key":"B","text":"对着人放"},{"key":"C","text":"遵守当地规定，注意防火安全"},{"key":"D","text":"不管禁放规定"}],"answer":"C","explanation":"安全文明过节。","verify":"\"遵守当地规定，注意防火安全\""},{"id":"cnd_p047_q4","topicId":"cnd_p047","difficulty":"challenge","type":"choice","prompt":"红红火火中国年体现了？","choices":[{"key":"A","text":"只是商场促销"},{"key":"B","text":"与文化无关"},{"key":"C","text":"只属于个别地方"},{"key":"D","text":"中华民族的传统文化和亲情"}],"answer":"D","explanation":"春节承载传统文化与亲情。","verify":"\"中华民族的传统文化和亲情\""},{"id":"cnd_p048_q1","topicId":"cnd_p048","difficulty":"basic","type":"choice","prompt":"我们的祖国是？","choices":[{"key":"A","text":"某一个省"},{"key":"B","text":"中华人民共和国"},{"key":"C","text":"某一个市"},{"key":"D","text":"某一个学校"}],"answer":"B","explanation":"我们的祖国是中华人民共和国。","verify":"\"中华人民共和国\""},{"id":"cnd_p048_q2","topicId":"cnd_p048","difficulty":"basic","type":"choice","prompt":"作为中国人，应当？","