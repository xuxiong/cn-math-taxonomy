[{"difficulty":"basic","type":"choice","prompt":"小数乘整数，积的小数位数怎样确定？","choices":[{"key":"A","text":"和小数因数的小数位数一样"},{"key":"B","text":"一定比因数多 1 位"},{"key":"C","text":"小数点可以随便点"}],"answer":"A","explanation":"先按整数乘法算，再看小数因数有几位小数，积就点几位。","verify":"'和小数因数的小数位数一样'","id":"cnm_p132_q1","topicId":"cnm_p132"},{"difficulty":"basic","type":"numeric","prompt":"每支笔 0.3 元，买 4 支。一共多少元？（用小数作答）","answer":"1.2","explanation":"0.3×4＝1.2（元）。","verify":"Fraction(3,10)*4","id":"cnm_p132_q2","topicId":"cnm_p132"},{"difficulty":"standard","type":"numeric","prompt":"每支笔 1.2 元，买 4 支。一共多少元？（用小数作答）","answer":"4.8","explanation":"1.2×4＝4.8（元）。","verify":"Fraction(12,10)*4","id":"cnm_p132_q3","topicId":"cnm_p132"},{"difficulty":"challenge","type":"numeric","prompt":"故事书每本 8.5 元，作文本每本 1.5 元。买 3 本故事书和 2 本作文本，一共多少元？（用小数作答）","answer":"28.5","explanation":"8.5×3＝25.5，1.5×2＝3，25.5＋3＝28.5（元）。","verify":"Fraction(85,10)*3+Fraction(15,10)*2","id":"cnm_p132_q4","topicId":"cnm_p132"},{"difficulty":"basic","type":"choice","prompt":"小数乘小数，积的小数位数等于什么？","choices":[{"key":"A","text":"两个因数小数位数的和"},{"key":"B","text":"只看较大的那个因数"},{"key":"C","text":"一定是整数，不用点小数点"}],"answer":"A","explanation":"两个因数的小数位数相加，就是积的小数位数；末尾的 0 可以去掉。","verify":"'两个因数小数位数的和'","id":"cnm_p133_q1","topicId":"cnm_p133"},{"difficulty":"basic","type":"numeric","prompt":"长 0.3 米、宽 0.4 米的长方形，面积是多少平方米？（用小数作答）","answer":"0.12","explanation":"0.3×0.4＝0.12（平方米）。","verify":"Fraction(3,10)*Fraction(4,10)","id":"cnm_p133_q2","topicId":"cnm_p133"},{"difficulty":"standard","type":"numeric","prompt":"长 1.5 米、宽 0.4 米的长方形，面积是多少平方米？（用小数作答）","answer":"0.6","explanation":"1.5×0.4＝0.60＝0.6（平方米）。","verify":"Fraction(15,10)*Fraction(4,10)","id":"cnm_p133_q3","topicId":"cnm_p133"},{"difficulty":"challenge","type":"numeric","prompt":"一块长方形菜地长 2.5 米、宽 1.2 米，每平方米收 0.8 千克菜。一共收多少千克？（用小数作答）","answer":"2.4","explanation":"先算面积 2.5×1.2＝3（平方米），再算 3×0.8＝2.4（千克）。","verify":"Fraction(25,10)*Fraction(12,10)*Fraction(8,10)","id":"cnm_p133_q4","topicId":"cnm_p133"},{"difficulty":"basic","type":"numeric","prompt":"每小时行 2.4 千米，行 3 小时。一共多少千米？（用小数作答）","answer":"7.2","explanation":"2.4×3＝7.2（千米）。","verify":"Fraction(24,10)*3","id":"cnm_p134_q1","topicId":"cnm_p134"},{"difficulty":"basic","type":"numeric","prompt":"每支铅笔 0.8 元，买 6 支。一共多少元？（用小数作答）","answer":"4.8","explanation":"0.8×6＝4.8（元）。","verify":"Fraction(8,10)*6","id":"cnm_p134_q2","topicId":"cnm_p134"},{"difficulty":"standard","type":"numeric","prompt":"每小时行 3.5 千米，行 3 小时。一共多少千米？（用小数作答）","answer":"10.5","explanation":"3.5×3＝10.5（千米）。","verify":"Fraction(35,10)*3","id":"cnm_p134_q3","topicId":"cnm_p134"},{"difficulty":"challenge","type":"numeric","prompt":"苹果每千克 6.5 元，梨每千克 4.8 元。买 2 千克苹果和 3 千克梨，一共多少元？（用小数作答）","answer":"27.4","explanation":"6.5×2＝13，4.8×3＝14.4，13＋14.4＝27.4（元）。","verify":"Fraction(65,10)*2+Fraction(48,10)*3","id":"cnm_p134_q4","topicId":"cnm_p134"}]
