[{"id":"cnk_h083_q1","topicId":"cnk_h083","difficulty":"basic","type":"choice","prompt":"烷烃分子中，碳原子之间只含有？","choices":[{"key":"A","text":"碳碳单键"},{"key":"B","text":"碳碳双键"},{"key":"C","text":"碳碳三键"},{"key":"D","text":"苯环"}],"answer":"A","explanation":"烷烃是饱和烃，碳碳之间都是单键，不含双键、三键或苯环。","verify":"\"碳碳单键\""},{"id":"cnk_h083_q2","topicId":"cnk_h083","difficulty":"basic","type":"choice","prompt":"烷烃的通式是？","choices":[{"key":"A","text":"CnH2n"},{"key":"B","text":"CnH2n+2"},{"key":"C","text":"CnH2n-2"},{"key":"D","text":"CnH2n-6"}],"answer":"B","explanation":"饱和链烃每增加一个碳，就增加两个氢，通式是 CnH2n+2。","verify":"\"CnH2n+2\""},{"id":"cnk_h083_q3","topicId":"cnk_h083","difficulty":"standard","type":"numeric","prompt":"丁烷分子中碳原子数为 4。按通式 CnH2n+2，氢原子数是多少？","answer":"10","explanation":"n＝4 时，氢原子数是 2×4+2＝10。丁烷的分子式是 C4H10。","verify":"2 * 4 + 2"},{"id":"cnk_h083_q4","topicId":"cnk_h083","difficulty":"challenge","type":"choice","prompt":"甲烷与氯气在光照下主要发生的反应类型是？","choices":[{"key":"A","text":"加成反应"},{"key":"B","text":"加聚反应"},{"key":"C","text":"酯化反应"},{"key":"D","text":"取代反应"}],"answer":"D","explanation":"甲烷没有不饱和键，不能加成。光照下氯原子逐步取代氢原子，属于取代反应。","verify":"\"取代反应\""}]
