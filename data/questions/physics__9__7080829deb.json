[{"id":"cnp_058_q1","topicId":"cnp_058","difficulty":"basic","type":"numeric","prompt":"完全燃烧 0.2 kg 汽油放出多少 J 的热量？（q汽油 = 4.6×10⁷ J/kg，只填数值）","answer":"9200000","explanation":"Q = mq = 0.2 × 4.6×10⁷ = 9.2×10⁶ J。","verify":"0.2*4.6e7"},{"id":"cnp_058_q2","topicId":"cnp_058","difficulty":"basic","type":"choice","prompt":"一桶汽油用去一半后，剩下汽油的热值怎样？","choices":[{"key":"A","text":"变为一半"},{"key":"B","text":"变为 2 倍"},{"key":"C","text":"不变"},{"key":"D","text":"无法判断"}],"answer":"C","explanation":"热值是燃料的特性，与质量无关。","verify":"\"不变\""},{"id":"cnp_058_q3","topicId":"cnp_058","difficulty":"standard","type":"numeric","prompt":"某热机燃料完全燃烧放出 1×10⁸ J 的热量，其中 3×10⁷ J 用来做有用功，热机效率是百分之多少？（只填数值）","answer":"30","explanation":"η = 3×10⁷ ÷ 1×10⁸ = 30%。","verify":"3e7/1e8*100","percent":true},{"id":"cnp_058_q4","topicId":"cnp_058","difficulty":"standard","type":"choice","prompt":"下列做法中，不能提高热机效率的是哪一个？","choices":[{"key":"A","text":"使燃料燃烧更充分"},{"key":"B","text":"换用热值更大的燃料"},{"key":"C","text":"减少各种热损失"},{"key":"D","text":"保持良好润滑，减小摩擦"}],"answer":"B","explanation":"热机效率是有用能量占总能量的比例，换热值大的燃料不改变这个比例。","verify":"\"换用热值更大的燃料\""}]
