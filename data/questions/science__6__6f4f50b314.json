[{"id":"cns_p197_q1","topicId":"cns_p197","difficulty":"basic","type":"choice","prompt":"研究昼夜现象时，常用什么代表地球？","choices":[{"key":"A","text":"手电筒"},{"key":"B","text":"镜子"},{"key":"C","text":"地球仪或乒乓球"},{"key":"D","text":"温度计"}],"answer":"C","explanation":"地球仪是地球的模型。","verify":"\"地球仪或乒乓球\""},{"id":"cns_p197_q2","topicId":"cns_p197","difficulty":"basic","type":"choice","prompt":"模拟实验中，手电筒代表什么？","choices":[{"key":"A","text":"月球"},{"key":"B","text":"地球"},{"key":"C","text":"火星"},{"key":"D","text":"太阳"}],"answer":"D","explanation":"手电筒的光代表太阳光。","verify":"\"太阳\""},{"id":"cns_p197_q3","topicId":"cns_p197","difficulty":"standard","type":"choice","prompt":"为什么要用模型来研究地球运动？","choices":[{"key":"A","text":"地球太大，不能直接观察它的运动"},{"key":"B","text":"模型更好看"},{"key":"C","text":"地球不会动"},{"key":"D","text":"模型比地球更大"}],"answer":"A","explanation":"模型实验帮助研究难以直接观察的现象。","verify":"\"地球太大，不能直接观察它的运动\""},{"id":"cns_p197_q4","topicId":"cns_p197","difficulty":"challenge","type":"choice","prompt":"模型实验的结论，和实际情况可能有差别，原因是什么？","choices":[{"key":"A","text":"模型完全等于地球"},{"key":"B","text":"模型和真实地球在大小、条件等方面不同"},{"key":"C","text":"实验一定错"},{"key":"D","text":"地球是平的"}],"answer":"B","explanation":"模型是简化的，有局限性。","verify":"\"模型和真实地球在大小、条件等方面不同\""},{"id":"cns_p198_q1","topicId":"cns_p198","difficulty":"basic","type":"choice","prompt":"昼夜交替是由什么形成的？","choices":[{"key":"A","text":"地球的公转"},{"key":"B","text":"月球的转动"},{"key":"C","text":"太阳的自转"},{"key":"D","text":"地球的自转"}],"answer":"D","explanation":"地球自转使各地轮流朝向太阳。","verify":"\"地球的自转\""},{"id":"cns_p198_q2","topicId":"cns_p198","difficulty":"basic","type":"choice","prompt":"地球自转的方向是怎样的？","choices":[{"key":"A","text":"自西向东"},{"key":"B","text":"自东向西"},{"key":"C","text":"自南向北"},{"key":"D","text":"自北向南"}],"answer":"A","explanation":"所以太阳看起来东升西落。","verify":"\"自西向东\""},{"id":"cns_p198_q3","topicId":"cns_p198","difficulty":"standard","type":"choice","prompt":"地球自转一周大约需要多长时间？","choices":[{"key":"A","text":"约 1 小时"},{"key":"B","text":"约 24 小时"},{"key":"C","text":"约 365 天"},{"key":"D","text":"约 30 天"}],"answer":"B","explanation":"自转一周约为一天。","verify":"\"约 24 小时\""},{"id":"cns_p198_q4","topicId":"cns_p198","difficulty":"challenge","type":"choice","prompt":"如果地球不自转，只绕太阳公转，昼夜会怎样？","choices":[{"key":"A","text":"没有任何变化"},{"key":"B","text":"每小时交替一次"},{"key":"C","text":"昼夜交替周期会变成约一年"},{"key":"D","text":"永远是黑夜"}],"answer":"C","explanation":"那样一面朝向太阳的时间会长达半年。","verify":"\"昼夜交替周期会变成约一年\""},{"id":"cns_p199_q1","topicId":"cns_p199","difficulty":"basic","type":"choice","prompt":"北京和乌鲁木齐，哪里先看到日出？","choices":[{"key":"A","text":"北京"},{"key":"B","text":"乌鲁木齐"},{"key":"C","text":"同时"},{"key":"D","text":"无法判断"}],"answer":"A","explanation":"北京在东边，地球自西向东转，东边先迎来黎明。","verify":"\"北京\""},{"id":"cns_p199_q2","topicId":"cns_p199","difficulty":"basic","type":"choice","prompt":"上海在成都的东边，哪个城市先迎来黎明？","choices":[{"key":"A","text":"成都"},{"key":"B","text":"上海"},{"key":"C","text":"同时"},{"key":"D","text":"看天气"}],"answer":"B","explanation":"越往东，日出越早。","verify":"\"上海\""},{"id":"cns_p199_q3","topicId":"cns_p199","difficulty":"standard","type":"choice","prompt":"我国最东端的黑龙江抚远比最西端新疆帕米尔高原日出早，原因是什么？","choices":[{"key":"A","text":"东边太阳更大"},{"key":"B","text":"东边海拔高"},{"key":"C","text":"地球自西向东自转"},{"key":"D","text":"西边天气差"}],"answer":"C","explanation":"东边先转到朝向太阳的一面。","verify":"\"地球自西向东自转\""},{"id":"cns_p199_q4","topicId":"cns_p199","difficulty":"challenge","type":"choice","prompt":"我国东西两端日出相差约 4 小时，这说明我国东西跨度怎样？","choices":[{"key":"A","text":"很小"},{"key":"B","text":"一样"},{"key":"C","text":"没有关系"},{"key":"D","text":"很大"}],"answer":"D","explanation":"东西跨度大，日出时间差就大。","verify":"\"很大\""},{"id":"cns_p200_q1","topicId":"cns_p200","difficulty":"basic","type":"choice","prompt":"在我国北方，一年中哪一天正午的影子最短？","choices":[{"key":"A","text":"冬至"},{"key":"B","text":"夏至"},{"key":"C","text":"春分"},{"key":"D","text":"秋分"}],"answer":"B","explanation":"夏至太阳最高，影子最短。","verify":"\"夏至\""},{"id":"cns_p200_q2","topicId":"cns_p200","difficulty":"basic","type":"choice","prompt":"在我国北方，一年中哪一天正午的影子最长？","choices":[{"key":"A","text":"夏至"},{"key":"B","text":"春分"},{"key":"C","text":"冬至"},{"key":"D","text":"秋分"}],"answer":"C","explanation":"冬至太阳最低，影子最长。","verify":"\"冬至\""},{"id":"cns_p200_q3","topicId":"cns_p200","difficulty":"standard","type":"choice","prompt":"正午太阳高度越高，影子会怎样？","choices":[{"key":"A","text":"越长"},{"key":"B","text":"不变"},{"key":"C","text":"消失后再出现"},{"key":"D","text":"越短"}],"answer":"D","explanation":"太阳越高，影子越短。","verify":"\"越短\""},{"id":"cns_p200_q4","topicId":"cns_p200","difficulty":"challenge","type":"choice","prompt":"一根竖杆每月 15 日正午测影长，从 1 月到 6 月，影长变化趋势是？","choices":[{"key":"A","text":"逐渐变短"},{"key":"B","text":"逐渐变长"},{"key":"C","text":"一直不变"},{"key":"D","text":"先短后长"}],"answer":"A","explanation":"从冬到夏太阳越来越高，影子越来越短。","verify":"\"逐渐变短\""},{"id":"cns_p201_q1","topicId":"cns_p201","difficulty":"basic","type":"choice","prompt":"地球绕太阳公转一周大约需要多长时间？","choices":[{"key":"A","text":"约一天"},{"key":"B","text":"约一个月"},{"key":"C","text":"约一年（365 天）"},{"key":"D","text":"约十年"}],"answer":"C","explanation":"公转周期约一年。","verify":"\"约一年（365 天）\""},{"id":"cns_p201_q2","topicId":"cns_p201","difficulty":"basic","type":"choice","prompt":"四季的形成和什么有关？","choices":[{"key":"A","text":"地球离太阳忽近忽远"},{"key":"B","text":"地球自转"},{"key":"C","text":"月球的转动"},{"key":"D","text":"地球公转以及地轴倾斜"}],"answer":"D","explanation":"地轴倾斜使太阳直射点在南北间移动。","verify":"\"地球公转以及地轴倾斜\""},{"id":"cns_p201_q3","topicId":"cns_p201","difficulty":"standard","type":"choice","prompt":"我国是夏季时，澳大利亚是什么季节？","choices":[{"key":"A","text":"冬季"},{"key":"B","text":"夏季"},{"key":"C","text":"春季"},{"key":"D","text":"秋季"}],"answer":"A","explanation":"南北半球季节相反。","verify":"\"冬季\""},{"id":"cns_p201_q4","topicId":"cns_p201","difficulty":"challenge","type":"choice","prompt":"如果地轴不倾斜，地球上还会有明显的四季吗？","choices":[{"key":"A","text":"四季更明显"},{"key":"B","text":"不会有明显的四季"},{"key":"C","text":"季节完全不变但更热"},{"key":"D","text":"会有八个季节"}],"answer":"B","explanation":"地轴倾斜是四季形成的关键。","verify":"\"不会有明显的四季\""}]
