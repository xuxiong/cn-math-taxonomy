[{"id":"cnp_063_q1","topicId":"cnp_063","difficulty":"basic","type":"choice","prompt":"电流表应怎样接入电路？","choices":[{"key":"A","text":"并联在被测用电器两端"},{"key":"B","text":"串联在被测电路中"},{"key":"C","text":"直接接在电源两极"},{"key":"D","text":"随便怎样接都可以"}],"answer":"B","explanation":"电流表要串联在被测电路中；直接接在电源两极会烧坏电流表。","verify":"\"串联在被测电路中\""},{"id":"cnp_063_q2","topicId":"cnp_063","difficulty":"basic","type":"numeric","prompt":"0.25 A 等于多少 mA？（只填数值）","answer":"250","explanation":"1 A = 1000 mA，0.25 A = 250 mA。","verify":"0.25*1000"},{"id":"cnp_063_q3","topicId":"cnp_063","difficulty":"standard","type":"choice","prompt":"使用电流表时，指针向左（反向）偏转，原因是什么？","choices":[{"key":"A","text":"量程选小了"},{"key":"B","text":"量程选大了"},{"key":"C","text":"电流表短路了"},{"key":"D","text":"正、负接线柱接反了"}],"answer":"D","explanation":"电流从负接线柱流入时指针反偏。","verify":"\"正、负接线柱接反了\""},{"id":"cnp_063_q4","topicId":"cnp_063","difficulty":"standard","type":"choice","prompt":"电流表选用 0~0.6 A 量程，却按 0~3 A 量程读出 1.5 A，实际电流是多少？","choices":[{"key":"A","text":"1.5 A"},{"key":"B","text":"7.5 A"},{"key":"C","text":"0.15 A"},{"key":"D","text":"0.3 A"}],"answer":"D","explanation":"0~3 A 量程的读数是 0~0.6 A 量程读数的 5 倍，实际电流 1.5 ÷ 5 = 0.3 A。","verify":"1.5/5"}]
