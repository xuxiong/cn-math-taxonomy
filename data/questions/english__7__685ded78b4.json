[{"id":"cne_j001_q1","topicId":"cne_j001","difficulty":"basic","type":"choice","prompt":"teacher 的重音在第几个音节？","choices":[{"key":"A","text":"第二个音节"},{"key":"B","text":"两个音节同样重"},{"key":"C","text":"第一个音节"},{"key":"D","text":"没有重音"}],"answer":"C","explanation":"tea-cher 的重音在 tea。","verify":"\"第一个音节\""},{"id":"cne_j001_q2","topicId":"cne_j001","difficulty":"basic","type":"choice","prompt":"about 的重音在第几个音节？","choices":[{"key":"A","text":"第一个音节"},{"key":"B","text":"两个音节同样重"},{"key":"C","text":"没有重音"},{"key":"D","text":"第二个音节"}],"answer":"D","explanation":"a-bout 的重音在 bout。","verify":"\"第二个音节\""},{"id":"cne_j001_q3","topicId":"cne_j001","difficulty":"standard","type":"choice","prompt":"哪个单词的重音在第二个音节？","choices":[{"key":"A","text":"begin"},{"key":"B","text":"student"},{"key":"C","text":"China"},{"key":"D","text":"apple"}],"answer":"A","explanation":"be-gin 的重音在 gin，其余三个词的重音在第一个音节。","verify":"\"begin\""},{"id":"cne_j001_q4","topicId":"cne_j001","difficulty":"standard","type":"choice","prompt":"computer 的重音在第几个音节？","choices":[{"key":"A","text":"第一个音节"},{"key":"B","text":"第二个音节"},{"key":"C","text":"第三个音节"},{"key":"D","text":"三个音节同样重"}],"answer":"B","explanation":"com-pu-ter 的重音在 pu。","verify":"\"第二个音节\""},{"id":"cne_j002_q1","topicId":"cne_j002","difficulty":"basic","type":"choice","prompt":"一般疑问句 Are you a student? 句末通常用什么语调？","choices":[{"key":"A","text":"降调"},{"key":"B","text":"先降后升"},{"key":"C","text":"每个词都重读"},{"key":"D","text":"升调"}],"answer":"D","explanation":"一般疑问句句末通常用升调。","verify":"\"升调\""},{"id":"cne_j002_q2","topicId":"cne_j002","difficulty":"basic","type":"choice","prompt":"陈述句 My name is Gina. 句末通常用什么语调？","choices":[{"key":"A","text":"降调"},{"key":"B","text":"升调"},{"key":"C","text":"先升后降再升"},{"key":"D","text":"没有语调"}],"answer":"A","explanation":"陈述句句末通常用降调。","verify":"\"降调\""},{"id":"cne_j002_q3","topicId":"cne_j002","difficulty":"standard","type":"choice","prompt":"特殊疑问句 Where is she? 句末通常用什么语调？","choices":[{"key":"A","text":"升调"},{"key":"B","text":"降调"},{"key":"C","text":"和一般疑问句相同的升调"},{"key":"D","text":"只在 where 上升"}],"answer":"B","explanation":"特殊疑问句句末通常用降调。","verify":"\"降调\""},{"id":"cne_j002_q4","topicId":"cne_j002","difficulty":"standard","type":"choice","prompt":"哪一句朗读时句末通常用升调？","choices":[{"key":"A","text":"He is my friend."},{"key":"B","text":"Where is your friend?"},{"key":"C","text":"Is he your friend?"},{"key":"D","text":"She is Gina."}],"answer":"C","explanation":"Is he your friend 是一般疑问句，句末用升调。","verify":"\"Is he your friend?\""},{"id":"cne_j003_q1","topicId":"cne_j003","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「名字」？","choices":[{"key":"A","text":"name"},{"key":"B","text":"friend"},{"key":"C","text":"girl"},{"key":"D","text":"boy"}],"answer":"A","explanation":"name 的意思是名字。","verify":"\"name\""},{"id":"cne_j003_q2","topicId":"cne_j003","difficulty":"basic","type":"choice","prompt":"「friend」的中文意思是哪一个？","choices":[{"key":"A","text":"名字"},{"key":"B","text":"朋友"},{"key":"C","text":"女孩"},{"key":"D","text":"男孩"}],"answer":"B","explanation":"friend 的意思是朋友。","verify":"\"朋友\""},{"id":"cne_j003_q3","topicId":"cne_j003","difficulty":"standard","type":"choice","prompt":"选择表示「女孩」的单词。","choices":[{"key":"A","text":"name"},{"key":"B","text":"friend"},{"key":"C","text":"girl"},{"key":"D","text":"boy"}],"answer":"C","explanation":"表示女孩的单词是 girl。","verify":"\"girl\""},{"id":"cne_j003_q4","topicId":"cne_j003","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「男孩」？","choices":[{"key":"A","text":"name"},{"key":"B","text":"friend"},{"key":"C","text":"girl"},{"key":"D","text":"boy"}],"answer":"D","explanation":"boy 的意思是男孩。","verify":"\"boy\""},{"id":"cne_j005_q1","topicId":"cne_j005","difficulty":"basic","type":"choice","prompt":"初次见面，对方说 Nice to meet you. 你应回答什么？","choices":[{"key":"A","text":"Good night."},{"key":"B","text":"See you yesterday."},{"key":"C","text":"Nice to meet you, too."},{"key":"D","text":"Nice to meeting you, too."}],"answer":"C","explanation":"回答 Nice to meet you 时加上 too。","verify":"\"Nice to meet you, too.\""},{"id":"cne_j005_q2","topicId":"cne_j005","difficulty":"basic","type":"choice","prompt":"想告诉别人自己叫 Gina，哪一句合适？","choices":[{"key":"A","text":"Your name is Gina."},{"key":"B","text":"She name is Gina."},{"key":"C","text":"My name are Gina."},{"key":"D","text":"My name is Gina."}],"answer":"D","explanation":"说自己的名字用 My name is。","verify":"\"My name is Gina.\""},{"id":"cne_j005_q3","topicId":"cne_j005","difficulty":"standard","type":"choice","prompt":"早上见面，哪一句是问候？","choices":[{"key":"A","text":"Good morning."},{"key":"B","text":"Good mornings."},{"key":"C","text":"Goodbye."},{"key":"D","text":"Good afternoon."}],"answer":"A","explanation":"Good morning 用来问候早晨。","verify":"\"Good morning.\""},{"id":"cne_j005_q4","topicId":"cne_j005","difficulty":"standard","type":"choice","prompt":"对方问 What's your name? 你叫 Tom，应回答什么？","choices":[{"key":"A","text":"His name is Tom."},{"key":"B","text":"My name is Tom."},{"key":"C","text":"I name Tom."},{"key":"D","text":"You are Tom?"}],"answer":"B","explanation":"询问你的名字时，用 My name is 回答。","verify":"\"My name is Tom.\""}]
