ices":[{"key":"A","text":"Good morning."},{"key":"B","text":"Good mornings."},{"key":"C","text":"Goodbye."},{"key":"D","text":"Good afternoon."}],"answer":"A","explanation":"Good morning 用来问候早晨。","verify":"\"Good morning.\""},{"id":"cne_j005_q4","topicId":"cne_j005","difficulty":"standard","type":"choice","prompt":"对方问 What's your name? 你叫 Tom，应回答什么？","choices":[{"key":"A","text":"His name is Tom."},{"key":"B","text":"My name is Tom."},{"key":"C","text":"I name Tom."},{"key":"D","text":"You are Tom?"}],"answer":"B","explanation":"询问你的名字时，用 My name is 回答。","verify":"\"My name is Tom.\""}]
