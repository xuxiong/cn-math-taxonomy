[{"id":"cne_p270_q1","topicId":"cne_p270","difficulty":"basic","type":"choice","prompt":"quietly 的意思是？","choices":[{"key":"A","text":"安静地"},{"key":"B","text":"大声地"},{"key":"C","text":"快速地"},{"key":"D","text":"慢慢地"}],"answer":"A","explanation":"quietly 是安静地。","verify":"\"安静地\""},{"id":"cne_p270_q2","topicId":"cne_p270","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「大声地」？","choices":[{"key":"A","text":"quietly"},{"key":"B","text":"clean"},{"key":"C","text":"right"},{"key":"D","text":"loudly"}],"answer":"D","explanation":"loudly 是大声地。","verify":"\"loudly\""},{"id":"cne_p270_q3","topicId":"cne_p270","difficulty":"standard","type":"choice","prompt":"keep your desk clean 是在说？","choices":[{"key":"A","text":"大声说话"},{"key":"B","text":"跑步"},{"key":"C","text":"保持书桌干净"},{"key":"D","text":"靠右走"}],"answer":"C","explanation":"keep … clean。","verify":"\"保持书桌干净\""},{"id":"cne_p270_q4","topicId":"cne_p270","difficulty":"challenge","type":"choice","prompt":"读一读：Talk quietly. Don't talk loudly. 两句都在强调？","choices":[{"key":"A","text":"保持书桌"},{"key":"B","text":"要小声说话"},{"key":"C","text":"要大喊"},{"key":"D","text":"不要说话也可以大喊"}],"answer":"B","explanation":"quietly，不要 loudly。","verify":"\"要小声说话\""},{"id":"cne_p271_q1","topicId":"cne_p271","difficulty":"basic","type":"choice","prompt":"想说「禁止饮食」，应选哪一句？","choices":[{"key":"A","text":"No eating or drinking."},{"key":"B","text":"No eat or drink."},{"key":"C","text":"Not eating or drinking."},{"key":"D","text":"Don't eating."}],"answer":"A","explanation":"No + doing。","verify":"\"No eating or drinking.\""},{"id":"cne_p271_q2","topicId":"cne_p271","difficulty":"basic","type":"choice","prompt":"Keep to the right. 这句是在说？","choices":[{"key":"A","text":"靠左走"},{"key":"B","text":"保持安静"},{"key":"C","text":"不要走"},{"key":"D","text":"靠右走"}],"answer":"D","explanation":"Keep to the right。","verify":"\"靠右走\""},{"id":"cne_p271_q3","topicId":"cne_p271","difficulty":"standard","type":"choice","prompt":"哪一句正确？","choices":[{"key":"A","text":"Keep your desk to clean."},{"key":"B","text":"Keeping your desk clean is no."},{"key":"C","text":"Keep your desk clean."},{"key":"D","text":"Keep your desk cleaning."}],"answer":"C","explanation":"Keep + 名词 + 形容词。","verify":"\"Keep your desk clean.\""},{"id":"cne_p271_q4","topicId":"cne_p271","difficulty":"challenge","type":"choice","prompt":"读一读：Library rules: Talk quietly. No eating. Keep the books clean. 可以做的是？","choices":[{"key":"A","text":"大声喊"},{"key":"B","text":"小声说话"},{"key":"C","text":"吃零食"},{"key":"D","text":"把书弄脏"}],"answer":"B","explanation":"Talk quietly 是允许的要求。","verify":"\"小声说话\""},{"id":"cne_p272_q1","topicId":"cne_p272","difficulty":"basic","type":"choice","prompt":"在图书馆应选哪一句？","choices":[{"key":"A","text":"Talk quietly."},{"key":"B","text":"Talk loudly."},{"key":"C","text":"Run fast."},{"key":"D","text":"Eat snacks."}],"answer":"A","explanation":"图书馆要小声。","verify":"\"Talk quietly.\""},{"id":"cne_p272_q2","topicId":"cne_p272","difficulty":"basic","type":"choice","prompt":"Work quietly. 这句要求？","choices":[{"key":"A","text":"大声玩"},{"key":"B","text":"跑出教室"},{"key":"C","text":"吃东西"},{"key":"D","text":"安静地做事"}],"answer":"D","explanation":"Work quietly。","verify":"\"安静地做事\""},{"id":"cne_p272_q3","topicId":"cne_p272","difficulty":"standard","type":"choice","prompt":"哪一句适合教室？","choices":[{"key":"A","text":"Throw paper on the floor."},{"key":"B","text":"Run between desks."},{"key":"C","text":"Keep your desk clean."},{"key":"D","text":"Shout in class."}],"answer":"C","explanation":"保持书桌干净。","verify":"\"Keep your desk clean.\""},{"id":"cne_p272_q4","topicId":"cne_p272","difficulty":"challenge","type":"choice","prompt":"读情景：同学们在阅览室看书。管理员最该说？","choices":[{"key":"A","text":"Please eat here."},{"key":"B","text":"Please work quietly."},{"key":"C","text":"Please shout."},{"key":"D","text":"Please run."}],"answer":"B","explanation":"阅览室要安静做事。","verify":"\"Please work quietly.\""},{"id":"cne_p273_q1","topicId":"cne_p273","difficulty":"basic","type":"choice","prompt":"想说「他们正在安静地看书」，应选哪一句？","choices":[{"key":"A","text":"They are reading quietly."},{"key":"B","text":"They are read quietly."},{"key":"C","text":"They reading quietly."},{"key":"D","text":"They is reading quietly."}],"answer":"A","explanation":"are + reading + quietly。","verify":"\"They are reading quietly.\""},{"id":"cne_p273_q2","topicId":"cne_p273","difficulty":"basic","type":"choice","prompt":"He is shouting in the library. 他守规吗？","choices":[{"key":"A","text":"守规"},{"key":"B","text":"在睡觉"},{"key":"C","text":"在排队"},{"key":"D","text":"不守规"}],"answer":"D","explanation":"图书馆不应大喊。","verify":"\"不守规\""},{"id":"cne_p273_q3","topicId":"cne_p273","difficulty":"standard","type":"choice","prompt":"哪一句既写正在做又守规？","choices":[{"key":"A","text":"She walking quietly."},{"key":"B","text":"She are walking quietly."},{"key":"C","text":"She is walking quietly in the hall."},{"key":"D","text":"She is running in the hall."}],"answer":"C","explanation":"walking quietly。","verify":"\"She is walking quietly in the hall.\""},{"id":"cne_p273_q4","topicId":"cne_p273","difficulty":"challenge","type":"choice","prompt":"读一读：Rule: No eating. Look! Tom is eating an apple. 汤姆？","choices":[{"key":"A","text":"规则允许吃"},{"key":"B","text":"违规了"},{"key":"C","text":"守规"},{"key":"D","text":"没有在吃"}],"answer":"B","explanation":"No eating，他却 is eating。","verify":"\"违规了\""},{"id":"cne_p274_q1","topicId":"cne_p274","difficulty":"basic","type":"choice","prompt":"想说「请排队」，应选哪一句？","choices":[{"key":"A","text":"Please wait in line."},{"key":"B","text":"Please wait in lines."},{"key":"C","text":"Please waiting in line."},{"key":"D","text":"Please wait on line classroom."}],"answer":"A","explanation":"wait in line。","verify":"\"Please wait in line.\""},{"id":"cne_p274_q2","topicId":"cne_p274","difficulty":"basic","type":"choice","prompt":"take turns 的意思是？","choices":[{"key":"A","text":"插队"},{"key":"B","text":"奔跑"},{"key":"C","text":"大喊"},{"key":"D","text":"轮流"}],"answer":"D","explanation":"take turns 是轮流。","verify":"\"轮流\""},{"id":"cne_p274_q3","topicId":"cne_p274","difficulty":"standard","type":"choice","prompt":"哪一句正确？","choices":[{"key":"A","text":"Let's takes turns."},{"key":"B","text":"Let's take turnings."},{"key":"C","text":"Let's take turns."},{"key":"D","text":"Let's take turning."}],"answer":"C","explanation":"take turns。","verify":"\"Let's take turns.\""},{"id":"cne_p274_q4","topicId":"cne_p274","difficulty":"challenge","type":"choice","prompt":"读一读：Keep to the right. Wait in line. Take turns. 这三条都在讲？","choices":[{"key":"A","text":"怎么画画"},{"key":"B","text":"公共秩序"},{"key":"C","text":"怎么做饭"},{"key":"D","text":"怎么游泳"}],"answer":"B","explanation":"靠右、排队、轮流都是秩序。","verify":"\"公共秩序\""},{"id":"cne_p275_q1","topicId":"cne_p275","difficulty":"basic","type":"choice","prompt":"读一读：Talk quietly. Do not eat. 不可以做什么？","choices":[{"key":"A","text":"吃东西"},{"key":"B","text":"小声说话"},{"key":"C","text":"看书"},{"key":"D","text":"排队"}],"answer":"A","explanation":"Do not eat。","verify":"\"吃东西\""},{"id":"cne_p275_q2","topicId":"cne_p275","difficulty":"basic","type":"choice","prompt":"读一读：Keep to the right. 应怎样走？","choices":[{"key":"A","text":"靠左"},{"key":"B","text":"跑"},{"key":"C","text":"停住不走"},{"key":"D","text":"靠右"}],"answer":"D","explanation":"Keep to the right。","verify":"\"靠右\""},{"id":"cne_p275_q3","topicId":"cne_p275","difficulty":"standard","type":"choice","prompt":"读一读：We are in the library. Please work quietly. Keep the books clean. 哪一句一致？","choices":[{"key":"A","text":"可以大喊。"},{"key":"B","text":"可以把书撕坏。"},{"key":"C","text":"请安静做事并爱护书。"},{"key":"D","text":"可以吃东西。"}],"answer":"C","explanation":"work quietly … books clean。","verify":"\"请安静做事并爱护书。\""},{"id":"cne_p275_q4","topicId":"cne_p275","difficulty":"challenge","type":"choice","prompt":"读一读：Rules: 1. Take turns. 2. No running. 3. Keep the desk clean. 小明在跑，他违反了第几条？","choices":[{"key":"A","text":"没有违反"},{"key":"B","text":"第 2 条"},{"key":"C","text":"第 1 条"},{"key":"D","text":"第 3 条"}],"answer":"B","explanation":"No running 是第 2 条。","verify":"\"第 2 条\""}]
