[{"id":"cng_j055_q1","topicId":"cng_j055","difficulty":"basic","type":"choice","prompt":"西北地区最显著的自然特征是？","choices":[{"key":"A","text":"干旱"},{"key":"B","text":"湿热"},{"key":"C","text":"高寒且降水极为丰富"},{"key":"D","text":"与江南水乡相同"}],"answer":"A","explanation":"深居内陆、距海遥远，降水稀少。","verify":"\"干旱\""},{"id":"cng_j055_q2","topicId":"cng_j055","difficulty":"basic","type":"choice","prompt":"从东到西，西北地区的自然景观大致是？","choices":[{"key":"A","text":"森林—雨林—海洋"},{"key":"B","text":"草原—荒漠草原—荒漠"},{"key":"C","text":"水田—丘陵—雪山且降水递增"},{"key":"D","text":"与距海远近无关"}],"answer":"B","explanation":"降水自东向西递减，植被随之变化。","verify":"\"草原—荒漠草原—荒漠\""},{"id":"cng_j055_q3","topicId":"cng_j055","difficulty":"standard","type":"choice","prompt":"本区农业以畜牧业和灌溉农业为主，灌溉水源主要来自？","choices":[{"key":"A","text":"丰沛的台风雨"},{"key":"B","text":"赤道对流雨"},{"key":"C","text":"高山冰雪融水和地下水"},{"key":"D","text":"当地全年的暴雨"}],"answer":"C","explanation":"天山、祁连山等高山冰雪融水补给绿洲。","verify":"\"高山冰雪融水和地下水\""},{"id":"cng_j055_q4","topicId":"cng_j055","difficulty":"challenge","type":"choice","prompt":"过度放牧和开垦会导致？","choices":[{"key":"A","text":"草原自动恢复且无需管理"},{"key":"B","text":"降水突然增加到江南水平"},{"key":"C","text":"沙漠全部变成水田"},{"key":"D","text":"土地荒漠化加剧"}],"answer":"D","explanation":"干旱区生态脆弱，必须合理放牧、保护植被。","verify":"\"土地荒漠化加剧\""},{"id":"cng_j056_q1","topicId":"cng_j056","difficulty":"basic","type":"choice","prompt":"塔里木盆地是我国面积最大的盆地，位于？","choices":[{"key":"A","text":"四川东部"},{"key":"B","text":"新疆南部"},{"key":"C","text":"青海湖边"},{"key":"D","text":"东北平原中部"}],"answer":"B","explanation":"盆地周围是天山、昆仑山等山脉，内部是塔克拉玛干沙漠。","verify":"\"新疆南部\""},{"id":"cng_j056_q2","topicId":"cng_j056","difficulty":"basic","type":"choice","prompt":"盆地边缘出现串珠状绿洲，主要因为？","choices":[{"key":"A","text":"盆地中心降水最多"},{"key":"B","text":"绿洲与水源无关"},{"key":"C","text":"高山冰雪融水在山麓形成水源"},{"key":"D","text":"全年受台风灌溉"}],"answer":"C","explanation":"冰雪融水出山后，在冲积扇前缘形成绿洲。","verify":"\"高山冰雪融水在山麓形成水源\""},{"id":"cng_j056_q3","topicId":"cng_j056","difficulty":"standard","type":"choice","prompt":"西气东输工程的气源地之一是？","choices":[{"key":"A","text":"珠江三角洲的水田"},{"key":"B","text":"长江三角洲的全部港口"},{"key":"C","text":"东南沿海的渔场"},{"key":"D","text":"塔里木盆地的天然气田"}],"answer":"D","explanation":"轮南等地的天然气通过管道输往上海等东部城市。","verify":"\"塔里木盆地的天然气田\""},{"id":"cng_j056_q4","topicId":"cng_j056","difficulty":"challenge","type":"choice","prompt":"在塔里木盆地发展农业，必须特别注意？","choices":[{"key":"A","text":"节约用水，保护绿洲生态"},{"key":"B","text":"大水漫灌且开垦全部沙漠"},{"key":"C","text":"砍伐全部胡杨"},{"key":"D","text":"把内流河引入海洋"}],"answer":"A","explanation":"水资源是绿洲的生命线，过度用水会使河流下游和植被衰退。","verify":"\"节约用水，保护绿洲生态\""}]
