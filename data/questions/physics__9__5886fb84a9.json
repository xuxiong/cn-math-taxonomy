[{"id":"cnp_053_q1","topicId":"cnp_053","difficulty":"basic","type":"numeric","prompt":"质量为 2 kg 的水温度升高 10 ℃，吸收多少 J 的热量？（c水 = 4.2×10³ J/(kg·℃)，只填数值）","answer":"84000","explanation":"Q = cmΔt = 4200 × 2 × 10 = 84000 J。","verify":"4.2e3*2*10"},{"id":"cnp_053_q2","topicId":"cnp_053","difficulty":"basic","type":"choice","prompt":"沿海地区昼夜温差比内陆小，主要是因为水的什么性质？","choices":[{"key":"A","text":"比热容大"},{"key":"B","text":"密度大"},{"key":"C","text":"沸点高"},{"key":"D","text":"热值大"}],"answer":"A","explanation":"水的比热容大，吸收或放出相同热量时温度变化小。","verify":"\"比热容大\""},{"id":"cnp_053_q3","topicId":"cnp_053","difficulty":"standard","type":"choice","prompt":"一杯水倒掉一半后，剩下水的比热容怎样？","choices":[{"key":"A","text":"不变"},{"key":"B","text":"变为原来的一半"},{"key":"C","text":"变为原来的 2 倍"},{"key":"D","text":"无法确定"}],"answer":"A","explanation":"比热容是物质的特性，与质量多少无关。","verify":"\"不变\""},{"id":"cnp_053_q4","topicId":"cnp_053","difficulty":"standard","type":"numeric","prompt":"质量为 0.5 kg 的某金属吸收 4.6×10³ J 的热量后温度升高 20 ℃，它的比热容是多少 J/(kg·℃)？（只填数值）","answer":"460","explanation":"c = Q/(mΔt) = 4600 ÷ (0.5 × 20) = 460 J/(kg·℃)。","verify":"4.6e3/(0.5*20)"}]
