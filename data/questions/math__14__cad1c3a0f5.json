[{"id":"cnm_h243_q1","topicId":"cnm_h243","difficulty":"basic","type":"numeric","prompt":"把 (a+b)^n 的二项式系数排成一行，n 从 0 开始。n=5 这一行、从左数第 3 个数（对应 k=2）是多少？","answer":"10","explanation":"这个位置是 C(5,2)=10。","verify":"comb(5,2)"},{"id":"cnm_h243_q2","topicId":"cnm_h243","difficulty":"basic","type":"numeric","prompt":"n=4 这一行所有数相加，和是多少？","answer":"16","explanation":"二项式系数之和是 2^4=16。","verify":"2**4"},{"id":"cnm_h243_q3","topicId":"cnm_h243","difficulty":"standard","type":"numeric","prompt":"杨辉三角中，C(5,1)+C(5,2) 等于下一行的哪一个组合数的值？先算出这个和。","answer":"15","explanation":"C(6,2)=C(5,1)+C(5,2)=5+10=15。","verify":"comb(5,1)+comb(5,2)"},{"id":"cnm_h243_q4","topicId":"cnm_h243","difficulty":"standard","type":"choice","prompt":"杨辉三角和二项式定理是什么关系？","choices":[{"key":"A","text":"每一行都是自然数 1、2、3 的依次排列"},{"key":"B","text":"它只用来计算等差数列的和"},{"key":"C","text":"它与组合数没有关系"},{"key":"D","text":"每一行就是一次二项式展开的系数"}],"answer":"D","explanation":"第 n 行（从 0 数）正是 (a+b)^n 的二项式系数。","verify":"\"每一行就是一次二项式展开的系数\""}]
