[{"id":"cnk_h031_q1","topicId":"cnk_h031","difficulty":"basic","type":"choice","prompt":"有机化合物在组成上最突出的特点是？","choices":[{"key":"A","text":"一定含有碳元素"},{"key":"B","text":"一定含有钠元素"},{"key":"C","text":"一定是离子化合物"},{"key":"D","text":"一定不含氢"}],"answer":"A","explanation":"有机化合物是碳的化合物（一氧化碳、二氧化碳、碳酸盐等习惯上不算有机物）。多数还含氢。","verify":"\"一定含有碳元素\""},{"id":"cnk_h031_q2","topicId":"cnk_h031","difficulty":"basic","type":"choice","prompt":"认识一类有机物的性质，关键是看它的？","choices":[{"key":"A","text":"只看瓶子的颜色"},{"key":"B","text":"官能团"},{"key":"C","text":"只看是不是固体"},{"key":"D","text":"只看谁先被发现"}],"answer":"B","explanation":"官能团决定有机物的特征反应。碳骨架说明碳原子怎样连接。","verify":"\"官能团\""},{"id":"cnk_h031_q3","topicId":"cnk_h031","difficulty":"standard","type":"choice","prompt":"甲烷、乙烷、丙烷彼此相差一个或几个 CH2，它们互称为？","choices":[{"key":"A","text":"同素异形体"},{"key":"B","text":"合金"},{"key":"C","text":"同系物"},{"key":"D","text":"同位素"}],"answer":"C","explanation":"结构相似、组成上相差若干个 CH2 的物质互为同系物。同素异形体是同一元素的不同单质。","verify":"\"同系物\""},{"id":"cnk_h031_q4","topicId":"cnk_h031","difficulty":"challenge","type":"choice","prompt":"分子式都是 C2H6O，一种是乙醇，一种是甲醚。它们属于？","choices":[{"key":"A","text":"同一种物质，只是名称不同"},{"key":"B","text":"同素异形体"},{"key":"C","text":"金属单质"},{"key":"D","text":"同分异构体"}],"answer":"D","explanation":"分子式相同、结构不同的化合物互为同分异构体。乙醇有羟基，甲醚有醚键，性质不同。","verify":"\"同分异构体\""}]
