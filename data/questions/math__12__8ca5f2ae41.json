[{"id":"cnm_h169_q1","topicId":"cnm_h169","difficulty":"basic","type":"numeric","prompt":"直线过 (1，2)，斜率是 3。它在 y 轴上的截距是多少？","answer":"-1","explanation":"y−2=3(x−1)。x=0 时 y=2−3=−1。","verify":"2+3*(0-1)"},{"id":"cnm_h169_q2","topicId":"cnm_h169","difficulty":"basic","type":"numeric","prompt":"直线 y−4=2(x−1)。斜率是多少？","answer":"2","explanation":"点斜式里 x 的系数就是斜率 2。","verify":"2"},{"id":"cnm_h169_q3","topicId":"cnm_h169","difficulty":"standard","type":"numeric","prompt":"直线过 (0，−1)，斜率是 −2。当 x=3 时，y 是多少？","answer":"-7","explanation":"y+1=−2(x−0)，x=3 时 y=−1−6=−7。","verify":"-1+(-2)*(3-0)"},{"id":"cnm_h169_q4","topicId":"cnm_h169","difficulty":"standard","type":"choice","prompt":"点斜式不能直接表示哪一种直线？","choices":[{"key":"A","text":"斜率为 0 的直线"},{"key":"B","text":"垂直于 x 轴、斜率不存在的直线"},{"key":"C","text":"过原点且斜率为 1 的直线"},{"key":"D","text":"斜率为 −1 的直线"}],"answer":"B","explanation":"点斜式先要有斜率。垂直于 x 轴的直线没有斜率，要用 x=x0。","verify":"\"垂直于 x 轴、斜率不存在的直线\""},{"id":"cnm_h170_q1","topicId":"cnm_h170","difficulty":"basic","type":"numeric","prompt":"直线 x/2+y/3=1 的纵截距是多少？","answer":"3","explanation":"y 下面的分母就是纵截距 3。","verify":"3"},{"id":"cnm_h170_q2","topicId":"cnm_h170","difficulty":"basic","type":"numeric","prompt":"直线 x/4+y/5=1 的横截距是多少？","answer":"4","explanation":"x 下面的分母就是横截距 4。","verify":"4"},{"id":"cnm_h170_q3","topicId":"cnm_h170","difficulty":"standard","type":"choice","prompt":"过原点的直线能不能写成截距式 x/a+y/b=1？","choices":[{"key":"A","text":"能，只要斜率为 1"},{"key":"B","text":"不能，两个截距里至少有一个是 0"},{"key":"C","text":"能，a 和 b 都写成 0"},{"key":"D","text":"不能，因为原点没有坐标"}],"answer":"B","explanation":"截距式要求两个截距都不为 0。过原点时至少有一个截距是 0。","verify":"\"不能，两个截距里至少有一个是 0\""},{"id":"cnm_h170_q4","topicId":"cnm_h170","difficulty":"standard","type":"numeric","prompt":"直线横截距是 6，纵截距是 2。横截距与纵截距的和是多少？","answer":"8","explanation":"截距式是 x/6+y/2=1，两个截距之和是 8。","verify":"6+2"},{"id":"cnm_h171_q1","topicId":"cnm_h171","difficulty":"basic","type":"numeric","prompt":"直线 2x−y+4=0 的斜率是多少？","answer":"2","explanation":"写成 y=2x+4，斜率是 2。也可以用 −A/B=−2/(−1)=2。","verify":"2"},{"id":"cnm_h171_q2","topicId":"cnm_h171","difficulty":"basic","type":"numeric","prompt":"直线 x+2y−6=0 的斜率是多少？","answer":"-1/2","explanation":"y=−x/2+3，斜率是 −1/2。","verify":"Fraction(-1,2)"},{"id":"cnm_h171_q3","topicId":"cnm_h171","difficulty":"standard","type":"numeric","prompt":"直线 3x+4y−12=0 与 y 轴交点的纵坐标是多少？","answer":"3","explanation":"x=0 时 4y=12，y=3。","verify":"3"},{"id":"cnm_h171_q4","topicId":"cnm_h171","difficulty":"standard","type":"choice","prompt":"方程 Ax+By+C=0 表示直线时，A 和 B 必须满足什么？","choices":[{"key":"A","text":"必须都等于 1"},{"key":"B","text":"必须 A=B"},{"key":"C","text":"必须 C=0"},{"key":"D","text":"不能同时为 0"}],"answer":"D","explanation":"A、B 同时为 0 时不再是关于 x、y 的一次方程，不能表示直线。","verify":"\"不能同时为 0\""}]
