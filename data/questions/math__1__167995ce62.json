[{"difficulty":"basic","type":"numeric","prompt":"3 的后面一个数是几？","answer":"4","explanation":"从 1 往后数，3 的后面是 4。","verify":"3+1","id":"cnm_p001_q1","topicId":"cnm_p001"},{"difficulty":"basic","type":"numeric","prompt":"4 的前面一个数是几？","answer":"3","explanation":"4 的前面是 3。","verify":"4-1","id":"cnm_p001_q2","topicId":"cnm_p001"},{"difficulty":"standard","type":"numeric","prompt":"5 的前面一个数是几？","answer":"4","explanation":"5 往前一个数是 4。","verify":"5-1","id":"cnm_p001_q3","topicId":"cnm_p001"},{"difficulty":"challenge","type":"numeric","prompt":"小明数数：1，2，3，5。他漏掉了哪一个数？","answer":"4","explanation":"1 到 5 要一个一个数，3 和 5 中间是 4。","verify":"3+1","id":"cnm_p001_q4","topicId":"cnm_p001"},{"difficulty":"basic","type":"choice","prompt":"4 和 2 比，哪个数大？","choices":[{"key":"A","text":"4"},{"key":"B","text":"2"},{"key":"C","text":"一样大"}],"answer":"A","explanation":"4 排在 2 的后面，所以 4 比 2 大。","verify":"'4'","id":"cnm_p002_q1","topicId":"cnm_p002"},{"difficulty":"basic","type":"numeric","prompt":"5 比 3 大几？","answer":"2","explanation":"从 3 数到 5，5 比 3 大 2。","verify":"5-3","id":"cnm_p002_q2","topicId":"cnm_p002"},{"difficulty":"standard","type":"choice","prompt":"盘子里有 4 个苹果，碗里有 2 个梨。哪种水果多？","choices":[{"key":"A","text":"苹果多"},{"key":"B","text":"梨多"},{"key":"C","text":"一样多"},{"key":"D","text":"无法比较"}],"answer":"A","explanation":"4 比 2 大，苹果多。","verify":"'苹果多'","id":"cnm_p002_q3","topicId":"cnm_p002"},{"difficulty":"challenge","type":"numeric","prompt":"比 1 大、又比 4 小的数有 2 和 3。其中较大的是几？","answer":"3","explanation":"2 和 3 都在 1 和 4 中间，3 比 2 大。","verify":"3","id":"cnm_p002_q4","topicId":"cnm_p002"},{"difficulty":"basic","type":"choice","prompt":"从左数，排在最前面的是第几个？","choices":[{"key":"A","text":"第1个"},{"key":"B","text":"第5个"},{"key":"C","text":"一共有5个"}],"answer":"A","explanation":"「第几」从 1 开始数，最前面是第 1 个。","verify":"'第1个'","id":"cnm_p003_q1","topicId":"cnm_p003"},{"difficulty":"basic","type":"numeric","prompt":"一队 5 个小朋友，从左数小明是第 3 个。他前面有几人？","answer":"2","explanation":"第 3 个的前面是第 1 个和第 2 个，一共 2 人。有几个要和第几个分开。","verify":"3-1","id":"cnm_p003_q2","topicId":"cnm_p003"},{"difficulty":"standard","type":"numeric","prompt":"5 个小朋友排成一队，小华排在第 5 个，小丽排在小华的前面一个。小丽排第几？","answer":"4","explanation":"小华是第 5 个，前面一个是第 4 个。","verify":"5-1","id":"cnm_p003_q3","topicId":"cnm_p003"},{"difficulty":"challenge","type":"numeric","prompt":"从左边数小红是第 2，从右边数她是第 3。这一排一共有几人？","answer":"4","explanation":"左边算上小红有 2 人，右边还有 2 人，中间的小红不能数两次：2＋3－1＝4。","verify":"2+3-1","id":"cnm_p003_q4","topicId":"cnm_p003"},{"difficulty":"basic","type":"numeric","prompt":"5 可以分成 2 和几？","answer":"3","explanation":"2 和 3 合起来是 5。","verify":"5-2","id":"cnm_p004_q1","topicId":"cnm_p004"},{"difficulty":"basic","type":"numeric","prompt":"1 和 4 合起来是几？","answer":"5","explanation":"1＋4＝5。","verify":"1+4","id":"cnm_p004_q2","topicId":"cnm_p004"},{"difficulty":"standard","type":"numeric","prompt":"4 可以分成 1 和几？","answer":"3","explanation":"1 和 3 合起来是 4。","verify":"4-1","id":"cnm_p004_q3","topicId":"cnm_p004"},{"difficulty":"challenge","type":"numeric","prompt":"把 4 分成两份，两份同样多。每一份是几？","answer":"2","explanation":"2 和 2 合起来是 4，每一份是 2。","verify":"4-2","id":"cnm_p004_q4","topicId":"cnm_p004"},{"difficulty":"basic","type":"choice","prompt":"0 表示一个也没有。盘子里一个苹果也没有，用哪个数表示？","choices":[{"key":"A","text":"0"},{"key":"B","text":"1"},{"key":"C","text":"5"}],"answer":"A","explanation":"一个也没有，用 0 表示。","verify":"'0'","id":"cnm_p005_q1","topicId":"cnm_p005"},{"difficulty":"basic","type":"numeric","prompt":"有 3 个气球，全部飞走了。还剩几个？","answer":"0","explanation":"3 个都飞走了，一个也不剩，是 0。","verify":"3-3","id":"cnm_p005_q2","topicId":"cnm_p005"},{"difficulty":"standard","type":"numeric","prompt":"盒子里一个也没有，再放进 4 个皮球。现在有几个？","answer":"4","explanation":"从 0 再放进 4 个，就是 4。","verify":"0+4","id":"cnm_p005_q3","topicId":"cnm_p005"},{"difficulty":"challenge","type":"numeric","prompt":"0 的后面一个数是几？","answer":"1","explanation":"0 再添 1 是 1，所以 0 的后面是 1。","verify":"0+1","id":"cnm_p005_q4","topicId":"cnm_p005"},{"difficulty":"basic","type":"numeric","prompt":"有 2 朵花，又放进来 1 朵。一共有多少朵？","answer":"3","explanation":"2＋1＝3（朵）。","verify":"2+1","id":"cnm_p006_q1","topicId":"cnm_p006"},{"difficulty":"basic","type":"numeric","prompt":"左边 1 个苹果，右边 3 个苹果。一共有几个？","answer":"4","explanation":"1＋3＝4（个）。","verify":"1+3","id":"cnm_p006_q2","topicId":"cnm_p006"},{"difficulty":"standard","type":"numeric","prompt":"树上有 2 只鸟，又飞来 2 只。现在有几只？","answer":"4","explanation":"2＋2＝4（只）。","verify":"2+2","id":"cnm_p006_q3","topicId":"cnm_p006"},{"difficulty":"challenge","type":"numeric","prompt":"小明有 2 个苹果，小红有 1 个苹果，桌上还有 3 支铅笔。苹果一共有几个？","answer":"3","explanation":"只把苹果合起来：2＋1＝3。铅笔不是苹果，不能加进去。","verify":"2+1","id":"cnm_p006_q4","topicId":"cnm_p006"},{"difficulty":"basic","type":"numeric","prompt":"有 5 个气球，拿走 2 个。还剩几个？","answer":"3","explanation":"5－2＝3（个）。","verify":"5-2","id":"cnm_p007_q1","topicId":"cnm_p007"},{"difficulty":"basic","type":"numeric","prompt":"4 支笔，送出 1 支。还剩几支？","answer":"3","explanation":"4－1＝3（支）。","verify":"4-1","id":"cnm_p007_q2","topicId":"cnm_p007"},{"difficulty":"standard","type":"numeric","prompt":"有 5 颗糖，吃掉 3 颗。还剩几颗？","answer":"2","explanation":"5－3＝2（颗）。","verify":"5-3","id":"cnm_p007_q3","topicId":"cnm_p007"},{"difficulty":"challenge","type":"numeric","prompt":"盘子里有 4 个桃和 2 个梨。吃掉 1 个桃，桃还剩几个？","answer":"3","explanation":"只看桃：4－1＝3。梨不参加这次减法。","verify":"4-1","id":"cnm_p007_q4","topicId":"cnm_p007"}]
