[{"id":"cnm_024_q1","topicId":"cnm_024","difficulty":"basic","type":"numeric","prompt":"把二进制数 101 化为十进制数。","answer":"5","explanation":"101（二进制）=1×2²+0×2+1=4+0+1=5。","verify":"1*2**2+0*2+1"},{"id":"cnm_024_q2","topicId":"cnm_024","difficulty":"basic","type":"numeric","prompt":"二进制的计数规则是“逢几进一”？（只填数字）","answer":"2","explanation":"二进制只用 0 和 1 两个数码，每满 2 就向前一位进 1，即逢二进一。","verify":"len([0,1])"},{"id":"cnm_024_q3","topicId":"cnm_024","difficulty":"standard","type":"numeric","prompt":"把二进制数 1101 化为十进制数。","answer":"13","explanation":"1101（二进制）=1×2³+1×2²+0×2+1=8+4+0+1=13。","verify":"1*2**3+1*2**2+0*2+1"},{"id":"cnm_024_q4","topicId":"cnm_024","difficulty":"standard","type":"choice","prompt":"把十进制数 10 化为二进制数，结果是哪一个？","choices":[{"key":"A","text":"1010"},{"key":"B","text":"1100"},{"key":"C","text":"1001"},{"key":"D","text":"101"}],"answer":"A","explanation":"10=8+2=1×2³+0×2²+1×2+0，所以二进制是 1010。"},{"id":"cnm_024_q5","topicId":"cnm_024","difficulty":"advanced","type":"numeric","prompt":"把二进制数 1011 与 110 相加，其和化为十进制数是多少？","answer":"17","explanation":"1011（二进制）=11，110（二进制）=6，和为 17。","verify":"(1*8+0*4+1*2+1)+(1*4+1*2+0)"}]
