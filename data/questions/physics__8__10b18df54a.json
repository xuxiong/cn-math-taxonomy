[{"id":"cnp_006_q1","topicId":"cnp_006","difficulty":"basic","type":"choice","prompt":"“闻其声而知其人”，主要是根据声音的哪个特性？","choices":[{"key":"A","text":"音色"},{"key":"B","text":"音调"},{"key":"C","text":"响度"},{"key":"D","text":"频率"}],"answer":"A","explanation":"不同人的声带结构不同，发出声音的音色不同。","verify":"\"音色\""},{"id":"cnp_006_q2","topicId":"cnp_006","difficulty":"basic","type":"choice","prompt":"“引吭高歌”中的“高”指的是声音的哪个特性？","choices":[{"key":"A","text":"音调高"},{"key":"B","text":"音色好"},{"key":"C","text":"频率高"},{"key":"D","text":"响度大"}],"answer":"D","explanation":"引吭高歌是放开嗓子大声唱，指响度大；“女高音”的高才是音调高。","verify":"\"响度大\""},{"id":"cnp_006_q3","topicId":"cnp_006","difficulty":"standard","type":"choice","prompt":"用相同的力拨动钢尺，伸出桌面的部分越短，声音有什么变化？","choices":[{"key":"A","text":"音调越高"},{"key":"B","text":"响度越大"},{"key":"C","text":"音调越低"},{"key":"D","text":"音色改变"}],"answer":"A","explanation":"伸出部分越短，振动越快，频率越高，音调越高。","verify":"\"音调越高\""},{"id":"cnp_006_q4","topicId":"cnp_006","difficulty":"standard","type":"choice","prompt":"人耳能听到的声音频率范围大约是多少？","choices":[{"key":"A","text":"20 Hz～20000 Hz"},{"key":"B","text":"0～20 Hz"},{"key":"C","text":"20000 Hz 以上"},{"key":"D","text":"20 Hz～2000 Hz"}],"answer":"A","explanation":"人耳听觉范围约 20～20000 Hz；低于 20 Hz 是次声，高于 20000 Hz 是超声。","verify":"\"20 Hz～20000 Hz\""}]
