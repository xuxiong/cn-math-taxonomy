[{"id":"cnm_016_q1","topicId":"cnm_016","difficulty":"basic","type":"numeric","prompt":"求 -2/5 的倒数。","answer":"-5/2","explanation":"乘积为 1 的两个数互为倒数，(-2/5)×(-5/2)=1，所以倒数是 -5/2（倒数与原数符号相同）。","verify":"1/Fraction(-2,5)"},{"id":"cnm_016_q2","topicId":"cnm_016","difficulty":"basic","type":"numeric","prompt":"求 -4 的倒数。","answer":"-1/4","explanation":"(-4)×(-1/4)=1，所以 -4 的倒数是 -1/4。","verify":"1/Fraction(-4)"},{"id":"cnm_016_q3","topicId":"cnm_016","difficulty":"standard","type":"choice","prompt":"下列说法正确的是哪一个？","choices":[{"key":"A","text":"0 的倒数是 0"},{"key":"B","text":"倒数等于它本身的数是 1 和 -1"},{"key":"C","text":"倒数等于它本身的数只有 1"},{"key":"D","text":"一个数的倒数一定比它小"}],"answer":"B","explanation":"1×1=1，(-1)×(-1)=1，所以倒数等于本身的数是 1 和 -1；0 没有倒数；1/2 的倒数 2 比它大。"},{"id":"cnm_016_q4","topicId":"cnm_016","difficulty":"standard","type":"numeric","prompt":"求 -1又1/2（即负的一又二分之一）的倒数，结果写成分数。","answer":"-2/3","explanation":"-1又1/2=-3/2，倒数是 -2/3。","verify":"1/Fraction(-3,2)"},{"id":"cnm_016_q5","topicId":"cnm_016","difficulty":"standard","type":"numeric","prompt":"已知 a、b 互为倒数，c、d 互为相反数，求 4ab-3(c+d) 的值。","answer":"4","explanation":"互为倒数 ab=1，互为相反数 c+d=0，所以原式=4×1-3×0=4。","verify":"4*1-3*0"},{"id":"cnm_017_q1","topicId":"cnm_017","difficulty":"standard","type":"numeric","prompt":"计算 (-12)÷(-3/4)。","answer":"16","explanation":"除以一个数等于乘它的倒数：(-12)×(-4/3)=16。","verify":"Fraction(-12)/Fraction(-3,4)"},{"id":"cnm_017_q2","topicId":"cnm_017","difficulty":"basic","type":"numeric","prompt":"计算 (-18)÷6。","answer":"-3","explanation":"异号两数相除得负，绝对值相除：18÷6=3，所以结果是 -3。","verify":"Fraction(-18)/6"},{"id":"cnm_017_q3","topicId":"cnm_017","difficulty":"standard","type":"numeric","prompt":"计算 (-3/8)÷(9/4)，结果写成最简分数。","answer":"-1/6","explanation":"(-3/8)×(4/9)=-12/72=-1/6。","verify":"Fraction(-3,8)/Fraction(9,4)"},{"id":"cnm_017_q4","topicId":"cnm_017","difficulty":"standard","type":"choice","prompt":"下列计算正确的是哪一个？","choices":[{"key":"A","text":"(-8)÷(-2)=-4"},{"key":"B","text":"6÷(-1/3)=-2"},{"key":"C","text":"0÷(-5)=0"},{"key":"D","text":"(-1)÷0=0"}],"answer":"C","explanation":"0 除以任何不为 0 的数都得 0。(-8)÷(-2)=4；6÷(-1/3)=6×(-3)=-18；除数不能为 0。"},{"id":"cnm_017_q5","topicId":"cnm_017","difficulty":"standard","type":"numeric","prompt":"一个数乘 -3/5 得 9，这个数是多少？","answer":"-15","explanation":"这个数=9÷(-3/5)=9×(-5/3)=-15。","verify":"Fraction(9)/Fraction(-3,5)"},{"id":"cnm_018_q1","topicId":"cnm_018","difficulty":"standard","type":"numeric","prompt":"计算 -6÷(-2)×3+(-4)。","answer":"5","explanation":"先乘除后加减，乘除按从左到右：(-6)÷(-2)=3，3×3=9，9+(-4)=5。","verify":"Fraction(-6)/Fraction(-2)*3+(-4)"},{"id":"cnm_018_q2","topicId":"cnm_018","difficulty":"basic","type":"numeric","prompt":"计算 8-12÷(-3)。","answer":"12","explanation":"先算除法：12÷(-3)=-4，再算 8-(-4)=12。","verify":"8-Fraction(12)/Fraction(-3)"},{"id":"cnm_018_q3","topicId":"cnm_018","difficulty":"basic","type":"choice","prompt":"计算 2+3×(-4) 的结果是哪一个？","choices":[{"key":"A","text":"-20"},{"key":"B","text":"14"},{"key":"C","text":"20"},{"key":"D","text":"-10"}],"answer":"D","explanation":"先算乘法 3×(-4)=-12，再算 2+(-12)=-10。若先算加法会得到 -20。","verify":"2+3*(-4)"},{"id":"cnm_018_q4","topicId":"cnm_018","difficulty":"standard","type":"numeric","prompt":"计算 (-2)×(3-5)÷(1/2)-1。","answer":"7","explanation":"先算括号 3-5=-2；(-2)×(-2)=4；4÷(1/2)=8；8-1=7。","verify":"-2*(3-5)/Fraction(1,2)-1"},{"id":"cnm_018_q5","topicId":"cnm_018","difficulty":"advanced","type":"numeric","prompt":"计算 (-1/2+2/3)÷(-1/6)×(-5)。","answer":"5","explanation":"括号内 -1/2+2/3=1/6；1/6÷(-1/6)=-1；-1×(-5)=5。","verify":"(Fraction(-1,2)+Fraction(2,3))/Fraction(-1,6)*(-5)"}]
