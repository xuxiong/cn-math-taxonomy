[{"id":"cnp_087_q1","topicId":"cnp_087","difficulty":"basic","type":"choice","prompt":"电磁波在真空中的传播速度是多少？","choices":[{"key":"A","text":"340 m/s"},{"key":"B","text":"3×10⁵ m/s"},{"key":"C","text":"3×10⁸ m/s"},{"key":"D","text":"不能在真空中传播"}],"answer":"C","explanation":"电磁波在真空中的传播速度与光速相同，约 3×10⁸ m/s。","verify":"\"3×10⁸ m/s\""},{"id":"cnp_087_q2","topicId":"cnp_087","difficulty":"standard","type":"numeric","prompt":"某电台发射的电磁波频率为 1×10⁸ Hz，它的波长是多少 m？（只填数值）","answer":"3","explanation":"λ = c/f = 3×10⁸ ÷ 1×10⁸ = 3 m。","verify":"3e8/1e8"},{"id":"cnp_087_q3","topicId":"cnp_087","difficulty":"basic","type":"choice","prompt":"电磁波与声波相比，下列说法正确的是哪一个？","choices":[{"key":"A","text":"声波能在真空中传播，电磁波不能"},{"key":"B","text":"电磁波能在真空中传播，声波不能"},{"key":"C","text":"二者都不能在真空中传播"},{"key":"D","text":"二者传播速度相同"}],"answer":"B","explanation":"声音的传播需要介质，电磁波不需要介质。","verify":"\"电磁波能在真空中传播，声波不能\""},{"id":"cnp_087_q4","topicId":"cnp_087","difficulty":"standard","type":"choice","prompt":"电磁波的频率越高，它的波长怎样？","choices":[{"key":"A","text":"越长"},{"key":"B","text":"不变"},{"key":"C","text":"与频率无关"},{"key":"D","text":"越短"}],"answer":"D","explanation":"波速一定，由 c = λf，频率越高波长越短。","verify":"\"越短\""}]
