[{"id":"cnh_j066_q1","topicId":"cnh_j066","difficulty":"basic","type":"choice","prompt":"1949年9月中国人民政治协商会议通过的文件是？","choices":[{"key":"A","text":"《中华人民共和国宪法》"},{"key":"B","text":"《中华人民共和国土地改革法》"},{"key":"C","text":"《论十大关系》"},{"key":"D","text":"《中国人民政治协商会议共同纲领》"}],"answer":"D","explanation":"《共同纲领》起临时宪法的作用。","verify":"\"《中国人民政治协商会议共同纲领》\""},{"id":"cnh_j066_q2","topicId":"cnh_j066","difficulty":"basic","type":"choice","prompt":"开国大典举行于？","choices":[{"key":"A","text":"1949年10月1日"},{"key":"B","text":"1949年9月21日"},{"key":"C","text":"1951年5月23日"},{"key":"D","text":"1949年4月23日"}],"answer":"A","explanation":"毛泽东在天安门宣告中华人民共和国中央人民政府成立。","verify":"\"1949年10月1日\""},{"id":"cnh_j066_q3","topicId":"cnh_j066","difficulty":"standard","type":"choice","prompt":"中华人民共和国的首都定在？","choices":[{"key":"A","text":"南京"},{"key":"B","text":"北京"},{"key":"C","text":"延安"},{"key":"D","text":"上海"}],"answer":"B","explanation":"政协会议决定定都北京。","verify":"\"北京\""},{"id":"cnh_j066_q4","topicId":"cnh_j066","difficulty":"challenge","type":"choice","prompt":"1951年西藏实现和平解放，依据的是？","choices":[{"key":"A","text":"《共同纲领》代替了这份协议"},{"key":"B","text":"《南京条约》"},{"key":"C","text":"《中央人民政府和西藏地方政府关于和平解放西藏办法的协议》"},{"key":"D","text":"《双十协定》"}],"answer":"C","explanation":"1951年西藏地方政府代表与中央人民政府签订协议，西藏和平解放。","verify":"\"《中央人民政府和西藏地方政府关于和平解放西藏办法的协议》\""},{"id":"cnh_j067_q1","topicId":"cnh_j067","difficulty":"basic","type":"choice","prompt":"1950年10月中国人民志愿军赴朝作战，司令员是？","choices":[{"key":"A","text":"彭德怀"},{"key":"B","text":"林彪"},{"key":"C","text":"刘伯承"},{"key":"D","text":"粟裕"}],"answer":"A","explanation":"彭德怀担任中国人民志愿军司令员。","verify":"\"彭德怀\""},{"id":"cnh_j067_q2","topicId":"cnh_j067","difficulty":"basic","type":"choice","prompt":"抗美援朝战争结束于？","choices":[{"key":"A","text":"1950年10月"},{"key":"B","text":"1953年7月"},{"key":"C","text":"1951年"},{"key":"D","text":"1949年"}],"answer":"B","explanation":"1953年7月美国在停战协定上签字。","verify":"\"1953年7月\""},{"id":"cnh_j067_q3","topicId":"cnh_j067","difficulty":"standard","type":"choice","prompt":"1950年颁布的土地法律是？","choices":[{"key":"A","text":"《中国土地法大纲》是1947年的文件"},{"key":"B","text":"《共同纲领》"},{"key":"C","text":"《中华人民共和国土地改革法》"},{"key":"D","text":"《五四宪法》"}],"answer":"C","explanation":"土地改革废除封建土地所有制。","verify":"\"《中华人民共和国土地改革法》\""},{"id":"cnh_j067_q4","topicId":"cnh_j067","difficulty":"challenge","type":"choice","prompt":"土地改革基本完成是在？","choices":[{"key":"A","text":"1949年10月"},{"key":"B","text":"1956年底"},{"key":"C","text":"1978年"},{"key":"D","text":"1952年底"}],"answer":"D","explanation":"到1952年底，除部分少数民族地区外，土地改革基本完成。","verify":"\"1952年底\""},{"id":"cnh_j068_q1","topicId":"cnh_j068","difficulty":"basic","type":"choice","prompt":"第一个五年计划的时间是？","choices":[{"key":"A","text":"1949年到1952年"},{"key":"B","text":"1953年到1957年"},{"key":"C","text":"1958年到1962年"},{"key":"D","text":"1978年到1982年"}],"answer":"B","explanation":"一五计划集中力量发展重工业。","verify":"\"1953年到1957年\""},{"id":"cnh_j068_q2","topicId":"cnh_j068","difficulty":"basic","type":"choice","prompt":"长春第一汽车制造厂是哪个计划的成就？","choices":[{"key":"A","text":"土地改革"},{"key":"B","text":"大跃进"},{"key":"C","text":"第一个五年计划"},{"key":"D","text":"改革开放"}],"answer":"C","explanation":"1956年长春一汽生产出第一辆解放牌汽车。","verify":"\"第一个五年计划\""},{"id":"cnh_j068_q3","topicId":"cnh_j068","difficulty":"standard","type":"choice","prompt":"三大改造基本完成、社会主义制度基本建立是在？","choices":[{"key":"A","text":"1949年"},{"key":"B","text":"1954年"},{"key":"C","text":"1978年"},{"key":"D","text":"1956年底"}],"answer":"D","explanation":"农业、手工业和资本主义工商业的社会主义改造基本完成。","verify":"\"1956年底\""},{"id":"cnh_j068_q4","topicId":"cnh_j068","difficulty":"challenge","type":"choice","prompt":"1954年颁布的《中华人民共和国宪法》是？","choices":[{"key":"A","text":"第一部社会主义类型的宪法"},{"key":"B","text":"临时宪法《共同纲领》"},{"key":"C","text":"土地改革法"},{"key":"D","text":"1982年宪法"}],"answer":"A","explanation":"1954年宪法规定国家的性质和根本政治制度。","verify":"\"第一部社会主义类型的宪法\""},{"id":"cnh_j069_q1","topicId":"cnh_j069","difficulty":"basic","type":"choice","prompt":"1953年底周恩来首次提出和平共处五项原则，是在接见哪国代表团时？","choices":[{"key":"A","text":"缅甸是随后共同倡导的国家之一"},{"key":"B","text":"印度尼西亚"},{"key"