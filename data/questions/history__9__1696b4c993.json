[{"id":"cnh_j116_q1","topicId":"cnh_j116","difficulty":"basic","type":"choice","prompt":"第二次工业革命开始于？","choices":[{"key":"A","text":"18世纪六十年代"},{"key":"B","text":"19世纪六七十年代"},{"key":"C","text":"20世纪四十年代"},{"key":"D","text":"17世纪"}],"answer":"B","explanation":"它在几个先进资本主义国家同时发生。","verify":"\"19世纪六七十年代\""},{"id":"cnh_j116_q2","topicId":"cnh_j116","difficulty":"basic","type":"choice","prompt":"第二次工业革命的主要标志是？","choices":[{"key":"A","text":"蒸汽机的改良"},{"key":"B","text":"珍妮机"},{"key":"C","text":"电力的广泛应用"},{"key":"D","text":"指南针用于航海"}],"answer":"C","explanation":"人类社会进入电气时代。","verify":"\"电力的广泛应用\""},{"id":"cnh_j116_q3","topicId":"cnh_j116","difficulty":"standard","type":"choice","prompt":"19世纪八十年代制造出内燃机汽车的是？","choices":[{"key":"A","text":"莱特兄弟"},{"key":"B","text":"爱迪生"},{"key":"C","text":"瓦特"},{"key":"D","text":"卡尔·本茨"}],"answer":"D","explanation":"本茨制造出由内燃机驱动的汽车。","verify":"\"卡尔·本茨\""},{"id":"cnh_j116_q4","topicId":"cnh_j116","difficulty":"challenge","type":"choice","prompt":"1903年莱特兄弟试飞成功，标志？","choices":[{"key":"A","text":"飞机时代开始"},{"key":"B","text":"铁路时代开始"},{"key":"C","text":"蒸汽时代开始"},{"key":"D","text":"人类进入太空"}],"answer":"A","explanation":"飞机后来成为交通和军事工具。","verify":"\"飞机时代开始\""},{"id":"cnh_j117_q1","topicId":"cnh_j117","difficulty":"basic","type":"choice","prompt":"第二次工业革命后，主要资本主义国家出现了？","choices":[{"key":"A","text":"手工行会重新统治"},{"key":"B","text":"庄园制"},{"key":"C","text":"垄断组织"},{"key":"D","text":"种姓制度"}],"answer":"C","explanation":"生产和资本高度集中，形成垄断。","verify":"\"垄断组织\""},{"id":"cnh_j117_q2","topicId":"cnh_j117","difficulty":"basic","type":"choice","prompt":"工业化推动人口向城市集中，这一现象称为？","choices":[{"key":"A","text":"殖民化"},{"key":"B","text":"农奴化"},{"key":"C","text":"封建化"},{"key":"D","text":"城市化"}],"answer":"D","explanation":"城市规模扩大，城市人口比例上升。","verify":"\"城市化\""},{"id":"cnh_j117_q3","topicId":"cnh_j117","difficulty":"standard","type":"choice","prompt":"工业化国家工人队伍的变化是？","choices":[{"key":"A","text":"人数增加，并出现工运"},{"key":"B","text":"完全消失"},{"key":"C","text":"都成为农场主"},{"key":"D","text":"不再有罢工"}],"answer":"A","explanation":"社会矛盾依然存在，工人争取政治权利。","verify":"\"人数增加，并出现工运\""},{"id":"cnh_j117_q4","topicId":"cnh_j117","difficulty":"challenge","type":"choice","prompt":"工业化带来的环境问题包括？","choices":[{"key":"A","text":"空气和河水自动变干净"},{"key":"B","text":"污染加重"},{"key":"C","text":"森林面积必然增加"},{"key":"D","text":"城市消失"}],"answer":"B","explanation":"工厂排放烟尘和污水，环境问题开始突出。","verify":"\"污染加重\""},{"id":"cnh_j118_q1","topicId":"cnh_j118","difficulty":"basic","type":"choice","prompt":"1859年出版《物种起源》的是？","choices":[{"key":"A","text":"爱因斯坦"},{"key":"B","text":"牛顿"},{"key":"C","text":"巴斯德"},{"key":"D","text":"达尔文"}],"answer":"D","explanation":"达尔文提出进化论，认为生物是进化来的。","verify":"\"达尔文\""},{"id":"cnh_j118_q2","topicId":"cnh_j118","difficulty":"basic","type":"choice","prompt":"20世纪初提出相对论的是？","choices":[{"key":"A","text":"爱因斯坦"},{"key":"B","text":"达尔文"},{"key":"C","text":"牛顿"},{"key":"D","text":"居里夫人"}],"answer":"A","explanation":"相对论推动了物理学的发展。","verify":"\"爱因斯坦\""},{"id":"cnh_j118_q3","topicId":"cnh_j118","difficulty":"standard","type":"choice","prompt":"牛顿的主要贡献是？","choices":[{"key":"A","text":"生物进化论"},{"key":"B","text":"力学体系"},{"key":"C","text":"相对论"},{"key":"D","text":"元素周期表"}],"answer":"B","explanation":"牛顿奠定了经典力学的基础，是近代科学的重要代表。","verify":"\"力学体系\""},{"id":"cnh_j118_q4","topicId":"cnh_j118","difficulty":"challenge","type":"choice","prompt":"批判现实主义文学的代表作家巴尔扎克，其作品集是？","choices":[{"key":"A","text":"《战争与和平》"},{"key":"B","text":"《物种起源》"},{"key":"C","text":"《人间喜剧》"},{"key":"D","text":"《哈姆雷特》"}],"answer":"C","explanation":"《人间喜剧》再现了法国社会的图景。","verify":"\"《人间喜剧》\""}]
