[{"id":"cne_p151_q1","topicId":"cne_p151","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「安静地」？","choices":[{"key":"A","text":"quietly"},{"key":"B","text":"talk"},{"key":"C","text":"keep"},{"key":"D","text":"desk"}],"answer":"A","explanation":"quietly 的意思是安静地。","verify":"\"quietly\""},{"id":"cne_p151_q2","topicId":"cne_p151","difficulty":"basic","type":"choice","prompt":"「talk」的中文意思是哪一个？","choices":[{"key":"A","text":"安静地"},{"key":"B","text":"说话"},{"key":"C","text":"保持"},{"key":"D","text":"书桌"}],"answer":"B","explanation":"talk 的意思是说话。","verify":"\"说话\""},{"id":"cne_p151_q3","topicId":"cne_p151","difficulty":"standard","type":"choice","prompt":"选择表示「保持」的单词。","choices":[{"key":"A","text":"quietly"},{"key":"B","text":"talk"},{"key":"C","text":"keep"},{"key":"D","text":"desk"}],"answer":"C","explanation":"表示保持的单词是 keep。","verify":"\"keep\""},{"id":"cne_p151_q4","topicId":"cne_p151","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「书桌」？","choices":[{"key":"A","text":"quietly"},{"key":"B","text":"talk"},{"key":"C","text":"keep"},{"key":"D","text":"desk"}],"answer":"D","explanation":"desk 的意思是书桌。","verify":"\"desk\""},{"id":"cne_p152_q1","topicId":"cne_p152","difficulty":"basic","type":"choice","prompt":"哪一句是祈使句？","choices":[{"key":"A","text":"You talk quietly?"},{"key":"B","text":"Talk quietly."},{"key":"C","text":"She talks quietly."},{"key":"D","text":"Talking quietly is."}],"answer":"B","explanation":"祈使句用动词原形开头。","verify":"\"Talk quietly.\""},{"id":"cne_p152_q2","topicId":"cne_p152","difficulty":"basic","type":"choice","prompt":"Keep to the right. 这句是在说什么？","choices":[{"key":"A","text":"靠左走"},{"key":"B","text":"保持安静"},{"key":"C","text":"靠右走"},{"key":"D","text":"把桌子擦干净"}],"answer":"C","explanation":"Keep to the right 是靠右。","verify":"\"靠右走\""},{"id":"cne_p152_q3","topicId":"cne_p152","difficulty":"standard","type":"choice","prompt":"Do not talk. 这句的意思是？","choices":[{"key":"A","text":"请说话"},{"key":"B","text":"正在说话"},{"key":"C","text":"喜欢说话"},{"key":"D","text":"不要说话"}],"answer":"D","explanation":"Do not talk 是不要说话。","verify":"\"不要说话\""},{"id":"cne_p152_q4","topicId":"cne_p152","difficulty":"standard","type":"choice","prompt":"哪一句表示「请安静」？","choices":[{"key":"A","text":"Be quiet."},{"key":"B","text":"Is quiet."},{"key":"C","text":"Are quiet."},{"key":"D","text":"Quiet is be."}],"answer":"A","explanation":"祈使句说 Be quiet。","verify":"\"Be quiet.\""},{"id":"cne_p153_q1","topicId":"cne_p153","difficulty":"basic","type":"choice","prompt":"图书馆里要小声说话，应说哪一句？","choices":[{"key":"A","text":"Talk loudly."},{"key":"B","text":"Keep to the left."},{"key":"C","text":"Talk quietly."},{"key":"D","text":"Do not read."}],"answer":"C","explanation":"小声是 quietly。","verify":"\"Talk quietly.\""},{"id":"cne_p153_q2","topicId":"cne_p153","difficulty":"basic","type":"choice","prompt":"Keep your desk clean. 这句是在说什么？","choices":[{"key":"A","text":"靠右走"},{"key":"B","text":"不要说话"},{"key":"C","text":"可以跑"},{"key":"D","text":"保持书桌干净"}],"answer":"D","explanation":"desk clean。","verify":"\"保持书桌干净\""},{"id":"cne_p153_q3","topicId":"cne_p153","difficulty":"standard","type":"choice","prompt":"Do not eat in the library. 图书馆里不可以做什么？","choices":[{"key":"A","text":"吃东西"},{"key":"B","text":"看书"},{"key":"C","text":"安静地说话"},{"key":"D","text":"靠右走"}],"answer":"A","explanation":"Do not eat。","verify":"\"吃东西\""},{"id":"cne_p153_q4","topicId":"cne_p153","difficulty":"standard","type":"choice","prompt":"Work quietly. 这句是在要求什么？","choices":[{"key":"A","text":"大声说话"},{"key":"B","text":"安静地做事"},{"key":"C","text":"出去玩"},{"key":"D","text":"吃午饭"}],"answer":"B","explanation":"quietly 是安静地。","verify":"\"安静地做事\""},{"id":"cne_p154_q1","topicId":"cne_p154","difficulty":"basic","type":"choice","prompt":"读一读：Talk quietly. Do not eat. Keep your desk clean. 不可以做什么？","choices":[{"key":"A","text":"安静说话"},{"key":"B","text":"保持书桌干净"},{"key":"C","text":"看书"},{"key":"D","text":"吃东西"}],"answer":"D","explanation":"Do not eat。","verify":"\"吃东西\""},{"id":"cne_p154_q2","topicId":"cne_p154","difficulty":"basic","type":"choice","prompt":"读一读：Keep to the right. 哪一句和文字一致？","choices":[{"key":"A","text":"请靠右。"},{"key":"B","text":"请靠左。"},{"key":"C","text":"请吃东西。"},{"key":"D","text":"请大声说话。"}],"answer":"A","explanation":"Keep to the right。","verify":"\"请靠右。\""},{"id":"cne_p154_q3","topicId":"cne_p154","difficulty":"standard","type":"choice","prompt":"读一读：We are reading in the library. Please work quietly. 人们正在哪里？","choices":[{"key":"A","text":"操场"},{"key":"B","text":"图书馆"},{"key":"C","text":"食堂"},{"key":"D","text":"公园"}],"answer":"B","explanation":"in the library。","verify":"\"图书馆\""},{"id":"cne_p154_q4","topicId":"cne_p154","difficulty":"standard","type":"choice","prompt":"读一读：Do not run in the classroom. Walk quietly. 教室里应该怎样走？","choices":[{"key":"A","text":"跑"},{"key":"B","text":"吃东西"},{"key":"C","text":"安静地走"},{"key":"D","text":"大声说话"}],"answer":"C","explanation":"Walk quietly，并且 Do not run。","verify":"\"安静地走\""},{"id":"cne_p246_q1","topicId":"cne_p246","difficulty":"basic","type":"choice","prompt":"想说「我们必须听老师讲」，应选哪一句？","choices":[{"key":"A","text":"We must listen to the teacher."},{"key":"B","text":"We must listening to the teacher."},{"key":"C","text":"We mustn't listen to the teacher."},{"key":"D","text":"We must listens to the teacher."}],"answer":"A","explanation":"must + 动词原形。","verify":"\"We must listen to the teacher.\""},{"id":"cne_p246_q2","topicId":"cne_p246","difficulty":"basic","type":"choice","prompt":"We mustn't run in the hall. 这句班规是？","choices":[{"key":"A","text":"走廊里必须跑"},{"key":"B","text":"教室里必须跑"},{"key":"C","text":"可以在走廊大喊"},{"key":"D","text":"走廊里不能跑"}],"answer":"D","explanation":"mustn't 表示禁止。","verify":"\"走廊里不能跑\""},{"id":"cne_p246_q3","topicId":"cne_p246","difficulty":"standard","type":"choice","prompt":"哪一句表示「必须」？","choices":[{"key":"A","text":"You can never listen."},{"key":"B","text":"You don't must talk."},{"key":"C","text":"You must keep quiet in class."},{"key":"D","text":"You mustn't keep quiet in class."}],"answer":"C","explanation":"must 表示必须。","verify":"\"You must keep quiet in class.\""},{"id":"cne_p246_q4","topicId":"cne_p246","difficulty":"challenge","type":"choice","prompt":"读一读：We must raise our hands. We mustn't shout. 哪一句和班规一致？","choices":[{"key":"A","text":"可以在走廊跑。"},{"key":"B","text":"要举手，不能大喊。"},{"key":"C","text":"要大喊，不能举手。"},{"key":"D","text":"不必举手。"}],"answer":"B","explanation":"must raise … mustn't shout。","verify":"\"要举手，不能大喊。\""},{"id":"cne_p247_q1","topicId":"cne_p247","difficulty":"basic","type":"choice","prompt":"海报上写 Keep the classroom clean. 这是在要求？","choices":[{"key":"A","text":"保持教室干净"},{"key":"B","text":"在走廊跑"},{"key":"C","text":"大声说话"},{"key":"D","text":"乱扔垃圾"}],"answer":"A","explanation":"keep … clean。","verify":"\"保持教室干净\""},{"id":"cne_p247_q2","topicId":"cne_p247","difficulty":"basic","type":"choice","prompt":"哪一句适合写进班规海报？","choices":[{"key":"A","text":"I like apples."},{"key":"B","text":"It is sunny today."},{"key":"C","text":"My name is Tom."},{"key":"D","text":"Listen to the teacher."}],"answer":"D","explanation":"班规用祈使句。","verify":"\"Listen to the teacher.\""},{"id":"cne_p247_q3","topicId":"cne_p247","difficulty":"standard","type":"choice","prompt":"读一读海报：1. Listen carefully. 2. Don't push. 不可以做什么？","choices":[{"key":"A","text":"举手"},{"key":"B","text":"保持安静"},{"key":"C","text":"推搡"},{"key":"D","text":"认真听"}],"answer":"C","explanation":"Don't push。","verify":"\"推搡\""},{"id":"cne_p247_q4","topicId":"cne_p247","difficulty":"challenge","type":"choice","prompt":"读一读：Our class rules: We must help each other. We mustn't litter. 哪一句可加进海报？","choices":[{"key":"A","text":"Never listen."},{"key":"B","text":"Keep the floor clean."},{"key":"C","text":"Run in the hall every day."},{"key":"D","text":"Shout in class."}],"answer":"B","explanation":"保持干净与不乱扔一致。","verify":"\"Keep the floor clean.\""}]
