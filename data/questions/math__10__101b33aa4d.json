[{"id":"cnm_h039_q1","topicId":"cnm_h039","difficulty":"basic","type":"numeric","prompt":"计算 2 的 −3 次方。","answer":"1/8","explanation":"负指数表示倒数，2⁻³=1/8。","verify":"Fraction(1, 2**3)"},{"id":"cnm_h039_q2","topicId":"cnm_h039","difficulty":"basic","type":"numeric","prompt":"计算 8 的 2/3 次方。结果是整数。","answer":"4","explanation":"8=2³，(2³)^(2/3)=2²=4。","verify":"4"},{"id":"cnm_h039_q3","topicId":"cnm_h039","difficulty":"standard","type":"numeric","prompt":"计算 16 的 1/2 次方。","answer":"4","explanation":"16 的算术平方根是 4。","verify":"isqrt(16)"},{"id":"cnm_h039_q4","topicId":"cnm_h039","difficulty":"standard","type":"choice","prompt":"a^(1/2) 在 a≥0 时等于？","choices":[{"key":"A","text":"a²"},{"key":"B","text":"1/a"},{"key":"C","text":"2a"},{"key":"D","text":"√a"}],"answer":"D","explanation":"分数指数 1/2 就是算术平方根。","verify":"\"√a\""},{"id":"cnm_h040_q1","topicId":"cnm_h040","difficulty":"basic","type":"numeric","prompt":"计算 2³×2⁴。","answer":"128","explanation":"指数相加，2⁷=128。","verify":"2**3*2**4"},{"id":"cnm_h040_q2","topicId":"cnm_h040","difficulty":"basic","type":"numeric","prompt":"计算 3⁵÷3²。","answer":"27","explanation":"指数相减，3³=27。","verify":"3**(5-2)"},{"id":"cnm_h040_q3","topicId":"cnm_h040","difficulty":"standard","type":"numeric","prompt":"计算 (2³)²。","answer":"64","explanation":"幂的乘方，指数相乘，2⁶=64。","verify":"(2**3)**2"},{"id":"cnm_h040_q4","topicId":"cnm_h040","difficulty":"standard","type":"choice","prompt":"同底数幂相乘，指数应该？","choices":[{"key":"A","text":"相加"},{"key":"B","text":"相乘"},{"key":"C","text":"相减后再取倒数"},{"key":"D","text":"不变"}],"answer":"A","explanation":"a^m·a^n=a^(m+n)。指数相乘是幂的乘方。","verify":"\"相加\""}]
