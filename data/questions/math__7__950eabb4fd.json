[{"id":"cnm_019_q1","topicId":"cnm_019","difficulty":"standard","type":"numeric","prompt":"写出 (-3)³ 与 -3³ 的含义并计算。（只需依次写出两个式子的值，用逗号隔开）","answer":"-27，-27","explanation":"(-3)³ 表示 3 个 (-3) 相乘，=(-3)×(-3)×(-3)=-27；-3³ 表示 3³ 的相反数，=-(3×3×3)=-27。","verify":"[(-3)**3, -(3**3)]"},{"id":"cnm_019_q2","topicId":"cnm_019","difficulty":"basic","type":"choice","prompt":"在幂 (-5)³ 中，底数是哪一个？","choices":[{"key":"A","text":"-5"},{"key":"B","text":"5"},{"key":"C","text":"-3"},{"key":"D","text":"3"}],"answer":"A","explanation":"括号内的 -5 是相同因数，即底数；3 是指数。"},{"id":"cnm_019_q3","topicId":"cnm_019","difficulty":"standard","type":"choice","prompt":"下列各组中，两个式子的值相等的是哪一组？","choices":[{"key":"A","text":"(-2)² 与 -2²"},{"key":"B","text":"(-2)³ 与 -2³"},{"key":"C","text":"(-3)² 与 -3²"},{"key":"D","text":"2³ 与 3²"}],"answer":"B","explanation":"(-2)³=-8，-2³=-8，相等。(-2)²=4 而 -2²=-4；(-3)²=9 而 -3²=-9；2³=8 而 3²=9。"},{"id":"cnm_019_q4","topicId":"cnm_019","difficulty":"basic","type":"numeric","prompt":"把 (-3)×(-3)×(-3)×(-3) 写成幂 a^n 的形式，指数 n 是多少？","answer":"4","explanation":"4 个 (-3) 相乘，写成 (-3)^4，指数是 4。","verify":"len([-3,-3,-3,-3])"},{"id":"cnm_019_q5","topicId":"cnm_019","difficulty":"standard","type":"numeric","prompt":"计算 -2²-(-2)² 的值。","answer":"-8","explanation":"-2²=-(2×2)=-4；(-2)²=4；所以 -4-4=-8。","verify":"-(2**2)-((-2)**2)"},{"id":"cnm_020_q1","topicId":"cnm_020","difficulty":"basic","type":"numeric","prompt":"计算 (-2)⁴ 和 (-1/2)³。（依次作答，用逗号隔开）","answer":"16，-1/8","explanation":"负数的偶次幂为正：(-2)⁴=16；负数的奇次幂为负：(-1/2)³=-1/8。","verify":"[(-2)**4, Fraction(-1,2)**3]"},{"id":"cnm_020_q2","topicId":"cnm_020","difficulty":"basic","type":"choice","prompt":"下列各数中，结果为负数的是哪一个？","choices":[{"key":"A","text":"(-3)²"},{"key":"B","text":"(-1)⁴"},{"key":"C","text":"(-2)³"},{"key":"D","text":"0⁵"}],"answer":"C","explanation":"负数的奇次幂是负数：(-2)³=-8；(-3)²=9，(-1)⁴=1，0⁵=0。"},{"id":"cnm_020_q3","topicId":"cnm_020","difficulty":"basic","type":"numeric","prompt":"计算 (-10)³。","answer":"-1000","explanation":"(-10)³=(-10)×(-10)×(-10)=-1000（负数的奇次幂为负）。","verify":"(-10)**3"},{"id":"cnm_020_q4","topicId":"cnm_020","difficulty":"standard","type":"numeric","prompt":"计算 (-2/3)³，结果写成最简分数。","answer":"-8/27","explanation":"奇次幂为负：-(2/3)³=-8/27。","verify":"Fraction(-2,3)**3"},{"id":"cnm_020_q5","topicId":"cnm_020","difficulty":"advanced","type":"numeric","prompt":"若 a=-1，求 a^2025-a^2026+a^2 的值。","answer":"-1","explanation":"a^2025=-1，a^2026=1，a^2=1，所以 -1-1+1=-1。","verify":"(-1)**(2025%2)-(-1)**(2026%2)+(-1)**2"},{"id":"cnm_021_q1","topicId":"cnm_021","difficulty":"standard","type":"numeric","prompt":"计算 -2²+(-3)²÷(-3)。","answer":"-7","explanation":"先算乘方：-2²=-4，(-3)²=9；再算除法 9÷(-3)=-3；最后 -4+(-3)=-7。","verify":"-(2**2)+Fraction((-3)**2)/(-3)"},{"id":"cnm_021_q2","topicId":"cnm_021","difficulty":"basic","type":"numeric","prompt":"计算 (-3)²-2×5。","answer":"-1","explanation":"先乘方 (-3)²=9，再乘 2×5=10，最后 9-10=-1。","verify":"(-3)**2-2*5"},{"id":"cnm_021_q3","topicId":"cnm_021","difficulty":"standard","type":"choice","prompt":"计算 -2+3×(-2)² 的结果是哪一个？","choices":[{"key":"A","text":"-14"},{"key":"B","text":"4"},{"key":"C","text":"34"},{"key":"D","text":"10"}],"answer":"D","explanation":"先算乘方 (-2)²=4，再算乘法 3×4=12，最后 -2+12=10。","verify":"-2+3*(-2)**2"},{"id":"cnm_021_q4","topicId":"cnm_021","difficulty":"standard","type":"numeric","prompt":"计算 (-2)³÷4-(-3)×2。","answer":"4","explanation":"(-2)³=-8，-8÷4=-2；(-3)×2=-6，-2-(-6)=4。","verify":"Fraction((-2)**3,4)-(-3)*2"},{"id":"cnm_021_q5","topicId":"cnm_021","difficulty":"advanced","type":"numeric","prompt":"计算 -1⁴-(1-0.5)×(1/3)×[2-(-3)²]，结果写成最简分数。","answer":"1/6","explanation":"-1⁴=-1；(1-1/2)×(1/3)=1/6；[2-9]=-7；原式=-1-(1/6)×(-7)=-1+7/6=1/6。","verify":"-(1**4)-(1-Fraction(1,2))*Fraction(1,3)*(2-(-3)**2)"}]
