[{"id":"cne_p201_q1","topicId":"cne_p201","difficulty":"basic","type":"choice","prompt":"pocket money 的意思是？","choices":[{"key":"A","text":"口袋"},{"key":"B","text":"商店"},{"key":"C","text":"零花钱"},{"key":"D","text":"钱包"}],"answer":"C","explanation":"pocket money 是零花钱。","verify":"\"零花钱\""},{"id":"cne_p201_q2","topicId":"cne_p201","difficulty":"basic","type":"choice","prompt":"I want to ____ money for a new bike. 我想为买新车攒钱。","choices":[{"key":"A","text":"cost"},{"key":"B","text":"spend"},{"key":"C","text":"save"},{"key":"D","text":"sell"}],"answer":"C","explanation":"攒钱用 save。","verify":"\"save\""},{"id":"cne_p201_q3","topicId":"cne_p201","difficulty":"standard","type":"choice","prompt":"「花钱」用哪个英文动词？","choices":[{"key":"A","text":"spend"},{"key":"B","text":"send"},{"key":"C","text":"spell"},{"key":"D","text":"save"}],"answer":"A","explanation":"spend money 是花钱。","verify":"\"spend\""},{"id":"cne_p201_q4","topicId":"cne_p201","difficulty":"standard","type":"choice","prompt":"The book ____ 20 yuan. 这本书要 20 元。","choices":[{"key":"A","text":"saves"},{"key":"B","text":"spends"},{"key":"C","text":"buys"},{"key":"D","text":"costs"}],"answer":"D","explanation":"物品价格用 cost，主语单数用 costs。","verify":"\"costs\""},{"id":"cne_p202_q1","topicId":"cne_p202","difficulty":"basic","type":"choice","prompt":"three hundred and five 是多少？","choices":[{"key":"A","text":"305"},{"key":"B","text":"350"},{"key":"C","text":"35"},{"key":"D","text":"3005"}],"answer":"A","explanation":"three hundred 是 300，and five 是 5。","verify":"\"305\""},{"id":"cne_p202_q2","topicId":"cne_p202","difficulty":"basic","type":"choice","prompt":"1,200 用英语怎么读？","choices":[{"key":"A","text":"one hundred two thousand"},{"key":"B","text":"twelve thousand"},{"key":"C","text":"one thousand two hundred"},{"key":"D","text":"one thousand twenty"}],"answer":"C","explanation":"1,000 是 one thousand，200 是 two hundred。","verify":"\"one thousand two hundred\""},{"id":"cne_p202_q3","topicId":"cne_p202","difficulty":"standard","type":"choice","prompt":"哪个写法正确表示 500？","choices":[{"key":"A","text":"fifty hundred"},{"key":"B","text":"five hundreds"},{"key":"C","text":"five hundred and"},{"key":"D","text":"five hundred"}],"answer":"D","explanation":"具体数字前的 hundred 不加 s。","verify":"\"five hundred\""},{"id":"cne_p202_q4","topicId":"cne_p202","difficulty":"standard","type":"choice","prompt":"The bike is 680 yuan. 680 读作？","choices":[{"key":"A","text":"six hundred and eighty"},{"key":"B","text":"sixty-eight"},{"key":"C","text":"six thousand eighty"},{"key":"D","text":"six hundred and eighteen"}],"answer":"A","explanation":"680 = 600 + 80。","verify":"\"six hundred and eighty\""},{"id":"cne_p203_q1","topicId":"cne_p203","difficulty":"basic","type":"choice","prompt":"I get 40 yuan a week. I spend 15 yuan on books and save the rest. 每周存多少元？","choices":[{"key":"A","text":"55"},{"key":"B","text":"25"},{"key":"C","text":"40"},{"key":"D","text":"15"}],"answer":"B","explanation":"40 − 15 = 25。","verify":"\"25\""},{"id":"cne_p203_q2","topicId":"cne_p203","difficulty":"basic","type":"choice","prompt":"Amy saves 10 yuan every week. How much does she save in 4 weeks?","choices":[{"key":"A","text":"10 yuan"},{"key":"B","text":"4 yuan"},{"key":"C","text":"40 yuan"},{"key":"D","text":"14 yuan"}],"answer":"C","explanation":"10 × 4 = 40。","verify":"\"40 yuan\""},{"id":"cne_p203_q3","topicId":"cne_p203","difficulty":"standard","type":"choice","prompt":"Tom: I don't buy snacks. I put the money in my piggy bank. Tom 在做什么？","choices":[{"key":"A","text":"花钱买零食"},{"key":"B","text":"丢了钱"},{"key":"C","text":"存钱"},{"key":"D","text":"借钱"}],"answer":"C","explanation":"piggy bank 是存钱罐，他在存钱。","verify":"\"存钱\""},{"id":"cne_p203_q4","topicId":"cne_p203","difficulty":"standard","type":"choice","prompt":"哪一句是好的用钱建议？","choices":[{"key":"A","text":"Spend all your money at once."},{"key":"B","text":"Never count your money."},{"key":"C","text":"Buy everything you see."},{"key":"D","text":"Make a plan before you spend money."}],"answer":"D","explanation":"先做计划再花钱。","verify":"\"Make a plan before you spend money.\""},{"id":"cne_p239_q1","topicId":"cne_p239","difficulty":"basic","type":"choice","prompt":"想说「我想存钱买书」，应选哪一句？","choices":[{"key":"A","text":"I want to save money for books."},{"key":"B","text":"I want to spend money for save."},{"key":"C","text":"I want save money books."},{"key":"D","text":"I wants to save money."}],"answer":"A","explanation":"want to save money for …","verify":"\"I want to save money for books.\""},{"id":"cne_p239_q2","topicId":"cne_p239","difficulty":"basic","type":"choice","prompt":"I will spend 10 yuan on fruit. 我打算？","choices":[{"key":"A","text":"存 10 元"},{"key":"B","text":"卖水果"},{"key":"C","text":"借 10 元"},{"key":"D","text":"花 10 元买水果"}],"answer":"D","explanation":"spend … on … 是花钱买。","verify":"\"花 10 元买水果\""},{"id":"cne_p239_q3","topicId":"cne_p239","difficulty":"standard","type":"choice","prompt":"哪一句是存钱计划？","choices":[{"key":"A","text":"I never save."},{"key":"B","text":"I lose money on purpose."},{"key":"C","text":"I will save my pocket money."},{"key":"D","text":"I will spend all money today."}],"answer":"C","explanation":"save pocket money。","verify":"\"I will save my pocket money.\""},{"id":"cne_p239_q4","topicId":"cne_p239","difficulty":"standard","type":"choice","prompt":"She wants to ____ money for a gift.","choices":[{"key":"A","text":"price"},{"key":"B","text":"save"},{"key":"C","text":"cost"},{"key":"D","text":"cheap"}],"answer":"B","explanation":"攒钱用 save。","verify":"\"save\""}]
