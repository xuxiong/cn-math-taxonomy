[{"id":"cnm_h055_q1","topicId":"cnm_h055","difficulty":"basic","type":"choice","prompt":"按逆时针方向旋转形成的角是？","choices":[{"key":"A","text":"正角"},{"key":"B","text":"负角"},{"key":"C","text":"零角"},{"key":"D","text":"直角"}],"answer":"A","explanation":"本图谱按教材约定：逆时针为正角，顺时针为负角。","verify":"\"正角\""},{"id":"cnm_h055_q2","topicId":"cnm_h055","difficulty":"basic","type":"numeric","prompt":"30° 再逆时针旋转一周，得到的角度数是多少？","answer":"390","explanation":"一周是 360°，30+360=390。","verify":"30+360"},{"id":"cnm_h055_q3","topicId":"cnm_h055","difficulty":"standard","type":"numeric","prompt":"30° 再顺时针旋转一周，得到的角度数是多少？","answer":"-330","explanation":"顺时针为负，30−360=−330。","verify":"30-360"},{"id":"cnm_h055_q4","topicId":"cnm_h055","difficulty":"standard","type":"choice","prompt":"任意角与 0° 到 360° 内的角相比？","choices":[{"key":"A","text":"只能是锐角"},{"key":"B","text":"不能超过 180°"},{"key":"C","text":"不能是 0°"},{"key":"D","text":"还可以是负角或超过一周的角"}],"answer":"D","explanation":"任意角把旋转继续下去，不限制在一周以内。","verify":"\"还可以是负角或超过一周的角\""},{"id":"cnm_h056_q1","topicId":"cnm_h056","difficulty":"basic","type":"numeric","prompt":"与 400° 终边相同、且在 0° 到 360° 之间的角是多少度？","answer":"40","explanation":"400−360=40，两者相差一整周。","verify":"400-360"},{"id":"cnm_h056_q2","topicId":"cnm_h056","difficulty":"basic","type":"numeric","prompt":"与 60° 终边相同的角 −300°，两者相差多少度？","answer":"360","explanation":"60−(−300)=360，正好相差一周。","verify":"60-(-300)"},{"id":"cnm_h056_q3","topicId":"cnm_h056","difficulty":"standard","type":"choice","prompt":"终边相同的两个角相差？","choices":[{"key":"A","text":"180° 的整数倍"},{"key":"B","text":"90°"},{"key":"C","text":"必须相等"},{"key":"D","text":"360° 的整数倍"}],"answer":"D","explanation":"多转或少转若干整周，终边回到同一位置。","verify":"\"360° 的整数倍\""},{"id":"cnm_h056_q4","topicId":"cnm_h056","difficulty":"standard","type":"numeric","prompt":"−20° 加上多少度后，落在 0° 到 360° 内并与它终边相同？","answer":"360","explanation":"−20+360=340，加的是一周。","verify":"360"},{"id":"cnm_h057_q1","topicId":"cnm_h057","difficulty":"basic","type":"numeric","prompt":"π 弧度等于多少度？","answer":"180","explanation":"按照换算，π 弧度是 180°。","verify":"degrees(pi)"},{"id":"cnm_h057_q2","topicId":"cnm_h057","difficulty":"basic","type":"numeric","prompt":"半径等于弧长时，圆心角是多少弧度？","answer":"1","explanation":"弧度等于弧长除以半径。两者相等时，圆心角是 1 弧度。","verify":"1"},{"id":"cnm_h057_q3","topicId":"cnm_h057","difficulty":"standard","type":"choice","prompt":"弧度制用什么来度量角？","choices":[{"key":"A","text":"弧长与半径的比"},{"key":"B","text":"弧长与直径的和"},{"key":"C","text":"角度数本身"},{"key":"D","text":"扇形面积"}],"answer":"A","explanation":"θ=l/r，这个比是不名数，单位记为弧度。","verify":"\"弧长与半径的比\""},{"id":"cnm_h057_q4","topicId":"cnm_h057","difficulty":"standard","type":"numeric","prompt":"2π 弧度等于多少度？","answer":"360","explanation":"两周的一半是一周，2π 弧度等于 360°。","verify":"degrees(2*pi)"},{"id":"cnm_h058_q1","topicId":"cnm_h058","difficulty":"basic","type":"numeric","prompt":"π/6 弧度等于多少度？","answer":"30","explanation":"180°/6=30°。","verify":"degrees(pi/6)"},{"id":"cnm_h058_q2","topicId":"cnm_h058","difficulty":"basic","type":"numeric","prompt":"90° 等于多少个 π 弧度？只写 π 前面的系数。","answer":"1/2","explanation":"90/180=1/2，即 π/2 弧度。","verify":"Fraction(90,180)"},{"id":"cnm_h058_q3","topicId":"cnm_h058","difficulty":"standard","type":"numeric","prompt":"π/2 弧度等于多少度？","answer":"90","explanation":"π/2 弧度是 90°。","verify":"degrees(pi/2)"},{"id":"cnm_h058_q4","topicId":"cnm_h058","difficulty":"standard","type":"choice","prompt":"30° 等于多少弧度？","choices":[{"key":"A","text":"π/3"},{"key":"B","text":"π/4"},{"key":"C","text":"π/6"},{"key":"D","text":"π/2"}],"answer":"C","explanation":"30° 是 180° 的 1/6，所以是 π/6。","verify":"\"π/6\""},{"id":"cnm_h059_q1","topicId":"cnm_h059","difficulty":"basic","type":"numeric","prompt":"半径为 5、圆心角为 2 弧度，弧长是多少？","answer":"10","explanation":"弧度制下弧长 = 半径 × 圆心角，5×2=10。","verify":"5*2"},{"id":"cnm_h059_q2","topicId":"cnm_h059","difficulty":"basic","type":"numeric","prompt":"半径为 4、弧长为 8，圆心角是多少弧度？","answer":"2","explanation":"圆心角 = 弧长 / 半径 = 2。","verify":"8/4"},{"id":"cnm_h059_q3","topicId":"cnm_h059","difficulty":"standard","type":"numeric","prompt":"半径为 3、圆心角为 1 弧度，弧长是多少？","answer":"3","explanation":"弧长等于半径 3。","verify":"3*1"},{"id":"cnm_h059_q4","topicId":"cnm_h059","difficulty":"standard","type":"choice","prompt":"公式 l=|α|r 里的 α 必须用？","choices":[{"key":"A","text":"角度"},{"key":"B","text":"百分数"},{"key":"C","text":"弧长本身"},{"key":"D","text":"弧度"}],"answer":"D","explanation":"这个公式只在 α 用弧度时成立。用角度要先换算。","verify":"\"弧度\""}]
