[{"id":"cnm_010_q1","topicId":"cnm_010","difficulty":"basic","type":"numeric","prompt":"计算 (-8)+5 和 (-3)+(-4)。（依次作答，用逗号隔开）","answer":"-3，-7","explanation":"异号两数相加，取绝对值较大的数的符号，再用较大的绝对值减较小的：-(8-5)=-3；同号相加取相同符号，绝对值相加：-(3+4)=-7。","verify":"[-8+5, -3+(-4)]"},{"id":"cnm_010_q2","topicId":"cnm_010","difficulty":"basic","type":"choice","prompt":"下列计算正确的是哪一个？","choices":[{"key":"A","text":"(-5)+3=-8"},{"key":"B","text":"(-5)+(-3)=8"},{"key":"C","text":"4+(-9)=5"},{"key":"D","text":"(-2)+5=3"}],"answer":"D","explanation":"(-2)+5：异号相加，取 5 的符号（正），5-2=3。其余三式符号或数值有误：(-5)+3=-2，(-5)+(-3)=-8，4+(-9)=-5。"},{"id":"cnm_010_q3","topicId":"cnm_010","difficulty":"standard","type":"numeric","prompt":"计算 (-5/6)+(1/3)，结果写成最简分数。","answer":"-1/2","explanation":"通分：-5/6+2/6，异号相加，取负号，(5-2)/6=3/6=1/2，结果为 -1/2。","verify":"Fraction(-5,6)+Fraction(1,3)"},{"id":"cnm_010_q4","topicId":"cnm_010","difficulty":"standard","type":"numeric","prompt":"已知 |a|=6，|b|=4，且 a<0<b，求 a+b 的值。","answer":"-2","explanation":"由 a<0 得 a=-6，由 b>0 得 b=4，所以 a+b=-6+4=-2。","verify":"-6+4"},{"id":"cnm_011_q1","topicId":"cnm_011","difficulty":"basic","type":"numeric","prompt":"简便计算 (-7)+12+(-3)+8。","answer":"10","explanation":"把同号的数结合：[(-7)+(-3)]+(12+8)=-10+20=10。","verify":"-7+12+(-3)+8"},{"id":"cnm_011_q2","topicId":"cnm_011","difficulty":"basic","type":"choice","prompt":"等式 13+(-7)+(-13)=13+(-13)+(-7) 主要运用了哪条运算律？","choices":[{"key":"A","text":"加法结合律"},{"key":"B","text":"加法交换律"},{"key":"C","text":"乘法分配律"}],"answer":"B","explanation":"只是交换了 (-7) 与 (-13) 的位置，没有改变加数的分组，所以用的是加法交换律。"},{"id":"cnm_011_q3","topicId":"cnm_011","difficulty":"standard","type":"numeric","prompt":"简便计算 (-1.6)+3.7+(-2.4)+1.3。","answer":"1","explanation":"把互相凑整的数结合：[(-1.6)+(-2.4)]+(3.7+1.3)=-4+5=1。","verify":"Fraction(-8,5)+Fraction(37,10)+Fraction(-12,5)+Fraction(13,10)"},{"id":"cnm_011_q4","topicId":"cnm_011","difficulty":"standard","type":"numeric","prompt":"简便计算 (-5/2)+(7/3)+(-3/2)+(2/3)。","answer":"-1","explanation":"同分母结合：[(-5/2)+(-3/2)]+(7/3+2/3)=-4+3=-1。","verify":"Fraction(-5,2)+Fraction(7,3)+Fraction(-3,2)+Fraction(2,3)"}]
