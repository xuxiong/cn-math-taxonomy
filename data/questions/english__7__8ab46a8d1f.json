prompt":"失物招领牌上写什么可以表示「请找老师」？","choices":[{"key":"A","text":"I am the teacher."},{"key":"B","text":"This are a teacher."},{"key":"C","text":"Ask you teacher."},{"key":"D","text":"Ask the teacher for it."}],"answer":"D","explanation":"Ask the teacher for it 是向老师索取。","verify":"\"Ask the teacher for it.\""},{"id":"cne_j016_q4","topicId":"cne_j016","difficulty":"standard","type":"choice","prompt":"想说这本词典是他的，哪一句合适？","choices":[{"key":"A","text":"This is his dictionary."},{"key":"B","text":"This is he dictionary."},{"key":"C","text":"This is him dictionary."},{"key":"D","text":"This are his dictionary."}],"answer":"A","explanation":"his 修饰 dictionary。","verify":"\"This is his dictionary.\""},{"id":"cne_j017_q1","topicId":"cne_j017","difficulty":"basic","type":"choice","prompt":"Found: a blue pencil. Is this your pencil? Call Mary at 622-6033. 捡到的是什么？","choices":[{"key":"A","text":"一块橡皮"},{"key":"B","text":"一本词典"},{"key":"C","text":"一支蓝色铅笔"},{"key":"D","text":"一把尺子"}],"answer":"C","explanation":"a blue pencil 是蓝色铅笔。","verify":"\"一支蓝色铅笔\""},{"id":"cne_j017_q2","topicId":"cne_j017","difficulty":"basic","type":"choice","prompt":"Found: a blue pencil. Is this your pencil? Call Mary at 622-6033. 应该给谁打电话？","choices":[{"key":"A","text":"Gina"},{"key":"B","text":"Tom"},{"key":"C","text":"Jack"},{"key":"D","text":"Mary"}],"answer":"D","explanation":"Call Mary 是给 Mary 打电话。","verify":"\"Mary\""},{"id":"cne_j017_q3","topicId":"cne_j017","difficulty":"standard","type":"choice","prompt":"Lost: my dictionary. My name is Tom. Please call 139-0011. 谁丢了词典？","choices":[{"key":"A","text":"Tom"},{"key":"B","text":"Mary"},{"key":"C","text":"Gina"},{"key":"D","text":"Alice"}],"answer":"A","explanation":"My name is Tom，丢的是 my dictionary。","verify":"\"Tom\""},{"id":"cne_j017_q4","topicId":"cne_j017","difficulty":"standard","type":"choice","prompt":"Lost: my dictionary. My name is Tom. Please call 139-0011. 哪一句和启事一致？","choices":[{"key":"A","text":"Tom found a dictionary."},{"key":"B","text":"Tom lost a dictionary."},{"key":"C","text":"Mary lost a pencil."},{"key":"D","text":"The dictionary is blue."}],"answer":"B","explanation":"Lost: my dictionary 表示词典丢失了。","verify":"\"Tom lost a dictionary.\""},{"id":"cne_j018_q1","topicId":"cne_j018","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「房间」？","choices":[{"key":"A","text":"bed"},{"key":"B","text":"table"},{"key":"C","text":"chair"},{"key":"D","text":"room"}],"answer":"D","explanation":"room 的意思是房间。","verify":"\"room\""},{"id":"cne_j018_q2","topicId":"cne_j018","difficulty":"basic","type":"choice","prompt":"「bed」的中文意思是哪一个？","choices":[{"key":"A","text":"床"},{"key":"B","text":"房间"},{"key":"C","text":"桌子"},{"key":"D","text":"椅子"}],"answer":"A","explanation":"bed 的意思是床。","verify":"\"床\""},{"id":"cne_j018_q3","topicId":"cne_j018","difficulty":"standard","type":"choice","prompt":"选择表示「桌子」的单词。","choices":[{"key":"A","text":"room"},{"key":"B","text":"table"},{"key":"C","text":"bed"},{"key":"D","text":"chair"}],"answer":"B","explanation":"表示桌子的单词是 table。","verify":"\"table\""},{"id":"cne_j018_q4","topicId":"cne_j018","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「椅子」？","choices":[{"key":"A","text":"room"},{"key":"B","text":"bed"},{"key":"C","text":"chair"},{"key":"D","text":"table"}],"answer":"C","explanation":"chair 的意思是椅子。","verify":"\"chair\""},{"id":"cne_j020_q1","topicId":"cne_j020","difficulty":"basic","type":"choice","prompt":"找不到书包，哪一句用来询问？","choices":[{"key":"A","text":"What is my schoolbag?"},{"key":"B","text":"Where is my schoolbag?"},{"key":"C","text":"Where are my schoolbag?"},{"key":"D","text":"Who is my schoolbag?"}],"answer":"B","explanation":"单数物品用 Where is。","verify":"\"Where is my schoolbag?\""},{"id":"cne_j020_q2","topicId":"cne_j020","difficulty":"basic","type":"choice","prompt":"书包在椅子下面，应回答什么？","choices":[{"key":"A","text":"It are under the chair."},{"key":"B","text":"It is the under chair."},{"key":"C","text":"It is under the chair."},{"key":"D","text":"They is under the chair."}],"answer":"C","explanation":"单数用 It is under。","verify":"\"It is under the chair.\""},{"id":"cne_j020_q3","topicId":"cne_j020","difficulty":"standard","type":"choice","prompt":"对方说 Where are my books? 书在桌子上，应回答什么？","choices":[{"key":"A","text":"It is on the table."},{"key":"B","text":"They is on the table."},{"key":"C","text":"They are in the table."},{"key":"D","text":"They are on the table."}],"answer":"D","explanation":"books 用 they are，在桌面上用 on。","verify":"\"They are on the table.\""},{"id":"cne_j020_q4","topicId":"cne_j020","difficulty":"standard","type":"choice","prompt":"哪一句是在请对方看床底下？","choices":[{"key":"A","text":"Look under the bed."},{"key":"B","text":"Look the bed under."},{"key":"C","text":"Look on name."},{"key":"D","text":"See you under."}],"answer":"A","explanation":"Look under the bed 是看床底下。","verify":"\"Look under the bed.\""},{"id":"cne_j021_q1","topicId":"cne_j021","difficulty":"basic","type":"choice","prompt":"This is my room. The book is on the table. The bag is under the chair. 书在哪里？","choices":[{"key":"A","text":"在椅子下面"},{"key":"B","text":"在书包里"},{"key":"C","text":"在桌子上"},{"key":"D","text":"在床上"}],"answer":"C","explanation":"The book is on the table。","verify":"\"在桌子上\""},{"id":"cne_j021_q2","topicId":"cne_j021","difficulty":"basic","type":"choice","prompt":"This is my room. The book is on the table. The bag is under the chair. 包在哪里？","choices":[{"key":"A","text":"在桌子上"},{"key":"B","text":"在床上"},{"key":"C","text":"在书里面"},{"key":"D","text":"在椅子下面"}],"answer":"D","explanation":"The bag is under the chair。","verify":"\"在椅子下面\""},{"id":"cne_j021_q3","topicId":"cne_j021","difficulty":"standard","type":"choice","prompt":"The keys are in the schoolbag. The schoolbag is on the bed. 钥匙在哪里？","choices":[{"key":"A","text":"在书包里"},{"key":"B","text":"在床底下"},{"key":"C","text":"在桌子上"},{"key":"D","text":"在椅子上"}],"answer":"A","explanation":"The keys are in the schoolbag。","verify":"\"在书包里\""},{"id":"cne_j021_q4","topicId":"cne_j021","difficulty":"standard","type":"choice","prompt":"The keys are in the schoolbag. The schoolbag is on the bed. 哪一句和短文一致？","choices":[{"key":"A","text":"The keys are on the bed."},{"key":"B","text":"The schoolbag is on the bed."},{"key":"C","text":"The schoolbag is under the bed."},{"key":"D","text":"The keys are under the chair."}],"answer":"B","explanation":"书包在床上，钥匙在书包里，不是直接在床上。","verify":"\"The schoolbag is on the bed.\""}]
