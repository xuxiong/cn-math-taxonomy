[{"id":"cnd_p001_q1","topicId":"cnd_p001","difficulty":"basic","type":"choice","prompt":"第一天去上学，最合适的做法是？","choices":[{"key":"A","text":"把书包扔门口就走"},{"key":"B","text":"从来不和同学说话"},{"key":"C","text":"按时到校，认识老师和同学"},{"key":"D","text":"上课随便离开教室"}],"answer":"C","explanation":"按时到校并认识老师同学，才能开开心心上学。","verify":"\"按时到校，认识老师和同学\""},{"id":"cnd_p001_q2","topicId":"cnd_p001","difficulty":"basic","type":"choice","prompt":"背书包走路上学，应该注意什么？","choices":[{"key":"A","text":"边走边玩不看路"},{"key":"B","text":"在马路中间追跑"},{"key":"C","text":"红灯时冲过马路"},{"key":"D","text":"走人行横道，注意来往车辆"}],"answer":"D","explanation":"上学路上要遵守交通规则。","verify":"\"走人行横道，注意来往车辆\""},{"id":"cnd_p001_q3","topicId":"cnd_p001","difficulty":"standard","type":"choice","prompt":"到了教室发现自己紧张，可以怎么做？","choices":[{"key":"A","text":"深呼吸，和旁边同学打个招呼"},{"key":"B","text":"大哭着跑出学校"},{"key":"C","text":"把书包砸到地上"},{"key":"D","text":"躲在厕所不出来"}],"answer":"A","explanation":"紧张时可以放松一下，主动认识新同学。","verify":"\"深呼吸，和旁边同学打个招呼\""},{"id":"cnd_p001_q4","topicId":"cnd_p001","difficulty":"challenge","type":"choice","prompt":"小学生在学校的主要任务是什么？","choices":[{"key":"A","text":"整天只玩不听课"},{"key":"B","text":"好好学习，和同学友好相处"},{"key":"C","text":"替老师批改全部作业"},{"key":"D","text":"不去上课"}],"answer":"B","explanation":"小学生要以学习为主，并学会与同学相处。","verify":"\"好好学习，和同学友好相处\""},{"id":"cnd_p002_q1","topicId":"cnd_p002","difficulty":"basic","type":"choice","prompt":"升国旗时，正确的做法是？","choices":[{"key":"A","text":"到处走动聊天"},{"key":"B","text":"低头玩玩具"},{"key":"C","text":"背对国旗站着"},{"key":"D","text":"立正敬礼，安静注视国旗"}],"answer":"D","explanation":"升国旗要立正敬礼，表示尊敬。","verify":"\"立正敬礼，安静注视国旗\""},{"id":"cnd_p002_q2","topicId":"cnd_p002","difficulty":"basic","type":"choice","prompt":"五星红旗是哪个国家的国旗？","choices":[{"key":"A","text":"中华人民共和国"},{"key":"B","text":"某一个城市的旗帜"},{"key":"C","text":"一所学校的校旗"},{"key":"D","text":"一个运动队的队旗"}],"answer":"A","explanation":"五星红旗是我们国家的国旗。","verify":"\"中华人民共和国\""},{"id":"cnd_p002_q3","topicId":"cnd_p002","difficulty":"standard","type":"choice","prompt":"为什么要向国旗敬礼？","choices":[{"key":"A","text":"只是为了摆姿势拍照"},{"key":"B","text":"表达对祖国的热爱和尊敬"},{"key":"C","text":"因为别人敬礼所以跟风"},{"key":"D","text":"因为国旗颜色好看"}],"answer":"B","explanation":"敬礼是热爱祖国、尊敬国家象征的表现。","verify":"\"表达对祖国的热爱和尊敬\""},{"id":"cnd_p002_q4","topicId":"cnd_p002","difficulty":"challenge","type":"choice","prompt":"国旗上的大五角星代表什么？","choices":[{"key":"A","text":"太阳"},{"key":"B","text":"一颗星星的名字"},{"key":"C","text":"中国共产党的领导"},{"key":"D","text":"一个省"}],"answer":"C","explanation":"教材告诉我们，大五角星代表中国共产党。","verify":"\"中国共产党的领导\""},{"id":"cnd_p003_q1","topicId":"cnd_p003","difficulty":"basic","type":"choice","prompt":"校园里常见的地方有？","choices":[{"key":"A","text":"教室、操场、图书馆等"},{"key":"B","text":"只有游乐场"},{"key":"C","text":"只有商店"},{"key":"D","text":"只有家里客厅"}],"answer":"A","explanation":"校园有教室、操场、图书馆等。","verify":"\"教室、操场、图书馆等\""},{"id":"cnd_p003_q2","topicId":"cnd_p003","difficulty":"basic","type":"choice","prompt":"在校园走廊里走路，正确做法是？","choices":[{"key":"A","text":"拼命奔跑推挤"},{"key":"B","text":"靠右行走，不追逐打闹"},{"key":"C","text":"在门口玩球挡路"},{"key":"D","text":"从楼上往下扔东西"}],"answer":"B","explanation":"走廊要文明行走，注意安全。","verify":"\"靠右行走，不追逐打闹\""},{"id":"cnd_p003_q3","topicId":"cnd_p003","difficulty":"standard","type":"choice","prompt":"看到花坛里的花，应该怎么做？","choices":[{"key":"A","text":"摘下来带回家"},{"key":"B","text":"踩进花坛"},{"key":"C","text":"欣赏，不采摘"},{"key":"D","text":"扒开泥土玩"}],"answer":"C","explanation":"要爱护校园花草。","verify":"\"欣赏，不采摘\""},{"id":"cnd_p003_q4","topicId":"cnd_p003","difficulty":"challenge","type":"choice","prompt":"熟悉校园有什么好处？","choices":[{"key":"A","text":"只为了向别人炫耀"},{"key":"B","text":"没有用"},{"key":"C","text":"只为了考试画地图"},{"key":"D","text":"方便学习和活动，遇事知道怎么走"}],"answer":"D","explanation":"熟悉校园有助学习和安全。","verify":"\"方便学习和活动，遇事知道怎么走\""},{"id":"cnd_p004_q1","topicId":"cnd_p004","difficulty":"basic","type":"choice","prompt":"放学过马路时，应该怎么做？","choices":[{"key":"A","text":"不看灯直接冲"},{"key":"B","text":"走人行横道，红灯停绿灯行"},{"key":"C","text":"从车流中穿行"},{"key":"D","text":"跟在大车后跑"}],"answer":"B","explanation":"遵守交通规则才能平安回家。","verify":"\"走人行横道，红灯停绿灯行\""},{"id":"cnd_p004_q2","topicId":"cnd_p004","difficulty":"basic","type":"choice","prompt":"一个人在家，陌生人敲门说要进屋，正确做法是？","choices":[{"key":"A","text":"马上开门请进"},{"key":"B","text":"把钥匙交给对方"},{"key":"C","text":"不随便开门，先联系家长"},{"key":"D","text":"带他参观每个房间"}],"answer":"C","explanation":"不能给陌生人随便开门。","verify":"\"不随便开门，先联系家长\""},{"id":"cnd_p004_q3","topicId":"cnd_p004","difficulty":"standard","type":"choice","prompt":"路上有人给陌生食物，应该怎么做？","choices":[{"key":"A","text":"马上吃掉"},{"key":"B","text":"跟对方去偏僻处"},{"key":"C","text":"把家庭住址告诉对方"},{"key":"D","text":"不接受，回家告诉家长"}],"answer":"D","explanation":"不接受陌生人的食物。","verify":"\"不接受，回家告诉家长\""},{"id":"cnd_p004_q4","topicId":"cnd_p004","difficulty":"challenge","type":"choice","prompt":"为什么强调平平安安回家？","choices":[{"key":"A","text":"安全到家才能继续学习和生活"},{"key":"B","text":"回家越晚越好"},{"key":"C","text":"路上玩多久都行"},{"key":"D","text":"安全不重要"}],"answer":"A","explanation":"安全是学习和生活的前提。","verify":"\"安全到家才能继续学习和生活\""}]
