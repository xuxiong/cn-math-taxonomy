[{"id":"cne_p204_q1","topicId":"cne_p204","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「行星」？","choices":[{"key":"A","text":"planet"},{"key":"B","text":"plant"},{"key":"C","text":"plate"},{"key":"D","text":"plane"}],"answer":"A","explanation":"planet 是行星。","verify":"\"planet\""},{"id":"cne_p204_q2","topicId":"cne_p204","difficulty":"basic","type":"choice","prompt":"We live on the ____. 我们住在地球上。","choices":[{"key":"A","text":"moon"},{"key":"B","text":"star"},{"key":"C","text":"earth"},{"key":"D","text":"sun"}],"answer":"C","explanation":"人类住在地球 earth 上。","verify":"\"earth\""},{"id":"cne_p204_q3","topicId":"cne_p204","difficulty":"standard","type":"choice","prompt":"At night, we can see the ____ and stars.","choices":[{"key":"A","text":"rocket"},{"key":"B","text":"sun"},{"key":"C","text":"rain"},{"key":"D","text":"moon"}],"answer":"D","explanation":"夜里能看到月亮和星星。","verify":"\"moon\""},{"id":"cne_p204_q4","topicId":"cne_p204","difficulty":"standard","type":"choice","prompt":"space 在 Exploring space 中的意思是？","choices":[{"key":"A","text":"太空"},{"key":"B","text":"地方"},{"key":"C","text":"空房间"},{"key":"D","text":"空格"}],"answer":"A","explanation":"Exploring space 是探索太空。","verify":"\"太空\""},{"id":"cne_p205_q1","topicId":"cne_p205","difficulty":"basic","type":"choice","prompt":"I ____ be an astronaut in the future.","choices":[{"key":"A","text":"will"},{"key":"B","text":"am"},{"key":"C","text":"did"},{"key":"D","text":"was"}],"answer":"A","explanation":"说将来用 will 加动词原形。","verify":"\"will\""},{"id":"cne_p205_q2","topicId":"cne_p205","difficulty":"basic","type":"choice","prompt":"哪一句正确？","choices":[{"key":"A","text":"We wills visit Mars one day."},{"key":"B","text":"We will visits Mars one day."},{"key":"C","text":"We will visit Mars one day."},{"key":"D","text":"We will visiting Mars one day."}],"answer":"C","explanation":"will 后面接动词原形。","verify":"\"We will visit Mars one day.\""},{"id":"cne_p205_q3","topicId":"cne_p205","difficulty":"standard","type":"choice","prompt":"Will people travel to space? 肯定回答是？","choices":[{"key":"A","text":"Yes, they are."},{"key":"B","text":"Yes, they will."},{"key":"C","text":"Yes, they do."},{"key":"D","text":"Yes, they did."}],"answer":"B","explanation":"Will 提问用 will 回答。","verify":"\"Yes, they will.\""},{"id":"cne_p205_q4","topicId":"cne_p205","difficulty":"standard","type":"choice","prompt":"「机器人将会帮助宇航员」哪一句对？","choices":[{"key":"A","text":"Robots will help astronauts."},{"key":"B","text":"Robots are help astronauts."},{"key":"C","text":"Robots will helped astronauts."},{"key":"D","text":"Robots helped astronauts."}],"answer":"A","explanation":"will help 表示将来。","verify":"\"Robots will help astronauts.\""},{"id":"cne_p206_q1","topicId":"cne_p206","difficulty":"basic","type":"choice","prompt":"Shenzhou-5 took Yang Liwei into space in 2003. 是哪一年？","choices":[{"key":"A","text":"2013"},{"key":"B","text":"2003"},{"key":"C","text":"2005"},{"key":"D","text":"2030"}],"answer":"B","explanation":"原文写 in 2003。","verify":"\"2003\""},{"id":"cne_p206_q2","topicId":"cne_p206","difficulty":"basic","type":"choice","prompt":"Chang'e-5 brought back soil from the moon. 带回了什么？","choices":[{"key":"A","text":"月球土壤"},{"key":"B","text":"太空水"},{"key":"C","text":"火星石头"},{"key":"D","text":"星星"}],"answer":"A","explanation":"soil from the moon 是月球土壤。","verify":"\"月球土壤\""},{"id":"cne_p206_q3","topicId":"cne_p206","difficulty":"standard","type":"choice","prompt":"The astronauts live and work in the space station for six months. 他们在空间站待多久？","choices":[{"key":"A","text":"六个月"},{"key":"B","text":"六年"},{"key":"C","text":"六天"},{"key":"D","text":"六周"}],"answer":"A","explanation":"six months 是六个月。","verify":"\"六个月\""},{"id":"cne_p206_q4","topicId":"cne_p206","difficulty":"standard","type":"choice","prompt":"Tiangong is China's space station. Tiangong 是什么？","choices":[{"key":"A","text":"一枚火箭"},{"key":"B","text":"一颗行星"},{"key":"C","text":"一个月亮"},{"key":"D","text":"中国的空间站"}],"answer":"D","explanation":"space station 是空间站。","verify":"\"中国的空间站\""},{"id":"cne_p240_q1","topicId":"cne_p240","difficulty":"basic","type":"choice","prompt":"想说「将来人们会去火星」，应选哪一句？","choices":[{"key":"A","text":"People will go to Mars."},{"key":"B","text":"People will goes to Mars."},{"key":"C","text":"People going to Mars yesterday."},{"key":"D","text":"People go to Mars yesterday."}],"answer":"A","explanation":"will + 动词原形表将来。","verify":"\"People will go to Mars.\""},{"id":"cne_p240_q2","topicId":"cne_p240","difficulty":"basic","type":"choice","prompt":"I am going to be an astronaut. 这句是在说？","choices":[{"key":"A","text":"我昨天是宇航员"},{"key":"B","text":"我不是宇航员"},{"key":"C","text":"我害怕太空"},{"key":"D","text":"我打算当宇航员"}],"answer":"D","explanation":"be going to 表打算。","verify":"\"我打算当宇航员\""},{"id":"cne_p240_q3","topicId":"cne_p240","difficulty":"standard","type":"choice","prompt":"哪一句谈未来太空生活？","choices":[{"key":"A","text":"We never will."},{"key":"B","text":"Space is a book."},{"key":"C","text":"We will live on a space station."},{"key":"D","text":"We lived on a space station yesterday only."}],"answer":"C","explanation":"will live 表将来。","verify":"\"We will live on a space station.\""},{"id":"cne_p240_q4","topicId":"cne_p240","difficulty":"standard","type":"choice","prompt":"They ____ explore the moon next year.","choices":[{"key":"A","text":"was"},{"key":"B","text":"will"},{"key":"C","text":"did"},{"key":"D","text":"are"}],"answer":"B","explanation":"next year 用 will。","verify":"\"will\""}]
