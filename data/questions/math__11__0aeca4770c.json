[{"id":"cnm_h100_q1","topicId":"cnm_h100","difficulty":"basic","type":"numeric","prompt":"(1+2i)+(3+4i) 的实部是多少？","answer":"4","explanation":"实部 1+3=4。","verify":"1+3"},{"id":"cnm_h100_q2","topicId":"cnm_h100","difficulty":"basic","type":"numeric","prompt":"(1+2i)+(3+4i) 的虚部是多少？","answer":"6","explanation":"虚部与虚部相加，2+4=6。","verify":"2+4"},{"id":"cnm_h100_q3","topicId":"cnm_h100","difficulty":"standard","type":"numeric","prompt":"(5+i)−(2+3i) 的实部是多少？","answer":"3","explanation":"实部 5−2=3。","verify":"5-2"},{"id":"cnm_h100_q4","topicId":"cnm_h100","difficulty":"standard","type":"numeric","prompt":"(5+i)−(2+3i) 的虚部是多少？","answer":"-2","explanation":"虚部 1−3=−2。","verify":"1-3"},{"id":"cnm_h101_q1","topicId":"cnm_h101","difficulty":"basic","type":"numeric","prompt":"复数 3 与 4i 的模分别是 3 和 4。它们的和 3+4i 的模是多少？","answer":"5","explanation":"两个向量垂直，和的模是 5。","verify":"isqrt(3**2+4**2)"},{"id":"cnm_h101_q2","topicId":"cnm_h101","difficulty":"basic","type":"numeric","prompt":"上一问中，两个模的和是多少？","answer":"7","explanation":"3+4=7，大于和的模 5。","verify":"3+4"},{"id":"cnm_h101_q3","topicId":"cnm_h101","difficulty":"standard","type":"numeric","prompt":"复数 2 与 5 都在实轴上。和的模是多少？","answer":"7","explanation":"同方向时，模可以直接相加，和是 7。","verify":"2+5"},{"id":"cnm_h101_q4","topicId":"cnm_h101","difficulty":"standard","type":"choice","prompt":"|z1+z2| 与 |z1|+|z2| 的关系是？","choices":[{"key":"A","text":"总是严格大于"},{"key":"B","text":"|z1+z2| 小于或等于 |z1|+|z2|"},{"key":"C","text":"总是相等"},{"key":"D","text":"没有确定关系"}],"answer":"B","explanation":"这是三角不等式。方向相同时等号成立。","verify":"\"|z1+z2| 小于或等于 |z1|+|z2|\""},{"id":"cnm_h102_q1","topicId":"cnm_h102","difficulty":"basic","type":"numeric","prompt":"计算 (1+i)(1−i) 的结果。","answer":"2","explanation":"(1+i)(1−i)=1−(i)²=1−(−1)=2。虚部为 0。","verify":"1*1-1*(-1)"},{"id":"cnm_h102_q2","topicId":"cnm_h102","difficulty":"basic","type":"numeric","prompt":"计算 i²。","answer":"-1","explanation":"按定义，i²=−1。","verify":"-1"},{"id":"cnm_h102_q3","topicId":"cnm_h102","difficulty":"standard","type":"numeric","prompt":"计算 i⁴。","answer":"1","explanation":"i⁴=(i²)²=(−1)²=1。","verify":"1"},{"id":"cnm_h102_q4","topicId":"cnm_h102","difficulty":"standard","type":"numeric","prompt":"(2+i)(1+0i) 的实部是多少？","answer":"2","explanation":"乘以 1 后复数不变，实部仍是 2。","verify":"2"},{"id":"cnm_h103_q1","topicId":"cnm_h103","difficulty":"basic","type":"numeric","prompt":"(4+6i)/2 的实部是多少？","answer":"2","explanation":"实部和虚部同时除以 2，实部是 2。","verify":"4/2"},{"id":"cnm_h103_q2","topicId":"cnm_h103","difficulty":"basic","type":"numeric","prompt":"(4+6i)/2 的虚部是多少？","answer":"3","explanation":"虚部 6/2=3。","verify":"6/2"},{"id":"cnm_h103_q3","topicId":"cnm_h103","difficulty":"standard","type":"numeric","prompt":"1+i 的共轭是 1−i。两者的积是多少？","answer":"2","explanation":"z 与共轭的积等于模的平方，这里是 2。","verify":"1*1-1*(-1)"},{"id":"cnm_h103_q4","topicId":"cnm_h103","difficulty":"standard","type":"numeric","prompt":"(1+i)/(1+i) 等于多少？","answer":"1","explanation":"非零复数除以自己等于 1。","verify":"1"},{"id":"cnm_h104_q1","topicId":"cnm_h104","difficulty":"basic","type":"numeric","prompt":"i³=−i。它的虚部是多少？","answer":"-1","explanation":"i³=i²·i=−i，虚部是 −1，实部是 0。","verify":"-1"},{"id":"cnm_h104_q2","topicId":"cnm_h104","difficulty":"basic","type":"numeric","prompt":"计算 (1+2i)(1−2i)。","answer":"5","explanation":"1−(2i)²=1−4i²=1+4=5。","verify":"1*1-2*(-2)"},{"id":"cnm_h104_q3","topicId":"cnm_h104","difficulty":"standard","type":"numeric","prompt":"计算 (3+i)(3−i)。","answer":"10","explanation":"模的平方是 9+1=10。","verify":"3*3-1*(-1)"},{"id":"cnm_h104_q4","topicId":"cnm_h104","difficulty":"standard","type":"choice","prompt":"i 的正整数次幂从 i¹ 起循环的是？","choices":[{"key":"A","text":"i，−1，−i，1"},{"key":"B","text":"1，−1 两种"},{"key":"C","text":"只有 i"},{"key":"D","text":"1，i，−1 三种"}],"answer":"A","explanation":"每 4 次循环一次：i、−1、−i、1。","verify":"\"i，−1，−i，1\""}]
