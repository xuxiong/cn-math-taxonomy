[{"id":"cnm_109_q1","topicId":"cnm_109","difficulty":"basic","type":"choice","prompt":"北半球夏至日昼最长，这一点在趋势图上表现为什么？（图中纵轴为昼长，横轴为日期）","answer":"A","choices":[{"key":"A","text":"曲线的最高点（峰值）"},{"key":"B","text":"曲线的最低点"},{"key":"C","text":"曲线与横轴的交点"}],"explanation":"昼长最大，对应曲线纵坐标最大的点，即最高点（峰值）。"},{"id":"cnm_109_q2","topicId":"cnm_109","difficulty":"basic","type":"numeric","prompt":"昼长与夜长之和为 24 小时。某地某日昼长 14 小时 30 分，夜长是多少小时？（用小数表示）","answer":"9.5","explanation":"14 小时 30 分=14.5 小时，夜长=24-14.5=9.5 小时。","verify":"24-Fraction(29,2)"},{"id":"cnm_109_q3","topicId":"cnm_109","difficulty":"standard","type":"choice","prompt":"北半球某地春分、夏至、秋分的昼长（小时）依次为 12、15、12。从夏至到秋分，昼长趋势图上的曲线","answer":"B","choices":[{"key":"A","text":"上升"},{"key":"B","text":"下降"},{"key":"C","text":"保持水平"}],"explanation":"夏至昼长 15 小时，秋分降到 12 小时，数值变小，曲线下降。"},{"id":"cnm_109_q4","topicId":"cnm_109","difficulty":"standard","type":"numeric","prompt":"北半球某地夏至昼长 15 小时，冬至昼长 9 小时。全年昼长的最大值与最小值的平均数是多少小时？","answer":"12","explanation":"(15+9)÷2=12 小时。","verify":"mean([15,9])"}]
