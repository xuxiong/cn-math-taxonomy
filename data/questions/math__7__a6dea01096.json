[{"id":"cnm_076_q1","topicId":"cnm_076","difficulty":"basic","type":"numeric","prompt":"求 -8 的立方根。","answer":"-2","explanation":"(-2)^3=-8，所以 -8 的立方根是 -2。","verify":"-round(8**(1/3))"},{"id":"cnm_076_q2","topicId":"cnm_076","difficulty":"basic","type":"numeric","prompt":"求 125 的立方根。","answer":"5","explanation":"5^3=125，所以 125 的立方根是 5。","verify":"round(125**(1/3))"},{"id":"cnm_076_q3","topicId":"cnm_076","difficulty":"standard","type":"choice","prompt":"下列说法正确的是","choices":[{"key":"A","text":"任何实数都有且只有一个立方根"},{"key":"B","text":"负数没有立方根"},{"key":"C","text":"一个正数有两个立方根，它们互为相反数"},{"key":"D","text":"0 的立方根不存在"}],"answer":"A","explanation":"立方根与平方根不同：任何实数都有唯一的立方根，负数的立方根是负数，0 的立方根是 0；有两个互为相反数的是平方根，不是立方根。"},{"id":"cnm_076_q4","topicId":"cnm_076","difficulty":"standard","type":"numeric","prompt":"求 -27/64 的立方根，结果写成最简分数。","answer":"-3/4","explanation":"27=3^3，64=4^3，所以 (-3/4)^3=-27/64，立方根是 -3/4。","verify":"-Fraction(round(27**(1/3)), round(64**(1/3)))"},{"id":"cnm_076_q5","topicId":"cnm_076","difficulty":"advanced","type":"numeric","prompt":"已知 ∛(x-1)=-2，求 x 的值。","answer":"-7","explanation":"两边同时立方：x-1=(-2)^3=-8，所以 x=-7。","verify":"(-2)**3+1"}]
