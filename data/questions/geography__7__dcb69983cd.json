[{"id":"cng_j030_q1","topicId":"cng_j030","difficulty":"basic","type":"choice","prompt":"南极地区是地球上最冷的地区之一，被称为？","choices":[{"key":"A","text":"热带雨林"},{"key":"B","text":"世界油库"},{"key":"C","text":"鱼米之乡"},{"key":"D","text":"“冰雪高原”"}],"answer":"D","explanation":"南极大陆平均海拔高、冰层厚，酷寒、烈风、干燥。","verify":"\"“冰雪高原”\""},{"id":"cng_j030_q2","topicId":"cng_j030","difficulty":"basic","type":"choice","prompt":"北极地区的中心是？","choices":[{"key":"A","text":"北冰洋"},{"key":"B","text":"南极大陆"},{"key":"C","text":"青藏高原"},{"key":"D","text":"撒哈拉沙漠"}],"answer":"A","explanation":"北极点位于北冰洋上，周围是亚洲、欧洲和北美洲的北部。","verify":"\"北冰洋\""},{"id":"cng_j030_q3","topicId":"cng_j030","difficulty":"standard","type":"choice","prompt":"到南极考察应选择的季节是北半球的？","choices":[{"key":"A","text":"夏季"},{"key":"B","text":"冬季"},{"key":"C","text":"与季节无关，全年皆宜且同样温暖"},{"key":"D","text":"只有春分日"}],"answer":"B","explanation":"南北半球季节相反，北半球冬季正值南极暖季，有极昼。","verify":"\"冬季\""},{"id":"cng_j030_q4","topicId":"cng_j030","difficulty":"challenge","type":"choice","prompt":"极地地区对全球的意义突出表现在？","choices":[{"key":"A","text":"可以大规模开垦农田"},{"key":"B","text":"气候与全球变暖毫无关系"},{"key":"C","text":"调节全球气候，并具有科研价值"},{"key":"D","text":"没有独特的自然环境"}],"answer":"C","explanation":"冰盖反射阳光、影响洋流和大气环流；还保存气候和环境演变信息。","verify":"\"调节全球气候，并具有科研价值\""}]
