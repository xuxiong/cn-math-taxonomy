[{"id":"cnh_j059_q1","topicId":"cnh_j059","difficulty":"basic","type":"choice","prompt":"1931年9月18日日本炸毁柳条湖一段铁路，随即进攻？","choices":[{"key":"A","text":"沈阳北大营"},{"key":"B","text":"卢沟桥"},{"key":"C","text":"上海闸北"},{"key":"D","text":"宛平城"}],"answer":"A","explanation":"九一八事变后，东北很快沦陷。","verify":"\"沈阳北大营\""},{"id":"cnh_j059_q2","topicId":"cnh_j059","difficulty":"basic","type":"choice","prompt":"1935年北平学生反对华北自治的运动是？","choices":[{"key":"A","text":"五四运动"},{"key":"B","text":"一二·九运动"},{"key":"C","text":"五卅运动"},{"key":"D","text":"一二·一运动"}],"answer":"B","explanation":"一二·九运动宣传了停止内战、一致抗日的主张。","verify":"\"一二·九运动\""},{"id":"cnh_j059_q3","topicId":"cnh_j059","difficulty":"standard","type":"choice","prompt":"1936年12月12日发动西安事变的是？","choices":[{"key":"A","text":"蒋介石和汪精卫"},{"key":"B","text":"周恩来和叶剑英"},{"key":"C","text":"张学良和杨虎城"},{"key":"D","text":"张自忠和佟麟阁"}],"answer":"C","explanation":"张学良、杨虎城实行兵谏。","verify":"\"张学良和杨虎城\""},{"id":"cnh_j059_q4","topicId":"cnh_j059","difficulty":"challenge","type":"choice","prompt":"西安事变和平解决的结果是？","choices":[{"key":"A","text":"日本立即投降"},{"key":"B","text":"国共合作彻底破裂"},{"key":"C","text":"红军停止长征"},{"key":"D","text":"十年内战基本结束，抗日民族统一战线初步形成"}],"answer":"D","explanation":"中国共产党促成西安事变和平解决。","verify":"\"十年内战基本结束，抗日民族统一战线初步形成\""},{"id":"cnh_j060_q1","topicId":"cnh_j060","difficulty":"basic","type":"choice","prompt":"1937年7月7日日本进攻宛平城，这一事件称为？","choices":[{"key":"A","text":"九一八事变"},{"key":"B","text":"七七事变"},{"key":"C","text":"一二·九运动"},{"key":"D","text":"八一三事变"}],"answer":"B","explanation":"卢沟桥事变标志全民族抗战开始。","verify":"\"七七事变\""},{"id":"cnh_j060_q2","topicId":"cnh_j060","difficulty":"basic","type":"choice","prompt":"1937年8月13日日本进攻上海，中国军队进行的是？","choices":[{"key":"A","text":"徐州会战"},{"key":"B","text":"武汉会战"},{"key":"C","text":"淞沪会战"},{"key":"D","text":"百团大战"}],"answer":"C","explanation":"淞沪会战粉碎了日军三个月灭亡中国的企图。","verify":"\"淞沪会战\""},{"id":"cnh_j060_q3","topicId":"cnh_j060","difficulty":"standard","type":"choice","prompt":"1937年12月日军占领南京后制造的暴行是？","choices":[{"key":"A","text":"旅顺大屠杀"},{