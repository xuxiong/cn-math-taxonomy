[{"id":"cnm_167_q1","topicId":"cnm_167","difficulty":"basic","type":"choice","prompt":"x 取何值时 √(x-3) 有意义？","answer":"D","choices":[{"key":"A","text":"x>3"},{"key":"B","text":"x≤3"},{"key":"C","text":"x≠3"},{"key":"D","text":"x≥3"}],"explanation":"二次根式的被开方数必须非负：x-3≥0，所以 x≥3。"},{"id":"cnm_167_q2","topicId":"cnm_167","difficulty":"basic","type":"choice","prompt":"下列各式中，一定是二次根式的是","answer":"A","choices":[{"key":"A","text":"√(x^2+1)"},{"key":"B","text":"√(-2)"},{"key":"C","text":"∛3"},{"key":"D","text":"√(a-1)"}],"explanation":"x^2+1≥1>0，所以 √(x^2+1) 一定有意义；√(-2) 无意义，∛3 是三次根式，√(a-1) 当 a<1 时无意义。"},{"id":"cnm_167_q3","topicId":"cnm_167","difficulty":"standard","type":"numeric","prompt":"使 √(2x-6) 有意义的 x 的最小整数值是多少？","answer":"3","explanation":"需 2x-6≥0，即 x≥3，最小整数为 3。","verify":"min([x for x in range(-20,21) if 2*x-6>=0])"},{"id":"cnm_167_q4","topicId":"cnm_167","difficulty":"advanced","type":"numeric","prompt":"使 √(x-2)+√(4-x) 有意义的整数 x 有哪几个？从小到大依次作答，用逗号隔开。","answer":"2，3，4","explanation":"需 x-2≥0 且 4-x≥0，即 2≤x≤4，整数为 2、3、4。","verify":"[x for x in range(-10,11) if x-2>=0 and 4-x>=0]"},{"id":"cnm_168_q1","topicId":"cnm_168","difficulty":"standard","type":"numeric","prompt":"化简 √((-5)²) 和 (√7)²。（依次作答，用逗号隔开）","answer":"5，7","explanation":"√((-5)²)=|-5|=5；(√7)²=7（7≥0）。","verify":"[sqrt((-5)**2), sqrt(7)**2]"},{"id":"cnm_168_q2","topicId":"cnm_168","difficulty":"basic","type":"numeric","prompt":"计算 (√10)² - √(3²) 的值。","answer":"7","explanation":"(√10)²=10，√(3²)=3，10-3=7。","verify":"sqrt(10)**2 - sqrt(3**2)"},{"id":"cnm_168_q3","topicId":"cnm_168","difficulty":"standard","type":"choice","prompt":"下列计算正确的是","answer":"B","choices":[{"key":"A","text":"√((-3)²)=-3"},{"key":"B","text":"(√3)²=3"},{"key":"C","text":"√(3²)=±3"},{"key":"D","text":"(-√3)²=-3"}],"explanation":"√((-3)²)=|-3|=3，√(3²)=3，(-√3)²=3，只有 (√3)²=3 正确。"},{"id":"cnm_168_q4","topicId":"cnm_168","difficulty":"advanced","type":"numeric","prompt":"若 1<a<3，化简 √((a-1)²)+√((a-3)²)，结果是一个常数，这个常数是多少？","answer":"2","explanation":"因 a-1>0，a-3<0，所以原式=(a-1)+(3-a)=2。","verify":"abs(2-1)+abs(2-3)"}]
