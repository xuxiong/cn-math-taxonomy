[{"id":"cne_p200_q1","topicId":"cne_p200","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「小麦」？","choices":[{"key":"A","text":"white"},{"key":"B","text":"weather"},{"key":"C","text":"wheat"},{"key":"D","text":"water"}],"answer":"C","explanation":"wheat 是小麦。","verify":"\"wheat\""},{"id":"cne_p200_q2","topicId":"cne_p200","difficulty":"basic","type":"choice","prompt":"Milk comes from ____. 牛奶来自哪里？","choices":[{"key":"A","text":"cows"},{"key":"B","text":"trees"},{"key":"C","text":"fish"},{"key":"D","text":"hens"}],"answer":"A","explanation":"牛奶来自奶牛 cows。","verify":"\"cows\""},{"id":"cne_p200_q3","topicId":"cne_p200","difficulty":"standard","type":"choice","prompt":"Eggs come from ____.","choices":[{"key":"A","text":"hens"},{"key":"B","text":"sheep"},{"key":"C","text":"cows"},{"key":"D","text":"rice"}],"answer":"A","explanation":"鸡蛋来自母鸡 hens。","verify":"\"hens\""},{"id":"cne_p200_q4","topicId":"cne_p200","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「大米」？","choices":[{"key":"A","text":"rice"},{"key":"B","text":"race"},{"key":"C","text":"nice"},{"key":"D","text":"ice"}],"answer":"A","explanation":"rice 是米饭、大米。","verify":"\"rice\""},{"id":"cne_p232_q1","topicId":"cne_p232","difficulty":"basic","type":"choice","prompt":"「挤牛奶」用哪一组词？","choices":[{"key":"A","text":"milk cows"},{"key":"B","text":"feed chickens"},{"key":"C","text":"pick vegetables"},{"key":"D","text":"plant seeds"}],"answer":"A","explanation":"milk cows 是挤牛奶。","verify":"\"milk cows\""},{"id":"cne_p232_q2","topicId":"cne_p232","difficulty":"basic","type":"choice","prompt":"feed chickens 的意思是？","choices":[{"key":"A","text":"挤牛奶"},{"key":"B","text":"摘菜"},{"key":"C","text":"播种"},{"key":"D","text":"喂鸡"}],"answer":"D","explanation":"feed chickens 是喂鸡。","verify":"\"喂鸡\""},{"id":"cne_p232_q3","topicId":"cne_p232","difficulty":"standard","type":"choice","prompt":"「摘蔬菜」用哪一组？","choices":[{"key":"A","text":"milk cows"},{"key":"B","text":"ride a horse"},{"key":"C","text":"pick vegetables"},{"key":"D","text":"plant seeds"}],"answer":"C","explanation":"pick vegetables。","verify":"\"pick vegetables\""},{"id":"cne_p232_q4","topicId":"cne_p232","difficulty":"standard","type":"choice","prompt":"plant seeds 是在做什么？","choices":[{"key":"A","text":"买菜"},{"key":"B","text":"播种"},{"key":"C","text":"喂鸡"},{"key":"D","text":"挤奶"}],"answer":"B","explanation":"plant seeds 是播种。","verify":"\"播种\""},{"id":"cne_p233_q1","topicId":"cne_p233","difficulty":"basic","type":"choice","prompt":"想说「我可以在农场喂鸡」，应选哪一句？","choices":[{"key":"A","text":"I can feed chickens on the farm."},{"key":"B","text":"I can feed chickens on the shop."},{"key":"C","text":"I can feeding chickens."},{"key":"D","text":"I can feeds chickens."}],"answer":"A","explanation":"can + 动词原形；地点 on the farm。","verify":"\"I can feed chickens on the farm.\""},{"id":"cne_p233_q2","topicId":"cne_p233","difficulty":"basic","type":"choice","prompt":"We pick vegetables on the farm. 我们在农场做什么？","choices":[{"key":"A","text":"挤牛奶"},{"key":"B","text":"看书"},{"key":"C","text":"看电影"},{"key":"D","text":"摘蔬菜"}],"answer":"D","explanation":"pick vegetables。","verify":"\"摘蔬菜\""},{"id":"cne_p233_q3","topicId":"cne_p233","difficulty":"standard","type":"choice","prompt":"哪一句是在农场做的事？","choices":[{"key":"A","text":"They milk cows in the library."},{"key":"B","text":"They watch TV on the farm only."},{"key":"C","text":"They milk cows every morning."},{"key":"D","text":"They buy milk in a cinema."}],"answer":"C","explanation":"milk cows 是农场活动。","verify":"\"They milk cows every morning.\""},{"id":"cne_p233_q4","topicId":"cne_p233","difficulty":"standard","type":"choice","prompt":"On the farm I ____ plant seeds.","choices":[{"key":"A","text":"is"},{"key":"B","text":"can"},{"key":"C","text":"cans"},{"key":"D","text":"am"}],"answer":"B","explanation":"情态 can 后接原形。","verify":"\"can\""},{"id":"cne_p234_q1","topicId":"cne_p234","difficulty":"basic","type":"choice","prompt":"读一读：On the farm we milk cows and feed chickens. 我们做什么？","choices":[{"key":"A","text":"挤牛奶和喂鸡"},{"key":"B","text":"只摘菜"},{"key":"C","text":"只播种"},{"key":"D","text":"去商店"}],"answer":"A","explanation":"milk cows and feed chickens。","verify":"\"挤牛奶和喂鸡\""},{"id":"cne_p234_q2","topicId":"cne_p234","difficulty":"basic","type":"choice","prompt":"读一读：Farmers plant seeds in spring. 农民春天做什么？","choices":[{"key":"A","text":"堆雪人"},{"key":"B","text":"放风筝"},{"key":"C","text":"游泳"},{"key":"D","text":"播种"}],"answer":"D","explanation":"plant seeds。","verify":"\"播种\""},{"id":"cne_p234_q3","topicId":"cne_p234","difficulty":"standard","type":"choice","prompt":"读一读：Amy picks vegetables. Tom milks cows. 哪一句一致？","choices":[{"key":"A","text":"汤姆摘菜。"},{"key":"B","text":"他们在图书馆。"},{"key":"C","text":"汤姆挤牛奶。"},{"key":"D","text":"艾米挤牛奶。"}],"answer":"C","explanation":"Tom milks cows。","verify":"\"汤姆挤牛奶。\""},{"id":"cne_p234_q4","topicId":"cne_p234","difficulty":"standard","type":"choice","prompt":"读一读：From the farm we get milk and eggs. 我们从农场得到什么？","choices":[{"key":"A","text":"汽车"},{"key":"B","text":"牛奶和鸡蛋"},{"key":"C","text":"书和笔"},{"key":"D","text":"衣服"}],"answer":"B","explanation":"milk and eggs。","verify":"\"牛奶和鸡蛋\""}]
