[{"id":"cnm_h254_q1","topicId":"cnm_h254","difficulty":"basic","type":"numeric","prompt":"每次成功概率都是 1/5，而且各次独立。失败概率是多少？","answer":"4/5","explanation":"失败概率是 1−p=4/5。","verify":"1-Fraction(1,5)"},{"id":"cnm_h254_q2","topicId":"cnm_h254","difficulty":"basic","type":"choice","prompt":"伯努利试验需要满足哪些条件？","choices":[{"key":"A","text":"每次只有两个结果，成功概率不变，而且各次独立"},{"key":"B","text":"每次可以有很多个结果"},{"key":"C","text":"成功概率一次比一次大"},{"key":"D","text":"各次结果必须互斥地合成一个结果"}],"answer":"A","explanation":"两个结果、概率不变、相互独立，这三条都要有。","verify":"\"每次只有两个结果，成功概率不变，而且各次独立\""},{"id":"cnm_h254_q3","topicId":"cnm_h254","difficulty":"standard","type":"numeric","prompt":"把同一个试验独立重复 4 次。试验次数 n 是多少？","answer":"4","explanation":"重复了 4 次，n=4。","verify":"4"},{"id":"cnm_h254_q4","topicId":"cnm_h254","difficulty":"standard","type":"numeric","prompt":"n=3，每次成功概率 p=1/2。单次失败的概率是多少？","answer":"1/2","explanation":"1−1/2=1/2。","verify":"1-Fraction(1,2)"},{"id":"cnm_h255_q1","topicId":"cnm_h255","difficulty":"basic","type":"numeric","prompt":"X 服从 B(4,1/2)。P(X=2) 是多少？","answer":"3/8","explanation":"C(4,2)×(1/2)^4=6/16=3/8。","verify":"comb(4,2)*Fraction(1,2)**4"},{"id":"cnm_h255_q2","topicId":"cnm_h255","difficulty":"basic","type":"numeric","prompt":"X 服从 B(3,1/3)。P(X=0) 是多少？","answer":"8/27","explanation":"三次都失败：(2/3)^3=8/27。","verify":"Fraction(2,3)**3"},{"id":"cnm_h255_q3","topicId":"cnm_h255","difficulty":"standard","type":"numeric","prompt":"X 服从 B(2,1/2)。P(X=1) 是多少？","answer":"1/2","explanation":"C(2,1)×1/4=1/2。","verify":"comb(2,1)*Fraction(1,2)**2"},{"id":"cnm_h255_q4","topicId":"cnm_h255","difficulty":"standard","type":"choice","prompt":"二项分布 B(n,p) 里的 X 表示什么？","choices":[{"key":"A","text":"每一次试验的成功概率"},{"key":"B","text":"试验失败时的取值个数"},{"key":"C","text":"样本空间的全部结果数"},{"key":"D","text":"n 次独立重复试验中的成功次数"}],"answer":"D","explanation":"X 取 0、1、…、n，记录成功了几次。","verify":"\"n 次独立重复试验中的成功次数\""},{"id":"cnm_h256_q1","topicId":"cnm_h256","difficulty":"basic","type":"numeric","prompt":"X 服从 B(10,1/5)。均值是多少？","answer":"2","explanation":"np=10×1/5=2。","verify":"10*Fraction(1,5)"},{"id":"cnm_h256_q2","topicId":"cnm_h256","difficulty":"basic","type":"numeric","prompt":"X 服从 B(10,1/5)。方差是多少？","answer":"8/5","explanation":"np(1−p)=2×4/5=8/5。","verify":"10*Fraction(1,5)*Fraction(4,5)"},{"id":"cnm_h256_q3","topicId":"cnm_h256","difficulty":"standard","type":"numeric","prompt":"X 服从 B(4,1/2)。均值是多少？","answer":"2","explanation":"4×1/2=2。","verify":"4*Fraction(1,2)"},{"id":"cnm_h256_q4","topicId":"cnm_h256","difficulty":"standard","type":"choice","prompt":"二项分布的方差公式是哪一个？","choices":[{"key":"A","text":"np(1−p)"},{"key":"B","text":"np"},{"key":"C","text":"n+p"},{"key":"D","text":"p 除以 n"}],"answer":"A","explanation":"均值是 np。方差再乘上失败概率 1−p。","verify":"\"np(1−p)\""},{"id":"cnm_h257_q1","topicId":"cnm_h257","difficulty":"basic","type":"numeric","prompt":"10 件产品中有 4 件次品，不放回地抽 3 件。恰有 1 件次品的概率是多少？","answer":"1/2","explanation":"C(4,1)×C(6,2)/C(10,3)=4×15/120=1/2。","verify":"Fraction(comb(4,1)*comb(6,2), comb(10,3))"},{"id":"cnm_h257_q2","topicId":"cnm_h257","difficulty":"basic","type":"numeric","prompt":"10 件产品中有 4 件次品，不放回地抽 3 件。3 件都是次品的概率是多少？","answer":"1/30","explanation":"C(4,3)×C(6,0)/120=4/120=1/30。","verify":"Fraction(comb(4,3)*comb(6,0), comb(10,3))"},{"id":"cnm_h257_q3","topicId":"cnm_h257","difficulty":"standard","type":"numeric","prompt":"10 件产品中有 4 件次品，不放回地抽 3 件。没有次品的概率是多少？","answer":"1/6","explanation":"C(6,3)/120=20/120=1/6。","verify":"Fraction(comb(4,0)*comb(6,3), comb(10,3))"},{"id":"cnm_h257_q4","topicId":"cnm_h257","difficulty":"standard","type":"choice","prompt":"超几何分布和二项分布的抽取方式有什么不同？","choices":[{"key":"A","text":"超几何分布每次都放回"},{"key":"B","text":"超几何分布是不放回抽取"},{"key":"C","text":"两者都要求无限总体"},{"key":"D","text":"超几何分布不能使用组合数"}],"answer":"B","explanation":"不放回时，箱里剩下的次品数会变，所以用组合数而不是固定的 p。","verify":"\"超几何分布是不放回抽取\""},{"id":"cnm_h258_q1","topicId":"cnm_h258","difficulty":"basic","type":"numeric","prompt":"总体 10 件，其中指定类 4 件，不放回地抽 3 件。抽到的指定类件数的均值是多少？","answer":"6/5","explanation":"nK/N=12/10=6/5。","verify":"Fraction(3*4,10)"},{"id":"cnm_h258_q2","topicId":"cnm_h258","difficulty":"basic","type":"numeric","prompt":"总体 8 件，其中指定类 2 件，不放回地抽 4 件。均值是多少？","answer":"1","explanation":"8/8=1。","verify":"Fraction(4*2,8)"},{"id":"cnm_h258_q3","topicId":"cnm_h258","difficulty":"standard","type":"choice","prompt":"超几何分布均值 nK/N 中，K 表示什么？","choices":[{"key":"A","text":"抽取的件数"},{"key":"B","text":"总体里指定类的件数"},{"key":"C","text":"总体的件数"},{"key":"D","text":"抽取后剩下的件数"}],"answer":"B","explanation":"N 是总体件数，n 是抽取件数，K 是总体中那一类的件数。","verify":"\"总体里指定类的件数\""},{"id":"cnm_h258_q4","topicId":"cnm_h258","difficulty":"standard","type":"numeric","prompt":"总体 6 件，其中指定类 3 件，不放回地抽 2 件。均值是多少？","answer":"1","explanation":"6/6=1。","verify":"Fraction(2*3,6)"}]
