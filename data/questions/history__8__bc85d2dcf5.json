[{"id":"cnh_j087_q1","topicId":"cnh_j087","difficulty":"basic","type":"choice","prompt":"第一个百年奋斗目标实现的时间节点是？","choices":[{"key":"A","text":"2021年中国共产党成立100年"},{"key":"B","text":"1949年"},{"key":"C","text":"1978年"},{"key":"D","text":"2049年"}],"answer":"A","explanation":"到2021年，全面建成小康社会的目标实现。","verify":"\"2021年中国共产党成立100年\""},{"id":"cnh_j087_q2","topicId":"cnh_j087","difficulty":"basic","type":"choice","prompt":"全面建成小康社会覆盖的范围是？","choices":[{"key":"A","text":"只包括沿海城市"},{"key":"B","text":"城乡全体人民"},{"key":"C","text":"只包括经济特区"},{"key":"D","text":"只统计工业产值"}],"answer":"B","explanation":"小康是惠及全体人民的小康。","verify":"\"城乡全体人民\""},{"id":"cnh_j087_q3","topicId":"cnh_j087","difficulty":"standard","type":"choice","prompt":"中共二十大召开于？","choices":[{"key":"A","text":"2017年"},{"key":"B","text":"2012年"},{"key":"C","text":"2022年"},{"key":"D","text":"2002年"}],"answer":"C","explanation":"二十大总结了新时代十年的变革。","verify":"\"2022年\""},{"id":"cnh_j087_q4","topicId":"cnh_j087","difficulty":"challenge","type":"choice","prompt":"第一个百年和第二个百年的区别是？","choices":[{"key":"A","text":"两者是同一年"},{"key":"B","text":"前者在2049年"},{"key":"C","text":"后者在2021年"},{"key":"D","text":"前者是全面建成小康社会，后者是建成社会主义现代化强国"}],"answer":"D","explanation":"第二个百年指向本世纪中叶。","verify":"\"前者是全面建成小康社会，后者是建成社会主义现代化强国\""},{"id":"cnh_j088_q1","topicId":"cnh_j088","difficulty":"basic","type":"choice","prompt":"中共二十大提出以什么全面推进中华民族伟大复兴？","choices":[{"key":"A","text":"计划经济"},{"key":"B","text":"中国式现代化"},{"key":"C","text":"封闭式现代化"},{"key":"D","text":"殖民化"}],"answer":"B","explanation":"中国式现代化是人口规模巨大的现代化，也是全体人民共同富裕的现代化。","verify":"\"中国式现代化\""},{"id":"cnh_j088_q2","topicId":"cnh_j088","difficulty":"basic","type":"choice","prompt":"新征程上到2035年的目标包括？","choices":[{"key":"A","text":"完成三大改造"},{"key":"B","text":"恢复科举"},{"key":"C","text":"基本实现社会主义现代化"},{"key":"D","text":"取消市场经济"}],"answer":"C","explanation":"二十大对未来五年和2035年作出部署。","verify":"\"基本实现社会主义现代化\""},{"id":"cnh_j088_q3","topicId":"cnh_j088","difficulty":"standard","type":"choice","prompt":"本世纪中叶的奋斗目标是？","choices":[{"key":"A","text":"解决温饱"},{"key":"B","text":"建立四个经济特区"},{"key":"C","text":"完成土地改革"},{"key":"D","text":"建成富强民主文明和谐美丽的社会主义现代化强国"}],"answer":"D","explanation":"这是第二个百年奋斗目标。","verify":"\"建成富强民主文明和谐美丽的社会主义现代化强国\""},{"id":"cnh_j088_q4","topicId":"cnh_j088","difficulty":"challenge","type":"choice","prompt":"这一课与上一课的衔接是？","choices":[{"key":"A","text":"第一个百年目标实现后，开启新的赶考之路"},{"key":"B","text":"两课都停在1949年"},{"key":"C","text":"新征程从鸦片战争算起"},{"key":"D","text":"二十大取消了改革开放"}],"answer":"A","explanation":"全面建成小康社会之后，进入全面建设社会主义现代化国家的阶段。","verify":"\"第一个百年目标实现后，开启新的赶考之路\""},{"id":"cnh_j089_q1","topicId":"cnh_j089","difficulty":"basic","type":"choice","prompt":"观察新时代社会生活，可以从哪些方面入手？","choices":[{"key":"A","text":"只看一个口号"},{"key":"B","text":"只比较古代帝王"},{"key":"C","text":"交通、通信、居住和消费方式"},{"key":"D","text":"忽略身边变化"}],"answer":"C","explanation":"高铁、移动支付、住房条件都是可以核对的变化。","verify":"\"交通、通信、居住和消费方式\""},{"id":"cnh_j089_q2","topicId":"cnh_j089","difficulty":"basic","type":"choice","prompt":"哪一项属于新时代交通生活的变化？","choices":[{"key":"A","text":"全国只有马车"},{"key":"B","text":"电报是唯一通信工具"},{"key":"C","text":"轮船尚未出现"},{"key":"D","text":"高速铁路网覆盖主要城市"}],"answer":"D","explanation":"高铁缩短了城市之间的旅行时间。","verify":"\"高速铁路网覆盖主要城市\""},{"id":"cnh_j089_q3","topicId":"cnh_j089","difficulty":"standard","type":"choice","prompt":"把生活变化写成历史材料时，应当？","choices":[{"key":"A","text":"注明时间、地点和具体事例"},{"key":"B","text":"只写感觉好或不好"},{"key":"C","text":"不写任何数字"},{"key":"D","text":"把不同年代混在一起"}],"answer":"A","explanation":"活动课要求用具体变化说明时代。","verify":"\"注明时间、地点和具体事例\""},{"id":"cnh_j089_q4","topicId":"cnh_j089","difficulty":"challenge","type":"choice","prompt":"这项活动的目的是？","choices":[{"key":"A","text":"背诵全部年代"},{"key":"B","text":"从身边的社会生活理解时代变迁"},{"key":"C","text":"评价每一个人的私生活"},{"key":"D","text":"代替所有课文"}],"answer":"B","explanation":"衣食住行的变化可以反映国家发展。","verify":"\"从身边的社会生活理解时代变迁\""}]
