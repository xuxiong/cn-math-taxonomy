[{"id":"cnc_p488_q1","topicId":"cnc_p488","difficulty":"basic","type":"choice","prompt":"「昔我往矣」的下一句是哪一句？","choices":[{"key":"A","text":"雨雪霏霏"},{"key":"B","text":"杨柳依依"},{"key":"C","text":"今我来思"},{"key":"D","text":"行道迟迟"}],"answer":"B","explanation":"出发的时候是春天，柳枝轻柔。雨雪是回来的时候。","verify":"\"杨柳依依\""},{"id":"cnc_p488_q2","topicId":"cnc_p488","difficulty":"basic","type":"choice","prompt":"「今我来思」的下一句是哪一句？","choices":[{"key":"A","text":"杨柳依依"},{"key":"B","text":"载渴载饥"},{"key":"C","text":"雨雪霏霏"},{"key":"D","text":"莫知我哀"}],"answer":"C","explanation":"回来时雨雪很大。载渴载饥是再后面的句子。思在这里是语气词，不是思考。","verify":"\"雨雪霏霏\""},{"id":"cnc_p488_q3","topicId":"cnc_p488","difficulty":"standard","type":"choice","prompt":"「行道迟迟」的下一句是哪一句？","choices":[{"key":"A","text":"我心伤悲"},{"key":"B","text":"莫知我哀"},{"key":"C","text":"杨柳依依"},{"key":"D","text":"载渴载饥"}],"answer":"D","explanation":"路走得很慢，又渴又饿。心伤悲是第三联的上句。","verify":"\"载渴载饥\""},{"id":"cnc_p488_q4","topicId":"cnc_p488","difficulty":"standard","type":"choice","prompt":"这段节选出自哪里？","choices":[{"key":"A","text":"《诗经》"},{"key":"B","text":"《孟子》"},{"key":"C","text":"李白的诗"},{"key":"D","text":"杜甫的诗"}],"answer":"A","explanation":"采薇是《诗经·小雅》里的一首。不要因为写了杨柳就记成后来的诗人。","verify":"\"《诗经》\""},{"id":"cnc_p489_q1","topicId":"cnc_p489","difficulty":"basic","type":"choice","prompt":"「渭城朝雨浥轻尘」的下一句是哪一句？","choices":[{"key":"A","text":"劝君更尽一杯酒"},{"key":"B","text":"客舍青青柳色青"},{"key":"C","text":"客舍青青柳色新"},{"key":"D","text":"西出阳关无故人"}],"answer":"C","explanation":"清晨的雨沾湿了尘土，客舍边的柳色显得新。无故人是最后一句。","verify":"\"客舍青青柳色新\""},{"id":"cnc_p489_q2","topicId":"cnc_p489","difficulty":"basic","type":"choice","prompt":"「劝君更尽一杯酒」的下一句是哪一句？","choices":[{"key":"A","text":"西出阳关无故人在"},{"key":"B","text":"客舍青青柳色新"},{"key":"C","text":"劝君更进一杯酒"},{"key":"D","text":"西出阳关无故人"}],"answer":"D","explanation":"再喝一杯，因为出了阳关就难遇故人。诗中是更尽，不是更进。无故人后面不要加字。","verify":"\"西出阳关无故人\""},{"id":"cnc_p489_q3","topicId":"cnc_p489","difficulty":"standard","type":"choice","prompt":"这首诗的作者是谁？","choices":[{"key":"A","text":"王维"},{"key":"B","text":"王昌龄"},{"key":"C","text":"王建"},{"key":"D","text":"王安石"}],"answer":"A","explanation":"送元二去安西的是王维。不要因为姓王就和王建、王安石记成一个人。","verify":"\"王维\""},{"id":"cnc_p489_q4","topicId":"cnc_p489","difficulty":"standard","type":"choice","prompt":"诗人为什么要再劝一杯酒？","choices":[{"key":"A","text":"他们在家里过年"},{"key":"B","text":"朋友要去安西，出了阳关就难见到熟人"},{"key":"C","text":"雨下得太大，不能出门"},{"key":"D","text":"他想把酒换成茶"}],"answer":"B","explanation":"西出阳关无故人，是送别的原因。这不是春节，也不是品茶。","verify":"\"朋友要去安西，出了阳关就难见到熟人\""},{"id":"cnc_p490_q1","topicId":"cnc_p490","difficulty":"basic","type":"choice","prompt":"「好雨知时节」的下一句是哪一句？","choices":[{"key":"A","text":"随风潜入夜"},{"key":"B","text":"当春才发生"},{"key":"C","text":"润物细无声"},{"key":"D","text":"当春乃发生"}],"answer":"D","explanation":"雨知道季节，春天到了就来了。诗中是乃，不是才。潜入夜是第二联。","verify":"\"当春乃发生\""},{"id":"cnc_p490_q2","topicId":"cnc_p490","difficulty":"basic","type":"choice","prompt":"「随风潜入夜」的下一句是哪一句？","choices":[{"key":"A","text":"润物细无声"},{"key":"B","text":"润物细无声息"},{"key":"C","text":"野径云俱黑"},{"key":"D","text":"花重锦官城"}],"answer":"A","explanation":"雨跟着风在夜里悄悄来，滋润万物却没有声响。不要在无声后面加息。","verify":"\"润物细无声\""},{"id":"cnc_p490_q3","topicId":"cnc_p490","difficulty":"standard","type":"choice","prompt":"「晓看红湿处」的下一句是哪一句？","choices":[{"key":"A","text":"花重锦官城外"},{"key":"B","text":"花重锦官城"},{"key":"C","text":"江船火独明"},{"key":"D","text":"花重锦官城中"}],"answer":"B","explanation":"早晨看见花被雨打湿，沉甸甸地开在成都。锦官城就是成都。不要加外或中。","verify":"\"花重锦官城\""},{"id":"cnc_p490_q4","topicId":"cnc_p490","difficulty":"standard","type":"choice","prompt":"这首诗的作者是谁？","choices":[{"key":"A","text":"王维"},{"key":"B","text":"杜牧"},{"key":"C","text":"杜甫"},{"key":"D","text":"李白"}],"answer":"C","explanation":"春夜喜雨是杜甫的。杜牧写过别的诗，不要只因为姓杜就记成他。","verify":"\"杜甫\""}]
