[{"difficulty":"basic","type":"choice","prompt":"用量角器量角时，量角器的中心要对准角的哪一部分？","choices":[{"key":"A","text":"顶点"},{"key":"B","text":"任意一条边的中点"},{"key":"C","text":"角的外面"}],"answer":"A","explanation":"中心对准顶点，0 刻度线对准一条边，再读另一条边对着的刻度。","verify":"'顶点'","id":"cnm_p100_q1","topicId":"cnm_p100"},{"difficulty":"basic","type":"numeric","prompt":"一个角的两条边正好对着量角器上的 0 度和 40 度。这个角是多少度？","answer":"40","explanation":"另一条边对着 40 度，这个角就是 40 度。","verify":"40","id":"cnm_p100_q2","topicId":"cnm_p100"},{"difficulty":"standard","type":"numeric","prompt":"一个直角是 90 度，一个角是 35 度。这个角比直角小多少度？","answer":"55","explanation":"90－35＝55（度）。","verify":"90-35","id":"cnm_p100_q3","topicId":"cnm_p100"},{"difficulty":"challenge","type":"numeric","prompt":"先画一个 50 度的角，再沿着它的一条边向外画一个 40 度的角。这两个角拼成的大角是多少度？","answer":"90","explanation":"两个角拼在一起：50＋40＝90（度）。","verify":"50+40","id":"cnm_p100_q4","topicId":"cnm_p100"},{"difficulty":"basic","type":"numeric","prompt":"1 个平角是多少度？","answer":"180","explanation":"平角的两条边在一条直线上，是 180 度。","verify":"180","id":"cnm_p232_q1","topicId":"cnm_p232"},{"difficulty":"basic","type":"choice","prompt":"一个角是 125°，它是什么角？","choices":[{"key":"A","text":"钝角"},{"key":"B","text":"锐角"},{"key":"C","text":"平角"},{"key":"D","text":"直角"}],"answer":"A","explanation":"大于 90 度、小于 180 度的角是钝角。","verify":"'钝角'","id":"cnm_p232_q2","topicId":"cnm_p232"},{"difficulty":"standard","type":"numeric","prompt":"1 周角等于几个直角？","answer":"4","explanation":"周角 360 度，直角 90 度，360÷90＝4。","verify":"360//90","id":"cnm_p232_q3","topicId":"cnm_p232"},{"difficulty":"challenge","type":"numeric","prompt":"一个钝角比直角大 35 度。这个钝角是多少度？","answer":"125","explanation":"直角 90 度，再大 35 度：90＋35＝125（度）。","verify":"90+35","id":"cnm_p232_q4","topicId":"cnm_p232"}]
