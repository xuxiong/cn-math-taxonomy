[{"id":"cnm_h249_q1","topicId":"cnm_h249","difficulty":"basic","type":"numeric","prompt":"掷一枚均匀骰子，用 X 表示点数。X 有多少个不同的可能取值？","answer":"6","explanation":"点数可以是 1 到 6，共 6 个值。","verify":"6"},{"id":"cnm_h249_q2","topicId":"cnm_h249","difficulty":"basic","type":"choice","prompt":"离散型随机变量的取值有什么特点？","choices":[{"key":"A","text":"可以取到某一区间里的每一个实数"},{"key":"B","text":"不能用数字表示"},{"key":"C","text":"取值必须是负数"},{"key":"D","text":"只取有限个或者可以逐个列出的值"}],"answer":"D","explanation":"骰子点数、次品件数都是离散型。一段区间上的全部实数则不是。","verify":"\"只取有限个或者可以逐个列出的值\""},{"id":"cnm_h249_q3","topicId":"cnm_h249","difficulty":"standard","type":"numeric","prompt":"抛一枚均匀硬币 2 次，X 表示正面朝上的次数。X 有多少个不同的可能取值？","answer":"3","explanation":"可以是 0 次、1 次或 2 次。","verify":"3"},{"id":"cnm_h249_q4","topicId":"cnm_h249","difficulty":"standard","type":"numeric","prompt":"袋中球的标号只有 1、2、3，抽出 1 个并用 X 表示标号。X=2 对应多少个标号？","answer":"1","explanation":"标号 2 只有一个，这个取值对应一种结果。","verify":"1"},{"id":"cnm_h250_q1","topicId":"cnm_h250","difficulty":"basic","type":"numeric","prompt":"X 的取值是 1、2、3。P(X=1)=1/2，P(X=2)=1/3。P(X=3) 是多少？","answer":"1/6","explanation":"三项概率之和为 1，所以第三项是 1/6。","verify":"1-Fraction(1,2)-Fraction(1,3)"},{"id":"cnm_h250_q2","topicId":"cnm_h250","difficulty":"basic","type":"numeric","prompt":"X 只取 0 和 1，P(X=0)=1/4。P(X=1) 是多少？","answer":"3/4","explanation":"1−1/4=3/4。","verify":"1-Fraction(1,4)"},{"id":"cnm_h250_q3","topicId":"cnm_h250","difficulty":"standard","type":"choice","prompt":"一个分布列必须满足什么？","choices":[{"key":"A","text":"每个概率都大于 1"},{"key":"B","text":"每个概率不小于 0，并且全部概率之和等于 1"},{"key":"C","text":"概率之和等于取值的个数"},{"key":"D","text":"概率可以是负数，只要和为 1"}],"answer":"B","explanation":"概率不能为负，全部可能取值的概率要正好分完 1。","verify":"\"每个概率不小于 0，并且全部概率之和等于 1\""},{"id":"cnm_h250_q4","topicId":"cnm_h250","difficulty":"standard","type":"numeric","prompt":"P(X=0)=1/5，P(X=1)=4/5。这两个概率之和是多少？","answer":"1","explanation":"1/5+4/5=1，可以作为完整的分布列。","verify":"Fraction(1,5)+Fraction(4,5)"},{"id":"cnm_h251_q1","topicId":"cnm_h251","difficulty":"basic","type":"numeric","prompt":"X 服从两点分布，P(X=1)=1/4。P(X=0) 是多少？","answer":"3/4","explanation":"失败概率是 1−p=3/4。","verify":"1-Fraction(1,4)"},{"id":"cnm_h251_q2","topicId":"cnm_h251","difficulty":"basic","type":"numeric","prompt":"两点分布中 P(X=1)=1/4。X 的均值是多少？","answer":"1/4","explanation":"0×(1−p)+1×p=p，均值就是 1/4。","verify":"Fraction(1,4)"},{"id":"cnm_h251_q3","topicId":"cnm_h251","difficulty":"standard","type":"choice","prompt":"两点分布用来描述什么？","choices":[{"key":"A","text":"一次试验有无穷多个结果"},{"key":"B","text":"必须连续做 n 次"},{"key":"C","text":"一次试验只有成功和失败两种结果"},{"key":"D","text":"取值可以是任意整数"}],"answer":"C","explanation":"成功记为 1，失败记为 0，所以只有两个点。","verify":"\"一次试验只有成功和失败两种结果\""},{"id":"cnm_h251_q4","topicId":"cnm_h251","difficulty":"standard","type":"numeric","prompt":"把硬币正面记为 1、反面记为 0，硬币均匀。P(X=1) 是多少？","answer":"1/2","explanation":"正面概率是 1/2。","verify":"Fraction(1,2)"}]
