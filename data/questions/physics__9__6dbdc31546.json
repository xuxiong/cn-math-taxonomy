[{"id":"cnp_061_q1","topicId":"cnp_061","difficulty":"basic","type":"choice","prompt":"物理学中规定的电流方向是什么？","choices":[{"key":"A","text":"正电荷定向移动的方向"},{"key":"B","text":"负电荷定向移动的方向"},{"key":"C","text":"电子定向移动的方向"},{"key":"D","text":"从电源负极流向正极（电源外部）"}],"answer":"A","explanation":"规定正电荷定向移动的方向为电流方向；在电源外部，电流从正极流向负极，与电子移动方向相反。","verify":"\"正电荷定向移动的方向\""},{"id":"cnp_061_q2","topicId":"cnp_061","difficulty":"basic","type":"choice","prompt":"在电路中，电源的作用是什么？","choices":[{"key":"A","text":"消耗电能"},{"key":"B","text":"控制电路通断"},{"key":"C","text":"提供电能"},{"key":"D","text":"输送电能"}],"answer":"C","explanation":"电源把其他形式的能转化为电能，为电路提供电能。","verify":"\"提供电能\""},{"id":"cnp_061_q3","topicId":"cnp_061","difficulty":"standard","type":"choice","prompt":"用导线直接把电源正、负极连接起来，这种情况叫什么？","choices":[{"key":"A","text":"通路"},{"key":"B","text":"断路"},{"key":"C","text":"开路"},{"key":"D","text":"电源短路"}],"answer":"D","explanation":"电源短路时电流很大，会损坏电源，必须避免。","verify":"\"电源短路\""},{"id":"cnp_061_q4","topicId":"cnp_061","difficulty":"standard","type":"choice","prompt":"一个完整的电路，至少由哪几部分组成？","choices":[{"key":"A","text":"电源和用电器"},{"key":"B","text":"电源、开关和导线"},{"key":"C","text":"电源、用电器、开关和导线"},{"key":"D","text":"用电器、开关和导线"}],"answer":"C","explanation":"完整电路由电源、用电器、开关和导线组成。","verify":"\"电源、用电器、开关和导线\""}]
