[{"id":"cne_j032_q1","topicId":"cne_j032","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「短袜」？","choices":[{"key":"A","text":"shirt"},{"key":"B","text":"sock"},{"key":"C","text":"skirt"},{"key":"D","text":"sweater"}],"answer":"B","explanation":"sock 的意思是短袜。","verify":"\"sock\""},{"id":"cne_j032_q2","topicId":"cne_j032","difficulty":"basic","type":"choice","prompt":"「shirt」的中文意思是哪一个？","choices":[{"key":"A","text":"短袜"},{"key":"B","text":"短裙"},{"key":"C","text":"衬衫"},{"key":"D","text":"毛衣"}],"answer":"C","explanation":"shirt 的意思是衬衫。","verify":"\"衬衫\""},{"id":"cne_j032_q3","topicId":"cne_j032","difficulty":"standard","type":"choice","prompt":"选择表示「短裙」的单词。","choices":[{"key":"A","text":"sock"},{"key":"B","text":"shirt"},{"key":"C","text":"sweater"},{"key":"D","text":"skirt"}],"answer":"D","explanation":"表示短裙的单词是 skirt。","verify":"\"skirt\""},{"id":"cne_j032_q4","topicId":"cne_j032","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「毛衣」？","choices":[{"key":"A","text":"sweater"},{"key":"B","text":"sock"},{"key":"C","text":"shirt"},{"key":"D","text":"skirt"}],"answer":"A","explanation":"sweater 的意思是毛衣。","verify":"\"sweater\""},{"id":"cne_j033_q1","topicId":"cne_j033","difficulty":"basic","type":"choice","prompt":"询问这双袜子多少钱，哪一句正确？","choices":[{"key":"A","text":"How much is these socks?"},{"key":"B","text":"How many are these socks?"},{"key":"C","text":"How much are these socks?"},{"key":"D","text":"How much these socks are?"}],"answer":"C","explanation":"socks 是复数，用 are；问价格用 How much。","verify":"\"How much are these socks?\""},{"id":"cne_j033_q2","topicId":"cne_j033","difficulty":"basic","type":"choice","prompt":"这件毛衣 20 美元。哪一句正确？","choices":[{"key":"A","text":"The sweater are 20 dollars."},{"key":"B","text":"The sweater is 20 dollar."},{"key":"C","text":"The sweater has 20 dollar."},{"key":"D","text":"The sweater is 20 dollars."}],"answer":"D","explanation":"价格里美元复数用 dollars，单数毛衣用 is。","verify":"\"The sweater is 20 dollars.\""},{"id":"cne_j033_q3","topicId":"cne_j033","difficulty":"standard","type":"choice","prompt":"How much is this shirt? 这句在问什么？","choices":[{"key":"A","text":"这件衬衫多少钱"},{"key":"B","text":"衬衫是什么颜色"},{"key":"C","text":"衬衫在哪里"},{"key":"D","text":"你有几件衬衫"}],"answer":"A","explanation":"How much 问价格。","verify":"\"这件衬衫多少钱\""},{"id":"cne_j033_q4","topicId":"cne_j033","difficulty":"standard","type":"choice","prompt":"短裙 15 美元。哪一句正确？","choices":[{"key":"A","text":"The skirt are fifteen dollars."},{"key":"B","text":"The skirt is fifteen dollars."},{"key":"C","text":"The skirt is fifteen dollar."},{"key":"D","text":"The skirts is fifteen dollars."}],"answer":"B","explanation":"一件短裙用 is，dollars 用复数。","verify":"\"The skirt is fifteen dollars.\""},{"id":"cne_j034_q1","topicId":"cne_j034","difficulty":"basic","type":"choice","prompt":"在商店想问毛衣的价格，哪一句合适？","choices":[{"key":"A","text":"How many is the sweater?"},{"key":"B","text":"What much is the sweater?"},{"key":"C","text":"How much the sweater is?"},{"key":"D","text":"How much is the sweater?"}],"answer":"D","explanation":"单数物品用 How much is。","verify":"\"How much is the sweater?\""},{"id":"cne_j034_q2","topicId":"cne_j034","difficulty":"basic","type":"choice","prompt":"店员说 It is 8 dollars. 你决定买下，哪一句合适？","choices":[{"key":"A","text":"I'll take it."},{"key":"B","text":"I take them are."},{"key":"C","text":"I'll taking it."},{"key":"D","text":"I am take it."}],"answer":"A","explanation":"I'll take it 表示我买下它。","verify":"\"I'll take it.\""},{"id":"cne_j034_q3","topicId":"cne_j034","difficulty":"standard","type":"choice","prompt":"想要一件红色的衬衫，哪一句合适？","choices":[{"key":"A","text":"I want a red shirts."},{"key":"B","text":"I want a red shirt."},{"key":"C","text":"I want red a shirt."},{"key":"D","text":"I wants a red shirt."}],"answer":"B","explanation":"a red shirt 是一件红色衬衫。","verify":"\"I want a red shirt.\""},{"id":"cne_j034_q4","topicId":"cne_j034","difficulty":"standard","type":"choice","prompt":"Can I help you? 店员这句是在做什么？","choices":[{"key":"A","text":"询问你的名字"},{"key":"B","text":"说衬衫很贵"},{"key":"C","text":"询问你需要什么帮助"},{"key":"D","text":"介绍自己的家人"}],"answer":"C","explanation":"Can I help you 是商店里的招呼。","verify":"\"询问你需要什么帮助\""},{"id":"cne_j035_q1","topicId":"cne_j035","difficulty":"basic","type":"choice","prompt":"Woman: How much is this skirt? Clerk: It is 15 dollars. Woman: I'll take it. 短裙多少钱？","choices":[{"key":"A","text":"15 美元"},{"key":"B","text":"8 美元"},{"key":"C","text":"20 美元"},{"key":"D","text":"50 美元"}],"answer":"A","explanation":"It is 15 dollars。","verify":"\"15 美元\""},{"id":"cne_j035_q2","topicId":"cne_j035","difficulty":"basic","type":"choice","prompt":"Woman: How much is this skirt? Clerk: It is 15 dollars. Woman: I'll take it. 她买了吗？","choices":[{"key":"A","text":"没买"},{"key":"B","text":"买了"},{"key":"C","text":"只问了颜色"},{"key":"D","text":"店员不卖"}],"answer":"B","explanation":"I'll take it 表示买下。","verify":"\"买了\""},{"id":"cne_j035_q3","topicId":"cne_j035","difficulty":"standard","type":"choice","prompt":"Boy: How much are the socks? Clerk: They are 5 dollars. Boy: They are too dear. I will not take them. 袜子贵不贵？按男孩的话。","choices":[{"key":"A","text":"他认为很便宜"},{"key":"B","text":"他马上买下"},{"key":"C","text":"他认为太贵"},{"key":"D","text":"短文没谈价格"}],"answer":"C","explanation":"too dear 是太贵，他不买。","verify":"\"他认为太贵\""},{"id":"cne_j035_q4","topicId":"cne_j035","difficulty":"standard","type":"choice","prompt":"选词填空：The sweater is 20 ___. I will take it. 哪个词使句子完整？","choices":[{"key":"A","text":"dollar"},{"key":"B","text":"much"},{"key":"C","text":"color"},{"key":"D","text":"dollars"}],"answer":"D","explanation":"20 后面用复数 dollars。","verify":"\"dollars\""},{"id":"cne_j036_q1","topicId":"cne_j036","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「一月」？","choices":[{"key":"A","text":"February"},{"key":"B","text":"January"},{"key":"C","text":"March"},{"key":"D","text":"April"}],"answer":"B","explanation":"January 的意思是一月。","verify":"\"January\""},{"id":"cne_j036_q2","topicId":"cne_j036","difficulty":"basic","type":"choice","prompt":"「February」的中文意思是哪一个？","choices":[{"key":"A","text":"一月"},{"key":"B","text":"三月"},{"key":"C","text":"二月"},{"key":"D","text":"四月"}],"answer":"C","explanation":"February 的意思是二月。","verify":"\"二月\""},{"id":"cne_j036_q3","topicId":"cne_j036","difficulty":"standard","type":"choice","prompt":"选择表示「三月」的单词。","choices":[{"key":"A","text":"January"},{"key":"B","text":"February"},{"key":"C","text":"April"},{"key":"D","text":"March"}],"answer":"D","explanation":"表示三月的单词是 March。","verify":"\"March\""},{"id":"cne_j036_q4","topicId":"cne_j036","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「四月」？","choices":[{"key":"A","text":"April"},{"key":"B","text":"January"},{"key":"C","text":"February"},{"key":"D","text":"March"}],"answer":"A","explanation":"April 的意思是四月。","verify":"\"April\""},{"id":"cne_j037_q1","topicId":"cne_j037","difficulty":"basic","type":"choice","prompt":"询问生日是哪一天，哪一句正确？","choices":[{"key":"A","text":"When your birthday is?"},{"key":"B","text":"What is your birthday?"},{"key":"C","text":"When is your birthday?"},{"key":"D","text":"When are your birthday?"}],"answer":"C","explanation":"When is your birthday 问日期。","verify":"\"When is your birthday?\""},{"id":"cne_j037_q2","topicId":"cne_j037","difficulty":"basic","type":"choice","prompt":"生日是 5 月 2 日。哪一句正确？","choices":[{"key":"A","text":"My birthday is on May two."},{"key":"B","text":"My birthday is in May 2nd."},{"key":"C","text":"My birthday are on May 2nd."},{"key":"D","text":"My birthday is on May 2nd."}],"answer":"D","explanation":"具体日期用 on，序数词用 2nd。","verify":"\"My birthday is on May 2nd.\""},{"id":"cne_j037_q3","topicId":"cne_j037","difficulty":"standard","type":"choice","prompt":"第一个月是哪一个？","choices":[{"key":"A","text":"January"},{"key":"B","text":"February"},{"key":"C","text":"March"},{"key":"D","text":"April"}],"answer":"A","explanation":"January 是一月。","verify":"\"January\""},{"id":"cne_j037_q4","topicId":"cne_j037","difficulty":"standard","type":"choice","prompt":"third 对应的基数词是哪一个？","choices":[{"key":"A","text":"thirdly"},{"key":"B","text":"three"},{"key":"C","text":"thirty"},{"key":"D","text":"thirteen"}],"answer":"B","explanation":"third 是第三，基数词是 three。","verify":"\"three\""},{"id":"cne_j038_q1","topicId":"cne_j038","difficulty":"basic","type":"choice","prompt":"想问对方的生日，哪一句合适？","choices":[{"key":"A","text":"Where is your birthday?"},{"key":"B","text":"When are your birthday?"},{"key":"C","text":"How much is your birthday?"},{"key":"D","text":"When is your birthday?"}],"answer":"D","explanation":"问日期用 When is your birthday。","verify":"\"When is your birthday?\""},{"id":"cne_j038_q2","topicId":"cne_j038","difficulty":"basic","type":"choice","prompt":"你的生日是 9 月 5 日，应回答什么？","choices":[{"key":"A","text":"It is on September 5th."},{"key":"B","text":"It is in September 5."},{"key":"C","text":"It is on September five."},{"key":"D","text":"It are on September 5th."}],"answer":"A","explanation":"具体日子用 on 加序数词。","verify":"\"It is on September 5th.\""},{"id":"cne_j038_q3","topicId":"cne_j038","difficulty":"standard","type":"choice","prompt":"How old are you? 这句在问什么？","choices":[{"key":"A","text":"你的生日是哪天"},{"key":"B","text":"你多大"},{"key":"C","text":"你叫什么"},{"key":"D","text":"你来自哪里"}],"answer":"B","explanation":"How old 问年龄。","verify":"\"你多大\""},{"id":"cne_j038_q4","topicId":"cne_j038","difficulty":"standard","type":"choice","prompt":"想说 Alice 十二岁，哪一句合适？","choices":[{"key":"A","text":"Alice are twelve."},{"key":"B","text":"Alice is twelfth."},{"key":"C","text":"Alice is twelve."},{"key":"D","text":"Alice has twelve."}],"answer":"C","explanation":"年龄用基数词 twelve，不是序数词 twelfth。","verify":"\"Alice is twelve.\""},{"id":"cne_j039_q1","topicId":"cne_j039","difficulty":"basic","type":"choice","prompt":"School Day is on September 21st. The basketball game is on October 2nd. 校庆是哪一天？","choices":[{"key":"A","text":"9 月 21 日"},{"key":"B","text":"10 月 2 日"},{"key":"C","text":"9 月 2 日"},{"key":"D","text":"10 月 21 日"}],"answer":"A","explanation":"School Day is on September 21st。","verify":"\"9 月 21 日\""},{"id":"cne_j039_q2","topicId":"cne_j039","difficulty":"basic","type":"choice","prompt":"School Day is on September 21st. The basketball game is on October 2nd. 篮球赛在哪一天？","choices":[{"key":"A","text":"9 月 21 日"},{"key":"B","text":"10 月 2 日"},{"key":"C","text":"10 月 21 日"},{"key":"D","text":"11 月 2 日"}],"answer":"B","explanation":"October 2nd 是 10 月 2 日。","verify":"\"10 月 2 日\""},{"id":"cne_j039_q3","topicId":"cne_j039","difficulty":"standard","type":"choice","prompt":"Alice's birthday party is on May 5th. She is twelve. 聚会在几月？","choices":[{"key":"A","text":"四月"},{"key":"B","text":"六月"},{"key":"C","text":"五月"},{"key":"D","text":"三月"}],"answer":"C","explanation":"May 是五月。","verify":"\"五月\""},{"id":"cne_j039_q4","topicId":"cne_j039","difficulty":"standard","type":"choice","prompt":"Alice's birthday party is on May 5th. She is twelve. 哪一句和短文一致？","choices":[{"key":"A","text":"Alice is five."},{"key":"B","text":"The party is in May 5th without on."},{"key":"C","text":"Alice is twenty."},{"key":"D","text":"Alice is twelve."}],"answer":"D","explanation":"She is twelve。年龄是十二，不是五岁或二十岁。","verify":"\"Alice is twelve.\""}]
