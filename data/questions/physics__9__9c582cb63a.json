[{"id":"cnp_082_q1","topicId":"cnp_082","difficulty":"basic","type":"choice","prompt":"首先发现电流周围存在磁场的科学家是谁？","choices":[{"key":"A","text":"法拉第"},{"key":"B","text":"牛顿"},{"key":"C","text":"欧姆"},{"key":"D","text":"奥斯特"}],"answer":"D","explanation":"1820 年奥斯特发现通电导线能使小磁针偏转；法拉第发现了电磁感应。","verify":"\"奥斯特\""},{"id":"cnp_082_q2","topicId":"cnp_082","difficulty":"basic","type":"choice","prompt":"通电螺线管外部的磁场与哪种磁体的磁场相似？","choices":[{"key":"A","text":"蹄形磁体"},{"key":"B","text":"条形磁体"},{"key":"C","text":"环形磁体"},{"key":"D","text":"没有磁场"}],"answer":"B","explanation":"通电螺线管外部磁场和条形磁体相似，两端是 N、S 极。","verify":"\"条形磁体\""},{"id":"cnp_082_q3","topicId":"cnp_082","difficulty":"standard","type":"choice","prompt":"安培定则：用右手握住螺线管，让四指指向螺线管中电流的方向，则什么所指的那端是 N 极？","choices":[{"key":"A","text":"食指"},{"key":"B","text":"小指"},{"key":"C","text":"手腕"},{"key":"D","text":"大拇指"}],"answer":"D","explanation":"右手握住螺线管，四指指向电流方向，大拇指所指那端是 N 极。","verify":"\"大拇指\""},{"id":"cnp_082_q4","topicId":"cnp_082","difficulty":"standard","type":"choice","prompt":"改变通电螺线管中的电流方向，它的磁极会怎样？","choices":[{"key":"A","text":"不变"},{"key":"B","text":"N、S 极对调"},{"key":"C","text":"磁性消失"},{"key":"D","text":"磁性增强"}],"answer":"B","explanation":"螺线管磁极与电流方向有关，电流方向改变磁极对调。","verify":"\"N、S 极对调\""}]
