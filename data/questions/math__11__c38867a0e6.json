[{"id":"cnm_h081_q1","topicId":"cnm_h081","difficulty":"basic","type":"numeric","prompt":"向量 (1，2) 与 (3，4) 的和的横坐标是多少？","answer":"4","explanation":"坐标分别相加，横坐标 1+3=4。","verify":"1+3"},{"id":"cnm_h081_q2","topicId":"cnm_h081","difficulty":"basic","type":"numeric","prompt":"向量 (1，2) 与 (3，4) 的和的纵坐标是多少？","answer":"6","explanation":"坐标分别相加，纵坐标 2+4=6。","verify":"2+4"},{"id":"cnm_h081_q3","topicId":"cnm_h081","difficulty":"standard","type":"numeric","prompt":"向量 (5，−1) 与 (−2，1) 的和的横坐标是多少？","answer":"3","explanation":"5−2=3。","verify":"5+(-2)"},{"id":"cnm_h081_q4","topicId":"cnm_h081","difficulty":"standard","type":"choice","prompt":"向量加法可以用？","choices":[{"key":"A","text":"只把长度相加、不管方向"},{"key":"B","text":"三角形法则或平行四边形法则"},{"key":"C","text":"只能用坐标、不能作图"},{"key":"D","text":"必须先取数量积"}],"answer":"B","explanation":"首尾相接是三角形法则，共起点作平行四边形也可以。","verify":"\"三角形法则或平行四边形法则\""},{"id":"cnm_h082_q1","topicId":"cnm_h082","difficulty":"basic","type":"numeric","prompt":"向量 (5，1) 减去 (2，3)，差的横坐标是多少？","answer":"3","explanation":"坐标分别相减，5−2=3。","verify":"5-2"},{"id":"cnm_h082_q2","topicId":"cnm_h082","difficulty":"basic","type":"numeric","prompt":"上一问里差的纵坐标是多少？","answer":"-2","explanation":"1−3=−2。","verify":"1-3"},{"id":"cnm_h082_q3","topicId":"cnm_h082","difficulty":"standard","type":"numeric","prompt":"a=(4，4)，求 a−a 的模。","answer":"0","explanation":"任何向量减自身都是零向量，模是 0。","verify":"0"},{"id":"cnm_h082_q4","topicId":"cnm_h082","difficulty":"standard","type":"choice","prompt":"a−b 等于？","choices":[{"key":"A","text":"a 的模减去 b 的模"},{"key":"B","text":"只改变 a 的方向"},{"key":"C","text":"a 加上 b 的相反向量"},{"key":"D","text":"a 与 b 的数量积"}],"answer":"C","explanation":"减法定义为加上相反向量，不是长度直接相减。","verify":"\"a 加上 b 的相反向量\""},{"id":"cnm_h083_q1","topicId":"cnm_h083","difficulty":"basic","type":"numeric","prompt":"3 乘以向量 (1，−2)，纵坐标是多少？","answer":"-6","explanation":"每个坐标都乘 3，纵坐标是 −6。","verify":"3*(-2)"},{"id":"cnm_h083_q2","topicId":"cnm_h083","difficulty":"basic","type":"numeric","prompt":"向量 (3，4) 的模是 5。2 倍这个向量的模是多少？","answer":"10","explanation":"正数倍之后，模乘这个正数，2×5=10。","verify":"2*5"},{"id":"cnm_h083_q3","topicId":"cnm_h083","difficulty":"standard","type":"numeric","prompt":"−1 乘以向量 (2，−5) 的横坐标是多少？","answer":"-2","explanation":"相反向量的横坐标是 −2。","verify":"-1*2"},{"id":"cnm_h083_q4","topicId":"cnm_h083","difficulty":"standard","type":"choice","prompt":"实数 k<0 时，k 倍非零向量的方向？","choices":[{"key":"A","text":"与原向量相同"},{"key":"B","text":"变成零向量"},{"key":"C","text":"与原向量垂直"},{"key":"D","text":"与原向量相反"}],"answer":"D","explanation":"负数倍把方向改成相反方向，模乘 |k|。","verify":"\"与原向量相反\""},{"id":"cnm_h084_q1","topicId":"cnm_h084","difficulty":"basic","type":"numeric","prompt":"向量 (2，4) 是 (1，2) 的多少倍？","answer":"2","explanation":"2×(1，2)=(2，4)，倍数是 2，所以共线。","verify":"2"},{"id":"cnm_h084_q2","topicId":"cnm_h084","difficulty":"basic","type":"numeric","prompt":"若 (k，6) 与 (2，3) 共线，且由第二坐标得 k/2=6/3。k 是多少？","answer":"4","explanation":"对应坐标成比例，k/2=2，k=4。","verify":"2*(6/3)"},{"id":"cnm_h084_q3","topicId":"cnm_h084","difficulty":"standard","type":"choice","prompt":"(1，0) 与 (0，1) 是否共线？","choices":[{"key":"A","text":"共线"},{"key":"B","text":"只有在起点相同时共线"},{"key":"C","text":"方向相反所以共线"},{"key":"D","text":"不共线"}],"answer":"D","explanation":"不存在实数 λ 使 (0，1)=λ(1，0)，因为第一坐标会迫使 λ=0，第二坐标却是 1。","verify":"\"不共线\""},{"id":"cnm_h084_q4","topicId":"cnm_h084","difficulty":"standard","type":"choice","prompt":"零向量与任意向量的位置关系按共线定义？","choices":[{"key":"A","text":"零向量与任意向量共线"},{"key":"B","text":"只与零向量共线"},{"key":"C","text":"与任意向量垂直"},{"key":"D","text":"不能讨论"}],"answer":"A","explanation":"取 λ=0 就有 0=λa。教材把零向量看作与任意向量共线。","verify":"\"零向量与任意向量共线\""}]
