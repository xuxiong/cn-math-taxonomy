[{"id":"cne_p014_q1","topicId":"cne_p014","difficulty":"basic","type":"choice","prompt":"指着近处的钢笔，哪一句是对的？","choices":[{"key":"A","text":"These is a pen."},{"key":"B","text":"This are a pen."},{"key":"C","text":"This be a pen."},{"key":"D","text":"This is a pen."}],"answer":"D","explanation":"近处的一件物品说 This is。","verify":"\"This is a pen.\""},{"id":"cne_p014_q2","topicId":"cne_p014","difficulty":"basic","type":"choice","prompt":"指着远处的尺子，哪一句是对的？","choices":[{"key":"A","text":"That is a ruler."},{"key":"B","text":"This are a ruler."},{"key":"C","text":"That am a ruler."},{"key":"D","text":"That be a ruler."}],"answer":"A","explanation":"远处的一件物品说 That is。","verify":"\"That is a ruler.\""},{"id":"cne_p014_q3","topicId":"cne_p014","difficulty":"standard","type":"choice","prompt":"This is my nose. 这句里的 This 用来指什么？","choices":[{"key":"A","text":"远处的那一个"},{"key":"B","text":"近处的这一个"},{"key":"C","text":"好几个"},{"key":"D","text":"过去的一个"}],"answer":"B","explanation":"This 指近处。","verify":"\"近处的这一个\""},{"id":"cne_p014_q4","topicId":"cne_p014","difficulty":"standard","type":"choice","prompt":"That is a cat. 这句里的 That 用来指什么？","choices":[{"key":"A","text":"近处的这一个"},{"key":"B","text":"许多个"},{"key":"C","text":"远处的那一个"},{"key":"D","text":"自己的名字"}],"answer":"C","explanation":"That 指远处。","verify":"\"远处的那一个\""},{"id":"cne_p035_q1","topicId":"cne_p035","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「爸爸」？","choices":[{"key":"A","text":"father"},{"key":"B","text":"mother"},{"key":"C","text":"brother"},{"key":"D","text":"sister"}],"answer":"A","explanation":"father 的意思是爸爸。","verify":"\"father\""},{"id":"cne_p035_q2","topicId":"cne_p035","difficulty":"basic","type":"choice","prompt":"「mother」的中文意思是哪一个？","choices":[{"key":"A","text":"爸爸"},{"key":"B","text":"妈妈"},{"key":"C","text":"哥哥或弟弟"},{"key":"D","text":"姐姐或妹妹"}],"answer":"B","explanation":"mother 的意思是妈妈。","verify":"\"妈妈\""},{"id":"cne_p035_q3","topicId":"cne_p035","difficulty":"standard","type":"choice","prompt":"选择表示「哥哥或弟弟」的单词。","choices":[{"key":"A","text":"father"},{"key":"B","text":"mother"},{"key":"C","text":"brother"},{"key":"D","text":"sister"}],"answer":"C","explanation":"表示哥哥或弟弟的单词是 brother。","verify":"\"brother\""},{"id":"cne_p035_q4","topicId":"cne_p035","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「姐姐或妹妹」？","choices":[{"key":"A","text":"father"},{"key":"B","text":"mother"},{"key":"C","text":"brother"},{"key":"D","text":"sister"}],"answer":"D","explanation":"sister 的意思是姐姐或妹妹。","verify":"\"sister\""},{"id":"cne_p036_q1","topicId":"cne_p036","difficulty":"basic","type":"choice","prompt":"问「他是谁」，应选哪一句？","choices":[{"key":"A","text":"Who are he?"},{"key":"B","text":"Who is he?"},{"key":"C","text":"Who he is name?"},{"key":"D","text":"What is he who?"}],"answer":"B","explanation":"问男性是谁说 Who is he?","verify":"\"Who is he?\""},{"id":"cne_p036_q2","topicId":"cne_p036","difficulty":"basic","type":"choice","prompt":"Who is she? 这句是在问什么？","choices":[{"key":"A","text":"她在哪里"},{"key":"B","text":"她几岁"},{"key":"C","text":"她是谁"},{"key":"D","text":"她喜欢什么"}],"answer":"C","explanation":"Who is she 问她是谁。","verify":"\"她是谁\""},{"id":"cne_p036_q3","topicId":"cne_p036","difficulty":"standard","type":"choice","prompt":"He ____ my father. 横线上应填哪个词？","choices":[{"key":"A","text":"am"},{"key":"B","text":"are"},{"key":"C","text":"be"},{"key":"D","text":"is"}],"answer":"D","explanation":"He 和 is 搭配。","verify":"\"is\""},{"id":"cne_p036_q4","topicId":"cne_p036","difficulty":"standard","type":"choice","prompt":"哪一句是正确的？","choices":[{"key":"A","text":"She is my mother."},{"key":"B","text":"She are my mother."},{"key":"C","text":"She am my mother."},{"key":"D","text":"She be my mother."}],"answer":"A","explanation":"She 后面用 is。","verify":"\"She is my mother.\""},{"id":"cne_p037_q1","topicId":"cne_p037","difficulty":"basic","type":"choice","prompt":"介绍自己的爸爸，应说哪一句？","choices":[{"key":"A","text":"This is my mother."},{"key":"B","text":"This is my sister."},{"key":"C","text":"This is my father."},{"key":"D","text":"This is my brother."}],"answer":"C","explanation":"爸爸是 father。","verify":"\"This is my father.\""},{"id":"cne_p037_q2","topicId":"cne_p037","difficulty":"basic","type":"choice","prompt":"This is my sister. 这是谁？","choices":[{"key":"A","text":"爸爸"},{"key":"B","text":"妈妈"},{"key":"C","text":"哥哥或弟弟"},{"key":"D","text":"姐姐或妹妹"}],"answer":"D","explanation":"sister 是姐姐或妹妹。","verify":"\"姐姐或妹妹\""},{"id":"cne_p037_q3","topicId":"cne_p037","difficulty":"standard","type":"choice","prompt":"Who is he? 若他是哥哥，应回答哪一句？","choices":[{"key":"A","text":"He is my brother."},{"key":"B","text":"She is my sister."},{"key":"C","text":"She is my mother."},{"key":"D","text":"He is my father."}],"answer":"A","explanation":"哥哥说 He is my brother。","verify":"\"He is my brother.\""},{"id":"cne_p037_q4","topicId":"cne_p037","difficulty":"standard","type":"choice","prompt":"This is my family. 这句的意思是？","choices":[{"key":"A","text":"这是我的朋友"},{"key":"B","text":"这是我的家庭"},{"key":"C","text":"这是我的学校"},{"key":"D","text":"这是我的书"}],"answer":"B","explanation":"family 是家庭。","verify":"\"这是我的家庭\""},{"id":"cne_p038_q1","topicId":"cne_p038","difficulty":"basic","type":"choice","prompt":"读一读：This is my father. He is from China. 这是谁？","choices":[{"key":"A","text":"妈妈"},{"key":"B","text":"姐姐或妹妹"},{"key":"C","text":"朋友"},{"key":"D","text":"爸爸"}],"answer":"D","explanation":"father 是爸爸。","verify":"\"爸爸\""},{"id":"cne_p038_q2","topicId":"cne_p038","difficulty":"basic","type":"choice","prompt":"读一读：She is my mother. 哪一句和文字一致？","choices":[{"key":"A","text":"她是我的妈妈。"},{"key":"B","text":"他是我的爸爸。"},{"key":"C","text":"她是我的姐姐。"},{"key":"D","text":"他是我的弟弟。"}],"answer":"A","explanation":"She is my mother 是妈妈。","verify":"\"她是我的妈妈。\""},{"id":"cne_p038_q3","topicId":"cne_p038","difficulty":"standard","type":"choice","prompt":"读一读：This is my brother. He is ten. 弟弟或哥哥几岁？","choices":[{"key":"A","text":"6 岁"},{"key":"B","text":"10 岁"},{"key":"C","text":"9 岁"},{"key":"D","text":"8 岁"}],"answer":"B","explanation":"He is ten 是 10 岁。","verify":"\"10 岁\""},{"id":"cne_p038_q4","topicId":"cne_p038","difficulty":"standard","type":"choice","prompt":"读一读：Sarah says, \"This is my sister.\" 哪一句是对的？","choices":[{"key":"A","text":"Sarah 在介绍爸爸。"},{"key":"B","text":"Sarah 在介绍妈妈。"},{"key":"C","text":"Sarah 在介绍姐姐或妹妹。"},{"key":"D","text":"Sarah 在介绍老师。"}],"answer":"C","explanation":"sister 是姐姐或妹妹。","verify":"\"Sarah 在介绍姐姐或妹妹。\""}]
