[{"id":"cnc_p085_q1","topicId":"cnc_p085","difficulty":"basic","type":"choice","prompt":"「一艘军舰」旁边配的是哪一个？","choices":[{"key":"A","text":"一条帆船"},{"key":"B","text":"一方鱼塘"},{"key":"C","text":"一处港湾"},{"key":"D","text":"一群飞鸟"}],"answer":"C","explanation":"一只海鸥，一条帆船。一艘军舰，一处港湾。帆船不跟军舰配在一起。","verify":"\"一处港湾\""},{"id":"cnc_p085_q2","topicId":"cnc_p085","difficulty":"basic","type":"choice","prompt":"「一只海鸥」旁边配的是哪一个？","choices":[{"key":"A","text":"一处港湾"},{"key":"B","text":"一片沙滩"},{"key":"C","text":"一座石桥"},{"key":"D","text":"一条帆船"}],"answer":"D","explanation":"海鸥和帆船写在一起。港湾配军舰，石桥配小溪。","verify":"\"一条帆船\""},{"id":"cnc_p085_q3","topicId":"cnc_p085","difficulty":"standard","type":"choice","prompt":"课文里，石桥前面用的量词是哪一个？","choices":[{"key":"A","text":"一座"},{"key":"B","text":"一孔"},{"key":"C","text":"一条"},{"key":"D","text":"一方"}],"answer":"A","explanation":"一道小溪，一座石桥。鱼塘才用「一方」。","verify":"\"一座\""},{"id":"cnc_p085_q4","topicId":"cnc_p085","difficulty":"standard","type":"choice","prompt":"哪一组和课文的量词一致？","choices":[{"key":"A","text":"一孔石桥，一条海鸥"},{"key":"B","text":"一丛翠竹，一群飞鸟"},{"key":"C","text":"一艘翠竹，一只港湾"},{"key":"D","text":"一片沙滩，一条军舰"}],"answer":"B","explanation":"翠竹是一丛，飞鸟是一群。船才用艘，军舰也用艘。","verify":"\"一丛翠竹，一群飞鸟\""},{"id":"cnc_p086_q1","topicId":"cnc_p086","difficulty":"basic","type":"choice","prompt":"梧桐的叶子像什么？","choices":[{"key":"A","text":"一把伞"},{"key":"B","text":"一根针"},{"key":"C","text":"圆圆的饼"},{"key":"D","text":"手掌"}],"answer":"D","explanation":"课文说梧桐树叶像手掌。","verify":"\"手掌\""},{"id":"cnc_p086_q2","topicId":"cnc_p086","difficulty":"basic","type":"choice","prompt":"秋天叶子变红的是哪一种树？","choices":[{"key":"A","text":"枫树"},{"key":"B","text":"松柏"},{"key":"C","text":"榕树"},{"key":"D","text":"银杏水杉"}],"answer":"A","explanation":"枫树秋天叶儿红。松柏是四季披绿装。","verify":"\"枫树\""},{"id":"cnc_p086_q3","topicId":"cnc_p086","difficulty":"standard","type":"choice","prompt":"哪种树四季都披着绿装？","choices":[{"key":"A","text":"枫树"},{"key":"B","text":"松柏"},{"key":"C","text":"梧桐"},{"key":"D","text":"木棉"}],"answer":"B","explanation":"松柏四季披绿装。枫树到了秋天会变红。","verify":"\"松柏\""},{"id":"cnc_p086_q4","topicId":"cnc_p086","difficulty":"standard","type":"choice","prompt":"「木棉喜暖在南方，桦树耐寒守北疆」是在说什么？","choices":[{"key":"A","text":"两种树都长在北方"},{"key":"B","text":"木棉最怕热"},{"key":"C","text":"不同的树适合不同的地方"},{"key":"D","text":"桦树只能长在南方"}],"answer":"C","explanation":"木棉喜欢温暖的南方，桦树耐寒，守在北方。","verify":"\"不同的树适合不同的地方\""},{"id":"cnc_p087_q1","topicId":"cnc_p087","difficulty":"basic","type":"choice","prompt":"「你拍二，我拍二」后面说的是什么？","choices":[{"key":"A","text":"孔雀锦鸡是伙伴"},{"key":"B","text":"竹林熊猫在嬉戏"},{"key":"C","text":"天空雁群会写字"},{"key":"D","text":"保护动物是大事"}],"answer":"A","explanation":"拍二写孔雀和锦鸡。熊猫是拍七，雁群是拍四。","verify":"\"孔雀锦鸡是伙伴\""},{"id":"cnc_p087_q2","topicId":"cnc_p087","difficulty":"basic","type":"choice","prompt":"「天空雁群会写字」在哪一句里？","choices":[{"key":"A","text":"你拍一，我拍一"},{"key":"B","text":"你拍四，我拍四"},{"key":"C","text":"你拍六，我拍六"},{"key":"D","text":"你拍十，我拍十"}],"answer":"B","explanation":"拍四写雁群。拍六是黄鹂百灵唱不休，拍十是保护动物。","verify":"\"你拍四，我拍四\""},{"id":"cnc_p087_q3","topicId":"cnc_p087","difficulty":"standard","type":"choice","prompt":"熊猫在课文里做什么？","choices":[{"key":"A","text":"在云彩间飞翔"},{"key":"B","text":"在丛林里当猛虎"},{"key":"C","text":"在竹林里嬉戏"},{"key":"D","text":"在海上开军舰"}],"answer":"C","explanation":"你拍七，我拍七，竹林熊猫在嬉戏。飞翔的是雄鹰。","verify":"\"在竹林里嬉戏\""},{"id":"cnc_p087_q4","topicId":"cnc_p087","difficulty":"standard","type":"choice","prompt":"课文最后要大家怎样对待动物？","choices":[{"key":"A","text":"把动物都关进笼子"},{"key":"B","text":"只保护锦鸡一种"},{"key":"C","text":"动物没有家也没关系"},{"key":"D","text":"保护动物是大事，人和动物是朋友"}],"answer":"D","explanation":"拍九说人和动物是朋友，拍十说保护动物是大事。拍八还说大小动物都有家。","verify":"\"保护动物是大事，人和动物是朋友\""},{"id":"cnc_p088_q1","topicId":"cnc_p088","difficulty":"basic","type":"choice","prompt":"春季里，课文写了哪些景象？","choices":[{"key":"A","text":"稻上场，谷像黄金"},{"key":"B","text":"春风吹，花开草长蝴蝶飞，麦苗嫩，桑叶肥"},{"key":"C","text":"雪初晴，穿上新棉衣"},{"key":"D","text":"采桑养蚕又插秧"}],"answer":"B","explanation":"春季是花开、草长、蝴蝶飞。稻谷是秋季，采桑养蚕、插秧是夏季。","verify":"\"春风吹，花开草长蝴蝶飞，麦苗嫩，桑叶肥\""},{"id":"cnc_p088_q2","topicId":"cnc_p088","difficulty":"basic","type":"choice","prompt":"「早起勤耕作，归来戴月光」写的是哪个季节？","choices":[{"key":"A","text":"春季"},{"key":"B","text":"秋季"},{"key":"C","text":"夏季"},{"key":"D","text":"冬季"}],"answer":"C","explanation":"夏季农事忙，采桑养蚕又插秧，早出晚归，所以戴着月光回来。","verify":"\"夏季\""},{"id":"cnc_p088_q3","topicId":"cnc_p088","difficulty":"standard","type":"choice","prompt":"秋季里，谷子被比作什么？农民心情怎样？","choices":[{"key":"A","text":"像雪花，大家很害怕"},{"key":"B","text":"像柳叶，所以不出门"},{"key":"C","text":"像棉衣，所以不再收稻"},{"key":"D","text":"像黄金，身体虽辛苦，心里喜洋洋"}],"answer":"D","explanation":"稻上场，谷像黄金粒粒香。辛苦和喜洋洋写在一起。","verify":"\"像黄金，身体虽辛苦，心里喜洋洋\""},{"id":"cnc_p088_q4","topicId":"cnc_p088","difficulty":"standard","type":"choice","prompt":"冬季里，一年的农事做完了，大家怎样？","choices":[{"key":"A","text":"雪初晴，穿上新棉衣，笑盈盈"},{"key":"B","text":"还在插秧，不能休息"},{"key":"C","text":"花刚开，蝴蝶正飞"},{"key":"D","text":"麦苗还很嫩，桑叶正肥"}],"answer":"A","explanation":"冬季雪初晴，新制棉衣暖又轻。一年农事了，大家笑盈盈。","verify":"\"雪初晴，穿上新棉衣，笑盈盈\""},{"id":"cnc_p089_q1","topicId":"cnc_p089","difficulty":"basic","type":"choice","prompt":"「高」说的是个子时，反义词是哪一个？","choices":[{"key":"A","text":"低一点"},{"key":"B","text":"长"},{"key":"C","text":"矮"},{"key":"D","text":"大"}],"answer":"C","explanation":"高和矮相反。长的反义词是短，大的反义词是小。","verify":"\"矮\""},{"id":"cnc_p089_q2","topicId":"cnc_p089","difficulty":"basic","type":"choice","prompt":"「早」的反义词是哪一个？","choices":[{"key":"A","text":"迟些"},{"key":"B","text":"快"},{"key":"C","text":"远"},{"key":"D","text":"晚"}],"answer":"D","explanation":"早和晚相反。快的反义词是慢。","verify":"\"晚\""},{"id":"cnc_p089_q3","topicId":"cnc_p089","difficulty":"standard","type":"choice","prompt":"「笑」的反义词是哪一个？","choices":[{"key":"A","text":"哭"},{"key":"B","text":"高兴"},{"key":"C","text":"喊"},{"key":"D","text":"唱"}],"answer":"A","explanation":"笑和哭的意思相反。高兴和笑意思接近，不是反义词。","verify":"\"哭\""},{"id":"cnc_p089_q4","topicId":"cnc_p089","difficulty":"standard","type":"choice","prompt":"哪一组是反义词？","choices":[{"key":"A","text":"冷—凉"},{"key":"B","text":"冷—热"},{"key":"C","text":"开—张开"},{"key":"D","text":"看—瞧"}],"answer":"B","explanation":"冷和热相反。凉和冷意思接近，看和瞧是近义词。","verify":"\"冷—热\""},{"id":"cnc_p090_q1","topicId":"cnc_p090","difficulty":"basic","type":"choice","prompt":"「树、林、枝」共有的偏旁是哪一个？","choices":[{"key":"A","text":"草字头"},{"key":"B","text":"三点水"},{"key":"C","text":"口字旁"},{"key":"D","text":"木字旁"}],"answer":"D","explanation":"树、林、枝都和树木有关，偏旁是木。","verify":"\"木字旁\""},{"id":"cnc_p090_q2","topicId":"cnc_p090","difficulty":"basic","type":"choice","prompt":"「花、草、苗」共有的偏旁是哪一个？","choices":[{"key":"A","text":"草字头"},{"key":"B","text":"木字旁"},{"key":"C","text":"竹字头"},{"key":"D","text":"宝盖头"}],"answer":"A","explanation":"花、草、苗都和植物有关，上面是草字头。","verify":"\"草字头\""},{"id":"cnc_p090_q3","topicId":"cnc_p090","difficulty":"standard","type":"choice","prompt":"「河、湖、海」应该归到哪一类？","choices":[{"key":"A","text":"火字旁"},{"key":"B","text":"三点水"},{"key":"C","text":"提手旁"},{"key":"D","text":"女字旁"}],"answer":"B","explanation":"河、湖、海都和水有关，偏旁是三点水。","verify":"\"三点水\""},{"id":"cnc_p090_q4","topicId":"cnc_p090","difficulty":"standard","type":"choice","prompt":"「跑、跳、跃」共有的偏旁是哪一个？","choices":[{"key":"A","text":"走之底"},{"key":"B","text":"提手旁"},{"key":"C","text":"足字旁"},{"key":"D","text":"单人旁"}],"answer":"C","explanation":"跑、跳、跃都和脚的动作有关，是足字旁。","verify":"\"足字旁\""}]
