[{"id":"cnm_120_q1","topicId":"cnm_120","difficulty":"basic","type":"choice","prompt":"△ABC≌△DEF，则点 A 的对应点是？","answer":"A","choices":[{"key":"A","text":"D"},{"key":"B","text":"E"},{"key":"C","text":"F"},{"key":"D","text":"无法确定"}],"explanation":"全等式中字母按对应顶点顺序书写，A 与 D 对应。"},{"id":"cnm_120_q2","topicId":"cnm_120","difficulty":"basic","type":"choice","prompt":"下列说法正确的是：","answer":"C","choices":[{"key":"A","text":"面积相等的两个三角形全等"},{"key":"B","text":"周长相等的两个三角形全等"},{"key":"C","text":"能够完全重合的两个图形全等"},{"key":"D","text":"形状相同的两个图形全等"}],"explanation":"全等图形的定义就是能够完全重合的图形；面积或周长相等、形状相同都不能保证完全重合。"},{"id":"cnm_120_q3","topicId":"cnm_120","difficulty":"standard","type":"choice","prompt":"△ABC≌△CDE，则 AB 的对应边是：","answer":"B","choices":[{"key":"A","text":"DE"},{"key":"B","text":"CD"},{"key":"C","text":"CE"}],"explanation":"对应顶点：A↔C，B↔D，C↔E，所以 AB 的对应边是 CD。"},{"id":"cnm_120_q4","topicId":"cnm_120","difficulty":"advanced","type":"short","prompt":"△ABC 与 △DEF 全等，且 ∠A=∠E，∠B=∠D，∠C=∠F。按对应顶点顺序写全等式：△ABC≌△___（填三个字母）","answer":"△EDF","explanation":"A 对应 E，B 对应 D，C 对应 F，所以 △ABC≌△EDF。","accept":["EDF","△EDF"]},{"id":"cnm_121_q1","topicId":"cnm_121","difficulty":"basic","type":"numeric","prompt":"△ABC≌△DEF，AB=5，DE 多长？（顶点按 A↔D，B↔E，C↔F 对应）","answer":"5","explanation":"全等三角形对应边相等，AB 与 DE 是对应边，DE=AB=5。","verify":"5"},{"id":"cnm_121_q2","topicId":"cnm_121","difficulty":"basic","type":"numeric","prompt":"△ABC≌△DEF，∠B=70°，则 ∠E 是多少度？","answer":"70","explanation":"∠B 与 ∠E 是对应角，全等三角形对应角相等。"},{"id":"cnm_121_q3","topicId":"cnm_121","difficulty":"standard","type":"numeric","prompt":"△ABC≌△DEF，∠A=40°，∠E=60°，求 ∠C 的度数。","answer":"80","explanation":"∠B=∠E=60°，所以 ∠C=180°-40°-60°=80°。","verify":"180-40-60"},{"id":"cnm_121_q4","topicId":"cnm_121","difficulty":"standard","type":"numeric","prompt":"△ABC≌△DEF，AB=3，BC=4，△DEF 的周长为 12，求 AC 的长。","answer":"5","explanation":"全等三角形周长相等，△ABC 周长为 12，AC=12-3-4=5。","verify":"12-3-4"},{"id":"cnm_121_q5","topicId":"cnm_121","difficulty":"advanced","type":"numeric","prompt":"△ABC≌△DEF，AB=2x+1，DE=4x-7，求 x 的值。","answer":"4","explanation":"AB 与 DE 是对应边，相等：2x+1=4x-7，解得 x=4。","verify":"Fraction(1+7,4-2)"}]
