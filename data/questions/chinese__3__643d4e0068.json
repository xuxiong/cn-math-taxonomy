[{"id":"cnc_p200_q1","topicId":"cnc_p200","difficulty":"basic","type":"choice","prompt":"「迟日江山丽」的下一句是哪一句？","choices":[{"key":"A","text":"泥融飞燕子"},{"key":"B","text":"春风花草香"},{"key":"C","text":"沙暖睡鸳鸯"},{"key":"D","text":"两个黄鹂鸣翠柳"}],"answer":"B","explanation":"迟日江山丽，春风花草香。泥融、沙暖是后两句。两个黄鹂是另一首《绝句》。","verify":"\"春风花草香\""},{"id":"cnc_p200_q2","topicId":"cnc_p200","difficulty":"basic","type":"choice","prompt":"「泥融飞燕子」的下一句是哪一句？","choices":[{"key":"A","text":"春风花草香"},{"key":"B","text":"一行白鹭上青天"},{"key":"C","text":"沙暖睡鸳鸯"},{"key":"D","text":"窗含西岭千秋雪"}],"answer":"C","explanation":"泥土化开，燕子飞来；沙子变暖，鸳鸯在睡觉。","verify":"\"沙暖睡鸳鸯\""},{"id":"cnc_p200_q3","topicId":"cnc_p200","difficulty":"standard","type":"choice","prompt":"「迟日江山丽」这首《绝句》的作者是谁？","choices":[{"key":"A","text":"杜牧"},{"key":"B","text":"李白"},{"key":"C","text":"苏轼"},{"key":"D","text":"杜甫"}],"answer":"D","explanation":"两首都叫《绝句》的诗都是杜甫写的。杜牧写的是《山行》和《清明》。","verify":"\"杜甫\""},{"id":"cnc_p200_q4","topicId":"cnc_p200","difficulty":"standard","type":"choice","prompt":"哪一句属于这首五言《绝句》，而不属于「两个黄鹂」那首？","choices":[{"key":"A","text":"沙暖睡鸳鸯"},{"key":"B","text":"一行白鹭上青天"},{"key":"C","text":"门泊东吴万里船"},{"key":"D","text":"窗含西岭千秋雪"}],"answer":"A","explanation":"沙暖睡鸳鸯和迟日江山丽是同一首。白鹭、万里船、千秋雪都在七言那首里。","verify":"\"沙暖睡鸳鸯\""},{"id":"cnc_p201_q1","topicId":"cnc_p201","difficulty":"basic","type":"choice","prompt":"「竹外桃花三两枝」的下一句是哪一句？","choices":[{"key":"A","text":"蒌蒿满地芦芽短"},{"key":"B","text":"正是河豚欲上时"},{"key":"C","text":"春江水暖鸭先知"},{"key":"D","text":"春江水暖鹅先知"}],"answer":"C","explanation":"先写鸭子知道江水暖了。蒌蒿、河豚是后两句。是鸭，不是鹅。","verify":"\"春江水暖鸭先知\""},{"id":"cnc_p201_q2","topicId":"cnc_p201","difficulty":"basic","type":"choice","prompt":"「蒌蒿满地芦芽短」的下一句是哪一句？","choices":[{"key":"A","text":"春江水暖鸭先知"},{"key":"B","text":"竹外桃花三两枝"},{"key":"C","text":"正是河豚欲下时"},{"key":"D","text":"正是河豚欲上时"}],"answer":"D","explanation":"蒌蒿长满地，芦芽还短，这正是河豚要逆流而上的时候。","verify":"\"正是河豚欲上时\""},{"id":"cnc_p201_q3","topicId":"cnc_p201","difficulty":"standard","type":"choice","prompt":"这首诗的作者是谁？","choices":[{"key":"A","text":"苏轼"},{"key":"B","text":"惠崇"},{"key":"C","text":"杜甫"},{"key":"D","text":"杜牧"}],"answer":"A","explanation":"惠崇是画画的人。给这幅《春江晚景》题诗的是苏轼。","verify":"\"苏轼\""},{"id":"cnc_p201_q4","topicId":"cnc_p201","difficulty":"standard","type":"choice","prompt":"「春江水暖鸭先知」是在说什么？","choices":[{"key":"A","text":"鹅站在岸上所以知道"},{"key":"B","text":"鸭子常在水里，最先感到江水变暖"},{"key":"C","text":"河豚在报天气"},{"key":"D","text":"桃花把水变暖了"}],"answer":"B","explanation":"鸭子游在江里，所以最先知道春天的水暖了。","verify":"\"鸭子常在水里，最先感到江水变暖\""},{"id":"cnc_p202_q1","topicId":"cnc_p202","difficulty":"basic","type":"choice","prompt":"「梅子黄时日日晴」的下一句是哪一句？","choices":[{"key":"A","text":"绿阴不减来时路"},{"key":"B","text":"添得黄鹂四五声"},{"key":"C","text":"春风花草香"},{"key":"D","text":"小溪泛尽却山行"}],"answer":"D","explanation":"梅子黄的时节天天放晴，小溪走到头，人改走山路。绿阴、黄鹂是后两句。","verify":"\"小溪泛尽却山行\""},{"id":"cnc_p202_q2","topicId":"cnc_p202","difficulty":"basic","type":"choice","prompt":"「绿阴不减来时路」的下一句是哪一句？","choices":[{"key":"A","text":"添得黄鹂四五声"},{"key":"B","text":"小溪泛尽却山行"},{"key":"C","text":"梅子黄时日日晴"},{"key":"D","text":"两个黄鹂鸣翠柳"}],"answer":"A","explanation":"回来时树荫并不比来时少，只是多了四五声黄鹂。两个黄鹂鸣翠柳是杜甫的另一首诗。","verify":"\"添得黄鹂四五声\""},{"id":"cnc_p202_q3","topicId":"cnc_p202","difficulty":"standard","type":"choice","prompt":"《三衢道中》的作者是谁？","choices":[{"key":"A","text":"曾巩"},{"key":"B","text":"曾几"},{"key":"C","text":"杜甫"},{"key":"D","text":"苏轼"}],"answer":"B","explanation":"《三衢道中》是宋朝曾几的诗。曾巩是另一位文人。杜甫写《绝句》，苏轼写《惠崇春江晚景》。","verify":"\"曾几\""},{"id":"cnc_p202_q4","topicId":"cnc_p202","difficulty":"standard","type":"choice","prompt":"哪一句属于《三衢道中》，而不属于杜甫的七言《绝句》？","choices":[{"key":"A","text":"两个黄鹂鸣翠柳"},{"key":"B","text":"一行白鹭上青天"},{"key":"C","text":"添得黄鹂四五声"},{"key":"D","text":"窗含西岭千秋雪"}],"answer":"C","explanation":"黄鹂四五声写的是山路上多听到的鸟声。翠柳、白鹭、西岭都在杜甫那首七言《绝句》里。","verify":"\"添得黄鹂四五声\""},{"id":"cnc_p203_q1","topicId":"cnc_p203","difficulty":"basic","type":"choice","prompt":"燕子的外形，课文抓住了哪三处？","choices":[{"key":"A","text":"羽毛、翅膀和尾巴"},{"key":"B","text":"嘴巴、爪子和眼睛"},{"key":"C","text":"只写了颜色没有写外形"},{"key":"D","text":"荷叶、荷花和莲蓬"}],"answer":"A","explanation":"一身乌黑光亮的羽毛，一对俊俏轻快的翅膀，加上剪刀似的尾巴。","verify":"\"羽毛、翅膀和尾巴\""},{"id":"cnc_p203_q2","topicId":"cnc_p203","difficulty":"basic","type":"choice","prompt":"燕子的尾巴像什么？","choices":[{"key":"A","text":"五线谱"},{"key":"B","text":"剪刀"},{"key":"C","text":"大圆盘"},{"key":"D","text":"小扇子"}],"answer":"B","explanation":"剪刀似的尾巴。五线谱是用来比喻电线的。","verify":"\"剪刀\""},{"id":"cnc_p203_q3","topicId":"cnc_p203","difficulty":"standard","type":"choice","prompt":"电线和停在上面的燕子，被比作什么？","choices":[{"key":"A","text":"剪刀和丝带"},{"key":"B","text":"大圆盘和白荷花"},{"key":"C","text":"五线谱和音符"},{"key":"D","text":"钥匙和大门"}],"answer":"C","explanation":"几痕细线像五线谱，停着的燕子成了音符，谱成了一支正待演奏的曲子。","verify":"\"五线谱和音符\""},{"id":"cnc_p203_q4","topicId":"cnc_p203","difficulty":"standard","type":"choice","prompt":"燕子从哪里飞来，给春天增添了生趣？","choices":[{"key":"A","text":"从海底赶来"},{"key":"B","text":"从牛肚子里赶来"},{"key":"C","text":"从西岭的雪里赶来"},{"key":"D","text":"从南方赶来"}],"answer":"D","explanation":"阳春三月，燕子从南方赶来，加入了这场赶集似的春天。","verify":"\"从南方赶来\""},{"id":"cnc_p204_q1","topicId":"cnc_p204","difficulty":"basic","type":"choice","prompt":"荷叶在课文里是什么样子？","choices":[{"key":"A","text":"稀疏的，像几根针"},{"key":"B","text":"挨挨挤挤的，像一个个碧绿的大圆盘"},{"key":"C","text":"金黄的，像小扇子"},{"key":"D","text":"红色的，像邮票"}],"answer":"B","explanation":"荷叶挨挨挤挤，像碧绿的大圆盘。小扇子是《秋天的雨》里的银杏叶。","verify":"\"挨挨挤挤的，像一个个碧绿的大圆盘\""},{"id":"cnc_p204_q2","topicId":"cnc_p204","difficulty":"basic","type":"choice","prompt":"白荷花是怎样长出来的？","choices":[{"key":"A","text":"全部沉在水底"},{"key":"B","text":"长在树枝上"},{"key":"C","text":"在大圆盘之间冒出来"},{"key":"D","text":"只有花骨朵，没有开放的"}],"answer":"C","explanation":"有的才展开，有的全开了，有的还是花骨朵，都从荷叶间冒出来。","verify":"\"在大圆盘之间冒出来\""},{"id":"cnc_p204_q3","topicId":"cnc_p204","difficulty":"standard","type":"choice","prompt":"「我」忽然觉得自己怎样了？","choices":[{"key":"A","text":"变成了一条小鱼"},{"key":"B","text":"离开荷塘回家了"},{"key":"C","text":"变成了画家的笔"},{"key":"D","text":"仿佛自己也是一朵荷花"}],"answer":"D","explanation":"我忽然觉得自己仿佛就是一朵荷花，穿着雪白的衣裳。","verify":"\"仿佛自己也是一朵荷花\""},{"id":"cnc_p204_q4","topicId":"cnc_p204","difficulty":"standard","type":"choice","prompt":"蜻蜓和小鱼在「我」的想象里做了什么？","choices":[{"key":"A","text":"告诉「我」飞行的快乐和昨夜的好梦"},{"key":"B","text":"把荷花全部采走"},{"key":"C","text":"钻进牛肚子里"},{"key":"D","text":"在岸上砸瓮"}],"answer":"A","explanation":"风停了，蜻蜓告诉我清早飞行的快乐，小鱼告诉我昨夜做的好梦。","verify":"\"告诉「我」飞行的快乐和昨夜的好梦\""},{"id":"cnc_p205_q1","topicId":"cnc_p205","difficulty":"basic","type":"choice","prompt":"《昆虫备忘录》的作者是谁？","choices":[{"key":"A","text":"法布尔"},{"key":"B","text":"冰心"},{"key":"C","text":"汪曾祺"},{"key":"D","text":"萧红"}],"answer":"C","explanation":"这篇是汪曾祺写的备忘录。法布尔写的是后面的《石蜂》。冰心写《肥皂泡》，萧红写《火烧云》。","verify":"\"汪曾祺\""},{"id":"cnc_p205_q2","topicId":"cnc_p205","difficulty":"basic","type":"choice","prompt":"课文说，昆虫的复眼是怎样的？","choices":[{"key":"A","text":"只有一只和人完全相同的眼睛"},{"key":"B","text":"长在翅膀上的硬壳"},{"key":"C","text":"一根头顶的角"},{"key":"D","text":"由许多小眼睛合在一起"}],"answer":"D","explanation":"复眼由许多小眼合成。蜻蜓那一对大大的眼睛就是复眼。独角仙头顶的才是角。","verify":"\"由许多小眼睛合在一起\""},{"id":"cnc_p205_q3","topicId":"cnc_p205","difficulty":"standard","type":"choice","prompt":"「花大姐」指的是哪一种虫？","choices":[{"key":"A","text":"瓢虫"},{"key":"B","text":"蚂蚱"},{"key":"C","text":"石蜂"},{"key":"D","text":"独角仙"}],"answer":"A","explanation":"瓢虫俗称花大姐。吃蚜虫的是益虫；吃马铃薯嫩叶的二十八星瓢虫是害虫。不能见了瓢虫就说全是益虫。","verify":"\"瓢虫\""},{"id":"cnc_p205_q4","topicId":"cnc_p205","difficulty":"standard","type":"choice","prompt":"蚂蚱真正用来飞的是哪一对翅膀？","choices":[{"key":"A","text":"前面那对又硬又用来保护的翅膀"},{"key":"B","text":"后面那对又薄又能扇动的翅膀"},{"key":"C","text":"头顶的那只角"},{"key":"D","text":"复眼里的小眼睛"}],"answer":"B","explanation":"前面一对是保护翅膀，后面一对才用来飞。角是独角仙的，不是蚂蚱的翅膀。","verify":"\"后面那对又薄又能扇动的翅膀\""},{"id":"cnc_p206_q1","topicId":"cnc_p206","difficulty":"basic","type":"choice","prompt":"「荷叶像一个个碧绿的大圆盘」用的是哪一种写法？","choices":[{"key":"A","text":"拟人"},{"key":"B","text":"反问"},{"key":"C","text":"排比"},{"key":"D","text":"比喻"}],"answer":"D","explanation":"把荷叶比作大圆盘，是比喻。圆盘不会说话，这里没有把荷叶写成一个人。","verify":"\"比喻\""},{"id":"cnc_p206_q2","topicId":"cnc_p206","difficulty":"basic","type":"choice","prompt":"「小鱼在脚下游过，告诉我昨夜做的好梦」用的是哪一种写法？","choices":[{"key":"A","text":"拟人"},{"key":"B","text":"比喻"},{"key":"C","text":"夸张得没有人的动作"},{"key":"D","text":"只是列数字"}],"answer":"A","explanation":"鱼不会说话。让小鱼来「告诉我」，是把鱼当作人来写，这是拟人。","verify":"\"拟人\""},{"id":"cnc_p206_q3","topicId":"cnc_p206","difficulty":"standard","type":"choice","prompt":"哪一句是比喻？","choices":[{"key":"A","text":"花朵在风里向我点头。"},{"key":"B","text":"露珠像一颗颗透明的珠子。"},{"key":"C","text":"小草从土里探出脑袋。"},{"key":"D","text":"春风轻轻地叫醒了柳树。"}],"answer":"B","explanation":"「像珠子」是把露珠比作另一种东西。点头、探出脑袋、叫醒都是拟人。","verify":"\"露珠像一颗颗透明的珠子。\""},{"id":"cnc_p206_q4","topicId":"cnc_p206","difficulty":"standard","type":"choice","prompt":"哪一句是拟人？","choices":[{"key":"A","text":"柳枝像绿色的丝带。"},{"key":"B","text":"荷叶像大圆盘。"},{"key":"C","text":"春风轻轻地叫醒了柳树。"},{"key":"D","text":"太阳像一个红球。"}],"answer":"C","explanation":"春风不会叫人，这里把它写成会叫醒别人，是拟人。像丝带、像圆盘、像红球都是比喻。","verify":"\"春风轻轻地叫醒了柳树。\""}]
