[{"id":"cnm_h179_q1","topicId":"cnm_h179","difficulty":"basic","type":"numeric","prompt":"圆 x²+y²=25，直线 x=3。圆心到直线的距离是多少？","answer":"3","explanation":"圆心是原点，到直线 x=3 的距离是 3。","verify":"3"},{"id":"cnm_h179_q2","topicId":"cnm_h179","difficulty":"basic","type":"choice","prompt":"圆 x²+y²=25，直线 x=3。直线与圆的位置关系是？","choices":[{"key":"A","text":"相切"},{"key":"B","text":"相交"},{"key":"C","text":"相离"},{"key":"D","text":"直线经过圆心"}],"answer":"B","explanation":"d=3，r=5，d<r，直线与圆有两个公共点。","verify":"\"相交\""},{"id":"cnm_h179_q3","topicId":"cnm_h179","difficulty":"standard","type":"numeric","prompt":"圆 x²+y²=25，直线 x=5。圆心到直线的距离是多少？","answer":"5","explanation":"距离等于半径 5，直线与圆相切。","verify":"5"},{"id":"cnm_h179_q4","topicId":"cnm_h179","difficulty":"standard","type":"choice","prompt":"圆心到直线的距离大于半径时，直线与圆怎样？","choices":[{"key":"A","text":"相交于两点"},{"key":"B","text":"相切"},{"key":"C","text":"直线经过圆心"},{"key":"D","text":"相离"}],"answer":"D","explanation":"d>r 时没有公共点，叫做相离。","verify":"\"相离\""},{"id":"cnm_h180_q1","topicId":"cnm_h180","difficulty":"basic","type":"numeric","prompt":"圆 x²+y²=25，直线 x=3。弦长是多少？","answer":"8","explanation":"弦心距 3，半弦长 √(25−9)=4，弦长是 8。","verify":"2*isqrt(25-9)"},{"id":"cnm_h180_q2","topicId":"cnm_h180","difficulty":"basic","type":"numeric","prompt":"半径 5，弦心距 4。半弦长是多少？","answer":"3","explanation":"√(25−16)=3。","verify":"isqrt(25-16)"},{"id":"cnm_h180_q3","topicId":"cnm_h180","difficulty":"standard","type":"numeric","prompt":"半径 13，弦心距 5。弦长是多少？","answer":"24","explanation":"半弦长 √(169−25)=√144=12，弦长是 24。","verify":"2*isqrt(169-25)"},{"id":"cnm_h180_q4","topicId":"cnm_h180","difficulty":"standard","type":"choice","prompt":"直线与圆相切时，弦长是多少？","choices":[{"key":"A","text":"0"},{"key":"B","text":"等于半径"},{"key":"C","text":"等于直径"},{"key":"D","text":"等于弦心距"}],"answer":"A","explanation":"相切只有一个公共点，弦长是 0。","verify":"\"0\""},{"id":"cnm_h181_q1","topicId":"cnm_h181","difficulty":"basic","type":"numeric","prompt":"两圆圆心距是 5，半径是 3 和 4。公共点有几个？","answer":"2","explanation":"|3−4|<5<3+4，两圆相交，有 2 个公共点。","verify":"2 if abs(3-4)<5<3+4 else (1 if 5==abs(3-4) or 5==3+4 else 0)"},{"id":"cnm_h181_q2","topicId":"cnm_h181","difficulty":"basic","type":"numeric","prompt":"两圆半径都是 3，圆心距是 6。公共点有几个？","answer":"1","explanation":"圆心距等于半径之和，两圆外切，有 1 个公共点。","verify":"2 if abs(3-3)<6<3+3 else (1 if 6==abs(3-3) or 6==3+3 else 0)"},{"id":"cnm_h181_q3","topicId":"cnm_h181","difficulty":"standard","type":"choice","prompt":"圆心距大于两个半径之和时，两圆的位置关系是？","choices":[{"key":"A","text":"外离"},{"key":"B","text":"外切"},{"key":"C","text":"相交"},{"key":"D","text":"内含"}],"answer":"A","explanation":"圆心离得比两半径之和还远，两圆没有公共点，并且各自在对方外部。","verify":"\"外离\""},{"id":"cnm_h181_q4","topicId":"cnm_h181","difficulty":"standard","type":"numeric","prompt":"两圆半径 5 和 3，圆心距 2。|r1−r2| 等于多少？","answer":"2","explanation":"半径差的绝对值是 2，等于圆心距，两圆内切。","verify":"abs(5-3)"},{"id":"cnm_h182_q1","topicId":"cnm_h182","difficulty":"basic","type":"numeric","prompt":"圆形喷灌区圆心在原点，半径 10。笔直管道沿直线 x=6。圆心到管道的距离是多少？","answer":"6","explanation":"管道是直线 x=6，原点到它的距离是 6，小于半径，管道穿过喷灌区。","verify":"6"},{"id":"cnm_h182_q2","topicId":"cnm_h182","difficulty":"basic","type":"numeric","prompt":"半径 10、弦心距 6 时，管道在圆内的那一段长度是多少？","answer":"16","explanation":"半弦长 √(100−36)=8，弦长是 16。","verify":"2*isqrt(100-36)"},{"id":"cnm_h182_q3","topicId":"cnm_h182","difficulty":"standard","type":"choice","prompt":"圆形禁区半径 5，直线道路到圆心的距离是 5。道路与禁区边界怎样？","choices":[{"key":"A","text":"穿过禁区内部"},{"key":"B","text":"相切"},{"key":"C","text":"与禁区相离"},{"key":"D","text":"经过圆心"}],"answer":"B","explanation":"距离等于半径，道路与圆相切，只有一个公共点。","verify":"\"相切\""},{"id":"cnm_h182_q4","topicId":"cnm_h182","difficulty":"standard","type":"numeric","prompt":"半径 5 的圆，一条弦的弦心距是 3。弦长比直径少多少？","answer":"2","explanation":"直径 10，弦长 8，差是 2。","verify":"10-2*isqrt(25-9)"}]
