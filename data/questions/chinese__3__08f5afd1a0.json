[{"id":"cnc_p217_q1","topicId":"cnc_p217","difficulty":"basic","type":"choice","prompt":"「爆竹声中一岁除」的下一句是哪一句？","choices":[{"key":"A","text":"千门万户曈曈日"},{"key":"B","text":"总把新桃换旧符"},{"key":"C","text":"春风送暖入屠苏"},{"key":"D","text":"春风送暖入屠城"}],"answer":"C","explanation":"爆竹送走旧年，人们喝着屠苏酒。千门万户是后两句。","verify":"\"春风送暖入屠苏\""},{"id":"cnc_p217_q2","topicId":"cnc_p217","difficulty":"basic","type":"choice","prompt":"「千门万户曈曈日」的下一句是哪一句？","choices":[{"key":"A","text":"春风送暖入屠苏"},{"key":"B","text":"爆竹声中一岁除"},{"key":"C","text":"总把新符换旧桃"},{"key":"D","text":"总把新桃换旧符"}],"answer":"D","explanation":"太阳照进千家万户，人们把旧桃符换成新的。不能把新桃、旧符说反。","verify":"\"总把新桃换旧符\""},{"id":"cnc_p217_q3","topicId":"cnc_p217","difficulty":"standard","type":"choice","prompt":"《元日》的作者是谁？","choices":[{"key":"A","text":"王安石"},{"key":"B","text":"杜甫"},{"key":"C","text":"杜牧"},{"key":"D","text":"苏轼"}],"answer":"A","explanation":"《元日》是王安石的诗。杜牧写《清明》，不要记混。","verify":"\"王安石\""},{"id":"cnc_p217_q4","topicId":"cnc_p217","difficulty":"standard","type":"choice","prompt":"「屠苏」在这首诗里指什么？","choices":[{"key":"A","text":"一种爆竹"},{"key":"B","text":"一种酒"},{"key":"C","text":"一面桃符"},{"key":"D","text":"一扇大门"}],"answer":"B","explanation":"古人过年要喝屠苏酒。春风把暖意送进这杯酒里。","verify":"\"一种酒\""},{"id":"cnc_p218_q1","topicId":"cnc_p218","difficulty":"basic","type":"choice","prompt":"「清明时节雨纷纷」的下一句是哪一句？","choices":[{"key":"A","text":"借问酒家何处有"},{"key":"B","text":"牧童遥指杏花村"},{"key":"C","text":"路上行人欲断肠"},{"key":"D","text":"路上行人欲断魂"}],"answer":"D","explanation":"清明细雨，路上的行人伤心极了。借问酒家是后两句。","verify":"\"路上行人欲断魂\""},{"id":"cnc_p218_q2","topicId":"cnc_p218","difficulty":"basic","type":"choice","prompt":"「借问酒家何处有」的下一句是哪一句？","choices":[{"key":"A","text":"牧童遥指杏花村"},{"key":"B","text":"路上行人欲断魂"},{"key":"C","text":"清明时节雨纷纷"},{"key":"D","text":"牧童遥指杏花酒"}],"answer":"A","explanation":"行人问哪里有酒家，牧童远远指向杏花村。","verify":"\"牧童遥指杏花村\""},{"id":"cnc_p218_q3","topicId":"cnc_p218","difficulty":"standard","type":"choice","prompt":"《清明》的作者是谁？","choices":[{"key":"A","text":"杜甫"},{"key":"B","text":"杜牧"},{"key":"C","text":"李白"},{"key":"D","text":"王安石"}],"answer":"B","explanation":"《清明》和《山行》都是杜牧的诗。杜甫不是这首诗的作者。","verify":"\"杜牧\""},{"id":"cnc_p218_q4","topicId":"cnc_p218","difficulty":"standard","type":"choice","prompt":"牧童指向的杏花村是什么地方？","choices":[{"key":"A","text":"诗人的家乡"},{"key":"B","text":"西岭雪山"},{"key":"C","text":"有酒家的村子"},{"key":"D","text":"天门山"}],"answer":"C","explanation":"行人想找个地方避雨、喝酒，牧童指的是杏花深处的酒家所在。","verify":"\"有酒家的村子\""},{"id":"cnc_p219_q1","topicId":"cnc_p219","difficulty":"basic","type":"choice","prompt":"「独在异乡为异客」的下一句是哪一句？","choices":[{"key":"A","text":"每逢佳节倍思亲"},{"key":"B","text":"遥知兄弟登高处"},{"key":"C","text":"遍插茱萸少一人"},{"key":"D","text":"春风送暖入屠苏"}],"answer":"A","explanation":"独自在外地作客，每到节日就更加想念亲人。登高、茱萸是后两句。屠苏是《元日》里的酒。","verify":"\"每逢佳节倍思亲\""},{"id":"cnc_p219_q2","topicId":"cnc_p219","difficulty":"basic","type":"choice","prompt":"「遥知兄弟登高处」的下一句是哪一句？","choices":[{"key":"A","text":"每逢佳节倍思亲"},{"key":"B","text":"遍插茱萸少一人"},{"key":"C","text":"独在异乡为异客"},{"key":"D","text":"遍插茱萸少两人"}],"answer":"B","explanation":"诗人想到兄弟们重阳登高、插茱萸，少的是他自己这一个。不能说成少两人。","verify":"\"遍插茱萸少一人\""},{"id":"cnc_p219_q3","topicId":"cnc_p219","difficulty":"standard","type":"choice","prompt":"《九月九日忆山东兄弟》的作者是谁？九月九日是什么节日？","choices":[{"key":"A","text":"王安石。九月九日是春节"},{"key":"B","text":"杜牧。九月九日是清明"},{"key":"C","text":"王维。九月九日是重阳节"},{"key":"D","text":"王之涣。九月九日是中秋"}],"answer":"C","explanation":"王维写的是重阳。春节是《元日》，清明是杜牧的《清明》。王之涣写的是《登鹳雀楼》。","verify":"\"王维。九月九日是重阳节\""},{"id":"cnc_p219_q4","topicId":"cnc_p219","difficulty":"standard","type":"choice","prompt":"诗题里的「山东」指哪里？","choices":[{"key":"A","text":"今天的山东省"},{"key":"B","text":"杏花村"},{"key":"C","text":"汴京的桥上"},{"key":"D","text":"华山以东，诗人的家乡一带"}],"answer":"D","explanation":"唐朝说的山东，常指华山以东。王维思念的是那边的兄弟，不是把诗题写成现在的省名。","verify":"\"华山以东，诗人的家乡一带\""},{"id":"cnc_p220_q1","topicId":"cnc_p220","difficulty":"basic","type":"choice","prompt":"纸还没有广泛使用时，人们把字写在哪里？","choices":[{"key":"A","text":"只能写在今天的电脑上"},{"key":"B","text":"龟甲兽骨、竹片木片，还有价钱很贵的帛"},{"key":"C","text":"只刻在赵州桥的栏板上"},{"key":"D","text":"写在还没发明的白纸上"}],"answer":"B","explanation":"更早还有刻在甲骨上、铸在青铜器上的字。竹简沉重，帛又太贵。","verify":"\"龟甲兽骨、竹片木片，还有价钱很贵的帛\""},{"id":"cnc_p220_q2","topicId":"cnc_p220","difficulty":"basic","type":"choice","prompt":"蔡伦做了什么？","choices":[{"key":"A","text":"隋朝设计了赵州桥"},{"key":"B","text":"北宋画了《清明上河图》"},{"key":"C","text":"东汉时吸取前人经验，改进了造纸术"},{"key":"D","text":"唐朝才第一次看见树皮"}],"answer":"C","explanation":"大约一千九百年前的东汉，蔡伦改进造纸方法。他不是造桥的李春，也不是画画的张择端。","verify":"\"东汉时吸取前人经验，改进了造纸术\""},{"id":"cnc_p220_q3","topicId":"cnc_p220","difficulty":"standard","type":"choice","prompt":"蔡伦造纸主要用哪些原料？","choices":[{"key":"A","text":"黄金和珍珠"},{"key":"B","text":"只用一块龟甲"},{"key":"C","text":"荷叶和燕子的羽毛"},{"key":"D","text":"树皮、麻头、破布和旧渔网"}],"answer":"D","explanation":"这些原料容易得到，造出来的纸价钱便宜，写字也方便。","verify":"\"树皮、麻头、破布和旧渔网\""},{"id":"cnc_p220_q4","topicId":"cnc_p220","difficulty":"standard","type":"choice","prompt":"造纸术改进以后有什么变化？","choices":[{"key":"A","text":"纸便宜、好用，后来传到许多地方"},{"key":"B","text":"人们从此不再写字"},{"key":"C","text":"帛变得比纸还便宜"},{"key":"D","text":"字只能再刻回甲骨上"}],"answer":"A","explanation":"纸便于书写和携带。这是中国古代重要的发明，后来影响到别的国家。","verify":"\"纸便宜、好用，后来传到许多地方\""},{"id":"cnc_p221_q1","topicId":"cnc_p221","difficulty":"basic","type":"choice","prompt":"赵州桥是谁设计并参加建造的？","choices":[{"key":"A","text":"宋朝的司马光"},{"key":"B","text":"唐朝的李白"},{"key":"C","text":"隋朝的石匠李春"},{"key":"D","text":"汉朝的曹操"}],"answer":"C","explanation":"赵州桥又叫安济桥，是隋朝石匠李春设计的。","verify":"\"隋朝的石匠李春\""},{"id":"cnc_p221_q2","topicId":"cnc_p221","difficulty":"basic","type":"choice","prompt":"桥下面有桥墩吗？","choices":[{"key":"A","text":"有很多桥墩"},{"key":"B","text":"用木柱撑着"},{"key":"C","text":"桥身浮在水面上"},{"key":"D","text":"没有桥墩，只有一个拱形的大桥洞"}],"answer":"D","explanation":"桥全部用石头砌成，下面没有桥墩，只有一个大拱。","verify":"\"没有桥墩，只有一个拱形的大桥洞\""},{"id":"cnc_p221_q3","topicId":"cnc_p221","difficulty":"standard","type":"choice","prompt":"大桥洞上面为什么还有小桥洞？","choices":[{"key":"A","text":"减轻重量，河水大时还能排洪，样子也好看"},{"key":"B","text":"为了让人住在里面"},{"key":"C","text":"因为石头不够用，随便挖的"},{"key":"D","text":"小桥洞不能过水"}],"answer":"A","explanation":"大拱顶上左右各有两个小拱。这种设计在建桥史上是一个创举。","verify":"\"减轻重量，河水大时还能排洪，样子也好看\""},{"id":"cnc_p221_q4","topicId":"cnc_p221","difficulty":"standard","type":"choice","prompt":"栏板上雕刻着什么？","choices":[{"key":"A","text":"荷花和燕子"},{"key":"B","text":"龙"},{"key":"C","text":"灰雀"},{"key":"D","text":"枣核"}],"answer":"B","explanation":"栏板上面雕刻着精美的龙，有的互相缠绕，有的张牙舞爪。","verify":"\"龙\""},{"id":"cnc_p222_q1","topicId":"cnc_p222","difficulty":"basic","type":"choice","prompt":"课文介绍的这幅画叫什么？","choices":[{"key":"A","text":"《惠崇春江晚景》"},{"key":"B","text":"赵州桥的设计图"},{"key":"C","text":"一张只有一座桥的地图"},{"key":"D","text":"《清明上河图》"}],"answer":"D","explanation":"它名扬中外，画的是北宋都城清明时节的繁华。惠崇的画是另一课里苏轼题诗的那幅。","verify":"\"《清明上河图》\""},{"id":"cnc_p222_q2","topicId":"cnc_p222","difficulty":"basic","type":"choice","prompt":"这幅画是谁画的？","choices":[{"key":"A","text":"北宋的张择端"},{"key":"B","text":"隋朝的李春"},{"key":"C","text":"东汉的蔡伦"},{"key":"D","text":"唐朝的杜甫"}],"answer":"A","explanation":"张择端是北宋画家。李春造桥，蔡伦改进造纸，都不是这幅画的作者。","verify":"\"北宋的张择端\""},{"id":"cnc_p222_q3","topicId":"cnc_p222","difficulty":"standard","type":"choice","prompt":"画上主要画了哪里的生活？","choices":[{"key":"A","text":"只有一只小虾"},{"key":"B","text":"都城汴京汴河两岸，各行各业的人都有"},{"key":"C","text":"只有海底的海参"},{"key":"D","text":"只有一只掉进陷阱的狼"}],"answer":"B","explanation":"街上有农夫、船工、做买卖的人，也有官员和读书人。三百六十行几乎都画到了。","verify":"\"都城汴京汴河两岸，各行各业的人都有\""},{"id":"cnc_p222_q4","topicId":"cnc_p222","difficulty":"standard","type":"choice","prompt":"画上特别热闹的一幕是什么？现在画保存在哪里？","choices":[{"key":"A","text":"船已经沉进海底。画保存在赵州桥下"},{"key":"B","text":"桥上没有人。画还在蔡伦手里"},{"key":"C","text":"大船正要通过桥洞，许多人在帮忙。画保存在北京故宫博物院"},{"key":"D","text":"画家把画送给了牧童"}],"answer":"C","explanation":"船夫放倒桅杆，桥上桥下的人都在看。这幅长卷现在藏在北京故宫博物院。","verify":"\"大船正要通过桥洞，许多人在帮忙。画保存在北京故宫博物院\""},{"id":"cnc_p223_q1","topicId":"cnc_p223","difficulty":"basic","type":"choice","prompt":"《元日》写的是哪个节日？","choices":[{"key":"A","text":"春节，农历正月初一"},{"key":"B","text":"清明节"},{"key":"C","text":"重阳节"},{"key":"D","text":"中秋节"}],"answer":"A","explanation":"爆竹、屠苏酒、换新桃符，都是旧年过去、新年到来时的事。","verify":"\"春节，农历正月初一\""},{"id":"cnc_p223_q2","topicId":"cnc_p223","difficulty":"basic","type":"choice","prompt":"《九月九日忆山东兄弟》写的是哪个节日？人们常常做什么？","choices":[{"key":"A","text":"春节。放爆竹，喝屠苏"},{"key":"B","text":"重阳节。登高，插茱萸"},{"key":"C","text":"清明。在雨中找酒家"},{"key":"D","text":"端午。赛龙舟"}],"answer":"B","explanation":"九月九日是重阳。诗里兄弟们登高，身上插着茱萸。","verify":"\"重阳节。登高，插茱萸\""},{"id":"cnc_p223_q3","topicId":"cnc_p223","difficulty":"standard","type":"choice","prompt":"端午节的习俗，哪一组是对的？","choices":[{"key":"A","text":"吃月饼，赏月"},{"key":"B","text":"喝屠苏，换桃符"},{"key":"C","text":"吃粽子，赛龙舟"},{"key":"D","text":"登高，插茱萸"}],"answer":"C","explanation":"粽子和龙舟是端午。月饼是中秋，屠苏是春节，茱萸是重阳。","verify":"\"吃粽子，赛龙舟\""},{"id":"cnc_p223_q4","topicId":"cnc_p223","difficulty":"standard","type":"choice","prompt":"做「中华传统节日」的学习时，哪一种做法合适？","choices":[{"key":"A","text":"把清明的雨安到春节头上"},{"key":"B","text":"说重阳的习俗是赛龙舟"},{"key":"C","text":"只写一个节日的名字，不写人们做什么"},{"key":"D","text":"选一个节日，把日期、习俗和相关的诗说清楚"}],"answer":"D","explanation":"日期、习俗、诗句要属于同一个节日，不能串到别的节日上。","verify":"\"选一个节日，把日期、习俗和相关的诗说清楚\""}]
