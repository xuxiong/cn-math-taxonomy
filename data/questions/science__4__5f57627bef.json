[{"id":"cns_p133_q1","topicId":"cns_p133","difficulty":"basic","type":"choice","prompt":"花岗岩上常能看到什么？","choices":[{"key":"A","text":"一层层的薄层"},{"key":"B","text":"许多小孔像海绵"},{"key":"C","text":"大小不同的颗粒（晶体）"},{"key":"D","text":"透明得像玻璃"}],"answer":"C","explanation":"花岗岩由颗粒较粗的矿物组成。","verify":"\"大小不同的颗粒（晶体）\""},{"id":"cns_p133_q2","topicId":"cns_p133","difficulty":"basic","type":"choice","prompt":"用稀盐酸滴在哪种岩石上会冒气泡？","choices":[{"key":"A","text":"花岗岩"},{"key":"B","text":"砂岩"},{"key":"C","text":"页岩"},{"key":"D","text":"大理岩"}],"answer":"D","explanation":"大理岩含碳酸钙，遇酸冒气泡。","verify":"\"大理岩\""},{"id":"cns_p133_q3","topicId":"cns_p133","difficulty":"standard","type":"choice","prompt":"能看到一层层薄薄的层理，容易剥开的是哪种岩石？","choices":[{"key":"A","text":"页岩"},{"key":"B","text":"花岗岩"},{"key":"C","text":"大理岩"},{"key":"D","text":"玄武岩"}],"answer":"A","explanation":"页岩有明显的薄层。","verify":"\"页岩\""},{"id":"cns_p133_q4","topicId":"cns_p133","difficulty":"challenge","type":"choice","prompt":"观察岩石时，可以用哪些方法？","choices":[{"key":"A","text":"用嘴尝味道"},{"key":"B","text":"看颜色、用放大镜看颗粒、用小刀刻划比硬度"},{"key":"C","text":"放进火里烧"},{"key":"D","text":"使劲摔"}],"answer":"B","explanation":"安全、有序地观察岩石特征。","verify":"\"看颜色、用放大镜看颗粒、用小刀刻划比硬度\""},{"id":"cns_p134_q1","topicId":"cns_p134","difficulty":"basic","type":"choice","prompt":"岩石是由什么组成的？","choices":[{"key":"A","text":"土壤"},{"key":"B","text":"植物"},{"key":"C","text":"水"},{"key":"D","text":"一种或几种矿物"}],"answer":"D","explanation":"矿物是组成岩石的基本单位。","verify":"\"一种或几种矿物\""},{"id":"cns_p134_q2","topicId":"cns_p134","difficulty":"basic","type":"choice","prompt":"花岗岩里主要含有哪些矿物？","choices":[{"key":"A","text":"石英、长石、云母"},{"key":"B","text":"铁、铜、金"},{"key":"C","text":"钻石、红宝石"},{"key":"D","text":"盐和糖"}],"answer":"A","explanation":"这三种是花岗岩的主要矿物。","verify":"\"石英、长石、云母\""},{"id":"cns_p134_q3","topicId":"cns_p134","difficulty":"standard","type":"choice","prompt":"矿物在白瓷板上划出的颜色叫什么？","choices":[{"key":"A","text":"光泽"},{"key":"B","text":"条痕"},{"key":"C","text":"硬度"},{"key":"D","text":"形状"}],"answer":"B","explanation":"条痕颜色可以帮助鉴别矿物。","verify":"\"条痕\""},{"id":"cns_p134_q4","topicId":"cns_p134","difficulty":"challenge","type":"choice","prompt":"用指甲刻不动、用小刀能刻出痕迹的矿物，硬度怎样？","choices":[{"key":"A","text":"比小刀硬"},{"key":"B","text":"比指甲软"},{"key":"C","text":"比指甲硬，比小刀软"},{"key":"D","text":"无法判断"}],"answer":"C","explanation":"根据能否被刻划比较硬度。","verify":"\"比指甲硬，比小刀软\""},{"id":"cns_p135_q1","topicId":"cns_p135","difficulty":"basic","type":"choice","prompt":"沙和黏土主要是怎样形成的？","choices":[{"key":"A","text":"岩石经过长期风化破碎形成"},{"key":"B","text":"人工制造"},{"key":"C","text":"从天上掉下来"},{"key":"D","text":"植物长出来"}],"answer":"A","explanation":"岩石风化变成小颗粒。","verify":"\"岩石经过长期风化破碎形成\""},{"id":"cns_p135_q2","topicId":"cns_p135","difficulty":"basic","type":"choice","prompt":"沙和黏土相比，谁的颗粒更大？","choices":[{"key":"A","text":"黏土"},{"key":"B","text":"沙"},{"key":"C","text":"一样大"},{"key":"D","text":"都没有颗粒"}],"answer":"B","explanation":"沙粒较大，黏土颗粒非常细。","verify":"\"沙\""},{"id":"cns_p135_q3","topicId":"cns_p135","difficulty":"standard","type":"choice","prompt":"往装沙和装黏土的漏斗里同时倒水，哪个渗水更快？","choices":[{"key":"A","text":"黏土"},{"key":"B","text":"一样"},{"key":"C","text":"沙"},{"key":"D","text":"都不渗"}],"answer":"C","explanation":"沙粒间空隙大，渗水快。","verify":"\"沙\""},{"id":"cns_p135_q4","topicId":"cns_p135","difficulty":"challenge","type":"choice","prompt":"加水后能捏成形状、不容易散开的是什么？","choices":[{"key":"A","text":"沙"},{"key":"B","text":"小石子"},{"key":"C","text":"干树叶"},{"key":"D","text":"黏土"}],"answer":"D","explanation":"黏土黏性大，可塑性强。","verify":"\"黏土\""},{"id":"cns_p136_q1","topicId":"cns_p136","difficulty":"basic","type":"choice","prompt":"把土壤放进水中搅拌，静置后最下层是什么？","choices":[{"key":"A","text":"腐殖质"},{"key":"B","text":"较大的沙石颗粒"},{"key":"C","text":"水"},{"key":"D","text":"空气"}],"answer":"B","explanation":"较重的颗粒最先沉到底。","verify":"\"较大的沙石颗粒\""},{"id":"cns_p136_q2","topicId":"cns_p136","difficulty":"basic","type":"choice","prompt":"土壤中由动植物残体腐烂形成的物质叫什么？","choices":[{"key":"A","text":"沙子"},{"key":"B","text":"黏土"},{"key":"C","text":"腐殖质"},{"key":"D","text":"岩石"}],"answer":"C","explanation":"腐殖质给植物提供养料。","verify":"\"腐殖质\""},{"id":"cns_p136_q3","topicId":"cns_p136","difficulty":"standard","type":"choice","prompt":"把一块土放入水中会冒出气泡，说明土壤中有什么？","choices":[{"key":"A","text":"石油"},{"key":"B","text":"金属"},{"key":"C","text":"盐"},{"key":"D","text":"空气"}],"answer":"D","explanation":"土壤颗粒间有空气。","verify":"\"空气\""},{"id":"cns_p136_q4","topicId":"cns_p136","difficulty":"challenge","type":"choice","prompt":"下面哪些生物常在土壤里生活？","choices":[{"key":"A","text":"蚯蚓和蚂蚁"},{"key":"B","text":"金鱼和虾"},{"key":"C","text":"麻雀和老鹰"},{"key":"D","text":"海豚和鲸"}],"answer":"A","explanation":"土壤中生活着很多小动物。","verify":"\"蚯蚓和蚂蚁\""},{"id":"cns_p137_q1","topicId":"cns_p137","difficulty":"basic","type":"choice","prompt":"哪种土壤最适合大多数植物生长？","choices":[{"key":"A","text":"沙质土"},{"key":"B","text":"黏质土"},{"key":"C","text":"壤土"},{"key":"D","text":"纯沙子"}],"answer":"C","explanation":"壤土通气、保水能力适中。","verify":"\"壤土\""},{"id":"cns_p137_q2","topicId":"cns_p137","difficulty":"basic","type":"choice","prompt":"渗水最快、保水最差的土壤是哪种？","choices":[{"key":"A","text":"黏质土"},{"key":"B","text":"壤土"},{"key":"C","text":"都一样"},{"key":"D","text":"沙质土"}],"answer":"D","explanation":"沙质土颗粒大，渗水快。","verify":"\"沙质土\""},{"id":"cns_p137_q3","topicId":"cns_p137","difficulty":"standard","type":"choice","prompt":"比较三种土壤的渗水性，下面哪个做法公平？","choices":[{"key":"A","text":"取等量土壤，倒入等量的水，同时开始计时"},{"key":"B","text":"土壤一多一少"},{"key":"C","text":"倒水量不同"},{"key":"D","text":"先后不同时间开始"}],"answer":"A","explanation":"只改变土壤种类，其他条件相同。","verify":"\"取等量土壤，倒入等量的水，同时开始计时\""},{"id":"cns_p137_q4","topicId":"cns_p137","difficulty":"challenge","type":"choice","prompt":"下面哪种做法能保护土壤？","choices":[{"key":"A","text":"大量乱砍树木"},{"key":"B","text":"植树种草，回收废电池"},{"key":"C","text":"把废电池埋进土里"},{"key":"D","text":"过度放牧"}],"answer":"B","explanation":"植被能防止水土流失，废电池会污染土壤。","verify":"\"植树种草，回收废电池\""}]
