[{"id":"cns_p231_q1","topicId":"cns_p231","difficulty":"basic","type":"choice","prompt":"「岩石与土壤的故事」主要想让我们了解什么？","choices":[{"key":"A","text":"岩石、土壤和我们的生活有怎样的联系"},{"key":"B","text":"只讲天气预报怎么形成"},{"key":"C","text":"只讲电灯电路怎样连接"},{"key":"D","text":"只讲呼吸器官有哪些"}],"answer":"A","explanation":"这一课围绕岩石、土壤与生活的关系。","verify":"\"岩石、土壤和我们的生活有怎样的联系\""},{"id":"cns_p231_q2","topicId":"cns_p231","difficulty":"basic","type":"choice","prompt":"下面哪一项属于岩石和我们生活的联系？","choices":[{"key":"A","text":"岩石能代替一日三餐"},{"key":"B","text":"房子、道路常常要用到岩石或石材"},{"key":"C","text":"岩石自己会呼吸"},{"key":"D","text":"岩石会变成空气"}],"answer":"B","explanation":"岩石是常见的建筑和铺路材料，和生活密切相关。","verify":"\"房子、道路常常要用到岩石或石材\""},{"id":"cns_p231_q3","topicId":"cns_p231","difficulty":"standard","type":"choice","prompt":"土壤和我们的生活有什么关系？","choices":[{"key":"A","text":"土壤只能用来玩耍，没有别的用处"},{"key":"B","text":"土壤里不能生长任何植物"},{"key":"C","text":"许多植物在土壤里生长，给我们食物和木材"},{"key":"D","text":"土壤和人的生活没有关系"}],"answer":"C","explanation":"土壤支撑植物生长，是生活离不开的一部分。","verify":"\"许多植物在土壤里生长，给我们食物和木材\""},{"id":"cns_p231_q4","topicId":"cns_p231","difficulty":"challenge","type":"choice","prompt":"想了解岩石和土壤的故事，比较合适的做法是什么？","choices":[{"key":"A","text":"只讲天气怎样变化"},{"key":"B","text":"编一个没有根据的人物情节"},{"key":"C","text":"只数电灯有几盏"},{"key":"D","text":"联系生活，想想岩石和土壤在哪里帮到了我们"}],"answer":"D","explanation":"从生活中的联系去认识岩石和土壤，就是在读它们的故事。","verify":"\"联系生活，想想岩石和土壤在哪里帮到了我们\""},{"id":"cns_p133_q1","topicId":"cns_p133","difficulty":"basic","type":"choice","prompt":"花岗岩上常能看到什么？","choices":[{"key":"A","text":"一层层的薄层"},{"key":"B","text":"许多小孔像海绵"},{"key":"C","text":"大小不同的颗粒（晶体）"},{"key":"D","text":"透明得像玻璃"}],"answer":"C","explanation":"花岗岩由颗粒较粗的矿物组成。","verify":"\"大小不同的颗粒（晶体）\""},{"id":"cns_p133_q2","topicId":"cns_p133","difficulty":"basic","type":"choice","prompt":"用稀盐酸滴在哪种岩石上会冒气泡？","choices":[{"key":"A","text":"花岗岩"},{"key":"B","text":"砂岩"},{"key":"C","text":"页岩"},{"key":"D","text":"大理岩"}],"answer":"D","explanation":"大理岩含碳酸钙，遇酸冒气泡。","verify":"\"大理岩\""},{"id":"cns_p133_q3","topicId":"cns_p133","difficulty":"standard","type":"choice","prompt":"能看到一层层薄薄的层理，容易剥开的是哪种岩石？","choices":[{"key":"A","text":"页岩"},{"key":"B","text":"花岗岩"},{"key":"C","text":"大理岩"},{"key":"D","text":"玄武岩"}],"answer":"A","explanation":"页岩有明显的薄层。","verify":"\"页岩\""},{"id":"cns_p133_q4","topicId":"cns_p133","difficulty":"challenge","type":"choice","prompt":"观察岩石时，可以用哪些方法？","choices":[{"key":"A","text":"用嘴尝味道"},{"key":"B","text":"看颜色、用放大镜看颗粒、用小刀刻划比硬度"},{"key":"C","text":"放进火里烧"},{"key":"D","text":"使劲摔"}],"answer":"B","explanation":"安全、有序地观察岩石特征。","verify":"\"看颜色、用放大镜看颗粒、用小刀刻划比硬度\""},{"id":"cns_p134_q1","topicId":"cns_p134","difficulty":"basic","type":"choice","prompt":"岩石是由什么组成的？","choices":[{"key":"A","text":"土壤"},{"key":"B","text":"植物"},{"key":"C","text":"水"},{"key":"D","text":"一种或几种矿物"}],"answer":"D","explanation":"矿物是组成岩石的基本单位。","verify":"\"一种或几种矿物\""},{"id":"cns_p134_q2","topicId":"cns_p134","difficulty":"basic","type":"choice","prompt":"花岗岩里主要含有哪些矿物？","choices":[{"key":"A","text":"石英、长石、云母"},{"key":"B","text":"铁、铜、金"},{"key":"C","text":"钻石、红宝石"},{"key":"D","text":"盐和糖"}],"answer":"A","explanation":"这三种是花岗岩的主要矿物。","verify":"\"石英、长石、云母\""},{"id":"cns_p134_q3","topicId":"cns_p134","difficulty":"standard","type":"choice","prompt":"矿物在白瓷板上划出的颜色叫什么？","choices":[{"key":"A","text":"光泽"},{"key":"B","text":"条痕"},{"key":"C","text":"硬度"},{"key":"D","text":"形状"}],"answer":"B","explanation":"条痕颜色可以帮助鉴别矿物。","verify":"\"条痕\""},{"id":"cns_p134_q4","topicId":"cns_p134","difficulty":"challenge","type":"choice","prompt":"用指甲刻不动、用小刀能刻出痕迹的矿物，硬度怎样？","choices":[{"key":"A","text":"比小刀硬"},{"key":"B","text":"比指甲软"},{"key":"C","text":"比指甲硬，比小刀软"},{"key":"D","text":"无法判断"}],"answer":"C","explanation":"根据能否被刻划比较硬度。","verify":"\"比指甲硬，比小刀软\""},{"id":"cns_p232_q1","topicId":"cns_p232","difficulty":"basic","type":"choice","prompt":"制作岩石和矿物标本，主要是为了什么？","choices":[{"key":"A","text":"把它们变成土壤"},{"key":"B","text":"把收集到的岩石和矿物整理好，方便以后观察和比较"},{"key":"C","text":"把它们当成食物"},{"key":"D","text":"让它们消失"}],"answer":"B","explanation":"标本是为了保存样品，便于反复观察和比较。","verify":"\"把收集到的岩石和矿物整理好，方便以后观察和比较\""},{"id":"cns_p232_q2","topicId":"cns_p232","difficulty":"basic","type":"choice","prompt":"收集岩石和矿物做标本时，比较合适的做法是什么？","choices":[{"key":"A","text":"全部混在一起，不写名称"},{"key":"B","text":"只收集塑料玩具"},{"key":"C","text":"按种类分类收集，并贴上标签"},{"key":"D","text":"把已经写好的标签撕掉"}],"answer":"C","explanation":"分类并贴标签，以后才容易找到和辨认。","verify":"\"按种类分类收集，并贴上标签\""},{"id":"cns_p232_q3","topicId":"cns_p232","difficulty":"standard","type":"choice","prompt":"给岩石和矿物标本贴标签有什么用？","choices":[{"key":"A","text":"标签是为了让标本变重"},{"key":"B","text":"有了标签就不用再观察"},{"key":"C","text":"标签能把矿物变成岩石"},{"key":"D","text":"写清名称等信息，以后更容易辨认和比较"}],"answer":"D","explanation":"标签帮助我们记住每件标本是什么。","verify":"\"写清名称等信息，以后更容易辨认和比较\""},{"id":"cns_p232_q4","topicId":"cns_p232","difficulty":"challenge","type":"choice","prompt":"做好的岩石和矿物标本，适合用来做什么？","choices":[{"key":"A","text":"对照观察、比较不同岩石和矿物的特征"},{"key":"B","text":"拿来品尝味道"},{"key":"C","text":"放进火里烧"},{"key":"D","text":"用力摔碎比谁碎得快"}],"answer":"A","explanation":"标本用来安全地观察和比较，而不是破坏或品尝。","verify":"\"对照观察、比较不同岩石和矿物的特征\""},{"id":"cns_p135_q1","topicId":"cns_p135","difficulty":"basic","type":"choice","prompt":"沙和黏土主要是怎样形成的？","choices":[{"key":"A","text":"岩石经过长期风化破碎形成"},{"key":"B","text":"人工制造"},{"key":"C","text":"从天上掉下来"},{"key":"D","text":"植物长出来"}],"answer":"A","explanation":"岩石风化变成小颗粒。","verify":"\"岩石经过长期风化破碎形成\""},{"id":"cns_p135_q2","topicId":"cns_p135","difficulty":"basic","type":"choice","prompt":"沙和黏土相比，谁的颗粒更大？","choices":[{"key":"A","text":"黏土"},{"key":"B","text":"沙"},{"key":"C","text":"一样大"},{"key":"D","text":"都没有颗粒"}],"answer":"B","explanation":"沙粒较大，黏土颗粒非常细。","verify":"\"沙\""},{"id":"cns_p135_q3","topicId":"cns_p135","difficulty":"standard","type":"choice","prompt":"往装沙和装黏土的漏斗里同时倒水，哪个渗水更快？","choices":[{"key":"A","text":"黏土"},{"key":"B","text":"一样"},{"key":"C","text":"沙"},{"key":"D","text":"都不渗"}],"answer":"C","explanation":"沙粒间空隙大，渗水快。","verify":"\"沙\""},{"id":"cns_p135_q4","topicId":"cns_p135","difficulty":"challenge","type":"choice","prompt":"加水后能捏成形状、不容易散开的是什么？","choices":[{"key":"A","text":"沙"},{"key":"B","text":"小石子"},{"key":"C","text":"干树叶"},{"key":"D","text":"黏土"}],"answer":"D","explanation":"黏土黏性大，可塑性强。","verify":"\"黏土\""},{"id":"cns_p136_q1","topicId":"cns_p136","difficulty":"basic","type":"choice","prompt":"把土壤放进水中搅拌，静置后最下层是什么？","choices":[{"key":"A","text":"腐殖质"},{"key":"B","text":"较大的沙石颗粒"},{"key":"C","text":"水"},{"key":"D","text":"空气"}],"answer":"B","explanation":"较重的颗粒最先沉到底。","verify":"\"较大的沙石颗粒\""},{"id":"cns_p136_q2","topicId":"cns_p136","difficulty":"basic","type":"choice","prompt":"土壤中由动植物残体腐烂形成的物质叫什么？","choices":[{"key":"A","text":"沙子"},{"key":"B","text":"黏土"},{"key":"C","text":"腐殖质"},{"key":"D","text":"岩石"}],"answer":"C","explanation":"腐殖质给植物提供养料。","verify":"\"腐殖质\""},{"id":"cns_p136_q3","topicId":"cns_p136","difficulty":"standard","type":"choice","prompt":"把一块土放入水中会冒出气泡，说明土壤中有什么？","choices":[{"key":"A","text":"石油"},{"key":"B","text":"金属"},{"key":"C","text":"盐"},{"key":"D","text":"空气"}],"answer":"D","explanation":"土壤颗粒间有空气。","verify":"\"空气\""},{"id":"cns_p136_q4","topicId":"cns_p136","difficulty":"challenge","type":"choice","prompt":"下面哪些生物常在土壤里生活？","choices":[{"key":"A","text":"蚯蚓和蚂蚁"},{"key":"B","text":"金鱼和虾"},{"key":"C","text":"麻雀和老鹰"},{"key":"D","text":"海豚和鲸"}],"answer":"A","explanation":"土壤中生活着很多小动物。","verify":"\"蚯蚓和蚂蚁\""},{"id":"cns_p137_q1","topicId":"cns_p137","difficulty":"basic","type":"choice","prompt":"哪种土壤最适合大多数植物生长？","choices":[{"key":"A","text":"沙质土"},{"key":"B","text":"黏质土"},{"key":"C","text":"壤土"},{"key":"D","text":"纯沙子"}],"answer":"C","explanation":"壤土通气、保水能力适中。","verify":"\"壤土\""},{"id":"cns_p137_q2","topicId":"cns_p137","difficulty":"basic","type":"choice","prompt":"渗水最快、保水最差的土壤是哪种？","choices":[{"key":"A","text":"黏质土"},{"key":"B","text":"壤土"},{"key":"C","text":"都一样"},{"key":"D","text":"沙质土"}],"answer":"D","explanation":"沙质土颗粒大，渗水快。","verify":"\"沙质土\""},{"id":"cns_p137_q3","topicId":"cns_p137","difficulty":"standard","type":"choice","prompt":"比较三种土壤的渗水性，下面哪个做法公平？","choices":[{"key":"A","text":"取等量土壤，倒入等量的水，同时开始计时"},{"key":"B","text":"土壤一多一少"},{"key":"C","text":"倒水量不同"},{"key":"D","text":"先后不同时间开始"}],"answer":"A","explanation":"只改变土壤种类，其他条件相同。","verify":"\"取等量土壤，倒入等量的水，同时开始计时\""},{"id":"cns_p137_q4","topicId":"cns_p137","difficulty":"challenge","type":"choice","prompt":"同样浇水后，哪种土壤通常渗得更慢、保水更好？","choices":[{"key":"A","text":"沙质土"},{"key":"B","text":"黏质土"},{"key":"C","text":"纯沙子"},{"key":"D","text":"碎石"}],"answer":"B","explanation":"黏质土颗粒细，空隙小，水不容易很快渗走。","verify":"\"黏质土\""},{"id":"cns_p233_q1","topicId":"cns_p233","difficulty":"basic","type":"choice","prompt":"下面哪种做法能保护土壤？","choices":[{"key":"A","text":"大量乱砍树木"},{"key":"B","text":"把废电池埋进土里"},{"key":"C","text":"植树种草，回收废电池"},{"key":"D","text":"过度放牧"}],"answer":"C","explanation":"植被能防止水土流失，废电池会污染土壤。","verify":"\"植树种草，回收废电池\""},{"id":"cns_p233_q2","topicId":"cns_p233","difficulty":"basic","type":"choice","prompt":"岩石和人类生活有什么关系？","choices":[{"key":"A","text":"岩石只能用来吃"},{"key":"B","text":"岩石会代替空气"},{"key":"C","text":"岩石和人的生活没有关系"},{"key":"D","text":"房屋、道路等常常用到岩石或石材"}],"answer":"D","explanation":"岩石是生活中常见的建筑和铺路材料。","verify":"\"房屋、道路等常常用到岩石或石材\""},{"id":"cns_p233_q3","topicId":"cns_p233","difficulty":"standard","type":"choice","prompt":"土壤对人类生活有什么作用？","choices":[{"key":"A","text":"土壤能生长庄稼和植物，提供食物和木材"},{"key":"B","text":"土壤不能生长植物"},{"key":"C","text":"土壤只能用来玩耍，没有别的用处"},{"key":"D","text":"土壤和人的生活无关"}],"answer":"A","explanation":"土壤支撑植物生长，生活离不开它。","verify":"\"土壤能生长庄稼和植物，提供食物和木材\""},{"id":"cns_p233_q4","topicId":"cns_p233","difficulty":"challenge","type":"choice","prompt":"下面哪种做法有利于保护土壤？","choices":[{"key":"A","text":"把垃圾埋进农田"},{"key":"B","text":"合理种植，减少乱扔会污染土壤的垃圾"},{"key":"C","text":"把地表植物全部清除"},{"key":"D","text":"在坡地上过度开垦"}],"answer":"B","explanation":"合理利用土地、少污染，才能让土壤继续为我们服务。","verify":"\"合理种植，减少乱扔会污染土壤的垃圾\""}]
