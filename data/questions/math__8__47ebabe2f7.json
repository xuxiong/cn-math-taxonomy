[{"id":"cnm_172_q1","topicId":"cnm_172","difficulty":"standard","type":"choice","prompt":"计算 √12+√27-√3。","answer":"C","choices":[{"key":"A","text":"6"},{"key":"B","text":"5√3"},{"key":"C","text":"4√3"},{"key":"D","text":"2√3"}],"explanation":"先化简：√12=2√3，√27=3√3，合并 2√3+3√3-√3=4√3。"},{"id":"cnm_172_q2","topicId":"cnm_172","difficulty":"basic","type":"numeric","prompt":"计算 √8+√18，结果等于 k√2，则 k 等于多少？","answer":"5","explanation":"√8=2√2，√18=3√2，和为 5√2，所以 k=5。","verify":"(sqrt(8)+sqrt(18))/sqrt(2)"},{"id":"cnm_172_q3","topicId":"cnm_172","difficulty":"standard","type":"choice","prompt":"下列计算正确的是","answer":"D","choices":[{"key":"A","text":"√2+√3=√5"},{"key":"B","text":"3√2-√2=3"},{"key":"C","text":"√12+√3=√15"},{"key":"D","text":"√8-√2=√2"}],"explanation":"√8-√2=2√2-√2=√2；√2 与 √3 不是同类根式不能合并；3√2-√2=2√2；√12+√3=2√3+√3=3√3。"},{"id":"cnm_172_q4","topicId":"cnm_172","difficulty":"advanced","type":"numeric","prompt":"计算 √(1/2)+√8，结果等于 k√2，k 写成最简分数，则 k 等于多少？","answer":"5/2","explanation":"√(1/2)=√2/2，√8=2√2，和为 (1/2+2)√2=(5/2)√2，所以 k=5/2。","verify":"(sqrt(Fraction(1,2))+sqrt(8))/sqrt(2)"},{"id":"cnm_173_q1","topicId":"cnm_173","difficulty":"standard","type":"choice","prompt":"计算 (√5+√2)(√5-√2)+(√3-1)²。","answer":"A","choices":[{"key":"A","text":"7-2√3"},{"key":"B","text":"4-2√3"},{"key":"C","text":"7+2√3"},{"key":"D","text":"6"}],"explanation":"平方差：(√5)²-(√2)²=3；完全平方：(√3-1)²=3-2√3+1=4-2√3；相加得 7-2√3。"},{"id":"cnm_173_q2","topicId":"cnm_173","difficulty":"basic","type":"numeric","prompt":"计算 (√3+1)(√3-1)。","answer":"2","explanation":"平方差公式：(√3)²-1²=3-1=2。","verify":"sqrt(3)**2-1**2"},{"id":"cnm_173_q3","topicId":"cnm_173","difficulty":"standard","type":"numeric","prompt":"计算 √48÷√3 - √(1/2)×√8 + (-3)^0。","answer":"3","explanation":"√48÷√3=√16=4；√(1/2)×√8=√4=2；(-3)^0=1；所以 4-2+1=3。","verify":"sqrt(48/3) - sqrt(Fraction(1,2)*8) + 1"},{"id":"cnm_173_q4","topicId":"cnm_173","difficulty":"advanced","type":"numeric","prompt":"已知 x=√3+1，y=√3-1，求 x²+y² 的值。","answer":"8","explanation":"x²=4+2√3，y²=4-2√3，相加得 8（也可用 x²+y²=(x+y)²-2xy=12-4）。","verify":"(sqrt(3)+1)**2+(sqrt(3)-1)**2"}]
