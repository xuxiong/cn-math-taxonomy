[{"id":"cnp_025_q1","topicId":"cnp_025","difficulty":"basic","type":"choice","prompt":"一名中学生的质量大约是多少？","choices":[{"key":"A","text":"50 g"},{"key":"B","text":"500 kg"},{"key":"C","text":"5 kg"},{"key":"D","text":"50 kg"}],"answer":"D","explanation":"中学生质量约 50 kg；估测是本节要求之一。","verify":"\"50 kg\""},{"id":"cnp_025_q2","topicId":"cnp_025","difficulty":"basic","type":"choice","prompt":"一块冰熔化成水后，质量怎样变化？","choices":[{"key":"A","text":"变大"},{"key":"B","text":"变小"},{"key":"C","text":"不变"},{"key":"D","text":"无法确定"}],"answer":"C","explanation":"质量是物体的属性，不随状态改变；冰熔化后体积变小，但质量不变。","verify":"\"不变\""},{"id":"cnp_025_q3","topicId":"cnp_025","difficulty":"standard","type":"choice","prompt":"用天平称物体，右盘砝码 50 g、20 g、5 g 各一个，游码示数 2.4 g，物体质量是多少？","choices":[{"key":"A","text":"75 g"},{"key":"B","text":"72.6 g"},{"key":"C","text":"77.4 g"},{"key":"D","text":"77 g"}],"answer":"C","explanation":"物体质量 = 砝码总质量 + 游码示数 = 75 + 2.4 = 77.4 g。","verify":"50+20+5+2.4"},{"id":"cnp_025_q4","topicId":"cnp_025","difficulty":"standard","type":"choice","prompt":"调节天平横梁平衡时，指针偏向分度盘左侧，平衡螺母应怎样调？","choices":[{"key":"A","text":"向右调"},{"key":"B","text":"向左调"},{"key":"C","text":"移动游码"},{"key":"D","text":"在右盘加砝码"}],"answer":"A","explanation":"调节横梁平衡时“左偏右调、右偏左调”；称量过程中才通过加减砝码、移动游码来平衡。","verify":"\"向右调\""}]
