[{"id":"cne_p021_q1","topicId":"cne_p021","difficulty":"basic","type":"choice","prompt":"哪一句表示「我喜欢面包」？","choices":[{"key":"A","text":"I likes bread."},{"key":"B","text":"Like I bread."},{"key":"C","text":"I like bread."},{"key":"D","text":"I like am bread."}],"answer":"C","explanation":"喜欢一件事物说 I like bread。","verify":"\"I like bread.\""},{"id":"cne_p021_q2","topicId":"cne_p021","difficulty":"basic","type":"choice","prompt":"I like milk. 这句的意思是？","choices":[{"key":"A","text":"我不喜欢牛奶"},{"key":"B","text":"我有牛奶"},{"key":"C","text":"牛奶喜欢我"},{"key":"D","text":"我喜欢牛奶"}],"answer":"D","explanation":"like 在这里是喜欢。","verify":"\"我喜欢牛奶\""},{"id":"cne_p021_q3","topicId":"cne_p021","difficulty":"standard","type":"choice","prompt":"哪一句是正确的？","choices":[{"key":"A","text":"I like apples."},{"key":"B","text":"I likes apples."},{"key":"C","text":"I like am apples."},{"key":"D","text":"Like I apples."}],"answer":"A","explanation":"I 后面用 like，不加 s。","verify":"\"I like apples.\""},{"id":"cne_p021_q4","topicId":"cne_p021","difficulty":"standard","type":"choice","prompt":"I do not like rice. 这句的意思是？","choices":[{"key":"A","text":"我喜欢米饭"},{"key":"B","text":"我不喜欢米饭"},{"key":"C","text":"我没有米饭"},{"key":"D","text":"米饭不喜欢我"}],"answer":"B","explanation":"do not like 表示不喜欢。","verify":"\"我不喜欢米饭\""},{"id":"cne_p050_q1","topicId":"cne_p050","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「梨」？","choices":[{"key":"A","text":"apple"},{"key":"B","text":"banana"},{"key":"C","text":"orange"},{"key":"D","text":"pear"}],"answer":"D","explanation":"pear 的意思是梨。","verify":"\"pear\""},{"id":"cne_p050_q2","topicId":"cne_p050","difficulty":"basic","type":"choice","prompt":"「apple」的中文意思是哪一个？","choices":[{"key":"A","text":"苹果"},{"key":"B","text":"梨"},{"key":"C","text":"香蕉"},{"key":"D","text":"橙子"}],"answer":"A","explanation":"apple 的意思是苹果。","verify":"\"苹果\""},{"id":"cne_p050_q3","topicId":"cne_p050","difficulty":"standard","type":"choice","prompt":"选择表示「香蕉」的单词。","choices":[{"key":"A","text":"pear"},{"key":"B",