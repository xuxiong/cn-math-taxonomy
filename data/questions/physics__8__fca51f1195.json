[{"id":"cnp_029_q1","topicId":"cnp_029","difficulty":"basic","type":"choice","prompt":"力的单位是什么？","choices":[{"key":"A","text":"千克（kg）"},{"key":"B","text":"帕斯卡（Pa）"},{"key":"C","text":"焦耳（J）"},{"key":"D","text":"牛顿（N）"}],"answer":"D","explanation":"力的单位是牛顿，简称牛，符号 N；千克是质量单位。","verify":"\"牛顿（N）\""},{"id":"cnp_029_q2","topicId":"cnp_029","difficulty":"basic","type":"choice","prompt":"游泳时人向后划水，人却向前进，说明了什么？","choices":[{"key":"A","text":"力能改变物体的形状"},{"key":"B","text":"物体间力的作用是相互的"},{"key":"C","text":"力的作用效果与大小无关"},{"key":"D","text":"人不受力也能前进"}],"answer":"B","explanation":"手向后推水，水同时向前推手，物体间力的作用是相互的。","verify":"\"物体间力的作用是相互的\""},{"id":"cnp_029_q3","topicId":"cnp_029","difficulty":"standard","type":"choice","prompt":"用力推门，推门的位置离门轴越远越容易推开，说明力的作用效果与什么有关？","choices":[{"key":"A","text":"力的作用点"},{"key":"B","text":"力的大小"},{"key":"C","text":"力的方向"},{"key":"D","text":"门的质量"}],"answer":"A","explanation":"推力的大小、方向不变，只改变推的位置，效果不同，说明作用效果与作用点有关。","verify":"\"力的作用点\""},{"id":"cnp_029_q4","topicId":"cnp_029","difficulty":"standard","type":"choice","prompt":"下列现象中，力改变了物体运动状态的是哪一个？","choices":[{"key":"A","text":"用力把弹簧拉长"},{"key":"B","text":"用力捏橡皮泥"},{"key":"C","text":"风把小树吹弯"},{"key":"D","text":"守门员接住飞来的足球"}],"answer":"D","explanation":"足球由运动变为静止，运动状态改变；其余三项是改变物体形状。","verify":"\"守门员接住飞来的足球\""}]
