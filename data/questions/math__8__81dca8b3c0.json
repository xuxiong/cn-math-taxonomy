[{"id":"cnm_218_q1","topicId":"cnm_218","difficulty":"basic","type":"choice","prompt":"怎样比较两个班的体质测试成绩？","choices":[{"key":"A","text":"只比较各班的最高分"},{"key":"B","text":"只比较各班的人数"},{"key":"C","text":"用平均数比较整体水平，用方差比较整齐程度"},{"key":"D","text":"只比较各班的最低分"}],"answer":"C","explanation":"平均数反映整体水平，方差反映数据的波动（整齐）程度，两者结合才能全面比较。"},{"id":"cnm_218_q2","topicId":"cnm_218","difficulty":"basic","type":"numeric","prompt":"某班 5 名同学 1 分钟跳绳个数为 120、130、140、150、160，平均每人跳多少个？","answer":"140","explanation":"总和 700，平均数=700÷5=140。","verify":"Fraction(120+130+140+150+160,5)"},{"id":"cnm_218_q3","topicId":"cnm_218","difficulty":"standard","type":"numeric","prompt":"甲班抽取 5 名同学的体测成绩为 80、82、78、84、76，平均数为 80，求方差。","answer":"8","explanation":"方差=[0+2^2+(-2)^2+4^2+(-4)^2]÷5=(0+4+4+16+16)÷5=8。","verify":"Fraction(sum([(x-80)**2 for x in [80,82,78,84,76]]),5)"},{"id":"cnm_218_q4","topicId":"cnm_218","difficulty":"standard","type":"choice","prompt":"要了解全校 1200 名学生的体质状况，下列抽样方案最合理的是（ ）","choices":[{"key":"A","text":"从各年级随机抽取若干名学生"},{"key":"B","text":"只抽取校田径队的学生"},{"key":"C","text":"只抽取七年级学生"},{"key":"D","text":"只抽取自愿报名的学生"}],"answer":"A","explanation":"样本要有代表性，应覆盖各年级并随机抽取；B、C、D 都会使样本偏向某一类学生。"},{"id":"cnm_218_q5","topicId":"cnm_218","difficulty":"advanced","type":"numeric","prompt":"全校 1200 名学生，随机抽取 50 名测试，其中 40 名达标。估计全校达标人数是多少？","answer":"960","explanation":"样本达标率 40/50=80%，估计全校达标人数 1200×80%=960。","verify":"1200*40//50"}]
