[{"difficulty":"basic","type":"numeric","prompt":"男生 16 人，女生 14 人。全班一共有多少人？","answer":"30","explanation":"两部分相加是总数：16＋14＝30。","verify":"16+14","id":"cnm_p035_q1","topicId":"cnm_p035"},{"difficulty":"basic","type":"numeric","prompt":"桃树和梨树一共 35 棵，桃树 15 棵。梨树有多少棵？","answer":"20","explanation":"总数减去一部分：35－15＝20。","verify":"35-15","id":"cnm_p035_q2","topicId":"cnm_p035"},{"difficulty":"standard","type":"numeric","prompt":"果园里有桃树和梨树共 40 棵，桃树 18 棵。梨树有多少棵？","answer":"22","explanation":"40－18＝22（棵）。","verify":"40-18","id":"cnm_p035_q3","topicId":"cnm_p035"},{"difficulty":"challenge","type":"numeric","prompt":"桃树和梨树共 40 棵，桃树 18 棵。又栽了 5 棵梨树。现在梨树有多少棵？","answer":"27","explanation":"原来梨树 40－18＝22 棵，再栽 5 棵，是 27 棵。","verify":"40-18+5","id":"cnm_p035_q4","topicId":"cnm_p035"},{"difficulty":"basic","type":"numeric","prompt":"15 比 9 多几？","answer":"6","explanation":"求一个数比另一个数多几，用减法：15－9＝6。","verify":"15-9","id":"cnm_p217_q1","topicId":"cnm_p217"},{"difficulty":"basic","type":"numeric","prompt":"红花有 42 朵，黄花有 30 朵。红花比黄花多多少朵？","answer":"12","explanation":"42－30＝12（朵）。","verify":"42-30","id":"cnm_p217_q2","topicId":"cnm_p217"},{"difficulty":"standard","type":"numeric","prompt":"小明跳绳跳了 56 下，小军跳了 71 下。小明比小军少跳多少下？","answer":"15","explanation":"少几也用减法：71－56＝15。","verify":"71-56","id":"cnm_p217_q3","topicId":"cnm_p217"},{"difficulty":"challenge","type":"numeric","prompt":"一班 38 人，二班 45 人，三班 40 人。二班比一班多几人？","answer":"7","explanation":"问的是二班和一班，45－38＝7。三班的 40 不用。","verify":"45-38","id":"cnm_p217_q4","topicId":"cnm_p217"},{"difficulty":"basic","type":"numeric","prompt":"小猫钓了 12 条鱼，小狗比小猫多钓 5 条。小狗钓了多少条？","answer":"17","explanation":"比 12 多 5，用加法：12＋5＝17。","verify":"12+5","id":"cnm_p218_q1","topicId":"cnm_p218"},{"difficulty":"basic","type":"numeric","prompt":"树上有 40 只鸟，地上的比树上少 8 只。地上有多少只？","answer":"32","explanation":"比 40 少 8，用减法：40－8＝32。","verify":"40-8","id":"cnm_p218_q2","topicId":"cnm_p218"},{"difficulty":"standard","type":"numeric","prompt":"妈妈买了 35 个苹果，梨比苹果少 9 个。梨有多少个？","answer":"26","explana