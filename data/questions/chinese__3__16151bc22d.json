[{"id":"cnc_p158_q1","topicId":"cnc_p158","difficulty":"basic","type":"choice","prompt":"课文写的学校在什么样的地方？","choices":[{"key":"A","text":"繁华的大城市中心"},{"key":"B","text":"海岛上的渔村"},{"key":"C","text":"只有一个院子的私塾"},{"key":"D","text":"边疆"}],"answer":"D","explanation":"课文说这就是我们可爱的小学，一所边疆的小学。","verify":"\"边疆\""},{"id":"cnc_p158_q2","topicId":"cnc_p158","difficulty":"basic","type":"choice","prompt":"来上学的孩子有什么特点？","choices":[{"key":"A","text":"有好几个民族的小朋友"},{"key":"B","text":"只有一个民族的孩子"},{"key":"C","text":"都是外地来的老师"},{"key":"D","text":"学校里没有学生"}],"answer":"A","explanation":"汉族、傣族、景颇族和其他民族的小学生，走在同一条上学的路上。","verify":"\"有好几个民族的小朋友\""},{"id":"cnc_p158_q3","topicId":"cnc_p158","difficulty":"standard","type":"choice","prompt":"下课以后，孩子们常常在哪里活动？","choices":[{"key":"A","text":"在井里"},{"key":"B","text":"大青树下"},{"key":"C","text":"在瓮旁边"},{"key":"D","text":"在海底"}],"answer":"B","explanation":"凤尾竹的影子里，大青树下成了他们游戏、舞蹈的地方。","verify":"\"大青树下\""},{"id":"cnc_p158_q4","topicId":"cnc_p158","difficulty":"standard","type":"choice","prompt":"这所小学最让人记住的是什么？","choices":[{"key":"A","text":"学校不上课"},{"key":"B","text":"大家互相不说话"},{"key":"C","text":"不同民族的孩子在一起学习、一起玩"},{"key":"D","text":"只有老师没有学生"}],"answer":"C","explanation":"他们穿着鲜艳的衣服来上学，在同一间教室里读书。","verify":"\"不同民族的孩子在一起学习、一起玩\""},{"id":"cnc_p159_q1","topicId":"cnc_p159","difficulty":"basic","type":"choice","prompt":"《花的学校》的作者是谁？","choices":[{"key":"A","text":"泰戈尔"},{"key":"B","text":"张天翼"},{"key":"C","text":"叶圣陶"},{"key":"D","text":"贾尼·罗大里"}],"answer":"A","explanation":"这篇是泰戈尔写的。张天翼写《宝葫芦的秘密》，贾尼·罗大里写《小狗学叫》。","verify":"\"泰戈尔\""},{"id":"cnc_p159_q2","topicId":"cnc_p159","difficulty":"basic","type":"choice","prompt":"「我」觉得那些花在哪里上学？","choices":[{"key":"A","text":"大青树下的小学"},{"key":"B","text":"地下的学校"},{"key":"C","text":"先生的私塾"},{"key":"D","text":"星星上面的课堂"}],"answer":"B","explanation":"花关了门在地下做功课。星星所住的地方是它们的家，不是学校。","verify":"\"地下的学校\""},{"id":"cnc_p159_q3","topicId":"cnc_p159","difficulty":"standard","type":"choice","prompt":"雨还没来、它们想提早出来玩时，老师会怎样？","choices":[{"key":"A","text":"马上放假"},{"key":"B","text":"带它们去天上找妈妈"},{"key":"C","text":"罚它们站壁角"},{"key":"D","text":"让它们到大青树下跳舞"}],"answer":"C","explanation":"做功课的时候不许随便出来。雨一来，它们才放假。","verify":"\"罚它们站壁角\""},{"id":"cnc_p159_q4","topicId":"cnc_p159","difficulty":"standard","type":"choice","prompt":"放假以后，花孩子们急着要到哪里去？","choices":[{"key":"A","text":"去私塾问先生一句话"},{"key":"B","text":"去西沙群岛看鱼"},{"key":"C","text":"钻进牛肚子里"},{"key":"D","text":"天上星星所住的地方，去找它们的妈妈"}],"answer":"D","explanation":"它们穿上紫的、黄的、白的衣裳冲出来，扬起双臂，因为它们也有自己的妈妈。","verify":"\"天上星星所住的地方，去找它们的妈妈\""},{"id":"cnc_p160_q1","topicId":"cnc_p160","difficulty":"basic","type":"choice","prompt":"课文里勤学好问的小朋友是谁？","choices":[{"key":"A","text":"司马光"},{"key":"B","text":"孙中山"},{"key":"C","text":"列宁"},{"key":"D","text":"曹冲"}],"answer":"B","explanation":"课文写的是孙中山小时候在私塾读书的事。","verify":"\"孙中山\""},{"id":"cnc_p160_q2","topicId":"cnc_p160","difficulty":"basic","type":"choice","prompt":"先生让学生怎样读书？","choices":[{"key":"A","text":"先把意思讨论清楚再读"},{"key":"B","text":"只用眼睛看、不许出声"},{"key":"C","text":"摇头晃脑地跟着念"},{"key":"D","text":"自己回家就不读了"}],"answer":"C","explanation":"那时候学生并不懂得句子的意思，只是跟着先生齐读。","verify":"\"摇头晃脑地跟着念\""},{"id":"cnc_p160_q3","topicId":"cnc_p160","difficulty":"standard","type":"choice","prompt":"孙中山做了一件什么让同学吃惊的事？","choices":[{"key":"A","text":"他把书合上就走了"},{"key":"B","text":"他跳进水缸里"},{"key":"C","text":"他不许别人提问"},{"key":"D","text":"他站起来问先生这句话是什么意思"}],"answer":"D","explanation":"同学们都吓呆了。那时候学生通常不敢打断先生。","verify":"\"他站起来问先生这句话是什么意思\""},{"id":"cnc_p160_q4","topicId":"cnc_p160","difficulty":"standard","type":"choice","prompt":"先生怎样评价这件事？","choices":[{"key":"A","text":"这样很好，不懂就要问"},{"key":"B","text":"提问要受罚"},{"key":"C","text":"书只要会背，不用懂"},{"key":"D","text":"以后不许再问"}],"answer":"A","explanation":"先生说：学问学问，不懂就要问。为了弄清道理，问一问是好的。","verify":"\"这样很好，不懂就要问\""},{"id":"cnc_p161_q1","topicId":"cnc_p161","difficulty":"basic","type":"choice","prompt":"已经知道「花」读 huā，适合先用哪种查法？","choices":[{"key":"A","text":"部首查字法"},{"key":"B","text":"随便从最后一页翻起"},{"key":"C","text":"音序查字法"},{"key":"D","text":"只看插图不查字"}],"answer":"C","explanation":"知道读音，就按音序去查。不知道读音，才先用部首。","verify":"\"音序查字法\""},{"id":"cnc_p161_q2","topicId":"cnc_p161","difficulty":"basic","type":"choice","prompt":"「花 huā」应到哪个字母里去找？","choices":[{"key":"A","text":"字母 F"},{"key":"B","text":"字母 U"},{"key":"C","text":"字母 A"},{"key":"D","text":"字母 H"}],"answer":"D","explanation":"花的拼音是 huā，音序看第一个字母 h，到 H 里找。","verify":"\"字母 H\""},{"id":"cnc_p161_q3","topicId":"cnc_p161","difficulty":"standard","type":"choice","prompt":"「山 shān」应到哪个字母里去找？","choices":[{"key":"A","text":"字母 S"},{"key":"B","text":"字母 H"},{"key":"C","text":"字母 C"},{"key":"D","text":"字母 Z"}],"answer":"A","explanation":"山的声母是 sh，音序取第一个字母 s。不要按翘舌音去找别的字母。","verify":"\"字母 S\""},{"id":"cnc_p161_q4","topicId":"cnc_p161","difficulty":"standard","type":"choice","prompt":"音序查字法的第一步是什么？","choices":[{"key":"A","text":"先数部首有几画"},{"key":"B","text":"确定音节的第一个字母"},{"key":"C","text":"先把字典倒过来"},{"key":"D","text":"先猜一个完全不同的读音"}],"answer":"B","explanation":"音序就是字母顺序。先看第一个字母，再在那一部里找音节。","verify":"\"确定音节的第一个字母\""},{"id":"cnc_p162_q1","topicId":"cnc_p162","difficulty":"basic","type":"choice","prompt":"「河」用部首查字法，部首是哪一个？","choices":[{"key":"A","text":"可"},{"key":"B","text":"口"},{"key":"C","text":"木"},{"key":"D","text":"三点水"}],"answer":"D","explanation":"河的左边是三点水。可是另一部分，不是部首。","verify":"\"三点水\""},{"id":"cnc_p162_q2","topicId":"cnc_p162","difficulty":"basic","type":"choice","prompt":"「草」用部首查字法，部首是哪一个？","choices":[{"key":"A","text":"草字头"},{"key":"B","text":"早"},{"key":"C","text":"日"},{"key":"D","text":"木"}],"answer":"A","explanation":"草的上面是草字头。早不是它的部首。","verify":"\"草字头\""},{"id":"cnc_p162_q3","topicId":"cnc_p162","difficulty":"standard","type":"choice","prompt":"「打」的部首是哪一个？","choices":[{"key":"A","text":"丁"},{"key":"B","text":"提手旁"},{"key":"C","text":"口"},{"key":"D","text":"木"}],"answer":"B","explanation":"打是提手旁。丁是声旁，查部首时不先查丁。","verify":"\"提手旁\""},{"id":"cnc_p162_q4","topicId":"cnc_p162","difficulty":"standard","type":"choice","prompt":"不知道读音时，更适合用哪种查法？","choices":[{"key":"A","text":"音序查字法"},{"key":"B","text":"把字典从后往前随便翻"},{"key":"C","text":"部首查字法"},{"key":"D","text":"只猜一个读音就写上去"}],"answer":"C","explanation":"音序要先知道读音。一个字还不认识时，可以先按部首去找。","verify":"\"部首查字法\""}]
