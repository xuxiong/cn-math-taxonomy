[{"id":"cnm_012_q1","topicId":"cnm_012","difficulty":"basic","type":"numeric","prompt":"计算 3-(-5) 和 (-2)-7。（依次作答，用逗号隔开）","answer":"8，-9","explanation":"减去一个数等于加上它的相反数：3-(-5)=3+5=8；(-2)-7=(-2)+(-7)=-9。","verify":"[3-(-5), -2-7]"},{"id":"cnm_012_q2","topicId":"cnm_012","difficulty":"basic","type":"numeric","prompt":"计算 (-4)-(-9)。","answer":"5","explanation":"(-4)-(-9)=(-4)+9=5。","verify":"-4-(-9)"},{"id":"cnm_012_q3","topicId":"cnm_012","difficulty":"basic","type":"choice","prompt":"下列各式中，与 5-(-3) 的值相等的是哪一个？","choices":[{"key":"A","text":"5-3"},{"key":"B","text":"5+3"},{"key":"C","text":"-5+3"},{"key":"D","text":"-5-3"}],"answer":"B","explanation":"减去 -3 等于加上它的相反数 3，所以 5-(-3)=5+3=8。"},{"id":"cnm_012_q4","topicId":"cnm_012","difficulty":"standard","type":"numeric","prompt":"计算 (-3/4)-(5/6)，结果写成最简分数。","answer":"-19/12","explanation":"(-3/4)-(5/6)=(-3/4)+(-5/6)=-9/12-10/12=-19/12。","verify":"Fraction(-3,4)-Fraction(5,6)"},{"id":"cnm_012_q5","topicId":"cnm_012","difficulty":"standard","type":"numeric","prompt":"某地某天最高气温是 3 ℃，最低气温是 -9 ℃，这一天的温差是多少 ℃？","answer":"12","explanation":"温差=最高气温-最低气温=3-(-9)=3+9=12（℃）。","verify":"3-(-9)"},{"id":"cnm_013_q1","topicId":"cnm_013","difficulty":"basic","type":"numeric","prompt":"计算 -3+8-(-2)-5。","answer":"2","explanation":"先化为省略括号的和：-3+8+2-5，再计算：（-3-5）+（8+2）=-8+10=2。","verify":"-3+8-(-2)-5"},{"id":"cnm_013_q2","topicId":"cnm_013","difficulty":"basic","type":"numeric","prompt":"计算 (-4)-(-6)+(-3)。","answer":"-1","explanation":"减法化为加法：(-4)+6+(-3)=-4+6-3=-1。","verify":"-4-(-6)+(-3)"},{"id":"cnm_013_q3","topicId":"cnm_013","difficulty":"basic","type":"choice","prompt":"把 -3+(-5)-(-7)+2 写成省略加号和括号的和的形式，正确的是哪一个？","choices":[{"key":"A","text":"-3-5+7+2"},{"key":"B","text":"-3-5-7+2"},{"key":"C","text":"-3+5+7+2"},{"key":"D","text":"-3-5+7-2"}],"answer":"A","explanation":"+(-5) 写作 -5；-(-7) 写作 +7；+2 保持不变，所以是 -3-5+7+2。"},{"id":"cnm_013_q4","topicId":"cnm_013","difficulty":"standard","type":"numeric","prompt":"计算 1/2-(-3/4)+(-5/4)-1/2。","answer":"-1/2","explanation":"化为 1/2+3/4-5/4-1/2，1/2 与 -1/2 抵消，3/4-5/4=-1/2。","verify":"Fraction(1,2)-Fraction(-3,4)+Fraction(-5,4)-Fraction(1,2)"},{"id":"cnm_013_q5","topicId":"cnm_013","difficulty":"advanced","type":"numeric","prompt":"计算 1-2+3-4+5-6+…+99-100 的值。","answer":"-50","explanation":"两项一组：(1-2)+(3-4)+…+(99-100)，共 50 组，每组为 -1，所以和为 -50。","verify":"sum([(-1)**(k+1)*k for k in range(1,101)])"}]
