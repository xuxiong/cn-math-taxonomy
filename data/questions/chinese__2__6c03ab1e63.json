[{"id":"cnc_p129_q1","topicId":"cnc_p129","difficulty":"basic","type":"choice","prompt":"「我神州，称华夏」的下一句是哪一句？","choices":[{"key":"A","text":"黄河奔，长江涌"},{"key":"B","text":"长城长，珠峰耸"},{"key":"C","text":"山川美，可入画"},{"key":"D","text":"台湾岛，隔海峡"}],"answer":"C","explanation":"先说山川美得可以画下来，后面才写黄河、长江。","verify":"\"山川美，可入画\""},{"id":"cnc_p129_q2","topicId":"cnc_p129","difficulty":"basic","type":"choice","prompt":"「黄河奔，长江涌」的下一句是哪一句？","choices":[{"key":"A","text":"与大陆，是一家"},{"key":"B","text":"各民族，情谊浓"},{"key":"C","text":"山川美，可入画"},{"key":"D","text":"长城长，珠峰耸"}],"answer":"D","explanation":"奔涌的大河后面，是长城和珠穆朗玛峰。","verify":"\"长城长，珠峰耸\""},{"id":"cnc_p129_q3","topicId":"cnc_p129","difficulty":"standard","type":"choice","prompt":"「台湾岛，隔海峡」后面说它和谁是一家？","choices":[{"key":"A","text":"与大陆是一家"},{"key":"B","text":"与黄河是一家"},{"key":"C","text":"与珠峰隔海相望、互不相关"},{"key":"D","text":"只和长城是一家"}],"answer":"A","explanation":"台湾岛隔着海峡，与大陆是一家。","verify":"\"与大陆是一家\""},{"id":"cnc_p129_q4","topicId":"cnc_p129","difficulty":"standard","type":"choice","prompt":"课文怎样写各民族？","choices":[{"key":"A","text":"各自生活，互不往来"},{"key":"B","text":"情谊浓，齐奋发"},{"key":"C","text":"只住在台湾岛上"},{"key":"D","text":"都住在长城下面"}],"answer":"B","explanation":"各民族情谊浓，齐奋发，共荣光。","verify":"\"情谊浓，齐奋发\""},{"id":"cnc_p130_q1","topicId":"cnc_p130","difficulty":"basic","type":"choice","prompt":"端午节有哪些习俗？","choices":[{"key":"A","text":"赏月、吃月饼"},{"key":"B","text":"登高、赏菊"},{"key":"C","text":"看花灯"},{"key":"D","text":"吃粽子、赛龙舟"}],"answer":"D","explanation":"过端午，赛龙舟，粽子飘香。赏月吃月饼是中秋。","verify":"\"吃粽子、赛龙舟\""},{"id":"cnc_p130_q2","topicId":"cnc_p130","difficulty":"basic","type":"choice","prompt":"中秋节人们常常做什么？","choices":[{"key":"A","text":"赏月、吃月饼"},{"key":"B","text":"赛龙舟"},{"key":"C","text":"扫墓踏青"},{"key":"D","text":"贴窗花放鞭炮"}],"answer":"A","explanation":"过中秋，吃月饼，十五的圆月当空照。","verify":"\"赏月、吃月饼\""},{"id":"cnc_p130_q3","topicId":"cnc_p130","difficulty":"standard","type":"choice","prompt":"清明节常常做什么？","choices":[{"key":"A","text":"乞巧"},{"key":"B","text":"扫墓、踏青"},{"key":"C","text":"看花灯"},{"key":"D","text":"登高插茱萸"}],"answer":"B","explanation":"清明节雨纷纷，人们到先人墓前祭扫，也出门踏青。乞巧是七夕。","verify":"\"扫墓、踏青\""},{"id":"cnc_p130_q4","topicId":"cnc_p130","difficulty":"standard","type":"choice","prompt":"重阳节的习俗是哪一个？","choices":[{"key":"A","text":"赛龙舟"},{"key":"B","text":"贴春联"},{"key":"C","text":"登高、敬老"},{"key":"D","text":"吃元宵"}],"answer":"C","explanation":"重阳节要敬老，人们踏秋赏菊、登高。贴春联是春节。","verify":"\"登高、敬老\""},{"id":"cnc_p131_q1","topicId":"cnc_p131","difficulty":"basic","type":"choice","prompt":"古代人们曾经把什么当成钱币？","choices":[{"key":"A","text":"贝壳"},{"key":"B","text":"树叶"},{"key":"C","text":"石头子"},{"key":"D","text":"雪花"}],"answer":"A","explanation":"海边的贝壳好看又难得，古时候曾经拿它当货币。","verify":"\"贝壳\""},{"id":"cnc_p131_q2","topicId":"cnc_p131","difficulty":"basic","type":"choice","prompt":"「财、购、贫」为什么都有贝字旁？","choices":[{"key":"A","text":"这些字都和水有关"},{"key":"B","text":"这些字的意思都和钱财有关"},{"key":"C","text":"这些字都是木字旁"},{"key":"D","text":"贝字旁表示颜色"}],"answer":"B","explanation":"和钱财有关的字，很多带贝字旁。","verify":"\"这些字的意思都和钱财有关\""},{"id":"cnc_p131_q3","topicId":"cnc_p131","difficulty":"standard","type":"choice","prompt":"下面哪个字和钱财有关，带贝字旁？","choices":[{"key":"A","text":"明"},{"key":"B","text":"林"},{"key":"C","text":"货"},{"key":"D","text":"跑"}],"answer":"C","explanation":"货是货物，有贝字旁。明是日和月，林是木，跑是足字旁。","verify":"\"货\""},{"id":"cnc_p131_q4","topicId":"cnc_p131","difficulty":"standard","type":"choice","prompt":"「贫」的贝字旁告诉我们什么？","choices":[{"key":"A","text":"它的意思和太阳有关"},{"key":"B","text":"它要读成贝"},{"key":"C","text":"它是一个树名"},{"key":"D","text":"它的意思和财物有关"}],"answer":"D","explanation":"贫是缺少财物。看到贝字旁，可以想到和钱财有关。","verify":"\"它的意思和财物有关\""},{"id":"cnc_p132_q1","topicId":"cnc_p132","difficulty":"basic","type":"choice","prompt":"哪一组菜名都在这篇课文里？","choices":[{"key":"A","text":"火锅、酸辣粉、汤圆"},{"key":"B","text":"凉拌菠菜、香煎豆腐、红烧茄子"},{"key":"C","text":"汉堡、薯条、三明治"},{"key":"D","text":"年糕、月饼、粽子"}],"answer":"B","explanation":"课文写了凉拌菠菜、香煎豆腐、红烧茄子，还有烤鸭、水煮鱼等。","verify":"\"凉拌菠菜、香煎豆腐、红烧茄子\""},{"id":"cnc_p132_q2","topicId":"cnc_p132","difficulty":"basic","type":"choice","prompt":"哪一种是课文里的主食？","choices":[{"key":"A","text":"葱爆羊肉"},{"key":"B","text":"水煮鱼"},{"key":"C","text":"炸酱面"},{"key":"D","text":"小鸡炖蘑菇"}],"answer":"C","explanation":"蒸饺、炸酱面、小米粥、蛋炒饭是主食。葱爆羊肉、水煮鱼、小鸡炖蘑菇是菜。","verify":"\"炸酱面\""},{"id":"cnc_p132_q3","topicId":"cnc_p132","difficulty":"standard","type":"choice","prompt":"「红烧茄子」里的「红烧」是什么？","choices":[{"key":"A","text":"一种蔬菜的名字"},{"key":"B","text":"一种餐具"},{"key":"C","text":"一种节日"},{"key":"D","text":"一种烹调方法"}],"answer":"D","explanation":"拌、煎、烧、烤、煮、爆、炖、蒸、炸、炒，都是做菜的方法。","verify":"\"一种烹调方法\""},{"id":"cnc_p132_q4","topicId":"cnc_p132","difficulty":"standard","type":"choice","prompt":"「炸酱面」的「炸」读哪一个？","choices":[{"key":"A","text":"zhá（油炸的炸）"},{"key":"B","text":"zhà（爆炸的炸）"},{"key":"C","text":"zhā（没有这个常用读音）"},{"key":"D","text":"zà（没有这个读音）"}],"answer":"A","explanation":"炸鱼、炸酱的炸读 zhá。爆炸、炸弹的炸才读 zhà。","verify":"\"zhá（油炸的炸）\""},{"id":"cnc_p133_q1","topicId":"cnc_p133","difficulty":"basic","type":"choice","prompt":"「香喷喷」是怎样的词？它在写什么？","choices":[{"key":"A","text":"AABB 式，在写职业"},{"key":"B","text":"一个生肖的名字"},{"key":"C","text":"ABB 式，在写香味"},{"key":"D","text":"一种烹调方法"}],"answer":"C","explanation":"甜津津、酸溜溜、辣乎乎、香喷喷都是 ABB，用来写味道或感觉。","verify":"\"ABB 式，在写香味\""},{"id":"cnc_p133_q2","topicId":"cnc_p133","difficulty":"basic","type":"choice","prompt":"带竖心旁或心字底的字，意思常常和什么有关？","choices":[{"key":"A","text":"刀剪"},{"key":"B","text":"火和热"},{"key":"C","text":"钱币"},{"key":"D","text":"心情"}],"answer":"D","explanation":"情、想、怕这一类字带心。和刀有关的常常是立刀旁。","verify":"\"心情\""},{"id":"cnc_p133_q3","topicId":"cnc_p133","difficulty":"standard","type":"choice","prompt":"带「火」或四点底的字，意思常常和什么有关？","choices":[{"key":"A","text":"火、热"},{"key":"B","text":"心情"},{"key":"C","text":"刀剪"},{"key":"D","text":"河流"}],"answer":"A","explanation":"烧、热、煮这一类字和水无关，和火有关。四点底是火的变形。","verify":"\"火、热\""},{"id":"cnc_p133_q4","topicId":"cnc_p133","difficulty":"standard","type":"choice","prompt":"十二生肖里，紧接在「鼠」后面的是哪一个？","choices":[{"key":"A","text":"虎"},{"key":"B","text":"牛"},{"key":"C","text":"兔"},{"key":"D","text":"龙"}],"answer":"B","explanation":"子鼠、丑牛、寅虎、卯兔。鼠后面是牛，不是虎。","verify":"\"牛\""}]
