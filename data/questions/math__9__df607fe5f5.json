[{"id":"cnm_226_q1","topicId":"cnm_226","difficulty":"basic","type":"numeric","prompt":"x²-5x+6=0 两根之和与积分别是多少？（依次作答，用逗号隔开）","answer":"5，6","explanation":"a=1，b=-5，c=6，两根之和 -b/a=5，两根之积 c/a=6（也可直接解出根 2 和 3 验证）。","verify":"[-Fraction(-5,1), Fraction(6,1)]"},{"id":"cnm_226_q2","topicId":"cnm_226","difficulty":"basic","type":"numeric","prompt":"方程 2x²-6x+1=0 有两个实数根，求两根之和与两根之积。（依次作答，用逗号隔开，积写成分数）","answer":"3，1/2","explanation":"a=2，b=-6，c=1，和 -b/a=6/2=3，积 c/a=1/2。","verify":"[-Fraction(-6,2), Fraction(1,2)]"},{"id":"cnm_226_q3","topicId":"cnm_226","difficulty":"standard","type":"numeric","prompt":"x1、x2 是方程 x²-3x-5=0 的两个根，求 x1²+x2² 的值。","answer":"19","explanation":"x1+x2=3，x1x2=-5，x1²+x2²=(x1+x2)²-2x1x2=9+10=19。","verify":"3**2-2*(-5)"},{"id":"cnm_226_q4","topicId":"cnm_226","difficulty":"standard","type":"numeric","prompt":"关于 x 的方程 x²+kx+6=0 的一个根是 2，求 k 的值和另一个根。（依次作答，用逗号隔开）","answer":"-5，3","explanation":"由两根之积 6，另一根为 6÷2=3；两根之和 2+3=5=-k，所以 k=-5。","verify":"[-(2+6//2), 6//2]"},{"id":"cnm_226_q5","topicId":"cnm_226","difficulty":"advanced","type":"numeric","prompt":"x1、x2 是方程 2x²-5x-3=0 的两个根，求 1/x1+1/x2 的值。（写成最简分数）","answer":"-5/3","explanation":"x1+x2=5/2，x1x2=-3/2，1/x1+1/x2=(x1+x2)/(x1x2)=(5/2)÷(-3/2)=-5/3。","verify":"Fraction(5,2)/Fraction(-3,2)"}]
