[{"id":"cnp_048_q1","topicId":"cnp_048","difficulty":"basic","type":"choice","prompt":"苹果从树上加速下落，能量是怎样转化的？","choices":[{"key":"A","text":"重力势能转化为动能"},{"key":"B","text":"动能转化为重力势能"},{"key":"C","text":"动能转化为弹性势能"},{"key":"D","text":"没有能量转化"}],"answer":"A","explanation":"高度减小、速度增大，重力势能转化为动能。","verify":"\"重力势能转化为动能\""},{"id":"cnp_048_q2","topicId":"cnp_048","difficulty":"basic","type":"choice","prompt":"人造地球卫星从近地点向远地点运动时，能量怎样转化？","choices":[{"key":"A","text":"重力势能转化为动能"},{"key":"B","text":"动能转化为重力势能"},{"key":"C","text":"机械能转化为内能"},{"key":"D","text":"动能和势能都增大"}],"answer":"B","explanation":"从近地点到远地点，高度增大、速度减小，动能转化为重力势能。","verify":"\"动能转化为重力势能\""},{"id":"cnp_048_q3","topicId":"cnp_048","difficulty":"standard","type":"choice","prompt":"不计空气阻力，竖直上抛的小球在上升过程中机械能怎样？","choices":[{"key":"A","text":"增大"},{"key":"B","text":"减小"},{"key":"C","text":"不变"},{"key":"D","text":"先增大后减小"}],"answer":"C","explanation":"只有动能和重力势能相互转化，机械能守恒。","verify":"\"不变\""},{"id":"cnp_048_q4","topicId":"cnp_048","difficulty":"standard","type":"choice","prompt":"一个皮球从高处落下，弹起的高度越来越低，说明什么？","choices":[{"key":"A","text":"机械能守恒"},{"key":"B","text":"皮球的质量变小了"},{"key":"C","text":"皮球的重力变小了"},{"key":"D","text":"机械能有一部分转化为内能"}],"answer":"D","explanation":"空气阻力和撞击时的形变使部分机械能转化为内能，机械能减小。","verify":"\"机械能有一部分转化为内能\""}]
