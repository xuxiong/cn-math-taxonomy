[{"id":"cnm_142_q1","topicId":"cnm_142","difficulty":"basic","type":"choice","prompt":"计算 x³·x⁴。","answer":"A","choices":[{"key":"A","text":"x⁷"},{"key":"B","text":"x¹²"},{"key":"C","text":"2x⁷"},{"key":"D","text":"x"}],"explanation":"同底数幂相乘，底数不变，指数相加：3+4=7。"},{"id":"cnm_142_q2","topicId":"cnm_142","difficulty":"basic","type":"numeric","prompt":"计算 2^3×2^4 的值。","answer":"128","explanation":"2^3×2^4=2^(3+4)=2^7=128。","verify":"2**3*2**4"},{"id":"cnm_142_q3","topicId":"cnm_142","difficulty":"standard","type":"choice","prompt":"下列计算正确的是：","answer":"A","choices":[{"key":"A","text":"a·a^4=a^5"},{"key":"B","text":"a^2+a^3=a^5"},{"key":"C","text":"a^3·a^3=2a^3"},{"key":"D","text":"a^2·a^3=a^6"}],"explanation":"a=a^1，a·a^4=a^(1+4)=a^5；a^2 与 a^3 不是同类项不能相加；同底数幂相乘是指数相加，不是系数相加或指数相乘。"},{"id":"cnm_142_q4","topicId":"cnm_142","difficulty":"standard","type":"numeric","prompt":"若 3^x·3^2·3=3^7，求 x 的值。","answer":"4","explanation":"左边=3^(x+2+1)，所以 x+3=7，x=4。","verify":"7-2-1"},{"id":"cnm_142_q5","topicId":"cnm_142","difficulty":"advanced","type":"numeric","prompt":"已知 2^m=3，2^n=5，求 2^(m+n+1) 的值。","answer":"30","explanation":"2^(m+n+1)=2^m·2^n·2=3×5×2=30。","verify":"3*5*2"},{"id":"cnm_143_q1","topicId":"cnm_143","difficulty":"basic","type":"choice","prompt":"计算 (a²)³ 与 (2b)³。","answer":"C","choices":[{"key":"A","text":"a⁵ 与 8b³"},{"key":"B","text":"a⁶ 与 6b³"},{"key":"C","text":"a⁶ 与 8b³"},{"key":"D","text":"a⁸ 与 2b³"}],"explanation":"幂的乘方，指数相乘：(a²)³=a⁶；积的乘方，每个因式分别乘方：(2b)³=2³b³=8b³。"},{"id":"cnm_143_q2","topicId":"cnm_143","difficulty":"basic","type":"numeric","prompt":"计算 (2^2)^3 的值。","answer":"64","explanation":"(2^2)^3=2^(2×3)=2^6=64。","verify":"(2**2)**3"},{"id":"cnm_143_q3","topicId":"cnm_143","difficulty":"standard","type":"choice","prompt":"下列运算正确的是：","answer":"D","choices":[{"key":"A","text":"a^2·a^3=a^6"},{"key":"B","text":"(a^2)^3=a^5"},{"key":"C","text":"(a^3)^2=a^9"},{"key":"D","text":"(ab)^2=a^2b^2"}],"explanation":"a^2·a^3=a^5；(a^2)^3=a^6；(a^3)^2=a^6；只有 (ab)^2=a^2b^2 正确。"},{"id":"cnm_143_q4","topicId":"cnm_143","difficulty":"standard","type":"numeric","prompt":"化简 (-2x^2)^3，结果中 x^6 项的系数是多少？","answer":"-8","explanation":"(-2x^2)^3=(-2)^3·(x^2)^3=-8x^6。","verify":"(-2)**3"},{"id":"cnm_143_q5","topicId":"cnm_143","difficulty":"advanced","type":"numeric","prompt":"计算 (-2)^2025×(1/2)^2025 的值。","answer":"-1","explanation":"逆用积的乘方：(-2)^2025×(1/2)^2025=(-2×1/2)^2025=(-1)^2025=-1。","verify":"(-2*Fraction(1,2))**(2025%2)"}]
