[{"id":"cns_p156_q1","topicId":"cns_p156","difficulty":"basic","type":"choice","prompt":"地面平坦、面积广阔、海拔较低的地形叫什么？","choices":[{"key":"A","text":"高原"},{"key":"B","text":"平原"},{"key":"C","text":"山地"},{"key":"D","text":"盆地"}],"answer":"B","explanation":"平原平坦低矮。","verify":"\"平原\""},{"id":"cns_p156_q2","topicId":"cns_p156","difficulty":"basic","type":"choice","prompt":"四周高、中间低的地形叫什么？","choices":[{"key":"A","text":"平原"},{"key":"B","text":"高原"},{"key":"C","text":"盆地"},{"key":"D","text":"丘陵"}],"answer":"C","explanation":"盆地像一个大盆。","verify":"\"盆地\""},{"id":"cns_p156_q3","topicId":"cns_p156","difficulty":"standard","type":"choice","prompt":"世界上最高的高原是哪个？","choices":[{"key":"A","text":"黄土高原"},{"key":"B","text":"内蒙古高原"},{"key":"C","text":"云贵高原"},{"key":"D","text":"青藏高原"}],"answer":"D","explanation":"青藏高原平均海拔 4000 米以上。","verify":"\"青藏高原\""},{"id":"cns_p156_q4","topicId":"cns_p156","difficulty":"challenge","type":"choice","prompt":"在地形图上，常用什么颜色表示海拔较低的平原？","choices":[{"key":"A","text":"绿色"},{"key":"B","text":"褐色"},{"key":"C","text":"白色"},{"key":"D","text":"红色"}],"answer":"A","explanation":"分层设色地形图中，绿色多表示平原。","verify":"\"绿色\""},{"id":"cns_p157_q1","topicId":"cns_p157","difficulty":"basic","type":"choice","prompt":"火山喷发出来的炽热液体叫什么？","choices":[{"key":"A","text":"泥浆水"},{"key":"B","text":"石油"},{"key":"C","text":"岩浆（熔岩）"},{"key":"D","text":"雪水"}],"answer":"C","explanation":"地下高温的岩浆喷出地表叫熔岩。","verify":"\"岩浆（熔岩）\""},{"id":"cns_p157_q2","topicId":"cns_p157","difficulty":"basic","type":"choice","prompt":"火山喷发是地球什么力量的表现？","choices":[{"key":"A","text":"风的力量"},{"key":"B","text":"流水的力量"},{"key":"C","text":"人类的力量"},{"key":"D","text":"内部的力量"}],"answer":"D","explanation":"火山、地震都来自地球内部。","verify":"\"内部的力量\""},{"id":"cns_p157_q3","topicId":"cns_p157","difficulty":"standard","type":"choice","prompt":"火山喷发对地表可能造成什么改变？","choices":[{"key":"A","text":"形成新的山、岛屿或岩石"},{"key":"B","text":"让地表变成平原"},{"key":"C","text":"让海水变淡"},{"key":"D","text":"没有改变"}],"answer":"A","explanation":"喷出的熔岩冷却后形成新的地貌。","verify":"\"形成新的山、岛屿或岩石\""},{"id":"cns_p157_q4","topicId":"cns_p157","difficulty":"challenge","type":"choice","prompt":"用番茄酱和土豆泥模拟火山喷发，番茄酱代表什么？","choices":[{"key":"A","text":"地壳"},{"key":"B","text":"岩浆"},{"key":"C","text":"火山口外的树"},{"key":"D","text":"云"}],"answer":"B","explanation":"番茄酱受热冒出，模拟岩浆喷出。","verify":"\"岩浆\""},{"id":"cns_p158_q1","topicId":"cns_p158","difficulty":"basic","type":"choice","prompt":"地震是由什么引起的？","choices":[{"key":"A","text":"大风"},{"key":"B","text":"下大雨"},{"key":"C","text":"人跑步"},{"key":"D","text":"地球内部岩层断裂、运动"}],"answer":"D","explanation":"地震来自地球内部。","verify":"\"地球内部岩层断裂、运动\""},{"id":"cns_p158_q2","topicId":"cns_p158","difficulty":"basic","type":"choice","prompt":"在教室里发生地震，正确做法是？","choices":[{"key":"A","text":"迅速躲到课桌下，护住头部"},{"key":"B","text":"跳窗逃跑"},{"key":"C","text":"乘电梯"},{"key":"D","text":"站在窗边看"}],"answer":"A","explanation":"就近躲避，护住头部，震后有序撤离。","verify":"\"迅速躲到课桌下，护住头部\""},{"id":"cns_p158_q3","topicId":"cns_p158","difficulty":"standard","type":"choice","prompt":"地震可能对地表造成什么影响？","choices":[{"key":"A","text":"形成彩虹"},{"key":"B","text":"出现裂缝、山体滑坡"},{"key":"C","text":"让河水变清"},{"key":"D","text":"长出新树"}],"answer":"B","explanation":"地震会使地面开裂、山体崩塌。","verify":"\"出现裂缝、山体滑坡\""},{"id":"cns_p158_q4","topicId":"cns_p158","difficulty":"challenge","type":"choice","prompt":"地震后撤离教学楼，不能做什么？","choices":[{"key":"A","text":"走楼梯"},{"key":"B","text":"听老师指挥"},{"key":"C","text":"乘坐电梯"},{"key":"D","text":"护住头部"}],"answer":"C","explanation":"地震时电梯可能停运或损坏。","verify":"\"乘坐电梯\""},{"id":"cns_p159_q1","topicId":"cns_p159","difficulty":"basic","type":"choice","prompt":"建造纪念碑、台阶常用哪种坚硬的岩石？","choices":[{"key":"A","text":"花岗岩"},{"key":"B","text":"页岩"},{"key":"C","text":"砂岩"},{"key":"D","text":"滑石"}],"answer":"A","explanation":"花岗岩坚硬耐磨。","verify":"\"花岗岩\""},{"id":"cns_p159_q2","topicId":"cns_p159","difficulty":"basic","type":"choice","prompt":"可以做雕塑和地板装饰的、有漂亮花纹的岩石是什么？","choices":[{"key":"A","text":"页岩"},{"key":"B","text":"大理岩"},{"key":"C","text":"砾岩"},{"key":"D","text":"煤"}],"answer":"B","explanation":"大理岩花纹美观。","verify":"\"大理岩\""},{"id":"cns_p159_q3","topicId":"cns_p159","difficulty":"standard","type":"choice","prompt":"地壳主要由什么组成？","choices":[{"key":"A","text":"水"},{"key":"B","text":"空气"},{"key":"C","text":"岩石"},{"key":"D","text":"冰"}],"answer":"C","explanation":"地壳是由岩石组成的。","verify":"\"岩石\""},{"id":"cns_p159_q4","topicId":"cns_p159","difficulty":"challenge","type":"choice","prompt":"下面哪种岩石上最可能找到化石？","choices":[{"key":"A","text":"花岗岩"},{"key":"B","text":"玄武岩"},{"key":"C","text":"金属矿石"},{"key":"D","text":"石灰岩或页岩等沉积岩"}],"answer":"D","explanation":"化石常保存在沉积岩中。","verify":"\"石灰岩或页岩等沉积岩\""},{"id":"cns_p160_q1","topicId":"cns_p160","difficulty":"basic","type":"choice","prompt":"岩浆冷却凝固形成的岩石叫什么？","choices":[{"key":"A","text":"沉积岩"},{"key":"B","text":"岩浆岩"},{"key":"C","text":"变质岩"},{"key":"D","text":"化石"}],"answer":"B","explanation":"花岗岩、玄武岩是岩浆岩。","verify":"\"岩浆岩\""},{"id":"cns_p160_q2","topicId":"cns_p160","difficulty":"basic","type":"choice","prompt":"一层层泥沙堆积压实形成的岩石叫什么？","choices":[{"key":"A","text":"岩浆岩"},{"key":"B","text":"变质岩"},{"key":"C","text":"沉积岩"},{"key":"D","text":"陨石"}],"answer":"C","explanation":"砂岩、页岩是沉积岩。","verify":"\"沉积岩\""},{"id":"cns_p160_q3","topicId":"cns_p160","difficulty":"standard","type":"choice","prompt":"石灰岩在高温高压下变成大理岩，大理岩属于哪一类？","choices":[{"key":"A","text":"沉积岩"},{"key":"B","text":"岩浆岩"},{"key":"C","text":"土壤"},{"key":"D","text":"变质岩"}],"answer":"D","explanation":"原有岩石在高温高压下变化形成变质岩。","verify":"\"变质岩\""},{"id":"cns_p160_q4","topicId":"cns_p160","difficulty":"challenge","type":"choice","prompt":"岩石在风吹日晒、冷热交替下慢慢破碎的过程叫什么？","choices":[{"key":"A","text":"风化"},{"key":"B","text":"熔化"},{"key":"C","text":"蒸发"},{"key":"D","text":"凝结"}],"answer":"A","explanation":"风化使岩石变成碎石、沙和土。","verify":"\"风化\""},{"id":"cns_p161_q1","topicId":"cns_p161","difficulty":"basic","type":"choice","prompt":"河流入海口常形成三角洲，主要是什么作用？","choices":[{"key":"A","text":"风的侵蚀"},{"key":"B","text":"火山喷发"},{"key":"C","text":"流水沉积"},{"key":"D","text":"地震"}],"answer":"C","explanation":"河水流速变慢，泥沙沉积下来。","verify":"\"流水沉积\""},{"id":"cns_p161_q2","topicId":"cns_p161","difficulty":"basic","type":"choice","prompt":"沙漠里的蘑菇石主要是怎样形成的？","choices":[{"key":"A","text":"流水沉积"},{"key":"B","text":"冰川冻结"},{"key":"C","text":"人工雕刻"},{"key":"D","text":"风沙侵蚀"}],"answer":"D","explanation":"风携带沙子磨蚀岩石，下部磨得更多。","verify":"\"风沙侵蚀\""},{"id":"cns_p161_q3","topicId":"cns_p161","difficulty":"standard","type":"choice","prompt":"在土堆上用洒水壶模拟下雨，坡度越大，冲走的泥土会怎样？","choices":[{"key":"A","text":"越多"},{"key":"B","text":"越少"},{"key":"C","text":"不变"},{"key":"D","text":"一点也不冲走"}],"answer":"A","explanation":"坡度越大，流水侵蚀越强。","verify":"\"越多\""},{"id":"cns_p161_q4","topicId":"cns_p161","difficulty":"challenge","type":"choice","prompt":"防止水土流失，最有效的方法之一是什么？","choices":[{"key":"A","text":"大量开荒"},{"key":"B","text":"植树种草"},{"key":"C","text":"砍伐森林"},{"key":"D","text":"清除所有植被"}],"answer":"B","explanation":"植物的根能固定土壤。","verify":"\"植树种草\""}]
