[{"id":"cnc_p407_q1","topicId":"cnc_p407","difficulty":"basic","type":"choice","prompt":"《草原》的作者是谁？","choices":[{"key":"A","text":"老舍"},{"key":"B","text":"宗璞"},{"key":"C","text":"朱自清"},{"key":"D","text":"鲁迅"}],"answer":"A","explanation":"这篇是老舍写的。《丁香结》才是宗璞的。","verify":"\"老舍\""},{"id":"cnc_p407_q2","topicId":"cnc_p407","difficulty":"basic","type":"choice","prompt":"「羊群一会儿上了小丘，一会儿又下来」把羊群比成什么？","choices":[{"key":"A","text":"给天空挂上了星星"},{"key":"B","text":"给无边的绿毯绣上了白色的大花"},{"key":"C","text":"给湖面铺上了荷叶"},{"key":"D","text":"给丁香结上了花蕾"}],"answer":"B","explanation":"草原像绿毯，羊群像绣上去的白花。丁香结是下一课的比喻。","verify":"\"给无边的绿毯绣上了白色的大花\""},{"id":"cnc_p407_q3","topicId":"cnc_p407","difficulty":"standard","type":"choice","prompt":"课文写草原的天空和空气，突出的是什么？","choices":[{"key":"A","text":"乌云压城，雨点跳进船里"},{"key":"B","text":"夜里只有蛙声"},{"key":"C","text":"空气清鲜，天空明朗，一碧千里而不茫茫"},{"key":"D","text":"城里城外都是丁香"}],"answer":"C","explanation":"一碧千里，而并不茫茫。骤雨是《望湖楼醉书》，蛙声是《西江月》。","verify":"\"空气清鲜，天空明朗，一碧千里而不茫茫\""},{"id":"cnc_p407_q4","topicId":"cnc_p407","difficulty":"standard","type":"choice","prompt":"访问结束时，哪一句点出了这篇的情意？","choices":[{"key":"A","text":"丁香空结雨中愁"},{"key":"B","text":"三军过后尽开颜"},{"key":"C","text":"路转溪桥忽见"},{"key":"D","text":"蒙汉情深何忍别，天涯碧草话斜阳"}],"answer":"D","explanation":"景美，人情也深。别的句子分别来自丁香、长征和西江月。","verify":"\"蒙汉情深何忍别，天涯碧草话斜阳\""},{"id":"cnc_p408_q1","topicId":"cnc_p408","difficulty":"basic","type":"choice","prompt":"《丁香结》的作者是谁？","choices":[{"key":"A","text":"老舍"},{"key":"B","text":"宗璞"},{"key":"C","text":"朱自清"},{"key":"D","text":"史铁生"}],"answer":"B","explanation":"这篇散文是宗璞写的。老舍写的是《草原》。","verify":"\"宗璞\""},{"id":"cnc_p408_q2","topicId":"cnc_p408","difficulty":"basic","type":"choice","prompt":"丁香花的颜色和样子，作者突出的是什么？","choices":[{"key":"A","text":"鲜红的大花"},{"key":"B","text":"只写叶子，没有写花"},{"key":"C","text":"淡紫，细小的花抱在一起，像一个结"},{"key":"D","text":"花开在水底"}],"answer":"C","explanation":"小小的花蕾攒在一起，所以叫丁香结。","verify":"\"淡紫，细小的花抱在一起，像一个结\""},{"id":"cnc_p408_q3","topicId":"cnc_p408","difficulty":"standard","type":"choice","prompt":"古人说「丁香空结雨中愁」，愁的是什么？","choices":[{"key":"A","text":"丁香不能吃"},{"key":"B","text":"雨把房子淋塌了"},{"key":"C","text":"花开得太少，所以生气"},{"key":"D","text":"结打在雨里，解不开，像心里的愁"}],"answer":"D","explanation":"结是比喻。雨中的丁香结，被看成解不开的愁绪。","verify":"\"结打在雨里，解不开，像心里的愁\""},{"id":"cnc_p408_q4","topicId":"cnc_p408","difficulty":"standard","type":"choice","prompt":"作者最后怎样看生活里的结？","choices":[{"key":"A","text":"结是解不完的，人生的问题也解不完"},{"key":"B","text":"所有的结都要躲开"},{"key":"C","text":"丁香不该开花"},{"key":"D","text":"愁只能越积越深"}],"answer":"A","explanation":"她说结年年都有。要是什么问题都没有，生活反而平淡。","verify":"\"结是解不完的，人生的问题也解不完\""},{"id":"cnc_p409_q1","topicId":"cnc_p409","difficulty":"basic","type":"choice","prompt":"「明月别枝惊鹊」的下一句是哪一句？","choices":[{"key":"A","text":"稻花香里说丰年"},{"key":"B","text":"七八个星天外"},{"key":"C","text":"清风半夜鸣蝉"},{"key":"D","text":"路转溪桥忽见"}],"answer":"C","explanation":"先写月色惊起鹊鸟，再写半夜的蝉鸣。丰年是下片之前的第三句。","verify":"\"清风半夜鸣蝉\""},{"id":"cnc_p409_q2","topicId":"cnc_p409","difficulty":"basic","type":"choice","prompt":"「稻花香里说丰年」的下一句是哪一句？","choices":[{"key":"A","text":"七八个星天外"},{"key":"B","text":"听取蝉声一片"},{"key":"C","text":"两三点雨山前"},{"key":"D","text":"听取蛙声一片"}],"answer":"D","explanation":"丰年的消息是从一片蛙声里听来的。不是蝉声。蝉已经出现在上句。","verify":"\"听取蛙声一片\""},{"id":"cnc_p409_q3","topicId":"cnc_p409","difficulty":"standard","type":"choice","prompt":"「旧时茅店社林边」的下一句是哪一句？","choices":[{"key":"A","text":"路转溪桥忽见"},{"key":"B","text":"路转溪桥忽现"},{"key":"C","text":"两三点雨山前"},{"key":"D","text":"稻花香里说丰年"}],"answer":"A","explanation":"词里是「忽见」，不是「忽现」。转过溪桥，熟悉的茅店忽然出现。","verify":"\"路转溪桥忽见\""},{"id":"cnc_p409_q4","topicId":"cnc_p409","difficulty":"standard","type":"choice","prompt":"《西江月·夜行黄沙道中》的作者是谁？","choices":[{"key":"A","text":"苏轼"},{"key":"B","text":"辛弃疾"},{"key":"C","text":"孟浩然"},{"key":"D","text":"李白"}],"answer":"B","explanation":"这首词是辛弃疾写的。苏轼写的是《望湖楼醉书》，孟浩然写的是《宿建德江》。","verify":"\"辛弃疾\""},{"id":"cnc_p410_q1","topicId":"cnc_p410","difficulty":"basic","type":"choice","prompt":"「移舟泊烟渚」的下一句是哪一句？","choices":[{"key":"A","text":"野旷天低树"},{"key":"B","text":"江清月近人"},{"key":"C","text":"日暮客愁深"},{"key":"D","text":"日暮客愁新"}],"answer":"D","explanation":"船停在烟雾里的小洲边，旅途的愁又涌上来。野旷是第三句。","verify":"\"日暮客愁新\""},{"id":"cnc_p410_q2","topicId":"cnc_p410","difficulty":"basic","type":"choice","prompt":"「野旷天低树」的下一句是哪一句？","choices":[{"key":"A","text":"江清月近人"},{"key":"B","text":"日暮客愁新"},{"key":"C","text":"江清月照人"},{"key":"D","text":"野旷天接树"}],"answer":"A","explanation":"天比树还低，月亮好像离人很近。是近人，不是照人。","verify":"\"江清月近人\""},{"id":"cnc_p410_q3","topicId":"cnc_p410","difficulty":"standard","type":"choice","prompt":"《宿建德江》的作者是谁？","choices":[{"key":"A","text":"辛弃疾"},{"key":"B","text":"孟浩然"},{"key":"C","text":"李白"},{"key":"D","text":"苏轼"}],"answer":"B","explanation":"这首五言诗是孟浩然的。不要因为写了月亮就记成李白。","verify":"\"孟浩然\""},{"id":"cnc_p410_q4","topicId":"cnc_p410","difficulty":"standard","type":"choice","prompt":"哪一句不属于《宿建德江》？","choices":[{"key":"A","text":"移舟泊烟渚"},{"key":"B","text":"日暮客愁新"},{"key":"C","text":"听取蛙声一片"},{"key":"D","text":"江清月近人"}],"answer":"C","explanation":"听取蛙声一片是辛弃疾《西江月》里的句子。","verify":"\"听取蛙声一片\""},{"id":"cnc_p411_q1","topicId":"cnc_p411","difficulty":"basic","type":"choice","prompt":"「黑云翻墨未遮山」的下一句是哪一句？","choices":[{"key":"A","text":"白雨跳珠乱入船"},{"key":"B","text":"卷地风来忽吹散"},{"key":"C","text":"白雨跳珠乱入湖"},{"key":"D","text":"望湖楼下水如天"}],"answer":"A","explanation":"雨点像珍珠，乱跳进船里。不是跳进湖里。卷地风是第三句。","verify":"\"白雨跳珠乱入船\""},{"id":"cnc_p411_q2","topicId":"cnc_p411","difficulty":"basic","type":"choice","prompt":"「卷地风来忽吹散」的下一句是哪一句？","choices":[{"key":"A","text":"黑云翻墨未遮山"},{"key":"B","text":"望湖楼下水如天"},{"key":"C","text":"望湖楼下水连天"},{"key":"D","text":"白雨跳珠乱入船"}],"answer":"B","explanation":"风一吹，云散了，楼下水又像天空一样明净。","verify":"\"望湖楼下水如天\""},{"id":"cnc_p411_q3","topicId":"cnc_p411","difficulty":"standard","type":"choice","prompt":"这首诗的作者是谁？","choices":[{"key":"A","text":"辛弃疾"},{"key":"B","text":"孟浩然"},{"key":"C","text":"苏轼"},{"key":"D","text":"杜甫"}],"answer":"C","explanation":"望湖楼这首是苏轼的。《西江月》是辛弃疾的。","verify":"\"苏轼\""},{"id":"cnc_p411_q4","topicId":"cnc_p411","difficulty":"standard","type":"choice","prompt":"诗里的雨下得怎样？","choices":[{"key":"A","text":"整整下了一夜"},{"key":"B","text":"只有一滴"},{"key":"C","text":"下成了雪"},{"key":"D","text":"来得急，也去得快"}],"answer":"D","explanation":"黑云还没遮住山，雨点已经跳进船；风一来，又吹散了。","verify":"\"来得急，也去得快\""},{"id":"cnc_p412_q1","topicId":"cnc_p412","difficulty":"basic","type":"choice","prompt":"变成一滴雨，哪一句把变化后的经历写出来了？","choices":[{"key":"A","text":"我变成了雨，很开心。"},{"key":"B","text":"我顺着叶尖滚下去，砸在干土上，土缝里立刻暗了一点。"},{"key":"C","text":"雨是水。"},{"key":"D","text":"变形记三个字。"}],"answer":"B","explanation":"顺着叶尖滚、砸在干土上，是变成雨以后才有的动作。空说开心还没有经历。","verify":"\"我顺着叶尖滚下去，砸在干土上，土缝里立刻暗了一点。\""},{"id":"cnc_p412_q2","topicId":"cnc_p412","difficulty":"basic","type":"choice","prompt":"变形记的重点应该放在哪里？","choices":[{"key":"A","text":"变成之前的家庭住址"},{"key":"B","text":"只写原来的名字"},{"key":"C","text":"变成之后看见了什么、做了什么"},{"key":"D","text":"把课文《草原》抄一遍"}],"answer":"C","explanation":"读者想看的是新身份里的遭遇。住址和抄课文都不是这次想象。","verify":"\"变成之后看见了什么、做了什么\""},{"id":"cnc_p412_q3","topicId":"cnc_p412","difficulty":"standard","type":"choice","prompt":"哪一种写法更像这篇习作？","choices":[{"key":"A","text":"每一句都只写「然后我很高兴」"},{"key":"B","text":"三段各变成一种互不相干的东西"},{"key":"C","text":"不写自己的感觉，只列生字"},{"key":"D","text":"重点的一段写细，其余交代清楚就收住"}],"answer":"D","explanation":"重点写详细，文章才有一个让人记得住的场面。","verify":"\"重点的一段写细，其余交代清楚就收住\""},{"id":"cnc_p412_q4","topicId":"cnc_p412","difficulty":"standard","type":"choice","prompt":"哪一句不像变形以后的所见？","choices":[{"key":"A","text":"星期一早上我在教室里交了数学作业。"},{"key":"B","text":"我趴在鞋底上，跟着脚步一下一下颠。"},{"key":"C","text":"风把我这个蒲公英绒毛吹过操场。"},{"key":"D","text":"我变成铅笔，听见削笔刀擦过自己的身子。"}],"answer":"A","explanation":"交作业还是原来的自己。鞋底、绒毛、铅笔才是变成之后。","verify":"\"星期一早上我在教室里交了数学作业。\""},{"id":"cnc_p413_q1","topicId":"cnc_p413","difficulty":"basic","type":"choice","prompt":"「屹立」的「屹」读哪一个？","choices":[{"key":"A","text":"qì"},{"key":"B","text":"qǐ"},{"key":"C","text":"yì"},{"key":"D","text":"yǐ"}],"answer":"C","explanation":"屹立读 yì。不能读成气。","verify":"\"yì\""},{"id":"cnc_p413_q2","topicId":"cnc_p413","difficulty":"basic","type":"choice","prompt":"「哀悼」的「悼」读哪一个？","choices":[{"key":"A","text":"diào"},{"key":"B","text":"dǎo"},{"key":"C","text":"zhào"},{"key":"D","text":"dào"}],"answer":"D","explanation":"悼读 dào，不读掉。","verify":"\"dào\""},{"id":"cnc_p413_q3","topicId":"cnc_p413","difficulty":"standard","type":"choice","prompt":"「炽热」的「炽」读哪一个？","choices":[{"key":"A","text":"chì"},{"key":"B","text":"zhì"},{"key":"C","text":"zhī"},{"key":"D","text":"chī"}],"answer":"A","explanation":"炽热读 chì。只是声旁，不能读成只。","verify":"\"chì\""},{"id":"cnc_p413_q4","topicId":"cnc_p413","difficulty":"standard","type":"choice","prompt":"「澎湃」的「湃」读哪一个？","choices":[{"key":"A","text":"bài"},{"key":"B","text":"pài"},{"key":"C","text":"bǎi"},{"key":"D","text":"pāi"}],"answer":"B","explanation":"澎湃读 péng pài。湃不读拜。","verify":"\"pài\""}]
