[{"id":"cnm_h043_q1","topicId":"cnm_h043","difficulty":"basic","type":"numeric","prompt":"计算 log₂32。","answer":"5","explanation":"2⁵=32，所以对数是 5。","verify":"log2(32)"},{"id":"cnm_h043_q2","topicId":"cnm_h043","difficulty":"basic","type":"numeric","prompt":"计算 lg1000，即常用对数 log₁₀1000。","answer":"3","explanation":"10³=1000，所以是 3。","verify":"log10(1000)"},{"id":"cnm_h043_q3","topicId":"cnm_h043","difficulty":"standard","type":"numeric","prompt":"计算 log₂(1/8)。","answer":"-3","explanation":"2⁻³=1/8，对数是 −3。","verify":"log2(1/8)"},{"id":"cnm_h043_q4","topicId":"cnm_h043","difficulty":"standard","type":"choice","prompt":"log₂8=3 的含义是？","choices":[{"key":"A","text":"8³=2"},{"key":"B","text":"2×3=8"},{"key":"C","text":"3²=8"},{"key":"D","text":"2³=8"}],"answer":"D","explanation":"对数回答的是指数：底数的这个指数次方等于真数。","verify":"\"2³=8\""},{"id":"cnm_h044_q1","topicId":"cnm_h044","difficulty":"basic","type":"numeric","prompt":"计算 log₂8+log₂4。","answer":"5","explanation":"3+2=5，也可以写成 log₂32。","verify":"log2(8)+log2(4)"},{"id":"cnm_h044_q2","topicId":"cnm_h044","difficulty":"basic","type":"numeric","prompt":"计算 log₂16−log₂2。","answer":"3","explanation":"4−1=3，即 log₂8。","verify":"log2(16)-log2(2)"},{"id":"cnm_h044_q3","topicId":"cnm_h044","difficulty":"standard","type":"numeric","prompt":"计算 2·log₂8。","answer":"6","explanation":"2×3=6，等于 log₂(8²)=log₂64。","verify":"2*log2(8)"},{"id":"cnm_h044_q4","topicId":"cnm_h044","difficulty":"standard","type":"choice","prompt":"log_a(MN) 等于？","choices":[{"key":"A","text":"log_a M + log_a N"},{"key":"B","text":"log_a M · log_a N"},{"key":"C","text":"log_a M − log_a N"},{"key":"D","text":"log_a(M+N)"}],"answer":"A","explanation":"积的对数等于对数之和。商的对数才是相减。","verify":"\"log_a M + log_a N\""},{"id":"cnm_h045_q1","topicId":"cnm_h045","difficulty":"basic","type":"numeric","prompt":"计算 log₄16。","answer":"2","explanation":"16=4²，也可以按换底：log₂16 / log₂4 = 4/2 = 2。","verify":"log2(16)/log2(4)"},{"id":"cnm_h045_q2","topicId":"cnm_h045","difficulty":"basic","type":"numeric","prompt":"计算 log₈2。","answer":"1/3","explanation":"log₂2=1，log₂8=3，结果是 1/3。","verify":"log2(2)/log2(8)"},{"id":"cnm_h045_q3","topicId":"cnm_h045","difficulty":"standard","type":"numeric","prompt":"计算 log₄(1/16)。","answer":"-2","explanation":"1/16=4⁻²，结果是 −2。","verify":"log2(1/16)/log2(4)"},{"id":"cnm_h045_q4","topicId":"cnm_h045","difficulty":"standard","type":"choice","prompt":"换底公式 log_a b = ？","choices":[{"key":"A","text":"log_c a / log_c b"},{"key":"B","text":"log_c b / log_c a"},{"key":"C","text":"log_c a · log_c b"},{"key":"D","text":"log_c(a·b)"}],"answer":"B","explanation":"分子是新底数下的真数，分母是新底数下的原底数。","verify":"\"log_c b / log_c a\""}]
