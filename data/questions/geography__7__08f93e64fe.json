[{"id":"cng_j004_q1","topicId":"cng_j004","difficulty":"basic","type":"choice","prompt":"地图的三要素是？","choices":[{"key":"A","text":"经线、纬线、赤道"},{"key":"B","text":"比例尺、方向、图例"},{"key":"C","text":"海拔、相对高度、等高线"},{"key":"D","text":"图名、页码、附录"}],"answer":"B","explanation":"比例尺、方向和图例是阅读地图必须掌握的三项基本要素。","verify":"\"比例尺、方向、图例\""},{"id":"cng_j004_q2","topicId":"cng_j004","difficulty":"basic","type":"choice","prompt":"在没有指向标的一般地图上，默认方向是？","choices":[{"key":"A","text":"上南下北，左东右西"},{"key":"B","text":"上东下西，左北右南"},{"key":"C","text":"上北下南，左西右东"},{"key":"D","text":"上西下东，左南右北"}],"answer":"C","explanation":"普通地图通常按上北下南、左西右东定向。","verify":"\"上北下南，左西右东\""},{"id":"cng_j004_q3","topicId":"cng_j004","difficulty":"standard","type":"choice","prompt":"相同图幅下，比例尺越大，表示的实地范围？","choices":[{"key":"A","text":"越大，内容越简略"},{"key":"B","text":"不变，内容一样详细"},{"key":"C","text":"越大，内容越详细"},{"key":"D","text":"越小，内容越详细"}],"answer":"D","explanation":"比例尺大则同一图幅覆盖的实地范围小，地理事物可以画得更详细。","verify":"\"越小，内容越详细\""},{"id":"cng_j004_q4","topicId":"cng_j004","difficulty":"challenge","type":"choice","prompt":"数字式比例尺 1:100000 表示图上 1 厘米代表实地？","choices":[{"key":"A","text":"1千米"},{"key":"B","text":"100千米"},{"key":"C","text":"10米"},{"key":"D","text":"1米"}],"answer":"A","explanation":"1:100000 即图上 1 厘米代表实地 100000 厘米，也就是 1 千米。","verify":"\"1千米\""},{"id":"cng_j005_q1","topicId":"cng_j005","difficulty":"basic","type":"choice","prompt":"等高线地形图上，等高线越密集，表示？","choices":[{"key":"A","text":"坡度越缓"},{"key":"B","text":"海拔越低"},{"key":"C","text":"坡度越陡"},{"key":"D","text":"一定是山谷"}],"answer":"C","explanation":"相邻等高线水平距离越小，坡度越陡。","verify":"\"坡度越陡\""},{"id":"cng_j005_q2","topicId":"cng_j005","difficulty":"basic","type":"choice","prompt":"海拔一般在 200 米以下、地面平坦广阔的地形是？","choices":[{"key":"A","text":"高原"},{"key":"B","text":"山地"},{"key":"C","text":"丘陵"},{"key":"D","text":"平原"}],"answer":"D","explanation":"平原海拔较低，地势平坦。","verify":"\"平原\""},{"id":"cng_j005_q3","topicId":"cng_j005","difficulty":"standard","type":"choice","prompt":"等高线向海拔高处凸出的部位通常是？","choices":[{"key":"A","text":"山谷"},{"key":"B","text":"山脊"},{"key":"C","text":"鞍部"},{"key":"D","text":"陡崖"}],"answer":"A","explanation":"“凸高为谷，凸低为脊”，等高线向高处凸是山谷。","verify":"\"山谷\""},{"id":"cng_j005_q4","topicId":"cng_j005","difficulty":"challenge","type":"choice","prompt":"分层设色地形图上，绿色通常表示？","choices":[{"key":"A","text":"高山冰雪"},{"key":"B","text":"平原或低地"},{"key":"C","text":"海洋最深处"},{"key":"D","text":"沙漠"}],"answer":"B","explanation":"陆地上绿色多表示海拔较低的平原，黄色、褐色表示更高的高原山地。","verify":"\"平原或低地\""},{"id":"cng_j006_q1","topicId":"cng_j006","difficulty":"basic","type":"choice","prompt":"查找北京到上海的铁路路线，最合适的是？","choices":[{"key":"A","text":"世界气候图"},{"key":"B","text":"北京市区旅游图"},{"key":"C","text":"等高线地形图"},{"key":"D","text":"中国交通图"}],"answer":"D","explanation":"交通图专门表示铁路、公路等线路。","verify":"\"中国交通图\""},{"id":"cng_j006_q2","topicId":"cng_j006","difficulty":"basic","type":"choice","prompt":"去公园徒步，要判断哪条路更陡，应优先看？","choices":[{"key":"A","text":"等高线地形图"},{"key":"B","text":"世界政区图"},{"key":"C","text":"人口分布图"},{"key":"D","text":"语言分布图"}],"answer":"A","explanation":"等高线可以反映坡度陡缓，适合选择登山或徒步路线。","verify":"\"等高线地形图\""},{"id":"cng_j006_q3","topicId":"cng_j006","difficulty":"standard","type":"choice","prompt":"比例尺很小的世界地图，适合用来？","choices":[{"key":"A","text":"查找某条胡同的门牌"},{"key":"B","text":"了解大洲大洋的相对位置"},{"key":"C","text":"量算校园操场长度"},{"key":"D","text":"辨别小区内部道路"}],"answer":"B","explanation":"小比例尺地图表示范围大、内容简略，适合看大区域位置。","verify":"\"了解大洲大洋的相对位置\""},{"id":"cng_j006_q4","topicId":"cng_j006","difficulty":"challenge","type":"choice","prompt":"既要看清某省各市位置，又要大致了解地形起伏，较合适的组合是？","choices":[{"key":"A","text":"只有世界气候类型图"},{"key":"B","text":"只有太阳系示意图"},{"key":"C","text":"省级政区图和地形图"},{"key":"D","text":"只有城市公交线路图"}],"answer":"C","explanation":"政区图给出行政区位置，地形图给出地势起伏，二者配合使用。","verify":"\"省级政区图和地形图\""}]
