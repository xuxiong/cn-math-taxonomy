[{"id":"cnp_020_q1","topicId":"cnp_020","difficulty":"basic","type":"choice","prompt":"中间厚、边缘薄的透镜叫什么？","choices":[{"key":"A","text":"凹透镜"},{"key":"B","text":"凸透镜"},{"key":"C","text":"平面镜"},{"key":"D","text":"三棱镜"}],"answer":"B","explanation":"中间厚边缘薄的是凸透镜，中间薄边缘厚的是凹透镜。","verify":"\"凸透镜\""},{"id":"cnp_020_q2","topicId":"cnp_020","difficulty":"basic","type":"choice","prompt":"平行于主光轴的光经过凸透镜后会怎样？","choices":[{"key":"A","text":"发散开"},{"key":"B","text":"会聚于焦点"},{"key":"C","text":"传播方向不变"},{"key":"D","text":"原路返回"}],"answer":"B","explanation":"凸透镜对光有会聚作用，平行于主光轴的光经折射后会聚于焦点。","verify":"\"会聚于焦点\""},{"id":"cnp_020_q3","topicId":"cnp_020","difficulty":"standard","type":"choice","prompt":"通过凸透镜光心的光线，经过透镜后传播方向怎样？","choices":[{"key":"A","text":"向主光轴偏折"},{"key":"B","text":"不变"},{"key":"C","text":"远离主光轴偏折"},{"key":"D","text":"会聚于焦点"}],"answer":"B","explanation":"过光心的光线传播方向不改变。","verify":"\"不变\""},{"id":"cnp_020_q4","topicId":"cnp_020","difficulty":"standard","type":"choice","prompt":"用一个凸透镜正对太阳光，在离透镜 10 cm 处得到最小最亮的光斑，该透镜的焦距约是多少？","choices":[{"key":"A","text":"10 cm"},{"key":"B","text":"20 cm"},{"key":"C","text":"5 cm"},{"key":"D","text":"无法确定"}],"answer":"A","explanation":"最小最亮的光斑就是焦点，焦点到光心的距离是焦距，约 10 cm。","verify":"\"10 cm\""}]
