[{"id":"cnm_h165_q1","topicId":"cnm_h165","difficulty":"basic","type":"choice","prompt":"直线倾斜角的取值范围是？","choices":[{"key":"A","text":"大于等于 0 度且小于等于 90 度"},{"key":"B","text":"大于 0 度且小于 360 度"},{"key":"C","text":"大于等于 0 度且小于 180 度"},{"key":"D","text":"任意实数"}],"answer":"C","explanation":"倾斜角取直线向上方向与 x 轴正方向的最小正角，范围是 [0，180) 度。","verify":"\"大于等于 0 度且小于 180 度\""},{"id":"cnm_h165_q2","topicId":"cnm_h165","difficulty":"basic","type":"choice","prompt":"与 x 轴平行且向右的直线，倾斜角是多少？","choices":[{"key":"A","text":"90 度"},{"key":"B","text":"180 度"},{"key":"C","text":"45 度"},{"key":"D","text":"0 度"}],"answer":"D","explanation":"直线方向与 x 轴正方向相同，倾斜角是 0 度。","verify":"\"0 度\""},{"id":"cnm_h165_q3","topicId":"cnm_h165","difficulty":"standard","type":"numeric","prompt":"一条直线的倾斜角是 90 度。它与 y 轴的夹角是多少度？","answer":"0","explanation":"倾斜角 90 度的直线垂直于 x 轴，与 y 轴方向相同，夹角是 0 度。","verify":"0"},{"id":"cnm_h165_q4","topicId":"cnm_h165","difficulty":"standard","type":"choice","prompt":"倾斜角是 120 度的直线，从左到右看是？","choices":[{"key":"A","text":"上升的"},{"key":"B","text":"下降的"},{"key":"C","text":"与 x 轴平行"},{"key":"D","text":"与 y 轴平行"}],"answer":"B","explanation":"倾斜角大于 90 度且小于 180 度时，直线从左到右下降。","verify":"\"下降的\""},{"id":"cnm_h166_q1","topicId":"cnm_h166","difficulty":"basic","type":"choice","prompt":"斜率存在时，它等于什么？","choices":[{"key":"A","text":"倾斜角的正弦"},{"key":"B","text":"倾斜角本身"},{"key":"C","text":"倾斜角的余弦"},{"key":"D","text":"倾斜角的正切"}],"answer":"D","explanation":"斜率 k=tanα，α 是倾斜角。","verify":"\"倾斜角的正切\""},{"id":"cnm_h166_q2","topicId":"cnm_h166","difficulty":"basic","type":"choice","prompt":"垂直于 x 轴的直线，斜率怎样？","choices":[{"key":"A","text":"不存在"},{"key":"B","text":"等于 0"},{"key":"C","text":"等于 1"},{"key":"D","text":"等于 −1"}],"answer":"A","explanation":"倾斜角是 90 度，正切没有意义，所以斜率不存在。","verify":"\"不存在\""},{"id":"cnm_h166_q3","topicId":"cnm_h166","difficulty":"standard","type":"numeric","prompt":"直线从左到右上升，经过横坐标增加 2、纵坐标增加 2 的两点。斜率是多少？","answer":"1","explanation":"斜率等于纵坐标增量除以横坐标增量：2/2=1。","verify":"Fraction(2,2)"},{"id":"cnm_h166_q4","topicId":"cnm_h166","difficulty":"standard","type":"choice","prompt":"斜率为 0 的直线与 x 轴的位置关系是？","choices":[{"key":"A","text":"垂直"},{"key":"B","text":"相交成 45 度"},{"key":"C","text":"平行或重合"},{"key":"D","text":"斜率不存在"}],"answer":"C","explanation":"斜率为 0 时倾斜角是 0 度，直线平行于 x 轴。","verify":"\"平行或重合\""},{"id":"cnm_h167_q1","topicId":"cnm_h167","difficulty":"basic","type":"numeric","prompt":"直线过 (1，1) 和 (4，7)。斜率是多少？","answer":"2","explanation":"(7−1)/(4−1)=6/3=2。","verify":"Fraction(7-1, 4-1)"},{"id":"cnm_h167_q2","topicId":"cnm_h167","difficulty":"basic","type":"numeric","prompt":"直线过 (0，2) 和 (3，−4)。斜率是多少？","answer":"-2","explanation":"(−4−2)/(3−0)=−6/3=−2。","verify":"Fraction(-4-2, 3-0)"},{"id":"cnm_h167_q3","topicId":"cnm_h167","difficulty":"standard","type":"choice","prompt":"两点 (2，1) 和 (2，5) 的连线，斜率怎样？","choices":[{"key":"A","text":"等于 0"},{"key":"B","text":"等于 2"},{"key":"C","text":"不存在"},{"key":"D","text":"等于 4"}],"answer":"C","explanation":"横坐标相同，直线垂直于 x 轴，斜率不存在。","verify":"\"不存在\""},{"id":"cnm_h167_q4","topicId":"cnm_h167","difficulty":"standard","type":"numeric","prompt":"直线过 (−1，3) 和 (3，3)。斜率是多少？","answer":"0","explanation":"纵坐标没有变化，斜率是 0。","verify":"Fraction(3-3, 3-(-1))"},{"id":"cnm_h168_q1","topicId":"cnm_h168","difficulty":"basic","type":"choice","prompt":"两条不重合的直线斜率都是 3。它们的位置关系是？","choices":[{"key":"A","text":"垂直"},{"key":"B","text":"平行"},{"key":"C","text":"一定重合"},{"key":"D","text":"相交成 60 度"}],"answer":"B","explanation":"斜率相等且都存在，两条直线平行。题目已说明两条直线不重合。","verify":"\"平行\""},{"id":"cnm_h168_q2","topicId":"cnm_h168","difficulty":"basic","type":"numeric","prompt":"一条直线斜率为 2，另一条与它垂直且斜率存在。另一条斜率是多少？","answer":"-1/2","explanation":"两条斜率之积为 −1，所以另一条斜率是 −1/2。","verify":"Fraction(-1,2)"},{"id":"cnm_h168_q3","topicId":"cnm_h168","difficulty":"standard","type":"choice","prompt":"一条直线斜率不存在，另一条斜率为 0。它们的位置关系是？","choices":[{"key":"A","text":"平行"},{"key":"B","text":"重合"},{"key":"C","text":"无法判断"},{"key":"D","text":"垂直"}],"answer":"D","explanation":"斜率不存在的直线垂直于 x 轴，斜率为 0 的直线平行于 x 轴，两者垂直。","verify":"\"垂直\""},{"id":"cnm_h168_q4","topicId":"cnm_h168","difficulty":"standard","type":"numeric","prompt":"l1 的斜率是 −3，l2 与 l1 平行。l2 的斜率是多少？","answer":"-3","explanation":"平行且斜率存在时，斜率相等，仍是 −3。","verify":"-3"}]
