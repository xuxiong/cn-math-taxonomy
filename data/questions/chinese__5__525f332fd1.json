[{"id":"cnc_p379_q1","topicId":"cnc_p379","difficulty":"basic","type":"choice","prompt":"「江、河、湖、海」都有三点水，说明它们多和什么有关？","choices":[{"key":"A","text":"水"},{"key":"B","text":"树木"},{"key":"C","text":"金属"},{"key":"D","text":"言语"}],"answer":"A","explanation":"三点水的字大多和水有关。","verify":"\"水\""},{"id":"cnc_p379_q2","topicId":"cnc_p379","difficulty":"basic","type":"choice","prompt":"「铜、铁、银」的部首提示它们多和什么有关？","choices":[{"key":"A","text":"水"},{"key":"B","text":"金属"},{"key":"C","text":"手的动作"},{"key":"D","text":"草"}],"answer":"B","explanation":"金字旁的字大多和金属有关。","verify":"\"金属\""},{"id":"cnc_p379_q3","topicId":"cnc_p379","difficulty":"standard","type":"choice","prompt":"「订、记、讨」的言字旁，提示它们多和什么有关？","choices":[{"key":"A","text":"走路"},{"key":"B","text":"房屋"},{"key":"C","text":"语言"},{"key":"D","text":"病痛"}],"answer":"C","explanation":"言字旁的字常和说话、语言有关。","verify":"\"语言\""},{"id":"cnc_p379_q4","topicId":"cnc_p379","difficulty":"standard","type":"choice","prompt":"看到不认识的字，哪一种做法有用？","choices":[{"key":"A","text":"只看最后一笔"},{"key":"B","text":"把偏旁全部忽略"},{"key":"C","text":"随便读一个音就当字义"},{"key":"D","text":"先看偏旁，再联系上下文"}],"answer":"D","explanation":"偏旁能提示类别，上下文能帮助确定意思。","verify":"\"先看偏旁，再联系上下文\""},{"id":"cnc_p380_q1","topicId":"cnc_p380","difficulty":"basic","type":"choice","prompt":"「日」「月」这一类字主要是什么造字法？","choices":[{"key":"A","text":"会意"},{"key":"B","text":"象形"},{"key":"C","text":"只是随便画的圆圈，不是汉字"},{"key":"D","text":"反义词"}],"answer":"B","explanation":"日、月的古文字就像太阳和月亮的样子，是象形。","verify":"\"象形\""},{"id":"cnc_p380_q2","topicId":"cnc_p380","difficulty":"basic","type":"choice","prompt":"「休」是人靠着树，这是什么造字法？","choices":[{"key":"A","text":"象形"},{"key":"B","text":"多音字"},{"key":"C","text":"会意"},{"key":"D","text":"同音字"}],"answer":"C","explanation":"人和木合在一起表示休息，是会意，不是单独像一件东西。","verify":"\"会意\""},{"id":"cnc_p380_q3","topicId":"cnc_p380","difficulty":"standard","type":"choice","prompt":"「明」为什么是会意字？","choices":[{"key":"A","text":"它的样子就像一只眼睛"},{"key":"B","text":"它和「日」的读音完全一样"},{"key":"C","text":"它只有一个偏旁"},{"key":"D","text":"日和月合在一起，表示明亮"}],"answer":"D","explanation":"两个都有光的字合起来，意思是亮。这是会意。","verify":"\"日和月合在一起，表示明亮\""},{"id":"cnc_p380_q4","topicId":"cnc_p380","difficulty":"standard","type":"choice","prompt":"哪一种说法是对的？","choices":[{"key":"A","text":"象形看整体像什么，会意看合起来的意思"},{"key":"B","text":"两种造字法没有区别"},{"key":"C","text":"会意字都不能拆开"},{"key":"D","text":"象形字一定是左右结构"}],"answer":"A","explanation":"先看它像一件物，还是几个部分各有意思，再判断。","verify":"\"象形看整体像什么，会意看合起来的意思\""}]
