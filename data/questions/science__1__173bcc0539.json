[{"id":"cns_p008_q1","topicId":"cns_p008","difficulty":"basic","type":"choice","prompt":"我们用什么走路？","choices":[{"key":"A","text":"手"},{"key":"B","text":"腿和脚"},{"key":"C","text":"耳朵"},{"key":"D","text":"头发"}],"answer":"B","explanation":"走路靠腿和脚。","verify":"\"腿和脚\""},{"id":"cns_p008_q2","topicId":"cns_p008","difficulty":"basic","type":"choice","prompt":"胳膊和腿合起来叫什么？","choices":[{"key":"A","text":"五官"},{"key":"B","text":"躯干"},{"key":"C","text":"四肢"},{"key":"D","text":"头部"}],"answer":"C","explanation":"两只胳膊和两条腿叫四肢。","verify":"\"四肢\""},{"id":"cns_p008_q3","topicId":"cns_p008","difficulty":"standard","type":"choice","prompt":"连接头和躯干的部位是哪里？","choices":[{"key":"A","text":"膝盖"},{"key":"B","text":"手腕"},{"key":"C","text":"脚踝"},{"key":"D","text":"颈（脖子）"}],"answer":"D","explanation":"脖子连接头和身体。","verify":"\"颈（脖子）\""},{"id":"cns_p008_q4","topicId":"cns_p008","difficulty":"challenge","type":"choice","prompt":"跳绳时，需要身体的哪些部分一起配合？","choices":[{"key":"A","text":"手臂、腿和脚一起配合"},{"key":"B","text":"只用手"},{"key":"C","text":"只用脚"},{"key":"D","text":"只用眼睛"}],"answer":"A","explanation":"跳绳时手臂摇绳，腿和脚起跳，身体各部分协同完成动作。","verify":"\"手臂、腿和脚一起配合\""},{"id":"cns_p009_q1","topicId":"cns_p009","difficulty":"basic","type":"choice","prompt":"和刚出生时比，我们现在怎么样？","choices":[{"key":"A","text":"变小了"},{"key":"B","text":"一点没变"},{"key":"C","text":"长高长大了"},{"key":"D","text":"变成了植物"}],"answer":"C","explanation":"人在不断生长。","verify":"\"长高长大了\""},{"id":"cns_p009_q2","topicId":"cns_p009","difficulty":"basic","type":"choice","prompt":"去年的鞋子穿着挤脚了，说明什么？","choices":[{"key":"A","text":"鞋子变长了"},{"key":"B","text":"天气变冷了"},{"key":"C","text":"鞋子被洗大了"},{"key":"D","text":"脚长大了"}],"answer":"D","explanation":"鞋子变小是因为脚长大。","verify":"\"脚长大了\""},{"id":"cns_p009_q3","topicId":"cns_p009","difficulty":"standard","type":"choice","prompt":"想知道一年里自己长高了多少，最好怎么做？","choices":[{"key":"A","text":"隔一段时间量身高并记下来"},{"key":"B","text":"看镜子猜"},{"key":"C","text":"量一次就行"},{"key":"D","text":"问同学我高不高"}],"answer":"A","explanation":"多次测量并记录，再比较。","verify":"\"隔一段时间量身高并记下来\""},{"id":"cns_p009_q4","topicId":"cns_p009","difficulty":"challenge","type":"choice","prompt":"下面哪一样能证明小明在长大？","choices":[{"key":"A","text":"他今天穿了新衣服"},{"key":"B","text":"门框上去年和今年的身高标记相差 5 厘米"},{"key":"C","text":"他喜欢吃苹果"},{"key":"D","text":"他换了新书包"}],"answer":"B","explanation":"两次身高记录的差距就是长大的证据。","verify":"\"门框上去年和今年的身高标记相差 5 厘米\""},{"id":"cns_p010_q1","topicId":"cns_p010","difficulty":"basic","type":"choice","prompt":"我们用什么看东西？","choices":[{"key":"A","text":"耳朵"},{"key":"B","text":"鼻子"},{"key":"C","text":"舌头"},{"key":"D","text":"眼睛"}],"answer":"D","explanation":"眼睛是视觉器官。","verify":"\"眼睛\""},{"id":"cns_p010_q2","topicId":"cns_p010","difficulty":"basic","type":"choice","prompt":"在强烈的阳光下，保护眼睛的做法是？","choices":[{"key":"A","text":"不直视太阳"},{"key":"B","text":"一直盯着太阳看"},{"key":"C","text":"用手揉眼睛"},{"key":"D","text":"睁大眼睛看太阳"}],"answer":"A","explanation":"直视太阳会伤害眼睛。","verify":"\"不直视太阳\""},{"id":"cns_p010_q3","topicId":"cns_p010","difficulty":"standard","type":"choice","prompt":"下面哪一项是用眼睛观察出来的？","choices":[{"key":"A","text":"花有香味"},{"key":"B","text":"花是红色的"},{"key":"C","text":"糖是甜的"},{"key":"D","text":"铃声很响"}],"answer":"B","explanation":"颜色要用眼睛看；香味靠鼻子，甜靠舌头，声音靠耳朵。","verify":"\"花是红色的\""},{"id":"cns_p010_q4","topicId":"cns_p010","difficulty":"challenge","type":"choice","prompt":"「找不同」游戏里，小红很快找出了两幅图的不同之处，主要因为她怎样？","choices":[{"key":"A","text":"闭上眼睛猜"},{"key":"B","text":"只看了一眼"},{"key":"C","text":"按顺序仔细地看"},{"key":"D","text":"用耳朵听"}],"answer":"C","explanation":"有顺序、仔细地观察，才不会漏掉细节。","verify":"\"按顺序仔细地看\""},{"id":"cns_p011_q1","topicId":"cns_p011","difficulty":"basic","type":"choice","prompt":"我们用什么闻气味？","choices":[{"key":"A","text":"鼻子"},{"key":"B","text":"眼睛"},{"key":"C","text":"耳朵"},{"key":"D","text":"手"}],"answer":"A","explanation":"鼻子是嗅觉器官。","verify":"\"鼻子\""},{"id":"cns_p011_q2","topicId":"cns_p011","difficulty":"basic","type":"choice","prompt":"闻一种不知道的气味，正确的方法是？","choices":[{"key":"A","text":"把鼻子凑近瓶口用力吸"},{"key":"B","text":"用手轻轻把气味扇向鼻子"},{"key":"C","text":"直接喝一口"},{"key":"D","text":"把它倒在手上舔"}],"answer":"B","explanation":"扇闻法更安全，不会一下吸进太多。","verify":"\"用手轻轻把气味扇向鼻子\""},{"id":"cns_p011_q3","topicId":"cns_p011","difficulty":"standard","type":"choice","prompt":"闻气味能分辨出下面哪两样？","choices":[{"key":"A","text":"白纸和白布"},{"key":"B","text":"红球和蓝球"},{"key":"C","text":"醋和清水"},{"key":"D","text":"大石头和小石头"}],"answer":"C","explanation":"醋有酸味，清水几乎没有气味，靠闻能分辨。","verify":"\"醋和清水\""},{"id":"cns_p011_q4","topicId":"cns_p011","difficulty":"challenge","type":"choice","prompt":"厨房里闻到很浓的煤气味，应该先怎么做？","choices":[{"key":"A","text":"马上打开电灯看看"},{"key":"B","text":"用打火机找原因"},{"key":"C","text":"不用管它"},{"key":"D","text":"不开灯、不点火，告诉大人开窗"}],"answer":"D","explanation":"煤气泄漏遇火花可能爆炸，要立刻开窗通风并告诉大人。","verify":"\"不开灯、不点火，告诉大人开窗\""},{"id":"cns_p012_q1","topicId":"cns_p012","difficulty":"basic","type":"choice","prompt":"用舌头可以知道食物的什么？","choices":[{"key":"A","text":"颜色"},{"key":"B","text":"味道"},{"key":"C","text":"声音"},{"key":"D","text":"大小"}],"answer":"B","explanation":"舌头尝出酸甜苦咸。","verify":"\"味道\""},{"id":"cns_p012_q2","topicId":"cns_p012","difficulty":"basic","type":"choice","prompt":"用手摸，能感觉到物体的什么？","choices":[{"key":"A","text":"颜色"},{"key":"B","text":"气味"},{"key":"C","text":"冷热和软硬"},{"key":"D","text":"声音"}],"answer":"C","explanation":"皮肤能感觉冷热、软硬、粗糙或光滑。","verify":"\"冷热和软硬\""},{"id":"cns_p012_q3","topicId":"cns_p012","difficulty":"standard","type":"choice","prompt":"认识一个苹果，用哪几种感官最全面？","choices":[{"key":"A","text":"只用眼睛看"},{"key":"B","text":"只用耳朵听"},{"key":"C","text":"只用鼻子闻"},{"key":"D","text":"看、摸、闻，洗干净后尝"}],"answer":"D","explanation":"多种感官一起用，认识得更全面。","verify":"\"看、摸、闻，洗干净后尝\""},{"id":"cns_p012_q4","topicId":"cns_p012","difficulty":"challenge","type":"choice","prompt":"蒙上眼睛，只靠摸和闻分辨橘子和苹果，下面哪条线索最有用？","choices":[{"key":"A","text":"橘子皮摸起来有小坑，还有橘子的香味"},{"key":"B","text":"它们都是圆的"},{"key":"C","text":"它们都能吃"},{"key":"D","text":"它们都长在树上"}],"answer":"A","explanation":"表面手感和气味是两者不同的地方。","verify":"\"橘子皮摸起来有小坑，还有橘子的香味\""},{"id":"cns_p013_q1","topicId":"cns_p013","difficulty":"basic","type":"choice","prompt":"比较两个苹果，下面哪一项是在比大小？","choices":[{"key":"A","text":"哪个苹果更红"},{"key":"B","text":"哪个更香"},{"key":"C","text":"哪个苹果更大"},{"key":"D","text":"哪个更甜"}],"answer":"C","explanation":"大小指物体占的地方多少。","verify":"\"哪个苹果更大\""},{"id":"cns_p013_q2","topicId":"cns_p013","difficulty":"basic","type":"choice","prompt":"比较两本书谁更重，最可靠的办法是？","choices":[{"key":"A","text":"看谁的封面颜色深"},{"key":"B","text":"看谁的名字长"},{"key":"C","text":"闻一闻"},{"key":"D","text":"一手拿一本掂一掂，或者用秤称"}],"answer":"D","explanation":"比较轻重要掂一掂或称一称。","verify":"\"一手拿一本掂一掂，或者用秤称\""},{"id":"cns_p013_q3","topicId":"cns_p013","difficulty":"standard","type":"choice","prompt":"比较一块石头和一个乒乓球，它们的相同点是什么？","choices":[{"key":"A","text":"都没有生命"},{"key":"B","text":"都很重"},{"key":"C","text":"都会弹得很高"},{"key":"D","text":"都是白色的"}],"answer":"A","explanation":"石头重、乒乓球轻；颜色也不一定一样，但它们都没有生命。","verify":"\"都没有生命\""},{"id":"cns_p013_q4","topicId":"cns_p013","difficulty":"challenge","type":"choice","prompt":"比较两根绳子谁更长，正确的做法是？","choices":[{"key":"A","text":"看哪根更粗"},{"key":"B","text":"把一端对齐拉直再看另一端"},{"key":"C","text":"把绳子揉成团再看"},{"key":"D","text":"看哪根颜色更亮"}],"answer":"B","explanation":"比长短要一端对齐、拉直后比另一端。","verify":"\"把一端对齐拉直再看另一端\""},{"id":"cns_p014_q1","topicId":"cns_p014","difficulty":"basic","type":"choice","prompt":"「时间胶囊」主要用来做什么？","choices":[{"key":"A","text":"装零食"},{"key":"B","text":"当玩具"},{"key":"C","text":"放垃圾"},{"key":"D","text":"留下现在的记录，以后比较变化"}],"answer":"D","explanation":"时间胶囊保存现在的样子，过一段时间打开就能比较。","verify":"\"留下现在的记录，以后比较变化\""},{"id":"cns_p014_q2","topicId":"cns_p014","difficulty":"basic","type":"choice","prompt":"下面哪一样最适合放进时间胶囊？","choices":[{"key":"A","text":"写着现在身高的卡片"},{"key":"B","text":"一块饼干"},{"key":"C","text":"一杯水"},{"key":"D","text":"一只小鱼"}],"answer":"A","explanation":"身高卡片能长期保存，以后能比较。","verify":"\"写着现在身高的卡片\""},{"id":"cns_p014_q3","topicId":"cns_p014","difficulty":"standard","type":"choice","prompt":"一年后打开时间胶囊，把手放在去年的手印画上，发现手比手印大了，说明什么？","choices":[{"key":"A","text":"纸变小了"},{"key":"B","text":"我的手长大了"},{"key":"C","text":"手印画被换了"},{"key":"D","text":"手印画会自己缩小"}],"answer":"B","explanation":"现在的手比一年前大，所以旧手印显得小。","verify":"\"我的手长大了\""},{"id":"cns_p014_q4","topicId":"cns_p014","difficulty":"challenge","type":"choice","prompt":"为什么时间胶囊里的记录要写上日期？","choices":[{"key":"A","text":"日期让卡片更好看"},{"key":"B","text":"老师要求写满"},{"key":"C","text":"以后才知道是什么时候的样子"},{"key":"D","text":"没有原因"}],"answer":"C","explanation":"有日期才能算出过了多久、变化了多少。","verify":"\"以后才知道是什么时候的样子\""},{"id":"cns_p015_q1","topicId":"cns_p015","difficulty":"basic","type":"choice","prompt":"看书时，眼睛和书本之间大约应保持多远？","choices":[{"key":"A","text":"约一尺（30 厘米左右）"},{"key":"B","text":"贴着书本"},{"key":"C","text":"约 3 厘米"},{"key":"D","text":"越近越好"}],"answer":"A","explanation":"读写时眼睛离书本约一尺，能保护视力。","verify":"\"约一尺（30 厘米左右）\""},{"id":"cns_p015_q2","topicId":"cns_p015","difficulty":"basic","type":"choice","prompt":"下面哪种做法会伤害耳朵？","choices":[{"key":"A","text":"远离很响的声音"},{"key":"B","text":"用尖东西掏耳朵"},{"key":"C","text":"游泳后擦干耳朵"},{"key":"D","text":"感冒时轻轻擤鼻涕"}],"answer":"B","explanation":"尖东西可能戳伤耳道和鼓膜。","verify":"\"用尖东西掏耳朵\""},{"id":"cns_p015_q3","topicId":"cns_p015","difficulty":"standard","type":"choice","prompt":"用眼一段时间后，最好做什么？","choices":[{"key":"A","text":"继续长时间看手机"},{"key":"B","text":"用手使劲揉眼睛"},{"key":"C","text":"向远处看看，让眼睛休息"},{"key":"D","text":"闭眼看强光"}],"answer":"C","explanation":"远眺能让眼睛放松。","verify":"\"向远处看看，让眼睛休息\""},{"id":"cns_p015_q4","topicId":"cns_p015","difficulty":"challenge","type":"choice","prompt":"鞭炮声很响时，正确的保护方法是？","choices":[{"key":"A","text":"凑近去听"},{"key":"B","text":"把耳朵贴到地上"},{"key":"C","text":"大声喊叫"},{"key":"D","text":"张开嘴或捂住耳朵，并远离"}],"answer":"D","explanation":"远离强声，必要时捂耳并张嘴，减少对耳朵的伤害。","verify":"\"张开嘴或捂住耳朵，并远离\""}]
