[{"id":"cnp_015_q1","topicId":"cnp_015","difficulty":"basic","type":"choice","prompt":"下列物体中属于光源的是哪一个？","choices":[{"key":"A","text":"月亮"},{"key":"B","text":"闪闪发亮的钻石"},{"key":"C","text":"正在发光的萤火虫"},{"key":"D","text":"电影银幕"}],"answer":"C","explanation":"自身能发光的物体才是光源；月亮、钻石、银幕都是反射别的光。","verify":"\"正在发光的萤火虫\""},{"id":"cnp_015_q2","topicId":"cnp_015","difficulty":"basic","type":"choice","prompt":"光在真空中的传播速度约是多少？","choices":[{"key":"A","text":"3×10⁸ m/s"},{"key":"B","text":"340 m/s"},{"key":"C","text":"3×10⁵ m/s"},{"key":"D","text":"3×10⁸ km/s"}],"answer":"A","explanation":"真空中光速 c ≈ 3×10⁸ m/s = 3×10⁵ km/s；340 m/s 是空气中的声速。","verify":"\"3×10⁸ m/s\""},{"id":"cnp_015_q3","topicId":"cnp_015","difficulty":"standard","type":"choice","prompt":"“光年”是什么物理量的单位？","choices":[{"key":"A","text":"长度（距离）"},{"key":"B","text":"时间"},{"key":"C","text":"速度"},{"key":"D","text":"年份"}],"answer":"A","explanation":"光年是光在一年内传播的距离，是长度单位。","verify":"\"长度（距离）\""},{"id":"cnp_015_q4","topicId":"cnp_015","difficulty":"standard","type":"choice","prompt":"小孔成像中，像的形状由什么决定？","choices":[{"key":"A","text":"小孔的形状"},{"key":"B","text":"光屏的形状"},{"key":"C","text":"小孔的大小"},{"key":"D","text":"物体的形状"}],"answer":"D","explanation":"小孔成像是光沿直线传播形成的倒立实像，像的形状与物体相同，与小孔形状无关。","verify":"\"物体的形状\""}]
