[{"id":"cns_p219_q1","topicId":"cns_p219","difficulty":"basic","type":"choice","prompt":"把纸撕成碎片，这是什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"化学变化"},{"key":"C","text":"生命变化"},{"key":"D","text":"没有变化"}],"answer":"A","explanation":"没有产生新物质，是物理变化。","verify":"\"物理变化\""},{"id":"cns_p219_q2","topicId":"cns_p219","difficulty":"basic","type":"choice","prompt":"把面包烤焦变黑，这是什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"化学变化"},{"key":"C","text":"状态变化"},{"key":"D","text":"形状变化"}],"answer":"B","explanation":"烤焦产生了新物质（炭）。","verify":"\"化学变化\""},{"id":"cns_p219_q3","topicId":"cns_p219","difficulty":"standard","type":"choice","prompt":"判断物理变化和化学变化的根本依据是什么？","choices":[{"key":"A","text":"是否改变了形状"},{"key":"B","text":"是否改变了颜色"},{"key":"C","text":"是否产生了新的物质"},{"key":"D","text":"是否发出了声音"}],"answer":"C","explanation":"有新物质生成的是化学变化。","verify":"\"是否产生了新的物质\""},{"id":"cns_p219_q4","topicId":"cns_p219","difficulty":"challenge","type":"choice","prompt":"下面哪一个是化学变化？","choices":[{"key":"A","text":"冰化成水"},{"key":"B","text":"把萝卜切丝"},{"key":"C","text":"糖溶解在水里"},{"key":"D","text":"铁锅生锈"}],"answer":"D","explanation":"铁锈是新物质。","verify":"\"铁锅生锈\""},{"id":"cns_p220_q1","topicId":"cns_p220","difficulty":"basic","type":"choice","prompt":"小苏打和白醋混合时会看到什么？","choices":[{"key":"A","text":"没有变化"},{"key":"B","text":"产生大量气泡"},{"key":"C","text":"变成固体冰块"},{"key":"D","text":"发出强光"}],"answer":"B","explanation":"两者反应产生二氧化碳气体。","verify":"\"产生大量气泡\""},{"id":"cns_p220_q2","topicId":"cns_p220","difficulty":"basic","type":"choice","prompt":"小苏打和白醋反应产生的气体是什么？","choices":[{"key":"A","text":"氧气"},{"key":"B","text":"氢气"},{"key":"C","text":"二氧化碳"},{"key":"D","text":"水蒸气"}],"answer":"C","explanation":"生成的气体是二氧化碳。","verify":"\"二氧化碳\""},{"id":"cns_p220_q3","topicId":"cns_p220","difficulty":"standard","type":"choice","prompt":"把燃着的小木条伸进装有这种气体的杯中，会怎样？","choices":[{"key":"A","text":"燃得更旺"},{"key":"B","text":"爆炸"},{"key":"C","text":"没有变化"},{"key":"D","text":"熄灭"}],"answer":"D","explanation":"二氧化碳不支持燃烧。","verify":"\"熄灭\""},{"id":"cns_p220_q4","topicId":"cns_p220","difficulty":"challenge","type":"choice","prompt":"这个反应属于什么变化，为什么？","choices":[{"key":"A","text":"化学变化，因为产生了新物质二氧化碳"},{"key":"B","text":"物理变化，因为只冒泡"},{"key":"C","text":"物理变化，因为没颜色"},{"key":"D","text":"没有变化"}],"answer":"A","explanation":"产生了新物质就是化学变化。","verify":"\"化学变化，因为产生了新物质二氧化碳\""},{"id":"cns_p221_q1","topicId":"cns_p221","difficulty":"basic","type":"choice","prompt":"蜡烛燃烧时，下面哪个现象说明有新物质生成？","choices":[{"key":"A","text":"蜡烛熔化成液体"},{"key":"B","text":"蜡油凝固"},{"key":"C","text":"罩在火焰上方的干冷玻璃片上出现小水珠"},{"key":"D","text":"蜡烛变短"}],"answer":"C","explanation":"燃烧生成了水和炭黑等新物质。","verify":"\"罩在火焰上方的干冷玻璃片上出现小水珠\""},{"id":"cns_p221_q2","topicId":"cns_p221","difficulty":"basic","type":"choice","prompt":"化学变化常伴随哪些现象？","choices":[{"key":"A","text":"只有形状变化"},{"key":"B","text":"什么现象都没有"},{"key":"C","text":"只是位置变化"},{"key":"D","text":"发光发热、变色、产生气体"}],"answer":"D","explanation":"这些现象可帮助判断化学变化。","verify":"\"发光发热、变色、产生气体\""},{"id":"cns_p221_q3","topicId":"cns_p221","difficulty":"standard","type":"choice","prompt":"在淀粉上滴碘酒变蓝，属于什么变化？","choices":[{"key":"A","text":"化学变化"},{"key":"B","text":"物理变化"},{"key":"C","text":"状态变化"},{"key":"D","text":"溶解"}],"answer":"A","explanation":"生成了新的蓝色物质。","verify":"\"化学变化\""},{"id":"cns_p221_q4","topicId":"cns_p221","difficulty":"challenge","type":"choice","prompt":"电灯通电发光发热，是化学变化吗？","choices":[{"key":"A","text":"是，因为发光"},{"key":"B","text":"不是，没有产生新物质"},{"key":"C","text":"是，因为发热"},{"key":"D","text":"是，因为用电"}],"answer":"B","explanation":"有发光发热现象，不一定是化学变化。","verify":"\"不是，没有产生新物质\""},{"id":"cns_p222_q1","topicId":"cns_p222","difficulty":"basic","type":"choice","prompt":"下面哪个是生命体中的化学变化？","choices":[{"key":"A","text":"伸了个懒腰"},{"key":"B","text":"头发被剪短"},{"key":"C","text":"出汗变干"},{"key":"D","text":"食物在体内被消化分解"}],"answer":"D","explanation":"消化过程中食物变成新物质。","verify":"\"食物在体内被消化分解\""},{"id":"cns_p222_q2","topicId":"cns_p222","difficulty":"basic","type":"choice","prompt":"防止铁制品生锈，可以怎样做？","choices":[{"key":"A","text":"刷油漆或保持干燥"},{"key":"B","text":"经常浸在水里"},{"key":"C","text":"放在潮湿的地方"},{"key":"D","text":"用盐水擦"}],"answer":"A","explanation":"隔绝水和空气可以防锈。","verify":"\"刷油漆或保持干燥\""},{"id":"cns_p222_q3","topicId":"cns_p222","difficulty":"standard","type":"choice","prompt":"绿色植物的光合作用属于什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"化学变化"},{"key":"C","text":"状态变化"},{"key":"D","text":"位置变化"}],"answer":"B","explanation":"二氧化碳和水变成了养料和氧气。","verify":"\"化学变化\""},{"id":"cns_p222_q4","topicId":"cns_p222","difficulty":"challenge","type":"choice","prompt":"酸雨腐蚀大理石雕像，这是什么变化，造成的影响是？","choices":[{"key":"A","text":"物理变化，没有影响"},{"key":"B","text":"化学变化，让雕像更漂亮"},{"key":"C","text":"化学变化，会损坏文物和建筑"},{"key":"D","text":"物理变化，让雕像更结实"}],"answer":"C","explanation":"酸雨与碳酸钙反应，产生新物质。","verify":"\"化学变化，会损坏文物和建筑\""}]
