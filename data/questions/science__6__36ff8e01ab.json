[{"id":"cns_p219_q1","topicId":"cns_p219","difficulty":"basic","type":"choice","prompt":"把纸撕成碎片，这是什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"化学变化"},{"key":"C","text":"生命变化"},{"key":"D","text":"没有变化"}],"answer":"A","explanation":"没有产生新物质，是物理变化。","verify":"\"物理变化\""},{"id":"cns_p219_q2","topicId":"cns_p219","difficulty":"basic","type":"choice","prompt":"把面包烤焦变黑，这是什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"化学变化"},{"key":"C","text":"状态变化"},{"key":"D","text":"形状变化"}],"answer":"B","explanation":"烤焦产生了新物质（炭）。","verify":"\"化学变化\""},{"id":"cns_p219_q3","topicId":"cns_p219","difficulty":"standard","type":"choice","prompt":"判断物理变化和化学变化的根本依据是什么？","choices":[{"key":"A","text":"是否改变了形状"},{"key":"B","text":"是否改变了颜色"},{"key":"C","text":"是否产生了新的物质"},{"key":"D","text":"是否发出了声音"}],"answer":"C","explanation":"有新物质生成的是化学变化。","verify":"\"是否产生了新的物质\""},{"id":"cns_p219_q4","topicId":"cns_p219","difficulty":"challenge","type":"choice","prompt":"下面哪一个是化学变化？","choices":[{"key":"A","text":"冰化成水"},{"key":"B","text":"把萝卜切丝"},{"key":"C","text":"糖溶解在水里"},{"key":"D","text":"铁锅生锈"}],"answer":"D","explanation":"铁锈是新物质。","verify":"\"铁锅生锈\""},{"id":"cns_p220_q1","topicId":"cns_p220","difficulty":"basic","type":"choice","prompt":"小苏打和白醋混合时会看到什么？","choices":[{"key":"A","text":"没有变化"},{"key":"B","text":"产生大量气泡"},{"key":"C","text":"变成固体冰块"},{"key":"D","text":"发出强光"}],"answer":"B","explanation":"两者反应产生二氧化碳气体。","verify":"\"产生大量气泡\""},{"id":"cns_p220_q2","topicId":"cns_p220","difficulty":"basic","type":"choice","prompt":"小苏打和白醋反应产生的气体是什么？","choices":[{"key":"A","text":"氧气"},{"key":"B","text":"氢气"},{"key":"C","text":"二氧化碳"},{"key":"D","text":"水蒸气"}],"answer":"C","explanation":"生成的气体是二氧化碳。","verify":"\"二氧化碳\""},{"id":"cns_p220_q3","topicId":"cns_p220","difficulty":"standard","type":"choice","prompt":"把燃着的小木条伸进装有这种气体的杯中，会怎样？","choices":[{"key":"A","text":"燃得更旺"},{"key":"B","text":"爆炸"},{"key":"C","text":"没有变化"},{"key":"D","text":"熄灭"}],"answer":"D","explanation":"二氧化碳不支持燃烧。","verify":"\"熄灭\""},{"id":"cns_p220_q4","topicId":"cns_p220","difficulty":"challenge","type":"choice","prompt":"这个反应属于什么变化，为什么？","choices":[{"key":"A","text":"化学变化，因为产生了新物质二氧化碳"},{"key":"B","text":"物理变化，因为只冒泡"},{"key":"C","text":"物理变化，因为没颜色"},{"key":"D","text":"没有变化"}],"answer":"A","explanation":"产生了新物质就是化学变化。","verify":"\"化学变化，因为产生了新物质二氧化碳\""},{"id":"cns_p221_q1","topicId":"cns_p221","difficulty":"basic","type":"choice","prompt":"蜡烛燃烧时，下面哪个现象说明有新物质生成？","choices":[{"key":"A","text":"蜡烛熔化成液体"},{"key":"B","text":"蜡油凝固"},{"key":"C","text":"罩在火焰上方的干冷玻璃片上出现小水珠"},{"key":"D","text":"蜡烛变短"}],"answer":"C","explanation":"燃烧生成了水和炭黑等新物质。","verify":"\"罩在火焰上方的干冷玻璃片上出现小水珠\""},{"id":"cns_p221_q2","topicId":"cns_p221","difficulty":"basic","type":"choice","prompt":"在淀粉上滴碘酒变蓝，属于什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"状态变化"},{"key":"C","text":"溶解"},{"key":"D","text":"化学变化"}],"answer":"D","explanation":"生成了新的蓝色物质。","verify":"\"化学变化\""},{"id":"cns_p221_q3","topicId":"cns_p221","difficulty":"standard","type":"choice","prompt":"发现变化中的新物质，主要看什么？","choices":[{"key":"A","text":"变化后出现了与原来不同的物质"},{"key":"B","text":"只看物体有没有被移动"},{"key":"C","text":"只看形状有没有改变"},{"key":"D","text":"只看有没有发出声音"}],"answer":"A","explanation":"新物质是变化后生成的、与原来不同的物质。","verify":"\"变化后出现了与原来不同的物质\""},{"id":"cns_p221_q4","topicId":"cns_p221","difficulty":"challenge","type":"choice","prompt":"铁在潮湿空气中表面出现铁锈，铁锈和原来的铁相比说明什么？","choices":[{"key":"A","text":"铁锈仍是原来的铁"},{"key":"B","text":"铁锈是变化中生成的新物质"},{"key":"C","text":"铁锈说明铁只改变了形状"},{"key":"D","text":"铁锈说明没有发生变化"}],"answer":"B","explanation":"铁锈的性质和铁不同，是新生成的物质。","verify":"\"铁锈是变化中生成的新物质\""},{"id":"cns_p258_q1","topicId":"cns_p258","difficulty":"basic","type":"choice","prompt":"化学变化常伴随哪些现象？","choices":[{"key":"A","text":"只有形状变化"},{"key":"B","text":"什么现象都没有"},{"key":"C","text":"只是位置变化"},{"key":"D","text":"发光发热、变色、产生气体"}],"answer":"D","explanation":"这些现象可帮助判断化学变化。","verify":"\"发光发热、变色、产生气体\""},{"id":"cns_p258_q2","topicId":"cns_p258","difficulty":"basic","type":"choice","prompt":"电灯通电发光发热，是化学变化吗？","choices":[{"key":"A","text":"不是，没有产生新物质"},{"key":"B","text":"是，因为发光"},{"key":"C","text":"是，因为发热"},{"key":"D","text":"是，因为用电"}],"answer":"A","explanation":"有发光发热现象，不一定是化学变化。","verify":"\"不是，没有产生新物质\""},{"id":"cns_p258_q3","topicId":"cns_p258","difficulty":"standard","type":"choice","prompt":"下面哪一项属于变化中常伴随的现象？","choices":[{"key":"A","text":"只把物体搬到别处"},{"key":"B","text":"变色或产生气体"},{"key":"C","text":"只用尺子量长度"},{"key":"D","text":"只把物品放进柜子"}],"answer":"B","explanation":"变色、产生气体是变化过程中可能一起出现的现象。","verify":"\"变色或产生气体\""},{"id":"cns_p258_q4","topicId":"cns_p258","difficulty":"challenge","type":"choice","prompt":"双手摩擦会发热，但没有产生新物质。这个例子说明什么？","choices":[{"key":"A","text":"发热就一定产生了新物质"},{"key":"B","text":"摩擦后双手变成了新物质"},{"key":"C","text":"发热不一定是化学变化"},{"key":"D","text":"没有新物质就不可能发热"}],"answer":"C","explanation":"发热是可能伴随的现象，不能单独说明产生了新物质。","verify":"\"发热不一定是化学变化\""},{"id":"cns_p222_q1","topicId":"cns_p222","difficulty":"basic","type":"choice","prompt":"铁制品在潮湿空气中生锈，属于什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"只是形状变化"},{"key":"C","text":"没有变化"},{"key":"D","text":"化学变化"}],"answer":"D","explanation":"铁锈是新生成的物质，所以生锈是化学变化。","verify":"\"化学变化\""},{"id":"cns_p222_q2","topicId":"cns_p222","difficulty":"basic","type":"choice","prompt":"防止铁制品生锈，可以怎样做？","choices":[{"key":"A","text":"刷油漆或保持干燥"},{"key":"B","text":"经常浸在水里"},{"key":"C","text":"放在潮湿的地方"},{"key":"D","text":"用盐水擦"}],"answer":"A","explanation":"隔绝水和空气可以防锈。","verify":"\"刷油漆或保持干燥\""},{"id":"cns_p222_q3","topicId":"cns_p222","difficulty":"standard","type":"choice","prompt":"木柴在空气中燃烧，属于什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"化学变化"},{"key":"C","text":"只是位置变化"},{"key":"D","text":"没有变化"}],"answer":"B","explanation":"燃烧生成了与原来不同的新物质。","verify":"\"化学变化\""},{"id":"cns_p222_q4","topicId":"cns_p222","difficulty":"challenge","type":"choice","prompt":"酸雨腐蚀大理石雕像，这是什么变化，造成的影响是？","choices":[{"key":"A","text":"物理变化，没有影响"},{"key":"B","text":"化学变化，让雕像更漂亮"},{"key":"C","text":"化学变化，会损坏文物和建筑"},{"key":"D","text":"物理变化，让雕像更结实"}],"answer":"C","explanation":"酸雨与大理石发生反应，产生新物质，会损坏文物和建筑。","verify":"\"化学变化，会损坏文物和建筑\""},{"id":"cns_p259_q1","topicId":"cns_p259","difficulty":"basic","type":"choice","prompt":"下面哪个是生命体中的化学变化？","choices":[{"key":"A","text":"食物在体内被消化分解"},{"key":"B","text":"伸了个懒腰"},{"key":"C","text":"头发被剪短"},{"key":"D","text":"出汗变干"}],"answer":"A","explanation":"消化过程中食物变成新物质。","verify":"\"食物在体内被消化分解\""},{"id":"cns_p259_q2","topicId":"cns_p259","difficulty":"basic","type":"choice","prompt":"绿色植物的光合作用属于什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"化学变化"},{"key":"C","text":"状态变化"},{"key":"D","text":"位置变化"}],"answer":"B","explanation":"光合作用中，二氧化碳和水变成了养料和氧气。","verify":"\"化学变化\""},{"id":"cns_p259_q3","topicId":"cns_p259","difficulty":"standard","type":"choice","prompt":"人呼吸时，身体利用氧气并产生二氧化碳，这属于什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"只是空气进出"},{"key":"C","text":"化学变化"},{"key":"D","text":"位置变化"}],"answer":"C","explanation":"呼吸过程中物质发生了变化，生成了新的物质。","verify":"\"化学变化\""},{"id":"cns_p259_q4","topicId":"cns_p259","difficulty":"challenge","type":"choice","prompt":"食物在体内被消化后变成能被吸收的物质，这说明什么？","choices":[{"key":"A","text":"消化只是把食物切碎，没有新物质"},{"key":"B","text":"消化是位置变化"},{"key":"C","text":"消化后食物和原来完全一样"},{"key":"D","text":"消化过程中发生了化学变化"}],"answer":"D","explanation":"消化把食物变成了新的、能被身体利用的物质。","verify":"\"消化过程中发生了化学变化\""},{"id":"cns_p260_q1","topicId":"cns_p260","difficulty":"basic","type":"choice","prompt":"节日夜空中的烟花绽放，发出彩色的光，这主要是什么变化？","choices":[{"key":"A","text":"物理变化"},{"key":"B","text":"化学变化"},{"key":"C","text":"只是位置移动"},{"key":"D","text":"没有变化"}],"answer":"B","explanation":"烟花燃烧时产生新物质，并伴随发光、变色。","verify":"\"化学变化\""},{"id":"cns_p260_q2","topicId":"cns_p260","difficulty":"basic","type":"choice","prompt":"有些化学变化会让物质呈现新的颜色。这种变色说明什么？","choices":[{"key":"A","text":"一定只是把物体搬了地方"},{"key":"B","text":"颜色变了就一定没有新物质"},{"key":"C","text":"可能生成了新物质"},{"key":"D","text":"变色只说明物体被剪短了"}],"answer":"C","explanation":"变色常常伴随化学变化，提示可能有新物质生成。","verify":"\"可能生成了新物质\""},{"id":"cns_p260_q3","topicId":"cns_p260","difficulty":"standard","type":"choice","prompt":"下面哪一种更适合称为美丽的化学变化？","choices":[{"key":"A","text":"把纸撕成碎片"},{"key":"B","text":"冰融化成水"},{"key":"C","text":"把石块搬到别处"},{"key":"D","text":"烟花在夜空中绽放成彩色"}],"answer":"D","explanation":"烟花燃放既产生新物质，又有美丽的光和颜色。","verify":"\"烟花在夜空中绽放成彩色\""},{"id":"cns_p260_q4","topicId":"cns_p260","difficulty":"challenge","type":"choice","prompt":"化学变化看起来可以怎样？","choices":[{"key":"A","text":"也可以很美丽，例如发光、变色"},{"key":"B","text":"只能造成破坏"},{"key":"C","text":"一定没有颜色变化"},{"key":"D","text":"一定不能发光"}],"answer":"A","explanation":"发光、变色等现象可以让化学变化显得美丽。","verify":"\"也可以很美丽，例如发光、变色\""}]
