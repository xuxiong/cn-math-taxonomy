[{"id":"cnm_h021_q1","topicId":"cnm_h021","difficulty":"basic","type":"numeric","prompt":"4 和 9 的算术平均数是多少？","answer":"13/2","explanation":"算术平均数是 (4+9)/2=13/2。","verify":"(4+9)/2"},{"id":"cnm_h021_q2","topicId":"cnm_h021","difficulty":"basic","type":"numeric","prompt":"4 和 9 的几何平均数是多少？","answer":"6","explanation":"几何平均数是 √(4×9)=√36=6。","verify":"isqrt(4*9)"},{"id":"cnm_h021_q3","topicId":"cnm_h021","difficulty":"standard","type":"choice","prompt":"基本不等式 (a+b)/2 ≥ √(ab) 等号成立的条件是？","choices":[{"key":"A","text":"a=b 且 a、b 为正数"},{"key":"B","text":"a、b 只要为正"},{"key":"C","text":"a+b=1"},{"key":"D","text":"ab=1"}],"answer":"A","explanation":"两个正数相等时，算术平均数和几何平均数相等。","verify":"\"a=b 且 a、b 为正数\""},{"id":"cnm_h021_q4","topicId":"cnm_h021","difficulty":"standard","type":"numeric","prompt":"正数 1 和 1 的算术平均数减去几何平均数，结果是多少？","answer":"0","explanation":"两者都是 1，差为 0，等号成立。","verify":"(1+1)/2-isqrt(1*1)"},{"id":"cnm_h022_q1","topicId":"cnm_h022","difficulty":"basic","type":"numeric","prompt":"正数 x、y 满足 x+y=10。xy 的最大值是多少？","answer":"25","explanation":"当 x=y=5 时积最大，最大值是 5×5=25。","verify":"(10/2)**2"},{"id":"cnm_h022_q2","topicId":"cnm_h022","difficulty":"basic","type":"numeric","prompt":"正数 x、y 满足 xy=16。x+y 的最小值是多少？","answer":"8","explanation":"x+y ≥ 2√(xy)=8，等号在 x=y=4 时取到。","verify":"2*isqrt(16)"},{"id":"cnm_h022_q3","topicId":"cnm_h022","difficulty":"standard","type":"numeric","prompt":"正数 x 满足 x+4/x 能取最小值。最小值是多少？","answer":"4","explanation":"x 与 4/x 的积是 4，和的最小值是 2√4=4，在 x=2 时取到。","verify":"2*isqrt(4)"},{"id":"cnm_h022_q4","topicId":"cnm_h022","difficulty":"standard","type":"choice","prompt":"用基本不等式求最值时，如果等号条件达不到，应该？","choices":[{"key":"A","text":"仍然写成最值"},{"key":"B","text":"把不等号改成等号"},{"key":"C","text":"不能把该值当作最值"},{"key":"D","text":"改用负数再求"}],"answer":"C","explanation":"等号取不到时，这个界不是最小值或最大值。","verify":"\"不能把该值当作最值\""}]
