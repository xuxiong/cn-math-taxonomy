[{"id":"cnc_p119_q1","topicId":"cnc_p119","difficulty":"basic","type":"choice","prompt":"「碧玉妆成一树高」的下一句是哪一句？","choices":[{"key":"A","text":"万条垂下绿丝绦"},{"key":"B","text":"不知细叶谁裁出"},{"key":"C","text":"二月春风似剪刀"},{"key":"D","text":"万条垂下绿丝条"}],"answer":"A","explanation":"柳条像绿丝绦垂下来。绦是丝带，不能写成「条」。","verify":"\"万条垂下绿丝绦\""},{"id":"cnc_p119_q2","topicId":"cnc_p119","difficulty":"basic","type":"choice","prompt":"「不知细叶谁裁出」的下一句是哪一句？","choices":[{"key":"A","text":"万条垂下绿丝绦"},{"key":"B","text":"二月春风似剪刀"},{"key":"C","text":"碧玉妆成一树高"},{"key":"D","text":"春风又绿江南岸"}],"answer":"B","explanation":"细叶像被剪刀裁出来，诗人说那剪刀就是二月的春风。","verify":"\"二月春风似剪刀\""},{"id":"cnc_p119_q3","topicId":"cnc_p119","difficulty":"standard","type":"choice","prompt":"《咏柳》的作者是谁？","choices":[{"key":"A","text":"李白"},{"key":"B","text":"杜甫"},{"key":"C","text":"贺知章"},{"key":"D","text":"高鼎"}],"answer":"C","explanation":"《咏柳》是贺知章的诗。《村居》才是高鼎写的。","verify":"\"贺知章\""},{"id":"cnc_p119_q4","topicId":"cnc_p119","difficulty":"standard","type":"choice","prompt":"「二月春风似剪刀」把春风比作什么？","choices":[{"key":"A","text":"碧玉"},{"key":"B","text":"丝带"},{"key":"C","text":"细叶"},{"key":"D","text":"剪刀"}],"answer":"D","explanation":"春风像剪刀，裁出了细细的柳叶。碧玉是用来写整棵柳树的。","verify":"\"剪刀\""},{"id":"cnc_p120_q1","topicId":"cnc_p120","difficulty":"basic","type":"choice","prompt":"「草长莺飞二月天」的下一句是哪一句？","choices":[{"key":"A","text":"儿童散学归来早"},{"key":"B","text":"拂堤杨柳醉春烟"},{"key":"C","text":"忙趁东风放纸鸢"},{"key":"D","text":"二月春风似剪刀"}],"answer":"B","explanation":"先写杨柳在春烟里拂着堤岸，后面才写儿童放风筝。","verify":"\"拂堤杨柳醉春烟\""},{"id":"cnc_p120_q2","topicId":"cnc_p120","difficulty":"basic","type":"choice","prompt":"「儿童散学归来早」的下一句是哪一句？","choices":[{"key":"A","text":"拂堤杨柳醉春烟"},{"key":"B","text":"忙趁东风放纸鹞"},{"key":"C","text":"忙趁东风放纸鸢"},{"key":"D","text":"草长莺飞二月天"}],"answer":"C","explanation":"孩子们放学早，趁着东风放纸鸢。纸鸢就是风筝，不是纸鹞。","verify":"\"忙趁东风放纸鸢\""},{"id":"cnc_p120_q3","topicId":"cnc_p120","difficulty":"standard","type":"choice","prompt":"《村居》的作者是谁？","choices":[{"key":"A","text":"贺知章"},{"key":"B","text":"李白"},{"key":"C","text":"白居易"},{"key":"D","text":"高鼎"}],"answer":"D","explanation":"《村居》是高鼎的诗。《咏柳》才是贺知章的。","verify":"\"高鼎\""},{"id":"cnc_p120_q4","topicId":"cnc_p120","difficulty":"standard","type":"choice","prompt":"儿童放学以后忙着做什么？","choices":[{"key":"A","text":"放风筝"},{"key":"B","text":"裁柳叶"},{"key":"C","text":"采白莲"},{"key":"D","text":"登楼看黄河"}],"answer":"A","explanation":"忙趁东风放纸鸢。裁柳叶是《咏柳》里的想象。","verify":"\"放风筝\""},{"id":"cnc_p121_q1","topicId":"cnc_p121","difficulty":"basic","type":"choice","prompt":"小朋友到哪里去找春天？","choices":[{"key":"A","text":"到雪地里堆雪人"},{"key":"B","text":"待在被窝里不出来"},{"key":"C","text":"脱掉棉袄，奔向田野"},{"key":"D","text":"到夏天的荷塘"}],"answer":"C","explanation":"他们脱掉棉袄，冲出家门，奔向田野寻找春天。","verify":"\"脱掉棉袄，奔向田野\""},{"id":"cnc_p121_q2","topicId":"cnc_p121","difficulty":"basic","type":"choice","prompt":"小草从地下探出头，课文把它当成什么？","choices":[{"key":"A","text":"春天的眼睛"},{"key":"B","text":"春天的音符"},{"key":"C","text":"春天的琴声"},{"key":"D","text":"春天的眉毛"}],"answer":"D","explanation":"小草是眉毛。野花是眼睛，嫩芽是音符，解冻的小溪是琴声。","verify":"\"春天的眉毛\""},{"id":"cnc_p121_q3","topicId":"cnc_p121","difficulty":"standard","type":"choice","prompt":"哪一组都是课文里春天的迹象？","choices":[{"key":"A","text":"小草、野花、嫩芽、小溪"},{"key":"B","text":"霜、雪、冰、北风"},{"key":"C","text":"荷花、知了、绿太阳"},{"key":"D","text":"落叶、大雁、黄叶"}],"answer":"A","explanation":"小草探头，野花开放，树木吐出嫩芽，小溪叮咚作响。","verify":"\"小草、野花、嫩芽、小溪\""},{"id":"cnc_p121_q4","topicId":"cnc_p121","difficulty":"standard","type":"choice","prompt":"「春天像个害羞的小姑娘」是在说春天怎样？","choices":[{"key":"A","text":"春天已经走了"},{"key":"B","text":"遮遮掩掩，要人仔细找"},{"key":"C","text":"春天很大声"},{"key":"D","text":"春天只在夜里出现"}],"answer":"B","explanation":"春天躲躲藏藏，所以要仔细找她。","verify":"\"遮遮掩掩，要人仔细找\""},{"id":"cnc_p122_q1","topicId":"cnc_p122","difficulty":"basic","type":"choice","prompt":"包裹是谁寄给鼹鼠先生的？","choices":[{"key":"A","text":"松鼠太太"},{"key":"B","text":"刺猬太太"},{"key":"C","text":"狐狸太太"},{"key":"D","text":"长颈鹿大叔"}],"answer":"D","explanation":"长颈鹿大叔寄来包裹。松鼠太太、刺猬太太和狐狸太太是后来看见花的人。","verify":"\"长颈鹿大叔\""},{"id":"cnc_p122_q2","topicId":"cnc_p122","difficulty":"basic","type":"choice","prompt":"包裹拿到松鼠太太家时，为什么是空的？","choices":[{"key":"A","text":"包裹破了，东西漏在来时的路上"},{"key":"B","text":"松鼠太太把东西吃掉了"},{"key":"C","text":"邮局没有这个包裹"},{"key":"D","text":"里面本来就是一张空白纸"}],"answer":"A","explanation":"鼹鼠先生很懊丧，因为花籽都漏在路上了。","verify":"\"包裹破了，东西漏在来时的路上\""},{"id":"cnc_p122_q3","topicId":"cnc_p122","difficulty":"standard","type":"choice","prompt":"第二年春天，通往松鼠太太家的路为什么开满鲜花？","choices":[{"key":"A","text":"刺猬太太连夜种上的"},{"key":"B","text":"漏掉的是花籽，春天发芽开花了"},{"key":"C","text":"狐狸太太从城里买来的"},{"key":"D","text":"雪花落在路上变成了花"}],"answer":"B","explanation":"松鼠太太说：去年长颈鹿大叔寄来的是花籽。","verify":"\"漏掉的是花籽，春天发芽开花了\""},{"id":"cnc_p122_q4","topicId":"cnc_p122","difficulty":"standard","type":"choice","prompt":"松鼠太太把这些花籽称作什么？","choices":[{"key":"A","text":"一件没用的废物"},{"key":"B","text":"一封催债的信"},{"key":"C","text":"美好的礼物"},{"key":"D","text":"一把剪柳枝的剪刀"}],"answer":"C","explanation":"花开在大家门前，她说这是多么美好的礼物。","verify":"\"美好的礼物\""},{"id":"cnc_p123_q1","topicId":"cnc_p123","difficulty":"basic","type":"choice","prompt":"课文写的植树是哪一天？","choices":[{"key":"A","text":"1987 年 4 月 5 日"},{"key":"B","text":"1985 年 1 月 1 日"},{"key":"C","text":"1978 年 10 月 1 日"},{"key":"D","text":"2000 年 6 月 1 日"}],"answer":"A","explanation":"课文开头就写：1987 年 4 月 5 日，是个令人难忘的日子。","verify":"\"1987 年 4 月 5 日\""},{"id":"cnc_p123_q2","topicId":"cnc_p123","difficulty":"basic","type":"choice","prompt":"邓小平爷爷是在哪里植树？","choices":[{"key":"A","text":"井冈山"},{"key":"B","text":"北京天坛公园"},{"key":"C","text":"沙洲坝"},{"key":"D","text":"西湖边"}],"answer":"B","explanation":"这一天，他在北京天坛公园和大家一起植树。","verify":"\"北京天坛公园\""},{"id":"cnc_p123_q3","topicId":"cnc_p123","difficulty":"standard","type":"choice","prompt":"他精心地挑选并栽下的是什么？","choices":[{"key":"A","text":"一根柳条"},{"key":"B","text":"一棵被风刮倒的老树"},{"key":"C","text":"一棵茁壮的柏树苗"},{"key":"D","text":"一盆已经开花的牡丹"}],"answer":"C","explanation":"他挑选柏树苗，移入树坑，再挥锹填土。","verify":"\"一棵茁壮的柏树苗\""},{"id":"cnc_p123_q4","topicId":"cnc_p123","difficulty":"standard","type":"choice","prompt":"树苗看起来不直，他怎样做？","choices":[{"key":"A","text":"说一声不行就离开了"},{"key":"B","text":"把树苗拔出来扔掉"},{"key":"C","text":"叫别人随便填上土就行"},{"key":"D","text":"走上前把树苗扶正"}],"answer":"D","explanation":"他站到几步之外看了看，连声说不行，又把树苗扶正。","verify":"\"走上前把树苗扶正\""},{"id":"cnc_p124_q1","topicId":"cnc_p124","difficulty":"basic","type":"choice","prompt":"请别人帮忙时，语气怎样更合适？","choices":[{"key":"A","text":"用命令的口气催别人快点"},{"key":"B","text":"用商量的口气，把话说清楚"},{"key":"C","text":"背过身去不说话"},{"key":"D","text":"故意把声音压得谁也听不见"}],"answer":"B","explanation":"园地里的口语交际是注意说话的语气。请求别人，要用商量的口气。","verify":"\"用商量的口气，把话说清楚\""},{"id":"cnc_p124_q2","topicId":"cnc_p124","difficulty":"basic","type":"choice","prompt":"请求、道歉和提醒，说话时要注意什么？","choices":[{"key":"A","text":"语气永远只能有一种"},{"key":"B","text":"换了语气意思就一定相反"},{"key":"C","text":"语气不一样，要让对方听着明白"},{"key":"D","text":"语气只在唱歌时才有用"}],"answer":"C","explanation":"表扬、请求、道歉，说出来的轻重和态度不同，对方的感受也不同。","verify":"\"语气不一样，要让对方听着明白\""},{"id":"cnc_p124_q3","topicId":"cnc_p124","difficulty":"standard","type":"choice","prompt":"「离离原上草」的下一句是哪一句？","choices":[{"key":"A","text":"春风吹又生"},{"key":"B","text":"野火烧不尽"},{"key":"C","text":"二月春风似剪刀"},{"key":"D","text":"一岁一枯荣"}],"answer":"D","explanation":"原上的草每年都会枯一次、再荣一次。春风吹又生在更后面。","verify":"\"一岁一枯荣\""},{"id":"cnc_p124_q4","topicId":"cnc_p124","difficulty":"standard","type":"choice","prompt":"「野火烧不尽」的下一句是哪一句？作者是谁？","choices":[{"key":"A","text":"春风吹又生。作者是白居易"},{"key":"B","text":"春风吹又生。作者是贺知章"},{"key":"C","text":"一岁一枯荣。作者是高鼎"},{"key":"D","text":"忙趁东风放纸鸢。作者是白居易"}],"answer":"A","explanation":"野火烧不尽，春风吹又生。这首是白居易的《赋得古原草送别》，不是《咏柳》。","verify":"\"春风吹又生。作者是白居易\""}]
