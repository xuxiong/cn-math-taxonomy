[{"id":"cns_p169_q1","topicId":"cns_p169","difficulty":"basic","type":"choice","prompt":"人类最早使用的船之一是什么？","choices":[{"key":"A","text":"航空母舰"},{"key":"B","text":"核潜艇"},{"key":"C","text":"独木舟或竹筏"},{"key":"D","text":"游轮"}],"answer":"C","explanation":"早期人类用独木舟、竹筏渡水。","verify":"\"独木舟或竹筏\""},{"id":"cns_p169_q2","topicId":"cns_p169","difficulty":"basic","type":"choice","prompt":"船的发展从利用人力划桨，后来出现了利用什么的帆船？","choices":[{"key":"A","text":"电力"},{"key":"B","text":"核能"},{"key":"C","text":"太阳能电池"},{"key":"D","text":"风力"}],"answer":"D","explanation":"帆船利用风力航行。","verify":"\"风力\""},{"id":"cns_p169_q3","topicId":"cns_p169","difficulty":"standard","type":"choice","prompt":"现代大型轮船一般用什么材料建造？","choices":[{"key":"A","text":"钢铁"},{"key":"B","text":"木头"},{"key":"C","text":"竹子"},{"key":"D","text":"纸"}],"answer":"A","explanation":"钢铁坚固，适合造大船。","verify":"\"钢铁\""},{"id":"cns_p169_q4","topicId":"cns_p169","difficulty":"challenge","type":"choice","prompt":"独木舟变成多块木板拼成的木船，主要解决了什么问题？","choices":[{"key":"A","text":"让船沉得更快"},{"key":"B","text":"能造得更大，装更多东西"},{"key":"C","text":"让船更难划"},{"key":"D","text":"没有区别"}],"answer":"B","explanation":"木板拼接可以造出更大的船。","verify":"\"能造得更大，装更多东西\""},{"id":"cns_p170_q1","topicId":"cns_p170","difficulty":"basic","type":"choice","prompt":"下面哪种材料在水中会浮？","choices":[{"key":"A","text":"铁块"},{"key":"B","text":"石头"},{"key":"C","text":"铜球"},{"key":"D","text":"泡沫塑料"}],"answer":"D","explanation":"泡沫塑料比水轻。","verify":"\"泡沫塑料\""},{"id":"cns_p170_q2","topicId":"cns_p170","difficulty":"basic","type":"choice","prompt":"用竹筒做竹筏，竹筒越多，竹筏能载的东西会怎样？","choices":[{"key":"A","text":"越多"},{"key":"B","text":"越少"},{"key":"C","text":"不变"},{"key":"D","text":"立刻沉没"}],"answer":"A","explanation":"体积越大，浮力越大，载重越多。","verify":"\"越多\""},{"id":"cns_p170_q3","topicId":"cns_p170","difficulty":"standard","type":"choice","prompt":"把泡沫块放入水中，用手往下按，感觉到什么？","choices":[{"key":"A","text":"什么也没有"},{"key":"B","text":"有一个向上的力推手"},{"key":"C","text":"被往下拉"},{"key":"D","text":"泡沫变重"}],"answer":"B","explanation":"水对浸入的物体有向上的浮力。","verify":"\"有一个向上的力推手\""},{"id":"cns_p170_q4","topicId":"cns_p170","difficulty":"challenge","type":"choice","prompt":"竹筏总是向一边倾斜，可以怎样改进？","choices":[{"key":"A","text":"把竹筒全部拆掉"},{"key":"B","text":"只在倾斜的一侧放货物"},{"key":"C","text":"让货物均匀分布或在轻的一侧加竹筒"},{"key":"D","text":"在竹筏上开洞"}],"answer":"C","explanation":"受力平衡，竹筏才平稳。","verify":"\"让货物均匀分布或在轻的一侧加竹筒\""},{"id":"cns_p171_q1","topicId":"cns_p171","difficulty":"basic","type":"choice","prompt":"一块橡皮泥放进水中会沉，把它捏成什么形状就能浮起来？","choices":[{"key":"A","text":"空心的小船形"},{"key":"B","text":"实心的球"},{"key":"C","text":"一根细条"},{"key":"D","text":"一块实心的方块"}],"answer":"A","explanation":"空心船形排开更多的水，浮力增大。","verify":"\"空心的小船形\""},{"id":"cns_p171_q2","topicId":"cns_p171","difficulty":"basic","type":"choice","prompt":"钢铁很重，为什么钢铁做的轮船能浮在水面？","choices":[{"key":"A","text":"钢铁比水轻"},{"key":"B","text":"船是空心的，排开的水很多"},{"key":"C","text":"船上有魔法"},{"key":"D","text":"钢铁遇水会变轻"}],"answer":"B","explanation":"空心结构让船排开足够多的水。","verify":"\"船是空心的，排开的水很多\""},{"id":"cns_p171_q3","topicId":"cns_p171","difficulty":"standard","type":"choice","prompt":"同样多的橡皮泥，做成哪种船载重量更大？","choices":[{"key":"A","text":"底面很小的船"},{"key":"B","text":"实心球形"},{"key":"C","text":"底面更大、船舷适当高的船"},{"key":"D","text":"细长的条形实心块"}],"answer":"C","explanation":"船的体积越大，能排开的水越多。","verify":"\"底面更大、船舷适当高的船\""},{"id":"cns_p171_q4","topicId":"cns_p171","difficulty":"challenge","type":"choice","prompt":"船身破了一个洞会进水下沉，现代船常用什么设计防止整船沉没？","choices":[{"key":"A","text":"把船涂成红色"},{"key":"B","text":"去掉所有船舱"},{"key":"C","text":"让船更重"},{"key":"D","text":"分隔成多个密封舱（水密隔舱）"}],"answer":"D","explanation":"水密隔舱让一个舱进水不至于整船沉没。","verify":"\"分隔成多个密封舱（水密隔舱）\""},{"id":"cns_p172_q1","topicId":"cns_p172","difficulty":"basic","type":"choice","prompt":"船的载重量与什么关系最大？","choices":[{"key":"A","text":"船的颜色"},{"key":"B","text":"船排开水的体积"},{"key":"C","text":"船的名字"},{"key":"D","text":"船员的人数"}],"answer":"B","explanation":"排开的水越多，浮力越大。","verify":"\"船排开水的体积\""},{"id":"cns_p172_q2","topicId":"cns_p172","difficulty":"basic","type":"choice","prompt":"往小船里放垫圈，放到什么时候就是最大载重量？","choices":[{"key":"A","text":"放第一个时"},{"key":"B","text":"随便放多少"},{"key":"C","text":"再放一个就会进水下沉之前"},{"key":"D","text":"船倾斜一点时"}],"answer":"C","explanation":"船即将沉没前的承载量是最大载重量。","verify":"\"再放一个就会进水下沉之前\""},{"id":"cns_p172_q3","topicId":"cns_p172","difficulty":"standard","type":"choice","prompt":"放垫圈时，应该怎样放？","choices":[{"key":"A","text":"全部堆在一侧"},{"key":"B","text":"从高处扔进去"},{"key":"C","text":"只放在船头"},{"key":"D","text":"均匀分散地放"}],"answer":"D","explanation":"均匀放置船更稳定。","verify":"\"均匀分散地放\""},{"id":"cns_p172_q4","topicId":"cns_p172","difficulty":"challenge","type":"choice","prompt":"两只同样的铝箔船，一只船舷 2 厘米高，另一只 4 厘米高，哪只能装更多垫圈？","choices":[{"key":"A","text":"4 厘米高的"},{"key":"B","text":"2 厘米高的"},{"key":"C","text":"一样多"},{"key":"D","text":"都装不了"}],"answer":"A","explanation":"船舷高，船能下沉更深而不进水，排开的水更多。","verify":"\"4 厘米高的\""},{"id":"cns_p173_q1","topicId":"cns_p173","difficulty":"basic","type":"choice","prompt":"帆船靠什么向前行驶？","choices":[{"key":"A","text":"水对帆的推力"},{"key":"B","text":"船上的灯"},{"key":"C","text":"风对帆的推力"},{"key":"D","text":"船的颜色"}],"answer":"C","explanation":"风吹帆产生推力。","verify":"\"风对帆的推力\""},{"id":"cns_p173_q2","topicId":"cns_p173","difficulty":"basic","type":"choice","prompt":"用橡皮筋驱动船桨，橡皮筋拧得越紧，船会怎样？","choices":[{"key":"A","text":"行驶得越近"},{"key":"B","text":"停在原地"},{"key":"C","text":"向下沉"},{"key":"D","text":"行驶得越远"}],"answer":"D","explanation":"弹力越大，驱动越久。","verify":"\"行驶得越远\""},{"id":"cns_p173_q3","topicId":"cns_p173","difficulty":"standard","type":"choice","prompt":"想让帆船行驶得更快，可以怎样做？","choices":[{"key":"A","text":"适当增大帆的面积"},{"key":"B","text":"把帆剪小"},{"key":"C","text":"去掉帆"},{"key":"D","text":"让风从侧面完全挡住"}],"answer":"A","explanation":"帆面积大，受到的风力大。","verify":"\"适当增大帆的面积\""},{"id":"cns_p173_q4","topicId":"cns_p173","difficulty":"challenge","type":"choice","prompt":"小船装上动力后总在水面打转，可能是什么原因？","choices":[{"key":"A","text":"船太轻"},{"key":"B","text":"动力装置装偏了，推力不在船的中线上"},{"key":"C","text":"水太清"},{"key":"D","text":"帆太漂亮"}],"answer":"B","explanation":"推力偏向一侧，船会转圈。","verify":"\"动力装置装偏了，推力不在船的中线上\""},{"id":"cns_p174_q1","topicId":"cns_p174","difficulty":"basic","type":"choice","prompt":"设计小船之前，最先要明确什么？","choices":[{"key":"A","text":"船涂什么颜色"},{"key":"B","text":"船叫什么名字"},{"key":"C","text":"比赛谁先完成"},{"key":"D","text":"小船要达到的要求（载重、速度、稳定等）"}],"answer":"D","explanation":"工程设计先明确任务要求。","verify":"\"小船要达到的要求（载重、速度、稳定等）\""},{"id":"cns_p174_q2","topicId":"cns_p174","difficulty":"basic","type":"choice","prompt":"测试小船时，为什么要在同样的水槽、同样的条件下测？","choices":[{"key":"A","text":"这样结果才能比较"},{"key":"B","text":"为了省水"},{"key":"C","text":"因为只有一个水槽"},{"key":"D","text":"没有原因"}],"answer":"A","explanation":"条件相同，测试结果才可比。","verify":"\"这样结果才能比较\""},{"id":"cns_p174_q3","topicId":"cns_p174","difficulty":"standard","type":"choice","prompt":"测试发现小船容易翻，下面哪种改进最合理？","choices":[{"key":"A","text":"把重物放高处"},{"key":"B","text":"降低重心，加宽船底"},{"key":"C","text":"把船做得更窄更高"},{"key":"D","text":"去掉船底"}],"answer":"B","explanation":"重心低、底面宽，船更稳。","verify":"\"降低重心，加宽船底\""},{"id":"cns_p174_q4","topicId":"cns_p174","difficulty":"challenge","type":"choice","prompt":"下面哪一项是工程设计正确的过程？","choices":[{"key":"A","text":"制作→设计→问题→测试"},{"key":"B","text":"测试→制作→改进→设计"},{"key":"C","text":"明确问题→设计→制作→测试→改进"},{"key":"D","text":"设计→比赛→结束"}],"answer":"C","explanation":"工程设计是一个不断改进的循环。","verify":"\"明确问题→设计→制作→测试→改进\""}]
