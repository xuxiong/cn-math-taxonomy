[{"id":"cnh_j083_q1","topicId":"cnh_j083","difficulty":"basic","type":"choice","prompt":"中共十八大召开于？","choices":[{"key":"A","text":"2012年"},{"key":"B","text":"2007年"},{"key":"C","text":"2017年"},{"key":"D","text":"2022年"}],"answer":"A","explanation":"十八大在北京召开。","verify":"\"2012年\""},{"id":"cnh_j083_q2","topicId":"cnh_j083","difficulty":"basic","type":"choice","prompt":"2012年提出中国梦的是？","choices":[{"key":"A","text":"邓小平"},{"key":"B","text":"习近平"},{"key":"C","text":"江泽民"},{"key":"D","text":"胡锦涛"}],"answer":"B","explanation":"中国梦的基本内涵是实现国家富强、民族振兴、人民幸福。","verify":"\"习近平\""},{"id":"cnh_j083_q3","topicId":"cnh_j083","difficulty":"standard","type":"choice","prompt":"两个一百年奋斗目标中，第一个一百年对应？","choices":[{"key":"A","text":"新中国成立100年时建成社会主义现代化强国"},{"key":"B","text":"清朝灭亡100年"},{"key":"C","text":"中国共产党成立100年时全面建成小康社会"},{"key":"D","text":"鸦片战争100年"}],"answer":"C","explanation":"第二个一百年是到本世纪中叶建成社会主义现代化强国。","verify":"\"中国共产党成立100年时全面建成小康社会\""},{"id":"cnh_j083_q4","topicId":"cnh_j083","difficulty":"challenge","type":"choice","prompt":"十八大以后，党中央强调的主题是？","choices":[{"key":"A","text":"回到计划经济"},{"key":"B","text":"取消改革开放"},{"key":"C","text":"恢复人民公社"},{"key":"D","text":"坚持和发展中国特色社会主义"}],"answer":"D","explanation":"坚持和发展中国特色社会主义是改革开放新时期的主线，也是十八大后的主题。","verify":"\"坚持和发展中国特色社会主义\""},{"id":"cnh_j084_q1","topicId":"cnh_j084","difficulty":"basic","type":"choice","prompt":"中共十九大召开于？","choices":[{"key":"A","text":"2012年"},{"key":"B","text":"2017年"},{"key":"C","text":"2002年"},{"key":"D","text":"2022年"}],"answer":"B","explanation":"十九大把习近平新时代中国特色社会主义思想确立为党的指导思想。","verify":"\"2017年\""},{"id":"cnh_j084_q2","topicId":"cnh_j084","difficulty":"basic","type":"choice","prompt":"精准扶贫针对的是？","choices":[{"key":"A","text":"全体城市居民的工资"},{"key":"B","text":"海外留学生"},{"key":"C","text":"建档立卡的贫困人口"},{"key":"D","text":"上市公司"}],"answer":"C","explanation":"精准扶贫要求扶持对象、项目、资金、措施、派人和成效都精准。","verify":"\"建档立卡的贫困人口\""},{"id":"cnh_j084_q3","topicId":"cnh_j084","difficulty":"standard","type":"choice","prompt":"我国宣告脱贫攻坚战取得全面胜利是在？","choices":[{"key":"A","text":"2012年"},{"key":"B","text":"2000年"},{"key":"C","text":"1978年"},{"key":"D","text":"2021年"}],"answer":"D","explanation":"现行标准下农村贫困人口全部脱贫，区域性整体贫困得到解决。","verify":"\"2021年\""},{"id":"cnh_j084_q4","topicId":"cnh_j084","difficulty":"challenge","type":"choice","prompt":"脱贫攻坚和全面建成小康社会的关系是？","choices":[{"key":"A","text":"脱贫攻坚是全面建成小康社会的底线任务"},{"key":"B","text":"两者没有关系"},{"key":"C","text":"脱贫攻坚发生在1956年"},{"key":"D","text":"小康社会只统计城市"}],"answer":"A","explanation":"没有农村贫困人口脱贫，就谈不上全面小康。","verify":"\"脱贫攻坚是全面建成小康社会的底线任务\""},{"id":"cnh_j085_q1","topicId":"cnh_j085","difficulty":"basic","type":"choice","prompt":"2005年全国人民代表大会通过的相关法律是？","choices":[{"key":"A","text":"《香港特别行政区基本法》"},{"key":"B","text":"《澳门特别行政区基本法》"},{"key":"C","text":"《反分裂国家法》"},{"key":"D","text":"《土地改革法》"}],"answer":"C","explanation":"《反分裂国家法》把反对和遏制分裂国家的立场写成法律。香港基本法通过于1990年。","verify":"\"《反分裂国家法》\""},{"id":"cnh_j085_q2","topicId":"cnh_j085","difficulty":"basic","type":"choice","prompt":"1992年海协会与海基会达成的共识被称为？","choices":[{"key":"A","text":"一国两制首次提出"},{"key":"B","text":"和平共处五项原则"},{"key":"C","text":"万隆精神"},{"key":"D","text":"九二共识"}],"answer":"D","explanation":"九二共识的核心是坚持一个中国原则。","verify":"\"九二共识\""},{"id":"cnh_j085_q3","topicId":"cnh_j085","difficulty":"standard","type":"choice","prompt":"总体国家安全观强调？","choices":[{"key":"A","text":"以人民安全为宗旨"},{"key":"B","text":"只顾某一种安全"},{"key":"C","text":"放弃主权"},{"key":"D","text":"把安全交给外国"}],"answer":"A","explanation":"总体国家安全观是新时代维护国家安全的指导思想。","verify":"\"以人民安全为宗旨\""},{"id":"cnh_j085_q4","topicId":"cnh_j085","difficulty":"challenge","type":"choice","prompt":"推进祖国统一的基本方针仍然是？","choices":[{"key":"A","text":"一国一制"},{"key":"B","text":"一国两制"},{"key":"C","text":"武力是唯一办法"},{"key":"D","text":"托管"}],"answer":"B","explanation":"一国两制是实现祖国统一的基本方针。","verify":"\"一国两制\""},{"id":"cnh_j086_q1","topicId":"cnh_j086","difficulty":"basic","type":"choice","prompt":"2013年提出的国际合作设想是？","choices":[{"key":"A","text":"马歇尔计划"},{"key":"B","text":"门户开放"},{"key":"C","text":"大东亚共荣圈"},{"key":"D","text":"丝绸之路经济带和21世纪海上丝绸之路"}],"answer":"D","explanation":"两者合称一带一路。","verify":"\"丝绸之路经济带和21世纪海上丝绸之路\""},{"id":"cnh_j086_q2","topicId":"cnh_j086","difficulty":"basic","type":"choice","prompt":"人类命运共同体强调各国应当？","choices":[{"key":"A","text":"相互尊重、合作共赢"},{"key":"B","text":"划分势力范围"},{"key":"C","text":"零和对抗"},{"key":"D","text":"殖民扩张"}],"answer":"A","explanation":"这一理念主张建设持久和平、普遍安全、共同繁荣的世界。","verify":"\"相互尊重、合作共赢\""},{"id":"cnh_j086_q3","topicId":"cnh_j086","difficulty":"standard","type":"choice","prompt":"中国倡议成立的多边金融机构是？","choices":[{"key":"A","text":"国际货币基金组织是1945年成立的"},{"key":"B","text":"亚洲基础设施投资银行"},{"key":"C","text":"世界银行"},{"key":"D","text":"世界贸易组织"}],"answer":"B","explanation":"亚投行总部设在北京，为亚洲基础设施建设提供资金。","verify":"\"亚洲基础设施投资银行\""},{"id":"cnh_j086_q4","topicId":"cnh_j086","difficulty":"challenge","type":"choice","prompt":"中国特色大国外交的一项实践是？","choices":[{"key":"A","text":"加入八国联军"},{"key":"B","text":"签订《南京条约》"},{"key":"C","text":"举办一带一路国际合作高峰论坛"},{"key":"D","text":"退出联合国"}],"answer":"C","explanation":"高峰论坛推动政策沟通和设施联通等合作。","verify":"\"举办一带一路国际合作高峰论坛\""}]
