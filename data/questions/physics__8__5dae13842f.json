[{"id":"cnp_003_q1","topicId":"cnp_003","difficulty":"basic","type":"choice","prompt":"一辆汽车 2 h 行驶了 144 km，它的平均速度是多少？","choices":[{"key":"A","text":"288 km/h"},{"key":"B","text":"72 km/h"},{"key":"C","text":"20 km/h"},{"key":"D","text":"146 km/h"}],"answer":"B","explanation":"v = s/t = 144 km ÷ 2 h = 72 km/h。","verify":"144/2"},{"id":"cnp_003_q2","topicId":"cnp_003","difficulty":"basic","type":"choice","prompt":"72 km/h 等于多少 m/s？","choices":[{"key":"A","text":"259.2 m/s"},{"key":"B","text":"72 m/s"},{"key":"C","text":"2 m/s"},{"key":"D","text":"20 m/s"}],"answer":"D","explanation":"1 m/s = 3.6 km/h，所以 72 ÷ 3.6 = 20 m/s。把 72 乘以 3.6 是常见错误。","verify":"72/3.6"},{"id":"cnp_003_q3","topicId":"cnp_003","difficulty":"standard","type":"numeric","prompt":"声音在空气中以 340 m/s 传播，听到雷声比看到闪电晚 3 s，打雷处离人约多少 m？（只填数值）","answer":"1020","explanation":"光速很大，光传播的时间可以忽略。s = vt = 340 m/s × 3 s = 1020 m。","verify":"340*3"},{"id":"cnp_003_q4","topicId":"cnp_003","difficulty":"advanced","type":"choice","prompt":"小华前一半路程的速度是 4 m/s，后一半路程的速度是 6 m/s，全程平均速度是多少？","choices":[{"key":"A","text":"5 m/s"},{"key":"B","text":"10 m/s"},{"key":"C","text":"4.8 m/s"},{"key":"D","text":"2.4 m/s"}],"answer":"C","explanation":"设一半路程为 s，总时间 t = s/4 + s/6 = 5s/12，平均速度 = 2s ÷ (5s/12) = 4.8 m/s。直接求速度的平均值 5 m/s 是错的。","verify":"2/(1/4+1/6)"}]
