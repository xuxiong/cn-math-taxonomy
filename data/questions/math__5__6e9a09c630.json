[{"difficulty":"basic","type":"choice","prompt":"小数除以整数，商的小数点要怎样？","choices":[{"key":"A","text":"和被除数的小数点对齐"},{"key":"B","text":"一定写在最左边"},{"key":"C","text":"可以不写小数点"}],"answer":"A","explanation":"除的时候，商的小数点要和被除数的小数点对齐。","verify":"'和被除数的小数点对齐'","id":"cnm_p137_q1","topicId":"cnm_p137"},{"difficulty":"basic","type":"numeric","prompt":"0.8 米的绳子平均剪成 2 段。每段多少米？（用小数作答）","answer":"0.4","explanation":"0.8÷2＝0.4（米）。","verify":"Fraction(8,10)/2","id":"cnm_p137_q2","topicId":"cnm_p137"},{"difficulty":"standard","type":"numeric","prompt":"3 条同样的绳子共长 4.5 米。每条多少米？（用小数作答）","answer":"1.5","explanation":"4.5÷3＝1.5（米）。","verify":"Fraction(45,10)/3","id":"cnm_p137_q3","topicId":"cnm_p137"},{"difficulty":"challenge","type":"numeric","prompt":"4 支同样的笔共 9.6 元，3 个同样的本子共 6.3 元。一支笔比一个本子贵多少元？（用小数作答）","answer":"0.3","explanation":"笔每支 9.6÷4＝2.4（元），本子每个 6.3÷3＝2.1（元），2.4－2.1＝0.3（元）。","verify":"Fraction(96,10)/4-Fraction(63,10)/3","id":"cnm_p137_q4","topicId":"cnm_p137"},{"difficulty":"basic","type":"choice","prompt":"除数是小数时，应先怎样做再除？","choices":[{"key":"A","text":"把除数变成整数"},{"key":"B","text":"只把被除数变成整数，除数不用管"},{"key":"C","text":"直接去掉所有小数点"}],"answer":"A","explanation":"除数是小数时，先把除数变成整数（被除数要扩大相同的倍数），再除。","verify":"'把除数变成整数'","id":"cnm_p138_q1","topicId":"cnm_p138"},{"difficulty":"basic","type":"numeric","prompt":"每段绳子长 0.2 米，0.8 米可以剪成几段？","answer":"4","explanation":"0.8÷0.2＝4（段）。","verify":"Fraction(8,10)/Fraction(2,10)","id":"cnm_p138_q2","topicId":"cnm_p138"},{"difficulty":"standard","type":"numeric","prompt":"每块橡皮 0.4 元，2.4 元可以买几块？","answer":"6","explanation":"2.4÷0.4＝6（块）。","verify":"Fraction(24,10)/Fraction(4,10)","id":"cnm_p138_q3","topicId":"cnm_p138"},{"difficulty":"challenge","type":"numeric","prompt":"一条 3.6 米的绳子，每 0.4 米做一根跳绳，已经做了 5 根。剩下的绳子还能做几根？","answer":"4","explanation":"一共可以做 3.6÷0.4＝9（根），还剩 9－5＝4（根）。","verify":"Fraction(36,10)/Fraction(4,10)-5","id":"cnm_p138_q4","topicId":"cnm_p138"},{"difficulty":"basic","type":"numeric","prompt":"7.2 升果汁平均分给 8 人。每人多少升？（用小数作答）","answer":"0.9","explanation":"7.2÷8＝0.9（升）。","verify":"Fraction(72,10)/8","id":"cnm_p139_q1","topicId":"cnm_p139"},{"difficulty":"basic","type":"numeric","prompt":"有 4.5 元，每本本子 0.5 元。可以买几本？","answer":"9","explanation":"4.5÷0.5＝9（本）。","verify":"Fraction(45,10)/Fraction(5,10)","id":"cnm_p139_q2","topicId":"cnm_p139"},{"difficulty":"standard","type":"numeric","prompt":"9.6 千米走了 3 小时。平均每小时多少千米？（用小数作答）","answer":"3.2","explanation":"9.6÷3＝3.2（千米）。","verify":"Fraction(96,10)/3","id":"cnm_p139_q3","topicId":"cnm_p139"},{"difficulty":"challenge","type":"numeric","prompt":"8.4 米彩带先剪下 1.2 米，剩下的平均做成 4 朵花。每朵用多少米？（用小数作答）","answer":"1.8","explanation":"剩下 8.4－1.2＝7.2（米），7.2÷4＝1.8（米）。","verify":"(Fraction(84,10)-Fraction(12,10))/4","id":"cnm_p139_q4","topicId":"cnm_p139"}]
