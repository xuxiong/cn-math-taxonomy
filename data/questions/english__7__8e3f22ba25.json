[{"id":"cne_j071_q1","topicId":"cne_j071","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「雨；下雨」？","choices":[{"key":"A","text":"rain"},{"key":"B","text":"windy"},{"key":"C","text":"cloudy"},{"key":"D","text":"sunny"}],"answer":"A","explanation":"rain 的意思是雨；下雨。","verify":"\"rain\""},{"id":"cne_j071_q2","topicId":"cne_j071","difficulty":"basic","type":"choice","prompt":"「windy」的中文意思是哪一个？","choices":[{"key":"A","text":"雨；下雨"},{"key":"B","text":"有风的"},{"key":"C","text":"多云的"},{"key":"D","text":"晴朗的"}],"answer":"B","explanation":"windy 的意思是有风的。","verify":"\"有风的\""},{"id":"cne_j071_q3","topicId":"cne_j071","difficulty":"standard","type":"choice","prompt":"选择表示「多云的」的单词。","choices":[{"key":"A","text":"rain"},{"key":"B","text":"windy"},{"key":"C","text":"cloudy"},{"key":"D","text":"sunny"}],"answer":"C","explanation":"表示多云的的单词是 cloudy。","verify":"\"cloudy\""},{"id":"cne_j071_q4","topicId":"cne_j071","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「晴朗的」？","choices":[{"key":"A","text":"rain"},{"key":"B","text":"windy"},{"key":"C","text":"cloudy"},{"key":"D","text":"sunny"}],"answer":"D","explanation":"sunny 的意思是晴朗的。","verify":"\"sunny\""},{"id":"cne_j073_q1","topicId":"cne_j073","difficulty":"basic","type":"choice","prompt":"想问北京的天气，哪一句合适？","choices":[{"key":"A","text":"What is the weather in Beijing?"},{"key":"B","text":"How is the weather in Beijing is?"},{"key":"C","text":"How is the weather in Beijing?"},{"key":"D","text":"What weather is it in Beijing does?"}],"answer":"C","explanation":"How is the weather in Beijing 是常见问法。","verify":"\"How is the weather in Beijing?\""},{"id":"cne_j073_q2","topicId":"cne_j073","difficulty":"basic","type":"choice","prompt":"北京正在下雨，应怎么说？","choices":[{"key":"A","text":"It is rain in Beijing."},{"key":"B","text":"It raining in Beijing."},{"key":"C","text":"Beijing is raining."},{"key":"D","text":"It is raining in Beijing."}],"answer":"D","explanation":"正在下雨用 It is raining。","verify":"\"It is raining in Beijing.\""},{"id":"cne_j073_q3","topicId":"cne_j073","difficulty":"standard","type":"choice","prompt":"对方说 It is sunny. 你觉得天气很好，哪一句合适？","choices":[{"key":"A","text":"What a fine day!"},{"key":"B","text":"What fine day!"},{"key":"C","text":"How a fine day!"},{"key":"D","text":"What a fine day it are!"}],"answer":"A","explanation":"What a fine day。","verify":"\"What a fine day!\""},{"id":"cne_j073_q4","topicId":"cne_j073","difficulty":"standard","type":"choice","prompt":"How is the weather? 也可以说成哪一句？","choices":[{"key":"A","text":"What's the weather is like?"},{"key":"B","text":"What's the weather like?"},{"key":"C","text":"How the weather is?"},{"key":"D","text":"What does the weather like?"}],"answer":"B","explanation":"What's the weather like 和 How is the weather 同义。","verify":"\"What's the weather like?\""},{"id":"cne_j074_q1","topicId":"cne_j074","difficulty":"basic","type":"choice","prompt":"It is sunny in Shanghai. It is raining in Beijing. It is windy in Guangzhou. 北京的天气怎样？","choices":[{"key":"A","text":"晴朗"},{"key":"B","text":"有风"},{"key":"C","text":"多云"},{"key":"D","text":"正在下雨"}],"answer":"D","explanation":"raining in Beijing。","verify":"\"正在下雨\""},{"id":"cne_j074_q2","topicId":"cne_j074","difficulty":"basic","type":"choice","prompt":"It is sunny in Shanghai. It is raining in Beijing. It is windy in Guangzhou. 哪里有风？","choices":[{"key":"A","text":"广州"},{"key":"B","text":"上海"},{"key":"C","text":"北京"},{"key":"D","text":"三地都有风"}],"answer":"A","explanation":"windy in Guangzhou。","verify":"\"广州\""},{"id":"cne_j074_q3","topicId":"cne_j074","difficulty":"standard","type":"choice","prompt":"What a cold day in Harbin! People are wearing sweaters. 哈尔滨的人穿着什么？","choices":[{"key":"A","text":"短裙"},{"key":"B","text":"毛衣"},{"key":"C","text":"校服"},{"key":"D","text":"短袜"}],"answer":"B","explanation":"wearing sweaters。","verify":"\"毛衣\""},{"id":"cne_j074_q4","topicId":"cne_j074","difficulty":"standard","type":"choice","prompt":"What a cold day in Harbin! People are wearing sweaters. 哪一句和短文一致？","choices":[{"key":"A","text":"It is hot in Harbin."},{"key":"B","text":"People are wearing skirts."},{"key":"C","text":"It is cold in Harbin."},{"key":"D","text":"It is raining in Harbin."}],"answer":"C","explanation":"a cold day 说明很冷。短文没有说下雨。","verify":"\"It is cold in Harbin.\""}]
