[{"id":"cns_p186_q1","topicId":"cns_p186","difficulty":"basic","type":"choice","prompt":"人的一生中，身高增长特别快的两个时期是？","choices":[{"key":"A","text":"老年期和中年期"},{"key":"B","text":"只有婴儿期"},{"key":"C","text":"只有成年期"},{"key":"D","text":"婴幼儿期和青春期"}],"answer":"D","explanation":"这两个时期生长最迅速。","verify":"\"婴幼儿期和青春期\""},{"id":"cns_p186_q2","topicId":"cns_p186","difficulty":"basic","type":"choice","prompt":"进入青春期，身体会出现什么变化？","choices":[{"key":"A","text":"身高体重迅速增加"},{"key":"B","text":"身高停止增长"},{"key":"C","text":"体重一直下降"},{"key":"D","text":"完全没有变化"}],"answer":"A","explanation":"青春期是生长发育的关键期。","verify":"\"身高体重迅速增加\""},{"id":"cns_p186_q3","topicId":"cns_p186","difficulty":"standard","type":"choice","prompt":"每个人进入青春期的时间是否一样？","choices":[{"key":"A","text":"完全一样"},{"key":"B","text":"不一样，有早有晚"},{"key":"C","text":"都在 10 岁整"},{"key":"D","text":"都在 18 岁"}],"answer":"B","explanation":"个体差异是正常的。","verify":"\"不一样，有早有晚\""},{"id":"cns_p186_q4","topicId":"cns_p186","difficulty":"challenge","type":"choice","prompt":"青春期出现烦恼时，比较好的做法是？","choices":[{"key":"A","text":"一直憋在心里"},{"key":"B","text":"沉迷游戏"},{"key":"C","text":"和父母、老师或信任的人交流"},{"key":"D","text":"不睡觉"}],"answer":"C","explanation":"积极沟通有助于健康成长。","verify":"\"和父母、老师或信任的人交流\""},{"id":"cns_p187_q1","topicId":"cns_p187","difficulty":"basic","type":"choice","prompt":"米饭、馒头主要提供哪种营养？","choices":[{"key":"A","text":"淀粉（糖类）"},{"key":"B","text":"蛋白质"},{"key":"C","text":"脂肪"},{"key":"D","text":"维生素 C"}],"answer":"A","explanation":"谷类食物富含淀粉，提供能量。","verify":"\"淀粉（糖类）\""},{"id":"cns_p187_q2","topicId":"cns_p187","difficulty":"basic","type":"choice","prompt":"鸡蛋、牛奶、瘦肉富含什么营养？","choices":[{"key":"A","text":"淀粉"},{"key":"B","text":"蛋白质"},{"key":"C","text":"纤维素"},{"key":"D","text":"水"}],"answer":"B","explanation":"蛋白质是构成身体的重要物质。","verify":"\"蛋白质\""},{"id":"cns_p187_q3","topicId":"cns_p187","difficulty":"standard","type":"choice","prompt":"用碘酒滴在馒头上，馒头变蓝，说明馒头含有什么？","choices":[{"key":"A","text":"蛋白质"},{"key":"B","text":"脂肪"},{"key":"C","text":"淀粉"},{"key":"D","text":"维生素"}],"answer":"C","explanation":"淀粉遇碘变蓝。","verify":"\"淀粉\""},{"id":"cns_p187_q4","topicId":"cns_p187","difficulty":"challenge","type":"choice","prompt":"食用油和肥肉主要提供哪种营养？","choices":[{"key":"A","text":"淀粉"},{"key":"B","text":"蛋白质"},{"key":"C","text":"维生素 C"},{"key":"D","text":"脂肪"}],"answer":"D","explanation":"油脂类食物富含脂肪，也能提供能量。","verify":"\"脂肪\""},{"id":"cns_p242_q1","topicId":"cns_p242","difficulty":"basic","type":"choice","prompt":"按「平衡膳食宝塔」，每天吃得最多的应该是哪类食物？","choices":[{"key":"A","text":"油和盐"},{"key":"B","text":"糖果"},{"key":"C","text":"肉类"},{"key":"D","text":"谷薯类"}],"answer":"D","explanation":"谷薯类在宝塔底层，需要量最大；油盐在最顶层，最少。","verify":"\"谷薯类\""},{"id":"cns_p242_q2","topicId":"cns_p242","difficulty":"basic","type":"choice","prompt":"营养要均衡是指怎样吃？","choices":[{"key":"A","text":"各类食物都适量吃"},{"key":"B","text":"只吃一种最爱的食物"},{"key":"C","text":"只吃零食"},{"key":"D","text":"完全不吃主食"}],"answer":"A","explanation":"不同食物提供的营养不同，要搭配着吃。","verify":"\"各类食物都适量吃\""},{"id":"cns_p242_q3","topicId":"cns_p242","difficulty":"standard","type":"choice","prompt":"只爱吃肉、很少吃蔬菜，这种做法怎么样？","choices":[{"key":"A","text":"很好，肉最有营养"},{"key":"B","text":"不好，容易营养不均衡"},{"key":"C","text":"无所谓"},{"key":"D","text":"只要吃饱就行"}],"answer":"B","explanation":"偏食会使某些营养素不足。","verify":"\"不好，容易营养不均衡\""},{"id":"cns_p242_q4","topicId":"cns_p242","difficulty":"challenge","type":"choice","prompt":"下面哪种吃法更符合营养均衡？","choices":[{"key":"A","text":"三餐只吃炸鸡"},{"key":"B","text":"只喝饮料"},{"key":"C","text":"米饭、青菜、鱼和水果都吃一些"},{"key":"D","text":"一天只吃糖果"}],"answer":"C","explanation":"多种食物搭配，营养更全面。","verify":"\"米饭、青菜、鱼和水果都吃一些\""},{"id":"cns_p188_q1","topicId":"cns_p188","difficulty":"basic","type":"choice","prompt":"人体的「总指挥」是哪个器官？","choices":[{"key":"A","text":"心脏"},{"key":"B","text":"脑"},{"key":"C","text":"胃"},{"key":"D","text":"肺"}],"answer":"B","explanation":"脑通过神经指挥全身。","verify":"\"脑\""},{"id":"cns_p188_q2","topicId":"cns_p188","difficulty":"basic","type":"choice","prompt":"手不小心碰到很烫的东西会立刻缩回，这是什么？","choices":[{"key":"A","text":"肌肉自己决定的"},{"key":"B","text":"皮肤变冷了"},{"key":"C","text":"神经的反射活动"},{"key":"D","text":"骨骼的作用"}],"answer":"C","explanation":"神经把信息传给脊髓和脑，迅速作出反应。","verify":"\"神经的反射活动\""},{"id":"cns_p188_q3","topicId":"cns_p188","difficulty":"standard","type":"choice","prompt":"把信息在脑和身体各部分之间传递的是什么？","choices":[{"key":"A","text":"血管"},{"key":"B","text":"骨骼"},{"key":"C","text":"头发"},{"key":"D","text":"神经"}],"answer":"D","explanation":"神经像电线一样传递信息。","verify":"\"神经\""},{"id":"cns_p188_q4","topicId":"cns_p188","difficulty":"challenge","type":"choice","prompt":"测量反应快慢的「接尺子」实验中，尺子落下的距离越短，说明什么？","choices":[{"key":"A","text":"反应越快"},{"key":"B","text":"反应越慢"},{"key":"C","text":"尺子越轻"},{"key":"D","text":"没有意义"}],"answer":"A","explanation":"抓住得快，尺子下落少。","verify":"\"反应越快\""},{"id":"cns_p189_q1","topicId":"cns_p189","difficulty":"basic","type":"choice","prompt":"小学生每天的睡眠时间建议大约是多少？","choices":[{"key":"A","text":"约 4 小时"},{"key":"B","text":"约 6 小时"},{"key":"C","text":"约 10 小时"},{"key":"D","text":"约 15 小时"}],"answer":"C","explanation":"小学生每天应睡约 10 小时。","verify":"\"约 10 小时\""},{"id":"cns_p189_q2","topicId":"cns_p189","difficulty":"basic","type":"choice","prompt":"下面哪种做法有助于入睡？","choices":[{"key":"A","text":"睡前玩激烈游戏"},{"key":"B","text":"睡前喝浓茶"},{"key":"C","text":"开着强光"},{"key":"D","text":"睡前不看手机等电子屏幕"}],"answer":"D","explanation":"电子屏幕的光会影响入睡。","verify":"\"睡前不看手机等电子屏幕\""},{"id":"cns_p189_q3","topicId":"cns_p189","difficulty":"standard","type":"choice","prompt":"长期睡眠不足，最可能出现什么情况？","choices":[{"key":"A","text":"注意力下降，影响生长和学习"},{"key":"B","text":"长得更高"},{"key":"C","text":"成绩更好"},{"key":"D","text":"精神更足"}],"answer":"A","explanation":"充足睡眠有利于生长发育和记忆。","verify":"\"注意力下降，影响生长和学习\""},{"id":"cns_p189_q4","topicId":"cns_p189","difficulty":"challenge","type":"choice","prompt":"为了让睡眠更充足，下面哪种做法更合适？","choices":[{"key":"A","text":"经常熬夜赶作业"},{"key":"B","text":"尽量按时睡觉，保证每天睡够"},{"key":"C","text":"周末通宵再白天补觉"},{"key":"D","text":"困了才想起睡觉"}],"answer":"B","explanation":"规律、充足的睡眠有利于身体健康。","verify":"\"尽量按时睡觉，保证每天睡够\""},{"id":"cns_p243_q1","topicId":"cns_p243","difficulty":"basic","type":"choice","prompt":"生气时，下面哪种做法比较合适？","choices":[{"key":"A","text":"深呼吸、暂时离开，冷静后再说"},{"key":"B","text":"摔东西"},{"key":"C","text":"骂人"},{"key":"D","text":"打人"}],"answer":"A","explanation":"学会调节情绪。","verify":"\"深呼吸、暂时离开，冷静后再说\""},{"id":"cns_p243_q2","topicId":"cns_p243","difficulty":"basic","type":"choice","prompt":"心情不好时，下面哪种做法更有助于管理情绪？","choices":[{"key":"A","text":"把气撒在别人身上"},{"key":"B","text":"找信任的人说说，或做喜欢的活动放松"},{"key":"C","text":"一个人一直生闷气"},{"key":"D","text":"用大喊大叫发泄"}],"answer":"B","explanation":"用合适的方式疏导情绪，比伤害自己或别人更好。","verify":"\"找信任的人说说，或做喜欢的活动放松\""},{"id":"cns_p243_q3","topicId":"cns_p243","difficulty":"standard","type":"choice","prompt":"感到紧张时，比较好的做法是？","choices":[{"key":"A","text":"假装什么都没发生"},{"key":"B","text":"马上放弃要做的事"},{"key":"C","text":"先让自己平静下来，再处理眼前的事"},{"key":"D","text":"责怪周围所有人"}],"answer":"C","explanation":"先平复情绪，再面对问题，是管理情绪的一种方式。","verify":"\"先让自己平静下来，再处理眼前的事\""},{"id":"cns_p243_q4","topicId":"cns_p243","difficulty":"challenge","type":"choice","prompt":"下面哪句话更符合「管理我们的情绪」？","choices":[{"key":"A","text":"有情绪就是不对"},{"key":"B","text":"生气时一定要马上发作"},{"key":"C","text":"高兴或难过都不用在意"},{"key":"D","text":"情绪有变化很正常，可以用合适的办法调节"}],"answer":"D","explanation":"管理情绪是学会觉察并适当调节。","verify":"\"情绪有变化很正常，可以用合适的办法调节\""},{"id":"cns_p190_q1","topicId":"cns_p190","difficulty":"basic","type":"choice","prompt":"一份合理的健康生活计划应该包括哪些方面？","choices":[{"key":"A","text":"只有饮食"},{"key":"B","text":"只有玩游戏"},{"key":"C","text":"只有学习"},{"key":"D","text":"饮食、运动、睡眠和情绪"}],"answer":"D","explanation":"健康生活要全面考虑。","verify":"\"饮食、运动、睡眠和情绪\""},{"id":"cns_p190_q2","topicId":"cns_p190","difficulty":"basic","type":"choice","prompt":"下面哪种早餐搭配更合理？","choices":[{"key":"A","text":"牛奶、鸡蛋、全麦面包和水果"},{"key":"B","text":"只喝一杯可乐"},{"key":"C","text":"只吃一包薯片"},{"key":"D","text":"不吃早餐"}],"answer":"A","explanation":"早餐要包含谷物、蛋白质和果蔬。","verify":"\"牛奶、鸡蛋、全麦面包和水果\""},{"id":"cns_p190_q3","topicId":"cns_p190","difficulty":"standard","type":"choice","prompt":"每天坚持多长时间的体育锻炼比较合适？","choices":[{"key":"A","text":"5 分钟"},{"key":"B","text":"约 1 小时"},{"key":"C","text":"不需要"},{"key":"D","text":"5 小时以上"}],"answer":"B","explanation":"建议每天进行约 1 小时中等强度运动。","verify":"\"约 1 小时\""},{"id":"cns_p190_q4","topicId":"cns_p190","difficulty":"challenge","type":"choice","prompt":"执行计划一段时间后，发现总是做不到，应该怎么做？","choices":[{"key":"A","text":"彻底放弃"},{"key":"B","text":"装作做到了"},{"key":"C","text":"分析原因，调整成更可行的计划"},{"key":"D","text":"让别人代做"}],"answer":"C","explanation":"计划要根据实际情况不断改进。","verify":"\"分析原因，调整成更可行的计划\""}]
