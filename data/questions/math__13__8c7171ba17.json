[{"id":"cnm_h197_q1","topicId":"cnm_h197","difficulty":"basic","type":"choice","prompt":"下面哪一项最能说明数列和数集的差别？","choices":[{"key":"A","text":"数列不能有重复的数"},{"key":"B","text":"数列必须有无穷多项"},{"key":"C","text":"数列讲究顺序，数集不讲究顺序"},{"key":"D","text":"数列的每一项必须是正数"}],"answer":"C","explanation":"数列按顺序排列。同样的数换顺序，一般是不同的数列。","verify":"\"数列讲究顺序，数集不讲究顺序\""},{"id":"cnm_h197_q2","topicId":"cnm_h197","difficulty":"basic","type":"numeric","prompt":"数列 3，5，7，9 的第 3 项是多少？","answer":"7","explanation":"从第 1 项数起，第 3 项是 7。","verify":"7"},{"id":"cnm_h197_q3","topicId":"cnm_h197","difficulty":"standard","type":"numeric","prompt":"数列 2，4，6，8，10 一共有多少项？","answer":"5","explanation":"写出的五项都要数进去。","verify":"5"},{"id":"cnm_h197_q4","topicId":"cnm_h197","difficulty":"standard","type":"choice","prompt":"数列 1，1，1，1 是不是一个数列？","choices":[{"key":"A","text":"不是，因为有重复"},{"key":"B","text":"是，各项相等也可以"},{"key":"C","text":"不是，因为没有递增"},{"key":"D","text":"不是，因为通项不存在"}],"answer":"B","explanation":"常数列也是数列，每一项都是 1。","verify":"\"是，各项相等也可以\""},{"id":"cnm_h198_q1","topicId":"cnm_h198","difficulty":"basic","type":"numeric","prompt":"通项公式 a_n=2n+1。第 4 项是多少？","answer":"9","explanation":"把 n=4 代入，得 8+1=9。","verify":"2*4+1"},{"id":"cnm_h198_q2","topicId":"cnm_h198","difficulty":"basic","type":"choice","prompt":"数列的图象通常是什么样子？","choices":[{"key":"A","text":"一串孤立的点"},{"key":"B","text":"一条连续直线"},{"key":"C","text":"一条抛物线的全部"},{"key":"D","text":"一个圆"}],"answer":"A","explanation":"序号是正整数，所以图象只在正整数处有点，不是连续曲线。","verify":"\"一串孤立的点\""},{"id":"cnm_h198_q3","topicId":"cnm_h198","difficulty":"standard","type":"numeric","prompt":"数列前四项是 1，3，5，7。第 1 项与第 4 项的和是多少？","answer":"8","explanation":"1+7=8。","verify":"1+7"},{"id":"cnm_h198_q4","topicId":"cnm_h198","difficulty":"standard","type":"choice","prompt":"用通项公式表示数列时，n 通常取什么数？","choices":[{"key":"A","text":"任意实数"},{"key":"B","text":"任意负数"},{"key":"C","text":"正整数"},{"key":"D","text":"只取 0"}],"answer":"C","explanation":"项的序号从 1 开始，是正整数。","verify":"\"正整数\""},{"id":"cnm_h199_q1","topicId":"cnm_h199","difficulty":"basic","type":"numeric","prompt":"a_n=3n−1。a_4 等于多少？","answer":"11","explanation":"3×4−1=11。","verify":"3*4-1"},{"id":"cnm_h199_q2","topicId":"cnm_h199","difficulty":"basic","type":"numeric","prompt":"a_n=n²。a_5 等于多少？","answer":"25","explanation":"5 的平方是 25。","verify":"5*5"},{"id":"cnm_h199_q3","topicId":"cnm_h199","difficulty":"standard","type":"numeric","prompt":"a_n=10−n。a_3 等于多少？","answer":"7","explanation":"10−3=7。","verify":"10-3"},{"id":"cnm_h199_q4","topicId":"cnm_h199","difficulty":"standard","type":"choice","prompt":"通项公式 a_n=2n 的前三项是？","choices":[{"key":"A","text":"1，2，3"},{"key":"B","text":"2，3，4"},{"key":"C","text":"1，3，5"},{"key":"D","text":"2，4，6"}],"answer":"D","explanation":"n=1、2、3 时分别得 2、4、6。","verify":"\"2，4，6\""},{"id":"cnm_h200_q1","topicId":"cnm_h200","difficulty":"basic","type":"numeric","prompt":"a_1=3，a_{n+1}=a_n+4。a_2 等于多少？","answer":"7","explanation":"后一项比前一项大 4，a_2=7。","verify":"3+4"},{"id":"cnm_h200_q2","topicId":"cnm_h200","difficulty":"basic","type":"numeric","prompt":"a_1=2，a_{n+1}=3a_n。a_3 等于多少？","answer":"18","explanation":"a_2=6，a_3=18。","verify":"2*3*3"},{"id":"cnm_h200_q3","topicId":"cnm_h200","difficulty":"standard","type":"numeric","prompt":"a_1=5，a_{n+1}=a_n−1。a_4 等于多少？","answer":"2","explanation":"从第 1 项到第 4 项减了 3 次，得 2。","verify":"5-3"},{"id":"cnm_h200_q4","topicId":"cnm_h200","difficulty":"standard","type":"choice","prompt":"a_{n+1}=a_n+2 给出的是什么？","choices":[{"key":"A","text":"递推关系"},{"key":"B","text":"直接写出任意一项的通项，不需要首项"},{"key":"C","text":"数列的和"},{"key":"D","text":"函数的导数"}],"answer":"A","explanation":"它用前一项表示后一项，还要知道首项才能确定整个数列。","verify":"\"递推关系\""}]
