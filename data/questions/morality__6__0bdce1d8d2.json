[{"id":"cnd_p153_q1","topicId":"cnd_p153","difficulty":"basic","type":"choice","prompt":"家人之所以珍贵，是因为？","choices":[{"key":"A","text":"家里东西最多"},{"key":"B","text":"家人从不提要求"},{"key":"C","text":"互相关爱、共同生活"},{"key":"D","text":"家人只会批评"}],"answer":"C","explanation":"家是互相关爱的地方。","verify":"\"互相关爱、共同生活\""},{"id":"cnd_p153_q2","topicId":"cnd_p153","difficulty":"basic","type":"choice","prompt":"父母辛苦工作，我们可以？","choices":[{"key":"A","text":"故意添乱"},{"key":"B","text":"什么家务都不做"},{"key":"C","text":"只顾要礼物"},{"key":"D","text":"体贴他们，少让他们操心"}],"answer":"D","explanation":"体贴父母是爱家的表现。","verify":"\"体贴他们，少让他们操心\""},{"id":"cnd_p153_q3","topicId":"cnd_p153","difficulty":"standard","type":"choice","prompt":"和家人意见不同，较好做法？","choices":[{"key":"A","text":"心平气和说明想法，一起商量"},{"key":"B","text":"摔门而出"},{"key":"C","text":"完全不说话冷战"},{"key":"D","text":"大声骂人"}],"answer":"A","explanation":"家庭矛盾也要好好沟通。","verify":"\"心平气和说明想法，一起商量\""},{"id":"cnd_p153_q4","topicId":"cnd_p153","difficulty":"challenge","type":"choice","prompt":"为什么要弘扬家庭美德？","choices":[{"key":"A","text":"家庭美德过时了"},{"key":"B","text":"尊敬长辈、相亲相爱，家庭更和睦"},{"key":"C","text":"只顾自己最重要"},{"key":"D","text":"美德只在学校需要"}],"answer":"B","explanation":"家庭美德让家更温暖。","verify":"\"尊敬长辈、相亲相爱，家庭更和睦\""},{"id":"cnd_p154_q1","topicId":"cnd_p154","difficulty":"basic","type":"choice","prompt":"亲近大自然时，正确做法是？","choices":[{"key":"A","text":"捕捉珍稀动物带回家"},{"key":"B","text":"折断树枝取乐"},{"key":"C","text":"把垃圾留在山里"},{"key":"D","text":"观察欣赏，不伤害动植物"}],"answer":"D","explanation":"亲近自然也要保护自然。","verify":"\"观察欣赏，不伤害动植物\""},{"id":"cnd_p154_q2","topicId":"cnd_p154","difficulty":"basic","type":"choice","prompt":"节约用纸，可以怎么做？","choices":[{"key":"A","text":"双面使用，废纸回收"},{"key":"B","text":"一张只用一个字就扔"},{"key":"C","text":"把新本子撕着玩"},{"key":"D","text":"拒绝使用任何回收纸"}],"answer":"A","explanation":"节约纸张保护树木。","verify":"\"双面使用，废纸回收\""},{"id":"cnd_p154_q3","topicId":"cnd_p154","difficulty":"standard","type":"choice","prompt":"关于水和资源，我们应？","choices":[{"key":"A","text":"水永远用不完"},{"key":"B","text":"节约用水，保护水源清洁"},{"key":"C","text":"把脏水倒进河里没关系"},{"key":"D","text":"洗澡时间越长越好"}],"answer":"B","explanation":"水资源需要珍惜。","verify":"\"节约用水，保护水源清洁\""},{"id":"cnd_p154_q4","topicId":"cnd_p154","difficulty":"challenge","type":"choice","prompt":"低碳生活，小学生可以？","choices":[{"key":"A","text":"白天开灯睡觉"},{"key":"B","text":"短途也空转汽车久等"},{"key":"C","text":"随手关灯、绿色出行、少用一次性用品"},{"key":"D","text":"把垃圾倒进河道"}],"answer":"C","explanation":"日常小事也能低碳。","verify":"\"随手关灯、绿色出行、少用一次性用品\""}]
