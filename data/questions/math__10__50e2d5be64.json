[{"id":"cnm_h075_q1","topicId":"cnm_h075","difficulty":"basic","type":"numeric","prompt":"y=2sin x 的最大值是多少？","answer":"2","explanation":"A=2>0，最大值是振幅 2。","verify":"2"},{"id":"cnm_h075_q2","topicId":"cnm_h075","difficulty":"basic","type":"numeric","prompt":"y=sin(2x) 的最小正周期除以 π，结果是多少？","answer":"1","explanation":"周期是 2π/2=π，再除以 π 得 1。","verify":"1"},{"id":"cnm_h075_q3","topicId":"cnm_h075","difficulty":"standard","type":"numeric","prompt":"求 sin(0+π/2)。x 用弧度。","answer":"1","explanation":"sin(π/2)=1。","verify":"sin(radians(90))"},{"id":"cnm_h075_q4","topicId":"cnm_h075","difficulty":"standard","type":"choice","prompt":"y=Asin(ωx+φ) 里，振幅是？","choices":[{"key":"A","text":"一定是 A 本身"},{"key":"B","text":"ω"},{"key":"C","text":"φ"},{"key":"D","text":"A 的绝对值"}],"answer":"D","explanation":"A 为负时图象上下翻转，振幅仍取绝对值。","verify":"\"A 的绝对值\""},{"id":"cnm_h076_q1","topicId":"cnm_h076","difficulty":"basic","type":"numeric","prompt":"y=2sin(2x+φ) 的振幅是多少？","answer":"2","explanation":"A=2，振幅是 2。","verify":"2"},{"id":"cnm_h076_q2","topicId":"cnm_h076","difficulty":"basic","type":"numeric","prompt":"ω=2 时，最小正周期除以 π 是多少？","answer":"1","explanation":"T=2π/ω=π，除以 π 得 1。","verify":"1"},{"id":"cnm_h076_q3","topicId":"cnm_h076","difficulty":"standard","type":"numeric","prompt":"求 sin(π/6−π/6)。","answer":"0","explanation":"括号里是 0，正弦是 0。","verify":"sin(radians(0))"},{"id":"cnm_h076_q4","topicId":"cnm_h076","difficulty":"standard","type":"choice","prompt":"y=sin(x+φ) 中的 φ 叫做？","choices":[{"key":"A","text":"初相"},{"key":"B","text":"振幅"},{"key":"C","text":"周期"},{"key":"D","text":"频率"}],"answer":"A","explanation":"φ 是 x=0 时相位的起点，称为初相。","verify":"\"初相\""},{"id":"cnm_h077_q1","topicId":"cnm_h077","difficulty":"basic","type":"numeric","prompt":"一个正弦型函数最大值是 5，最小值是 −1。振幅是多少？","answer":"3","explanation":"最大值与最小值的差的一半是 (5+1)/2=3。","verify":"(5-(-1))/2"},{"id":"cnm_h077_q2","topicId":"cnm_h077","difficulty":"basic","type":"numeric","prompt":"一个正弦型函数最大值是 5，最小值是 −1。平衡位置是多少？","answer":"2","explanation":"平衡位置是最大值与最小值的平均，(5+(−1))/2=2。","verify":"(5+(-1))/2"},{"id":"cnm_h077_q3","topicId":"cnm_h077","difficulty":"standard","type":"numeric","prompt":"最小正周期是 4π。ω 等于 2π 除以周期，ω 是多少？","answer":"1/2","explanation":"ω=2π/(4π)=1/2。","verify":"Fraction(2,4)"},{"id":"cnm_h077_q4","topicId":"cnm_h077","difficulty":"standard","type":"choice","prompt":"只知道最大值和最小值，还不能确定？","choices":[{"key":"A","text":"振幅"},{"key":"B","text":"周期和初相"},{"key":"C","text":"平衡位置"},{"key":"D","text":"函数值的范围"}],"answer":"B","explanation":"最大、最小决定振幅和上下位置，周期要另给时间间隔。","verify":"\"周期和初相\""}]
