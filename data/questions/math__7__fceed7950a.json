[{"id":"cnm_042_q1","topicId":"cnm_042","difficulty":"standard","type":"numeric","prompt":"解方程 3x+2=x-6。（只填 x 的值）","answer":"-4","explanation":"移项得 3x-x=-6-2，合并得 2x=-8，系数化为 1 得 x=-4。","verify":"Fraction(-6-2,3-1)"},{"id":"cnm_042_q2","topicId":"cnm_042","difficulty":"basic","type":"numeric","prompt":"解方程 2x-5=9。（只填 x 的值）","answer":"7","explanation":"移项得 2x=9+5=14，系数化为 1 得 x=7。","verify":"Fraction(9+5,2)"},{"id":"cnm_042_q3","topicId":"cnm_042","difficulty":"standard","type":"numeric","prompt":"解方程 2x+3=5x-4，结果写成最简分数。（只填 x 的值）","answer":"7/3","explanation":"移项得 2x-5x=-4-3，即 -3x=-7，所以 x=7/3。","verify":"Fraction(3+4,5-2)"},{"id":"cnm_042_q4","topicId":"cnm_042","difficulty":"standard","type":"choice","prompt":"解方程 2x-3=5x+6 时，移项后正确的是哪一个？","answer":"B","choices":[{"key":"A","text":"2x-5x=6-3"},{"key":"B","text":"2x-5x=6+3"},{"key":"C","text":"2x+5x=6+3"},{"key":"D","text":"2x-5x=-3-6"}],"explanation":"移项要变号：把 5x 移到左边变为 -5x，把 -3 移到右边变为 +3，得 2x-5x=6+3。"},{"id":"cnm_043_q1","topicId":"cnm_043","difficulty":"standard","type":"numeric","prompt":"解方程 2(x-3)=4-(x+1)。（只填 x 的值）","answer":"3","explanation":"去括号得 2x-6=4-x-1，移项合并得 3x=9，所以 x=3。","verify":"Fraction(4-1+6,2+1)"},{"id":"cnm_043_q2","topicId":"cnm_043","difficulty":"basic","type":"numeric","prompt":"解方程 3(x-1)=9。（只填 x 的值）","answer":"4","explanation":"去括号得 3x-3=9，移项得 3x=12，所以 x=4。","verify":"Fraction(9,3)+1"},{"id":"cnm_043_q3","topicId":"cnm_043","difficulty":"standard","type":"numeric","prompt":"解方程 5(x+2)-3(2x-1)=4。（只填 x 的值）","answer":"9","explanation":"去括号得 5x+10-6x+3=4，合并得 -x+13=4，所以 x=9。","verify":"-(4-5*2-3)"},{"id":"cnm_043_q4","topicId":"cnm_043","difficulty":"advanced","type":"numeric","prompt":"解方程 2x-3(x-1)=-2(x+1)+7。（只填 x 的值）","answer":"2","explanation":"去括号得 2x-3x+3=-2x-2+7，即 -x+3=-2x+5，移项得 x=2。","verify":"Fraction(5-3,-1+2)"},{"id":"cnm_044_q1","topicId":"cnm_044","difficulty":"standard","type":"numeric","prompt":"解方程 (x+1)/2 - x/3 = 1。（只填 x 的值）","answer":"3","explanation":"两边同乘 6：3(x+1)-2x=6，去括号得 x+3=6，所以 x=3。","verify":"6-3"},{"id":"cnm_044_q2","topicId":"cnm_044","difficulty":"basic","type":"numeric","prompt":"解方程 x/2 + x/3 = 5。（只填 x 的值）","answer":"6","explanation":"两边同乘 6：3x+2x=30，即 5x=30，所以 x=6。","verify":"Fraction(5*6,3+2)"},{"id":"cnm_044_q3","topicId":"cnm_044","difficulty":"standard","type":"numeric","prompt":"解方程 (2x-1)/3 = (x+2)/2。（只填 x 的值）","answer":"8","explanation":"两边同乘 6：2(2x-1)=3(x+2)，得 4x-2=3x+6，所以 x=8。","verify":"Fraction(6+2,4-3)"},{"id":"cnm_044_q4","topicId":"cnm_044","difficulty":"advanced","type":"numeric","prompt":"解方程 (x-1)/2 - (2x+1)/3 = 1。（只填 x 的值）","answer":"-11","explanation":"两边同乘 6（注意右边的 1 也要乘 6）：3(x-1)-2(2x+1)=6，得 3x-3-4x-2=6，即 -x-5=6，所以 x=-11。","verify":"Fraction(6+5,-1)"}]
