[{"id":"cnp_091_q1","topicId":"cnp_091","difficulty":"basic","type":"choice","prompt":"目前核电站获得核能的途径是什么？","choices":[{"key":"A","text":"核聚变"},{"key":"B","text":"化学反应"},{"key":"C","text":"燃烧铀"},{"key":"D","text":"核裂变"}],"answer":"D","explanation":"核电站利用可控的核裂变释放能量。","verify":"\"核裂变\""},{"id":"cnp_091_q2","topicId":"cnp_091","difficulty":"basic","type":"choice","prompt":"太阳能来自太阳内部发生的什么反应？","choices":[{"key":"A","text":"核裂变"},{"key":"B","text":"燃烧"},{"key":"C","text":"化学分解"},{"key":"D","text":"核聚变"}],"answer":"D","explanation":"太阳内部氢原子核发生聚变，释放巨大能量。","verify":"\"核聚变\""},{"id":"cnp_091_q3","topicId":"cnp_091","difficulty":"standard","type":"choice","prompt":"太阳能电池板工作时，把太阳能转化为什么能？","choices":[{"key":"A","text":"化学能"},{"key":"B","text":"机械能"},{"key":"C","text":"电能"},{"key":"D","text":"核能"}],"answer":"C","explanation":"太阳能电池直接把光能转化为电能。","verify":"\"电能\""},{"id":"cnp_091_q4","topicId":"cnp_091","difficulty":"standard","type":"choice","prompt":"关于核能，下列说法正确的是哪一个？","choices":[{"key":"A","text":"核废料有放射性，需要妥善处理"},{"key":"B","text":"核能是可再生能源"},{"key":"C","text":"核电站没有任何风险"},{"key":"D","text":"核电站利用核聚变发电"}],"answer":"A","explanation":"核燃料不可再生，核电站利用核裂变；核泄漏和核废料的放射性必须严格防护。","verify":"\"核废料有放射性，需要妥善处理\""}]
