[{"id":"cne_p100_q1","topicId":"cne_p100","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「衬衫」？","choices":[{"key":"A","text":"dress"},{"key":"B","text":"shirt"},{"key":"C","text":"skirt"},{"key":"D","text":"pants"}],"answer":"B","explanation":"shirt 的意思是衬衫。","verify":"\"shirt\""},{"id":"cne_p100_q2","topicId":"cne_p100","difficulty":"basic","type":"choice","prompt":"「dress」的中文意思是哪一个？","choices":[{"key":"A","text":"衬衫"},{"key":"B","text":"裙子"},{"key":"C","text":"连衣裙"},{"key":"D","text":"裤子"}],"answer":"C","explanation":"dress 的意思是连衣裙。","verify":"\"连衣裙\""},{"id":"cne_p100_q3","topicId":"cne_p100","difficulty":"standard","type":"choice","prompt":"选择表示「裙子」的单词。","choices":[{"key":"A","text":"shirt"},{"key":"B","text":"dress"},{"key":"C","text":"pants"},{"key":"D","text":"skirt"}],"answer":"D","explanation":"表示裙子的单词是 skirt。","verify":"\"skirt\""},{"id":"cne_p100_q4","topicId":"cne_p100","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「裤子」？","choices":[{"key":"A","text":"pants"},{"key":"B","text":"shirt"},{"key":"C","text":"dress"},{"key":"D","text":"skirt"}],"answer":"A","explanation":"pants 的意思是裤子。","verify":"\"pants\""},{"id":"cne_p101_q1","topicId":"cne_p101","difficulty":"basic","type":"choice","prompt":"问「这是谁的帽子」，应选哪一句？","choices":[{"key":"A","text":"Who hat is this?"},{"key":"B","text":"Where hat is this?"},{"key":"C","text":"Whose hat is this?"},{"key":"D","text":"What hat is this?"}],"answer":"C","explanation":"问属于谁用 Whose。","verify":"\"Whose hat is this?\""},{"id":"cne_p101_q2","topicId":"cne_p101","difficulty":"basic","type":"choice","prompt":"It is Amy's dress. 裙子是谁的？","choices":[{"key":"A","text":"Mike 的"},{"key":"B","text":"老师的"},{"key":"C","text":"我的"},{"key":"D","text":"Amy 的"}],"answer":"D","explanation":"Amy's 表示 Amy 的。","verify":"\"Amy 的\""},{"id":"cne_p101_q3","topicId":"cne_p101","difficulty":"standard","type":"choice","prompt":"Whose pants are these? 这句是在问什么？","choices":[{"key":"A","text":"这条裤子是谁的"},{"key":"B","text":"裤子是什么颜色"},{"key":"C","text":"裤子多少钱"},{"key":"D","text":"裤子在哪里"}],"answer":"A","explanation":"Whose pants 问裤子是谁的。","verify":"\"这条裤子是谁的\""},{"id":"cne_p101_q4","topicId":"cne_p101","difficulty":"standard","type":"choice","prompt":"This is Chen Jie's skirt. 裙子是谁的？","choices":[{"key":"A","text":"Amy 的"},{"key":"B","text":"Chen Jie 的"},{"key":"C","text":"John 的"},{"key":"D","text":"Sarah 的"}],"answer":"B","explanation":"Chen Jie's 表示 Chen Jie 的。","verify":"\"Chen Jie 的\""},{"id":"cne_p102_q1","topicId":"cne_p102","difficulty":"basic","type":"choice","prompt":"想说自己喜欢这条裙子，应说哪一句？","choices":[{"key":"A","text":"I like this shirt."},{"key":"B","text":"I like this dress."},{"key":"C","text":"I like these pants."},{"key":"D","text":"I like this skirt."}],"answer":"D","explanation":"裙子是 skirt。","verify":"\"I like this skirt.\""},{"id":"cne_p102_q2","topicId":"cne_p102","difficulty":"basic","type":"choice","prompt":"Whose shirt is this? 若是 Mike 的，应回答哪一句？","choices":[{"key":"A","text":"It is Mike's."},{"key":"B","text":"It is Amy's."},{"key":"C","text":"It is Sarah's."},{"key":"D","text":"It is Chen Jie's."}],"answer":"A","explanation":"Mike 的要说 Mike's。","verify":"\"It is Mike's.\""},{"id":"cne_p102_q3","topicId":"cne_p102","difficulty":"standard","type":"choice","prompt":"These pants are Zhang Peng's. 裤子是谁的？","choices":[{"key":"A","text":"Amy 的"},{"key":"B","text":"Zhang Peng 的"},{"key":"C","text":"Sarah 的"},{"key":"D","text":"John 的"}],"answer":"B","explanation":"Zhang Peng's 是 Zhang Peng 的。","verify":"\"Zhang Peng 的\""},{"id":"cne_p102_q4","topicId":"cne_p102","difficulty":"standard","type":"choice","prompt":"Put on your shirt. 这句是在说什么？","choices":[{"key":"A","text":"脱下你的裙子"},{"key":"B","text":"这是谁的裤子"},{"key":"C","text":"穿上你的衬衫"},{"key":"D","text":"我喜欢这条连衣裙"}],"answer":"C","explanation":"Put on your shirt 是穿上衬衫。","verify":"\"穿上你的衬衫\""},{"id":"cne_p103_q1","topicId":"cne_p103","difficulty":"basic","type":"choice","prompt":"读一读：This is Amy's dress. It is red. 连衣裙是谁的？","choices":[{"key":"A","text":"Amy 的"},{"key":"B","text":"Mike 的"},{"key":"C","text":"John 的"},{"key":"D","text":"Sarah 的"}],"answer":"A","explanation":"Amy's dress。","verify":"\"Amy 的\""},{"id":"cne_p103_q2","topicId":"cne_p103","difficulty":"basic","type":"choice","prompt":"读一读：Whose pants are these? They are Zhang Peng's. 裤子是谁的？","choices":[{"key":"A","text":"Amy 的"},{"key":"B","text":"Zhang Peng 的"},{"key":"C","text":"Chen Jie 的"},{"key":"D","text":"老师的"}],"answer":"B","explanation":"回答是 Zhang Peng's。","verify":"\"Zhang Peng 的\""},{"id":"cne_p103_q3","topicId":"cne_p103","difficulty":"standard","type":"choice","prompt":"读一读：I like that green skirt. 喜欢的裙子是什么颜色？","choices":[{"key":"A","text":"红色"},{"key":"B","text":"蓝色"},{"key":"C","text":"绿色"},{"key":"D","text":"黄色"}],"answer":"C","explanation":"green skirt。","verify":"\"绿色\""},{"id":"cne_p103_q4","topicId":"cne_p103","difficulty":"standard","type":"choice","prompt":"读一读：My shirt is white. Sarah's shirt is blue. 谁的衬衫是蓝色的？","choices":[{"key":"A","text":"我的"},{"key":"B","text":"Amy 的"},{"key":"C","text":"Mike 的"},{"key":"D","text":"Sarah 的"}],"answer":"D","explanation":"Sarah's shirt is blue。","verify":"\"Sarah 的\""},{"id":"cne_p220_q1","topicId":"cne_p220","difficulty":"basic","type":"choice","prompt":"「堆雪人」用哪一组词？","choices":[{"key":"A","text":"make a snowman"},{"key":"B","text":"fly a kite"},{"key":"C","text":"go swimming"},{"key":"D","text":"pick apples"}],"answer":"A","explanation":"make a snowman 是堆雪人。","verify":"\"make a snowman\""},{"id":"cne_p220_q2","topicId":"cne_p220","difficulty":"basic","type":"choice","prompt":"fly a kite 的意思是？","choices":[{"key":"A","text":"游泳"},{"key":"B","text":"堆雪人"},{"key":"C","text":"摘苹果"},{"key":"D","text":"放风筝"}],"answer":"D","explanation":"fly a kite 是放风筝。","verify":"\"放风筝\""},{"id":"cne_p220_q3","topicId":"cne_p220","difficulty":"standard","type":"choice","prompt":"夏天常做的活动是？","choices":[{"key":"A","text":"wear a thick coat"},{"key":"B","text":"skate on ice"},{"key":"C","text":"go swimming"},{"key":"D","text":"make a snowman"}],"answer":"C","explanation":"夏天常游泳。","verify":"\"go swimming\""},{"id":"cne_p220_q4","topicId":"cne_p220","difficulty":"standard","type":"choice","prompt":"pick apples 多在哪个季节？","choices":[{"key":"A","text":"夏天只游泳"},{"key":"B","text":"秋天"},{"key":"C","text":"冬天"},{"key":"D","text":"春天只放风筝"}],"answer":"B","explanation":"摘苹果多在秋天。","verify":"\"秋天\""},{"id":"cne_p221_q1","topicId":"cne_p221","difficulty":"basic","type":"choice","prompt":"读一读：Season: summer. Wear: T-shirt. Do: swim. 卡片里的季节是？","choices":[{"key":"A","text":"夏天"},{"key":"B","text":"冬天"},{"key":"C","text":"秋天"},{"key":"D","text":"春天"}],"answer":"A","explanation":"summer 是夏天。","verify":"\"夏天\""},{"id":"cne_p221_q2","topicId":"cne_p221","difficulty":"basic","type":"choice","prompt":"读一读：Season: winter. Wear: coat. Do: make a snowman. 冬天做什么？","choices":[{"key":"A","text":"游泳"},{"key":"B","text":"放风筝"},{"key":"C","text":"摘苹果"},{"key":"D","text":"堆雪人"}],"answer":"D","explanation":"make a snowman。","verify":"\"堆雪人\""},{"id":"cne_p221_q3","topicId":"cne_p221","difficulty":"standard","type":"choice","prompt":"读一读：Spring trip. Wear a sweater. Fly a kite. 哪一句和卡片一致？","choices":[{"key":"A","text":"春天去游泳。"},{"key":"B","text":"春天摘苹果。"},{"key":"C","text":"春天可以放风筝。"},{"key":"D","text":"春天要穿大衣堆雪人。"}],"answer":"C","explanation":"Fly a kite。","verify":"\"春天可以放风筝。\""},{"id":"cne_p221_q4","topicId":"cne_p221","difficulty":"standard","type":"choice","prompt":"读一读：Autumn. Wear a jacket. Pick apples. 穿着是什么？","choices":[{"key":"A","text":"泳装"},{"key":"B","text":"夹克"},{"key":"C","text":"T 恤"},{"key":"D","text":"大衣"}],"answer":"B","explanation":"jacket 是夹克。","verify":"\"夹克\""}]
