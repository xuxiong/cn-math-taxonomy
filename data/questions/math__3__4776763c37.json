[{"difficulty":"basic","type":"choice","prompt":"数字编码是为了什么？","choices":[{"key":"A","text":"用数字表示事物，方便区分"},{"key":"B","text":"把所有数都变成 0"},{"key":"C","text":"只用来做加法"}],"answer":"A","explanation":"编码里的每一位可以表示不同的意思。","verify":"'用数字表示事物，方便区分'","id":"cnm_p076_q1","topicId":"cnm_p076"},{"difficulty":"basic","type":"numeric","prompt":"学号 25 的十位表示年级，个位表示小组。年级是几？","answer":"2","explanation":"25 的十位是 2，表示 2 年级。","verify":"2","id":"cnm_p076_q2","topicId":"cnm_p076"},{"difficulty":"standard","type":"numeric","prompt":"编码 3205 里，百位上的数字表示座区。座区是几？","answer":"2","explanation":"3205 的百位是 2。","verify":"2","id":"cnm_p076_q3","topicId":"cnm_p076"},{"difficulty":"challenge","type":"numeric","prompt":"年级用数字 3，座号用两位数 15。年级写在前面、座号写在后面，这个三位数是多少？","answer":"315","explanation":"3 和 15 连起来是 315。","verify":"300+15","id":"cnm_p076_q4","topicId":"cnm_p076"},{"difficulty":"basic","type":"choice","prompt":"给全班同学编学号时，下面哪一种更合理？","choices":[{"key":"A","text":"按班级、座位等规则用数字表示"},{"key":"B","text":"每个人随便写一个喜欢的数"},{"key":"C","text":"全班都用同一个号"}],"answer":"A","explanation":"学号要能区分每个人，并带有班级等信息。","verify":"'按班级、座位等规则用数字表示'","id":"cnm_p280_q1","topicId":"cnm_p280"},{"difficulty":"basic","type":"numeric","prompt":"学号写成「年级＋班号＋座号」。三年级 2 班 5 号，班号一位、座号两位，这个学号是多少？","answer":"3205","explanation":"3、2、05 连起来是 3205。","verify":"3000+200+5","id":"cnm_p280_q2","topicId":"cnm_p280"},{"difficulty":"standard","type":"numeric","prompt":"学号 4108 表示四年级 1 班 08 号。座号是多少？","answer":"8","explanation":"后两位 08 表示座号 8。","verify":"8","id":"cnm_p280_q3","topicId":"cnm_p280"},{"difficulty":"challenge","type":"numeric","prompt":"五年级有 3 个班，每班 40 人。若学号用「年级＋班号＋两位座号」，五年级 3 班最后一名的学号是多少？","answer":"5340","explanation":"5、3、40 连起来是 5340。","verify":"5000+300+40","id":"cnm_p280_q4","topicId":"cnm_p280"}]
