[{"id":"cnc_p042_q1","topicId":"cnc_p042","difficulty":"basic","type":"choice","prompt":"「秋霜降」的「霜」最常出现在哪个季节？","choices":[{"key":"A","text":"夏天中午"},{"key":"B","text":"春天开花时"},{"key":"C","text":"每天下午"},{"key":"D","text":"秋天到冬天的寒冷时候"}],"answer":"D","explanation":"霜出现在天冷的时候。课文把它和秋天、冬天放在一起，不和夏天放在一起。","verify":"\"秋天到冬天的寒冷时候\""},{"id":"cnc_p042_q2","topicId":"cnc_p042","difficulty":"basic","type":"choice","prompt":"下面哪一件是冬天的景象？","choices":[{"key":"A","text":"冬雪飘"},{"key":"B","text":"春风吹"},{"key":"C","text":"夏雨落"},{"key":"D","text":"山花红"}],"answer":"A","explanation":"冬雪飘是冬天。春风、夏雨和山花红都不是冬天。","verify":"\"冬雪飘\""},{"id":"cnc_p042_q3","topicId":"cnc_p042","difficulty":"standard","type":"choice","prompt":"「雪」和「霜」的上面都是什么？","choices":[{"key":"A","text":"宝盖头"},{"key":"B","text":"雨字头"},{"key":"C","text":"草字头"},{"key":"D","text":"竹字头"}],"answer":"B","explanation":"雪、霜、雷都是雨字头。花才是草字头。","verify":"\"雨字头\""},{"id":"cnc_p042_q4","topicId":"cnc_p042","difficulty":"standard","type":"choice","prompt":"哪一组和课文的搭配一致？","choices":[{"key":"A","text":"春风落，夏雨吹"},{"key":"B","text":"秋霜飘，冬雪降"},{"key":"C","text":"春风吹，夏雨落"},{"key":"D","text":"冬雪吹，春霜落"}],"answer":"C","explanation":"课文是春风吹、夏雨落、秋霜降、冬雪飘。动词不能随便对换。","verify":"\"春风吹，夏雨落\""},{"id":"cnc_p043_q1","topicId":"cnc_p043","difficulty":"basic","type":"choice","prompt":"「木子李」的「李」是哪两个部分合成的？","choices":[{"key":"A","text":"木和子"},{"key":"B","text":"弓和长"},{"key":"C","text":"古和月"},{"key":"D","text":"口和天"}],"answer":"A","explanation":"木加子是李。弓加长是张，古加月是胡，口加天是吴。","verify":"\"木和子\""},{"id":"cnc_p043_q2","topicId":"cnc_p043","difficulty":"basic","type":"choice","prompt":"「什么张？弓长张」说的是哪个姓？","choices":[{"key":"A","text":"李"},{"key":"B","text":"张"},{"key":"C","text":"胡"},{"key":"D","text":"吴"}],"answer":"B","explanation":"弓和长合起来是张。李是木子李，不是弓长。","verify":"\"张\""},{"id":"cnc_p043_q3","topicId":"cnc_p043","difficulty":"standard","type":"choice","prompt":"「古月」合起来是哪个姓？","choices":[{"key":"A","text":"吴"},{"key":"B","text":"徐"},{"key":"C","text":"胡"},{"key":"D","text":"许"}],"answer":"C","explanation":"古加月是胡。口加天才是吴，双人徐、言午许是后面的姓。","verify":"\"胡\""},{"id":"cnc_p043_q4","topicId":"cnc_p043","difficulty":"standard","type":"choice","prompt":"课文说中国姓氏有很多，接着的一句是什么？","choices":[{"key":"A","text":"只有木子李一个姓"},{"key":"B","text":"春风吹，夏雨落"},{"key":"C","text":"小娃撑小艇"},{"key":"D","text":"张王李赵遍地刘"}],"answer":"D","explanation":"课文的后两句是：中国姓氏有很多，张王李赵遍地刘。","verify":"\"张王李赵遍地刘\""},{"id":"cnc_p044_q1","topicId":"cnc_p044","difficulty":"basic","type":"choice","prompt":"《小青蛙》里，小青蛙做了什么好事情？","choices":[{"key":"A","text":"把禾苗咬坏"},{"key":"B","text":"保护禾苗，吃害虫"},{"key":"C","text":"只在河里睡觉"},{"key":"D","text":"让禾苗生病"}],"answer":"B","explanation":"诗里写它保护禾苗、吃害虫，做了不少好事情。","verify":"\"保护禾苗，吃害虫\""},{"id":"cnc_p044_q2","topicId":"cnc_p044","difficulty":"basic","type":"choice","prompt":"「小小青蛙大眼睛」里，表示眼睛的是哪个字？","choices":[{"key":"A","text":"晴"},{"key":"B","text":"清"},{"key":"C","text":"睛"},{"key":"D","text":"请"}],"answer":"C","explanation":"眼睛的睛是目字旁。晴是日字旁，清是三点水，请是言字旁。","verify":"\"睛\""},{"id":"cnc_p044_q3","topicId":"cnc_p044","difficulty":"standard","type":"choice","prompt":"诗的最后请大家怎样对待小青蛙？","choices":[{"key":"A","text":"捉住它来玩"},{"key":"B","text":"不让它吃害虫"},{"key":"C","text":"把它赶出稻田"},{"key":"D","text":"爱护它，好让禾苗不生病"}],"answer":"D","explanation":"请你爱护小青蛙，好让禾苗不生病。","verify":"\"爱护它，好让禾苗不生病\""},{"id":"cnc_p044_q4","topicId":"cnc_p044","difficulty":"standard","type":"choice","prompt":"「做了不少好事情」的「情」是什么偏旁？","choices":[{"key":"A","text":"竖心旁"},{"key":"B","text":"三点水"},{"key":"C","text":"日字旁"},{"key":"D","text":"言字旁"}],"answer":"A","explanation":"心情、事情的情是竖心旁。清水才是三点水，晴天才是日字旁。","verify":"\"竖心旁\""},{"id":"cnc_p045_q1","topicId":"cnc_p045","difficulty":"basic","type":"choice","prompt":"「左边绿，右边红，左右相遇起凉风」打的是哪个字？","choices":[{"key":"A","text":"春"},{"key":"B","text":"明"},{"key":"C","text":"秋"},{"key":"D","text":"花"}],"answer":"C","explanation":"左边禾苗绿，右边火红，合起来是秋。凉风也和秋天有关。","verify":"\"秋\""},{"id":"cnc_p045_q2","topicId":"cnc_p045","difficulty":"basic","type":"choice","prompt":"「言来互相尊重」打的是哪个字？","choices":[{"key":"A","text":"情"},{"key":"B","text":"晴"},{"key":"C","text":"清"},{"key":"D","text":"请"}],"answer":"D","explanation":"言字旁加青是请，请有尊重、礼貌的意思。","verify":"\"请\""},{"id":"cnc_p045_q3","topicId":"cnc_p045","difficulty":"standard","type":"choice","prompt":"「日出万里无云」打的是哪个字？","choices":[{"key":"A","text":"晴"},{"key":"B","text":"清"},{"key":"C","text":"请"},{"key":"D","text":"情"}],"answer":"A","explanation":"日字旁加青是晴，日出无云就是晴天。","verify":"\"晴\""},{"id":"cnc_p045_q4","topicId":"cnc_p045","difficulty":"standard","type":"choice","prompt":"「水到纯净透明」打的是哪个字？","choices":[{"key":"A","text":"晴"},{"key":"B","text":"清"},{"key":"C","text":"请"},{"key":"D","text":"青"}],"answer":"B","explanation":"三点水加青是清，水清了才纯净透明。","verify":"\"清\""},{"id":"cnc_p046_q1","topicId":"cnc_p046","difficulty":"basic","type":"choice","prompt":"铅笔滚到桌下，想请同学帮忙。哪一种说法最合适？","choices":[{"key":"A","text":"你必须马上给我捡！"},{"key":"B","text":"铅笔。"},{"key":"C","text":"不许你捡。"},{"key":"D","text":"请你帮我捡一下铅笔，谢谢！"}],"answer":"D","explanation":"先说请，再说清帮什么忙，最后道谢。命令别人，或只说一个词，对方不知道该怎样帮。","verify":"\"请你帮我捡一下铅笔，谢谢！\""},{"id":"cnc_p046_q2","topicId":"cnc_p046","difficulty":"basic","type":"choice","prompt":"别人已经帮完忙，接着该说什么？","choices":[{"key":"A","text":"谢谢你"},{"key":"B","text":"快走开"},{"key":"C","text":"这本来就该你做"},{"key":"D","text":"什么也不说就跑开"}],"answer":"A","explanation":"别人帮了忙，要说谢谢。催人走开、不道谢，都不合适。","verify":"\"谢谢你\""},{"id":"cnc_p046_q3","topicId":"cnc_p046","difficulty":"standard","type":"choice","prompt":"请人帮忙，首先要说清楚什么？","choices":[{"key":"A","text":"只喊一声喂"},{"key":"B","text":"请谁帮忙、帮什么忙"},{"key":"C","text":"先批评对方"},{"key":"D","text":"先讲一件完全无关的事"}],"answer":"B","explanation":"对方要知道你在叫谁、要帮的是哪一件事，才帮得上。","verify":"\"请谁帮忙、帮什么忙\""},{"id":"cnc_p046_q4","topicId":"cnc_p046","difficulty":"standard","type":"choice","prompt":"下面哪一种做法不合适？","choices":[{"key":"A","text":"用上请"},{"key":"B","text":"把要帮的事说清楚"},{"key":"C","text":"大声命令别人快点给自己做"},{"key":"D","text":"帮完以后道谢"}],"answer":"C","explanation":"请人帮忙要客气。命令别人，就不是在请求了。","verify":"\"大声命令别人快点给自己做\""},{"id":"cnc_p047_q1","topicId":"cnc_p047","difficulty":"basic","type":"choice","prompt":"童谣和儿歌最明显的特点是什么？","choices":[{"key":"A","text":"句子短，有节奏，读起来顺口"},{"key":"B","text":"每一句都很长，听不出节奏"},{"key":"C","text":"只能默写，不能出声读"},{"key":"D","text":"必须换成古文才算读过"}],"answer":"A","explanation":"童谣、儿歌句子短，常常押韵，适合朗读。","verify":"\"句子短，有节奏，读起来顺口\""},{"id":"cnc_p047_q2","topicId":"cnc_p047","difficulty":"basic","type":"choice","prompt":"读童谣时，哪一种做法合适？","choices":[{"key":"A","text":"把句子里的字全部跳过"},{"key":"B","text":"按节奏朗读，还可以拍手一起读"},{"key":"C","text":"只读题目，不读句子"},{"key":"D","text":"故意读得没有停顿"}],"answer":"B","explanation":"读出节奏，别人才能听出儿歌的味道。跳过句子就没有在读。","verify":"\"按节奏朗读，还可以拍手一起读\""},{"id":"cnc_p047_q3","topicId":"cnc_p047","difficulty":"standard","type":"choice","prompt":"读完一首喜欢的儿歌，可以怎样做？","choices":[{"key":"A","text":"合上书以后再也不读"},{"key":"B","text":"只记住一个标点"},{"key":"C","text":"读给大人听，或和别人再读一遍"},{"key":"D","text":"改成另一个故事，还说是原来的儿歌"}],"answer":"C","explanation":"快乐读书吧就是多读、读给别人听。改掉内容就不是原来那首了。","verify":"\"读给大人听，或和别人再读一遍\""},{"id":"cnc_p047_q4","topicId":"cnc_p047","difficulty":"standard","type":"choice","prompt":"哪一种材料适合放在这里读？","choices":[{"key":"A","text":"很长的产品说明"},{"key":"B","text":"一页空白"},{"key":"C","text":"只有数字的表格"},{"key":"D","text":"句子短、读起来顺口的童谣"}],"answer":"D","explanation":"这一栏读的是童谣和儿歌，不是说明书或表格。","verify":"\"句子短、读起来顺口的童谣\""}]
