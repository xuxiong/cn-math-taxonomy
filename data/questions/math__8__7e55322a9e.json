[{"id":"cnm_169_q1","topicId":"cnm_169","difficulty":"basic","type":"numeric","prompt":"计算 √2×√8。","answer":"4","explanation":"√2×√8=√(2×8)=√16=4。","verify":"sqrt(2*8)"},{"id":"cnm_169_q2","topicId":"cnm_169","difficulty":"basic","type":"numeric","prompt":"计算 √3×√12。","answer":"6","explanation":"√3×√12=√36=6。","verify":"sqrt(3*12)"},{"id":"cnm_169_q3","topicId":"cnm_169","difficulty":"standard","type":"numeric","prompt":"计算 (2√3)×(3√3)。","answer":"18","explanation":"系数相乘 2×3=6，根式相乘 √3×√3=3，结果 6×3=18。","verify":"2*3*sqrt(3*3)"},{"id":"cnm_169_q4","topicId":"cnm_169","difficulty":"standard","type":"choice","prompt":"把 √45 化成最简二次根式，结果是","answer":"C","choices":[{"key":"A","text":"5√3"},{"key":"B","text":"9√5"},{"key":"C","text":"3√5"},{"key":"D","text":"15√3"}],"explanation":"√45=√(9×5)=3√5。"},{"id":"cnm_169_q5","topicId":"cnm_169","difficulty":"advanced","type":"numeric","prompt":"计算 2√6 × 3√(2/3)。","answer":"12","explanation":"系数 2×3=6，根式 √6×√(2/3)=√4=2，结果 6×2=12。","verify":"2*3*sqrt(6*Fraction(2,3))"},{"id":"cnm_170_q1","topicId":"cnm_170","difficulty":"basic","type":"numeric","prompt":"计算 √12÷√3。","answer":"2","explanation":"√12÷√3=√(12÷3)=√4=2。","verify":"sqrt(12/3)"},{"id":"cnm_170_q2","topicId":"cnm_170","difficulty":"basic","type":"numeric","prompt":"计算 √48÷√3。","answer":"4","explanation":"√48÷√3=√16=4。","verify":"sqrt(48/3)"},{"id":"cnm_170_q3","topicId":"cnm_170","difficulty":"standard","type":"numeric","prompt":"计算 √27÷√(1/3)。","answer":"9","explanation":"√27÷√(1/3)=√(27÷1/3)=√81=9。","verify":"sqrt(27/Fraction(1,3))"},{"id":"cnm_170_q4","topicId":"cnm_170","difficulty":"standard","type":"choice","prompt":"要使等式 √x/√(x-2) = √(x/(x-2)) 成立，x 的取值范围是","answer":"D","choices":[{"key":"A","text":"x≥2"},{"key":"B","text":"x≥0"},{"key":"C","text":"x>0"},{"key":"D","text":"x>2"}],"explanation":"需被开方数 x≥0 且分母的根式 √(x-2) 中 x-2>0（分母不为 0），综合得 x>2。"},{"id":"cnm_171_q1","topicId":"cnm_171","difficulty":"standard","type":"choice","prompt":"化简 √18 和 1/√2。","answer":"A","choices":[{"key":"A","text":"3√2；√2/2"},{"key":"B","text":"9√2；√2/2"},{"key":"C","text":"3√2；1/2"},{"key":"D","text":"2√3；√2"}],"explanation":"√18=√(9×2)=3√2；1/√2 分子分母同乘 √2 得 √2/2。"},{"id":"cnm_171_q2","topicId":"cnm_171","difficulty":"basic","type":"choice","prompt":"下列二次根式中，是最简二次根式的是","answer":"B","choices":[{"key":"A","text":"√8"},{"key":"B","text":"√7"},{"key":"C","text":"√(1/2)"},{"key":"D","text":"√12"}],"explanation":"√8=2√2、√12=2√3 含能开尽方的因数，√(1/2) 的被开方数含分母，只有 √7 是最简二次根式。"},{"id":"cnm_171_q3","topicId":"cnm_171","difficulty":"standard","type":"numeric","prompt":"化简 6/√3，结果等于 k√3，则 k 等于多少？","answer":"2","explanation":"6/√3=6√3/3=2√3，所以 k=2。","verify":"Fraction(6,3)"},{"id":"cnm_171_q4","topicId":"cnm_171","difficulty":"standard","type":"numeric","prompt":"分母有理化：1/(√5+√3)=k(√5-√3)，则 k 等于多少？（写成最简分数）","answer":"1/2","explanation":"分子分母同乘 √5-√3：(√5-√3)/(5-3)=(1/2)(√5-√3)，所以 k=1/2。","verify":"1/(sqrt(5)+sqrt(3))/(sqrt(5)-sqrt(3))"}]
