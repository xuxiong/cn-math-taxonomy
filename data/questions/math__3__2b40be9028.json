[{"difficulty":"basic","type":"choice","prompt":"分数的分母表示什么？","choices":[{"key":"A","text":"把整体平均分成了几份"},{"key":"B","text":"拿走了几份"},{"key":"C","text":"一共有多少个整体"}],"answer":"A","explanation":"几分之一里，分母是平均分成的份数，分子 1 表示其中的 1 份。","verify":"'把整体平均分成了几份'","id":"cnm_p079_q1","topicId":"cnm_p079"},{"difficulty":"basic","type":"numeric","prompt":"把一张纸平均分成 4 份，取其中 1 份。这一份是这张纸的几分之几？","answer":"1/4","explanation":"平均分成 4 份，1 份是 1/4。","verify":"Fraction(1,4)","id":"cnm_p079_q2","topicId":"cnm_p079"},{"difficulty":"standard","type":"numeric","prompt":"一张纸平均分成 8 份，涂了其中 1 份。涂色部分是这张纸的几分之几？","answer":"1/8","explanation":"平均分成 8 份，1 份是 1/8。","verify":"Fraction(1,8)","id":"cnm_p079_q3","topicId":"cnm_p079"},{"difficulty":"challenge","type":"numeric","prompt":"一个蛋糕平均分给 2 个小朋友。每人得到的是这个蛋糕的几分之几？","answer":"1/2","explanation":"平均分成 2 份，每人 1 份，是 1/2。","verify":"Fraction(1,2)","id":"cnm_p079_q4","topicId":"cnm_p079"},{"difficulty":"basic","type":"numeric","prompt":"1/5 加上 2/5 是多少？","answer":"3/5","explanation":"分母不变，分子 1＋2＝3，得 3/5。","verify":"Fraction(1,5)+Fraction(2,5)","id":"cnm_p080_q1","topicId":"cnm_p080"},{"difficulty":"basic","type":"numeric","prompt":"3/4 减去 1/4 是多少？","answer":"1/2","explanation":"分子 3－1＝2，得 2/4，就是 1/2。","verify":"Fraction(3,4)-Fraction(1,4)","id":"cnm_p080_q2","topicId":"cnm_p080"},{"difficulty":"standard","type":"numeric","prompt":"一条绳子用去 2/8，又用去 3/8。一共用去几分之几？","answer":"5/8","explanation":"分母不变，2/8＋3/8＝5/8。","verify":"Fraction(2,8)+Fraction(3,8)","id":"cnm_p080_q3","topicId":"cnm_p080"},{"difficulty":"challenge","type":"numeric","prompt":"一块饼平均分成 8 份，小明吃了 3 份，小红吃了 2 份。还剩这块饼的几分之几？","answer":"3/8","explanation":"吃了 3/8＋2/8＝5/8，剩下 8/8－5/8＝3/8。","verify":"Fraction(8-3-2,8)","id":"cnm_p080_q4","topicId":"cnm_p080"},{"difficulty":"basic","type":"numeric","prompt":"把一个圆平均分成 4 份，涂了其中 3 份。涂色部分是这个圆的几分之几？","answer":"3/4","explanation":"平均分成 4 份，取 3 份，是 3/4。","verify":"Fraction(3,4)","id":"cnm_p226_q1","topicId":"cnm_p226"},{"difficulty":"basic","type":"choice","prompt":"5/8 的分母是几？","choices":[{"key":"A","text":"3"},{"key":"B","text":"5"},{"key":"C","text":"8"}],"answer":"C","explanation":"分数线下面的数是分母，5/8 的分母是 8。","verify":"'8'","id":"cnm_p226_q2","topicId":"cnm_p226"},{"difficulty":"standard","type":"numeric","prompt":"把一根绳子平均分成 10 段，用去 7 段。用去的是这根绳子的几分之几？","answer":"7/10","explanation":"10 段里用去 7 段，是 7/10。","verify":"Fraction(7,10)","id":"cnm_p226_q3","topicId":"cnm_p226"},{"difficulty":"challenge","type":"numeric","prompt":"一块蛋糕平均切成 6 块，吃了 1 块。还剩下这块蛋糕的几分之几？","answer":"5/6","explanation":"剩下 5 块，是 5/6。","verify":"Fraction(5,6)","id":"cnm_p226_q4","topicId":"cnm_p226"},{"difficulty":"basic","type":"choice","prompt":"3/7 和 2/7 哪个大？","choices":[{"key":"A","text":"2/7"},{"key":"B","text":"一样大"},{"key":"C","text":"3/7"}],"answer":"C","explanation":"分母相同，分子大的分数大，3/7 更大。","verify":"'3/7'","id":"cnm_p227_q1","topicId":"cnm_p227"},{"difficulty":"basic","type":"choice","prompt":"1/3 和 1/5 哪个大？","choices":[{"key":"A","text":"一样大"},{"key":"B","text":"1/3"},{"key":"C","text":"1/5"}],"answer":"B","explanation":"分子都是 1 时，分母小的分数大，1/3 更大。","verify":"'1/3'","id":"cnm_p227_q2","topicId":"cnm_p227"},{"difficulty":"standard","type":"choice","prompt":"4/9、1/9、5/9 中最大的是哪个？","choices":[{"key":"A","text":"4/9"},{"key":"B","text":"1/9"},{"key":"C","text":"5/9"}],"answer":"C","explanation":"分母相同，分子 5 最大，所以 5/9 最大。","verify":"'5/9'","id":"cnm_p227_q3","topicId":"cnm_p227"},{"difficulty":"challenge","type":"numeric","prompt":"同样大的两张饼，一张平均分成 4 份、一张平均分成 8 份。各取 1 份，1/4 比 1/8 大多少？","answer":"1/8","explanation":"1/4＝2/8，2/8－1/8＝1/8。","verify":"Fraction(1,4)-Fraction(1,8)","id":"cnm_p227_q4","topicId":"cnm_p227"},{"difficulty":"basic","type":"choice","prompt":"把一个蛋糕平均分成 2 份，每份是这个蛋糕的几分之几？","choices":[{"key":"A","text":"1/2"},{"key":"B","text":"2/2"},{"key":"C","text":"1/3"}],"answer":"A","explanation":"平均分成 2 份，其中 1 份是 1/2。","verify":"'1/2'","id":"cnm_p278_q1","topicId":"cnm_p278"},{"difficulty":"basic","type":"numeric","prompt":"一张长方形纸对折一次，再展开，每份是这张纸的几分之几？用分数作答。","answer":"1/2","explanation":"对折一次平均分成 2 份，每份是 1/2。","verify":"Fraction(1,2)","id":"cnm_p278_q2","topicId":"cnm_p278"},{"difficulty":"standard","type":"numeric","prompt":"把 8 个同样的苹果平均分成 2 堆。每堆是这些苹果的几分之几？","answer":"1/2","explanation":"平均分成 2 堆，每堆是 1/2。","verify":"Fraction(1,2)","id":"cnm_p278_q3","topicId":"cnm_p278"},{"difficulty":"challenge","type":"choice","prompt":"下面哪种分法得到的是 1/2？","choices":[{"key":"A","text":"一块饼对半切开，取其中一半"},{"key":"B","text":"一块饼随便切开，取较大的一块"},{"key":"C","text":"把饼切成 3 块，取 1 块"}],"answer":"A","explanation":"必须平均分成 2 份，取其中 1 份，才是 1/2。","verify":"'一块饼对半切开，取其中一半'","id":"cnm_p278_q4","topicId":"cnm_p278"}]
