[{"id":"cnd_p142_q1","topicId":"cnd_p142","difficulty":"basic","type":"choice","prompt":"我们的祖国是？","choices":[{"key":"A","text":"某一个省"},{"key":"B","text":"某一个市"},{"key":"C","text":"某一个学校"},{"key":"D","text":"中华人民共和国"}],"answer":"D","explanation":"我们的祖国是中华人民共和国。","verify":"\"中华人民共和国\""},{"id":"cnd_p142_q2","topicId":"cnd_p142","difficulty":"basic","type":"choice","prompt":"作为中国人，应当？","choices":[{"key":"A","text":"热爱祖国，遵守法律和公德"},{"key":"B","text":"破坏公共财物"},{"key":"C","text":"传播谣言"},{"key":"D","text":"歧视其他民族同学"}],"answer":"A","explanation":"爱国守法、尊重各族同学。","verify":"\"热爱祖国，遵守法律和公德\""},{"id":"cnd_p142_q3","topicId":"cnd_p142","difficulty":"standard","type":"choice","prompt":"我国是统一的多民族国家，正确态度是？","choices":[{"key":"A","text":"只尊重本民族"},{"key":"B","text":"各民族平等团结、互相尊重"},{"key":"C","text":"嘲笑其他民族习俗"},{"key":"D","text":"拒绝与其他民族交往"}],"answer":"B","explanation":"民族团结很重要。","verify":"\"各民族平等团结、互相尊重\""},{"id":"cnd_p142_q4","topicId":"cnd_p142","difficulty":"challenge","type":"choice","prompt":"为祖国自豪，小学生可以怎么做？","choices":[{"key":"A","text":"只喊口号不行动"},{"key":"B","text":"破坏文物"},{"key":"C","text":"努力学习，文明礼貌，爱护环境"},{"key":"D","text":"不遵守公共秩序"}],"answer":"C","explanation":"用实际行动爱国。","verify":"\"努力学习，文明礼貌，爱护环境\""},{"id":"cnd_p143_q1","topicId":"cnd_p143","difficulty":"basic","type":"choice","prompt":"法律是什么？","choices":[{"key":"A","text":"由国家制定或认可、具有强制力的行为规范"},{"key":"B","text":"只是学校校规"},{"key":"C","text":"同学间的口头约定"},{"key":"D","text":"可有可无的建议"}],"answer":"A","explanation":"法律是特殊的行为规范。","verify":"\"由国家制定或认可、具有强制力的行为规范\""},{"id":"cnd_p143_q2","topicId":"cnd_p143","difficulty":"basic","type":"choice","prompt":"我国的根本法是？","choices":[{"key":"A","text":"一本故事书"},{"key":"B","text":"宪法"},{"key":"C","text":"班规"},{"key":"D","text":"游戏规则"}],"answer":"B","explanation":"宪法是国家的根本法。","verify":"\"宪法\""},{"id":"cnd_p143_q3","topicId":"cnd_p143","difficulty":"standard","type":"choice","prompt":"作为中国公民，既有权利也有？","choices":[{"key":"A","text":"只享权利不尽义务"},{"key":"B","text":"想尽就尽不想就放弃且无责"},{"key":"C","text":"义务"},{"key":"D","text":"义务只属于大人"}],"answer":"C","explanation":"权利与义务相一致。","verify":"\"义务\""},{"id":"cnd_p143_q4","topicId":"cnd_p143","difficulty":"challenge","type":"choice","prompt":"未成年人受到特殊保护，遇到侵害应？","choices":[{"key":"A","text":"自己忍着不说"},{"key":"B","text":"用违法手段报复"},{"key":"C","text":"以为小孩不受法律保护"},{"key":"D","text":"告诉家长、老师或拨打报警求助电话"}],"answer":"D","explanation":"依法求助，用法律保护自己。","verify":"\"告诉家长、老师或拨打报警求助电话\""},{"id":"cnd_p144_q1","topicId":"cnd_p144","difficulty":"basic","type":"choice","prompt":"家人之所以珍贵，是因为？","choices":[{"key":"A","text":"家里东西最多"},{"key":"B","text":"互相关爱、共同生活"},{"key":"C","text":"家人从不提要求"},{"key":"D","text":"家人只会批评"}],"answer":"B","explanation":"家是互相关爱的地方。","verify":"\"互相关爱、共同生活\""},{"id":"cnd_p144_q2","topicId":"cnd_p144","difficulty":"basic","type":"choice","prompt":"父母辛苦工作，我们可以？","choices":[{"key":"A","text":"故意添乱"},{"key":"B","text":"什么家务都不做"},{"key":"C","text":"体贴他们，少让他们操心"},{"key":"D","text":"只顾要礼物"}],"answer":"C","explanation":"体贴父母是爱家的表现。","verify":"\"体贴他们，少让他们操心\""},{"id":"cnd_p144_q3","topicId":"cnd_p144","difficulty":"standard","type":"choice","prompt":"和家人意见不同，较好做法？","choices":[{"key":"A","text":"摔门而出"},{"key":"B","text":"完全不说话冷战"},{"key":"C","text":"大声骂人"},{"key":"D","text":"心平气和说明想法，一起商量"}],"answer":"D","explanation":"家庭矛盾也要好好沟通。","verify":"\"心平气和说明想法，一起商量\""},{"id":"cnd_p144_q4","topicId":"cnd_p144","difficulty":"challenge","type":"choice","prompt":"为什么要弘扬家庭美德？","choices":[{"key":"A","text":"尊敬长辈、相亲相爱，家庭更和睦"},{"key":"B","text":"家庭美德过时了"},{"key":"C","text":"只顾自己最重要"},{"key":"D","text":"美德只在学校需要"}],"answer":"A","explanation":"家庭美德让家更温暖。","verify":"\"尊敬长辈、相亲相爱，家庭更和睦\""}]
