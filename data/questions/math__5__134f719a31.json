[{"difficulty":"basic","type":"choice","prompt":"一个图形平移、旋转或作轴对称之后，大小和形状怎样？","choices":[{"key":"A","text":"大小和形状都不变"},{"key":"B","text":"一定变大"},{"key":"C","text":"形状一定改变"}],"answer":"A","explanation":"平移、旋转和轴对称只改变位置或方向，不改变大小和形状。","verify":"'大小和形状都不变'","id":"cnm_p238_q1","topicId":"cnm_p238"},{"difficulty":"basic","type":"numeric","prompt":"方格纸上一个点在第 4 列，向右平移 2 格后在第几列？","answer":"6","explanation":"向右平移，列数增加：4＋2＝6。","verify":"4+2","id":"cnm_p238_q2","topicId":"cnm_p238"},{"difficulty":"standard","type":"numeric","prompt":"方格纸上一个点在第 3 列第 2 行，向右平移 4 格、再向上平移 3 格。现在在第几列？","answer":"7","explanation":"向上平移不改变列。列数是 3＋4＝7。","verify":"3+4","id":"cnm_p238_q3","topicId":"cnm_p238"},{"difficulty":"challenge","type":"numeric","prompt":"钟面上的指针从 12 顺时针转到 6，再继续顺时针转到 9。从 12 到 9 一共旋转了多少度？","answer":"270","explanation":"从 12 到 6 是 180 度，再到 9 是 90 度，一共 180＋90＝270 度。","verify":"180+90","id":"cnm_p238_q4","topicId":"cnm_p238"}]
