[{"id":"cne_j050_q1","topicId":"cne_j050","difficulty":"basic","type":"choice","prompt":"他每天都锻炼。哪一个词最合适？","choices":[{"key":"A","text":"never"},{"key":"B","text":"sometimes"},{"key":"C","text":"seldom only once"},{"key":"D","text":"always"}],"answer":"D","explanation":"每天都做用 always。","verify":"\"always\""},{"id":"cne_j050_q2","topicId":"cne_j050","difficulty":"basic","type":"choice","prompt":"她从不迟到。哪一句正确？","choices":[{"key":"A","text":"She is never late."},{"key":"B","text":"She never is late."},{"key":"C","text":"She is late never."},{"key":"D","text":"She never late."}],"answer":"A","explanation":"be 动词放在 never 前面：is never。","verify":"\"She is never late.\""},{"id":"cne_j050_q3","topicId":"cne_j050","difficulty":"standard","type":"choice","prompt":"I usually do my homework at 7. usually 的意思是什么？","choices":[{"key":"A","text":"从不"},{"key":"B","text":"通常"},{"key":"C","text":"总是，一次不落"},{"key":"D","text":"只在周末"}],"answer":"B","explanation":"usually 是通常。","verify":"\"通常\""},{"id":"cne_j050_q4","topicId":"cne_j050","difficulty":"standard","type":"choice","prompt":"频度从高到低，哪一组顺序正确？","choices":[{"key":"A","text":"never, sometimes, usually, always"},{"key":"B","text":"usually, never, always, sometimes"},{"key":"C","text":"always, usually, sometimes, never"},{"key":"D","text":"sometimes, always, never, usually"}],"answer":"C","explanation":"always 最高，never 最低。","verify":"\"always, usually, sometimes, never\""},{"id":"cne_j103_q1","topicId":"cne_j103","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「锻炼」？","choices":[{"key":"A","text":"exercise"},{"key":"B","text":"hardly"},{"key":"C","text":"twice"},{"key":"D","text":"Internet"}],"answer":"A","explanation":"exercise 的意思是锻炼。","verify":"\"exercise\""},{"id":"cne_j103_q2","topicId":"cne_j103","difficulty":"basic","type":"choice","prompt":"「hardly」的中文意思是哪一个？","choices":[{"key":"A","text":"锻炼"},{"key":"B","text":"几乎不"},{"key":"C","text":"两次"},{"key":"D","text":"互联网"}],"answer":"B","explanation":"hardly 的意思是几乎不。","verify":"\"几乎不\""},{"id":"cne_j103_q3","topicId":"cne_j103","difficulty":"standard","type":"choice","prompt":"选择表示「两次」的单词。","choices":[{"key":"A","text":"exercise"},{"key":"B","text":"hardly"},{"key":"C","text":"twice"},{"key":"D","text":"Internet"}],"answer":"C","explanation":"表示两次的单词是 twice。","verify":"\"twice\""},{"id":"cne_j103_q4","topicId":"cne_j103","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「互联网」？","choices":[{"key":"A","text":"exercise"},{"key":"B","text":"hardly"},{"key":"C","text":"twice"},{"key":"D","text":"Internet"}],"answer":"D","explanation":"Internet 的意思是互联网。","verify":"\"Internet\""},{"id":"cne_j104_q1","topicId":"cne_j104","difficulty":"basic","type":"choice","prompt":"想问对方多久锻炼一次，哪一句正确？","choices":[{"key":"A","text":"How often you exercise?"},{"key":"B","text":"How often do you exercise?"},{"key":"C","text":"How long do you exercise once?"},{"key":"D","text":"How far do you exercise?"}],"answer":"B","explanation":"How often 问频率，后面用助动词 do。","verify":"\"How often do you exercise?\""},{"id":"cne_j104_q2","topicId":"cne_j104","difficulty":"basic","type":"choice","prompt":"我一周两次。哪一句正确？","choices":[{"key":"A","text":"I exercise two time a week."},{"key":"B","text":"I exercise twice week."},{"key":"C","text":"I exercise twice a week."},{"key":"D","text":"I exercise a twice week."}],"answer":"C","explanation":"twice a week 表示一周两次。","verify":"\"I exercise twice a week.\""},{"id":"cne_j104_q3","topicId":"cne_j104","difficulty":"standard","type":"choice","prompt":"hardly ever 的意思是哪一个？","choices":[{"key":"A","text":"每天"},{"key":"B","text":"一周三次"},{"key":"C","text":"只在昨天"},{"key":"D","text":"几乎从不"}],"answer":"D","explanation":"hardly ever 表示频率非常低。","verify":"\"几乎从不\""},{"id":"cne_j104_q4","topicId":"cne_j104","difficulty":"standard","type":"choice","prompt":"She uses the Internet every day. 这句说明什么？","choices":[{"key":"A","text":"她每天上网"},{"key":"B","text":"她几乎不上网"},{"key":"C","text":"她一周上一次"},{"key":"D","text":"她昨天没上网"}],"answer":"A","explanation":"every day 是每天。","verify":"\"她每天上网\""},{"id":"cne_j105_q1","topicId":"cne_j105","difficulty":"basic","type":"choice","prompt":"医生问你多久运动一次，哪一句是这个问题？","choices":[{"key":"A","text":"How old do you exercise?"},{"key":"B","text":"What time is exercise yesterday?"},{"key":"C","text":"How often do you exercise?"},{"key":"D","text":"How many exercise are you?"}],"answer":"C","explanation":"How often 用来问习惯的频率。","verify":"\"How often do you exercise?\""},{"id":"cne_j105_q2","topicId":"cne_j105","difficulty":"basic","type":"choice","prompt":"你几乎不喝牛奶，应怎么说？","choices":[{"key":"A","text":"I hardly ever drank milk tomorrow."},{"key":"B","text":"I hard ever drink milk."},{"key":"C","text":"I hardly ever drinking milk."},{"key":"D","text":"I hardly ever drink milk."}],"answer":"D","explanation":"hardly ever 放在实义动词前面。","verify":"\"I hardly ever drink milk.\""},{"id":"cne_j105_q3","topicId":"cne_j105","difficulty":"standard","type":"choice","prompt":"对方回答 Three times a week. 这是在说什么？","choices":[{"key":"A","text":"一周三次"},{"key":"B","text":"三点钟"},{"key":"C","text":"三公里"},{"key":"D","text":"三个人"}],"answer":"A","explanation":"times a week 表示每周几次。","verify":"\"一周三次\""},{"id":"cne_j105_q4","topicId":"cne_j105","difficulty":"standard","type":"choice","prompt":"想建议对方多运动，哪一句合适？","choices":[{"key":"A","text":"You should exercises more."},{"key":"B","text":"You should exercise more."},{"key":"C","text":"You should to exercise more."},{"key":"D","text":"You should exercising more."}],"answer":"B","explanation":"should 后面用动词原形。","verify":"\"You should exercise more.\""},{"id":"cne_j106_q1","topicId":"cne_j106","difficulty":"basic","type":"choice","prompt":"Jack exercises every day. Mary exercises twice a week. Peter hardly ever exercises. 谁每天锻炼？","choices":[{"key":"A","text":"Mary"},{"key":"B","text":"Peter"},{"key":"C","text":"没有人"},{"key":"D","text":"Jack"}],"answer":"D","explanation":"Jack exercises every day。","verify":"\"Jack\""},{"id":"cne_j106_q2","topicId":"cne_j106","difficulty":"basic","type":"choice","prompt":"Jack exercises every day. Mary exercises twice a week. Peter hardly ever exercises. 谁几乎不锻炼？","choices":[{"key":"A","text":"Peter"},{"key":"B","text":"Jack"},{"key":"C","text":"Mary"},{"key":"D","text":"三个人一样"}],"answer":"A","explanation":"Peter hardly ever exercises。","verify":"\"Peter\""},{"id":"cne_j106_q3","topicId":"cne_j106","difficulty":"standard","type":"choice","prompt":"Mary uses the Internet once a week. She reads books every night. 她多久上一次网？","choices":[{"key":"A","text":"每天"},{"key":"B","text":"一周一次"},{"key":"C","text":"几乎从不"},{"key":"D","text":"一周两次"}],"answer":"B","explanation":"once a week。","verify":"\"一周一次\""},{"id":"cne_j106_q4","topicId":"cne_j106","difficulty":"standard","type":"choice","prompt":"Mary uses the Internet once a week. She reads books every night. 哪一句和短文一致？","choices":[{"key":"A","text":"Mary never reads."},{"key":"B","text":"Mary uses the Internet every day."},{"key":"C","text":"Mary reads every night."},{"key":"D","text":"Mary hardly ever reads."}],"answer":"C","explanation":"reads books every night。","verify":"\"Mary reads every night.\""},{"id":"cne_j247_q1","topicId":"cne_j247","difficulty":"basic","type":"choice","prompt":"— Is this your ball? — Yes, it's ____.","choices":[{"key":"A","text":"my"},{"key":"B","text":"me"},{"key":"C","text":"I"},{"key":"D","text":"mine"}],"answer":"D","explanation":"it's 后面单独用 mine。","verify":"\"mine\""},{"id":"cne_j247_q2","topicId":"cne_j247","difficulty":"basic","type":"choice","prompt":"His running shoes are new, but ____ are old. 我的鞋旧。","choices":[{"key":"A","text":"I"},{"key":"B","text":"mine"},{"key":"C","text":"me"},{"key":"D","text":"my"}],"answer":"B","explanation":"mine = my shoes。","verify":"\"mine\""},{"id":"cne_j247_q3","topicId":"cne_j247","difficulty":"standard","type":"choice","prompt":"The red bag is ____. 红包是她的。","choices":[{"key":"A","text":"hers'"},{"key":"B","text":"hers"},{"key":"C","text":"her"},{"key":"D","text":"she"}],"answer":"B","explanation":"句末单独用 hers。","verify":"\"hers\""},{"id":"cne_j247_q4","topicId":"cne_j247","difficulty":"standard","type":"choice","prompt":"哪一句正确？","choices":[{"key":"A","text":"Our club is bigger than their."},{"key":"B","text":"Our club is bigger than theirs."},{"key":"C","text":"Ours club is bigger than theirs."},{"key":"D","text":"Our club is bigger than them club."}],"answer":"B","explanation":"theirs = their club。","verify":"\"Our club is bigger than theirs.\""}]
