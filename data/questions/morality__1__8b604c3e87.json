[{"id":"cnd_p009_q1","topicId":"cnd_p009","difficulty":"basic","type":"choice","prompt":"比较合理的作息是？","choices":[{"key":"A","text":"熬夜看动画第二天补觉"},{"key":"B","text":"周末通宵"},{"key":"C","text":"按时睡觉起床，保证充足睡眠"},{"key":"D","text":"想睡就睡"}],"answer":"C","explanation":"规律作息有益健康。","verify":"\"按时睡觉起床，保证充足睡眠\""},{"id":"cnd_p009_q2","topicId":"cnd_p009","difficulty":"basic","type":"choice","prompt":"作业写到很晚，较好调整是？","choices":[{"key":"A","text":"继续熬到凌晨"},{"key":"B","text":"不写作业直接睡"},{"key":"C","text":"边玩手机边写"},{"key":"D","text":"提高效率，到点睡觉"}],"answer":"D","explanation":"要保证睡眠。","verify":"\"提高效率，到点睡觉\""},{"id":"cnd_p009_q3","topicId":"cnd_p009","difficulty":"standard","type":"choice","prompt":"早上磨蹭导致迟到，应怎么改？","choices":[{"key":"A","text":"提前准备书包，定好闹钟"},{"key":"B","text":"继续磨蹭怪闹钟"},{"key":"C","text":"让爸妈背着走"},{"key":"D","text":"干脆不上学"}],"answer":"A","explanation":"提前准备可避免迟到。","verify":"\"提前准备书包，定好闹钟\""},{"id":"cnd_p009_q4","topicId":"cnd_p009","difficulty":"challenge","type":"choice","prompt":"为什么作息要有规律？","choices":[{"key":"A","text":"规律作息没好处"},{"key":"B","text":"身体和精神更好，学习更有精神"},{"key":"C","text":"只是听大人的话"},{"key":"D","text":"作息乱更自由"}],"answer":"B","explanation":"规律作息提高效率。","verify":"\"身体和精神更好，学习更有精神\""},{"id":"cnd_p010_q1","topicId":"cnd_p010","difficulty":"basic","type":"choice","prompt":"吃饭时较好的习惯是？","choices":[{"key":"A","text":"只吃肉不吃菜"},{"key":"B","text":"边走边吃洒一地"},{"key":"C","text":"不爱吃的全倒掉"},{"key":"D","text":"细嚼慢咽，不挑食，不浪费"}],"answer":"D","explanation":"均衡饮食、不浪费。","verify":"\"细嚼慢咽，不挑食，不浪费\""},{"id":"cnd_p010_q2","topicId":"cnd_p010","difficulty":"basic","type":"choice","prompt":"饭前应该做什么？","choices":[{"key":"A","text":"洗手"},{"key":"B","text":"摸完泥再吃"},{"key":"C","text":"用袖子擦嘴开吃"},{"key":"D","text":"把筷子含嘴里玩"}],"answer":"A","explanation":"饭前洗手更卫生。","verify":"\"洗手\""},{"id":"cnd_p010_q3","topicId":"cnd_p010","difficulty":"standard","type":"choice","prompt":"同学剩很多饭，较好提醒是？","choices":[{"key":"A","text":"当众嘲笑"},{"key":"B","text":"提醒他适量盛饭、珍惜粮食"},{"key":"C","text":"把饭倒他头上"},{"key":"D","text":"再给他盛满"}],"answer":"B","explanation":"珍惜粮食，适量盛饭。","verify":"\"提醒他适量盛饭、珍惜粮食\""},{"id":"cnd_p010_q4","topicId":"cnd_p010","difficulty":"challenge","type":"choice","prompt":"为什么吃饭要有讲究？","choices":[{"key":"A","text":"只为快点填饱"},{"key":"B","text":"吃得越油越好"},{"key":"C","text":"营养均衡、饮食卫生，身体才好"},{"key":"D","text":"不吃蔬菜也没关系"}],"answer":"C","explanation":"合理饮食关乎健康。","verify":"\"营养均衡、饮食卫生，身体才好\""},{"id":"cnd_p011_q1","topicId":"cnd_p011","difficulty":"basic","type":"choice","prompt":"见到长辈，有礼貌的做法是？","choices":[{"key":"A","text":"主动问好"},{"key":"B","text":"低头走过"},{"key":"C","text":"直呼名字取乐"},{"key":"D","text":"抢话打断"}],"answer":"A","explanation":"主动问好是基本礼貌。","verify":"\"主动问好\""},{"id":"cnd_p011_q2","topicId":"cnd_p011","difficulty":"basic","type":"choice","prompt":"接受帮助后应说？","choices":[{"key":"A","text":"活该"},{"key":"B","text":"谢谢"},{"key":"C","text":"用不着你"},{"key":"D","text":"哼"}],"answer":"B","explanation":"接受帮助要致谢。","verify":"\"谢谢\""},{"id":"cnd_p011_q3","topicId":"cnd_p011","difficulty":"standard","type":"choice","prompt":"不小心碰到别人，应？","choices":[{"key":"A","text":"装作没看见跑开"},{"key":"B","text":"反过来说对方挡路"},{"key":"C","text":"说对不起并关心对方"},{"key":"D","text":"大声责怪"}],"answer":"C","explanation":"碰到人要道歉。","verify":"\"说对不起并关心对方\""},{"id":"cnd_p011_q4","topicId":"cnd_p011","difficulty":"challenge","type":"choice","prompt":"为什么要有礼貌？","choices":[{"key":"A","text":"礼貌只是做样子"},{"key":"B","text":"没礼貌没关系"},{"key":"C","text":"只对老师要礼貌"},{"key":"D","text":"交往更友好，别人更愿帮助你"}],"answer":"D","explanation":"礼貌是友好相处的基础。","verify":"\"交往更友好，别人更愿帮助你\""},{"id":"cnd_p012_q1","topicId":"cnd_p012","difficulty":"basic","type":"choice","prompt":"一起玩时正确做法是？","choices":[{"key":"A","text":"只许自己玩"},{"key":"B","text":"遵守规则，轮流分享"},{"key":"C","text":"输了就掀棋盘"},{"key":"D","text":"弄坏别人玩具"}],"answer":"B","explanation":"玩也要守规则、会分享。","verify":"\"遵守规则，轮流分享\""},{"id":"cnd_p012_q2","topicId":"cnd_p012","difficulty":"basic","type":"choice","prompt":"下面哪种玩法不安全？","choices":[{"key":"A","text":"公园里跳绳"},{"key":"B","text":"家里搭积木"},{"key":"C","text":"在马路边追跑打闹"},{"key":"D","text":"教室安静看书"}],"answer":"C","explanation":"马路边追逐危险。","verify":"\"在马路边追跑打闹\""},{"id":"cnd_p012_q3","topicId":"cnd_p012","difficulty":"standard","type":"choice","prompt":"玩的时间到了该回家，应？","choices":[{"key":"A","text":"继续玩不理家长"},{"key":"B","text":"玩具扔一地"},{"key":"C","text":"和家长吵架"},{"key":"D","text":"收拾玩具按时回家"}],"answer":"D","explanation":"玩也要守时并收拾。","verify":"\"收拾玩具按时回家\""},{"id":"cnd_p012_q4","topicId":"cnd_p012","difficulty":"challenge","type":"choice","prompt":"为什么说玩也有学问？","choices":[{"key":"A","text":"会玩才能开心又安全、不影响别人"},{"key":"B","text":"玩就该毫无规矩"},{"key":"C","text":"玩时可欺负弱小"},{"key":"D","text":"玩和学习无关"}],"answer":"A","explanation":"会选择、会合作、注意安全。","verify":"\"会玩才能开心又安全、不影响别人\""}]
