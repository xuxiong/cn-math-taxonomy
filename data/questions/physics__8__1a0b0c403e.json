[{"id":"cnp_001_q1","topicId":"cnp_001","difficulty":"basic","type":"choice","prompt":"长度的国际单位是什么？","choices":[{"key":"A","text":"厘米（cm）"},{"key":"B","text":"千米（km）"},{"key":"C","text":"秒（s）"},{"key":"D","text":"米（m）"}],"answer":"D","explanation":"国际单位制中长度的基本单位是米，符号 m；秒是时间单位。","verify":"\"米（m）\""},{"id":"cnp_001_q2","topicId":"cnp_001","difficulty":"basic","type":"choice","prompt":"1.5 h 等于多少分钟？","choices":[{"key":"A","text":"150 min"},{"key":"B","text":"90 min"},{"key":"C","text":"15 min"},{"key":"D","text":"1.5 min"}],"answer":"B","explanation":"1 h = 60 min，1.5 × 60 = 90 min。把 1.5 h 当成 1 h 50 min 是常见错误。","verify":"1.5*60"},{"id":"cnp_001_q3","topicId":"cnp_001","difficulty":"standard","type":"choice","prompt":"用分度值为 1 mm 的刻度尺测一支铅笔，下列记录中正确的是哪一个？","choices":[{"key":"A","text":"17.5 cm"},{"key":"B","text":"17.520 cm"},{"key":"C","text":"175 mm"},{"key":"D","text":"17.52 cm"}],"answer":"D","explanation":"分度值 1 mm = 0.1 cm，读数要估读到分度值的下一位，即 0.01 cm，所以记成 17.52 cm。","verify":"\"17.52 cm\""},{"id":"cnp_001_q4","topicId":"cnp_001","difficulty":"standard","type":"numeric","prompt":"四次测得同一本书的宽度分别为 18.52 cm、18.51 cm、18.53 cm、18.52 cm，取平均值作为结果是多少 cm？（只填数值）","answer":"18.52","explanation":"(18.52+18.51+18.53+18.52)÷4 = 18.52 cm。多次测量取平均值可以减小误差。","verify":"(18.52+18.51+18.53+18.52)/4"}]
