[{"id":"cnm_009_q1","topicId":"cnm_009","difficulty":"basic","type":"choice","prompt":"比较 -2/3 与 -3/4 的大小。（选择正确结论）","choices":[{"key":"A","text":"-2/3 > -3/4"},{"key":"B","text":"-2/3 < -3/4"},{"key":"C","text":"-2/3 = -3/4"}],"answer":"A","explanation":"两个负数比较，绝对值大的反而小。2/3=8/12 小于 3/4=9/12，所以 -2/3 > -3/4。"},{"id":"cnm_009_q2","topicId":"cnm_009","difficulty":"basic","type":"numeric","prompt":"在 -5，-1，0，3 这四个数中，最小的数是多少？","answer":"-5","explanation":"负数小于 0 小于正数；两个负数中绝对值大的反而小，|-5|>|-1|，所以 -5 最小。","verify":"min([-5,-1,0,3])"},{"id":"cnm_009_q3","topicId":"cnm_009","difficulty":"standard","type":"numeric","prompt":"把 -1.2，0，-2，3/2，-1/2 按从小到大的顺序排列，排在第三位的数是多少？","answer":"-1/2","explanation":"从小到大依次是 -2，-1.2，-1/2，0，3/2，第三个是 -1/2。","verify":"sorted([Fraction(-6,5),0,-2,Fraction(3,2),Fraction(-1,2)])[2]"},{"id":"cnm_009_q4","topicId":"cnm_009","difficulty":"standard","type":"choice","prompt":"下列各式中，大小关系正确的是哪一个？","choices":[{"key":"A","text":"-3 > -2"},{"key":"B","text":"|-5| < |3|"},{"key":"C","text":"-|-4| < -3"},{"key":"D","text":"-1/2 < -2/3"}],"answer":"C","explanation":"-|-4|=-4，-4 < -3 正确；-3 < -2；|-5|=5 > 3；-1/2=-3/6 > -4/6=-2/3。"}]
