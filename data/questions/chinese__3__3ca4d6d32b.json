[{"id":"cnc_p163_q1","topicId":"cnc_p163","difficulty":"basic","type":"choice","prompt":"「湖光秋月两相和」的下一句是哪一句？","choices":[{"key":"A","text":"潭面无风镜未磨"},{"key":"B","text":"遥望洞庭山水翠"},{"key":"C","text":"白银盘里一青螺"},{"key":"D","text":"潭面无风镜已磨"}],"answer":"A","explanation":"湖光和秋月融在一起，后面才写无风的湖面像没有磨过的铜镜。","verify":"\"潭面无风镜未磨\""},{"id":"cnc_p163_q2","topicId":"cnc_p163","difficulty":"basic","type":"choice","prompt":"「遥望洞庭山水翠」的下一句是哪一句？","choices":[{"key":"A","text":"潭面无风镜未磨"},{"key":"B","text":"白银盘里一青螺"},{"key":"C","text":"孤帆一片日边来"},{"key":"D","text":"淡妆浓抹总相宜"}],"answer":"B","explanation":"远远望去，山水苍翠。下一句才把湖和山比成银盘和青螺。孤帆是《望天门山》里的，淡妆浓抹是写西湖的。","verify":"\"白银盘里一青螺\""},{"id":"cnc_p163_q3","topicId":"cnc_p163","difficulty":"standard","type":"choice","prompt":"《望洞庭》的作者是谁？","choices":[{"key":"A","text":"李白"},{"key":"B","text":"苏轼"},{"key":"C","text":"刘禹锡"},{"key":"D","text":"杜牧"}],"answer":"C","explanation":"《望洞庭》是刘禹锡的诗。李白写《望天门山》，苏轼写西湖，杜牧写《山行》。","verify":"\"刘禹锡\""},{"id":"cnc_p163_q4","topicId":"cnc_p163","difficulty":"standard","type":"choice","prompt":"「白银盘里一青螺」把什么比作了青螺？","choices":[{"key":"A","text":"整个洞庭湖面"},{"key":"B","text":"天上的秋月"},{"key":"C","text":"一艘渔船"},{"key":"D","text":"洞庭湖里的君山"}],"answer":"D","explanation":"白银盘比喻平静的湖面，青螺比喻湖中的君山。秋月写在第一句，不是这只青螺。","verify":"\"洞庭湖里的君山\""},{"id":"cnc_p164_q1","topicId":"cnc_p164","difficulty":"basic","type":"choice","prompt":"「远上寒山石径斜」的下一句是哪一句？","choices":[{"key":"A","text":"停车坐爱枫林晚"},{"key":"B","text":"白云生处有人家"},{"key":"C","text":"霜叶红于二月花"},{"key":"D","text":"白云深处有人家"}],"answer":"B","explanation":"统编教材这句是「白云生处有人家」。停车、霜叶是后两句。","verify":"\"白云生处有人家\""},{"id":"cnc_p164_q2","topicId":"cnc_p164","difficulty":"basic","type":"choice","prompt":"「停车坐爱枫林晚」的下一句是哪一句？","choices":[{"key":"A","text":"白云生处有人家"},{"key":"B","text":"霜叶红如二月花"},{"key":"C","text":"霜叶红于二月花"},{"key":"D","text":"远上寒山石径斜"}],"answer":"C","explanation":"因为爱这傍晚的枫林，才停下车。下一句才写霜叶比二月的花还红。","verify":"\"霜叶红于二月花\""},{"id":"cnc_p164_q3","topicId":"cnc_p164","difficulty":"standard","type":"choice","prompt":"《山行》的作者是谁？","choices":[{"key":"A","text":"杜甫"},{"key":"B","text":"李白"},{"key":"C","text":"苏轼"},{"key":"D","text":"杜牧"}],"answer":"D","explanation":"《山行》是杜牧的诗。杜甫写过《绝句》，不要只看姓杜就记成同一个人。","verify":"\"杜牧\""},{"id":"cnc_p164_q4","topicId":"cnc_p164","difficulty":"standard","type":"choice","prompt":"「停车坐爱枫林晚」的「坐」在这里是什么意思？","choices":[{"key":"A","text":"因为"},{"key":"B","text":"坐下"},{"key":"C","text":"座位"},{"key":"D","text":"乘坐"}],"answer":"A","explanation":"坐在这首诗里是因为。诗人因为喜爱枫林晚景才停车。","verify":"\"因为\""},{"id":"cnc_p165_q1","topicId":"cnc_p165","difficulty":"basic","type":"choice","prompt":"「萧萧梧叶送寒声」的下一句是哪一句？","choices":[{"key":"A","text":"知有儿童挑促织"},{"key":"B","text":"夜深篱落一灯明"},{"key":"C","text":"江上秋风动客情"},{"key":"D","text":"江上秋风动客愁"}],"answer":"C","explanation":"梧叶带来寒意，秋风牵动了旅人想家的心情。挑促织、一灯明是后两句。","verify":"\"江上秋风动客情\""},{"id":"cnc_p165_q2","topicId":"cnc_p165","difficulty":"basic","type":"choice","prompt":"「知有儿童挑促织」的下一句是哪一句？","choices":[{"key":"A","text":"江上秋风动客情"},{"key":"B","text":"夜深篱落一灯灭"},{"key":"C","text":"霜叶红于二月花"},{"key":"D","text":"夜深篱落一灯明"}],"answer":"D","explanation":"儿童在捉蟋蟀，篱笆边有一盏灯。霜叶是《山行》里的句子。","verify":"\"夜深篱落一灯明\""},{"id":"cnc_p165_q3","topicId":"cnc_p165","difficulty":"standard","type":"choice","prompt":"《夜书所见》的作者是谁？","choices":[{"key":"A","text":"叶绍翁"},{"key":"B","text":"陆游"},{"key":"C","text":"杨万里"},{"key":"D","text":"杜牧"}],"answer":"A","explanation":"《夜书所见》是叶绍翁的诗。杜牧写《山行》，杨万里写的是西湖荷花。","verify":"\"叶绍翁\""},{"id":"cnc_p165_q4","topicId":"cnc_p165","difficulty":"standard","type":"choice","prompt":"「促织」在这首诗里指什么？","choices":[{"key":"A","text":"织布的布匹"},{"key":"B","text":"蟋蟀"},{"key":"C","text":"枫叶"},{"key":"D","text":"梧桐树"}],"answer":"B","explanation":"挑促织就是捉蟋蟀。灯在篱笆边亮着，诗人因此知道有孩子在捉。","verify":"\"蟋蟀\""},{"id":"cnc_p166_q1","topicId":"cnc_p166","difficulty":"basic","type":"choice","prompt":"水泥道上铺满的是什么？","choices":[{"key":"A","text":"金色的雪"},{"key":"B","text":"银杏叶做的小扇子"},{"key":"C","text":"海滩上的贝壳"},{"key":"D","text":"梧桐树的落叶，像一只只金色的巴掌"}],"answer":"D","explanation":"法国梧桐的叶子落下来，平展地贴在道上，所以说像巴掌。小扇子是《秋天的雨》里的银杏叶。","verify":"\"梧桐树的落叶，像一只只金色的巴掌\""},{"id":"cnc_p166_q2","topicId":"cnc_p166","difficulty":"basic","type":"choice","prompt":"「我」出门上学时，天气怎样了？","choices":[{"key":"A","text":"下过雨，天开始放晴"},{"key":"B","text":"还在下大雪"},{"key":"C","text":"从早到晚没有一丝风和雨"},{"key":"D","text":"天还是半夜"}],"answer":"A","explanation":"一夜秋风、一夜秋雨之后，上学时天放晴了，道上才留下那些湿润的落叶。","verify":"\"下过雨，天开始放晴\""},{"id":"cnc_p166_q3","topicId":"cnc_p166","difficulty":"standard","type":"choice","prompt":"「我」穿的雨靴是什么颜色？走路时怎样？","choices":[{"key":"A","text":"白色。闭着眼睛跑"},{"key":"B","text":"棕红色。小心地走，还一片一片数着落叶"},{"key":"C","text":"蓝色。把叶子全部扫进沟里"},{"key":"D","text":"没有穿鞋，专把叶子踩烂"}],"answer":"B","explanation":"棕红色的小雨靴像两只小鸟，在金色的叶子中间蹦跳。他是在看、在数，不是在糟蹋叶子。","verify":"\"棕红色。小心地走，还一片一片数着落叶\""},{"id":"cnc_p166_q4","topicId":"cnc_p166","difficulty":"standard","type":"choice","prompt":"他拾起的第一片落叶怎样处理？","choices":[{"key":"A","text":"扔进池塘"},{"key":"B","text":"贴到海滩上"},{"key":"C","text":"珍藏进书包里"},{"key":"D","text":"当场烧掉"}],"answer":"C","explanation":"他觉得这片叶子好看，就放进书包，好好留着。","verify":"\"珍藏进书包里\""},{"id":"cnc_p167_q1","topicId":"cnc_p167","difficulty":"basic","type":"choice","prompt":"课文把秋天的雨比作什么？","choices":[{"key":"A","text":"一把钥匙"},{"key":"B","text":"一个太阳"},{"key":"C","text":"一只灰雀"},{"key":"D","text":"一条小船"}],"answer":"A","explanation":"秋天的雨，是一把钥匙，把秋天的大门打开了。","verify":"\"一把钥匙\""},{"id":"cnc_p167_q2","topicId":"cnc_p167","difficulty":"basic","type":"choice","prompt":"银杏和枫叶在课文里各是什么颜色？","choices":[{"key":"A","text":"银杏是红色的，枫叶是黄色的"},{"key":"B","text":"银杏是黄色的，枫叶是红色的"},{"key":"C","text":"两种都是绿色"},{"key":"D","text":"两种都变成了白色"}],"answer":"B","explanation":"黄色的银杏叶像小扇子，红色的枫叶像邮票。","verify":"\"银杏是黄色的，枫叶是红色的\""},{"id":"cnc_p167_q3","topicId":"cnc_p167","difficulty":"standard","type":"choice","prompt":"秋天的雨带给大地哪些气味？","choices":[{"key":"A","text":"只有火药味"},{"key":"B","text":"大海的咸味"},{"key":"C","text":"菠萝和梨那样香甜的气味"},{"key":"D","text":"冬天的冰味"}],"answer":"C","explanation":"课文写果子熟了，有菠萝甜甜的、梨子香香的气味。","verify":"\"菠萝和梨那样香甜的气味\""},{"id":"cnc_p167_q4","topicId":"cnc_p167","difficulty":"standard","type":"choice","prompt":"「轻轻地，轻轻地」是在写雨的什么特点？","choices":[{"key":"A","text":"雨下得又急又响"},{"key":"B","text":"雨把大门砸坏了"},{"key":"C","text":"雨只在夜里吼叫"},{"key":"D","text":"它安静、温柔地把秋天带来"}],"answer":"D","explanation":"秋天的雨是一把钥匙，它轻轻地打开大门，带着清凉和温柔。","verify":"\"它安静、温柔地把秋天带来\""},{"id":"cnc_p168_q1","topicId":"cnc_p168","difficulty":"basic","type":"choice","prompt":"「刷刷」在诗里是什么声音？","choices":[{"key":"A","text":"蟋蟀振动翅膀"},{"key":"B","text":"大树抖抖手臂，黄叶在道别"},{"key":"C","text":"海浪拍打沙滩"},{"key":"D","text":"石头砸破水缸"}],"answer":"B","explanation":"黄叶离开树枝，说出道别的话。蟋蟀的声音是后面的「瞿瞿」。","verify":"\"大树抖抖手臂，黄叶在道别\""},{"id":"cnc_p168_q2","topicId":"cnc_p168","difficulty":"basic","type":"choice","prompt":"蟋蟀的「瞿瞿」被写成什么？","choices":[{"key":"A","text":"黄叶道别的话音"},{"key":"B","text":"大雁暖暖的叮咛"},{"key":"C","text":"和阳台告别的歌韵"},{"key":"D","text":"丰收的歌吟"}],"answer":"C","explanation":"蟋蟀振动翅膀，是在跟阳台告别。叮咛是大雁的，歌吟是秋风送来的。","verify":"\"和阳台告别的歌韵\""},{"id":"cnc_p168_q3","topicId":"cnc_p168","difficulty":"standard","type":"choice","prompt":"大雁和秋风各带来什么？","choices":[{"key":"A","text":"两个都没有声音"},{"key":"B","text":"大雁送来枫叶，秋风只把湖面吹破"},{"key":"C","text":"秋风在唱蟋蟀的歌，大雁在道别"},{"key":"D","text":"大雁撒下叮咛，秋风送来一片丰收的歌吟"}],"answer":"D","explanation":"一排排大雁追着白云，一阵阵秋风掠过田野。它们的声音不一样。","verify":"\"大雁撒下叮咛，秋风送来一片丰收的歌吟\""},{"id":"cnc_p168_q4","topicId":"cnc_p168","difficulty":"standard","type":"choice","prompt":"诗里说，秋的声音还可以到哪里去听？","choices":[{"key":"A","text":"每一片叶子、每一朵小花、每一滴汗水、每一颗谷粒里"},{"key":"B","text":"只有乐器里才有"},{"key":"C","text":"只有夏天的蝉鸣里"},{"key":"D","text":"秋天没有可以听的声音"}],"answer":"A","explanation":"落叶、花、汗水和成熟的谷粒里都有秋的声音。最后一句请大家去听。","verify":"\"每一片叶子、每一朵小花、每一滴汗水、每一颗谷粒里\""},{"id":"cnc_p169_q1","topicId":"cnc_p169","difficulty":"basic","type":"choice","prompt":"一篇日记，第一行通常先写什么？","choices":[{"key":"A","text":"只写一个感叹号"},{"key":"B","text":"先写结尾"},{"key":"C","text":"日期、星期和天气"},{"key":"D","text":"先写别人没看见的想象"}],"answer":"C","explanation":"先让人知道是哪一天、星期几、天气怎样，再写这一天的事。","verify":"\"日期、星期和天气\""},{"id":"cnc_p169_q2","topicId":"cnc_p169","difficulty":"basic","type":"choice","prompt":"哪一种写法更像日记？","choices":[{"key":"A","text":"叶子很好看。"},{"key":"B","text":"我没出门，但我觉得天下了雨。"},{"key":"C","text":"叶子。"},{"key":"D","text":"十月八日 星期一 晴。水泥道上铺满梧桐叶，我捡起一片放进了书包。"}],"answer":"D","explanation":"要写出这一天实际看到的事。只写「很好看」，别人不知道你看见了什么。","verify":"\"十月八日 星期一 晴。水泥道上铺满梧桐叶，我捡起一片放进了书包。\""},{"id":"cnc_p169_q3","topicId":"cnc_p169","difficulty":"standard","type":"choice","prompt":"日记里写看到的事，最好怎样写？","choices":[{"key":"A","text":"按先后记下这一天真正看到的和想到的"},{"key":"B","text":"只写「很好」两个字"},{"key":"C","text":"把没看见的写成看见了"},{"key":"D","text":"不写日期，让人看不出是哪一天"}],"answer":"A","explanation":"日记要真实，也要看得出先后。没有看见的事，不能写成自己的见闻。","verify":"\"按先后记下这一天真正看到的和想到的\""},{"id":"cnc_p169_q4","topicId":"cnc_p169","difficulty":"standard","type":"choice","prompt":"哪一种内容不适合写进日记？","choices":[{"key":"A","text":"今天的雨把落叶打湿了"},{"key":"B","text":"自己根本没有看到，却写成看到了"},{"key":"C","text":"我把一片叶子夹进了书里"},{"key":"D","text":"放学时天放晴了"}],"answer":"B","explanation":"打湿的叶子、夹进书里、天放晴，都是可以写的见闻。没看到却写成看到了，就不是日记。","verify":"\"自己根本没有看到，却写成看到了\""},{"id":"cnc_p170_q1","topicId":"cnc_p170","difficulty":"basic","type":"choice","prompt":"哪一个是 ABB 式词语？","choices":[{"key":"A","text":"整整齐齐"},{"key":"B","text":"高低"},{"key":"C","text":"绿油"},{"key":"D","text":"绿油油"}],"answer":"D","explanation":"绿油油是一个字后面叠两个相同的字。整整齐齐是 AABB。","verify":"\"绿油油\""},{"id":"cnc_p170_q2","topicId":"cnc_p170","difficulty":"basic","type":"choice","prompt":"哪一个是 AABB 式词语？","choices":[{"key":"A","text":"整整齐齐"},{"key":"B","text":"红彤彤"},{"key":"C","text":"整齐齐"},{"key":"D","text":"齐整整齐"}],"answer":"A","explanation":"整齐重叠成整整齐齐。红彤彤是 ABB。","verify":"\"整整齐齐\""},{"id":"cnc_p170_q3","topicId":"cnc_p170","difficulty":"standard","type":"choice","prompt":"「绿油油」常用来写什么？","choices":[{"key":"A","text":"很绿的石头"},{"key":"B","text":"很绿的草地或叶子"},{"key":"C","text":"很绿的雪"},{"key":"D","text":"很绿的墨水"}],"answer":"B","explanation":"绿油油形容植物绿得新鲜、绿得可爱。","verify":"\"很绿的草地或叶子\""},{"id":"cnc_p170_q4","topicId":"cnc_p170","difficulty":"standard","type":"choice","prompt":"哪一个词语写对了？","choices":[{"key":"A","text":"讨论得热闹闹"},{"key":"B","text":"讨论得热热热闹"},{"key":"C","text":"讨论得热热闹闹"},{"key":"D","text":"讨论得闹热热热"}],"answer":"C","explanation":"热闹重叠成热热闹闹。不能少字，也不能把顺序打乱。","verify":"\"讨论得热热闹闹\""}]
