[{"id":"cnp_046_q1","topicId":"cnp_046","difficulty":"basic","type":"choice","prompt":"功率是表示什么的物理量？","choices":[{"key":"A","text":"做功多少"},{"key":"B","text":"做功快慢"},{"key":"C","text":"力的大小"},{"key":"D","text":"能量多少"}],"answer":"B","explanation":"功率表示做功的快慢，做功多不一定功率大。","verify":"\"做功快慢\""},{"id":"cnp_046_q2","topicId":"cnp_046","difficulty":"basic","type":"numeric","prompt":"起重机在 10 s 内做了 5×10⁴ J 的功，它的功率是多少 W？（只填数值）","answer":"5000","explanation":"P = W/t = 50000 ÷ 10 = 5000 W。","verify":"5e4/10"},{"id":"cnp_046_q3","topicId":"cnp_046","difficulty":"standard","type":"choice","prompt":"汽车上坡时司机通常换低速挡，目的是什么？","choices":[{"key":"A","text":"增大功率"},{"key":"B","text":"节省燃油"},{"key":"C","text":"功率一定时，减小速度来增大牵引力"},{"key":"D","text":"增大速度"}],"answer":"C","explanation":"由 P = Fv，功率一定时速度越小牵引力越大。","verify":"\"功率一定时，减小速度来增大牵引力\""},{"id":"cnp_046_q4","topicId":"cnp_046","difficulty":"standard","type":"numeric","prompt":"汽车以 20 m/s 的速度匀速行驶，牵引力为 3000 N，发动机的功率是多少 W？（只填数值）","answer":"60000","explanation":"P = Fv = 3000 × 20 = 60000 W。","verify":"3000*20"}]
