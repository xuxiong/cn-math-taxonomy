[{"id":"cne_p199_q1","topicId":"cne_p199","difficulty":"basic","type":"choice","prompt":"I ____ go to bed before 9:30. 我得九点半前睡觉。","choices":[{"key":"A","text":"can"},{"key":"B","text":"have to"},{"key":"C","text":"has to"},{"key":"D","text":"am"}],"answer":"B","explanation":"主语是 I，用 have to。","verify":"\"have to\""},{"id":"cne_p199_q2","topicId":"cne_p199","difficulty":"basic","type":"choice","prompt":"「我们不能在床上吃东西」哪一句正确？","choices":[{"key":"A","text":"We can eat in bed."},{"key":"B","text":"We don't can eat in bed."},{"key":"C","text":"We can't eats in bed."},{"key":"D","text":"We can't eat in bed."}],"answer":"D","explanation":"can't 后面接动词原形。","verify":"\"We can't eat in bed.\""},{"id":"cne_p199_q3","topicId":"cne_p199","difficulty":"standard","type":"choice","prompt":"He ____ help with the dishes. 他得帮忙洗碗。","choices":[{"key":"A","text":"have to"},{"key":"B","text":"haves to"},{"key":"C","text":"has to"},{"key":"D","text":"have"}],"answer":"C","explanation":"主语 he 是第三人称单数，用 has to。","verify":"\"has to\""},{"id":"cne_p199_q4","topicId":"cne_p199","difficulty":"standard","type":"choice","prompt":"哪一条是家规？","choices":[{"key":"A","text":"I like apples."},{"key":"B","text":"Clean your room on Saturdays."},{"key":"C","text":"It is sunny today."},{"key":"D","text":"She is my sister."}],"answer":"B","explanation":"说要做什么的祈使句才是规矩。","verify":"\"Clean your room on Saturdays.\""},{"id":"cne_p229_q1","topicId":"cne_p229","difficulty":"basic","type":"choice","prompt":"「整理床铺」用哪一组词？","choices":[{"key":"A","text":"make the bed"},{"key":"B","text":"do homework"},{"key":"C","text":"go to bed"},{"key":"D","text":"keep quiet"}],"answer":"A","explanation":"make the bed 是整理床铺。","verify":"\"make the bed\""},{"id":"cne_p229_q2","topicId":"cne_p229","difficulty":"basic","type":"choice","prompt":"keep quiet 的意思是？","choices":[{"key":"A","text":"早睡"},{"key":"B","text":"做家务"},{"key":"C","text":"起床"},{"key":"D","text":"保持安静"}],"answer":"D","explanation":"keep quiet 是保持安静。","verify":"\"保持安静\""},{"id":"cne_p229_q3","topicId":"cne_p229","difficulty":"standard","type":"choice","prompt":"「早睡」用哪一组？","choices":[{"key":"A","text":"make the bed"},{"key":"B","text":"watch TV late"},{"key":"C","text":"go to bed early"},{"key":"D","text":"get up late"}],"answer":"C","explanation":"go to bed early。","verify":"\"go to bed early\""},{"id":"cne_p229_q4","topicId":"cne_p229","difficulty":"standard","type":"choice","prompt":"do housework 是在说什么？","choices":[{"key":"A","text":"做运动"},{"key":"B","text":"做家务"},{"key":"C","text":"做作业"},{"key":"D","text":"做游戏"}],"answer":"B","explanation":"housework 是家务。","verify":"\"做家务\""},{"id":"cne_p230_q1","topicId":"cne_p230","difficulty":"basic","type":"choice","prompt":"想说「我必须早睡」，应选哪一句？","choices":[{"key":"A","text":"I have to go to bed early."},{"key":"B","text":"I have go to bed early."},{"key":"C","text":"I has to go to bed early."},{"key":"D","text":"I have to going to bed early."}],"answer":"A","explanation":"have to + 动词原形。","verify":"\"I have to go to bed early.\""},{"id":"cne_p230_q2","topicId":"cne_p230","difficulty":"basic","type":"choice","prompt":"I can't watch TV late. 这句家规是？","choices":[{"key":"A","text":"必须很晚看电视"},{"key":"B","text":"可以不整理床铺"},{"key":"C","text":"必须大声说话"},{"key":"D","text":"不能很晚看电视"}],"answer":"D","explanation":"can't 表示不能。","verify":"\"不能很晚看电视\""},{"id":"cne_p230_q3","topicId":"cne_p230","difficulty":"standard","type":"choice","prompt":"哪一句表示「不必」？","choices":[{"key":"A","text":"I can't cook today."},{"key":"B","text":"I must cook today."},{"key":"C","text":"I don't have to cook today."},{"key":"D","text":"I have to cook today."}],"answer":"C","explanation":"don't have to 是不必。","verify":"\"I don't have to cook today.\""},{"id":"cne_p230_q4","topicId":"cne_p230","difficulty":"standard","type":"choice","prompt":"At home I ____ make the bed.","choices":[{"key":"A","text":"having to"},{"key":"B","text":"have to"},{"key":"C","text":"have"},{"key":"D","text":"has to"}],"answer":"B","explanation":"I 后用 have to。","verify":"\"have to\""},{"id":"cne_p231_q1","topicId":"cne_p231","difficulty":"basic","type":"choice","prompt":"读一读：I have to make the bed. I can't play football inside. 我必须做什么？","choices":[{"key":"A","text":"整理床铺"},{"key":"B","text":"在屋里踢球"},{"key":"C","text":"晚睡"},{"key":"D","text":"大声说话"}],"answer":"A","explanation":"have to make the bed。","verify":"\"整理床铺\""},{"id":"cne_p231_q2","topicId":"cne_p231","difficulty":"basic","type":"choice","prompt":"读一读：We have to keep quiet at night. 晚上要怎样？","choices":[{"key":"A","text":"大声唱歌"},{"key":"B","text":"踢足球"},{"key":"C","text":"开派对"},{"key":"D","text":"保持安静"}],"answer":"D","explanation":"keep quiet。","verify":"\"保持安静\""},{"id":"cne_p231_q3","topicId":"cne_p231","difficulty":"standard","type":"choice","prompt":"读一读：Tom has to do housework. He can't watch TV before homework. 哪一句一致？","choices":[{"key":"A","text":"他可以先看电视。"},{"key":"B","text":"他没有家规。"},{"key":"C","text":"做完作业前不能看电视。"},{"key":"D","text":"他不必做家务。"}],"answer":"C","explanation":"can't watch TV before homework。","verify":"\"做完作业前不能看电视。\""},{"id":"cne_p231_q4","topicId":"cne_p231","difficulty":"standard","type":"choice","prompt":"读一读：I don't have to cook, but I have to wash the dishes. 我必须做什么？","choices":[{"key":"A","text":"看电视"},{"key":"B","text":"洗碗"},{"key":"C","text":"做饭"},{"key":"D","text":"不必洗碗"}],"answer":"B","explanation":"have to wash the dishes。","verify":"\"洗碗\""}]
