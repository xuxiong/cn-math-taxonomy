[{"id":"cng_j007_q1","topicId":"cng_j007","difficulty":"basic","type":"choice","prompt":"地球表面海洋与陆地面积大约是？","choices":[{"key":"A","text":"海洋约 71%，陆地约 29%"},{"key":"B","text":"各占一半"},{"key":"C","text":"陆地约 71%，海洋约 29%"},{"key":"D","text":"海洋约 90%，陆地约 10%"}],"answer":"A","explanation":"全球约十分之七是海洋，十分之三是陆地。","verify":"\"海洋约 71%，陆地约 29%\""},{"id":"cng_j007_q2","topicId":"cng_j007","difficulty":"basic","type":"choice","prompt":"面积最大的大洲是？","choices":[{"key":"A","text":"非洲"},{"key":"B","text":"亚洲"},{"key":"C","text":"南极洲"},{"key":"D","text":"欧洲"}],"answer":"B","explanation":"亚洲是世界第一大洲，面积约 4400 万平方千米。","verify":"\"亚洲\""},{"id":"cng_j007_q3","topicId":"cng_j007","difficulty":"standard","type":"choice","prompt":"亚洲与非洲的分界线是？","choices":[{"key":"A","text":"巴拿马运河"},{"key":"B","text":"白令海峡"},{"key":"C","text":"苏伊士运河"},{"key":"D","text":"乌拉尔山脉"}],"answer":"C","explanation":"苏伊士运河沟通地中海和红海，是亚非分界。","verify":"\"苏伊士运河\""},{"id":"cng_j007_q4","topicId":"cng_j007","difficulty":"challenge","type":"choice","prompt":"七大洲按面积从大到小，正确的一组口诀是？","choices":[{"key":"A","text":"亚欧非北美，南美南极大洋"},{"key":"B","text":"非亚北美欧，南美南极大洋"},{"key":"C","text":"亚非欧北美，南美南极大洋"},{"key":"D","text":"亚非北南美，南极欧大洋"}],"answer":"D","explanation":"口诀“亚非北南美，南极欧大洋”对应亚洲、非洲、北美洲、南美洲、南极洲、欧洲、大洋洲。","verify":"\"亚非北南美，南极欧大洋\""},{"id":"cng_j008_q1","topicId":"cng_j008","difficulty":"basic","type":"choice","prompt":"陆地五种基本地形是？","choices":[{"key":"A","text":"平原、沙漠、绿洲、峡谷、岛屿"},{"key":"B","text":"平原、高原、山地、丘陵、盆地"},{"key":"C","text":"海洋、湖泊、河流、冰川、沼泽"},{"key":"D","text":"半岛、群岛、海峡、海湾、海岸"}],"answer":"B","explanation":"教材把陆地地形分为平原、高原、山地、丘陵和盆地。","verify":"\"平原、高原、山地、丘陵、盆地\""},{"id":"cng_j008_q2","topicId":"cng_j008","difficulty":"basic","type":"choice","prompt":"世界最高大的山脉是？","choices":[{"key":"A","text":"安第斯山脉"},{"key":"B","text":"阿尔卑斯山脉"},{"key":"C","text":"喜马拉雅山脉"},{"key":"D","text":"落基山脉"}],"answer":"C","explanation":"喜马拉雅山脉位于亚洲中部，主峰珠穆朗玛峰是世界最高峰。","verify":"\"喜马拉雅山脉\""},{"id":"cng_j008_q3","topicId":"cng_j008","difficulty":"standard","type":"choice","prompt":"安第斯山脉主要位于哪个大洲？","choices":[{"key":"A","text":"非洲"},{"key":"B","text":"欧洲"},{"key":"C","text":"大洋洲"},{"key":"D","text":"南美洲"}],"answer":"D","explanation":"安第斯山脉纵贯南美洲西部，是世界上最长的山脉。","verify":"\"南美洲\""},{"id":"cng_j008_q4","topicId":"cng_j008","difficulty":"challenge","type":"choice","prompt":"亚马孙平原成为世界最大平原，主要因为它位于？","choices":[{"key":"A","text":"南美洲赤道附近的亚马孙河流域"},{"key":"B","text":"非洲北部的撒哈拉沙漠"},{"key":"C","text":"亚洲中部的青藏高原"},{"key":"D","text":"北美洲中部的落基山麓"}],"answer":"A","explanation":"亚马孙河流域地势低平，形成广阔的冲积平原。","verify":"\"南美洲赤道附近的亚马孙河流域\""},{"id":"cng_j009_q1","topicId":"cng_j009","difficulty":"basic","type":"choice","prompt":"海陆变迁的重要证据之一是？","choices":[{"key":"A","text":"四季更替"},{"key":"B","text":"昼夜长短变化"},{"key":"C","text":"有的高山上发现海洋生物化石"},{"key":"D","text":"地图上的比例尺大小"}],"answer":"C","explanation":"高山上的海相化石说明那里曾经是海洋。","verify":"\"有的高山上发现海洋生物化石\""},{"id":"cng_j009_q2","topicId":"cng_j009","difficulty":"basic","type":"choice","prompt":"魏格纳提出的学说是？","choices":[{"key":"A","text":"日心说"},{"key":"B","text":"地心说"},{"key":"C","text":"宇宙大爆炸说"},{"key":"D","text":"大陆漂移说"}],"answer":"D","explanation":"魏格纳根据南美洲和非洲轮廓吻合等现象提出大陆漂移说。","verify":"\"大陆漂移说\""},{"id":"cng_j009_q3","topicId":"cng_j009","difficulty":"standard","type":"choice","prompt":"世界火山、地震主要集中在？","choices":[{"key":"A","text":"板块交界地带"},{"key":"B","text":"大陆内部的平原中心"},{"key":"C","text":"大洋中部远离海沟处"},{"key":"D","text":"所有赤道地区"}],"answer":"A","explanation":"板块交界地壳活跃，多火山地震。","verify":"\"板块交界地带\""},{"id":"cng_j009_q4","topicId":"cng_j009","difficulty":"challenge","type":"choice","prompt":"红海面积在不断扩大，主要是因为两侧板块在？","choices":[{"key":"A","text":"碰撞挤压"},{"key":"B","text":"张裂拉伸"},{"key":"C","text":"水平错动但完全静止"},{"key":"D","text":"整体向地心沉降"}],"answer":"B","explanation":"红海位于非洲板块与印度洋板块张裂地带，海域逐渐扩大。","verify":"\"张裂拉伸\""}]
