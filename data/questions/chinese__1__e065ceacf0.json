[{"id":"cnc_p029_q1","topicId":"cnc_p029","difficulty":"basic","type":"choice","prompt":"「云对雨」后面紧接着的是哪一组？","choices":[{"key":"A","text":"花对树"},{"key":"B","text":"鸟对虫"},{"key":"C","text":"雪对风"},{"key":"D","text":"柳绿对桃红"}],"answer":"C","explanation":"课文先写云对雨、雪对风，再写花对树、鸟对虫。","verify":"\"雪对风\""},{"id":"cnc_p029_q2","topicId":"cnc_p029","difficulty":"basic","type":"choice","prompt":"「花对树」后面紧接着的是哪一组？","choices":[{"key":"A","text":"雪对风"},{"key":"B","text":"山清对水秀"},{"key":"C","text":"云对雨"},{"key":"D","text":"鸟对虫"}],"answer":"D","explanation":"花对树的下一组是鸟对虫。山清对水秀在更后面。","verify":"\"鸟对虫\""},{"id":"cnc_p029_q3","topicId":"cnc_p029","difficulty":"standard","type":"choice","prompt":"「山清对水秀」后面紧接着的是哪一组？","choices":[{"key":"A","text":"柳绿对桃红"},{"key":"B","text":"云对雨"},{"key":"C","text":"雪对风"},{"key":"D","text":"花对树"}],"answer":"A","explanation":"山清对水秀之后，是柳绿对桃红。","verify":"\"柳绿对桃红\""},{"id":"cnc_p029_q4","topicId":"cnc_p029","difficulty":"standard","type":"choice","prompt":"「云」对的是哪一个？","choices":[{"key":"A","text":"风"},{"key":"B","text":"雨"},{"key":"C","text":"雪"},{"key":"D","text":"树"}],"answer":"B","explanation":"云对雨。风对的是雪，树对的是花。","verify":"\"雨\""},{"id":"cnc_p030_q1","topicId":"cnc_p030","difficulty":"basic","type":"choice","prompt":"「日」和「月」合在一起是哪个字？","choices":[{"key":"A","text":"朋"},{"key":"B","text":"胆"},{"key":"C","text":"期"},{"key":"D","text":"明"}],"answer":"D","explanation":"日加月是明亮的明。朋是两个月，不要看错。","verify":"\"明\""},{"id":"cnc_p030_q2","topicId":"cnc_p030","difficulty":"basic","type":"choice","prompt":"「田」和「力」合在一起是哪个字？","choices":[{"key":"A","text":"男"},{"key":"B","text":"电"},{"key":"C","text":"累"},{"key":"D","text":"苗"}],"answer":"A","explanation":"田力男。电和田有关但不是这个字，苗是草字头。","verify":"\"男\""},{"id":"cnc_p030_q3","topicId":"cnc_p030","difficulty":"standard","type":"choice","prompt":"两个人站在一起，可以记哪个字？","choices":[{"key":"A","text":"众"},{"key":"B","text":"从"},{"key":"C","text":"林"},{"key":"D","text":"森"}],"answer":"B","explanation":"二人从。三个人才是众，两棵木是林。","verify":"\"从\""},{"id":"cnc_p030_q4","topicId":"cnc_p030","difficulty":"standard","type":"choice","prompt":"三棵「木」合在一起是哪个字？","choices":[{"key":"A","text":"林"},{"key":"B","text":"丛"},{"key":"C","text":"森"},{"key":"D","text":"苗"}],"answer":"C","explanation":"双木林，三木森。丛和苗都不是三棵木。","verify":"\"森\""},{"id":"cnc_p031_q1","topicId":"cnc_p031","difficulty":"basic","type":"choice","prompt":"下面哪一种是小书包里的文具？","choices":[{"key":"A","text":"橡皮"},{"key":"B","text":"南瓜"},{"key":"C","text":"荷叶"},{"key":"D","text":"石子"}],"answer":"A","explanation":"橡皮是文具，放在小书包里。南瓜、荷叶和石子都不是文具。","verify":"\"橡皮\""},{"id":"cnc_p031_q2","topicId":"cnc_p031","difficulty":"basic","type":"choice","prompt":"「尺子」是用来做什么的？","choices":[{"key":"A","text":"擦掉铅笔字"},{"key":"B","text":"量长短"},{"key":"C","text":"装水喝"},{"key":"D","text":"把国旗升上去"}],"answer":"B","explanation":"尺子用来量长短。擦字用橡皮，装水不是尺子的用处。","verify":"\"量长短\""},{"id":"cnc_p031_q3","topicId":"cnc_p031","difficulty":"standard","type":"choice","prompt":"「笔袋」是用来放什么的？","choices":[{"key":"A","text":"午饭"},{"key":"B","text":"鞋子"},{"key":"C","text":"笔"},{"key":"D","text":"国旗"}],"answer":"C","explanation":"笔袋是文具袋，用来放笔。午饭、鞋子和国旗都不放进笔袋。","verify":"\"笔\""},{"id":"cnc_p031_q4","topicId":"cnc_p031","difficulty":"standard","type":"choice","prompt":"「作业本」用完以后，应当放回哪里？","choices":[{"key":"A","text":"雪地里"},{"key":"B","text":"池塘里"},{"key":"C","text":"瓶口里"},{"key":"D","text":"小书包里"}],"answer":"D","explanation":"作业本是学习用品，用完放回小书包，才不会弄丢。","verify":"\"小书包里\""},{"id":"cnc_p032_q1","topicId":"cnc_p032","difficulty":"basic","type":"choice","prompt":"课文里的国旗是哪一面旗？","choices":[{"key":"A","text":"彩旗"},{"key":"B","text":"五星红旗"},{"key":"C","text":"队旗"},{"key":"D","text":"校旗"}],"answer":"B","explanation":"五星红旗是我们的国旗。彩旗、队旗、校旗都不是国旗。","verify":"\"五星红旗\""},{"id":"cnc_p032_q2","topicId":"cnc_p032","difficulty":"basic","type":"choice","prompt":"国旗是怎样升起来的？","choices":[{"key":"A","text":"一下子被风吹跑"},{"key":"B","text":"小朋友用手抛上去"},{"key":"C","text":"随着国歌徐徐升起"},{"key":"D","text":"降到旗杆下面"}],"answer":"C","explanation":"课文写国歌声中，国旗徐徐升起。徐徐是慢慢地。","verify":"\"随着国歌徐徐升起\""},{"id":"cnc_p032_q3","topicId":"cnc_p032","difficulty":"standard","type":"choice","prompt":"面向升起的国旗，小朋友应该怎样做？","choices":[{"key":"A","text":"坐下休息"},{"key":"B","text":"转身离开"},{"key":"C","text":"大声说笑"},{"key":"D","text":"立正，敬礼"}],"answer":"D","explanation":"向着国旗我们立正，望着国旗我们敬礼。","verify":"\"立正，敬礼\""},{"id":"cnc_p032_q4","topicId":"cnc_p032","difficulty":"standard","type":"choice","prompt":"「迎风飘扬」写的是什么？","choices":[{"key":"A","text":"国旗在风里展开"},{"key":"B","text":"云朵在天上跑"},{"key":"C","text":"树叶落到地上"},{"key":"D","text":"同学们在赛跑"}],"answer":"A","explanation":"升起来的五星红旗迎风飘扬，课文说它多么美丽。","verify":"\"国旗在风里展开\""},{"id":"cnc_p033_q1","topicId":"cnc_p033","difficulty":"basic","type":"choice","prompt":"「一头黄牛」的「头」可以换成下面哪一种说法？","choices":[{"key":"A","text":"一只黄牛也可以"},{"key":"B","text":"一条黄牛也可以"},{"key":"C","text":"一头黄牛不能改成一只黄牛"},{"key":"D","text":"一群黄牛也可以"}],"answer":"C","explanation":"黄牛常用「头」。鸟才常用「只」，鱼常用「条」。","verify":"\"一头黄牛不能改成一只黄牛\""},{"id":"cnc_p033_q2","topicId":"cnc_p033","difficulty":"basic","type":"choice","prompt":"「一只」最适合配下面哪一个？","choices":[{"key":"A","text":"黄牛"},{"key":"B","text":"大雁"},{"key":"C","text":"鱼"},{"key":"D","text":"鸟"}],"answer":"D","explanation":"鸟常用「只」。黄牛常用「头」，大雁常用「群」，鱼常用「条」。","verify":"\"鸟\""},{"id":"cnc_p033_q3","topicId":"cnc_p033","difficulty":"standard","type":"choice","prompt":"「一群大雁」和「一条鱼」放在一起，是在比什么？","choices":[{"key":"A","text":"多和少"},{"key":"B","text":"大和鱼"},{"key":"C","text":"群和雁"},{"key":"D","text":"条和鸟"}],"answer":"A","explanation":"一群是多，一条是少。大和小是另一组，不要和多少混在一起。","verify":"\"多和少\""},{"id":"cnc_p033_q4","topicId":"cnc_p033","difficulty":"standard","type":"choice","prompt":"「大」的反义词是哪一个？","choices":[{"key":"A","text":"少"},{"key":"B","text":"小"},{"key":"C","text":"短"},{"key":"D","text":"低"}],"answer":"B","explanation":"大对小，多对少。少不是大的反义词。","verify":"\"小\""}]
