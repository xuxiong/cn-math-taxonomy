[{"id":"cne_p192_q1","topicId":"cne_p192","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「以前」？","choices":[{"key":"A","text":"different"},{"key":"B","text":"ago"},{"key":"C","text":"active"},{"key":"D","text":"Internet"}],"answer":"B","explanation":"ago 的意思是以前。","verify":"\"ago\""},{"id":"cne_p192_q2","topicId":"cne_p192","difficulty":"basic","type":"choice","prompt":"「different」的中文意思是哪一个？","choices":[{"key":"A","text":"以前"},{"key":"B","text":"活跃的"},{"key":"C","text":"不同的"},{"key":"D","text":"互联网"}],"answer":"C","explanation":"different 的意思是不同的。","verify":"\"不同的\""},{"id":"cne_p192_q3","topicId":"cne_p192","difficulty":"standard","type":"choice","prompt":"选择表示「活跃的」的单词。","choices":[{"key":"A","text":"ago"},{"key":"B","text":"different"},{"key":"C","text":"Internet"},{"key":"D","text":"active"}],"answer":"D","explanation":"表示活跃的的单词是 active。","verify":"\"active\""},{"id":"cne_p192_q4","topicId":"cne_p192","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「互联网」？","choices":[{"key":"A","text":"Internet"},{"key":"B","text":"ago"},{"key":"C","text":"different"},{"key":"D","text":"active"}],"answer":"A","explanation":"Internet 的意思是互联网。","verify":"\"Internet\""},{"id":"cne_p193_q1","topicId":"cne_p193","difficulty":"basic","type":"choice","prompt":"There ____ no library in my school ten years ago. 横线上应填哪个词？","choices":[{"key":"A","text":"is"},{"key":"B","text":"were"},{"key":"C","text":"was"},{"key":"D","text":"are"}],"answer":"C","explanation":"单数 library 的过去式用 There was。","verify":"\"was\""},{"id":"cne_p193_q2","topicId":"cne_p193","difficulty":"basic","type":"choice","prompt":"哪一句表示「以前我很矮」？","choices":[{"key":"A","text":"I were short."},{"key":"B","text":"I was shorted."},{"key":"C","text":"I am short yesterday."},{"key":"D","text":"I was short."}],"answer":"D","explanation":"I 的过去式用 was。","verify":"\"I was short.\""},{"id":"cne_p193_q3","topicId":"cne_p193","difficulty":"standard","type":"choice","prompt":"They ____ young then. 横线上应填哪个词？","choices":[{"key":"A","text":"were"},{"key":"B","text":"was"},{"key":"C","text":"are"},{"key":"D","text":"is"}],"answer":"A","explanation":"They 的过去式用 were。","verify":"\"were\""},{"id":"cne_p193_q4","topicId":"cne_p193","difficulty":"standard","type":"choice","prompt":"There were no computers in the old school. 这句的意思是？","choices":[{"key":"A","text":"以前学校里有电脑"},{"key":"B","text":"以前学校里没有电脑"},{"key":"C","text":"现在学校里没有电脑"},{"key":"D","text":"电脑在图书馆里"}],"answer":"B","explanation":"There were no 表示过去没有。","verify":"\"以前学校里没有电脑\""},{"id":"cne_p194_q1","topicId":"cne_p194","difficulty":"basic","type":"choice","prompt":"想说以前很安静，现在很活跃，应说哪一句？","choices":[{"key":"A","text":"Before, I am quiet. Now, I was active."},{"key":"B","text":"Before, I were quiet. Now, I am active."},{"key":"C","text":"Now, I was quiet. Before, I am active."},{"key":"D","text":"Before, I was quiet. Now, I am active."}],"answer":"D","explanation":"过去用 was，现在用 am。","verify":"\"Before, I was quiet. Now, I am active.\""},{"id":"cne_p194_q2","topicId":"cne_p194","difficulty":"basic","type":"choice","prompt":"There was no Internet ten years ago. 这句的意思是？","choices":[{"key":"A","text":"十年前没有互联网"},{"key":"B","text":"现在没有互联网"},{"key":"C","text":"十年前就有互联网"},{"key":"D","text":"互联网在图书馆里"}],"answer":"A","explanation":"was no Internet ten years ago。","verify":"\"十年前没有互联网\""},{"id":"cne_p194_q3","topicId":"cne_p194","difficulty":"standard","type":"choice","prompt":"How did you change? 这句是在问什么？","choices":[{"key":"A","text":"你现在多高"},{"key":"B","text":"你有什么变化"},{"key":"C","text":"你上周末做了什么"},{"key":"D","text":"你怎么去学校"}],"answer":"B","explanation":"change 是变化。","verify":"\"你有什么变化\""},{"id":"cne_p194_q4","topicId":"cne_p194","difficulty":"standard","type":"choice","prompt":"Now there is a gym. 现在有什么？","choices":[{"key":"A","text":"一个图书馆"},{"key":"B","text":"互联网"},{"key":"C","text":"一个体育馆"},{"key":"D","text":"一台电脑"}],"answer":"C","explanation":"a gym 是体育馆。","verify":"\"一个体育馆\""},{"id":"cne_p195_q1","topicId":"cne_p195","difficulty":"basic","type":"choice","prompt":"读一读：Before, there was no library. Now, there is a big library. 现在有图书馆吗？","choices":[{"key":"A","text":"有"},{"key":"B","text":"没有"},{"key":"C","text":"只有体育馆"},{"key":"D","text":"短文没写现在"}],"answer":"A","explanation":"Now, there is a big library。","verify":"\"有\""},{"id":"cne_p195_q2","topicId":"cne_p195","difficulty":"basic","type":"choice","prompt":"读一读：I was short before. Now I am tall. 哪一句和短文一致？","choices":[{"key":"A","text":"我以前高，现在矮。"},{"key":"B","text":"我以前矮，现在高。"},{"key":"C","text":"我一直很矮。"},{"key":"D","text":"我以前就很高。"}],"answer":"B","explanation":"was short before，Now I am tall。","verify":"\"我以前矮，现在高。\""},{"id":"cne_p195_q3","topicId":"cne_p195","difficulty":"standard","type":"choice","prompt":"读一读：There were no computers in my old school. 以前的学校有电脑吗？","choices":[{"key":"A","text":"有"},{"key":"B","text":"只有一台"},{"key":"C","text":"没有"},{"key":"D","text":"短文说现在没有"}],"answer":"C","explanation":"were no computers。","verify":"\"没有\""},{"id":"cne_p195_q4","topicId":"cne_p195","difficulty":"standard","type":"choice","prompt":"读一读：People did not use the Internet then. Now we use it every day. 现在人们用互联网吗？","choices":[{"key":"A","text":"不用"},{"key":"B","text":"只用电话"},{"key":"C","text":"短文没写现在"},{"key":"D","text":"用"}],"answer":"D","explanation":"Now we use it every day。","verify":"\"用\""},{"id":"cne_p196_q1","topicId":"cne_p196","difficulty":"basic","type":"choice","prompt":"____ is a book on the desk. 横线上应填哪个词？","choices":[{"key":"A","text":"Their"},{"key":"B","text":"There"},{"key":"C","text":"They are"},{"key":"D","text":"Theirs"}],"answer":"B","explanation":"表示「有」用 There is。","verify":"\"There\""},{"id":"cne_p196_q2","topicId":"cne_p196","difficulty":"basic","type":"choice","prompt":"The dog wagged ____ tail. 横线上应填哪个词？","choices":[{"key":"A","text":"it's"},{"key":"B","text":"it is"},{"key":"C","text":"its"},{"key":"D","text":"its is"}],"answer":"C","explanation":"「它的」用 its，没有撇号。","verify":"\"its\""},{"id":"cne_p196_q3","topicId":"cne_p196","difficulty":"standard","type":"choice","prompt":"I have two pens. I want one, ____. 横线上应填哪个词？","choices":[{"key":"A","text":"two"},{"key":"B","text":"to"},{"key":"C","text":"and"},{"key":"D","text":"too"}],"answer":"D","explanation":"表示「也」用 too。","verify":"\"too\""},{"id":"cne_p196_q4","topicId":"cne_p196","difficulty":"standard","type":"choice","prompt":"____ books are on the desk. 意思是「他们的书」。横线上应填哪个词？","choices":[{"key":"A","text":"Their"},{"key":"B","text":"There"},{"key":"C","text":"They are"},{"key":"D","text":"Theirs"}],"answer":"A","explanation":"「他们的」用 Their。","verify":"\"Their\""},{"id":"cne_p197_q1","topicId":"cne_p197","difficulty":"basic","type":"choice","prompt":"读短信：Dear Amy, I went to the park last Sunday. I saw a lake. Love, Mike. Mike 上星期日去了哪里？","choices":[{"key":"A","text":"湖边的学校"},{"key":"B","text":"医院"},{"key":"C","text":"公园"},{"key":"D","text":"超市"}],"answer":"C","explanation":"went to the park。","verify":"\"公园\""},{"id":"cne_p197_q2","topicId":"cne_p197","difficulty":"basic","type":"choice","prompt":"读短信：I am going to visit you in June. 写信人打算几月去看望对方？","choices":[{"key":"A","text":"五月"},{"key":"B","text":"三月"},{"key":"C","text":"十月"},{"key":"D","text":"六月"}],"answer":"D","explanation":"in June。","verify":"\"六月\""},{"id":"cne_p197_q3","topicId":"cne_p197","difficulty":"standard","type":"choice","prompt":"哪一句适合写在信的开头？","choices":[{"key":"A","text":"Dear Sarah,"},{"key":"B","text":"Love, Sarah,"},{"key":"C","text":"Yours, Sarah,"},{"key":"D","text":"How tall are you, Sarah,"}],"answer":"A","explanation":"称呼常用 Dear 加上名字。","verify":"\"Dear Sarah,\""},{"id":"cne_p197_q4","topicId":"cne_p197","difficulty":"standard","type":"choice","prompt":"读短信：Before, I could not swim. Now I can. 哪一句和短信一致？","choices":[{"key":"A","text":"我以前会游泳。"},{"key":"B","text":"我以前不会游泳，现在会了。"},{"key":"C","text":"我现在不会游泳。"},{"key":"D","text":"我打算去游泳。"}],"answer":"B","explanation":"could not swim before，Now I can。","verify":"\"我以前不会游泳，现在会了。\""}]
