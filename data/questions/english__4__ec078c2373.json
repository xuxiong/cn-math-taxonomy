[{"id":"cne_p084_q1","topicId":"cne_p084","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「学校」？","choices":[{"key":"A","text":"playground"},{"key":"B","text":"school"},{"key":"C","text":"library"},{"key":"D","text":"computer"}],"answer":"B","explanation":"school 的意思是学校。","verify":"\"school\""},{"id":"cne_p084_q2","topicId":"cne_p084","difficulty":"basic","type":"choice","prompt":"「playground」的中文意思是哪一个？","choices":[{"key":"A","text":"学校"},{"key":"B","text":"图书馆"},{"key":"C","text":"操场"},{"key":"D","text":"计算机"}],"answer":"C","explanation":"playground 的意思是操场。","verify":"\"操场\""},{"id":"cne_p084_q3","topicId":"cne_p084","difficulty":"standard","type":"choice","prompt":"选择表示「图书馆」的单词。","choices":[{"key":"A","text":"school"},{"key":"B","text":"playground"},{"key":"C","text":"computer"},{"key":"D","text":"library"}],"answer":"D","explanation":"表示图书馆的单词是 library。","verify":"\"library\""},{"id":"cne_p084_q4","topicId":"cne_p084","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「计算机」？","choices":[{"key":"A","text":"computer"},{"key":"B","text":"school"},{"key":"C","text":"playground"},{"key":"D","text":"library"}],"answer":"A","explanation":"computer 的意思是计算机。","verify":"\"computer\""},{"id":"cne_p085_q1","topicId":"cne_p085","difficulty":"basic","type":"numeric","prompt":"The library is on the second floor. 图书馆在第几层？","answer":"2","explanation":"second 是第二，所以是第 2 层。","verify":"2"},{"id":"cne_p085_q2","topicId":"cne_p085","difficulty":"basic","type":"choice","prompt":"first floor 是第几层？","choices":[{"key":"A","text":"第 2 层"},{"key":"B","text":"第 3 层"},{"key":"C","text":"第 4 层"},{"key":"D","text":"第 1 层"}],"answer":"D","explanation":"first 是第一。","verify":"\"第 1 层\""},{"id":"cne_p085_q3","topicId":"cne_p085","difficulty":"standard","type":"choice","prompt":"想问「教师办公室在哪里」，应选哪一句？","choices":[{"key":"A","text":"Where is the teachers' office?"},{"key":"B","text":"What is the teachers' office?"},{"key":"C","text":"Who is the teachers' office?"},{"key":"D","text":"How is the teachers' office?"}],"answer":"A","explanation":"问地点用 Where is。","verify":"\"Where is the teachers' office?\""},{"id":"cne_p085_q4","topicId":"cne_p085","difficulty":"standard","type":"choice","prompt":"It is on the first floor. 这句是在说什么？","choices":[{"key":"A","text":"在第二层"},{"key":"B","text":"在第一层"},{"key":"C","text":"在操场上"},{"key":"D","text":"在图书馆里"}],"answer":"B","explanation":"first floor 是第一层。","verify":"\"在第一层\""},{"id":"cne_p086_q1","topicId":"cne_p086","difficulty":"basic","type":"choice","prompt":"想问图书馆在哪里，应说哪一句？","choices":[{"key":"A","text":"Where is the playground?"},{"key":"B","text":"Where is the classroom?"},{"key":"C","text":"Do you have a library?"},{"key":"D","text":"Where is the library?"}],"answer":"D","explanation":"图书馆是 library。","verify":"\"Where is the library?\""},{"id":"cne_p086_q2","topicId":"cne_p086","difficulty":"basic","type":"choice","prompt":"The playground is on the first floor. 操场在第几层？","choices":[{"key":"A","text":"第 1 层"},{"key":"B","text":"第 2 层"},{"key":"C","text":"第 3 层"},{"key":"D","text":"第 4 层"}],"answer":"A","explanation":"first floor 是第一层。","verify":"\"第 1 层\""},{"id":"cne_p086_q3","topicId":"cne_p086","difficulty":"standard","type":"choice","prompt":"Do you have a computer room? 这句是在问什么？","choices":[{"key":"A","text":"计算机教室在哪里"},{"key":"B","text":"你们有计算机教室吗"},{"key":"C","text":"你喜欢计算机吗"},{"key":"D","text":"计算机是谁的"}],"answer":"B","explanation":"Do you have 问有没有。","verify":"\"你们有计算机教室吗\""},{"id":"cne_p086_q4","topicId":"cne_p086","difficulty":"standard","type":"choice","prompt":"This is my school. 哪一句和这句话意思相同？","choices":[{"key":"A","text":"这是我的教室。"},{"key":"B","text":"这是图书馆。"},{"key":"C","text":"这是我的学校。"},{"key":"D","text":"这是操场。"}],"answer":"C","explanation":"school 是学校。","verify":"\"这是我的学校。\""},{"id":"cne_p087_q1","topicId":"cne_p087","difficulty":"basic","type":"choice","prompt":"读一读：The library is on the second floor. 图书馆在第几层？","choices":[{"key":"A","text":"第 2 层"},{"key":"B","text":"第 1 层"},{"key":"C","text":"第 3 层"},{"key":"D","text":"第 4 层"}],"answer":"A","explanation":"second floor 是第二层。","verify":"\"第 2 层\""},{"id":"cne_p087_q2","topicId":"cne_p087","difficulty":"basic","type":"choice","prompt":"读一读：We have a big playground. 哪一句和短文一致？","choices":[{"key":"A","text":"我们没有操场。"},{"key":"B","text":"我们有一个大操场。"},{"key":"C","text":"图书馆很大。"},{"key":"D","text":"操场在第二层。"}],"answer":"B","explanation":"a big playground。","verify":"\"我们有一个大操场。\""},{"id":"cne_p087_q3","topicId":"cne_p087","difficulty":"standard","type":"choice","prompt":"读一读：The computer room is next to the library. 计算机教室在哪里？","choices":[{"key":"A","text":"在操场上"},{"key":"B","text":"在教室里"},{"key":"C","text":"在图书馆旁边"},{"key":"D","text":"在第一层的门后"}],"answer":"C","explanation":"next to the library 是在图书馆旁边。文字没有写楼层。","verify":"\"在图书馆旁边\""},{"id":"cne_p087_q4","topicId":"cne_p087","difficulty":"standard","type":"choice","prompt":"读一读：Classroom 2 is on the first floor. 二班教室在第几层？","choices":[{"key":"A","text":"第 2 层"},{"key":"B","text":"第 3 层"},{"key":"C","text":"第 4 层"},{"key":"D","text":"第 1 层"}],"answer":"D","explanation":"on the first floor；2 是教室编号，不是楼层。","verify":"\"第 1 层\""},{"id":"cne_p216_q1","topicId":"cne_p216","difficulty":"basic","type":"choice","prompt":"想说「我们可以帮助打扫公园」，应选哪一句？","choices":[{"key":"A","text":"We can help clean the park."},{"key":"B","text":"We can help cleans the park."},{"key":"C","text":"We help can clean the park."},{"key":"D","text":"We are help the park."}],"answer":"A","explanation":"can help + 动词原形。","verify":"\"We can help clean the park.\""},{"id":"cne_p216_q2","topicId":"cne_p216","difficulty":"basic","type":"choice","prompt":"We can help at the library. 这句是在说什么？","choices":[{"key":"A","text":"我们可以在医院帮忙"},{"key":"B","text":"我们在商店买书"},{"key":"C","text":"我们打扫公园"},{"key":"D","text":"我们可以在图书馆帮忙"}],"answer":"D","explanation":"at the library。","verify":"\"我们可以在图书馆帮忙\""},{"id":"cne_p216_q3","topicId":"cne_p216","difficulty":"standard","type":"choice","prompt":"哪一句表示帮助社区？","choices":[{"key":"A","text":"We helps old people."},{"key":"B","text":"Can we helping?"},{"key":"C","text":"We can help old people."},{"key":"D","text":"We can help cooks."}],"answer":"C","explanation":"help old people。","verify":"\"We can help old people.\""},{"id":"cne_p216_q4","topicId":"cne_p216","difficulty":"standard","type":"choice","prompt":"Young people can ____ in the community.","choices":[{"key":"A","text":"to help"},{"key":"B","text":"help"},{"key":"C","text":"helps"},{"key":"D","text":"helping"}],"answer":"B","explanation":"can 后用动词原形。","verify":"\"help\""},{"id":"cne_p217_q1","topicId":"cne_p217","difficulty":"basic","type":"choice","prompt":"读一读：Miss White is a school helper. She helps in the library. 怀特老师在哪里帮忙？","choices":[{"key":"A","text":"图书馆"},{"key":"B","text":"医院"},{"key":"C","text":"公园"},{"key":"D","text":"商店"}],"answer":"A","explanation":"in the library。","verify":"\"图书馆\""},{"id":"cne_p217_q2","topicId":"cne_p217","difficulty":"basic","type":"choice","prompt":"读一读：Tom helps clean the playground. 汤姆帮忙做什么？","choices":[{"key":"A","text":"做饭"},{"key":"B","text":"买东西"},{"key":"C","text":"看病"},{"key":"D","text":"打扫操场"}],"answer":"D","explanation":"clean the playground。","verify":"\"打扫操场\""},{"id":"cne_p217_q3","topicId":"cne_p217","difficulty":"standard","type":"choice","prompt":"读一读：Our school helpers are kind. They help teachers and students. 哪一句和短文一致？","choices":[{"key":"A","text":"老师不需要帮手。"},{"key":"B","text":"学生不能帮忙。"},{"key":"C","text":"学校帮手很善良。"},{"key":"D","text":"学校帮手不帮忙。"}],"answer":"C","explanation":"helpers are kind。","verify":"\"学校帮手很善良。\""},{"id":"cne_p217_q4","topicId":"cne_p217","difficulty":"standard","type":"choice","prompt":"读一读：Amy is a helper. She can help at the school gate. 艾米在哪里帮忙？","choices":[{"key":"A","text":"食堂"},{"key":"B","text":"校门口"},{"key":"C","text":"图书馆"},{"key":"D","text":"教室"}],"answer":"B","explanation":"at the school gate。","verify":"\"校门口\""}]
