[{"id":"cnc_p339_q1","topicId":"cnc_p339","difficulty":"basic","type":"choice","prompt":"「死去元知万事空」的下一句是哪一句？","choices":[{"key":"A","text":"但悲不见九州同"},{"key":"B","text":"王师北定中原日"},{"key":"C","text":"但悲不见九州空"},{"key":"D","text":"家祭无忘告乃翁"}],"answer":"A","explanation":"诗人悲伤的是没能看见国家统一。九州空、家祭都不是这一句的下一句。","verify":"\"但悲不见九州同\""},{"id":"cnc_p339_q2","topicId":"cnc_p339","difficulty":"basic","type":"choice","prompt":"「王师北定中原日」的下一句是哪一句？","choices":[{"key":"A","text":"死去元知万事空"},{"key":"B","text":"家祭无忘告乃翁"},{"key":"C","text":"家祭无忘告乃父"},{"key":"D","text":"家祭勿忘告乃翁"}],"answer":"B","explanation":"希望收复失地的那一天，家里祭奠时告诉父亲。诗中是乃翁，不是乃父。","verify":"\"家祭无忘告乃翁\""},{"id":"cnc_p339_q3","topicId":"cnc_p339","difficulty":"standard","type":"choice","prompt":"《示儿》的作者是谁？","choices":[{"key":"A","text":"林升"},{"key":"B","text":"龚自珍"},{"key":"C","text":"陆游"},{"key":"D","text":"杜甫"}],"answer":"C","explanation":"这首诗是陆游写给儿子的。林升写的是《题临安邸》。","verify":"\"陆游\""},{"id":"cnc_p339_q4","topicId":"cnc_p339","difficulty":"standard","type":"choice","prompt":"诗人最放心不下的是什么？","choices":[{"key":"A","text":"家里的祭品不够"},{"key":"B","text":"儿子不会写诗"},{"key":"C","text":"杭州的歌舞"},{"key":"D","text":"没能看见九州统一"}],"answer":"D","explanation":"万事可空，只有不见九州同这件事放不下。杭州歌舞是《题临安邸》里的情景。","verify":"\"没能看见九州统一\""},{"id":"cnc_p340_q1","topicId":"cnc_p340","difficulty":"basic","type":"choice","prompt":"「山外青山楼外楼」的下一句是哪一句？","choices":[{"key":"A","text":"暖风熏得游人醉"},{"key":"B","text":"西湖歌舞几时休"},{"key":"C","text":"直把杭州作汴州"},{"key":"D","text":"但悲不见九州同"}],"answer":"B","explanation":"先问西湖的歌舞什么时候才停止。暖风是第三句，九州同是《示儿》。","verify":"\"西湖歌舞几时休\""},{"id":"cnc_p340_q2","topicId":"cnc_p340","difficulty":"basic","type":"choice","prompt":"「暖风熏得游人醉」的下一句是哪一句？","choices":[{"key":"A","text":"西湖歌舞几时休"},{"key":"B","text":"直把汴州作杭州"},{"key":"C","text":"直把杭州作汴州"},{"key":"D","text":"直把杭州当汴州"}],"answer":"C","explanation":"诗人批评人们把临时的杭州当成了故都汴州。顺序不能倒过来。","verify":"\"直把杭州作汴州\""},{"id":"cnc_p340_q3","topicId":"cnc_p340","difficulty":"standard","type":"choice","prompt":"《题临安邸》的作者是谁？","choices":[{"key":"A","text":"陆游"},{"key":"B","text":"龚自珍"},{"key":"C","text":"李白"},{"key":"D","text":"林升"}],"answer":"D","explanation":"这首诗是林升写的。《示儿》是陆游的，不要都记成爱国诗人里的同一个人。","verify":"\"林升\""},{"id":"cnc_p340_q4","topicId":"cnc_p340","difficulty":"standard","type":"choice","prompt":"「直把杭州作汴州」批评的是什么？","choices":[{"key":"A","text":"忘了失去的故土，只顾在杭州享乐"},{"key":"B","text":"杭州的楼盖得不够高"},{"key":"C","text":"汴州比杭州更适合看西湖"},{"key":"D","text":"游人不会写诗"}],"answer":"A","explanation":"汴州是已经失去的都城。把杭州当成汴州，是忘了北方还没收回。","verify":"\"忘了失去的故土，只顾在杭州享乐\""},{"id":"cnc_p341_q1","topicId":"cnc_p341","difficulty":"basic","type":"choice","prompt":"「九州生气恃风雷」的下一句是哪一句？","choices":[{"key":"A","text":"我劝天公重抖擞"},{"key":"B","text":"但悲不见九州同"},{"key":"C","text":"万马齐喑究可哀"},{"key":"D","text":"直把杭州作汴州"}],"answer":"C","explanation":"没有风雷，到处都静得可怕。九州同是《示儿》，杭州是《题临安邸》。","verify":"\"万马齐喑究可哀\""},{"id":"cnc_p341_q2","topicId":"cnc_p341","difficulty":"basic","type":"choice","prompt":"「我劝天公重抖擞」的下一句是哪一句？","choices":[{"key":"A","text":"万马齐喑究可哀"},{"key":"B","text":"不拘一格降人材"},{"key":"C","text":"家祭无忘告乃翁"},{"key":"D","text":"不拘一格降人才"}],"answer":"D","explanation":"希望上天重新振作，不限一种规格地降下人才。诗中是人才，不是人材。","verify":"\"不拘一格降人才\""},{"id":"cnc_p341_q3","topicId":"cnc_p341","difficulty":"standard","type":"choice","prompt":"《己亥杂诗》（九州生气恃风雷）的作者是谁？","choices":[{"key":"A","text":"龚自珍"},{"key":"B","text":"陆游"},{"key":"C","text":"林升"},{"key":"D","text":"梁启超"}],"answer":"A","explanation":"这首是龚自珍的。陆游写《示儿》，林升写《题临安邸》，梁启超写《少年中国说》。","verify":"\"龚自珍\""},{"id":"cnc_p341_q4","topicId":"cnc_p341","difficulty":"standard","type":"choice","prompt":"「万马齐喑」在诗里是什么意思？","choices":[{"key":"A","text":"马真的都哑了，不能拉车"},{"key":"B","text":"人才被压抑，到处没有声音"},{"key":"C","text":"杭州的歌舞太吵"},{"key":"D","text":"圆明园里在打仗"}],"answer":"B","explanation":"万马齐喑是比喻沉闷。诗人盼的是不拘一格降人才。","verify":"\"人才被压抑，到处没有声音\""},{"id":"cnc_p342_q1","topicId":"cnc_p342","difficulty":"basic","type":"choice","prompt":"「少年智则国智」的下一句是哪一句？","choices":[{"key":"A","text":"少年强则国强"},{"key":"B","text":"少年独立则国独立"},{"key":"C","text":"少年自由则国自由"},{"key":"D","text":"少年富则国富"}],"answer":"D","explanation":"原文按智、富、强往下说。强在富的后面。","verify":"\"少年富则国富\""},{"id":"cnc_p342_q2","topicId":"cnc_p342","difficulty":"basic","type":"choice","prompt":"《少年中国说》的作者是谁？","choices":[{"key":"A","text":"梁启超"},{"key":"B","text":"陆游"},{"key":"C","text":"龚自珍"},{"key":"D","text":"林升"}],"answer":"A","explanation":"这篇是梁启超的。不要因为都是近代文章就记成别人。陆游、龚自珍、林升写的是这一单元的诗。","verify":"\"梁启超\""},{"id":"cnc_p342_q3","topicId":"cnc_p342","difficulty":"standard","type":"choice","prompt":"作者把中国的未来寄托在谁身上？","choices":[{"key":"A","text":"老人"},{"key":"B","text":"少年"},{"key":"C","text":"外国人"},{"key":"D","text":"古人"}],"answer":"B","explanation":"少年强则国强，强调的是年轻一代。","verify":"\"少年\""},{"id":"cnc_p342_q4","topicId":"cnc_p342","difficulty":"standard","type":"choice","prompt":"「少年强则国强」是什么意思？","choices":[{"key":"A","text":"国家强了，少年就可以不学习"},{"key":"B","text":"只有老人决定国家的未来"},{"key":"C","text":"年轻人奋发有为，国家就会强盛"},{"key":"D","text":"少年和祖国没有关系"}],"answer":"C","explanation":"句子用「则」表示少年的状态会影响国家。","verify":"\"年轻人奋发有为，国家就会强盛\""},{"id":"cnc_p343_q1","topicId":"cnc_p343","difficulty":"basic","type":"choice","prompt":"圆明园里有怎样的建筑？","choices":[{"key":"A","text":"既有金碧辉煌的殿堂，也有山乡村野，还有西洋景观"},{"key":"B","text":"只有一座小小的茅屋"},{"key":"C","text":"只有西洋楼，没有中国建筑"},{"key":"D","text":"全部是后来新建的居民楼"}],"answer":"A","explanation":"课文从皇家园林写到各地名胜的缩影，也写到西洋景观。","verify":"\"既有金碧辉煌的殿堂，也有山乡村野，还有西洋景观\""},{"id":"cnc_p343_q2","topicId":"cnc_p343","difficulty":"basic","type":"choice","prompt":"园里还收藏着什么？","choices":[{"key":"A","text":"只有一些普通的砖头"},{"key":"B","text":"历代珍贵的文物、名人书画"},{"key":"C","text":"海力布的宝石"},{"key":"D","text":"和氏璧和荆条"}],"answer":"B","explanation":"最珍贵的历史文物、金银珠宝都在园中。宝石和荆条是另外两课。","verify":"\"历代珍贵的文物、名人书画\""},{"id":"cnc_p343_q3","topicId":"cnc_p343","difficulty":"standard","type":"choice","prompt":"是谁毁灭了圆明园？","choices":[{"key":"A","text":"园里的工匠自己拆掉的"},{"key":"B","text":"一场地震把它震塌"},{"key":"C","text":"英法联军放火焚烧"},{"key":"D","text":"赵国的军队"}],"answer":"C","explanation":"一八六零年，英法联军闯进圆明园，抢掠之后放火。","verify":"\"英法联军放火焚烧\""},{"id":"cnc_p343_q4","topicId":"cnc_p343","difficulty":"standard","type":"choice","prompt":"作者为什么说这是不可估量的损失？","choices":[{"key":"A","text":"只损失了几棵树，所以无所谓"},{"key":"B","text":"圆明园本来就没有价值"},{"key":"C","text":"火只烧了一间屋子"},{"key":"D","text":"损失的是祖国文化，也是世界文化"}],"answer":"D","explanation":"课文开头和结尾都说：圆明园的毁灭是文化史上不可估量的损失。","verify":"\"损失的是祖国文化，也是世界文化\""},{"id":"cnc_p344_q1","topicId":"cnc_p344","difficulty":"basic","type":"choice","prompt":"梅兰芳是做什么的？平时为什么不能留胡子？","choices":[{"key":"A","text":"赵国的大将，胡子是盔甲的一部分"},{"key":"B","text":"京剧表演艺术家，演的是旦角，留了胡子就没法扮女子"},{"key":"C","text":"圆明园的工匠，胡子会挡住砖"},{"key":"D","text":"诺曼底号的船长，胡子能当绳子"}],"answer":"B","explanation":"旦角是戏里的女角色。蓄须，等于宣布不再登台。","verify":"\"京剧表演艺术家，演的是旦角，留了胡子就没法扮女子\""},{"id":"cnc_p344_q2","topicId":"cnc_p344","difficulty":"basic","type":"choice","prompt":"他为什么要蓄须？","choices":[{"key":"A","text":"为了让胡须比别人长"},{"key":"B","text":"因为戏园子规定必须留胡子"},{"key":"C","text":"表示不给日本侵略者演戏的决心"},{"key":"D","text":"为了去圆明园救火"}],"answer":"C","explanation":"借口用尽以后，蓄须就是无声的抗议。","verify":"\"表示不给日本侵略者演戏的决心\""},{"id":"cnc_p344_q3","topicId":"cnc_p344","difficulty":"standard","type":"choice","prompt":"没有收入的时候，他怎样坚持？","choices":[{"key":"A","text":"立刻剃掉胡子去演戏赚钱"},{"key":"B","text":"把房子卖给侵略者换一张戏票"},{"key":"C","text":"请廉颇来替他唱"},{"key":"D","text":"宁可卖掉房子度日，也不肯登台"}],"answer":"D","explanation":"戏园子老板出再好的条件，他也不演。","verify":"\"宁可卖掉房子度日，也不肯登台\""},{"id":"cnc_p344_q4","topicId":"cnc_p344","difficulty":"standard","type":"choice","prompt":"抗战胜利以后，他怎样了？","choices":[{"key":"A","text":"剃掉胡须，重新登台"},{"key":"B","text":"把胡子留到老，再也不唱了"},{"key":"C","text":"去冀中修地道"},{"key":"D","text":"把和氏璧送回赵国"}],"answer":"A","explanation":"胡子是为拒演才留的。胜利了，才重新拿起艺术。","verify":"\"剃掉胡须，重新登台\""},{"id":"cnc_p345_q1","topicId":"cnc_p345","difficulty":"basic","type":"choice","prompt":"「不可估量的损失」里，「估量」是什么意思？","choices":[{"key":"A","text":"把园子量一遍长度"},{"key":"B","text":"把文物藏起来"},{"key":"C","text":"估计损失有多大"},{"key":"D","text":"把火扑灭"}],"answer":"C","explanation":"不可估量，是大到没法估计。不是拿尺子去量。","verify":"\"估计损失有多大\""},{"id":"cnc_p345_q2","topicId":"cnc_p345","difficulty":"basic","type":"choice","prompt":"「众星拱月」在文中比喻什么？","choices":[{"key":"A","text":"星星掉进了湖里"},{"key":"B","text":"月亮比殿堂更高"},{"key":"C","text":"游客围着一棵树"},{"key":"D","text":"许多小园环绕着圆明园"}],"answer":"D","explanation":"圆明园和长春园、万春园等园子的位置，像众星托着月亮。","verify":"\"许多小园环绕着圆明园\""},{"id":"cnc_p345_q3","topicId":"cnc_p345","difficulty":"standard","type":"choice","prompt":"「玲珑剔透」适合形容什么？","choices":[{"key":"A","text":"精巧、空灵的建筑或工艺品"},{"key":"B","text":"一场大火"},{"key":"C","text":"厚厚的城墙"},{"key":"D","text":"平平的操场"}],"answer":"A","explanation":"玲珑剔透是说精巧得能透出光来。大火和城墙不能这样形容。","verify":"\"精巧、空灵的建筑或工艺品\""},{"id":"cnc_p345_q4","topicId":"cnc_p345","difficulty":"standard","type":"choice","prompt":"理解这些词，哪一种做法对？","choices":[{"key":"A","text":"只看第一个字"},{"key":"B","text":"先放回课文里看它说的是什么"},{"key":"C","text":"换成反义词就当解释"},{"key":"D","text":"不看句子，挑一个词典里最生的意思"}],"answer":"B","explanation":"不可估量和众星拱月，离开圆明园这段话就不容易懂。","verify":"\"先放回课文里看它说的是什么\""}]
