[{"id":"cne_j142_q1","topicId":"cne_j142","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「头痛」？","choices":[{"key":"A","text":"stomachache"},{"key":"B","text":"fever"},{"key":"C","text":"cough"},{"key":"D","text":"headache"}],"answer":"D","explanation":"headache 的意思是头痛。","verify":"\"headache\""},{"id":"cne_j142_q2","topicId":"cne_j142","difficulty":"basic","type":"choice","prompt":"「stomachache」的中文意思是哪一个？","choices":[{"key":"A","text":"胃痛"},{"key":"B","text":"头痛"},{"key":"C","text":"发烧"},{"key":"D","text":"咳嗽"}],"answer":"A","explanation":"stomachache 的意思是胃痛。","verify":"\"胃痛\""},{"id":"cne_j142_q3","topicId":"cne_j142","difficulty":"standard","type":"choice","prompt":"选择表示「发烧」的单词。","choices":[{"key":"A","text":"headache"},{"key":"B","text":"fever"},{"key":"C","text":"stomachache"},{"key":"D","text":"cough"}],"answer":"B","explanation":"表示发烧的单词是 fever。","verify":"\"fever\""},{"id":"cne_j142_q4","topicId":"cne_j142","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「咳嗽」？","choices":[{"key":"A","text":"headache"},{"key":"B","text":"stomachache"},{"key":"C","text":"cough"},{"key":"D","text":"fever"}],"answer":"C","explanation":"cough 的意思是咳嗽。","verify":"\"cough\""},{"id":"cne_j143_q1","topicId":"cne_j143","difficulty":"basic","type":"choice","prompt":"你应该去看医生。哪一句正确？","choices":[{"key":"A","text":"You should see a doctor."},{"key":"B","text":"You should to see a doctor."},{"key":"C","text":"You should sees a doctor."},{"key":"D","text":"You should seeing a doctor."}],"answer":"A","explanation":"should 后面用动词原形。","verify":"\"You should see a doctor.\""},{"id":"cne_j143_q2","topicId":"cne_j143","difficulty":"basic","type":"choice","prompt":"你不该吃这么多。哪一句正确？","choices":[{"key":"A","text":"You shouldn't to eat so much."},{"key":"B","text":"You shouldn't eat so much."},{"key":"C","text":"You shouldn't eats so much."},{"key":"D","text":"You don't should eat so much."}],"answer":"B","explanation":"shouldn't 后面用动词原形。","verify":"\"You shouldn't eat so much.\""},{"id":"cne_j143_q3","topicId":"cne_j143","difficulty":"standard","type":"choice","prompt":"她牙痛，哪一条建议合适？","choices":[{"key":"A","text":"She should sees a dentist."},{"key":"B","text":"She should to see a dentist."},{"key":"C","text":"She should see a dentist."},{"key":"D","text":"She should seeing a dentist."}],"answer":"C","explanation":"should see。","verify":"\"She should see a dentist.\""},{"id":"cne_j143_q4","topicId":"cne_j143","difficulty":"standard","type":"choice","prompt":"should 在这些句子里表示什么？","choices":[{"key":"A","text":"过去的事实"},{"key":"B","text":"正在进行"},{"key":"C","text":"已经完成"},{"key":"D","text":"建议"}],"answer":"D","explanation":"should 用来告诉别人宜做什么。","verify":"\"建议\""},{"id":"cne_j144_q1","topicId":"cne_j144","difficulty":"basic","type":"choice","prompt":"看到同学不舒服，哪一句合适？","choices":[{"key":"A","text":"What's the matter yesterday happened?"},{"key":"B","text":"What's the matter?"},{"key":"C","text":"What the matter is you?"},{"key":"D","text":"How the matter are you?"}],"answer":"B","explanation":"What's the matter 用来问出了什么问题。","verify":"\"What's the matter?\""},{"id":"cne_j144_q2","topicId":"cne_j144","difficulty":"basic","type":"choice","prompt":"你头痛，应怎么说？","choices":[{"key":"A","text":"I have headache."},{"key":"B","text":"I has a headache."},{"key":"C","text":"I have a headache."},{"key":"D","text":"I have an headache."}],"answer":"C","explanation":"have a headache。","verify":"\"I have a headache.\""},{"id":"cne_j144_q3","topicId":"cne_j144","difficulty":"standard","type":"choice","prompt":"对方发烧了，你建议他躺下。哪一句合适？","choices":[{"key":"A","text":"You should lies down and rest."},{"key":"B","text":"You should to lie down and rest."},{"key":"C","text":"You should lying down and rest."},{"key":"D","text":"You should lie down and rest."}],"answer":"D","explanation":"should lie。","verify":"\"You should lie down and rest.\""},{"id":"cne_j144_q4","topicId":"cne_j144","difficulty":"standard","type":"choice","prompt":"对方说 I have a cough. 你还想问持续多久，哪一句合适？","choices":[{"key":"A","text":"How long have you had it?"},{"key":"B","text":"How long did you had it tomorrow?"},{"key":"C","text":"How far have you had it?"},{"key":"D","text":"How often you have it yesterday now?"}],"answer":"A","explanation":"How long 问持续了多久。","verify":"\"How long have you had it?\""},{"id":"cne_j145_q1","topicId":"cne_j145","difficulty":"basic","type":"choice","prompt":"Ben has a stomachache. The doctor says he should not eat cold food. 他怎么了？","choices":[{"key":"A","text":"头痛"},{"key":"B","text":"咳嗽"},{"key":"C","text":"胃痛"},{"key":"D","text":"牙疼"}],"answer":"C","explanation":"has a stomachache。","verify":"\"胃痛\""},{"id":"cne_j145_q2","topicId":"cne_j145","difficulty":"basic","type":"choice","prompt":"Ben has a stomachache. The doctor says he should not eat cold food. 医生建议他怎样？","choices":[{"key":"A","text":"多吃冰淇淋"},{"key":"B","text":"去跑步"},{"key":"C","text":"不休息"},{"key":"D","text":"别吃冷的食物"}],"answer":"D","explanation":"should not eat cold food。","verify":"\"别吃冷的食物\""},{"id":"cne_j145_q3","topicId":"cne_j145","difficulty":"standard","type":"choice","prompt":"Lisa has a fever and a cough. She should drink more water. 她应该做什么？","choices":[{"key":"A","text":"多喝水"},{"key":"B","text":"少喝水"},{"key":"C","text":"吃更多糖"},{"key":"D","text":"短文没说"}],"answer":"A","explanation":"should drink more water。","verify":"\"多喝水\""},{"id":"cne_j145_q4","topicId":"cne_j145","difficulty":"standard","type":"choice","prompt":"Lisa has a fever and a cough. 哪一句和短文一致？","choices":[{"key":"A","text":"Lisa only has a headache."},{"key":"B","text":"Lisa has both a fever and a cough."},{"key":"C","text":"Lisa should not drink water."},{"key":"D","text":"Ben has a fever in this sentence."}],"answer":"B","explanation":"fever and a cough 都有。","verify":"\"Lisa has both a fever and a cough.\""},{"id":"cne_j251_q1","topicId":"cne_j251","difficulty":"basic","type":"choice","prompt":"She cut ____ when she was cooking.","choices":[{"key":"A","text":"her"},{"key":"B","text":"she"},{"key":"C","text":"hers"},{"key":"D","text":"herself"}],"answer":"D","explanation":"主语 she 伤到自己，用 herself。","verify":"\"herself\""},{"id":"cne_j251_q2","topicId":"cne_j251","difficulty":"basic","type":"choice","prompt":"Take care of ____, Tom!","choices":[{"key":"A","text":"your"},{"key":"B","text":"yourself"},{"key":"C","text":"you"},{"key":"D","text":"yourselves"}],"answer":"B","explanation":"对一个人说，用 yourself。","verify":"\"yourself\""},{"id":"cne_j251_q3","topicId":"cne_j251","difficulty":"standard","type":"choice","prompt":"We enjoyed ____ at the party.","choices":[{"key":"A","text":"us"},{"key":"B","text":"ourself"},{"key":"C","text":"ours"},{"key":"D","text":"ourselves"}],"answer":"D","explanation":"we 对应 ourselves。","verify":"\"ourselves\""},{"id":"cne_j251_q4","topicId":"cne_j251","difficulty":"standard","type":"choice","prompt":"I hurt ____. 哪一个正确？","choices":[{"key":"A","text":"meself"},{"key":"B","text":"me self"},{"key":"C","text":"myself"},{"key":"D","text":"mine"}],"answer":"C","explanation":"I 对应 myself。","verify":"\"myself\""}]
