[{"id":"cnc_p008_q1","topicId":"cnc_p008","difficulty":"basic","type":"choice","prompt":"「妈」的第一声该怎么读？","choices":[{"key":"A","text":"má（麻，第二声）"},{"key":"B","text":"mā（妈，第一声）"},{"key":"C","text":"mǎ（马，第三声）"},{"key":"D","text":"mà（骂，第四声）"}],"answer":"B","explanation":"妈是第一声 mā。麻是第二声，马是第三声，骂是第四声。","verify":"\"mā（妈，第一声）\""},{"id":"cnc_p008_q2","topicId":"cnc_p008","difficulty":"basic","type":"choice","prompt":"「马」的读音是哪一个？","choices":[{"key":"A","text":"mā（妈，第一声）"},{"key":"B","text":"má（麻，第二声）"},{"key":"C","text":"mǎ（马，第三声）"},{"key":"D","text":"mà（骂，第四声）"}],"answer":"C","explanation":"马是第三声 mǎ，不要读成妈、麻或骂。","verify":"\"mǎ（马，第三声）\""},{"id":"cnc_p008_q3","topicId":"cnc_p008","difficulty":"standard","type":"choice","prompt":"「鹅」开头的单韵母是哪一个？","choices":[{"key":"A","text":"ē（第一声）"},{"key":"B","text":"ě（第三声）"},{"key":"C","text":"è（第四声）"},{"key":"D","text":"é（鹅，第二声）"}],"answer":"D","explanation":"鹅是第二声 é。第一声是 ē，第三声是 ě，第四声是 è。","verify":"\"é（鹅，第二声）\""},{"id":"cnc_p008_q4","topicId":"cnc_p008","difficulty":"standard","type":"choice","prompt":"「大」的韵母是哪一个？","choices":[{"key":"A","text":"单韵母 a"},{"key":"B","text":"单韵母 o"},{"key":"C","text":"单韵母 e"},{"key":"D","text":"单韵母 i"}],"answer":"A","explanation":"大的韵母是 a。o 是「波」一类的韵母，e 是「鹅」，i 是「衣」。","verify":"\"单韵母 a\""},{"id":"cnc_p009_q1","topicId":"cnc_p009","difficulty":"basic","type":"choice","prompt":"下面哪个是单韵母 ü？","choices":[{"key":"A","text":"u（乌的韵母）"},{"key":"B","text":"i（衣的韵母）"},{"key":"C","text":"ü（鱼的韵母）"},{"key":"D","text":"e（鹅的韵母）"}],"answer":"C","explanation":"鱼的韵母是 ü。乌的韵母是 u，衣的韵母是 i，鹅的韵母是 e。","verify":"\"ü（鱼的韵母）\""},{"id":"cnc_p009_q2","topicId":"cnc_p009","difficulty":"basic","type":"choice","prompt":"「乌」的韵母是哪一个？","choices":[{"key":"A","text":"单韵母 ü"},{"key":"B","text":"单韵母 i"},{"key":"C","text":"单韵母 a"},{"key":"D","text":"单韵母 u"}],"answer":"D","explanation":"乌的韵母是 u，上面没有两点。有两点的是 ü。","verify":"\"单韵母 u\""},{"id":"cnc_p009_q3","topicId":"cnc_p009","difficulty":"standard","type":"choice","prompt":"「衣」的韵母是哪一个？","choices":[{"key":"A","text":"单韵母 i"},{"key":"B","text":"单韵母 u"},{"key":"C","text":"单韵母 ü"},{"key":"D","text":"单韵母 o"}],"answer":"A","explanation":"衣的韵母是 i。u 是乌，ü 是鱼，o 是波。","verify":"\"单韵母 i\""},{"id":"cnc_p009_q4","topicId":"cnc_p009","difficulty":"standard","type":"choice","prompt":"下面哪一组都是单韵母？","choices":[{"key":"A","text":"b、p、m"},{"key":"B","text":"i、u、ü"},{"key":"C","text":"zh、ch、sh"},{"key":"D","text":"ai、ei、ui"}],"answer":"B","explanation":"i、u、ü 是单韵母。b、p、m 和 zh、ch、sh 是声母，ai、ei、ui 是复韵母。","verify":"\"i、u、ü\""},{"id":"cnc_p010_q1","topicId":"cnc_p010","difficulty":"basic","type":"choice","prompt":"「八」的声母是哪一个？","choices":[{"key":"A","text":"声母 p（坡）"},{"key":"B","text":"声母 m（摸）"},{"key":"C","text":"声母 f（佛）"},{"key":"D","text":"声母 b（玻）"}],"answer":"D","explanation":"八是 bā，声母是不送气的 b。爬才是送气的 p。","verify":"\"声母 b（玻）\""},{"id":"cnc_p010_q2","topicId":"cnc_p010","difficulty":"basic","type":"choice","prompt":"「爬」的声母是哪一个？","choices":[{"key":"A","text":"声母 p（坡）"},{"key":"B","text":"声母 b（玻）"},{"key":"C","text":"声母 f（佛）"},{"key":"D","text":"声母 m（摸）"}],"answer":"A","explanation":"爬是 pá，声母是送气的 p。八的声母才是 b。","verify":"\"声母 p（坡）\""},{"id":"cnc_p010_q3","topicId":"cnc_p010","difficulty":"standard","type":"choice","prompt":"「妈」的声母是哪一个？","choices":[{"key":"A","text":"声母 b（玻）"},{"key":"B","text":"声母 m（摸）"},{"key":"C","text":"声母 f（佛）"},{"key":"D","text":"声母 p（坡）"}],"answer":"B","explanation":"妈是 mā，声母是 m。b、p、f 都不是这个音。","verify":"\"声母 m（摸）\""},{"id":"cnc_p010_q4","topicId":"cnc_p010","difficulty":"standard","type":"choice","prompt":"「发」的声母是哪一个？","choices":[{"key":"A","text":"声母 b（玻）"},{"key":"B","text":"声母 p（坡）"},{"key":"C","text":"声母 f（佛）"},{"key":"D","text":"声母 m（摸）"}],"answer":"C","explanation":"发是 fā，声母是 f。不要读成 b 或 p。","verify":"\"声母 f（佛）\""},{"id":"cnc_p011_q1","topicId":"cnc_p011","difficulty":"basic","type":"choice","prompt":"「大」的声母是哪一个？","choices":[{"key":"A","text":"声母 d（得）"},{"key":"B","text":"声母 t（特）"},{"key":"C","text":"声母 n（讷）"},{"key":"D","text":"声母 l（勒）"}],"answer":"A","explanation":"大是 dà，声母是不送气的 d。兔才是送气的 t。","verify":"\"声母 d（得）\""},{"id":"cnc_p011_q2","topicId":"cnc_p011","difficulty":"basic","type":"choice","prompt":"「兔」的声母是哪一个？","choices":[{"key":"A","text":"声母 d（得）"},{"key":"B","text":"声母 t（特）"},{"key":"C","text":"声母 n（讷）"},{"key":"D","text":"声母 l（勒）"}],"answer":"B","explanation":"兔是 tù，声母是送气的 t。大的声母才是 d。","verify":"\"声母 t（特）\""},{"id":"cnc_p011_q3","topicId":"cnc_p011","difficulty":"standard","type":"choice","prompt":"「你」的声母是哪一个？","choices":[{"key":"A","text":"声母 l（勒）"},{"key":"B","text":"声母 d（得）"},{"key":"C","text":"声母 n（讷）"},{"key":"D","text":"声母 t（特）"}],"answer":"C","explanation":"你是 nǐ，声母是 n。拉的声母才是 l。","verify":"\"声母 n（讷）\""},{"id":"cnc_p011_q4","topicId":"cnc_p011","difficulty":"standard","type":"choice","prompt":"「拉」的声母是哪一个？","choices":[{"key":"A","text":"声母 n（讷）"},{"key":"B","text":"声母 d（得）"},{"key":"C","text":"声母 t（特）"},{"key":"D","text":"声母 l（勒）"}],"answer":"D","explanation":"拉是 lā，声母是 l。你的声母是 n，不要读混。","verify":"\"声母 l（勒）\""},{"id":"cnc_p012_q1","topicId":"cnc_p012","difficulty":"basic","type":"choice","prompt":"「远看山有色」的下一句是哪一句？","choices":[{"key":"A","text":"春去花还在"},{"key":"B","text":"近听水无声"},{"key":"C","text":"人来鸟不惊"},{"key":"D","text":"春去花不在"}],"answer":"B","explanation":"先写远远看见山有颜色，接着是走近了也听不见水声。","verify":"\"近听水无声\""},{"id":"cnc_p012_q2","topicId":"cnc_p012","difficulty":"basic","type":"choice","prompt":"「春去花还在」的下一句是哪一句？","choices":[{"key":"A","text":"近听水无声"},{"key":"B","text":"远看山有色"},{"key":"C","text":"人来鸟不惊"},{"key":"D","text":"人来鸟飞走"}],"answer":"C","explanation":"春天过去花还在，人来了鸟也不惊吓。飞走和原文相反。","verify":"\"人来鸟不惊\""},{"id":"cnc_p012_q3","topicId":"cnc_p012","difficulty":"standard","type":"choice","prompt":"为什么近处听不见水声、人来了鸟也不惊？","choices":[{"key":"A","text":"因为山里没有水"},{"key":"B","text":"因为鸟都已经飞走"},{"key":"C","text":"因为花全部谢了"},{"key":"D","text":"因为写的是一幅画，不是真的山水"}],"answer":"D","explanation":"画上的水不会响，画上的鸟也不会被人吓飞。","verify":"\"因为写的是一幅画，不是真的山水\""},{"id":"cnc_p012_q4","topicId":"cnc_p012","difficulty":"standard","type":"choice","prompt":"这首诗写的是什么？","choices":[{"key":"A","text":"一幅画"},{"key":"B","text":"一场大雨"},{"key":"C","text":"一群大雁"},{"key":"D","text":"一面国旗"}],"answer":"A","explanation":"山有色、水无声、花还在、鸟不惊，都是因为看的是画。","verify":"\"一幅画\""}]
