[{"id":"cnc_p250_q1","topicId":"cnc_p250","difficulty":"basic","type":"choice","prompt":"「一道残阳铺水中」的下一句是哪一句？","choices":[{"key":"A","text":"半江瑟瑟半江蓝"},{"key":"B","text":"露似真珠月似弓"},{"key":"C","text":"可怜九月初三夜"},{"key":"D","text":"半江瑟瑟半江红"}],"answer":"D","explanation":"江面一半是深青，一半被残阳照红。后两句才写九月初三的夜。","verify":"\"半江瑟瑟半江红\""},{"id":"cnc_p250_q2","topicId":"cnc_p250","difficulty":"basic","type":"choice","prompt":"「可怜九月初三夜」的下一句是哪一句？","choices":[{"key":"A","text":"露似真珠月似弓"},{"key":"B","text":"半江瑟瑟半江红"},{"key":"C","text":"露似珍珠月似弓"},{"key":"D","text":"一道残阳铺水中"}],"answer":"A","explanation":"露水像珍珠，月亮像弓。诗里写的是真珠。","verify":"\"露似真珠月似弓\""},{"id":"cnc_p250_q3","topicId":"cnc_p250","difficulty":"standard","type":"choice","prompt":"《暮江吟》的作者是谁？","choices":[{"key":"A","text":"苏轼"},{"key":"B","text":"白居易"},{"key":"C","text":"卢梅坡"},{"key":"D","text":"李白"}],"answer":"B","explanation":"这首诗是白居易写的。苏轼写《题西林壁》，卢梅坡写《雪梅》。","verify":"\"白居易\""},{"id":"cnc_p250_q4","topicId":"cnc_p250","difficulty":"standard","type":"choice","prompt":"「瑟瑟」在这首诗里是什么意思？","choices":[{"key":"A","text":"风吹树叶的声音"},{"key":"B","text":"天气很热"},{"key":"C","text":"没有照到阳光的那部分江水，颜色深青"},{"key":"D","text":"江水完全干了"}],"answer":"C","explanation":"半江瑟瑟半江红，瑟瑟对的是红，写的是颜色，不是声音。","verify":"\"没有照到阳光的那部分江水，颜色深青\""},{"id":"cnc_p251_q1","topicId":"cnc_p251","difficulty":"basic","type":"choice","prompt":"「横看成岭侧成峰」的下一句是哪一句？","choices":[{"key":"A","text":"远近高低各不同"},{"key":"B","text":"远近高低都不同"},{"key":"C","text":"远近高低各相同"},{"key":"D","text":"不识庐山真面目"}],"answer":"A","explanation":"从不同的距离、不同的高度看，山的样子各不相同。","verify":"\"远近高低各不同\""},{"id":"cnc_p251_q2","topicId":"cnc_p251","difficulty":"basic","type":"choice","prompt":"「不识庐山真面目」的下一句是哪一句？","choices":[{"key":"A","text":"只因身在此山中"},{"key":"B","text":"只缘身在此山中"},{"key":"C","text":"只缘人在此山中"},{"key":"D","text":"不识庐山真面貌"}],"answer":"B","explanation":"诗中用「只缘」，不是「只因」，也不是「人在」。","verify":"\"只缘身在此山中\""},{"id":"cnc_p251_q3","topicId":"cnc_p251","difficulty":"standard","type":"choice","prompt":"《题西林壁》的作者是谁？","choices":[{"key":"A","text":"李白"},{"key":"B","text":"杜甫"},{"key":"C","text":"苏轼"},{"key":"D","text":"白居易"}],"answer":"C","explanation":"这首诗是苏轼写的。《暮江吟》才是白居易的。","verify":"\"苏轼\""},{"id":"cnc_p251_q4","topicId":"cnc_p251","difficulty":"standard","type":"choice","prompt":"诗人为什么说认不清庐山的真面目？","choices":[{"key":"A","text":"庐山没有山峰"},{"key":"B","text":"他从来没有到过庐山"},{"key":"C","text":"山被雪完全盖住了"},{"key":"D","text":"自己就在这座山里面，看到的只是一个方面"}],"answer":"D","explanation":"横看、侧看、远看、近看都不一样。身在山中，反而看不全。","verify":"\"自己就在这座山里面，看到的只是一个方面\""},{"id":"cnc_p252_q1","topicId":"cnc_p252","difficulty":"basic","type":"choice","prompt":"「梅雪争春未肯降」的下一句是哪一句？","choices":[{"key":"A","text":"梅须逊雪三分白"},{"key":"B","text":"骚人阁笔费评章"},{"key":"C","text":"雪却输梅一段香"},{"key":"D","text":"远近高低各不同"}],"answer":"B","explanation":"梅和雪都说自己更能代表春，诗人搁下笔，不好立刻评判。","verify":"\"骚人阁笔费评章\""},{"id":"cnc_p252_q2","topicId":"cnc_p252","difficulty":"basic","type":"choice","prompt":"「梅须逊雪三分白」的下一句是哪一句？","choices":[{"key":"A","text":"骚人阁笔费评章"},{"key":"B","text":"半江瑟瑟半江红"},{"key":"C","text":"雪却输梅一段香"},{"key":"D","text":"只缘身在此山中"}],"answer":"C","explanation":"梅没有雪那么白，雪却没有梅的香。两句是一对。","verify":"\"雪却输梅一段香\""},{"id":"cnc_p252_q3","topicId":"cnc_p252","difficulty":"standard","type":"choice","prompt":"《雪梅》的作者是谁？","choices":[{"key":"A","text":"白居易"},{"key":"B","text":"苏轼"},{"key":"C","text":"王昌龄"},{"key":"D","text":"卢梅坡"}],"answer":"D","explanation":"这首是卢梅坡的。《暮江吟》是白居易的，《题西林壁》是苏轼的。","verify":"\"卢梅坡\""},{"id":"cnc_p252_q4","topicId":"cnc_p252","difficulty":"standard","type":"choice","prompt":"诗人认为梅和雪谁更好？","choices":[{"key":"A","text":"各有各的长处：雪更白，梅有香"},{"key":"B","text":"梅什么都比雪强"},{"key":"C","text":"雪什么都比梅强"},{"key":"D","text":"两者都比不上钱塘江的潮"}],"answer":"A","explanation":"争春未肯降，是因为各有一点别人比不过。不是把另一方说得一无是处。","verify":"\"各有各的长处：雪更白，梅有香\""},{"id":"cnc_p253_q1","topicId":"cnc_p253","difficulty":"basic","type":"choice","prompt":"爬山虎的脚长在哪里？","choices":[{"key":"A","text":"叶子尖上"},{"key":"B","text":"花心里"},{"key":"C","text":"茎上"},{"key":"D","text":"根的最底下，茎上没有"}],"answer":"C","explanation":"叶圣陶写细丝一样的脚长在茎上，不是长在花上。","verify":"\"茎上\""},{"id":"cnc_p253_q2","topicId":"cnc_p253","difficulty":"basic","type":"choice","prompt":"脚触到墙以后会怎样？","choices":[{"key":"A","text":"立刻枯萎"},{"key":"B","text":"变成叶子"},{"key":"C","text":"从墙上缩回来不再爬"},{"key":"D","text":"头上变成小圆片，巴住墙"}],"answer":"D","explanation":"细丝的头一触到墙，就变成小圆片，把爬山虎巴在墙上。","verify":"\"头上变成小圆片，巴住墙\""},{"id":"cnc_p253_q3","topicId":"cnc_p253","difficulty":"standard","type":"choice","prompt":"没有触到墙的脚后来怎样？","choices":[{"key":"A","text":"萎了"},{"key":"B","text":"照样长成小圆片"},{"key":"C","text":"开出花来"},{"key":"D","text":"变成另一种植物"}],"answer":"A","explanation":"课文写不触墙的脚很快就萎了。巴住墙的才会往上爬。","verify":"\"萎了\""},{"id":"cnc_p253_q4","topicId":"cnc_p253","difficulty":"standard","type":"choice","prompt":"作者把爬山虎往上爬的动作写成怎样？","choices":[{"key":"A","text":"一整株同时跳上去"},{"key":"B","text":"一脚一脚地往上爬"},{"key":"C","text":"被人用手拉上去"},{"key":"D","text":"只在地上横着长，从不往上"}],"answer":"B","explanation":"「一脚一脚」写出它换脚巴住、再往前移的样子。","verify":"\"一脚一脚地往上爬\""},{"id":"cnc_p254_q1","topicId":"cnc_p254","difficulty":"basic","type":"choice","prompt":"《蟋蟀的住宅》的作者是谁？","choices":[{"key":"A","text":"叶圣陶"},{"key":"B","text":"安徒生"},{"key":"C","text":"屠格涅夫"},{"key":"D","text":"法布尔"}],"answer":"D","explanation":"这篇是法布尔写昆虫的。叶圣陶写爬山虎，屠格涅夫写麻雀。","verify":"\"法布尔\""},{"id":"cnc_p254_q2","topicId":"cnc_p254","difficulty":"basic","type":"choice","prompt":"蟋蟀的住宅是怎样来的？","choices":[{"key":"A","text":"自己一点一点挖掘出来的"},{"key":"B","text":"捡现成的洞住进去"},{"key":"C","text":"请爬山虎用脚帮它挖"},{"key":"D","text":"女娲用五色石砌的"}],"answer":"A","explanation":"别的昆虫常常占用别人的窝。蟋蟀不肯这样，自己挖。","verify":"\"自己一点一点挖掘出来的\""},{"id":"cnc_p254_q3","topicId":"cnc_p254","difficulty":"standard","type":"choice","prompt":"它的住宅有什么特点？","choices":[{"key":"A","text":"像钱塘江那样排成一条白线"},{"key":"B","text":"倾斜的隧道，有门，里面光滑，门口还有平台"},{"key":"C","text":"和方帽子店一样只开一扇方门"},{"key":"D","text":"建在长城的垛子上"}],"answer":"B","explanation":"选址要排水好、有阳光。内部修得很认真。","verify":"\"倾斜的隧道，有门，里面光滑，门口还有平台\""},{"id":"cnc_p254_q4","topicId":"cnc_p254","difficulty":"standard","type":"choice","prompt":"作者为什么称赞这座住宅？","choices":[{"key":"A","text":"它比长城还长"},{"key":"B","text":"它能在夜里发出超声波"},{"key":"C","text":"小小的蟋蟀把窝做得又好又干净"},{"key":"D","text":"它是用兵马俑砌成的"}],"answer":"C","explanation":"和别的昆虫比，这座住宅更讲究。超声波是蝙蝠，兵马俑是另一课。","verify":"\"小小的蟋蟀把窝做得又好又干净\""},{"id":"cnc_p255_q1","topicId":"cnc_p255","difficulty":"basic","type":"choice","prompt":"已经有的问题被看出来了，该用哪一个？","choices":[{"key":"A","text":"发现"},{"key":"B","text":"发明"},{"key":"C","text":"发生"},{"key":"D","text":"发挥"}],"answer":"A","explanation":"发现是看到本来就存在的事物。发明是创造出原来没有的东西。","verify":"\"发现\""},{"id":"cnc_p255_q2","topicId":"cnc_p255","difficulty":"basic","type":"choice","prompt":"「把缺点改掉」该用哪一个？","choices":[{"key":"A","text":"改进缺点"},{"key":"B","text":"改正缺点"},{"key":"C","text":"改善缺点"},{"key":"D","text":"改变天气"}],"answer":"B","explanation":"缺点用改正。方法、工作才常说改进。","verify":"\"改正缺点\""},{"id":"cnc_p255_q3","topicId":"cnc_p255","difficulty":"standard","type":"choice","prompt":"「他____了一个新工具。」哪一个填得对？","choices":[{"key":"A","text":"发现"},{"key":"B","text":"发生"},{"key":"C","text":"发明"},{"key":"D","text":"发音"}],"answer":"C","explanation":"新工具原来没有，是发明出来的。","verify":"\"发明\""},{"id":"cnc_p255_q4","topicId":"cnc_p255","difficulty":"standard","type":"choice","prompt":"哪一组意思最接近，又能互相说明？","choices":[{"key":"A","text":"发现—发明"},{"key":"B","text":"改正—改进"},{"key":"C","text":"冷—热"},{"key":"D","text":"立刻—马上"}],"answer":"D","explanation":"立刻和马上都是很快。发现和发明、改正和改进不能混用，冷和热是反义词。","verify":"\"立刻—马上\""}]
