[{"id":"cnm_h046_q1","topicId":"cnm_h046","difficulty":"basic","type":"numeric","prompt":"f(x)=log₂x，求 f(16)。","answer":"4","explanation":"2⁴=16，函数值是 4。","verify":"log2(16)"},{"id":"cnm_h046_q2","topicId":"cnm_h046","difficulty":"basic","type":"choice","prompt":"y=log₂x 的定义域是？","choices":[{"key":"A","text":"全体正实数"},{"key":"B","text":"全体实数"},{"key":"C","text":"全体非负实数"},{"key":"D","text":"大于或等于 1 的实数"}],"answer":"A","explanation":"真数必须大于 0，底数已经是常数 2。","verify":"\"全体正实数\""},{"id":"cnm_h046_q3","topicId":"cnm_h046","difficulty":"standard","type":"numeric","prompt":"log₂x=5 时，x 是多少？","answer":"32","explanation":"x=2⁵=32。","verify":"2**5"},{"id":"cnm_h046_q4","topicId":"cnm_h046","difficulty":"standard","type":"choice","prompt":"y=log₂x 的图象经过哪个点？","choices":[{"key":"A","text":"(0，1)"},{"key":"B","text":"(0，0)"},{"key":"C","text":"(1，0)"},{"key":"D","text":"(2，0)"}],"answer":"C","explanation":"任何合法底数的对数，真数为 1 时对数是 0，所以过 (1，0)。","verify":"\"(1，0)\""},{"id":"cnm_h047_q1","topicId":"cnm_h047","difficulty":"basic","type":"choice","prompt":"y=log₂x 在 (0，+∞) 上是？","choices":[{"key":"A","text":"增函数"},{"key":"B","text":"减函数"},{"key":"C","text":"先增后减"},{"key":"D","text":"不单调"}],"answer":"A","explanation":"底数 2 大于 1，对数函数递增。","verify":"\"增函数\""},{"id":"cnm_h047_q2","topicId":"cnm_h047","difficulty":"basic","type":"choice","prompt":"y=log_(1/2) x 在定义域上是？","choices":[{"key":"A","text":"增函数"},{"key":"B","text":"减函数"},{"key":"C","text":"先减后增"},{"key":"D","text":"常函数"}],"answer":"B","explanation":"底数在 0 和 1 之间，对数函数递减。","verify":"\"减函数\""},{"id":"cnm_h047_q3","topicId":"cnm_h047","difficulty":"standard","type":"numeric","prompt":"比较 log₂16 与 log₂4，计算它们的差。","answer":"2","explanation":"4−2=2，差为正，前者更大。","verify":"log2(16)-log2(4)"},{"id":"cnm_h047_q4","topicId":"cnm_h047","difficulty":"standard","type":"numeric","prompt":"log₂x>3 时，x 的一个整数下界可以取 2³ 的下一个整数。2³ 等于多少？","answer":"8","explanation":"因为递增，log₂x>3 就是 x>8。8 本身不满足大于。","verify":"2**3"},{"id":"cnm_h048_q1","topicId":"cnm_h048","difficulty":"basic","type":"numeric","prompt":"计算 log₂(2⁵)。","answer":"5","explanation":"对数与指数互逆，结果就是 5。","verify":"log2(2**5)"},{"id":"cnm_h048_q2","topicId":"cnm_h048","difficulty":"basic","type":"numeric","prompt":"计算 2^(log₂16)。","answer":"16","explanation":"先取对数再作指数，回到真数 16。","verify":"2**log2(16)"},{"id":"cnm_h048_q3","topicId":"cnm_h048","difficulty":"standard","type":"numeric","prompt":"若 f(x)=2^x，f⁻¹(8) 是多少？","answer":"3","explanation":"反函数是 log₂x，log₂8=3。","verify":"log2(8)"},{"id":"cnm_h048_q4","topicId":"cnm_h048","difficulty":"standard","type":"choice","prompt":"y=2^x 与 y=log₂x 的图象关于哪条直线对称？","choices":[{"key":"A","text":"y=x"},{"key":"B","text":"y 轴"},{"key":"C","text":"x 轴"},{"key":"D","text":"y=−x"}],"answer":"A","explanation":"互为反函数的图象关于直线 y=x 对称。","verify":"\"y=x\""}]
