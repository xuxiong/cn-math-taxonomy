[{"difficulty":"basic","type":"numeric","prompt":"12 和 18 的最大公因数是多少？","answer":"6","explanation":"12 的因数有 1、2、3、4、6、12，18 的因数里公有的最大是 6。","verify":"gcd(12,18)","id":"cnm_p158_q1","topicId":"cnm_p158"},{"difficulty":"basic","type":"numeric","prompt":"8 和 12 的最大公因数是多少？","answer":"4","explanation":"公有因数里最大的是 4。","verify":"gcd(8,12)","id":"cnm_p158_q2","topicId":"cnm_p158"},{"difficulty":"standard","type":"numeric","prompt":"18 和 24 的最大公因数是多少？","answer":"6","explanation":"18＝6×3，24＝6×4，最大公因数是 6。","verify":"gcd(18,24)","id":"cnm_p158_q3","topicId":"cnm_p158"},{"difficulty":"challenge","type":"numeric","prompt":"12、18 和 30 这三个数的最大公因数是多少？","answer":"6","explanation":"12 和 18 的最大公因数是 6，6 也能整除 30，所以三个数的最大公因数是 6。","verify":"gcd(gcd(12,18),30)","id":"cnm_p158_q4","topicId":"cnm_p158"},{"difficulty":"basic","type":"numeric","prompt":"4 和 6 的最小公倍数是多少？","answer":"12","explanation":"4 的倍数有 4、8、12、16…，6 的倍数有 6、12、18…，最小的公共倍数是 12。","verify":"lcm(4,6)","id":"cnm_p159_q1","topicId":"cnm_p159"},{"difficulty":"basic","type":"numeric","prompt":"3 和 5 的最小公倍数是多少？","answer":"15","explanation":"3 和 5 只有公因数 1，最小公倍数是 3×5＝15。","verify":"lcm(3,5)","id":"cnm_p159_q2","topicId":"cnm_p159"},{"difficulty":"standard","type":"numeric","prompt":"6 和 8 的最小公倍数是多少？","answer":"24","explanation":"6 的倍数：6、12、18、24…；8 的倍数：8、16、24…。最小是 24。","verify":"lcm(6,8)","id":"cnm_p159_q3","topicId":"cnm_p159"},{"difficulty":"challenge","type":"numeric","prompt":"4、6 和 8 的最小公倍数是多少？","answer":"24","explanation":"4 和 6 的最小公倍数是 12，12 和 8 的最小公倍数是 24。","verify":"lcm(lcm(4,6),8)","id":"cnm_p159_q4","topicId":"cnm_p159"},{"difficulty":"basic","type":"numeric","prompt":"把一张纸平均分成 8 份，涂色的有 5 份。平均分成了几份？","answer":"8","explanation":"分母 8 表示平均分成 8 份，分子 5 表示涂了其中 5 份。","verify":"8","id":"cnm_p165_q1","topicId":"cnm_p165"},{"difficulty":"basic","type":"numeric","prompt":"把一张饼平均分成 4 份，吃了其中 1 份。吃了这张饼的几分之几？","answer":"1/4","explanation":"平均分成 4 份取 1 份，是 1/4。","verify":"Fraction(1,4)","id":"cnm_p165_q2","topicId":"cnm_p165"},{"difficulty":"standard","type":"numeric","prompt":"一盒 12 支彩笔平均分成 3 份，拿出其中 2 份。拿出的彩笔占这盒的几分之几？","answer":"2/3","explanation":"平均分成 3 份，拿出 2 份，是 2/3。与一共有 12 支无关。","verify":"Fraction(2,3)","id":"cnm_p165_q3","topicId":"cnm_p165"},{"difficulty":"challenge","type":"numeric","prompt":"一条绳子平均分成 8 段，用去 3 段。剩下的占全长的几分之几？","answer":"5/8","explanation":"剩下 8－3＝5（段），占全长的 5/8。","verify":"Fraction(8-3,8)","id":"cnm_p165_q4","topicId":"cnm_p165"},{"difficulty":"basic","type":"choice","prompt":"分子比分母小的分数是什么分数？","choices":[{"key":"A","text":"真分数"},{"key":"B","text":"假分数"},{"key":"C","text":"既不是真分数也不是假分数"}],"answer":"A","explanation":"分子比分母小的分数小于 1，是真分数。","verify":"'真分数'","id":"cnm_p166_q1","topicId":"cnm_p166"},{"difficulty":"basic","type":"choice","prompt":"7/4 是哪种分数？","choices":[{"key":"A","text":"假分数"},{"key":"B","text":"真分数"},{"key":"C","text":"不能算分数"}],"answer":"A","explanation":"分子 7 比分母 4 大，7/4 大于 1，是假分数。","verify":"'假分数'","id":"cnm_p166_q2","topicId":"cnm_p166"},{"difficulty":"standard","type":"choice","prompt":"下面哪个是真分数？","choices":[{"key":"A","text":"5/5"},{"key":"B","text":"7/4"},{"key":"C","text":"3/8"},{"key":"D","text":"9/8"}],"answer":"C","explanation":"只有 3/8 的分子比分母小。5/5、7/4、9/8 都是假分数。","verify":"'3/8'","id":"cnm_p166_q3","topicId":"cnm_p166"},{"difficulty":"challenge","type":"numeric","prompt":"在 2/3、5/5、7/4、8/3、1/6 中，假分数有几个？","answer":"3","explanation":"分子大于或等于分母的是假分数：5/5、7/4、8/3，共 3 个。","verify":"sum(1 for a,b in ((2,3),(5,5),(7,4),(8,3),(1,6)) if a>=b)","id":"cnm_p166_q4","topicId":"cnm_p166"},{"difficulty":"basic","type":"numeric","prompt":"把 1/2 的分子和分母同时乘 3，得到的新分数，分母是多少？","answer":"6","explanation":"分母 2×3＝6，分数大小不变，新分数是 3/6。","verify":"2*3","id":"cnm_p167_q1","topicId":"cnm_p167"},{"difficulty":"basic","type":"choice","prompt":"分子和分母同时乘或除以相同的数（0 除外），分数大小怎样？","choices":[{"key":"A","text":"大小不变"},{"key":"B","text":"一定变大"},{"key":"C","text":"一定变成 1"}],"answer":"A","explanation":"这是分数的基本性质：分数大小不变。","verify":"'大小不变'","id":"cnm_p167_q2","topicId":"cnm_p167"},{"difficulty":"standard","type":"numeric","prompt":"把 4/8 的分子和分母同时除以 4，化成的分数是多少？","answer":"1/2","explanation":"4÷4＝1，8÷4＝2，得到 1/2，大小不变。","verify":"Fraction(4,8)","id":"cnm_p167_q3","topicId":"cnm_p167"},{"difficulty":"challenge","type":"numeric","prompt":"一个分数的分子和分母同时乘 4，得到 12/20。原来的分数是多少？","answer":"3/5","explanation":"把 12 和 20 同时除以 4：12÷4＝3，20÷4＝5，原来是 3/5。","verify":"Fraction(12,4)/Fraction(20,4)","id":"cnm_p167_q4","topicId":"cnm_p167"},{"difficulty":"basic","type":"numeric","prompt":"把 6/8 约成最简分数。最简分数是多少？","answer":"3/4","explanation":"分子分母同时除以 2：6/8＝3/4。","verify":"Fraction(6,8)","id":"cnm_p168_q1","topicId":"cnm_p168"},{"difficulty":"basic","type":"numeric","prompt":"把 4/10 约成最简分数。最简分数是多少？","answer":"2/5","explanation":"分子分母同时除以 2：4/10＝2/5。","verify":"Fraction(4,10)","id":"cnm_p168_q2","topicId":"cnm_p168"},{"difficulty":"standard","type":"numeric","prompt":"把 8/12 约成最简分数。最简分数是多少？","answer":"2/3","explanation":"8 和 12 的最大公因数是 4：8/12＝2/3。","verify":"Fraction(8,12)","id":"cnm_p168_q3","topicId":"cnm_p168"},{"difficulty":"challenge","type":"numeric","prompt":"把 18/24 约成最简分数。最简分数是多少？","answer":"3/4","explanation":"18 和 24 的最大公因数是 6：18÷6＝3，24÷6＝4，得 3/4。","verify":"Fraction(18,24)","id":"cnm_p168_q4","topicId":"cnm_p168"},{"difficulty":"basic","type":"numeric","prompt":"比较 3/5 和 1/5 的大小，较大的那个分数是多少？","answer":"3/5","explanation":"分母相同，分子大的分数大，3/5 较大。","verify":"max(Fraction(3,5),Fraction(1,5))","id":"cnm_p169_q1","topicId":"cnm_p169"},{"difficulty":"basic","type":"numeric","prompt":"比较 2/3 和 3/4 的大小，较大的那个分数是多少？","answer":"3/4","explanation":"通分后 8/12＜9/12，所以 3/4 较大。","verify":"max(Fraction(2,3),Fraction(3,4))","id":"cnm_p169_q2","topicId":"cnm_p169"},{"difficulty":"standard","type":"numeric","prompt":"两条同样长的绳子，一条用去 3/8，另一条用去 5/8。用去较多的那条，用去的部分占全长的几分之几？","answer":"5/8","explanation":"分母相同，5/8＞3/8，用去较多的是 5/8。","verify":"max(Fraction(3,8),Fraction(5,8))","id":"cnm_p169_q3","topicId":"cnm_p169"},{"difficulty":"challenge","type":"numeric","prompt":"1/2、2/3 和 3/5 中，最大的分数是多少？","answer":"2/3","explanation":"通分成分母 30：15/30、20/30、18/30。最大的是 20/30，也就是 2/3。","verify":"max(Fraction(1,2),Fraction(2,3),Fraction(3,5))","id":"cnm_p169_q4","topicId":"cnm_p169"},{"difficulty":"basic","type":"numeric","prompt":"把 3/10 写成小数是多少？（用小数作答）","answer":"0.3","explanation":"3/10＝0.3。","verify":"Fraction(3,10)","id":"cnm_p170_q1","topicId":"cnm_p170"},{"difficulty":"basic","type":"numeric","prompt":"把 25/100 写成小数是多少？（用小数作答）","answer":"0.25","explanation":"25/100＝0.25。","verify":"Fraction(25,100)","id":"cnm_p170_q2","topicId":"cnm_p170"},{"difficulty":"standard","type":"numeric","prompt":"把 0.7 写成最简分数是多少？","answer":"7/10","explanation":"0.7 是 7 个 0.1，也就是 7/10。","verify":"Fraction(7,10)","id":"cnm_p170_q3","topicId":"cnm_p170"},{"difficulty":"challenge","type":"numeric","prompt":"把 0.125 化成最简分数是多少？","answer":"1/8","explanation":"0.125＝125/1000。分子分母同时除以 125，得 1/8。","verify":"Fraction(125,1000)","id":"cnm_p170_q4","topicId":"cnm_p170"},{"difficulty":"basic","type":"numeric","prompt":"要把 1/2 和 1/3 通分，最小的公分母是多少？","answer":"6","explanation":"2 和 3 的最小公倍数是 6。","verify":"lcm(2,3)","id":"cnm_p172_q1","topicId":"cnm_p172"},{"difficulty":"basic","type":"numeric","prompt":"把 1/4 和 3/8 通分，最小的公分母是多少？","answer":"8","explanation":"4 和 8 的最小公倍数是 8。","verify":"lcm(4,8)","id":"cnm_p172_q2","topicId":"cnm_p172"},{"difficulty":"standard","type":"numeric","prompt":"把 1/6 和 1/4 通分，最小的公分母是多少？","answer":"12","explanation":"6 和 4 的最小公倍数是 12。","verify":"lcm(6,4)","id":"cnm_p172_q3","topicId":"cnm_p172"},{"difficulty":"challenge","type":"numeric","prompt":"把 2/3 和 3/4 通分，公分母用 12。2/3 化成这个分母后，分子是多少？","answer":"8","explanation":"分母 3 变成 12 要乘 4，分子也同样乘 4：2×4＝8，所以 2/3＝8/12。","verify":"2*12//3","id":"cnm_p172_q4","topicId":"cnm_p172"}]
