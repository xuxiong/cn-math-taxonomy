[{"difficulty":"basic","type":"choice","prompt":"面向黑板站好，你正对着的那一边叫什么？","choices":[{"key":"A","text":"前面"},{"key":"B","text":"后面"},{"key":"C","text":"左边"}],"answer":"A","explanation":"正对着的那一边是前面。","verify":"'前面'","id":"cnm_p015_q1","topicId":"cnm_p015"},{"difficulty":"basic","type":"choice","prompt":"面向黑板站好，左手那边叫什么？","choices":[{"key":"A","text":"左面"},{"key":"B","text":"右面"},{"key":"C","text":"后面"}],"answer":"A","explanation":"左手那边是左面，右手那边是右面。","verify":"'左面'","id":"cnm_p015_q2","topicId":"cnm_p015"},{"difficulty":"standard","type":"choice","prompt":"小明的前面是小红。小红的后面是谁？","choices":[{"key":"A","text":"小明"},{"key":"B","text":"小红"},{"key":"C","text":"不能确定"}],"answer":"A","explanation":"小红在小明前面，所以小红的后面就是小明。","verify":"'小明'","id":"cnm_p015_q3","topicId":"cnm_p015"},{"difficulty":"challenge","type":"choice","prompt":"小红站在小明前面，小刚站在小红前面。谁在最前面？","choices":[{"key":"A","text":"小刚"},{"key":"B","text":"小明"},{"key":"C","text":"小红"}],"answer":"A","explanation":"小刚在小红前面，小红又在小明前面，所以小刚在最前面。","verify":"'小刚'","id":"cnm_p015_q4","topicId":"cnm_p015"},{"difficulty":"basic","type":"choice","prompt":"分类要先定标准。把铅笔按颜色分开，要先确定什么？","choices":[{"key":"A","text":"分类标准"},{"key":"B","text":"一共有多少支"},{"key":"C","text":"哪支最长"}],"answer":"A","explanation":"先定按什么分，才能把物品分成不同的类。","verify":"'分类标准'","id":"cnm_p022_q1","topicId":"cnm_p022"},{"difficulty":"basic","type":"numeric","prompt":"图形里有三角形、圆和长方形。按形状分成了几类？","answer":"3","explanation":"一种形状是一类，三种形状就是 3 类。","verify":"3","id":"cnm_p022_q2","topicId":"cnm_p022"},{"difficulty":"standard","type":"choice","prompt":"苹果、香蕉和皮球放在一起。按「是不是水果」来分，皮球应该在哪一类？","choices":[{"key":"A","text":"不是水果"},{"key":"B","text":"水果"},{"key":"C","text":"和苹果同一类"}],"answer":"A","explanation":"皮球不是水果，要单独分成「不是水果」。","verify":"'不是水果'","id":"cnm_p022_q3","topicId":"cnm_p022"},{"difficulty":"challenge","type":"numeric","prompt":"三角形有 4 个，圆有 3 个。按形状分类后，三角形这一类有几个？","answer":"4","explanation":"问的是三角形这一类，就是 4 个，不要把圆加进去。","verify":"4","id":"cnm_p022_q4","topicId":"cnm_p022"}]
