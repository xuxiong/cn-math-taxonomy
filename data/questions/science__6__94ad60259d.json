[{"id":"cns_p210_q1","topicId":"cns_p210","difficulty":"basic","type":"choice","prompt":"调查校园生物时，下面哪种做法正确？","choices":[{"key":"A","text":"把动物都捉回家"},{"key":"B","text":"把花草都拔掉"},{"key":"C","text":"踩死昆虫"},{"key":"D","text":"观察记录，不伤害生物"}],"answer":"D","explanation":"调查要爱护生物。","verify":"\"观察记录，不伤害生物\""},{"id":"cns_p210_q2","topicId":"cns_p210","difficulty":"basic","type":"choice","prompt":"校园生物分布图主要用来表示什么？","choices":[{"key":"A","text":"各种生物在校园里的分布位置"},{"key":"B","text":"学生的座位"},{"key":"C","text":"老师的办公室"},{"key":"D","text":"上课时间"}],"answer":"A","explanation":"分布图记录生物生活的位置。","verify":"\"各种生物在校园里的分布位置\""},{"id":"cns_p210_q3","topicId":"cns_p210","difficulty":"standard","type":"choice","prompt":"在校园阴暗潮湿的墙角，最可能找到什么？","choices":[{"key":"A","text":"向日葵"},{"key":"B","text":"苔藓和鼠妇"},{"key":"C","text":"仙人掌"},{"key":"D","text":"麻雀巢"}],"answer":"B","explanation":"苔藓、鼠妇喜欢阴湿环境。","verify":"\"苔藓和鼠妇\""},{"id":"cns_p210_q4","topicId":"cns_p210","difficulty":"challenge","type":"choice","prompt":"对不认识的植物，最好的办法是什么？","choices":[{"key":"A","text":"随便起个名字"},{"key":"B","text":"尝一尝"},{"key":"C","text":"拍照后查图鉴或请教老师"},{"key":"D","text":"不记录"}],"answer":"C","explanation":"借助工具书准确识别。","verify":"\"拍照后查图鉴或请教老师\""},{"id":"cns_p211_q1","topicId":"cns_p211","difficulty":"basic","type":"choice","prompt":"下面哪种植物不开花？","choices":[{"key":"A","text":"蕨类植物（如肾蕨）"},{"key":"B","text":"桃树"},{"key":"C","text":"向日葵"},{"key":"D","text":"水稻"}],"answer":"A","explanation":"蕨类用孢子繁殖，不开花。","verify":"\"蕨类植物（如肾蕨）\""},{"id":"cns_p211_q2","topicId":"cns_p211","difficulty":"basic","type":"choice","prompt":"苔藓植物一般生活在什么地方？","choices":[{"key":"A","text":"干燥的沙漠"},{"key":"B","text":"阴暗潮湿的地方"},{"key":"C","text":"滚烫的岩石"},{"key":"D","text":"深海底"}],"answer":"B","explanation":"苔藓需要湿润的环境。","verify":"\"阴暗潮湿的地方\""},{"id":"cns_p211_q3","topicId":"cns_p211","difficulty":"standard","type":"choice","prompt":"松树的种子外面没有果皮包被，它属于什么植物？","choices":[{"key":"A","text":"被子植物"},{"key":"B","text":"蕨类植物"},{"key":"C","text":"裸子植物"},{"key":"D","text":"藻类植物"}],"answer":"C","explanation":"种子裸露的是裸子植物。","verify":"\"裸子植物\""},{"id":"cns_p211_q4","topicId":"cns_p211","difficulty":"challenge","type":"choice","prompt":"给植物分类，下面哪个标准最科学？","choices":[{"key":"A","text":"叶子好不好看"},{"key":"B","text":"价格高低"},{"key":"C","text":"名字长短"},{"key":"D","text":"是否开花、有无种子等结构特征"}],"answer":"D","explanation":"分类要根据生物的结构特征。","verify":"\"是否开花、有无种子等结构特征\""},{"id":"cns_p212_q1","topicId":"cns_p212","difficulty":"basic","type":"choice","prompt":"下面哪种动物是无脊椎动物？","choices":[{"key":"A","text":"青蛙"},{"key":"B","text":"蜗牛"},{"key":"C","text":"猫"},{"key":"D","text":"麻雀"}],"answer":"B","explanation":"蜗牛体内没有脊柱。","verify":"\"蜗牛\""},{"id":"cns_p212_q2","topicId":"cns_p212","difficulty":"basic","type":"choice","prompt":"鲸生活在海里，为什么属于哺乳动物而不是鱼？","choices":[{"key":"A","text":"鲸很大"},{"key":"B","text":"鲸会游泳"},{"key":"C","text":"鲸用肺呼吸、胎生哺乳"},{"key":"D","text":"鲸吃鱼"}],"answer":"C","explanation":"分类看主要特征。","verify":"\"鲸用肺呼吸、胎生哺乳\""},{"id":"cns_p212_q3","topicId":"cns_p212","difficulty":"standard","type":"choice","prompt":"青蛙幼体用鳃呼吸，成体主要用肺呼吸，皮肤辅助呼吸，它属于哪类？","choices":[{"key":"A","text":"鱼类"},{"key":"B","text":"爬行动物"},{"key":"C","text":"哺乳动物"},{"key":"D","text":"两栖动物"}],"answer":"D","explanation":"这是两栖动物的特点。","verify":"\"两栖动物\""},{"id":"cns_p212_q4","topicId":"cns_p212","difficulty":"challenge","type":"choice","prompt":"下面哪种动物属于爬行动物？","choices":[{"key":"A","text":"蜥蜴"},{"key":"B","text":"蝾螈"},{"key":"C","text":"蝙蝠"},{"key":"D","text":"海豚"}],"answer":"A","explanation":"蜥蜴体表有鳞片、用肺呼吸、在陆地产卵。","verify":"\"蜥蜴\""},{"id":"cns_p213_q1","topicId":"cns_p213","difficulty":"basic","type":"choice","prompt":"孩子长得像父母，这种现象叫什么？","choices":[{"key":"A","text":"变异"},{"key":"B","text":"进化"},{"key":"C","text":"遗传"},{"key":"D","text":"适应"}],"answer":"C","explanation":"亲代特征传给子代叫遗传。","verify":"\"遗传\""},{"id":"cns_p213_q2","topicId":"cns_p213","difficulty":"basic","type":"choice","prompt":"兄弟姐妹长得不完全一样，这种现象叫什么？","choices":[{"key":"A","text":"遗传"},{"key":"B","text":"繁殖"},{"key":"C","text":"冬眠"},{"key":"D","text":"变异"}],"answer":"D","explanation":"子代之间、子代和亲代之间的差异叫变异。","verify":"\"变异\""},{"id":"cns_p213_q3","topicId":"cns_p213","difficulty":"standard","type":"choice","prompt":"下面哪一项是可以遗传的特征？","choices":[{"key":"A","text":"能否卷舌"},{"key":"B","text":"说的方言"},{"key":"C","text":"穿的衣服"},{"key":"D","text":"后天的伤疤"}],"answer":"A","explanation":"卷舌能力由遗传决定。","verify":"\"能否卷舌\""},{"id":"cns_p213_q4","topicId":"cns_p213","difficulty":"challenge","type":"choice","prompt":"「一母生九子，九子各不同」说明了什么？","choices":[{"key":"A","text":"没有遗传"},{"key":"B","text":"生物存在变异"},{"key":"C","text":"生物不会繁殖"},{"key":"D","text":"所有孩子一样"}],"answer":"B","explanation":"同一父母的孩子也有差异。","verify":"\"生物存在变异\""},{"id":"cns_p214_q1","topicId":"cns_p214","difficulty":"basic","type":"choice","prompt":"研究古代生物最重要的证据是什么？","choices":[{"key":"A","text":"传说"},{"key":"B","text":"动画片"},{"key":"C","text":"玩具"},{"key":"D","text":"化石"}],"answer":"D","explanation":"化石记录了古代生物。","verify":"\"化石\""},{"id":"cns_p214_q2","topicId":"cns_p214","difficulty":"basic","type":"choice","prompt":"下面哪种动物是我国特有的珍稀动物？","choices":[{"key":"A","text":"大熊猫"},{"key":"B","text":"袋鼠"},{"key":"C","text":"长颈鹿"},{"key":"D","text":"企鹅"}],"answer":"A","explanation":"大熊猫是我国特有物种。","verify":"\"大熊猫\""},{"id":"cns_p214_q3","topicId":"cns_p214","difficulty":"standard","type":"choice","prompt":"保护生物多样性最有效的措施是什么？","choices":[{"key":"A","text":"大量捕猎"},{"key":"B","text":"建立自然保护区"},{"key":"C","text":"砍伐森林"},{"key":"D","text":"引进大量外来物种"}],"answer":"B","explanation":"就地保护是最有效的方法。","verify":"\"建立自然保护区\""},{"id":"cns_p214_q4","topicId":"cns_p214","difficulty":"challenge","type":"choice","prompt":"一种生物灭绝后会怎样？","choices":[{"key":"A","text":"很快又会出现"},{"key":"B","text":"对别的生物没有影响"},{"key":"C","text":"无法再生，可能影响其他生物"},{"key":"D","text":"能用机器造出来"}],"answer":"C","explanation":"物种灭绝不可逆，会影响食物网。","verify":"\"无法再生，可能影响其他生物\""}]
