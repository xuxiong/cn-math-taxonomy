[{"id":"cnh_j077_q1","topicId":"cnh_j077","difficulty":"basic","type":"choice","prompt":"1992年邓小平视察南方并发表谈话，强调？","choices":[{"key":"A","text":"取消经济特区"},{"key":"B","text":"恢复人民公社"},{"key":"C","text":"计划和市场都是经济手段"},{"key":"D","text":"停止对外开放"}],"answer":"C","explanation":"南方谈话进一步解放了人们的思想。","verify":"\"计划和市场都是经济手段\""},{"id":"cnh_j077_q2","topicId":"cnh_j077","difficulty":"basic","type":"choice","prompt":"中共十四大确定我国经济体制改革的目标是？","choices":[{"key":"A","text":"建立计划经济体制"},{"key":"B","text":"取消商品交换"},{"key":"C","text":"只发展农村经济"},{"key":"D","text":"建立社会主义市场经济体制"}],"answer":"D","explanation":"1992年十四大提出建立社会主义市场经济体制。","verify":"\"建立社会主义市场经济体制\""},{"id":"cnh_j077_q3","topicId":"cnh_j077","difficulty":"standard","type":"choice","prompt":"1990年国家决定开发开放的地区是？","choices":[{"key":"A","text":"上海浦东"},{"key":"B","text":"深圳"},{"key":"C","text":"海南"},{"key":"D","text":"青岛"}],"answer":"A","explanation":"浦东开发开放成为国家经济发展的重大战略步骤。深圳、海南的开放早于1990年。","verify":"\"上海浦东\""},{"id":"cnh_j077_q4","topicId":"cnh_j077","difficulty":"challenge","type":"choice","prompt":"南方谈话和十四大的先后顺序是？","choices":[{"key":"A","text":"十四大在南方谈话之前十年"},{"key":"B","text":"1992年初南方谈话，同年十四大召开"},{"key":"C","text":"两者都在1978年"},{"key":"D","text":"两者都在2001年"}],"answer":"B","explanation":"谈话推动了十四大的决策。","verify":"\"1992年初南方谈话，同年十四大召开\""},{"id":"cnh_j078_q1","topicId":"cnh_j078","difficulty":"basic","type":"choice","prompt":"1997年中共十五大把什么确立为党的指导思想？","choices":[{"key":"A","text":"毛泽东思想首次写入"},{"key":"B","text":"三个代表"},{"key":"C","text":"科学发展观"},{"key":"D","text":"邓小平理论"}],"answer":"D","explanation":"十五大把邓小平理论写入党章。","verify":"\"邓小平理论\""},{"id":"cnh_j078_q2","topicId":"cnh_j078","difficulty":"basic","type":"choice","prompt":"香港回归祖国是在？","choices":[{"key":"A","text":"1997年7月1日"},{"key":"B","text":"1999年12月20日"},{"key":"C","text":"1984年12月19日"},{"key":"D","text":"1997年6月30日"}],"answer":"A","explanation":"1997年7月1日，中国政府对香港恢复行使主权。1984年12月19日是中英联合声明签署日。","verify":"\"1997年7月1日\""},{"id":"cnh_j078_q3","topicId":"cnh_j078","difficulty":"standard","type":