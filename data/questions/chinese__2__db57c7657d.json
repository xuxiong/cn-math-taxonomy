[{"id":"cnc_p154_q1","topicId":"cnc_p154","difficulty":"basic","type":"choice","prompt":"故事开头，天上同时出现了几个太阳？","choices":[{"key":"A","text":"一个"},{"key":"B","text":"九个"},{"key":"C","text":"两个"},{"key":"D","text":"十个"}],"answer":"D","explanation":"十个太阳一起烤着大地，庄稼枯了，人们受不了。","verify":"\"十个\""},{"id":"cnc_p154_q2","topicId":"cnc_p154","difficulty":"basic","type":"choice","prompt":"羿射下了几个太阳？","choices":[{"key":"A","text":"九个"},{"key":"B","text":"十个"},{"key":"C","text":"一个"},{"key":"D","text":"一个也没射下"}],"answer":"A","explanation":"他留下人们还需要的那一个，射下了另外九个。","verify":"\"九个\""},{"id":"cnc_p154_q3","topicId":"cnc_p154","difficulty":"standard","type":"choice","prompt":"为什么不能把太阳全部射下来？","choices":[{"key":"A","text":"太阳太小，射不中"},{"key":"B","text":"人们还要靠剩下的太阳得到光明和温暖"},{"key":"C","text":"弓箭不够十支"},{"key":"D","text":"九个太阳自己先落下去了"}],"answer":"B","explanation":"没有太阳，世界会又黑又冷。所以要留下一个。","verify":"\"人们还要靠剩下的太阳得到光明和温暖\""},{"id":"cnc_p154_q4","topicId":"cnc_p154","difficulty":"standard","type":"choice","prompt":"十个太阳造成的灾害是什么？","choices":[{"key":"A","text":"洪水把房屋冲走"},{"key":"B","text":"泥塘卖不出去"},{"key":"C","text":"大地被烤焦，庄稼枯死"},{"key":"D","text":"小毛虫不会飞"}],"answer":"C","explanation":"这篇是炎热和干旱。洪水是《大禹治水》里的灾害。","verify":"\"大地被烤焦，庄稼枯死\""},{"id":"cnc_p155_q1","topicId":"cnc_p155","difficulty":"basic","type":"choice","prompt":"课文里的黄帝又被称作什么？","choices":[{"key":"A","text":"轩辕"},{"key":"B","text":"大禹"},{"key":"C","text":"羿"},{"key":"D","text":"雷锋"}],"answer":"A","explanation":"课文称他轩辕。大禹、羿是另外两篇传说里的人物。","verify":"\"轩辕\""},{"id":"cnc_p155_q2","topicId":"cnc_p155","difficulty":"basic","type":"choice","prompt":"他看见什么，想到要造车？","choices":[{"key":"A","text":"蚂蚁在树叶上漂"},{"key":"B","text":"风吹着草帽在地上滚"},{"key":"C","text":"十个太阳一起出来"},{"key":"D","text":"喜鹊在教弟弟唱歌"}],"answer":"B","explanation":"草帽骨碌碌地滚，让他想到轮子和车。","verify":"\"风吹着草帽在地上滚\""},{"id":"cnc_p155_q3","topicId":"cnc_p155","difficulty":"standard","type":"choice","prompt":"他看见什么，想到要造船？","choices":[{"key":"A","text":"草帽滚下山"},{"key":"B","text":"柏树苗不直"},{"key":"C","text":"枯叶漂在水上，蚂蚁趴在叶子上"},{"key":"D","text":"羊圈破了个窟窿"}],"answer":"C","explanation":"树叶能浮在水面，人也可以坐在船上过河。","verify":"\"枯叶漂在水上，蚂蚁趴在叶子上\""},{"id":"cnc_p155_q4","topicId":"cnc_p155","difficulty":"standard","type":"choice","prompt":"车和船改善了什么？","choices":[{"key":"A","text":"天上太阳的个数"},{"key":"B","text":"泥塘的价钱"},{"key":"C","text":"喜鹊的语言"},{"key":"D","text":"路上和水上的来往"}],"answer":"D","explanation":"有了车和船，走远路、过河都方便了。","verify":"\"路上和水上的来往\""},{"id":"cnc_p156_q1","topicId":"cnc_p156","difficulty":"basic","type":"choice","prompt":"洪水泛滥时，人们的生活怎样？","choices":[{"key":"A","text":"到处都是十个太阳"},{"key":"B","text":"田地被淹，房屋被冲毁"},{"key":"C","text":"泥塘卖得很好"},{"key":"D","text":"只要把窗关上就行"}],"answer":"B","explanation":"大水淹没田地，冲毁房屋，人们痛苦极了。","verify":"\"田地被淹，房屋被冲毁\""},{"id":"cnc_p156_q2","topicId":"cnc_p156","difficulty":"basic","type":"choice","prompt":"只把水堵住，和禹的办法有什么不同？","choices":[{"key":"A","text":"禹也是把所有出口都堵死"},{"key":"B","text":"禹没有带领人们干活"},{"key":"C","text":"禹是疏导，把河道挖通，不是只靠堵"},{"key":"D","text":"禹把洪水引进家里"}],"answer":"C","explanation":"堵住容易再决口。禹开山挖河，给洪水找出去的路。","verify":"\"禹是疏导，把河道挖通，不是只靠堵\""},{"id":"cnc_p156_q3","topicId":"cnc_p156","difficulty":"standard","type":"choice","prompt":"挖通河道以后，洪水怎样了？","choices":[{"key":"A","text":"变成了十个太阳"},{"key":"B","text":"留在羊圈里"},{"key":"C","text":"被蜘蛛织成围巾"},{"key":"D","text":"流进了大海"}],"answer":"D","explanation":"水有了去路，才不再到处泛滥。","verify":"\"流进了大海\""},{"id":"cnc_p156_q4","topicId":"cnc_p156","difficulty":"standard","type":"choice","prompt":"人们后来怎样称呼他？","choices":[{"key":"A","text":"大禹"},{"key":"B","text":"轩辕"},{"key":"C","text":"羿"},{"key":"D","text":"雷锋叔叔"}],"answer":"A","explanation":"洪水退去，百姓安居，人们尊敬地称他大禹。","verify":"\"大禹\""},{"id":"cnc_p157_q1","topicId":"cnc_p157","difficulty":"basic","type":"choice","prompt":"「江上往来人」的下一句是哪一句？","choices":[{"key":"A","text":"君看一叶舟"},{"key":"B","text":"出没风波里"},{"key":"C","text":"但爱鲈鱼美"},{"key":"D","text":"映日荷花别样红"}],"answer":"C","explanation":"人们喜爱的是鲈鱼的鲜美，后面才写一叶小舟出没在风波里。荷花是杨万里的诗。","verify":"\"但爱鲈鱼美\""},{"id":"cnc_p157_q2","topicId":"cnc_p157","difficulty":"basic","type":"choice","prompt":"「出没风波里」的「没」读哪一个？","choices":[{"key":"A","text":"méi（没有的没）"},{"key":"B","text":"mò 的第二声"},{"key":"C","text":"méi 的第四声"},{"key":"D","text":"mò（出没的没）"}],"answer":"D","explanation":"出没读 mò，是隐隐现现。没有的没才读 méi。作者是范仲淹。","verify":"\"mò（出没的没）\""},{"id":"cnc_p157_q3","topicId":"cnc_p157","difficulty":"standard","type":"choice","prompt":"哪一句把「高兴极了」写具体了？","choices":[{"key":"A","text":"他高兴极了，蹦蹦跳跳地跑过去。"},{"key":"B","text":"他高兴极了。"},{"key":"C","text":"他高兴高兴极了极了。"},{"key":"D","text":"极了高兴他。"}],"answer":"A","explanation":"园地里把心情和行动配在一起。蹦蹦跳跳写出了高兴的样子。伤心则可以写成哭哭啼啼。","verify":"\"他高兴极了，蹦蹦跳跳地跑过去。\""},{"id":"cnc_p157_q4","topicId":"cnc_p157","difficulty":"standard","type":"choice","prompt":"写一件小事，哪一段顺序对？","choices":[{"key":"A","text":"我出门，然后才起床，接着已经到了学校。"},{"key":"B","text":"我先起床，接着洗脸，然后吃早饭，最后背上书包出门。"},{"key":"C","text":"最后吃饭，先到学校，接着起床。"},{"key":"D","text":"书包早饭洗脸出门。"}],"answer":"B","explanation":"先、接着、然后、最后，要符合事情真正发生的次序。","verify":"\"我先起床，接着洗脸，然后吃早饭，最后背上书包出门。\""}]
