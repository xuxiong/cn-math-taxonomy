[{"id":"cnp_024_q1","topicId":"cnp_024","difficulty":"basic","type":"choice","prompt":"由两个凸透镜组成的望远镜，靠近眼睛的透镜叫什么？","choices":[{"key":"A","text":"物镜"},{"key":"B","text":"目镜"},{"key":"C","text":"反光镜"},{"key":"D","text":"凹透镜"}],"answer":"B","explanation":"靠近眼睛的是目镜，靠近被观察物体的是物镜。","verify":"\"目镜\""},{"id":"cnp_024_q2","topicId":"cnp_024","difficulty":"basic","type":"choice","prompt":"望远镜的物镜对远处物体成什么像？","choices":[{"key":"A","text":"正立、放大的虚像"},{"key":"B","text":"倒立、缩小的实像"},{"key":"C","text":"倒立、放大的实像"},{"key":"D","text":"正立、缩小的虚像"}],"answer":"B","explanation":"远处物体在物镜 2 倍焦距以外，物镜成倒立、缩小的实像。","verify":"\"倒立、缩小的实像\""},{"id":"cnp_024_q3","topicId":"cnp_024","difficulty":"standard","type":"choice","prompt":"望远镜的目镜起什么作用？","choices":[{"key":"A","text":"相当于照相机"},{"key":"B","text":"相当于投影仪"},{"key":"C","text":"把光线发散掉"},{"key":"D","text":"相当于放大镜，把物镜成的像放大"}],"answer":"D","explanation":"物镜所成的像在目镜焦点以内，目镜成正立、放大的虚像。","verify":"\"相当于放大镜，把物镜成的像放大\""},{"id":"cnp_024_q4","topicId":"cnp_024","difficulty":"standard","type":"choice","prompt":"用两个凸透镜做望远镜，手上有焦距 50 cm 和 5 cm 的透镜，物镜应选哪一个？","choices":[{"key":"A","text":"焦距 5 cm 的透镜"},{"key":"B","text":"焦距 50 cm 的透镜"},{"key":"C","text":"两个都可以"},{"key":"D","text":"必须用凹透镜"}],"answer":"B","explanation":"开普勒望远镜的物镜焦距长、目镜焦距短，物镜选 50 cm 的透镜。","verify":"\"焦距 50 cm 的透镜\""}]
