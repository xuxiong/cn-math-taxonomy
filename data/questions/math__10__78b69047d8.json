[{"id":"cnm_h064_q1","topicId":"cnm_h064","difficulty":"basic","type":"choice","prompt":"sin(180°−α) 等于？","choices":[{"key":"A","text":"−sinα"},{"key":"B","text":"sinα"},{"key":"C","text":"cosα"},{"key":"D","text":"−cosα"}],"answer":"B","explanation":"180°−α 与 α 的正弦相等。","verify":"\"sinα\""},{"id":"cnm_h064_q2","topicId":"cnm_h064","difficulty":"basic","type":"choice","prompt":"cos(180°−α) 等于？","choices":[{"key":"A","text":"cosα"},{"key":"B","text":"sinα"},{"key":"C","text":"−cosα"},{"key":"D","text":"−sinα"}],"answer":"C","explanation":"落到第二象限时，余弦变号。","verify":"\"−cosα\""},{"id":"cnm_h064_q3","topicId":"cnm_h064","difficulty":"standard","type":"numeric","prompt":"用诱导公式，sin150° 等于 sin 多少度？只写这个锐角的度数。","answer":"30","explanation":"sin(180°−30°)=sin30°，对应的锐角是 30°。","verify":"30"},{"id":"cnm_h064_q4","topicId":"cnm_h064","difficulty":"standard","type":"choice","prompt":"诱导公式的作用主要是？","choices":[{"key":"A","text":"把任意角的三角函数化为锐角三角函数"},{"key":"B","text":"只用来求 90°"},{"key":"C","text":"代替弧度制"},{"key":"D","text":"只能用于正切"}],"answer":"A","explanation":"公式把角变到 0° 到 90°，再使用特殊角的值。","verify":"\"把任意角的三角函数化为锐角三角函数\""},{"id":"cnm_h065_q1","topicId":"cnm_h065","difficulty":"basic","type":"numeric","prompt":"求 sin150°。","answer":"1/2","explanation":"sin(180°−30°)=sin30°=1/2。","verify":"sin(radians(150))"},{"id":"cnm_h065_q2","topicId":"cnm_h065","difficulty":"basic","type":"numeric","prompt":"求 cos120°。","answer":"-1/2","explanation":"cos(180°−60°)=−cos60°=−1/2。","verify":"cos(radians(120))"},{"id":"cnm_h065_q3","topicId":"cnm_h065","difficulty":"standard","type":"numeric","prompt":"求 sin210°。","answer":"-1/2","explanation":"sin(180°+30°)=−sin30°=−1/2。","verify":"sin(radians(210))"},{"id":"cnm_h065_q4","topicId":"cnm_h065","difficulty":"standard","type":"numeric","prompt":"求 cos360°。","answer":"1","explanation":"与 0° 终边相同，余弦是 1。","verify":"cos(radians(360))"}]
