[{"id":"cnm_h172_q1","topicId":"cnm_h172","difficulty":"basic","type":"numeric","prompt":"直线 x+y=5 与 x−y=1 的交点横坐标是多少？","answer":"3","explanation":"两式相加得 2x=6，x=3。纵坐标是 2。","verify":"solve2(1,1,5,1,-1,1)[0]"},{"id":"cnm_h172_q2","topicId":"cnm_h172","difficulty":"basic","type":"numeric","prompt":"直线 x+y=5 与 x−y=1 的交点纵坐标是多少？","answer":"2","explanation":"两式相减得 2y=4，y=2。","verify":"solve2(1,1,5,1,-1,1)[1]"},{"id":"cnm_h172_q3","topicId":"cnm_h172","difficulty":"standard","type":"numeric","prompt":"直线 y=2x 与 y=x+3 的交点横坐标是多少？","answer":"3","explanation":"2x=x+3，所以 x=3，y=6。","verify":"3"},{"id":"cnm_h172_q4","topicId":"cnm_h172","difficulty":"standard","type":"choice","prompt":"两条斜率都存在且相等的不重合直线，交点有几个？","choices":[{"key":"A","text":"0 个"},{"key":"B","text":"恰好 1 个"},{"key":"C","text":"恰好 2 个"},{"key":"D","text":"无穷多个"}],"answer":"A","explanation":"斜率相等且不是同一条直线，两条直线平行，没有交点。","verify":"\"0 个\""},{"id":"cnm_h173_q1","topicId":"cnm_h173","difficulty":"basic","type":"numeric","prompt":"(1，2) 与 (4，6) 的距离是多少？","answer":"5","explanation":"横差 3，纵差 4，距离 √(9+16)=5。","verify":"isqrt((4-1)**2+(6-2)**2)"},{"id":"cnm_h173_q2","topicId":"cnm_h173","difficulty":"basic","type":"numeric","prompt":"(0，0) 与 (5，12) 的距离是多少？","answer":"13","explanation":"√(25+144)=√169=13。","verify":"isqrt(25+144)"},{"id":"cnm_h173_q3","topicId":"cnm_h173","difficulty":"standard","type":"numeric","prompt":"(−1，2) 与 (2，2) 的距离是多少？","answer":"3","explanation":"纵坐标相同，距离就是横坐标之差的绝对值 3。","verify":"isqrt((2-(-1))**2+(2-2)**2)"},{"id":"cnm_h173_q4","topicId":"cnm_h173","difficulty":"standard","type":"choice","prompt":"两点距离公式直接依靠的是哪一条定理？","choices":[{"key":"A","text":"正弦定理"},{"key":"B","text":"勾股定理"},{"key":"C","text":"切割线定理"},{"key":"D","text":"中位线定理"}],"answer":"B","explanation":"横差和纵差是直角边，距离是斜边。","verify":"\"勾股定理\""},{"id":"cnm_h174_q1","topicId":"cnm_h174","difficulty":"basic","type":"numeric","prompt":"原点到直线 3x+4y−10=0 的距离是多少？","answer":"2","explanation":"分子是 10，分母是 5，距离是 2。","verify":"Fraction(abs(3*0+4*0-10), isqrt(9+16))"},{"id":"cnm_h174_q2","topicId":"cnm_h174","difficulty":"basic","type":"numeric","prompt":"点 (1，1) 到直线 x+y−2=0 的距离是多少？","answer":"0","explanation":"分子是 0，点在直线上，距离是 0。","verify":"Fraction(abs(1+1-2), isqrt(1+1))"},{"id":"cnm_h174_q3","topicId":"cnm_h174","difficulty":"standard","type":"numeric","prompt":"点 (1，2) 到直线 x−y+1=0 的距离的分子绝对值是多少？","answer":"0","explanation":"代入得 |1−2+1|=0。分母是 √2，距离本身是 0。","verify":"abs(1-2+1)"},{"id":"cnm_h174_q4","topicId":"cnm_h174","difficulty":"standard","type":"choice","prompt":"点在直线上时，点到直线的距离是多少？","choices":[{"key":"A","text":"等于 1"},{"key":"B","text":"等于直线的斜率"},{"key":"C","text":"0"},{"key":"D","text":"不能用公式"}],"answer":"C","explanation":"点的坐标满足直线方程，分子是 0，距离是 0。","verify":"\"0\""},{"id":"cnm_h175_q1","topicId":"cnm_h175","difficulty":"basic","type":"numeric","prompt":"平行直线 3x+4y−1=0 与 3x+4y−11=0 的距离是多少？","answer":"2","explanation":"分子 |−1+11|=10，分母 5，距离是 2。","verify":"Fraction(abs(-1-(-11)), isqrt(9+16))"},{"id":"cnm_h175_q2","topicId":"cnm_h175","difficulty":"basic","type":"numeric","prompt":"平行直线 x−y+1=0 与 x−y−3=0 的距离，分子 |C1−C2| 是多少？","answer":"4","explanation":"常数项分别是 1 和 −3，差的绝对值是 4。","verify":"abs(1-(-3))"},{"id":"cnm_h175_q3","topicId":"cnm_h175","difficulty":"standard","type":"choice","prompt":"两条直线不平行时，还能谈它们之间的距离吗？","choices":[{"key":"A","text":"能，仍用平行线公式"},{"key":"B","text":"能，距离一定是 0"},{"key":"C","text":"不能，相交直线没有统一距离"},{"key":"D","text":"能，距离一定是 1"}],"answer":"C","explanation":"只有平行直线上的点到另一条直线的距离才处处相等。","verify":"\"不能，相交直线没有统一距离\""},{"id":"cnm_h175_q4","topicId":"cnm_h175","difficulty":"standard","type":"numeric","prompt":"平行直线 5x+12y+1=0 与 5x+12y−25=0 的距离是多少？","answer":"2","explanation":"分子 26，分母 13，距离是 2。","verify":"Fraction(abs(1-(-25)), isqrt(25+144))"}]
