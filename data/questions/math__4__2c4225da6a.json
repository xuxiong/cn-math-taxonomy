[{"difficulty":"basic","type":"numeric","prompt":"两个数相加得 36，其中一个加数是 15。另一个加数是多少？","answer":"21","explanation":"和减去一个加数等于另一个加数：36－15＝21。","verify":"36-15","id":"cnm_p110_q1","topicId":"cnm_p110"},{"difficulty":"basic","type":"numeric","prompt":"两个因数的积是 48，其中一个因数是 6。另一个因数是多少？","answer":"8","explanation":"积除以一个因数等于另一个因数：48÷6＝8。","verify":"48//6","id":"cnm_p110_q2","topicId":"cnm_p110"},{"difficulty":"standard","type":"numeric","prompt":"两个数相加得 70，其中一个是 28。另一个是多少？","answer":"42","explanation":"70－28＝42。","verify":"70-28","id":"cnm_p110_q3","topicId":"cnm_p110"},{"difficulty":"challenge","type":"numeric","prompt":"三个数相乘得 72，其中两个因数是 3 和 8。第三个因数是多少？","answer":"3","explanation":"先把已知的两个因数乘起来 3×8＝24，第三个因数是 72÷24＝3。","verify":"72//(3*8)","id":"cnm_p110_q4","topicId":"cnm_p110"},{"difficulty":"basic","type":"numeric","prompt":"运算顺序是先算小括号里面的，再算乘除，最后算加减。50－（8＋12）×2 的得数是多少？","answer":"10","explanation":"先算 8＋12＝20，再算 20×2＝40，最后 50－40＝10。","verify":"50-(8+12)*2","id":"cnm_p112_q1","topicId":"cnm_p112"},{"difficulty":"basic","type":"numeric","prompt":"（12＋8）×3 的得数是多少？","answer":"60","explanation":"先算括号里 12＋8＝20，再算 20×3＝60。","verify":"(12+8)*3","id":"cnm_p112_q2","topicId":"cnm_p112"},{"difficulty":"standard","type":"numeric","prompt":"96÷4－7 的得数是多少？","answer":"17","explanation":"没有括号时先算乘除：96÷4＝24，再算 24－7＝17。","verify":"96//4-7","id":"cnm_p112_q3","topicId":"cnm_p112"},{"difficulty":"challenge","type":"numeric","prompt":"3 盒笔，每盒 12 支，又拿出 6 支，再平均分给 6 人。每人多少支？","answer":"7","explanation":"先算一共有 12×3＋6＝42（支），再平均分：42÷6＝7（支）。","verify":"(12*3+6)//6","id":"cnm_p112_q4","topicId":"cnm_p112"}]
