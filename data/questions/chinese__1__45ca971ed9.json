[{"id":"cnc_p001_q1","topicId":"cnc_p001","difficulty":"basic","type":"choice","prompt":"下面哪个字是「人」？","choices":[{"key":"A","text":"入"},{"key":"B","text":"八"},{"key":"C","text":"人"},{"key":"D","text":"大"}],"answer":"C","explanation":"「人」是一撇一捺，撇捺分得开。入的撇捺收得更拢，八和大都不是「人」。","verify":"\"人\""},{"id":"cnc_p001_q2","topicId":"cnc_p001","difficulty":"basic","type":"choice","prompt":"「人」字正确的笔顺是哪一种？","choices":[{"key":"A","text":"先捺后撇"},{"key":"B","text":"先横后竖"},{"key":"C","text":"先竖后横"},{"key":"D","text":"先撇后捺"}],"answer":"D","explanation":"「人」先写撇，再写捺。它没有横和竖。","verify":"\"先撇后捺\""},{"id":"cnc_p001_q3","topicId":"cnc_p001","difficulty":"standard","type":"choice","prompt":"「你、我、他」里，表示自己的是哪一个？","choices":[{"key":"A","text":"我"},{"key":"B","text":"你"},{"key":"C","text":"他"},{"key":"D","text":"它"}],"answer":"A","explanation":"我是自己。你是对方，他是另外的人，它常用来指事物。","verify":"\"我\""},{"id":"cnc_p001_q4","topicId":"cnc_p001","difficulty":"standard","type":"choice","prompt":"下面哪个字是「天」？","choices":[{"key":"A","text":"夫"},{"key":"B","text":"天"},{"key":"C","text":"太"},{"key":"D","text":"大"}],"answer":"B","explanation":"「天」两横上短下长，下面是一撇一捺。「夫」上长下短，「太」多一点，「大」上面没有短横。","verify":"\"天\""},{"id":"cnc_p002_q1","topicId":"cnc_p002","difficulty":"basic","type":"choice","prompt":"下面哪个字是「土」？","choices":[{"key":"A","text":"士"},{"key":"B","text":"干"},{"key":"C","text":"工"},{"key":"D","text":"土"}],"answer":"D","explanation":"「土」上面一横短，下面一横长。「士」正好相反，干和工的笔画也不一样。","verify":"\"土\""},{"id":"cnc_p002_q2","topicId":"cnc_p002","difficulty":"basic","type":"choice","prompt":"「金木水火土」里，表示树木的是哪一个？","choices":[{"key":"A","text":"木"},{"key":"B","text":"禾"},{"key":"C","text":"本"},{"key":"D","text":"火"}],"answer":"A","explanation":"「木」是树木。禾是禾苗，本下面多一横，火是火焰。","verify":"\"木\""},{"id":"cnc_p002_q3","topicId":"cnc_p002","difficulty":"standard","type":"choice","prompt":"「一二三四五」后面紧接着的是哪一句？","choices":[{"key":"A","text":"天地分上下"},{"key":"B","text":"金木水火土"},{"key":"C","text":"日月照今古"},{"key":"D","text":"站如松，坐如钟"}],"answer":"B","explanation":"课文先数一二三四五，下一句就是金木水火土。","verify":"\"金木水火土\""},{"id":"cnc_p002_q4","topicId":"cnc_p002","difficulty":"standard","type":"choice","prompt":"「天地分上下」的下一句是哪一句？","choices":[{"key":"A","text":"金木水火土"},{"key":"B","text":"一二三四五"},{"key":"C","text":"日月照今古"},{"key":"D","text":"你我他"}],"answer":"C","explanation":"天地分上下之后，是日月照今古。金木水火土在更前面。","verify":"\"日月照今古\""},{"id":"cnc_p003_q1","topicId":"cnc_p003","difficulty":"basic","type":"choice","prompt":"哪一个字表示眼睛？","choices":[{"key":"A","text":"目"},{"key":"B","text":"日"},{"key":"C","text":"口"},{"key":"D","text":"耳"}],"answer":"A","explanation":"「目」是眼睛，里面有两横。「日」是太阳，「口」是嘴巴，「耳」是耳朵。","verify":"\"目\""},{"id":"cnc_p003_q2","topicId":"cnc_p003","difficulty":"basic","type":"choice","prompt":"「手、足」里的「足」指的是什么？","choices":[{"key":"A","text":"嘴巴"},{"key":"B","text":"脚"},{"key":"C","text":"耳朵"},{"key":"D","text":"头发"}],"answer":"B","explanation":"足是脚。口才是嘴巴，耳才是耳朵。","verify":"\"脚\""},{"id":"cnc_p003_q3","topicId":"cnc_p003","difficulty":"standard","type":"choice","prompt":"「站如松」是说站着要怎样？","choices":[{"key":"A","text":"像钟一样端坐"},{"key":"B","text":"像风一样跑"},{"key":"C","text":"像松树一样直"},{"key":"D","text":"像弓一样躺"}],"answer":"C","explanation":"站如松：站得又直又挺，像松树。坐着才说坐如钟。","verify":"\"像松树一样直\""},{"id":"cnc_p003_q4","topicId":"cnc_p003","difficulty":"standard","type":"choice","prompt":"「行如风，卧如弓」里，走路应当怎样？","choices":[{"key":"A","text":"像松树一样站着不动"},{"key":"B","text":"像钟一样坐着"},{"key":"C","text":"像弓一样侧着睡"},{"key":"D","text":"像风一样轻快"}],"answer":"D","explanation":"行如风是走路轻快。像弓一样，说的是睡觉的姿势卧如弓。","verify":"\"像风一样轻快\""},{"id":"cnc_p004_q1","topicId":"cnc_p004","difficulty":"basic","type":"choice","prompt":"哪一个字表示太阳？","choices":[{"key":"A","text":"目"},{"key":"B","text":"日"},{"key":"C","text":"月"},{"key":"D","text":"田"}],"answer":"B","explanation":"「日」是太阳。「目」是眼睛，「月」是月亮，「田」是田地。","verify":"\"日\""},{"id":"cnc_p004_q2","topicId":"cnc_p004","difficulty":"basic","type":"choice","prompt":"「月」表示什么？","choices":[{"key":"A","text":"太阳"},{"key":"B","text":"眼睛"},{"key":"C","text":"月亮"},{"key":"D","text":"火焰"}],"answer":"C","explanation":"月是月亮。太阳是日，眼睛是目，火焰是火。","verify":"\"月亮\""},{"id":"cnc_p004_q3","topicId":"cnc_p004","difficulty":"standard","type":"choice","prompt":"「川」指的是什么？","choices":[{"key":"A","text":"山峰"},{"key":"B","text":"禾苗"},{"key":"C","text":"田地"},{"key":"D","text":"河流"}],"answer":"D","explanation":"川是河流，三竖像水流。山是山峰，禾是禾苗，田是田地。","verify":"\"河流\""},{"id":"cnc_p004_q4","topicId":"cnc_p004","difficulty":"standard","type":"choice","prompt":"下面哪个字是禾苗的「禾」？","choices":[{"key":"A","text":"禾"},{"key":"B","text":"木"},{"key":"C","text":"日"},{"key":"D","text":"田"}],"answer":"A","explanation":"禾是禾苗，比「木」上面多一撇。日是太阳，田是田地。","verify":"\"禾\""},{"id":"cnc_p005_q1","topicId":"cnc_p005","difficulty":"basic","type":"choice","prompt":"下面哪一句和「我是中国人」的意思一致？","choices":[{"key":"A","text":"我们不是中国人"},{"key":"B","text":"我们是天安门"},{"key":"C","text":"我们都是中国人"},{"key":"D","text":"我们是小书包"}],"answer":"C","explanation":"我是中国人，也可以说我们都是中国人。天安门和小书包都不是这句话的意思。","verify":"\"我们都是中国人\""},{"id":"cnc_p005_q2","topicId":"cnc_p005","difficulty":"basic","type":"choice","prompt":"「我爱我们的祖国」里，写到了哪一组？","choices":[{"key":"A","text":"只有小书包"},{"key":"B","text":"只有雪人"},{"key":"C","text":"只有荷花"},{"key":"D","text":"五星红旗和北京天安门"}],"answer":"D","explanation":"这一节写我爱五星红旗、我爱北京天安门，还写到长江和黄河。","verify":"\"五星红旗和北京天安门\""},{"id":"cnc_p005_q3","topicId":"cnc_p005","difficulty":"standard","type":"choice","prompt":"《上学歌》里，「我」背上小书包是去做什么？","choices":[{"key":"A","text":"去上学校，天天不迟到"},{"key":"B","text":"去雪地里画画"},{"key":"C","text":"去池塘采莲"},{"key":"D","text":"去河边看大雁"}],"answer":"A","explanation":"小鸟问为什么背上小书包，回答是：我去上学校，天天不迟到。","verify":"\"去上学校，天天不迟到\""},{"id":"cnc_p005_q4","topicId":"cnc_p005","difficulty":"standard","type":"choice","prompt":"「我爱学语文」里，写到了哪一组活动？","choices":[{"key":"A","text":"只踢球、不读书"},{"key":"B","text":"读书、写字、讲故事、听故事"},{"key":"C","text":"只睡觉"},{"key":"D","text":"只看雪、不写字"}],"answer":"B","explanation":"这一节用图画写出读书、写字、讲故事和听故事。","verify":"\"读书、写字、讲故事、听故事\""},{"id":"cnc_p006_q1","topicId":"cnc_p006","difficulty":"basic","type":"choice","prompt":"做「我说你做」时，发指令的人要怎样说话？","choices":[{"key":"A","text":"声音很轻，含含糊糊"},{"key":"B","text":"背对着大家不说话"},{"key":"C","text":"只做动作，一个字也不说"},{"key":"D","text":"声音洪亮，吐字清楚"}],"answer":"D","explanation":"别人要听得见、听得清，才做得对。声音太小或完全不说，游戏就做不成。","verify":"\"声音洪亮，吐字清楚\""},{"id":"cnc_p006_q2","topicId":"cnc_p006","difficulty":"basic","type":"choice","prompt":"别人发指令时，应该怎样？","choices":[{"key":"A","text":"认真听，再照着做"},{"key":"B","text":"捂住耳朵"},{"key":"C","text":"抢着说别的事情"},{"key":"D","text":"听了一半就跑开"}],"answer":"A","explanation":"先听清楚要求，再做动作。不听、乱跑，就不知道该做什么。","verify":"\"认真听，再照着做\""},{"id":"cnc_p006_q3","topicId":"cnc_p006","difficulty":"standard","type":"choice","prompt":"哪一条指令别人一听就知道做什么？","choices":[{"key":"A","text":"书。"},{"key":"B","text":"请你把书合上，坐端正。"},{"key":"C","text":"那个。"},{"key":"D","text":"随便。"}],"answer":"B","explanation":"要说清做什么。只说一个词，别人不知道是合上书，还是做别的。","verify":"\"请你把书合上，坐端正。\""},{"id":"cnc_p006_q4","topicId":"cnc_p006","difficulty":"standard","type":"choice","prompt":"老师说「请你举手」，应该怎么做？","choices":[{"key":"A","text":"把书扔到地上"},{"key":"B","text":"趴在桌子上"},{"key":"C","text":"把手举起来"},{"key":"D","text":"跑出教室"}],"answer":"C","explanation":"听到什么就做什么。请你举手，就是把手举起来，不是扔书或跑开。","verify":"\"把手举起来\""},{"id":"cnc_p007_q1","topicId":"cnc_p007","difficulty":"basic","type":"choice","prompt":"「读书真快乐」是在说什么？","choices":[{"key":"A","text":"读书是一件高兴的事"},{"key":"B","text":"书只能用来垫桌子"},{"key":"C","text":"读完书应该难过"},{"key":"D","text":"书不能打开"}],"answer":"A","explanation":"这一栏就是让大家感到读书快乐，愿意打开书。","verify":"\"读书是一件高兴的事\""},{"id":"cnc_p007_q2","topicId":"cnc_p007","difficulty":"basic","type":"choice","prompt":"哪一种做法合适？","choices":[{"key":"A","text":"把书页撕掉"},{"key":"B","text":"和爸爸妈妈一起读有趣的故事"},{"key":"C","text":"只看封面，不打开书"},{"key":"D","text":"不许别人讲故事"}],"answer":"B","explanation":"可以和大人一起读，也可以听故事、讲故事。撕书、不打开，就没有在读。","verify":"\"和爸爸妈妈一起读有趣的故事\""},{"id":"cnc_p007_q3","topicId":"cnc_p007","difficulty":"standard","type":"choice","prompt":"学了拼音以后，可以怎样？","choices":[{"key":"A","text":"再也不用看书"},{"key":"B","text":"只读没有字的空白页"},{"key":"C","text":"认更多的字，读更多的书"},{"key":"D","text":"把所有的书都合上"}],"answer":"C","explanation":"拼音帮助认字。认的字多了，能读的书就更多。","verify":"\"认更多的字，读更多的书\""},{"id":"cnc_p007_q4","topicId":"cnc_p007","difficulty":"standard","type":"choice","prompt":"下面哪一种最适合放在这里读？","choices":[{"key":"A","text":"一张空白纸"},{"key":"B","text":"只写着数字的账单"},{"key":"C","text":"一把尺子"},{"key":"D","text":"有图画、有故事的书"}],"answer":"D","explanation":"快乐读书吧读的是故事和图画书，不是空白纸、账单或尺子。","verify":"\"有图画、有故事的书\""}]
