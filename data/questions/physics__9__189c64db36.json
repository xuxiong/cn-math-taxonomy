[{"id":"cnp_054_q1","topicId":"cnp_054","difficulty":"basic","type":"choice","prompt":"走进花园闻到花香，说明了什么？","choices":[{"key":"A","text":"分子在不停地做无规则运动"},{"key":"B","text":"分子间有引力"},{"key":"C","text":"分子间有斥力"},{"key":"D","text":"分子很大"}],"answer":"A","explanation":"花香分子运动到空气中进入鼻子，这是扩散现象。","verify":"\"分子在不停地做无规则运动\""},{"id":"cnp_054_q2","topicId":"cnp_054","difficulty":"basic","type":"choice","prompt":"下列现象中能说明分子在运动的是哪一个？","choices":[{"key":"A","text":"扫地时尘土飞扬"},{"key":"B","text":"雪花纷纷落下"},{"key":"C","text":"糖放入热水中，水很快变甜"},{"key":"D","text":"柳絮漫天飞舞"}],"answer":"C","explanation":"尘土、雪花、柳絮是肉眼可见的物体的机械运动，不是分子运动。","verify":"\"糖放入热水中，水很快变甜\""},{"id":"cnp_054_q3","topicId":"cnp_054","difficulty":"standard","type":"choice","prompt":"两块表面干净的铅块压紧后能吊起重物，说明了什么？","choices":[{"key":"A","text":"分子间存在斥力"},{"key":"B","text":"分子间存在引力"},{"key":"C","text":"分子在不停运动"},{"key":"D","text":"铅块有磁性"}],"answer":"B","explanation":"压紧后分子距离很近，分子间的引力使它们结合在一起。","verify":"\"分子间存在引力\""},{"id":"cnp_054_q4","topicId":"cnp_054","difficulty":"standard","type":"choice","prompt":"将红墨水分别滴入冷水和热水中，哪杯水颜色变化得快？","choices":[{"key":"A","text":"冷水"},{"key":"B","text":"一样快"},{"key":"C","text":"热水"},{"key":"D","text":"无法判断"}],"answer":"C","explanation":"温度越高，分子无规则运动越剧烈，扩散越快。","verify":"\"热水\""}]
