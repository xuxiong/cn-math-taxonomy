[{"id":"cnm_160_q1","topicId":"cnm_160","difficulty":"basic","type":"choice","prompt":"计算 (a/b)÷(a²/b²)。","answer":"A","choices":[{"key":"A","text":"b/a"},{"key":"B","text":"a/b"},{"key":"C","text":"a^3/b^3"}],"explanation":"除以分式等于乘它的倒数：(a/b)×(b²/a²)=b/a。"},{"id":"cnm_160_q2","topicId":"cnm_160","difficulty":"basic","type":"numeric","prompt":"计算 (2a/b)·(b/(6a))（a、b 均不为 0），结果是一个常数，请写成最简分数。","answer":"1/3","explanation":"分子分母相乘后约去 a 和 b：(2a·b)/(b·6a)=2/6=1/3。","verify":"Fraction(2*1,1*6)"},{"id":"cnm_160_q3","topicId":"cnm_160","difficulty":"standard","type":"choice","prompt":"计算 (x^2-1)/(x^2+2x) ÷ (x+1)/x，结果是","answer":"B","choices":[{"key":"A","text":"(x-1)(x+1)^2/[x^2(x+2)]"},{"key":"B","text":"(x-1)/(x+2)"},{"key":"C","text":"(x+1)/(x+2)"}],"explanation":"原式=(x+1)(x-1)/[x(x+2)]×x/(x+1)，约去 x 和 x+1 得 (x-1)/(x+2)。"},{"id":"cnm_160_q4","topicId":"cnm_160","difficulty":"advanced","type":"numeric","prompt":"计算 (x^2-4)/(x^2-2x+1) ÷ (x+2)/(x-1)，并求 x=3 时的值（写成最简分数）。","answer":"1/2","explanation":"原式=(x-2)(x+2)/(x-1)^2 × (x-1)/(x+2)=(x-2)/(x-1)，x=3 时为 1/2。","verify":"Fraction(3**2-4,3**2-2*3+1)/Fraction(3+2,3-1)"}]
