[{"id":"cne_j146_q1","topicId":"cne_j146","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「志愿者」？","choices":[{"key":"A","text":"lonely"},{"key":"B","text":"sign"},{"key":"C","text":"notice"},{"key":"D","text":"volunteer"}],"answer":"D","explanation":"volunteer 的意思是志愿者。","verify":"\"volunteer\""},{"id":"cne_j146_q2","topicId":"cne_j146","difficulty":"basic","type":"choice","prompt":"「lonely」的中文意思是哪一个？","choices":[{"key":"A","text":"孤独的"},{"key":"B","text":"志愿者"},{"key":"C","text":"标牌"},{"key":"D","text":"通知"}],"answer":"A","explanation":"lonely 的意思是孤独的。","verify":"\"孤独的\""},{"id":"cne_j146_q3","topicId":"cne_j146","difficulty":"standard","type":"choice","prompt":"选择表示「标牌」的单词。","choices":[{"key":"A","text":"volunteer"},{"key":"B","text":"sign"},{"key":"C","text":"lonely"},{"key":"D","text":"notice"}],"answer":"B","explanation":"表示标牌的单词是 sign。","verify":"\"sign\""},{"id":"cne_j146_q4","topicId":"cne_j146","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「通知」？","choices":[{"key":"A","text":"volunteer"},{"key":"B","text":"lonely"},{"key":"C","text":"notice"},{"key":"D","text":"sign"}],"answer":"C","explanation":"notice 的意思是通知。","verify":"\"notice\""},{"id":"cne_j148_q1","topicId":"cne_j148","difficulty":"basic","type":"choice","prompt":"想说自己可以发食物，哪一句合适？","choices":[{"key":"A","text":"I could to give out food."},{"key":"B","text":"I could give out food."},{"key":"C","text":"I could giving out food."},{"key":"D","text":"I could gave out food."}],"answer":"B","explanation":"could 后面用动词原形。","verify":"\"I could give out food.\""},{"id":"cne_j148_q2","topicId":"cne_j148","difficulty":"basic","type":"choice","prompt":"想问对方想参加志愿活动吗，哪一句合适？","choices":[{"key":"A","text":"Would you like helping out yesterday?"},{"key":"B","text":"Do you would like to help?"},{"key":"C","text":"Would you like to help?"},{"key":"D","text":"Would you like help?"}],"answer":"C","explanation":"Would you like to help。","verify":"\"Would you like to help?\""},{"id":"cne_j148_q3","topicId":