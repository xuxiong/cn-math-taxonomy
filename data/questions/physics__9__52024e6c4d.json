[{"id":"cnp_089_q1","topicId":"cnp_089","difficulty":"basic","type":"choice","prompt":"北斗卫星导航系统是利用什么传递信息的？","choices":[{"key":"A","text":"超声波"},{"key":"B","text":"次声波"},{"key":"C","text":"光纤"},{"key":"D","text":"电磁波"}],"answer":"D","explanation":"卫星与地面之间利用电磁波传递信息。","verify":"\"电磁波\""},{"id":"cnp_089_q2","topicId":"cnp_089","difficulty":"basic","type":"choice","prompt":"光纤通信中，激光在光导纤维中是怎样传播的？","choices":[{"key":"A","text":"沿光纤中心直线传播"},{"key":"B","text":"在光纤内壁多次反射向前传播"},{"key":"C","text":"沿光纤外表面传播"},{"key":"D","text":"靠声音带动传播"}],"answer":"B","explanation":"激光在光纤内壁上多次反射，从一端传到另一端。","verify":"\"在光纤内壁多次反射向前传播\""},{"id":"cnp_089_q3","topicId":"cnp_089","difficulty":"standard","type":"choice","prompt":"与普通电缆相比，光纤通信的优点是什么？","choices":[{"key":"A","text":"传播速度比光速快"},{"key":"B","text":"不需要任何能量"},{"key":"C","text":"容量大、抗干扰能力强"},{"key":"D","text":"只能在真空中使用"}],"answer":"C","explanation":"光纤通信容量大、不受电磁干扰、损耗小。","verify":"\"容量大、抗干扰能力强\""},{"id":"cnp_089_q4","topicId":"cnp_089","difficulty":"standard","type":"choice","prompt":"地球同步通信卫星相对于地面是怎样的？","choices":[{"key":"A","text":"运动的"},{"key":"B","text":"静止的"},{"key":"C","text":"时而静止时而运动"},{"key":"D","text":"无法判断"}],"answer":"B","explanation":"同步卫星与地球自转同步，以地面为参照物是静止的。","verify":"\"静止的\""}]
