[{"id":"cnd_p033_q1","topicId":"cnd_p033","difficulty":"basic","type":"choice","prompt":"过节假日较好的安排是？","choices":[{"key":"A","text":"整天玩电子设备不休息"},{"key":"B","text":"完全打乱作息"},{"key":"C","text":"劳逸结合，做有意义的事"},{"key":"D","text":"到处危险探险无人看护"}],"answer":"C","explanation":"假期也要合理安排。","verify":"\"劳逸结合，做有意义的事\""},{"id":"cnd_p033_q2","topicId":"cnd_p033","difficulty":"basic","type":"choice","prompt":"假期结束返校，应？","choices":[{"key":"A","text":"作业全拖到最后一晚"},{"key":"B","text":"无故旷课"},{"key":"C","text":"把作业抄同学的"},{"key":"D","text":"完成该做的学习任务，按时上学"}],"answer":"D","explanation":"假期也要负责。","verify":"\"完成该做的学习任务，按时上学\""},{"id":"cnd_p033_q3","topicId":"cnd_p033","difficulty":"standard","type":"choice","prompt":"假期里可以帮助家人做什么？","choices":[{"key":"A","text":"做力所能及的家务或陪伴家人"},{"key":"B","text":"故意添乱"},{"key":"C","text":"只顾要礼物"},{"key":"D","text":"整天把自己关房里不交流"}],"answer":"A","explanation":"假期可多关心家人。","verify":"\"做力所能及的家务或陪伴家人\""},{"id":"cnd_p033_q4","topicId":"cnd_p033","difficulty":"challenge","type":"choice","prompt":"为什么说假期也有收获？","choices":[{"key":"A","text":"假期只是浪费时间"},{"key":"B","text":"可以休息、实践、开阔眼界"},{"key":"C","text":"假期不必学任何东西"},{"key":"D","text":"收获只来自考试"}],"answer":"B","explanation":"假期同样能成长。","verify":"\"可以休息、实践、开阔眼界\""},{"id":"cnd_p034_q1","topicId":"cnd_p034","difficulty":"basic","type":"choice","prompt":"教师节是为了？","choices":[{"key":"A","text":"取消所有课程"},{"key":"B","text":"只给老师放假与学生无关"},{"key":"C","text":"比赛谁礼物最贵"},{"key":"D","text":"感谢老师的辛勤教导"}],"answer":"D","explanation":"教师节表达对老师的感谢。","verify":"\"感谢老师的辛勤教导\""},{"id":"cnd_p034_q2","topicId":"cnd_p034","difficulty":"basic","type":"choice","prompt":"送给老师最合适的“礼物”是？","choices":[{"key":"A","text":"认真听课、真诚祝福"},{"key":"B","text":"昂贵奢侈品攀比"},{"key":"C","text":"逃课表示庆祝"},{"key":"D","text":"恶作剧整蛊老师"}],"answer":"A","explanation":"认真学习和真诚祝福最珍贵。","verify":"\"认真听课、真诚祝福\""},{"id":"cnd_p034_q3","topicId":"cnd_p034","difficulty":"standard","type":"choice","prompt":"教师节可以对老师说？","choices":[{"key":"A","text":"今天不用听您的"},{"key":"B","text":"老师，您辛苦了，谢谢您"},{"key":"C","text":"作业我都不写了"},{"key":"D","text":"您管得太多"}],"answer":"B","explanation":"礼貌表达感谢。","verify":"\"老师，您辛苦了，谢谢您\""},{"id":"cnd_p034_q4","topicId":"cnd_p034","difficulty":"challenge","type":"choice","prompt":"平时怎样尊敬老师？","choices":[{"key":"A","text":"当面一套背后一套"},{"key":"B","text":"给老师起外号"},{"key":"C","text":"上课认真，有礼貌，按要求完成学习任务"},{"key":"D","text":"无视课堂纪律"}],"answer":"C","explanation":"日常尊师更重要。","verify":"\"上课认真，有礼貌，按要求完成学习任务\""},{"id":"cnd_p035_q1","topicId":"cnd_p035","difficulty":"basic","type":"choice","prompt":"中秋节人们常做的事情是？","choices":[{"key":"A","text":"家人团圆，赏月吃月饼"},{"key":"B","text":"只放鞭炮不团聚"},{"key":"C","text":"不去看望家人"},{"key":"D","text":"把月饼扔了"}],"answer":"A","explanation":"中秋注重团圆。","verify":"\"家人团圆，赏月吃月饼\""},{"id":"cnd_p035_q2","topicId":"cnd_p035","difficulty":"basic","type":"choice","prompt":"中秋节体现的美好情感是？","choices":[{"key":"A","text":"比谁月饼贵"},{"key":"B","text":"思念家乡和亲人"},{"key":"C","text":"比谁放烟花多"},{"key":"D","text":"比谁熬夜久"}],"answer":"B","explanation":"中秋寄托对亲人的思念。","verify":"\"思念家乡和亲人\""},{"id":"cnd_p035_q3","topicId":"cnd_p035","difficulty":"standard","type":"choice","prompt":"过中秋时要注意？","choices":[{"key":"A","text":"在阳台乱扔烟头"},{"key":"B","text":"通宵大声喧哗影响邻居"},{"key":"C","text":"文明过节，注意用火用电安全"},{"key":"D","text":"浪费大量食物攀比"}],"answer":"C","explanation":"节日也要文明安全。","verify":"\"文明过节，注意用火用电安全\""},{"id":"cnd_p035_q4","topicId":"cnd_p035","difficulty":"challenge","type":"choice","prompt":"为什么说团团圆圆过中秋？","choices":[{"key":"A","text":"一个人过更有意思"},{"key":"B","text":"节日只为放假睡觉"},{"key":"C","text":"团圆没有意义"},{"key":"D","text":"家人团聚更幸福"}],"answer":"D","explanation":"团圆是中秋的重要意义。","verify":"\"家人团聚更幸福\""},{"id":"cnd_p036_q1","topicId":"cnd_p036","difficulty":"basic","type":"choice","prompt":"国庆节是纪念什么？","choices":[{"key":"A","text":"学校开学"},{"key":"B","text":"中华人民共和国成立"},{"key":"C","text":"一个地方的庙会"},{"key":"D","text":"一次运动会"}],"answer":"B","explanation":"10月1日是国庆节。","verify":"\"中华人民共和国成立\""},{"id":"cnd_p036_q2","topicId":"cnd_p036","difficulty":"basic","type":"choice","prompt":"国庆节常见的爱国表达是？","choices":[{"key":"A","text":"破坏公共设施"},{"key":"B","text":"不遵守交通规则"},{"key":"C","text":"观看升旗、了解祖国成就"},{"key":"D","text":"乱涂乱画"}],"answer":"C","explanation":"用文明方式表达爱国。","verify":"\"观看升旗、了解祖国成就\""},{"id":"cnd_p036_q3","topicId":"cnd_p036","difficulty":"standard","type":"choice","prompt":"国庆节放假外出，应注意？","choices":[{"key":"A","text":"景区乱扔垃圾"},{"key":"B","text":"插队拥挤"},{"key":"C","text":"在文物上刻字"},{"key":"D","text":"文明旅游，遵守公共秩序"}],"answer":"D","explanation":"外出也要守秩序。","verify":"\"文明旅游，遵守公共秩序\""},{"id":"cnd_p036_q4","topicId":"cnd_p036","difficulty":"challenge","type":"choice","prompt":"欢欢喜喜庆国庆，我们应怀有？","choices":[{"key":"A","text":"对祖国的热爱和祝福"},{"key":"B","text":"对假期作业的抱怨而已"},{"key":"C","text":"与祖国无关的心态"},{"key":"D","text":"只关心买到什么礼物"}],"answer":"A","explanation":"国庆是爱国的节日。","verify":"\"对祖国的热爱和祝福\""}]
