[{"id":"cns_p076_q1","topicId":"cns_p076","difficulty":"basic","type":"choice","prompt":"描述一个物体的位置，需要先选定什么？","choices":[{"key":"A","text":"颜色"},{"key":"B","text":"参照物"},{"key":"C","text":"重量"},{"key":"D","text":"名字"}],"answer":"B","explanation":"位置是相对参照物来说的。","verify":"\"参照物\""},{"id":"cns_p076_q2","topicId":"cns_p076","difficulty":"basic","type":"choice","prompt":"小明在教室中间，小红在小明东边 2 米，这句话里参照物是谁？","choices":[{"key":"A","text":"小红"},{"key":"B","text":"教室门"},{"key":"C","text":"小明"},{"key":"D","text":"黑板"}],"answer":"C","explanation":"以小明为参照描述小红的位置。","verify":"\"小明\""},{"id":"cns_p076_q3","topicId":"cns_p076","difficulty":"standard","type":"choice","prompt":"坐在行驶的汽车里，以座椅为参照物，乘客是怎样的？","choices":[{"key":"A","text":"运动的"},{"key":"B","text":"向后跑的"},{"key":"C","text":"无法判断"},{"key":"D","text":"静止的"}],"answer":"D","explanation":"乘客和座椅之间位置不变，是静止的。","verify":"\"静止的\""},{"id":"cns_p076_q4","topicId":"cns_p076","difficulty":"challenge","type":"choice","prompt":"站在路边看行驶的火车，以路边的树为参照物，火车是怎样的？","choices":[{"key":"A","text":"运动的"},{"key":"B","text":"静止的"},{"key":"C","text":"忽快忽慢的"},{"key":"D","text":"无法判断"}],"answer":"A","explanation":"火车相对于树的位置在改变。","verify":"\"运动的\""},{"id":"cns_p077_q1","topicId":"cns_p077","difficulty":"basic","type":"choice","prompt":"电风扇叶片的运动方式是什么？","choices":[{"key":"A","text":"摆动"},{"key":"B","text":"滚动"},{"key":"C","text":"转动"},{"key":"D","text":"振动"}],"answer":"C","explanation":"叶片绕中心转动。","verify":"\"转动\""},{"id":"cns_p077_q2","topicId":"cns_p077","difficulty":"basic","type":"choice","prompt":"秋千来回荡的运动方式是什么？","choices":[{"key":"A","text":"转动"},{"key":"B","text":"直线运动"},{"key":"C","text":"滚动"},{"key":"D","text":"摆动"}],"answer":"D","explanation":"秋千在一定范围内来回摆动。","verify":"\"摆动\""},{"id":"cns_p077_q3","topicId":"cns_p077","difficulty":"standard","type":"choice","prompt":"拨动吉他琴弦，琴弦快速来回颤动，这是什么运动？","choices":[{"key":"A","text":"振动"},{"key":"B","text":"转动"},{"key":"C","text":"滚动"},{"key":"D","text":"移动"}],"answer":"A","explanation":"琴弦快速来回颤动叫振动。","verify":"\"振动\""},{"id":"cns_p077_q4","topicId":"cns_p077","difficulty":"challenge","type":"choice","prompt":"下面哪种运动是滚动？","choices":[{"key":"A","text":"钟摆来回摆"},{"key":"B","text":"足球在草地上向前滚"},{"key":"C","text":"电梯上下升降"},{"key":"D","text":"门绕门轴转开"}],"answer":"B","explanation":"球边转边向前，是滚动。","verify":"\"足球在草地上向前滚\""},{"id":"cns_p078_q1","topicId":"cns_p078","difficulty":"basic","type":"choice","prompt":"从高处自由落下的苹果，运动路线是怎样的？","choices":[{"key":"A","text":"曲线"},{"key":"B","text":"圆圈"},{"key":"C","text":"波浪线"},{"key":"D","text":"直线"}],"answer":"D","explanation":"苹果竖直下落，是直线运动。","verify":"\"直线\""},{"id":"cns_p078_q2","topicId":"cns_p078","difficulty":"basic","type":"choice","prompt":"投出去的篮球在空中的路线是怎样的？","choices":[{"key":"A","text":"曲线"},{"key":"B","text":"直线"},{"key":"C","text":"折线"},{"key":"D","text":"不动"}],"answer":"A","explanation":"篮球沿弧线飞行，是曲线运动。","verify":"\"曲线\""},{"id":"cns_p078_q3","topicId":"cns_p078","difficulty":"standard","type":"choice","prompt":"下面哪一种是直线运动？","choices":[{"key":"A","text":"转动的摩天轮座舱"},{"key":"B","text":"电梯竖直上升"},{"key":"C","text":"荡秋千"},{"key":"D","text":"扔出去的纸飞机"}],"answer":"B","explanation":"电梯沿直线上下。","verify":"\"电梯竖直上升\""},{"id":"cns_p078_q4","topicId":"cns_p078","difficulty":"challenge","type":"choice","prompt":"物体做曲线运动的路线，和直线运动最大的区别是什么？","choices":[{"key":"A","text":"速度一定更快"},{"key":"B","text":"一定是圆形"},{"key":"C","text":"运动方向在不断改变"},{"key":"D","text":"一定在空中"}],"answer":"C","explanation":"曲线运动方向时刻变化。","verify":"\"运动方向在不断改变\""},{"id":"cns_p079_q1","topicId":"cns_p079","difficulty":"basic","type":"choice","prompt":"跑 50 米，小明用 9 秒，小红用 10 秒，谁跑得快？","choices":[{"key":"A","text":"小明"},{"key":"B","text":"小红"},{"key":"C","text":"一样快"},{"key":"D","text":"无法比较"}],"answer":"A","explanation":"距离相同，用时少的快。","verify":"\"小明\""},{"id":"cns_p079_q2","topicId":"cns_p079","difficulty":"basic","type":"choice","prompt":"都跑 1 分钟，甲跑了 200 米，乙跑了 180 米，谁快？","choices":[{"key":"A","text":"乙"},{"key":"B","text":"甲"},{"key":"C","text":"一样快"},{"key":"D","text":"无法比较"}],"answer":"B","explanation":"时间相同，跑得远的快。","verify":"\"甲\""},{"id":"cns_p079_q3","topicId":"cns_p079","difficulty":"standard","type":"choice","prompt":"比较两辆玩具车谁快，下面哪种方法不公平？","choices":[{"key":"A","text":"同一跑道比用时"},{"key":"B","text":"同样时间比距离"},{"key":"C","text":"让两辆车在不同长度的跑道上各跑一次，只比时间"},{"key":"D","text":"同时出发看谁先到终点"}],"answer":"C","explanation":"距离不同又只比时间，无法判断快慢。","verify":"\"让两辆车在不同长度的跑道上各跑一次，只比时间\""},{"id":"cns_p079_q4","topicId":"cns_p079","difficulty":"challenge","type":"choice","prompt":"汽车 2 小时行驶 120 千米，自行车 1 小时骑行 15 千米，谁快？","choices":[{"key":"A","text":"自行车"},{"key":"B","text":"一样快"},{"key":"C","text":"无法比较"},{"key":"D","text":"汽车"}],"answer":"D","explanation":"汽车每小时 60 千米，比自行车每小时 15 千米快。","verify":"\"汽车\""},{"id":"cns_p080_q1","topicId":"cns_p080","difficulty":"basic","type":"choice","prompt":"下面哪个物体具有运动的能量？","choices":[{"key":"A","text":"静放在桌上的书"},{"key":"B","text":"滚动的皮球"},{"key":"C","text":"停着的自行车"},{"key":"D","text":"放着的石头"}],"answer":"B","explanation":"运动的物体具有能量。","verify":"\"滚动的皮球\""},{"id":"cns_p080_q2","topicId":"cns_p080","difficulty":"basic","type":"choice","prompt":"飞快行驶的汽车很难立刻停下，说明什么？","choices":[{"key":"A","text":"汽车没有能量"},{"key":"B","text":"汽车很轻"},{"key":"C","text":"运动的汽车具有能量"},{"key":"D","text":"路面太平"}],"answer":"C","explanation":"速度越大，物体的运动能量越大。","verify":"\"运动的汽车具有能量\""},{"id":"cns_p080_q3","topicId":"cns_p080","difficulty":"standard","type":"choice","prompt":"从高处滚下的小球越滚越快，是什么能量增加了？","choices":[{"key":"A","text":"电能"},{"key":"B","text":"声能"},{"key":"C","text":"光能"},{"key":"D","text":"运动的能量"}],"answer":"D","explanation":"高处的能量转化为运动的能量。","verify":"\"运动的能量\""},{"id":"cns_p080_q4","topicId":"cns_p080","difficulty":"challenge","type":"choice","prompt":"同样的小车从斜坡更高的位置放下，冲得更远，原因是什么？","choices":[{"key":"A","text":"从高处下来获得的运动能量更多"},{"key":"B","text":"小车变轻了"},{"key":"C","text":"斜坡变短了"},{"key":"D","text":"小车颜色不同"}],"answer":"A","explanation":"位置越高，转化成的运动能量越多。","verify":"\"从高处下来获得的运动能量更多\""},{"id":"cns_p081_q1","topicId":"cns_p081","difficulty":"basic","type":"choice","prompt":"纸过山车里的小钢珠，开始时要放在哪里才能跑完全程？","choices":[{"key":"A","text":"轨道最低处"},{"key":"B","text":"轨道中间的坑里"},{"key":"C","text":"轨道最高处"},{"key":"D","text":"轨道外面"}],"answer":"C","explanation":"起点最高，小球才有足够能量。","verify":"\"轨道最高处\""},{"id":"cns_p081_q2","topicId":"cns_p081","difficulty":"basic","type":"choice","prompt":"小钢珠总是在半路的小坡前停下，可以怎么改？","choices":[{"key":"A","text":"把起点降低"},{"key":"B","text":"把小坡加高"},{"key":"C","text":"换成更大的纸"},{"key":"D","text":"提高起点或降低后面的坡"}],"answer":"D","explanation":"起点要比后面的坡高，小球才能越过。","verify":"\"提高起点或降低后面的坡\""},{"id":"cns_p081_q3","topicId":"cns_p081","difficulty":"standard","type":"choice","prompt":"测试过山车时，为什么要每次从同一位置放小球、测几次？","choices":[{"key":"A","text":"让测试结果更可靠"},{"key":"B","text":"为了好玩"},{"key":"C","text":"节省时间"},{"key":"D","text":"没有原因"}],"answer":"A","explanation":"条件相同、重复测试，结果更可靠。","verify":"\"让测试结果更可靠\""},{"id":"cns_p081_q4","topicId":"cns_p081","difficulty":"challenge","type":"choice","prompt":"小球在弯道处总是飞出轨道，最合适的改进是？","choices":[{"key":"A","text":"把弯道拆掉换成坑"},{"key":"B","text":"把弯道外侧的边做高一些"},{"key":"C","text":"让小球更快"},{"key":"D","text":"把轨道涂成红色"}],"answer":"B","explanation":"加高外侧挡边，小球就不容易冲出去。","verify":"\"把弯道外侧的边做高一些\""}]
