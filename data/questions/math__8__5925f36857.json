[{"id":"cnm_147_q1","topicId":"cnm_147","difficulty":"standard","type":"numeric","prompt":"计算 103×97。（可用平方差公式简便计算）","answer":"9991","explanation":"103×97=(100+3)(100-3)=100²-3²=10000-9=9991。","verify":"103*97"},{"id":"cnm_147_q2","topicId":"cnm_147","difficulty":"basic","type":"choice","prompt":"下列各式中，能用平方差公式计算的是：","answer":"A","choices":[{"key":"A","text":"(x+y)(x-y)"},{"key":"B","text":"(x+y)(x+y)"},{"key":"C","text":"(x+y)(-x-y)"},{"key":"D","text":"(x-y)(y-x)"}],"explanation":"平方差公式要求一项相同、一项互为相反数；(x+y)(x-y) 满足，其余三个都是完全平方的形式（或其相反数）。"},{"id":"cnm_147_q3","topicId":"cnm_147","difficulty":"basic","type":"numeric","prompt":"计算 (x+3)(x-3)，并求当 x=5 时的值。","answer":"16","explanation":"(x+3)(x-3)=x²-9，x=5 时为 25-9=16。","verify":"(5+3)*(5-3)"},{"id":"cnm_147_q4","topicId":"cnm_147","difficulty":"standard","type":"numeric","prompt":"用平方差公式计算 1.02×0.98。","answer":"0.9996","explanation":"1.02×0.98=(1+0.02)(1-0.02)=1-0.0004=0.9996。","verify":"Fraction(102,100)*Fraction(98,100)"},{"id":"cnm_147_q5","topicId":"cnm_147","difficulty":"advanced","type":"numeric","prompt":"计算 (2+1)(2^2+1)(2^4+1)(2^8+1) 的值。","answer":"65535","explanation":"乘以 (2-1)=1 后连续用平方差公式，结果为 2^16-1=65535。","verify":"(2+1)*(2**2+1)*(2**4+1)*(2**8+1)"},{"id":"cnm_148_q1","topicId":"cnm_148","difficulty":"basic","type":"choice","prompt":"展开 (2x-3)²。","answer":"D","choices":[{"key":"A","text":"4x²-9"},{"key":"B","text":"4x²+12x+9"},{"key":"C","text":"2x²-12x+9"},{"key":"D","text":"4x²-12x+9"}],"explanation":"(2x-3)²=(2x)²-2·2x·3+3²=4x²-12x+9，中间项不能漏。"},{"id":"cnm_148_q2","topicId":"cnm_148","difficulty":"basic","type":"numeric","prompt":"展开 (x-5)^2，求一次项的系数。","answer":"-10","explanation":"(x-5)^2=x^2-10x+25，一次项系数为 -10。","verify":"-2*5"},{"id":"cnm_148_q3","topicId":"cnm_148","difficulty":"standard","type":"numeric","prompt":"用完全平方公式计算 99^2。","answer":"9801","explanation":"99^2=(100-1)^2=10000-200+1=9801。","verify":"99**2"},{"id":"cnm_148_q4","topicId":"cnm_148","difficulty":"advanced","type":"numeric","prompt":"已知 a+b=5，ab=6，求 a^2+b^2 的值。","answer":"13","explanation":"a^2+b^2=(a+b)^2-2ab=25-12=13。","verify":"5**2-2*6"},{"id":"cnm_149_q1","topicId":"cnm_149","difficulty":"basic","type":"choice","prompt":"计算 (a+b+c)(a+b-c)。","answer":"C","choices":[{"key":"A","text":"a²+b²-c²"},{"key":"B","text":"(a+b)²+c²"},{"key":"C","text":"(a+b)²-c²"},{"key":"D","text":"a²+b²+c²"}],"explanation":"把 a+b 看作整体，原式=[(a+b)+c][(a+b)-c]=(a+b)²-c²。"},{"id":"cnm_149_q2","topicId":"cnm_149","difficulty":"basic","type":"numeric","prompt":"计算 (x+2)(x-2)+4，并求当 x=3 时的值。","answer":"9","explanation":"(x+2)(x-2)+4=x²-4+4=x²，x=3 时为 9。","verify":"(3+2)*(3-2)+4"},{"id":"cnm_149_q3","topicId":"cnm_149","difficulty":"standard","type":"numeric","prompt":"先化简，再求值：(x+2)^2-(x+1)(x-1)，其中 x=1/2。","answer":"7","explanation":"原式=x²+4x+4-(x²-1)=4x+5，x=1/2 时为 2+5=7。","verify":"(Fraction(1,2)+2)**2-(Fraction(1,2)+1)*(Fraction(1,2)-1)"},{"id":"cnm_149_q4","topicId":"cnm_149","difficulty":"advanced","type":"numeric","prompt":"已知 (a+b)^2=25，(a-b)^2=9，求 ab 的值。","answer":"4","explanation":"两式相减：(a+b)^2-(a-b)^2=4ab=25-9=16，所以 ab=4。","verify":"Fraction(25-9,4)"}]
