[{"id":"cne_j228_q1","topicId":"cne_j228","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「友谊」？","choices":[{"key":"A","text":"king"},{"key":"B","text":"friendship"},{"key":"C","text":"pale"},{"key":"D","text":"queen"}],"answer":"B","explanation":"friendship 的意思是友谊。","verify":"\"friendship\""},{"id":"cne_j228_q2","topicId":"cne_j228","difficulty":"basic","type":"choice","prompt":"「king」的中文意思是哪一个？","choices":[{"key":"A","text":"友谊"},{"key":"B","text":"苍白的"},{"key":"C","text":"国王"},{"key":"D","text":"王后"}],"answer":"C","explanation":"king 的意思是国王。","verify":"\"国王\""},{"id":"cne_j228_q3","topicId":"cne_j228","difficulty":"standard","type":"choice","prompt":"选择表示「苍白的」的单词。","choices":[{"key":"A","text":"friendship"},{"key":"B","text":"king"},{"key":"C","text":"queen"},{"key":"D","text":"pale"}],"answer":"D","explanation":"表示苍白的的单词是 pale。","verify":"\"pale\""},{"id":"cne_j228_q4","topicId":"cne_j228","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「王后」？","choices":[{"key":"A","text":"queen"},{"key":"B","text":"friendship"},{"key":"C","text":"king"},{"key":"D","text":"pale"}],"answer":"A","explanation":"queen 的意思是王后。","verify":"\"queen\""},{"id":"cne_j229_q1","topicId":"cne_j229","difficulty":"basic","type":"choice","prompt":"悲伤的电影让我哭。哪一句正确？","choices":[{"key":"A","text":"Sad movies make me to cry."},{"key":"B","text":"Sad movies make me crying."},{"key":"C","text":"Sad movies make me cry."},{"key":"D","text":"Sad movies make me cried."}],"answer":"C","explanation":"make me cry，cry 用原形。","verify":"\"Sad movies make me cry.\""},{"id":"cne_j229_q2","topicId":"cne_j229","difficulty":"basic","type":"choice","prompt":"这个消息让他高兴。哪一句正确？","choices":[{"key":"A","text":"The news made him happily."},{"key":"B","text":"The news made him to happy."},{"key":"C","text":"The news made he happy."},{"key":"D","text":"The news made him happy."}],"answer":"D","explanation":"made him happy，happy 是形容词。","verify":"\"The news made him happy.\""},{"id":"cne_j229_q3","topicId":"cne_j229","difficulty":"standard","type":"choice","prompt":"make somebody do 里的 do 用什么形式？","choices":[{"key":"A","text":"动词原形"},{"key":"B","text":"to 加动词"},{"key":"C","text":"动词 ing"},{"key":"D","text":"过去式"}],"answer":"A","explanation":"make 后面的动词不带 to。","verify":"\"动词原形\""},{"id":"cne_j229_q4","topicId":"cne_j229","difficulty":"standard","type":"choice","prompt":"国王的决定让王后很苍白。哪一句正确？","choices":[{"key":"A","text":"The king's decision made the queen to pale."},{"key":"B","text":"The king's decision made the queen pale."},{"key":"C","text":"The king's decision made the queen palely."},{"key":"D","text":"The king's decision made the queen pales."}],"answer":"B","explanation":"made the queen pale。","verify":"\"The king's decision made the queen pale.\""},{"id":"cne_j230_q1","topicId":"cne_j230","difficulty":"basic","type":"choice","prompt":"想说这部电影让你想哭，哪一句合适？","choices":[{"key":"A","text":"The movie makes me to want to cry."},{"key":"B","text":"The movie makes me wanting to cry."},{"key":"C","text":"The movie makes me want cry."},{"key":"D","text":"The movie makes me want to cry."}],"answer":"D","explanation":"makes me want to cry。","verify":"\"The movie makes me want to cry.\""},{"id":"cne_j230_q2","topicId":"cne_j230","difficulty":"basic","type":"choice","prompt":"想问这部电影怎么样，哪一句合适？","choices":[{"key":"A","text":"What do you think of the movie?"},{"key":"B","text":"What do you think the movie of?"},{"key":"C","text":"How do you think of the movie is?"},{"key":"D","text":"What are you think of the movie?"}],"answer":"A","explanation":"What do you think of。","verify":"\"What do you think of the movie?\""},{"id":"cne_j230_q3","topicId":"cne_j230","difficulty":"standard","type":"choice","prompt":"友谊让她快乐，哪一句合适？","choices":[{"key":"A","text":"Friendship makes her happily."},{"key":"B","text":"Friendship makes her happy."},{"key":"C","text":"Friendship make her happy."},{"key":"D","text":"Friendship makes she happy."}],"answer":"B","explanation":"makes her happy。","verify":"\"Friendship makes her happy.\""},{"id":"cne_j230_q4","topicId":"cne_j230","difficulty":"standard","type":"choice","prompt":"The king looks pale. 这句说明什么？","choices":[{"key":"A","text":"国王很高兴"},{"key":"B","text":"王后在笑"},{"key":"C","text":"国王看上去脸色苍白"},{"key":"D","text":"电影还没开始"}],"answer":"C","explanation":"looks pale。","verify":"\"国王看上去脸色苍白\""},{"id":"cne_j231_q1","topicId":"cne_j231","difficulty":"basic","type":"choice","prompt":"The sad movie made Amy cry. It also made her think about friendship. 电影让 Amy 怎样了？","choices":[{"key":"A","text":"哭了，并想到友谊"},{"key":"B","text":"睡着了"},{"key":"C","text":"离开了电影院而且没有哭"},{"key":"D","text":"开始笑个不停"}],"answer":"A","explanation":"made Amy cry，think about friendship。","verify":"\"哭了，并想到友谊\""},{"id":"cne_j231_q2","topicId":"cne_j231","difficulty":"basic","type":"choice","prompt":"The sad movie made Amy cry. 她哭是因为什么？","choices":[{"key":"A","text":"一个笑话"},{"key":"B","text":"这部悲伤的电影"},{"key":"C","text":"国王请她吃饭"},{"key":"D","text":"短文没说原因"}],"answer":"B","explanation":"sad movie made Amy cry。","verify":"\"这部悲伤的电影\""},{"id":"cne_j231_q3","topicId":"cne_j231","difficulty":"standard","type":"choice","prompt":"The story of the king and the queen made Ben sleepy. He did not cry. Ben 哭了吗？","choices":[{"key":"A","text":"哭了"},{"key":"B","text":"和 Amy 一起哭"},{"key":"C","text":"没有"},{"key":"D","text":"短文没说"}],"answer":"C","explanation":"did not cry。","verify":"\"没有\""},{"id":"cne_j231_q4","topicId":"cne_j231","difficulty":"standard","type":"choice","prompt":"The story made Ben sleepy. 哪一句和观后感一致？","choices":[{"key":"A","text":"Ben cried a lot."},{"key":"B","text":"Amy did not think about friendship."},{"key":"C","text":"The queen made Amy sleepy in the first text."},{"key":"D","text":"Ben felt sleepy because of the story."}],"answer":"D","explanation":"made Ben sleepy。","verify":"\"Ben felt sleepy because of the story.\""}]
