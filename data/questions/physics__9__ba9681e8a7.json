[{"id":"cnp_064_q1","topicId":"cnp_064","difficulty":"basic","type":"choice","prompt":"两只不同的灯泡串联，通过它们的电流有什么关系？","choices":[{"key":"A","text":"通过亮的灯电流大"},{"key":"B","text":"通过暗的灯电流大"},{"key":"C","text":"相等"},{"key":"D","text":"无法确定"}],"answer":"C","explanation":"串联电路中电流处处相等，与灯泡亮暗无关。","verify":"\"相等\""},{"id":"cnp_064_q2","topicId":"cnp_064","difficulty":"basic","type":"numeric","prompt":"两盏灯并联，通过它们的电流分别是 0.3 A 和 0.5 A，干路电流是多少 A？（只填数值）","answer":"0.8","explanation":"I = I₁ + I₂ = 0.3 + 0.5 = 0.8 A。","verify":"0.3+0.5"},{"id":"cnp_064_q3","topicId":"cnp_064","difficulty":"standard","type":"numeric","prompt":"并联电路中干路电流为 1.2 A，一条支路电流为 0.4 A，另一条支路电流是多少 A？（只填数值）","answer":"0.8","explanation":"I₂ = I - I₁ = 1.2 - 0.4 = 0.8 A。","verify":"1.2-0.4"},{"id":"cnp_064_q4","topicId":"cnp_064","difficulty":"standard","type":"choice","prompt":"探究串联电路电流规律时，换用不同规格的灯泡多次实验，目的是什么？","choices":[{"key":"A","text":"减小测量误差"},{"key":"B","text":"使灯泡更亮"},{"key":"C","text":"使结论具有普遍性"},{"key":"D","text":"保护电流表"}],"answer":"C","explanation":"多次实验、换不同规格灯泡是为了避免偶然性，得到普遍规律。","verify":"\"使结论具有普遍性\""}]
