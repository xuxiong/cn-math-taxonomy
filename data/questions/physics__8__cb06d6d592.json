[{"id":"cnp_013_q1","topicId":"cnp_013","difficulty":"basic","type":"choice","prompt":"冬天窗玻璃内侧出现的冰花，是什么物态变化形成的？","choices":[{"key":"A","text":"凝固"},{"key":"B","text":"凝华"},{"key":"C","text":"液化"},{"key":"D","text":"升华"}],"answer":"B","explanation":"室内水蒸气遇冷的玻璃直接变成固态的冰晶，是凝华。","verify":"\"凝华\""},{"id":"cnp_013_q2","topicId":"cnp_013","difficulty":"basic","type":"choice","prompt":"衣柜里的樟脑丸放久了会变小甚至消失，这是什么现象？","choices":[{"key":"A","text":"熔化"},{"key":"B","text":"汽化"},{"key":"C","text":"凝华"},{"key":"D","text":"升华"}],"answer":"D","explanation":"樟脑丸由固态直接变为气态，是升华。","verify":"\"升华\""},{"id":"cnp_013_q3","topicId":"cnp_013","difficulty":"standard","type":"choice","prompt":"下列物态变化中都放热的一组是哪一组？","choices":[{"key":"A","text":"熔化、汽化、升华"},{"key":"B","text":"熔化、液化、凝华"},{"key":"C","text":"凝固、汽化、升华"},{"key":"D","text":"凝固、液化、凝华"}],"answer":"D","explanation":"熔化、汽化、升华吸热；凝固、液化、凝华放热。","verify":"\"凝固、液化、凝华\""},{"id":"cnp_013_q4","topicId":"cnp_013","difficulty":"standard","type":"choice","prompt":"秋天早晨草叶上的露珠是怎样形成的？","choices":[{"key":"A","text":"水蒸气凝华"},{"key":"B","text":"水蒸气液化"},{"key":"C","text":"冰熔化"},{"key":"D","text":"水汽化"}],"answer":"B","explanation":"露是空气中的水蒸气遇冷液化成的小水珠；霜才是凝华。","verify":"\"水蒸气液化\""}]
