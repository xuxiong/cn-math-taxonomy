[{"id":"cne_p118_q1","topicId":"cne_p118","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「茶」？","choices":[{"key":"A","text":"sandwich"},{"key":"B","text":"salad"},{"key":"C","text":"hamburger"},{"key":"D","text":"tea"}],"answer":"D","explanation":"tea 的意思是茶。","verify":"\"tea\""},{"id":"cne_p118_q2","topicId":"cne_p118","difficulty":"basic","type":"choice","prompt":"「sandwich」的中文意思是哪一个？","choices":[{"key":"A","text":"三明治"},{"key":"B","text":"茶"},{"key":"C","text":"沙拉"},{"key":"D","text":"汉堡包"}],"answer":"A","explanation":"sandwich 的意思是三明治。","verify":"\"三明治\""},{"id":"cne_p118_q3","topicId":"cne_p118","difficulty":"standard","type":"choice","prompt":"选择表示「沙拉」的单词。","choices":[{"key":"A","text":"tea"},{"key":"B","text":"salad"},{"key":"C","text":"sandwich"},{"key":"D","text":"hamburger"}],"answer":"B","explanation":"表示沙拉的单词是 salad。","verify":"\"salad\""},{"id":"cne_p118_q4","topicId":"cne_p118","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「汉堡包」？","choices":[{"key":"A","text":"tea"},{"key":"B","text":"sandwich"},{"key":"C","text":"hamburger"},{"key":"D","text":"salad"}],"answer":"C","explanation":"hamburger 的意思是汉堡包。","verify":"\"hamburger\""},{"id":"cne_p119_q1","topicId":"cne_p119","difficulty":"basic","type":"choice","prompt":"想问对方想吃什么，应说哪一句？","choices":[{"key":"A","text":"What would you like to eat?"},{"key":"B","text":"What do you have on Mondays?"},{"key":"C","text":"Where is the kitchen?"},{"key":"D","text":"How much is the salad?"}],"answer":"A","explanation":"点餐问 What would you like to eat?","verify":"\"What would you like to eat?\""},{"id":"cne_p119_q2","topicId":"cne_p119","difficulty":"basic","type":"choice","prompt":"I would like a sandwich and some tea. 想要什么？","choices":[{"key":"A","text":"沙拉和汉堡包"},{"key":"B","text":"三明治和茶"},{"key":"C","text":"只三明治"},{"key":"D","text":"只茶"}],"answer":"B","explanation":"a sandwich and some tea。","verify":"\"三明治和茶\""},{"id":"cne_p119_q3","topicId":"cne_p119","difficulty":"standard","type":"choice","prompt":"What would you like to drink? 若想喝茶，应说哪一句？","choices":[{"key":"A","text":"I would like a hamburger."},{"key":"B","text":"I would like a sandwich."},{"key":"C","text":"I would like some tea."},{"key":"D","text":"I would like some salad."}],"answer":"C","explanation":"喝的是 tea。","verify":"\"I would like some tea.\""},{"id":"cne_p119_q4","topicId":"cne_p119","difficulty":"standard","type":"choice","prompt":"She would like a salad. 她想要什么？","choices":[{"key":"A","text":"一个汉堡包"},{"key":"B","text":"一杯茶"},{"key":"C","text":"一个三明治"},{"key":"D","text":"一份沙拉"}],"answer":"D","explanation":"a salad。","verify":"\"一份沙拉\""},{"id":"cne_p120_q1","topicId":"cne_p120","difficulty":"basic","type":"choice","prompt":"读一读：Sarah would like a sandwich. Mike would like a hamburger. Sarah 想要什么？","choices":[{"key":"A","text":"汉堡包"},{"key":"B","text":"三明治"},{"key":"C","text":"沙拉"},{"key":"D","text":"茶"}],"answer":"B","explanation":"Sarah 对应 sandwich。","verify":"\"三明治\""},{"id":"cne_p120_q2","topicId":"cne_p120","difficulty":"basic","type":"choice","prompt":"读一读：I would like some salad and some tea. 哪一句和文字一致？","choices":[{"key":"A","text":"我想要汉堡包。"},{"key":"B","text":"我想要一个三明治。"},{"key":"C","text":"我想要沙拉和茶。"},{"key":"D","text":"我只想要茶。"}],"answer":"C","explanation":"salad and tea 都写了。","verify":"\"我想要沙拉和茶。\""},{"id":"cne_p120_q3","topicId":"cne_p120","difficulty":"standard","type":"choice","prompt":"读一读：What would you like to eat? I would like a hamburger. 想吃什么？","choices":[{"key":"A","text":"三明治"},{"key":"B","text":"沙拉"},{"key":"C","text":"茶"},{"key":"D","text":"汉堡包"}],"answer":"D","explanation":"a hamburger。","verify":"\"汉堡包\""},{"id":"cne_p120_q4","topicId":"cne_p120","difficulty":"standard","type":"choice","prompt":"读一读：My favourite food is salad. It is healthy. 最喜欢的食物是什么？","choices":[{"key":"A","text":"沙拉"},{"key":"B","text":"茶"},{"key":"C","text":"汉堡包"},{"key":"D","text":"三明治"}],"answer":"A","explanation":"favourite food is salad。","verify":"\"沙拉\""}]
