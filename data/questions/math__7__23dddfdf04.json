[{"id":"cnm_033_q1","topicId":"cnm_033","difficulty":"basic","type":"short","prompt":"3a²b 与 -a²b 是同类项吗？（回答“是”或“不是”）","answer":"是","accept":["是","是的","是同类项"],"explanation":"两项所含字母都是 a、b，且 a 的指数都是 2，b 的指数都是 1，所以是同类项（系数不同不影响）。"},{"id":"cnm_033_q2","topicId":"cnm_033","difficulty":"basic","type":"choice","prompt":"下列各组中，是同类项的是哪一组？","answer":"C","choices":[{"key":"A","text":"2x 与 2y"},{"key":"B","text":"a²b 与 ab²"},{"key":"C","text":"3ab 与 -ba"},{"key":"D","text":"5x² 与 5x³"}],"explanation":"同类项要求字母相同且相同字母的指数相同。3ab 与 -ba 字母相同、指数都是 1（与字母顺序无关），是同类项；其余各组字母或指数不同。"},{"id":"cnm_033_q3","topicId":"cnm_033","difficulty":"standard","type":"numeric","prompt":"若 3x^2 y^n 与 -5x^m y^3 是同类项，求 m+n 的值。","answer":"5","explanation":"同类项中相同字母的指数相等：m=2，n=3，所以 m+n=5。","verify":"2+3"},{"id":"cnm_033_q4","topicId":"cnm_033","difficulty":"advanced","type":"choice","prompt":"下列说法正确的是哪一个？","answer":"D","choices":[{"key":"A","text":"所有的常数项都不是同类项"},{"key":"B","text":"2ab 与 2abc 是同类项"},{"key":"C","text":"x²y 与 xy² 是同类项，因为字母相同"},{"key":"D","text":"-3 与 5 是同类项"}],"explanation":"所有常数项都是同类项，所以 D 正确；2ab 与 2abc 字母不同；x²y 与 xy² 字母指数不同，都不是同类项。"},{"id":"cnm_034_q1","topicId":"cnm_034","difficulty":"basic","type":"short","prompt":"合并 5x²-3x²+x。","answer":"2x²+x","accept":["2x²+x","2x^2+x","x+2x²","x+2x^2"],"explanation":"5x² 与 -3x² 是同类项，系数相加 5-3=2，得 2x²，x 不是同类项，保留，结果为 2x²+x。"},{"id":"cnm_034_q2","topicId":"cnm_034","difficulty":"basic","type":"numeric","prompt":"合并同类项 3a+5a-2a 后，结果是 ka，求 k 的值。","answer":"6","explanation":"同类项合并时系数相加，字母部分不变：3+5-2=6，结果为 6a。","verify":"3+5-2"},{"id":"cnm_034_q3","topicId":"cnm_034","difficulty":"standard","type":"choice","prompt":"下列合并同类项正确的是哪一个？","answer":"A","choices":[{"key":"A","text":"4a²b-3ba²=a²b"},{"key":"B","text":"3a+2b=5ab"},{"key":"C","text":"5x²-2x²=3"},{"key":"D","text":"2x+3x²=5x³"}],"explanation":"4a²b 与 3ba² 是同类项，系数 4-3=1，得 a²b。B、D 不是同类项不能合并；C 合并后字母部分应保留，为 3x²。"},{"id":"cnm_034_q4","topicId":"cnm_034","difficulty":"advanced","type":"numeric","prompt":"多项式 2x²+mx-5x+3 合并同类项后不含 x 的一次项，求 m 的值。","answer":"5","explanation":"一次项合并为 (m-5)x，不含一次项即系数 m-5=0，所以 m=5。"},{"id":"cnm_035_q1","topicId":"cnm_035","difficulty":"basic","type":"short","prompt":"去括号：-(2x-3y+1)。","answer":"-2x+3y-1","accept":["-2x+3y-1","3y-2x-1","−2x+3y−1"],"explanation":"括号前是“-”号，去括号后括号内各项都要变号：-2x+3y-1。"},{"id":"cnm_035_q2","topicId":"cnm_035","difficulty":"basic","type":"choice","prompt":"a+(b-c) 去括号后等于哪一个？","answer":"B","choices":[{"key":"A","text":"a+b+c"},{"key":"B","text":"a+b-c"},{"key":"C","text":"a-b+c"},{"key":"D","text":"a-b-c"}],"explanation":"括号前是“+”号，去括号后括号内各项都不变号，所以是 a+b-c。"},{"id":"cnm_035_q3","topicId":"cnm_035","difficulty":"standard","type":"choice","prompt":"下列去括号正确的是哪一个？","answer":"C","choices":[{"key":"A","text":"5-(x-2)=5-x-2"},{"key":"B","text":"-(a-b)=-a-b"},{"key":"C","text":"2(a-3)=2a-6"},{"key":"D","text":"-3(x+y)=-3x+3y"}],"explanation":"A 应为 5-x+2；B 应为 -a+b；D 应为 -3x-3y；C 用分配律 2×a-2×3=2a-6 正确。"},{"id":"cnm_035_q4","topicId":"cnm_035","difficulty":"advanced","type":"numeric","prompt":"化简 2(x-1)-3(x-2)，结果写成 ax+b 的形式（a、b 为常数），求 a+b 的值。","answer":"3","explanation":"2(x-1)-3(x-2)=2x-2-3x+6=-x+4，所以 a=-1，b=4，a+b=3。","verify":"(2-3)+(-2+6)"},{"id":"cnm_036_q1","topicId":"cnm_036","difficulty":"standard","type":"short","prompt":"计算 (3x²-2x)-(x²-5x+1)。","answer":"2x²+3x-1","accept":["2x²+3x-1","2x^2+3x-1","3x+2x²-1","3x+2x^2-1"],"explanation":"去括号得 3x²-2x-x²+5x-1，合并同类项得 2x²+3x-1。"},{"id":"cnm_036_q2","topicId":"cnm_036","difficulty":"basic","type":"numeric","prompt":"计算 (2a+3)+(a-5)，结果写成 ma+n 的形式，求 m+n 的值。","answer":"1","explanation":"(2a+3)+(a-5)=3a-2，所以 m=3，n=-2，m+n=1。","verify":"(2+1)+(3-5)"},{"id":"cnm_036_q3","topicId":"cnm_036","difficulty":"standard","type":"choice","prompt":"已知 A=2x²-x，B=x²+3x-1，则 A-B 等于哪一个？","answer":"D","choices":[{"key":"A","text":"x²+2x-1"},{"key":"B","text":"x²-4x-1"},{"key":"C","text":"3x²+2x-1"},{"key":"D","text":"x²-4x+1"}],"explanation":"A-B=2x²-x-(x²+3x-1)=2x²-x-x²-3x+1=x²-4x+1，注意括号前是负号，-1 要变成 +1。"},{"id":"cnm_036_q4","topicId":"cnm_036","difficulty":"advanced","type":"numeric","prompt":"已知 A=x²+2x，B=2x²-x+3。化简 2A-B 后结果为 ax+b（a、b 为常数），求 a+b 的值。","answer":"2","explanation":"2A-B=2x²+4x-2x²+x-3=5x-3，所以 a=5，b=-3，a+b=2。","verify":"(2*2-(-1))+(0-3)"},{"id":"cnm_037_q1","topicId":"cnm_037","difficulty":"standard","type":"numeric","prompt":"化简求值：2(a²-ab)-(a²-2ab)，其中 a=-1，b=2。（只填最后的值）","answer":"1","explanation":"先化简：2a²-2ab-a²+2ab=a²，再代入 a=-1 得 (-1)²=1。","verify":"2*((-1)**2-(-1)*2)-((-1)**2-2*(-1)*2)"},{"id":"cnm_037_q2","topicId":"cnm_037","difficulty":"basic","type":"numeric","prompt":"先化简再求值：(x+3)+(2x-1)，其中 x=-1。","answer":"-1","explanation":"化简得 3x+2，代入 x=-1 得 3×(-1)+2=-1。","verify":"(-1+3)+(2*(-1)-1)"},{"id":"cnm_037_q3","topicId":"cnm_037","difficulty":"standard","type":"numeric","prompt":"先化简再求值：3(x²-2x)-2(x²-3x)，其中 x=-3。","answer":"9","explanation":"化简：3x²-6x-2x²+6x=x²，代入 x=-3 得 (-3)²=9。","verify":"3*((-3)**2-2*(-3))-2*((-3)**2-3*(-3))"},{"id":"cnm_037_q4","topicId":"cnm_037","difficulty":"advanced","type":"numeric","prompt":"先化简再求值：2(x²y+xy²)-(2x²y-xy²)，其中 x=1/2，y=-2。","answer":"6","explanation":"化简：2x²y+2xy²-2x²y+xy²=3xy²。代入得 3×(1/2)×(-2)²=3×(1/2)×4=6。","verify":"2*(Fraction(1,2)**2*(-2)+Fraction(1,2)*(-2)**2)-(2*Fraction(1,2)**2*(-2)-Fraction(1,2)*(-2)**2)"},{"id":"cnm_038_q1","topicId":"cnm_038","difficulty":"basic","type":"short","prompt":"长方形长为 a+2，宽为 a，周长怎样用整式表示？","answer":"4a+4","accept":["4a+4","4+4a","2(a+2)+2a"],"explanation":"周长=2×(长+宽)=2×(a+2+a)=2(2a+2)=4a+4。"},{"id":"cnm_038_q2","topicId":"cnm_038","difficulty":"basic","type":"numeric","prompt":"正方形的边长为 (x+1) cm，当 x=4 时，它的周长是多少 cm？","answer":"20","explanation":"周长为 4(x+1)，x=4 时为 4×5=20（cm）。","verify":"4*(4+1)"},{"id":"cnm_038_q3","topicId":"cnm_038","difficulty":"standard","type":"choice","prompt":"三角形三边的长分别是 a cm，(a+2) cm，(2a-1) cm，则它的周长是多少 cm？","answer":"C","choices":[{"key":"A","text":"4a+3"},{"key":"B","text":"3a+1"},{"key":"C","text":"4a+1"},{"key":"D","text":"4a-1"}],"explanation":"周长=a+(a+2)+(2a-1)=4a+1。"},{"id":"cnm_038_q4","topicId":"cnm_038","difficulty":"advanced","type":"numeric","prompt":"三角形的第一边长 (3a+2) cm，第二边比第一边长 (a-1) cm，第三边比第二边短 3 cm。周长化简为 pa+q（p、q 为常数），求 p+q 的值。","answer":"12","explanation":"第二边 3a+2+a-1=4a+1，第三边 4a+1-3=4a-2，周长 (3a+2)+(4a+1)+(4a-2)=11a+1，所以 p+q=12。","verify":"(3+4+4)+(2+1-2)"}]
