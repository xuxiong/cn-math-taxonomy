[{"id":"cnp_067_q1","topicId":"cnp_067","difficulty":"basic","type":"choice","prompt":"导体的电阻与下列哪个因素无关？","choices":[{"key":"A","text":"导体两端的电压"},{"key":"B","text":"导体的材料"},{"key":"C","text":"导体的长度"},{"key":"D","text":"导体的横截面积"}],"answer":"A","explanation":"电阻是导体本身的性质，与是否通电、电压大小无关。","verify":"\"导体两端的电压\""},{"id":"cnp_067_q2","topicId":"cnp_067","difficulty":"basic","type":"choice","prompt":"材料和横截面积相同的两根导线，较长的那根电阻怎样？","choices":[{"key":"A","text":"较大"},{"key":"B","text":"较小"},{"key":"C","text":"相等"},{"key":"D","text":"无法比较"}],"answer":"A","explanation":"其他条件相同时，导体越长，电阻越大。","verify":"\"较大\""},{"id":"cnp_067_q3","topicId":"cnp_067","difficulty":"standard","type":"numeric","prompt":"2 kΩ 等于多少 Ω？（只填数值）","answer":"2000","explanation":"1 kΩ = 1000 Ω。","verify":"2*1000"},{"id":"cnp_067_q4","topicId":"cnp_067","difficulty":"standard","type":"choice","prompt":"把一根导线均匀拉长到原来的 2 倍，它的电阻怎样变化？","choices":[{"key":"A","text":"变为原来的 4 倍"},{"key":"B","text":"变为原来的 2 倍"},{"key":"C","text":"不变"},{"key":"D","text":"变为原来的一半"}],"answer":"A","explanation":"长度变为 2 倍，横截面积变为一半，两个因素都使电阻变为 2 倍，所以电阻变为 4 倍。","verify":"\"变为原来的 4 倍\""}]
