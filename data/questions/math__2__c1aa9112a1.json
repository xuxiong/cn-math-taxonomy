[{"difficulty":"basic","type":"choice","prompt":"东和西是什么关系？","choices":[{"key":"A","text":"相反的方向"},{"key":"B","text":"同一个方向"},{"key":"C","text":"都在南边"}],"answer":"A","explanation":"东和西相反，南和北相反。","verify":"'相反的方向'","id":"cnm_p049_q1","topicId":"cnm_p049"},{"difficulty":"basic","type":"choice","prompt":"地图上通常是怎样定方向的？","choices":[{"key":"A","text":"上北下南，左西右东"},{"key":"B","text":"上南下北，左东右西"},{"key":"C","text":"没有固定方向"}],"answer":"A","explanation":"看地图时通常按上北下南、左西右东。","verify":"'上北下南，左西右东'","id":"cnm_p049_q2","topicId":"cnm_p049"},{"difficulty":"standard","type":"choice","prompt":"早晨小明面向东站着，他的背后是哪个方向？","choices":[{"key":"A","text":"东"},{"key":"B","text":"西"},{"key":"C","text":"南"},{"key":"D","text":"北"}],"answer":"B","explanation":"面向东，背后就是西。","verify":"'西'","id":"cnm_p049_q3","topicId":"cnm_p049"},{"difficulty":"challenge","type":"choice","prompt":"早晨小明面向东站着。他的右手边是哪个方向？","choices":[{"key":"A","text":"南"},{"key":"B","text":"北"},{"key":"C","text":"东"},{"key":"D","text":"西"}],"answer":"A","explanation":"面向东时，左手是北，右手是南。","verify":"'南'","id":"cnm_p049_q4","topicId":"cnm_p049"},{"difficulty":"basic","type":"choice","prompt":"校园导游图上，从校门口向东走到教学楼。图上通常向哪边画？","choices":[{"key":"A","text":"向右"},{"key":"B","text":"向上"},{"key":"C","text":"向左"}],"answer":"A","explanation":"地图上一般右东，向东就是向右。","verify":"'向右'","id":"cnm_p267_q1","topicId":"cnm_p267"},{"difficulty":"basic","type":"choice","prompt":"设计导游路线时，先要知道什么？","choices":[{"key":"A","text":"景点在东南西北哪个方向"},{"key":"B","text":"景点的价钱"},{"key":"C","text":"导游的身高"}],"answer":"A","explanation":"先辨清方向，才能说清怎么走。","verify":"'景点在东南西北哪个方向'","id":"cnm_p267_q2","topicId":"cnm_p267"},{"difficulty":"standard","type":"choice","prompt":"图书馆在教学楼的北面。从教学楼去图书馆，大致朝哪个方向走？","choices":[{"key":"A","text":"北"},{"key":"B","text":"南"},{"key":"C","text":"东"},{"key":"D","text":"西"}],"answer":"A","explanation":"在北面就要朝北走。","verify":"'北'","id":"cnm_p267_q3","topicId":"cnm_p267"},{"difficulty":"challenge","type":"choice","prompt":"路线是：校门向东到花坛，再向北到操场。若面向东走到花坛，下一步转身朝哪边走？","choices":[{"key":"A","text":"左转朝北"},{"key":"B","text":"右转朝南"},{"key":"C","text":"继续朝东"}],"answer":"A","explanation":"面向东时左转就是朝北。","verify":"'左转朝北'","id":"cnm_p267_q4","topicId":"cnm_p267"}]
