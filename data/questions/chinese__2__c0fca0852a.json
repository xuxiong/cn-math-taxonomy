[{"id":"cnc_p134_q1","topicId":"cnc_p134","difficulty":"basic","type":"choice","prompt":"「我」的彩色梦靠什么画出来？","choices":[{"key":"A","text":"一块黑炭"},{"key":"B","text":"没有颜色的水"},{"key":"C","text":"夜里的月亮"},{"key":"D","text":"一大把彩色铅笔"}],"answer":"D","explanation":"课文里那一大把彩色的梦，就是躺在铅笔盒里的彩色铅笔。","verify":"\"一大把彩色铅笔\""},{"id":"cnc_p134_q2","topicId":"cnc_p134","difficulty":"basic","type":"choice","prompt":"在这个梦里，草坪、野花是什么颜色的？","choices":[{"key":"A","text":"绿的、各色都有的"},{"key":"B","text":"全是黑色的"},{"key":"C","text":"只有白色"},{"key":"D","text":"颜色被风吹掉了"}],"answer":"A","explanation":"彩色铅笔能画出绿草坪、各色的花和蓝天。","verify":"\"绿的、各色都有的\""},{"id":"cnc_p134_q3","topicId":"cnc_p134","difficulty":"standard","type":"choice","prompt":"梦里的小朋友在做什么？","choices":[{"key":"A","text":"在冬天堆雪人"},{"key":"B","text":"在树林里唱歌、做游戏"},{"key":"C","text":"把铅笔全部折断"},{"key":"D","text":"躲起来不让人看见颜色"}],"answer":"B","explanation":"彩色的梦里有葱郁的森林，小朋友在那里快乐地玩。","verify":"\"在树林里唱歌、做游戏\""},{"id":"cnc_p134_q4","topicId":"cnc_p134","difficulty":"standard","type":"choice","prompt":"这首儿童诗主要写什么？","choices":[{"key":"A","text":"一个没有颜色的夜晚"},{"key":"B","text":"怎样削铅笔"},{"key":"C","text":"彩色铅笔带来的美丽想象"},{"key":"D","text":"梦里什么也看不见"}],"answer":"C","explanation":"题目就是彩色的梦。颜色和想象是这首诗的重点。","verify":"\"彩色铅笔带来的美丽想象\""},{"id":"cnc_p135_q1","topicId":"cnc_p135","difficulty":"basic","type":"choice","prompt":"散步时，妹妹怎样了？","choices":[{"key":"A","text":"走不动，想让人抱"},{"key":"B","text":"一个人先跑回了家"},{"key":"C","text":"在河边洗柳条"},{"key":"D","text":"帮妈妈砍了一棵树"}],"answer":"A","explanation":"妹妹走累了，不愿意再往前走。","verify":"\"走不动，想让人抱\""},{"id":"cnc_p135_q2","topicId":"cnc_p135","difficulty":"basic","type":"choice","prompt":"妈妈从路边拿来什么给妹妹？","choices":[{"key":"A","text":"一匹真的马"},{"key":"B","text":"一根柳条"},{"key":"C","text":"一辆自行车"},{"key":"D","text":"一把铁锹"}],"answer":"B","explanation":"妈妈没有抱她，而是给了她一根柳条。","verify":"\"一根柳条\""},{"id":"cnc_p135_q3","topicId":"cnc_p135","difficulty":"standard","type":"choice","prompt":"这根柳条在游戏里被当成什么？","choices":[{"key":"A","text":"一条小溪"},{"key":"B","text":"一把剪刀"},{"key":"C","text":"一匹马"},{"key":"D","text":"一顶草帽"}],"answer":"C","explanation":"妹妹把柳条夹在腿间，把它当成自己的马。","verify":"\"一匹马\""},{"id":"cnc_p135_q4","topicId":"cnc_p135","difficulty":"standard","type":"choice","prompt":"妹妹后来怎样回到家？","choices":[{"key":"A","text":"一直坐在路边等爸爸背"},{"key":"B","text":"柳条自己走回了家"},{"key":"C","text":"她更走不动了"},{"key":"D","text":"骑着这匹「马」自己跑回去"}],"answer":"D","explanation":"有了这匹出色的马，走不动的妹妹反而跑起来了。","verify":"\"骑着这匹「马」自己跑回去\""},{"id":"cnc_p136_q1","topicId":"cnc_p136","difficulty":"basic","type":"choice","prompt":"枫树长在哪里？它像什么？","choices":[{"key":"A","text":"长在沙漠里，像一把剪刀"},{"key":"B","text":"渡口旁，像一把绿色的太阳伞"},{"key":"C","text":"长在天坛，像柏树苗"},{"key":"D","text":"长在雪地里，像一座城堡"}],"answer":"B","explanation":"渡口旁的枫树绿荫打开着，像一把一直撑开的太阳伞。","verify":"\"渡口旁，像一把绿色的太阳伞\""},{"id":"cnc_p136_q2","topicId":"cnc_p136","difficulty":"basic","type":"choice","prompt":"「我」在心中怎样称呼窝边那只大喜鹊？","choices":[{"key":"A","text":"喜鹊爷爷"},{"key":"B","text":"长颈鹿大叔"},{"key":"C","text":"喜鹊阿姨"},{"key":"D","text":"鼹鼠先生"}],"answer":"C","explanation":"「我」像童话书里那样，称呼她是喜鹊阿姨。","verify":"\"喜鹊阿姨\""},{"id":"cnc_p136_q3","topicId":"cnc_p136","difficulty":"standard","type":"choice","prompt":"窝里的小喜鹊被「我」称作什么？","choices":[{"key":"A","text":"喜鹊老师"},{"key":"B","text":"喜鹊顾客"},{"key":"C","text":"喜鹊邮递员"},{"key":"D","text":"喜鹊弟弟"}],"answer":"D","explanation":"「我」称呼那几只小喜鹊为喜鹊弟弟。","verify":"\"喜鹊弟弟\""},{"id":"cnc_p136_q4","topicId":"cnc_p136","difficulty":"standard","type":"choice","prompt":"喜鹊阿姨站在窝边教弟弟做什么？","choices":[{"key":"A","text":"唱歌、做游戏"},{"key":"B","text":"卖泥塘"},{"key":"C","text":"植树"},{"key":"D","text":"赛龙舟"}],"answer":"A","explanation":"她一会儿教唱歌，一会儿教做游戏。「我」觉得自己听得懂。","verify":"\"唱歌、做游戏\""},{"id":"cnc_p137_q1","topicId":"cnc_p137","difficulty":"basic","type":"choice","prompt":"「不倒翁」的「倒」读哪一个？","choices":[{"key":"A","text":"dào（倒水的倒）"},{"key":"B","text":"diào（没有这个读音）"},{"key":"C","text":"dǎo（倒下的倒）"},{"key":"D","text":"dōu（都的读音）"}],"answer":"C","explanation":"不倒翁是倒下去还会起来，这里的倒读 dǎo。","verify":"\"dǎo（倒下的倒）\""},{"id":"cnc_p137_q2","topicId":"cnc_p137","difficulty":"basic","type":"choice","prompt":"「把水倒进杯子」的「倒」读哪一个？","choices":[{"key":"A","text":"dǎo（不倒翁的倒）"},{"key":"B","text":"táo（桃的读音）"},{"key":"C","text":"dù（渡的读音）"},{"key":"D","text":"dào（倒水的倒）"}],"answer":"D","explanation":"倒水、倒车的倒读 dào。同一个字，要按词语选定读音。","verify":"\"dào（倒水的倒）\""},{"id":"cnc_p137_q3","topicId":"cnc_p137","difficulty":"standard","type":"choice","prompt":"「失信不立」是什么意思？","choices":[{"key":"A","text":"不守信用，就站不住"},{"key":"B","text":"守信用的人会跌倒"},{"key":"C","text":"说话可以不算数"},{"key":"D","text":"信用只在玩具店里有用"}],"answer":"A","explanation":"这句话出自《左传》。失信，事情就立不起来。","verify":"\"不守信用，就站不住\""},{"id":"cnc_p137_q4","topicId":"cnc_p137","difficulty":"standard","type":"choice","prompt":"「诚信者，天下之结也」强调什么？","choices":[{"key":"A","text":"诚信只是一个人的私事"},{"key":"B","text":"诚信能把天下人联结在一起"},{"key":"C","text":"天下人不必讲信用"},{"key":"D","text":"结是一种玩具的名字"}],"answer":"B","explanation":"这句话出自《管子》。诚信是把人们连在一起的结。","verify":"\"诚信能把天下人联结在一起\""}]
