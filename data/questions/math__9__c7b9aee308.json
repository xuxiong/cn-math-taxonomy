[{"id":"cnm_220_q1","topicId":"cnm_220","difficulty":"basic","type":"numeric","prompt":"解方程 (x-1)²=9。（两个根用逗号隔开）","answer":"4，-2","unordered":true,"explanation":"两边开平方得 x-1=3 或 x-1=-3，所以 x=4 或 x=-2。","verify":"[1+isqrt(9), 1-isqrt(9)]"},{"id":"cnm_220_q2","topicId":"cnm_220","difficulty":"basic","type":"numeric","prompt":"解方程 x²=49。（两个根用逗号隔开）","answer":"7，-7","unordered":true,"explanation":"49 的平方根是 ±7，所以 x=7 或 x=-7。","verify":"[isqrt(49), -isqrt(49)]"},{"id":"cnm_220_q3","topicId":"cnm_220","difficulty":"standard","type":"numeric","prompt":"解方程 4(x+2)²=25。（两个根用逗号隔开，写成最简分数或整数）","answer":"1/2，-9/2","unordered":true,"explanation":"先化为 (x+2)²=25/4，开平方得 x+2=±5/2，所以 x=1/2 或 x=-9/2。","verify":"[Fraction(5,2)-2, -Fraction(5,2)-2]"},{"id":"cnm_220_q4","topicId":"cnm_220","difficulty":"advanced","type":"choice","prompt":"关于 x 的方程 (x-2)²=k-3 有两个不相等的实数根，则 k 的取值范围是？","choices":[{"key":"A","text":"k≥3"},{"key":"B","text":"k<3"},{"key":"C","text":"k>3"},{"key":"D","text":"k>2"}],"answer":"C","explanation":"(x-2)² 非负。要有两个不相等的实根，需 k-3>0，即 k>3；k=3 时只有一个根，k<3 时无实根。"},{"id":"cnm_221_q1","topicId":"cnm_221","difficulty":"standard","type":"choice","prompt":"用配方法解 x²-4x-1=0。下列配方及结果正确的是哪一个？","choices":[{"key":"A","text":"(x-2)²=3，x=2±√3"},{"key":"B","text":"(x+2)²=5，x=-2±√5"},{"key":"C","text":"(x-2)²=5，x=2±√5"},{"key":"D","text":"(x-4)²=17，x=4±√17"}],"answer":"C","explanation":"移项 x²-4x=1，两边加 (4/2)²=4 得 (x-2)²=5，所以 x=2±√5。A 漏加了常数项的处理，B 符号错，D 配方时加错了数。"},{"id":"cnm_221_q2","topicId":"cnm_221","difficulty":"basic","type":"numeric","prompt":"要把 x²+6x 配成完全平方式，需要加上的常数是多少？","answer":"9","explanation":"加上一次项系数一半的平方：(6/2)²=9，得 x²+6x+9=(x+3)²。","verify":"(6//2)**2"},{"id":"cnm_221_q3","topicId":"cnm_221","difficulty":"standard","type":"numeric","prompt":"用配方法解方程 x²+6x-7=0。（两个根用逗号隔开）","answer":"1，-7","unordered":true,"explanation":"移项 x²+6x=7，两边加 9 得 (x+3)²=16，x+3=±4，所以 x=1 或 x=-7。","verify":"[-3+isqrt(16), -3-isqrt(16)]"},{"id":"cnm_221_q4","topicId":"cnm_221","difficulty":"advanced","type":"numeric","prompt":"把 2x²-8x+1=0 配方成 2(x-m)²=n 的形式，依次求 m 与 n 的值（用逗号隔开）。","answer":"2，7","explanation":"2x²-8x=-1，即 2(x²-4x)=-1，括号内加 4 的同时右边加 2×4=8，得 2(x-2)²=7，所以 m=2，n=7。","verify":"[8//(2*2), 2*(8//(2*2))**2-1]"},{"id":"cnm_222_q1","topicId":"cnm_222","difficulty":"standard","type":"numeric","prompt":"用公式法解 2x²-3x-2=0。（两个根用逗号隔开）","answer":"2，-1/2","unordered":true,"explanation":"a=2，b=-3，c=-2，b²-4ac=9+16=25，x=(3±5)/4，所以 x=2 或 x=-1/2。","verify":"roots2(2,-3,-2)"},{"id":"cnm_222_q2","topicId":"cnm_222","difficulty":"basic","type":"numeric","prompt":"用公式法解方程 x²-x-6=0。（两个根用逗号隔开）","answer":"3，-2","unordered":true,"explanation":"a=1，b=-1，c=-6，b²-4ac=1+24=25，x=(1±5)/2，所以 x=3 或 x=-2。","verify":"roots2(1,-1,-6)"},{"id":"cnm_222_q3","topicId":"cnm_222","difficulty":"standard","type":"choice","prompt":"用求根公式解方程 3x²+5x-1=0，结果正确的是哪一个？","choices":[{"key":"A","text":"x=(5±√37)/6"},{"key":"B","text":"x=(-5±√13)/6"},{"key":"C","text":"x=(-5±√37)/3"},{"key":"D","text":"x=(-5±√37)/6"}],"answer":"D","explanation":"a=3，b=5，c=-1，b²-4ac=25+12=37，x=(-5±√37)/(2×3)=(-5±√37)/6。A 漏了 -b 的负号，B 算错判别式，C 分母应为 2a=6。"},{"id":"cnm_222_q4","topicId":"cnm_222","difficulty":"advanced","type":"numeric","prompt":"用公式法解方程 (2x-1)(x+1)=2。（两个根用逗号隔开）","answer":"1，-3/2","unordered":true,"explanation":"展开得 2x²+x-1=2，化为 2x²+x-3=0。b²-4ac=1+24=25，x=(-1±5)/4，所以 x=1 或 x=-3/2。","verify":"roots2(2,1,-3)"},{"id":"cnm_223_q1","topicId":"cnm_223","difficulty":"standard","type":"choice","prompt":"x²-4x+k=0 有两个不相等实根，求 k 的范围。下列正确的是哪一个？","choices":[{"key":"A","text":"k>4"},{"key":"B","text":"k≥4"},{"key":"C","text":"k<4"},{"key":"D","text":"k≤4"}],"answer":"C","explanation":"两个不相等实根需 Δ=16-4k>0，解得 k<4。k=4 时是两个相等的根，不符合“不相等”。"},{"id":"cnm_223_q2","topicId":"cnm_223","difficulty":"basic","type":"numeric","prompt":"求方程 x²-3x-4=0 的判别式 b²-4ac 的值。","answer":"25","explanation":"a=1，b=-3，c=-4，Δ=(-3)²-4×1×(-4)=9+16=25。","verify":"(-3)**2-4*1*(-4)"},{"id":"cnm_223_q3","topicId":"cnm_223","difficulty":"standard","type":"choice","prompt":"方程 2x²-3x+5=0 的根的情况是？","choices":[{"key":"A","text":"没有实数根"},{"key":"B","text":"有两个不相等的实数根"},{"key":"C","text":"有两个相等的实数根"}],"answer":"A","explanation":"Δ=(-3)²-4×2×5=9-40=-31<0，所以方程没有实数根。"},{"id":"cnm_223_q4","topicId":"cnm_223","difficulty":"advanced","type":"numeric","prompt":"关于 x 的一元二次方程 kx²-2x+1=0 有两个不相等的实数根，求整数 k 的最大值。","answer":"-1","explanation":"需 k≠0 且 Δ=4-4k>0，得 k<1 且 k≠0。k<1 的最大整数是 0，但 k≠0，所以最大整数为 -1。","verify":"max([k for k in range(-10,10) if k!=0 and 4-4*k>0])"},{"id":"cnm_224_q1","topicId":"cnm_224","difficulty":"basic","type":"numeric","prompt":"解方程 x²-5x+6=0。（两个根用逗号隔开）","answer":"2，3","unordered":true,"explanation":"左边分解为 (x-2)(x-3)=0，所以 x=2 或 x=3。","verify":"roots2(1,-5,6)"},{"id":"cnm_224_q2","topicId":"cnm_224","difficulty":"basic","type":"numeric","prompt":"解方程 x²+4x=0。（两个根用逗号隔开）","answer":"0，-4","unordered":true,"explanation":"提公因式得 x(x+4)=0，所以 x=0 或 x=-4。","verify":"roots2(1,4,0)"},{"id":"cnm_224_q3","topicId":"cnm_224","difficulty":"standard","type":"numeric","prompt":"解方程 2x²-5x-3=0。（两个根用逗号隔开）","answer":"3，-1/2","unordered":true,"explanation":"十字相乘分解得 (2x+1)(x-3)=0，所以 x=-1/2 或 x=3。","verify":"roots2(2,-5,-3)"},{"id":"cnm_224_q4","topicId":"cnm_224","difficulty":"advanced","type":"numeric","prompt":"解方程 (x-2)²=3(x-2)。（两个根用逗号隔开；注意不要两边同除以 x-2）","answer":"2，5","unordered":true,"explanation":"移项得 (x-2)²-3(x-2)=0，提公因式 (x-2)(x-2-3)=0，即 (x-2)(x-5)=0，所以 x=2 或 x=5。两边同除以 x-2 会丢掉根 x=2。","verify":"roots2(1,-7,10)"},{"id":"cnm_225_q1","topicId":"cnm_225","difficulty":"basic","type":"choice","prompt":"解方程 3x²=6x，选用什么方法？下列最合适的是哪一个？","choices":[{"key":"A","text":"因式分解法"},{"key":"B","text":"直接开平方法"},{"key":"C","text":"配方法"},{"key":"D","text":"公式法"}],"answer":"A","explanation":"移项得 3x²-6x=0，提公因式得 3x(x-2)=0，x=0 或 2，用因式分解法最简便。"},{"id":"cnm_225_q2","topicId":"cnm_225","difficulty":"basic","type":"numeric","prompt":"用最简便的方法解方程 (x+1)²=16。（两个根用逗号隔开）","answer":"3，-5","unordered":true,"explanation":"左边是完全平方，直接开平方：x+1=±4，所以 x=3 或 x=-5。","verify":"[-1+isqrt(16), -1-isqrt(16)]"},{"id":"cnm_225_q3","topicId":"cnm_225","difficulty":"standard","type":"choice","prompt":"下列方程中，最适合用直接开平方法求解的是哪一个？","choices":[{"key":"A","text":"x²-4x=5"},{"key":"B","text":"(2x-1)²=9"},{"key":"C","text":"x²+3x-1=0"},{"key":"D","text":"x(x-2)=3x"}],"answer":"B","explanation":"B 已是 (含 x 的式子)²=常数 的形式，可直接开平方；D 适合因式分解，A、C 适合配方或公式法。"},{"id":"cnm_225_q4","topicId":"cnm_225","difficulty":"advanced","type":"numeric","prompt":"解方程 (2x-3)²=(x+1)²。（两个根用逗号隔开，写成整数或最简分数）","answer":"4，2/3","unordered":true,"explanation":"两边开平方得 2x-3=x+1 或 2x-3=-(x+1)。前者 x=4，后者 3x=2，x=2/3。也可移项后用平方差因式分解。","verify":"roots2(3,-14,8)"}]
