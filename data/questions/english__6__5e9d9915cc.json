[{"id":"cne_p159_q1","topicId":"cne_p159","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「公共汽车」？","choices":[{"key":"A","text":"bus"},{"key":"B","text":"plane"},{"key":"C","text":"ship"},{"key":"D","text":"train"}],"answer":"A","explanation":"bus 的意思是公共汽车。","verify":"\"bus\""},{"id":"cne_p159_q2","topicId":"cne_p159","difficulty":"basic","type":"choice","prompt":"「plane」的中文意思是哪一个？","choices":[{"key":"A","text":"公共汽车"},{"key":"B","text":"飞机"},{"key":"C","text":"轮船"},{"key":"D","text":"火车"}],"answer":"B","explanation":"plane 的意思是飞机。","verify":"\"飞机\""},{"id":"cne_p159_q3","topicId":"cne_p159","difficulty":"standard","type":"choice","prompt":"选择表示「轮船」的单词。","choices":[{"key":"A","text":"bus"},{"key":"B","text":"plane"},{"key":"C","text":"ship"},{"key":"D","text":"train"}],"answer":"C","explanation":"表示轮船的单词是 ship。","verify":"\"ship\""},{"id":"cne_p159_q4","topicId":"cne_p159","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「火车」？","choices":[{"key":"A","text":"bus"},{"key":"B","text":"plane"},{"key":"C","text":"ship"},{"key":"D","text":"train"}],"answer":"D","explanation":"train 的意思是火车。","verify":"\"train\""},{"id":"cne_p160_q1","topicId":"cne_p160","difficulty":"basic","type":"choice","prompt":"哪一句表示「你必须停」？","choices":[{"key":"A","text":"You must stops."},{"key":"B","text":"You must stop."},{"key":"C","text":"You are must stop."},{"key":"D","text":"You stop must."}],"answer":"B","explanation":"must 后面用动词原形 stop。","verify":"\"You must stop.\""},{"id":"cne_p160_q2","topicId":"cne_p160","difficulty":"basic","type":"choice","prompt":"Do not go at a red light. 红灯时应该怎样？","choices":[{"key":"A","text":"可以走"},{"key":"B","text":"必须跑"},{"key":"C","text":"不要走"},{"key":"D","text":"左转"}],"answer":"C","explanation":"Do not go 是不要走。","verify":"\"不要走\""},{"id":"cne_p160_q3","topicId":"cne_p160","difficulty":"standard","type":"choice","prompt":"We must look right before crossing. 过马路前必须看哪边？","choices":[{"key":"A","text":"左边"},{"key":"B","text":"上面"},{"key":"C","text":"后面"},{"key":"D","text":"右边"}],"answer":"D","explanation":"句子写的是 look right。","verify":"\"右边\""},{"id":"cne_p160_q4","topicId":"cne_p160","difficulty":"standard","type":"choice","prompt":"I must pay attention to the traffic lights. 这句是在说什么？","choices":[{"key":"A","text":"必须注意交通信号灯"},{"key":"B","text":"可以不看信号灯"},{"key":"C","text":"信号灯在书店"},{"key":"D","text":"我不会看信号灯"}],"answer":"A","explanation":"must pay attention to the traffic lights。","verify":"\"必须注意交通信号灯\""},{"id":"cne_p161_q1","topicId":"cne_p161","difficulty":"basic","type":"choice","prompt":"想说自己骑自行车来学校，应说哪一句？","choices":[{"key":"A","text":"I come to school by bus."},{"key":"B","text":"I come to school by train."},{"key":"C","text":"I come to school by bike."},{"key":"D","text":"I come to school by plane."}],"answer":"C","explanation":"自行车是 by bike。","verify":"\"I come to school by bike.\""},{"id":"cne_p161_q2","topicId":"cne_p161","difficulty":"basic","type":"choice","prompt":"How do you come to school? 这句是在问什么？","choices":[{"key":"A","text":"学校在哪里"},{"key":"B","text":"你必须停下吗"},{"key":"C","text":"你喜欢公共汽车吗"},{"key":"D","text":"你怎么来学校"}],"answer":"D","explanation":"How do you come 问方式。","verify":"\"你怎么来学校\""},{"id":"cne_p161_q3","topicId":"cne_p161","difficulty":"standard","type":"choice","prompt":"I usually walk. 这个人通常怎么来？","choices":[{"key":"A","text":"步行"},{"key":"B","text":"坐公共汽车"},{"key":"C","text":"坐火车"},{"key":"D","text":"坐飞机"}],"answer":"A","explanation":"walk 是步行。","verify":"\"步行\""},{"id":"cne_p161_q4","topicId":"cne_p161","difficulty":"standard","type":"choice","prompt":"Slow down and stop at a yellow light. 黄灯时应该怎样？","choices":[{"key":"A","text":"加速通过"},{"key":"B","text":"减速并停下"},{"key":"C","text":"不必看灯"},{"key":"D","text":"可以跑"}],"answer":"B","explanation":"Slow down and stop。","verify":"\"减速并停下\""},{"id":"cne_p162_q1","topicId":"cne_p162","difficulty":"basic","type":"choice","prompt":"读一读：I come to school by bus. Amy says, \"I come by bike.\" Amy 怎么来学校？","choices":[{"key":"A","text":"坐公共汽车"},{"key":"B","text":"步行"},{"key":"C","text":"坐火车"},{"key":"D","text":"骑自行车"}],"answer":"D","explanation":"引号里写的是 I come by bike。","verify":"\"骑自行车\""},{"id":"cne_p162_q2","topicId":"cne_p162","difficulty":"basic","type":"choice","prompt":"读一读：Do not go at a red light. You must stop. 红灯时必须怎样？","choices":[{"key":"A","text":"停下"},{"key":"B","text":"走"},{"key":"C","text":"跑"},{"key":"D","text":"左转"}],"answer":"A","explanation":"must stop。","verify":"\"停下\""},{"id":"cne_p162_q3","topicId":"cne_p162","difficulty":"standard","type":"choice","prompt":"读一读：In China, people drive on the right. 在中国，车靠哪边行驶？","choices":[{"key":"A","text":"左边"},{"key":"B","text":"右边"},{"key":"C","text":"中间"},{"key":"D","text":"短文没写"}],"answer":"B","explanation":"on the right。","verify":"\"右边\""},{"id":"cne_p162_q4","topicId":"cne_p162","difficulty":"standard","type":"choice","prompt":"读一读：Some children come by subway. 哪一句和短文一致？","choices":[{"key":"A","text":"所有孩子步行。"},{"key":"B","text":"孩子们坐飞机来。"},{"key":"C","text":"有些孩子坐地铁来。"},{"key":"D","text":"孩子们不来学校。"}],"answer":"C","explanation":"by subway。","verify":"\"有些孩子坐地铁来。\""},{"id":"cne_p207_q1","topicId":"cne_p207","difficulty":"basic","type":"choice","prompt":"turn off the lights 的意思是？","choices":[{"key":"A","text":"修灯"},{"key":"B","text":"开灯"},{"key":"C","text":"换灯"},{"key":"D","text":"关灯"}],"answer":"D","explanation":"turn off 是关掉。","verify":"\"关灯\""},{"id":"cne_p207_q2","topicId":"cne_p207","difficulty":"basic","type":"choice","prompt":"solar energy 是什么能？","choices":[{"key":"A","text":"水能"},{"key":"B","text":"煤炭"},{"key":"C","text":"风能"},{"key":"D","text":"太阳能"}],"answer":"D","explanation":"solar 和太阳有关。","verify":"\"太阳能\""},{"id":"cne_p207_q3","topicId":"cne_p207","difficulty":"standard","type":"choice","prompt":"We can ____ energy by taking the bus. 坐公交可以节约能源。","choices":[{"key":"A","text":"spend"},{"key":"B","text":"save"},{"key":"C","text":"make"},{"key":"D","text":"waste"}],"answer":"B","explanation":"节约用 save。","verify":"\"save\""},{"id":"cne_p207_q4","topicId":"cne_p207","difficulty":"standard","type":"choice","prompt":"哪种做法会浪费能源？","choices":[{"key":"A","text":"Leave the TV on all night."},{"key":"B","text":"Walk to school."},{"key":"C","text":"Use both sides of paper."},{"key":"D","text":"Turn off the lights."}],"answer":"A","explanation":"整夜开着电视浪费电。","verify":"\"Leave the TV on all night.\""},{"id":"cne_p208_q1","topicId":"cne_p208","difficulty":"basic","type":"choice","prompt":"Please ride a bike or walk to school. 这条倡议鼓励什么？","choices":[{"key":"A","text":"在家上课"},{"key":"B","text":"多买自行车"},{"key":"C","text":"绿色出行"},{"key":"D","text":"多坐出租车"}],"answer":"C","explanation":"骑车或步行是绿色出行。","verify":"\"绿色出行\""},{"id":"cne_p208_q2","topicId":"cne_p208","difficulty":"basic","type":"choice","prompt":"Don't leave the lights on. 意思是？","choices":[{"key":"A","text":"灯坏了"},{"key":"B","text":"不要买灯"},{"key":"C","text":"不要开着灯不关"},{"key":"D","text":"不要关灯"}],"answer":"C","explanation":"leave the lights on 是让灯一直亮着。","verify":"\"不要开着灯不关\""},{"id":"cne_p208_q3","topicId":"cne_p208","difficulty":"standard","type":"choice","prompt":"Save energy, save our earth! 这句话的主题是？","choices":[{"key":"A","text":"学好英语"},{"key":"B","text":"节约零花钱"},{"key":"C","text":"节约能源，保护地球"},{"key":"D","text":"探索太空"}],"answer":"C","explanation":"energy 是能源，earth 是地球。","verify":"\"节约能源，保护地球\""},{"id":"cne_p208_q4","topicId":"cne_p208","difficulty":"standard","type":"choice","prompt":"哪一句适合写进节能倡议？","choices":[{"key":"A","text":"Open the fridge often."},{"key":"B","text":"Use the stairs, not the lift, for one floor."},{"key":"C","text":"Keep the air conditioner on all day."},{"key":"D","text":"Print every page twice."}],"answer":"B","explanation":"走楼梯少用电梯，能省电。","verify":"\"Use the stairs, not the lift, for one floor.\""}]
