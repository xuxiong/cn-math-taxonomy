[{"id":"cne_p108_q1","topicId":"cne_p108","difficulty":"basic","type":"choice","prompt":"哪个单词以 bl 开头？","choices":[{"key":"A","text":"class"},{"key":"B","text":"black"},{"key":"C","text":"floor"},{"key":"D","text":"green"}],"answer":"B","explanation":"black 以 bl 开头。","verify":"\"black\""},{"id":"cne_p108_q2","topicId":"cne_p108","difficulty":"basic","type":"choice","prompt":"哪个单词以 cl 开头？","choices":[{"key":"A","text":"black"},{"key":"B","text":"blue"},{"key":"C","text":"class"},{"key":"D","text":"floor"}],"answer":"C","explanation":"class 以 cl 开头。","verify":"\"class\""},{"id":"cne_p108_q3","topicId":"cne_p108","difficulty":"standard","type":"choice","prompt":"哪个单词以 fl 开头？","choices":[{"key":"A","text":"black"},{"key":"B","text":"class"},{"key":"C","text":"blue"},{"key":"D","text":"floor"}],"answer":"D","explanation":"floor 以 fl 开头。","verify":"\"floor\""},{"id":"cne_p108_q4","topicId":"cne_p108","difficulty":"standard","type":"choice","prompt":"blue 和哪个词的开头辅音连缀相同？","choices":[{"key":"A","text":"black"},{"key":"B","text":"class"},{"key":"C","text":"floor"},{"key":"D","text":"green"}],"answer":"A","explanation":"blue 和 black 都以 bl 开头。","verify":"\"black\""},{"id":"cne_p109_q1","topicId":"cne_p109","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「年老的」？","choices":[{"key":"A","text":"young"},{"key":"B","text":"kind"},{"key":"C","text":"old"},{"key":"D","text":"strict"}],"answer":"C","explanation":"old 的意思是年老的。","verify":"\"old\""},{"id":"cne_p109_q2","topicId":"cne_p109","difficulty":"basic","type":"choice","prompt":"「young」的中文意思是哪一个？","choices":[{"key":"A","text":"年老的"},{"key":"B","text":"和蔼的"},{"key":"C","text":"严格的"},{"key":"D","text":"年轻的"}],"answer":"D","explanation":"young 的意思是年轻的。","verify":"\"年轻的\""},{"id":"cne_p109_q3","topicId":"cne_p109","difficulty":"standard","type":"choice","prompt":"选择表示「和蔼的」的单词。","choices":[{"key":"A","text":"kind"},{"key":"B","text":"old"},{"key":"C","text":"young"},{"key":"D","text":"strict"}],"answer":"A","explanation":"表示和蔼的的单词是 kind。","verify":"\"kind\""},{"id":"cne_p109_q4","topicId":"cne_p109","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「严格的」？","choices":[{"key":"A","text":"old"},{"key":"B","text":"strict"},{"key":"C","text":"young"},{"key":"D","text":"kind"}],"answer":"B","explanation":"strict 的意思是严格的。","verify":"\"strict\""},{"id":"cne_p110_q1","topicId":"cne_p110","difficulty":"basic","type":"choice","prompt":"What is he like? 这句是在问什么？","choices":[{"key":"A","text":"他喜欢什么"},{"key":"B","text":"他在哪里"},{"key":"C","text":"他是谁"},{"key":"D","text":"他是什么样的人"}],"answer":"D","explanation":"What is he like 问性格或外貌，不是问喜好。","verify":"\"他是什么样的人\""},{"id":"cne_p110_q2","topicId":"cne_p110","difficulty":"basic","type":"choice","prompt":"He is kind. 他怎么样？","choices":[{"key":"A","text":"很和蔼"},{"key":"B","text":"很严格"},{"key":"C","text":"很年轻"},{"key":"D","text":"很强壮"}],"answer":"A","explanation":"kind 是和蔼的。","verify":"\"很和蔼\""},{"id":"cne_p110_q3","topicId":"cne_p110","difficulty":"standard","type":"choice","prompt":"哪一句表示「她很严格」？","choices":[{"key":"A","text":"She is kind."},{"key":"B","text":"She is strict."},{"key":"C","text":"She is funny."},{"key":"D","text":"She is quiet."}],"answer":"B","explanation":"严格是 strict。","verify":"\"She is strict.\""},{"id":"cne_p110_q4","topicId":"cne_p110","difficulty":"standard","type":"choice","prompt":"Miss White is young. 怀特老师怎么样？","choices":[{"key":"A","text":"很年老"},{"key":"B","text":"很和蔼"},{"key":"C","text":"很年轻"},{"key":"D","text":"很有趣"}],"answer":"C","explanation":"young 是年轻的。句子没有说她和蔼。","verify":"\"很年轻\""},{"id":"cne_p111_q1","topicId":"cne_p111","difficulty":"basic","type":"choice","prompt":"想说音乐老师很和蔼，应说哪一句？","choices":[{"key":"A","text":"The music teacher is kind."},{"key":"B","text":"The music teacher is strict."},{"key":"C","text":"The music teacher is old."},{"key":"D","text":"The music teacher is young."}],"answer":"A","explanation":"和蔼是 kind。","verify":"\"The music teacher is kind.\""},{"id":"cne_p111_q2","topicId":"cne_p111","difficulty":"basic","type":"choice","prompt":"Who is your English teacher? 这句是在问什么？","choices":[{"key":"A","text":"英语老师什么样"},{"key":"B","text":"谁是你的英语老师"},{"key":"C","text":"你喜欢英语吗"},{"key":"D","text":"英语课在星期几"}],"answer":"B","explanation":"Who is 问是谁。","verify":"\"谁是你的英语老师\""},{"id":"cne_p111_q3","topicId":"cne_p111","difficulty":"standard","type":"choice","prompt":"She is strict but kind. 这句的意思是？","choices":[{"key":"A","text":"她只是很年轻"},{"key":"B","text":"她不严格"},{"key":"C","text":"她严格但是和蔼"},{"key":"D","text":"她很有趣"}],"answer":"C","explanation":"strict but kind。","verify":"\"她严格但是和蔼\""},{"id":"cne_p111_q4","topicId":"cne_p111","difficulty":"standard","type":"choice","prompt":"Mr Young is our art teacher. 杨老师教什么？","choices":[{"key":"A","text":"音乐"},{"key":"B","text":"英语"},{"key":"C","text":"数学"},{"key":"D","text":"美术"}],"answer":"D","explanation":"art teacher 是美术老师。","verify":"\"美术\""},{"id":"cne_p112_q1","topicId":"cne_p112","difficulty":"basic","type":"choice","prompt":"读一读：Mr Li is our maths teacher. He is tall and strict. 李老师怎么样？","choices":[{"key":"A","text":"又矮又和蔼"},{"key":"B","text":"又高又严格"},{"key":"C","text":"年轻而且有趣"},{"key":"D","text":"只说了他很老"}],"answer":"B","explanation":"tall and strict。","verify":"\"又高又严格\""},{"id":"cne_p112_q2","topicId":"cne_p112","difficulty":"basic","type":"choice","prompt":"读一读：Miss White is young and kind. 哪一句和短文一致？","choices":[{"key":"A","text":"怀特老师年老而且严格。"},{"key":"B","text":"怀特老师是男老师。"},{"key":"C","text":"怀特老师年轻而且和蔼。"},{"key":"D","text":"怀特老师教数学。"}],"answer":"C","explanation":"young and kind，Miss 通常指女老师。","verify":"\"怀特老师年轻而且和蔼。\""},{"id":"cne_p112_q3","topicId":"cne_p112","difficulty":"standard","type":"choice","prompt":"读一读：I like my Chinese teacher. She is funny. 语文老师怎么样？","choices":[{"key":"A","text":"很严格"},{"key":"B","text":"很年老"},{"key":"C","text":"很安静"},{"key":"D","text":"很有趣"}],"answer":"D","explanation":"funny 是有趣。","verify":"\"很有趣\""},{"id":"cne_p112_q4","topicId":"cne_p112","difficulty":"standard","type":"choice","prompt":"读一读：He is old. He is kind. 哪一句是短文里有的意思？","choices":[{"key":"A","text":"他又年老又和蔼。"},{"key":"B","text":"他很年轻。"},{"key":"C","text":"他很严格。"},{"key":"D","text":"他不和蔼。"}],"answer":"A","explanation":"old 和 kind 都写了。","verify":"\"他又年老又和蔼。\""},{"id":"cne_p198_q1","topicId":"cne_p198","difficulty":"basic","type":"choice","prompt":"哪个单词含有和 day 中 ay 相同的读音？","choices":[{"key":"A","text":"car"},{"key":"B","text":"rain"},{"key":"C","text":"cat"},{"key":"D","text":"ball"}],"answer":"B","explanation":"ay 和 ai 都读 /eɪ/。","verify":"\"rain\""},{"id":"cne_p198_q2","topicId":"cne_p198","difficulty":"basic","type":"choice","prompt":"The dog likes to ____ in the rain. 横线上填哪个含 ay 的词？","choices":[{"key":"A","text":"play"},{"key":"B","text":"way"},{"key":"C","text":"say"},{"key":"D","text":"pay"}],"answer":"A","explanation":"play 是玩耍，句意通顺。","verify":"\"play\""},{"id":"cne_p198_q3","topicId":"cne_p198","difficulty":"standard","type":"choice","prompt":"哪组单词的划线部分读音相同：ai、ay？","choices":[{"key":"A","text":"rain — day"},{"key":"B","text":"play — apple"},{"key":"C","text":"rain — hat"},{"key":"D","text":"day — dog"}],"answer":"A","explanation":"ai 和 ay 都读 /eɪ/。","verify":"\"rain — day\""},{"id":"cne_p198_q4","topicId":"cne_p198","difficulty":"standard","type":"choice","prompt":"给 s__l（航行）选字母组合，读作 /seɪl/。","choices":[{"key":"A","text":"ai"},{"key":"B","text":"ar"},{"key":"C","text":"ee"},{"key":"D","text":"ay"}],"answer":"A","explanation":"ai 常在词中，ay 常在词尾，sail 写作 ai。","verify":"\"ai\""}]
