[{"id":"cnm_h134_q1","topicId":"cnm_h134","difficulty":"basic","type":"numeric","prompt":"抛一枚均匀硬币 2 次，样本点有多少个？","answer":"4","explanation":"每次正反两种，两次共 4 个：正正、正反、反正、反反。","verify":"2**2"},{"id":"cnm_h134_q2","topicId":"cnm_h134","difficulty":"basic","type":"numeric","prompt":"一个袋子有 3 个不同的球，摸出 1 个。样本点有多少个？","answer":"3","explanation":"每个球是一个样本点。","verify":"3"},{"id":"cnm_h134_q3","topicId":"cnm_h134","difficulty":"standard","type":"choice","prompt":"样本空间是？","choices":[{"key":"A","text":"只含最可能的那个结果"},{"key":"B","text":"所有样本点组成的集合"},{"key":"C","text":"概率等于 1 的事件"},{"key":"D","text":"已经发生的结果"}],"answer":"B","explanation":"样本空间在做试验之前就列好，包含每一个可能结果。","verify":"\"所有样本点组成的集合\""},{"id":"cnm_h134_q4","topicId":"cnm_h134","difficulty":"standard","type":"choice","prompt":"用集合表示样本空间，依靠的是？","choices":[{"key":"A","text":"把概率看成元素"},{"key":"B","text":"只能用列举法且不能用描述法"},{"key":"C","text":"把结果看成元素"},{"key":"D","text":"不能有空集"}],"answer":"C","explanation":"高中概率用集合语言，结果就是元素。","verify":"\"把结果看成元素\""},{"id":"cnm_h135_q1","topicId":"cnm_h135","difficulty":"basic","type":"choice","prompt":"必然事件的概率是？","choices":[{"key":"A","text":"1"},{"key":"B","text":"0"},{"key":"C","text":"1/2"},{"key":"D","text":"可以大于 1"}],"answer":"A","explanation":"每次都发生，概率是 1。","verify":"\"1\""},{"id":"cnm_h135_q2","topicId":"cnm_h135","difficulty":"basic","type":"choice","prompt":"不可能事件对应的集合是？","choices":[{"key":"A","text":"样本空间"},{"key":"B","text":"空集"},{"key":"C","text":"只含一个样本点的集合"},{"key":"D","text":"全体实数"}],"answer":"B","explanation":"没有样本点能使它发生。","verify":"\"空集\""},{"id":"cnm_h135_q3","topicId":"cnm_h135","difficulty":"standard","type":"numeric","prompt":"样本空间有 5 个样本点，某事件含其中 5 个。这个事件的概率若按古典概型计算是多少？","answer":"1","explanation":"全部样本点都在事件里，概率是 1，这是必然事件。","verify":"Fraction(5,5)"},{"id":"cnm_h135_q4","topicId":"cnm_h135","difficulty":"standard","type":"choice","prompt":"随机事件是指？","choices":[{"key":"A","text":"一定发生的事件"},{"key":"B","text":"一定不发生的事件"},{"key":"C","text":"样本空间外面的对象"},{"key":"D","text":"可能发生也可能不发生的事件"}],"answer":"D","explanation":"概率严格在 0 和 1 之间的是随机事件。必然和不可能是两种极端。","verify":"\"可能发生也可能不发生的事件\""},{"id":"cnm_h136_q1","topicId":"cnm_h136","difficulty":"basic","type":"numeric","prompt":"样本空间有 8 个样本点，事件 A 有 3 个。A 的对立事件有几个样本点？","answer":"5","explanation":"对立事件是补集，8−3=5。","verify":"8-3"},{"id":"cnm_h136_q2","topicId":"cnm_h136","difficulty":"basic","type":"numeric","prompt":"A 有 4 个样本点，B 有 5 个，A∩B 有 2 个。A∪B 有几个样本点？","answer":"7","explanation":"并集个数是 4+5−2=7。","verify":"4+5-2"},{"id":"cnm_h136_q3","topicId":"cnm_h136","difficulty":"standard","type":"choice","prompt":"A∩B 表示？","choices":[{"key":"A","text":"A 或 B 至少一个发生"},{"key":"B","text":"A 不发生"},{"key":"C","text":"样本空间"},{"key":"D","text":"A 和 B 同时发生"}],"answer":"D","explanation":"交是公共部分，两个事件都发生。","verify":"\"A 和 B 同时发生\""},{"id":"cnm_h136_q4","topicId":"cnm_h136","difficulty":"standard","type":"choice","prompt":"对立事件除了互斥，还要满足？","choices":[{"key":"A","text":"并起来是整个样本空间"},{"key":"B","text":"交集不是空集"},{"key":"C","text":"概率都是 1/2"},{"key":"D","text":"只能各含一个样本点"}],"answer":"A","explanation":"互斥只是不能同时发生。对立还要求两者必有一个发生。","verify":"\"并起来是整个样本空间\""},{"id":"cnm_h137_q1","topicId":"cnm_h137","difficulty":"basic","type":"numeric","prompt":"袋中 5 红 3 蓝，共 8 个球，随机摸 2 个。摸到 2 个红球的概率是多少？","answer":"5/14","explanation":"C(5,2)/C(8,2)=10/28=5/14。","verify":"Fraction(comb(5,2),comb(8,2))"},{"id":"cnm_h137_q2","topicId":"cnm_h137","difficulty":"basic","type":"numeric","prompt":"掷一枚均匀骰子，点数大于 4 的概率是多少？","answer":"1/3","explanation":"5 和 6 两点，共 6 种等可能结果，概率 1/3。","verify":"Fraction(2,6)"},{"id":"cnm_h137_q3","topicId":"cnm_h137","difficulty":"standard","type":"numeric","prompt":"从 1，2，3，4 中等可能取一个数，取到偶数的概率是多少？","answer":"1/2","explanation":"偶数是 2 和 4，概率 1/2。","verify":"Fraction(2,4)"},{"id":"cnm_h137_q4","topicId":"cnm_h137","difficulty":"standard","type":"choice","prompt":"古典概型要求样本点？","choices":[{"key":"A","text":"可以无限个"},{"key":"B","text":"有限个并且每个等可能"},{"key":"C","text":"概率可以不相等"},{"key":"D","text":"必须是连续区间"}],"answer":"B","explanation":"不等可能时不能用「个数除以个数」。","verify":"\"有限个并且每个等可能\""},{"id":"cnm_h138_q1","topicId":"cnm_h138","difficulty":"basic","type":"numeric","prompt":"A、B 互斥，P(A)=1/4，P(B)=1/5。P(A∪B) 是多少？","answer":"9/20","explanation":"互斥时概率相加，1/4+1/5=9/20。","verify":"Fraction(1,4)+Fraction(1,5)"},{"id":"cnm_h138_q2","topicId":"cnm_h138","difficulty":"basic","type":"numeric","prompt":"P(A)=1/2，P(B)=1/3，P(A∩B)=1/6。P(A∪B) 是多少？","answer":"2/3","explanation":"不互斥时要减去同时发生的部分，1/2+1/3−1/6=2/3。","verify":"Fraction(1,2)+Fraction(1,3)-Fraction(1,6)"},{"id":"cnm_h138_q3","topicId":"cnm_h138","difficulty":"standard","type":"numeric","prompt":"对立事件的概率是 1/5。原事件的概率是多少？","answer":"4/5","explanation":"对立事件概率之和为 1，原事件是 4/5。","verify":"1-Fraction(1,5)"},{"id":"cnm_h138_q4","topicId":"cnm_h138","difficulty":"standard","type":"choice","prompt":"互斥事件的概率可以直接相加，因为？","choices":[{"key":"A","text":"它们互相独立"},{"key":"B","text":"它们的概率都是 1"},{"key":"C","text":"它们不能同时发生，交集为空"},{"key":"D","text":"样本点个数无限"}],"answer":"C","explanation":"互斥和独立不是一回事。这里用的是交集为空。","verify":"\"它们不能同时发生，交集为空\""},{"id":"cnm_h139_q1","topicId":"cnm_h139","difficulty":"basic","type":"choice","prompt":"对立一定互斥吗？","choices":[{"key":"A","text":"一定"},{"key":"B","text":"一定不"},{"key":"C","text":"只有概率为 1/2 时才"},{"key":"D","text":"无法判断"}],"answer":"A","explanation":"对立事件不能同时发生，所以互斥，并且还要盖住整个样本空间。","verify":"\"一定\""},{"id":"cnm_h139_q2","topicId":"cnm_h139","difficulty":"basic","type":"choice","prompt":"互斥是否一定对立？","choices":[{"key":"A","text":"一定"},{"key":"B","text":"不一定"},{"key":"C","text":"在古典概型里一定"},{"key":"D","text":"只有两个样本点时才不一定"}],"answer":"B","explanation":"两个事件可以都不发生。例如掷骰子「1 点」和「2 点」互斥，但不是对立。","verify":"\"不一定\""},{"id":"cnm_h139_q3","topicId":"cnm_h139","difficulty":"standard","type":"numeric","prompt":"P(A)=0.3。若 B 是 A 的对立事件，P(B) 用分数表示是多少？0.3=3/10。","answer":"7/10","explanation":"1−3/10=7/10。","verify":"1-Fraction(3,10)"},{"id":"cnm_h139_q4","topicId":"cnm_h139","difficulty":"standard","type":"numeric","prompt":"样本空间 6 个等可能结果。事件「点数为 1」和「点数为 2」一起含几个结果？","answer":"2","explanation":"两个互斥事件的结果数相加，1+1=2。它们的并不是必然事件。","verify":"2"}]
