[{"id":"cnh_j001_q1","topicId":"cnh_j001","difficulty":"basic","type":"choice","prompt":"我国境内目前已知最早的古人类是？","choices":[{"key":"A","text":"北京人"},{"key":"B","text":"山顶洞人"},{"key":"C","text":"元谋人"},{"key":"D","text":"半坡居民"}],"answer":"C","explanation":"元谋人距今约170万年，发现于云南元谋。","verify":"\"元谋人\""},{"id":"cnh_j001_q2","topicId":"cnh_j001","difficulty":"basic","type":"choice","prompt":"北京人遗址位于今天的哪里？","choices":[{"key":"A","text":"云南元谋"},{"key":"B","text":"陕西西安"},{"key":"C","text":"浙江余姚"},{"key":"D","text":"北京周口店"}],"answer":"D","explanation":"北京人遗址在北京西南周口店。","verify":"\"北京周口店\""},{"id":"cnh_j001_q3","topicId":"cnh_j001","difficulty":"standard","type":"choice","prompt":"北京人已经能够做到的是？","choices":[{"key":"A","text":"打制石器并使用火"},{"key":"B","text":"种植水稻"},{"key":"C","text":"建造干栏式房屋"},{"key":"D","text":"冶炼青铜"}],"answer":"A","explanation":"北京人使用打制石器，会使用天然火并保存火种。","verify":"\"打制石器并使用火\""},{"id":"cnh_j001_q4","topicId":"cnh_j001","difficulty":"challenge","type":"choice","prompt":"山顶洞人比北京人更进步的一项表现是？","choices":[{"key":"A","text":"还不会制造任何工具"},{"key":"B","text":"掌握磨光和钻孔技术"},{"key":"C","text":"已经实行郡县制"},{"key":"D","text":"已经使用曲辕犁"}],"answer":"B","explanation":"山顶洞人掌握磨光、钻孔技术，并会人工取火。","verify":"\"掌握磨光和钻孔技术\""},{"id":"cnh_j002_q1","topicId":"cnh_j002","difficulty":"basic","type":"choice","prompt":"河姆渡人生活的大致地点是？","choices":[{"key":"A","text":"陕西西安"},{"key":"B","text":"北京周口店"},{"key":"C","text":"云南元谋"},{"key":"D","text":"浙江余姚"}],"answer":"D","explanation":"河姆渡遗址在今天的浙江余姚。","verify":"\"浙江余姚\""},{"id":"cnh_j002_q2","topicId":"cnh_j002","difficulty":"basic","type":"choice","prompt":"半坡居民主要种植的农作物是？","choices":[{"key":"A","text":"粟"},{"key":"B","text":"水稻"},{"key":"C","text":"小麦"},{"key":"D","text":"玉米"}],"answer":"A","explanation":"半坡居民种粟，河姆渡人种水稻。","verify":"\"粟\""},{"id":"cnh_j002_q3","topicId":"cnh_j002","difficulty":"standard","type":"choice","prompt":"河姆渡人居住的房屋样式是？","choices":[{"key":"A","text":"半地穴式圆形房屋"},{"key":"B","text":"干栏式建筑"},{"key":"C","text":"砖木楼阁"},{"key":"D","text":"窑洞"}],"answer":"B","explanation":"河姆渡人住干栏式房屋，使用骨耜。","verify":"\"干栏式建筑\""},{"id":"cnh_j002_q4","topicId":"cnh_j002","difficulty":"challenge","type":"choice","prompt":"原始农业出现后，人们生活的重要变化是？","choices":[{"key":"A","text":"仍然只会采集和渔猎"},{"key":"B","text":"马上建立起皇帝制度"},{"key":"C","text":"开始定居并形成村落"},{"key":"D","text":"开始使用铁制农具"}],"answer":"C","explanation":"原始农业使人们可以比较稳定地定居下来。","verify":"\"开始定居并形成村落\""},{"id":"cnh_j003_q1","topicId":"cnh_j003","difficulty":"basic","type":"choice","prompt":"教材用来说明中华文明起源的重要考古文化是？","choices":[{"key":"A","text":"良渚文化"},{"key":"B","text":"仰韶文化里的半坡彩陶只代表农耕"},{"key":"C","text":"元谋人化石"},{"key":"D","text":"北京人用火遗迹"}],"answer":"A","explanation":"良渚古城、水利系统和玉器是早期文明的重要证据。","verify":"\"良渚文化\""},{"id":"cnh_j003_q2","topicId":"cnh_j003","difficulty":"basic","type":"choice","prompt":"良渚遗址的主要发现地在今天的？","choices":[{"key":"A","text":"云南"},{"key":"B","text":"浙江"},{"key":"C","text":"陕西"},{"key":"D","text":"河南安阳"}],"answer":"B","explanation":"良渚遗址位于长江下游的浙江。","verify":"\"浙江\""},{"id":"cnh_j003_q3","topicId":"cnh_j003","difficulty":"standard","type":"choice","prompt":"私有制、阶级和早期国家出现的重要标志之一是？","choices":[{"key":"A","text":"人人平均分配所有猎物"},{"key":"B","text":"还没有人会种地"},{"key":"C","text":"出现城址、大型工程和礼器"},{"key":"D","text":"青铜器完全消失"}],"answer":"C","explanation":"城址、水利和玉礼器说明社会分化和公共权力已经出现。","verify":"\"出现城址、大型工程和礼器\""},{"id":"cnh_j003_q4","topicId":"cnh_j003","difficulty":"challenge","type":"choice","prompt":"考古发现对认识中华文明起源的作用是？","choices":[{"key":"A","text":"只能用来讲神话故事"},{"key":"B","text":"可以代替全部文献且不必核对"},{"key":"C","text":"只能证明近代历史"},{"key":"D","text":"用遗址和遗物印证早期文明"}],"answer":"D","explanation":"考古材料是了解文字记载以前历史的重要依据。","verify":"\"用遗址和遗物印证早期文明\""}]
