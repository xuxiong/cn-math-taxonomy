[{"difficulty":"basic","type":"choice","prompt":"平均数表示的是什么？","choices":[{"key":"A","text":"一组数的平均水平"},{"key":"B","text":"这一组里最大的数"},{"key":"C","text":"这一组数的个数"}],"answer":"A","explanation":"平均数把几个数匀一匀，表示这组数的平均水平。","verify":"'一组数的平均水平'","id":"cnm_p129_q1","topicId":"cnm_p129"},{"difficulty":"basic","type":"numeric","prompt":"一组数 4、6、8 的平均数是多少？","answer":"6","explanation":"先求和再平均：（4＋6＋8）÷3＝6。","verify":"Fraction(4+6+8,3)","id":"cnm_p129_q2","topicId":"cnm_p129"},{"difficulty":"standard","type":"numeric","prompt":"三次成绩是 80、90、100。平均数是多少？","answer":"90","explanation":"（80＋90＋100）÷3＝90。","verify":"Fraction(80+90+100,3)","id":"cnm_p129_q3","topicId":"cnm_p129"},{"difficulty":"challenge","type":"numeric","prompt":"四个数的平均数是 8，其中三个是 6、9、7。第四个数是多少？","answer":"10","explanation":"四个数的总和是 8×4＝32，第四个数是 32－6－9－7＝10。","verify":"8*4-6-9-7","id":"cnm_p129_q4","topicId":"cnm_p129"}]
