[{"id":"cnm_h176_q1","topicId":"cnm_h176","difficulty":"basic","type":"numeric","prompt":"圆 (x−2)²+(y+1)²=25 的半径是多少？","answer":"5","explanation":"右边是半径的平方 25，半径是 5。","verify":"isqrt(25)"},{"id":"cnm_h176_q2","topicId":"cnm_h176","difficulty":"basic","type":"numeric","prompt":"圆 (x−2)²+(y+1)²=25 的圆心横坐标是多少？","answer":"2","explanation":"标准式 (x−a)² 中 a 是圆心横坐标，这里是 2。","verify":"2"},{"id":"cnm_h176_q3","topicId":"cnm_h176","difficulty":"standard","type":"numeric","prompt":"圆心 (0，0)、半径 6 的圆，方程右边的数是多少？","answer":"36","explanation":"方程是 x²+y²=36，右边是半径的平方 36。","verify":"6*6"},{"id":"cnm_h176_q4","topicId":"cnm_h176","difficulty":"standard","type":"choice","prompt":"点 (5，0) 在圆 x²+y²=25 上吗？","choices":[{"key":"A","text":"在圆上"},{"key":"B","text":"在圆内"},{"key":"C","text":"在圆外"},{"key":"D","text":"是圆心"}],"answer":"A","explanation":"5²+0²=25，满足方程，点在圆上。","verify":"\"在圆上\""},{"id":"cnm_h177_q1","topicId":"cnm_h177","difficulty":"basic","type":"numeric","prompt":"圆 x²+y²−4x+2y−4=0 的半径是多少？","answer":"3","explanation":"配方得 (x−2)²+(y+1)²=9，半径是 3。","verify":"isqrt((4//2)**2+(2//2)**2-(-4))"},{"id":"cnm_h177_q2","topicId":"cnm_h177","difficulty":"basic","type":"numeric","prompt":"圆 x²+y²−4x+2y−4=0 的圆心横坐标是多少？","answer":"2","explanation":"D=−4，圆心横坐标是 −D/2=2。","verify":"4//2"},{"id":"cnm_h177_q3","topicId":"cnm_h177","difficulty":"standard","type":"numeric","prompt":"方程 x²+y²+2x+2y+2=0 中，D²+E²−4F 等于多少？","answer":"0","explanation":"D=2，E=2，F=2，得 4+4−8=0，它表示一个点，不是普通的圆。","verify":"4+4-4*2"},{"id":"cnm_h177_q4","topicId":"cnm_h177","difficulty":"standard","type":"choice","prompt":"x²+y²+Dx+Ey+F=0 表示半径为正的圆，需要什么条件？","choices":[{"key":"A","text":"D²+E²−4F<0"},{"key":"B","text":"D²+E²−4F>0"},{"key":"C","text":"F 必须等于 0"},{"key":"D","text":"D 和 E 必须为 0"}],"answer":"B","explanation":"配方后右边必须为正，半径才是正数。等于 0 时是一个点，小于 0 时没有轨迹。","verify":"\"D²+E²−4F>0\""},{"id":"cnm_h178_q1","topicId":"cnm_h178","difficulty":"basic","type":"numeric","prompt":"圆心在原点，圆经过 (3，4)。半径是多少？","answer":"5","explanation":"原点到 (3，4) 的距离是 5，半径就是 5。","verify":"isqrt(9+16)"},{"id":"cnm_h178_q2","topicId":"cnm_h178","difficulty":"basic","type":"numeric","prompt":"圆 (x−1)²+(y−2)²=r² 经过 (1，5)。r² 等于多少？","answer":"9","explanation":"把点代入，r²=0+9=9。","verify":"(1-1)**2+(5-2)**2"},{"id":"cnm_h178_q3","topicId":"cnm_h178","difficulty":"standard","type":"numeric","prompt":"圆心 (2，0)，半径 5。圆与 x 轴正半轴交点的横坐标是多少？","answer":"7","explanation":"圆心在 x 轴上，右侧交点横坐标是 2+5=7。","verify":"2+5"},{"id":"cnm_h178_q4","topicId":"cnm_h178","difficulty":"standard","type":"choice","prompt":"确定一个圆，下面哪一组条件是够用的？","choices":[{"key":"A","text":"只知道圆心"},{"key":"B","text":"只知道半径"},{"key":"C","text":"圆心和半径"},{"key":"D","text":"只知道圆上一个点"}],"answer":"C","explanation":"圆心定位置，半径定大小，两者一起才能确定圆。","verify":"\"圆心和半径\""}]
