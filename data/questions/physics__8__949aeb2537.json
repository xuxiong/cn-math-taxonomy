[{"id":"cnp_052_q1","topicId":"cnp_052","difficulty":"basic","type":"choice","prompt":"使用任何机械时，机械效率总是怎样？","choices":[{"key":"A","text":"大于 1"},{"key":"B","text":"等于 1"},{"key":"C","text":"可能大于 1"},{"key":"D","text":"小于 1（100%）"}],"answer":"D","explanation":"使用机械总要做额外功，有用功总小于总功，所以机械效率小于 100%。","verify":"\"小于 1（100%）\""},{"id":"cnp_052_q2","topicId":"cnp_052","difficulty":"basic","type":"choice","prompt":"用滑轮组提升重物，有用功是 600 J，总功是 800 J，机械效率是多少？","choices":[{"key":"A","text":"133%"},{"key":"B","text":"25%"},{"key":"C","text":"75%"},{"key":"D","text":"80%"}],"answer":"C","explanation":"η = W有/W总 = 600 ÷ 800 = 75%。","verify":"'75%'"},{"id":"cnp_052_q3","topicId":"cnp_052","difficulty":"standard","type":"numeric","prompt":"用斜面把重 500 N 的箱子推上 1 m 高的平台，沿斜面推力 250 N，斜面长 4 m。斜面的机械效率是百分之多少？（只填数值）","answer":"50","explanation":"W有 = Gh = 500 J，W总 = Fs = 1000 J，η = 500 ÷ 1000 = 50%。","verify":"500*1/(250*4)*100","percent":true},{"id":"cnp_052_q4","topicId":"cnp_052","difficulty":"standard","type":"choice","prompt":"用同一个滑轮组提升不同的重物，下列做法能提高机械效率的是哪一个？","choices":[{"key":"A","text":"增加物体被提升的高度"},{"key":"B","text":"加快提升速度"},{"key":"C","text":"增加被提升物体的重力"},{"key":"D","text":"增加动滑轮的重力"}],"answer":"C","explanation":"额外功基本不变时，物体越重，有用功占比越大，效率越高；提升高度和速度不影响效率。","verify":"\"增加被提升物体的重力\""}]
