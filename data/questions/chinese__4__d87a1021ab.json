[{"id":"cnc_p300_q1","topicId":"cnc_p300","difficulty":"basic","type":"choice","prompt":"《猫》的作者是谁？","choices":[{"key":"A","text":"丰子恺"},{"key":"B","text":"老舍"},{"key":"C","text":"艾青"},{"key":"D","text":"鲁迅"}],"answer":"B","explanation":"这篇是老舍写的。丰子恺写的是《白鹅》。","verify":"\"老舍\""},{"id":"cnc_p300_q2","topicId":"cnc_p300","difficulty":"basic","type":"choice","prompt":"说猫「古怪」，是因为什么？","choices":[{"key":"A","text":"它天天同一种表情"},{"key":"B","text":"它不会抓老鼠"},{"key":"C","text":"它老实，可又贪玩；高兴时温柔，不高兴时一声也不出"},{"key":"D","text":"它比鹅还要高傲"}],"answer":"C","explanation":"课文用几对看起来相反的表现，写出猫的古怪。","verify":"\"它老实，可又贪玩；高兴时温柔，不高兴时一声也不出\""},{"id":"cnc_p300_q3","topicId":"cnc_p300","difficulty":"standard","type":"choice","prompt":"满月的小猫喜欢玩什么？","choices":[{"key":"A","text":"只玩一条鱼，别的都不碰"},{"key":"B","text":"和白鹅一起吃饭"},{"key":"C","text":"趴着一动不动"},{"key":"D","text":"鸡毛、线团，什么都玩"}],"answer":"D","explanation":"小猫腿脚还站不稳，却已经把院子里的东西都当成玩具。","verify":"\"鸡毛、线团，什么都玩\""},{"id":"cnc_p300_q4","topicId":"cnc_p300","difficulty":"standard","type":"choice","prompt":"作者写猫的淘气，表达的是什么？","choices":[{"key":"A","text":"对猫的喜爱"},{"key":"B","text":"要把猫送走"},{"key":"C","text":"猫给家里添了麻烦所以讨厌它"},{"key":"D","text":"猫应该改掉所有习惯"}],"answer":"A","explanation":"越写它淘气，越能看出作者喜欢它。讨厌不会写得这样细。","verify":"\"对猫的喜爱\""},{"id":"cnc_p301_q1","topicId":"cnc_p301","difficulty":"basic","type":"choice","prompt":"《母鸡》的作者是谁？","choices":[{"key":"A","text":"丰子恺"},{"key":"B","text":"艾青"},{"key":"C","text":"老舍"},{"key":"D","text":"叶圣陶"}],"answer":"C","explanation":"《猫》也是老舍写的。《白鹅》才是丰子恺的，不要把两篇的作者记混。","verify":"\"老舍\""},{"id":"cnc_p301_q2","topicId":"cnc_p301","difficulty":"basic","type":"choice","prompt":"课文开头，作者对母鸡是什么态度？","choices":[{"key":"A","text":"从第一句起就非常尊敬"},{"key":"B","text":"完全没注意过它"},{"key":"C","text":"把它当成一只高傲的白鹅"},{"key":"D","text":"讨厌"}],"answer":"D","explanation":"他先写母鸡的叫声和欺软怕硬，说自己一向讨厌母鸡。","verify":"\"讨厌\""},{"id":"cnc_p301_q3","topicId":"cnc_p301","difficulty":"standard","type":"choice","prompt":"后来他为什么不敢再讨厌母鸡了？","choices":[{"key":"A","text":"它成了鸡母亲，负责、慈爱、勇敢，又很辛苦"},{"key":"B","text":"它学会了像猫一样闭着眼睡觉"},{"key":"C","text":"它再也不叫了，所以不可怕"},{"key":"D","text":"它把小鸡全都赶走了"}],"answer":"A","explanation":"警戒、觅食、保护小鸡，这些地方让他改了看法。结尾是不敢再讨厌。","verify":"\"它成了鸡母亲，负责、慈爱、勇敢，又很辛苦\""},{"id":"cnc_p301_q4","topicId":"cnc_p301","difficulty":"standard","type":"choice","prompt":"哪一项是他原先讨厌母鸡的原因，不是后来的表现？","choices":[{"key":"A","text":"警戒着，不让别的动物靠近小鸡"},{"key":"B","text":"叫声没完没了，还会欺软怕硬"},{"key":"C","text":"教小鸡觅食、躲避危险"},{"key":"D","text":"自己吃苦，也要保护孩子"}],"answer":"B","explanation":"欺软怕硬写在前面，是讨厌的理由。护着小鸡，是后来让他尊敬的地方。","verify":"\"叫声没完没了，还会欺软怕硬\""},{"id":"cnc_p302_q1","topicId":"cnc_p302","difficulty":"basic","type":"choice","prompt":"《白鹅》的作者是谁？","choices":[{"key":"A","text":"老舍"},{"key":"B","text":"叶圣陶"},{"key":"C","text":"郭沫若"},{"key":"D","text":"丰子恺"}],"answer":"D","explanation":"这篇是丰子恺写的。老舍写的是《猫》。","verify":"\"丰子恺\""},{"id":"cnc_p302_q2","topicId":"cnc_p302","difficulty":"basic","type":"choice","prompt":"白鹅最突出的特点是什么？","choices":[{"key":"A","text":"高傲"},{"key":"B","text":"胆小"},{"key":"C","text":"沉默，从不叫"},{"key":"D","text":"走路像猫一样轻"}],"answer":"A","explanation":"作者说左看右看，鹅的高傲都从姿态上来。","verify":"\"高傲\""},{"id":"cnc_p302_q3","topicId":"cnc_p302","difficulty":"standard","type":"choice","prompt":"白鹅吃饭有什么特别？","choices":[{"key":"A","text":"自己到厨房把饭端来"},{"key":"B","text":"非有一个人侍候不可，吃法三眼一板"},{"key":"C","text":"只吃一口就走"},{"key":"D","text":"和狗抢同一只碗，从不叫"}],"answer":"B","explanation":"它吃饭时架子很大，还必须有人站在旁边侍候。","verify":"\"非有一个人侍候不可，吃法三眼一板\""},{"id":"cnc_p302_q4","topicId":"cnc_p302","difficulty":"standard","type":"choice","prompt":"作者写它的高傲，其实是怎样的感情？","choices":[{"key":"A","text":"准备把它卖掉"},{"key":"B","text":"害怕它，再也不敢看"},{"key":"C","text":"觉得它可笑，又很喜欢它"},{"key":"D","text":"只是在写一道菜"}],"answer":"C","explanation":"三眼一板、伸长脖子，读起来可笑，字里行间是喜爱。","verify":"\"觉得它可笑，又很喜欢它\""},{"id":"cnc_p303_q1","topicId":"cnc_p303","difficulty":"basic","type":"choice","prompt":"哪一个词含有夸奖的意思？","choices":[{"key":"A","text":"团结"},{"key":"B","text":"勾结"},{"key":"C","text":"阴谋"},{"key":"D","text":"狡猾"}],"answer":"A","explanation":"团结是一起做好事。勾结、阴谋、狡猾都带有批评的意思。","verify":"\"团结\""},{"id":"cnc_p303_q2","topicId":"cnc_p303","difficulty":"basic","type":"choice","prompt":"哪一个词含有批评的意思？","choices":[{"key":"A","text":"果断"},{"key":"B","text":"武断"},{"key":"C","text":"坚强"},{"key":"D","text":"诚实"}],"answer":"B","explanation":"武断是不听别人、主观地做决定。果断是优点。","verify":"\"武断\""},{"id":"cnc_p303_q3","topicId":"cnc_p303","difficulty":"standard","type":"choice","prompt":"「他做事很____，同事都信任他。」该填哪一个？","choices":[{"key":"A","text":"武断"},{"key":"B","text":"狡猾"},{"key":"C","text":"果断"},{"key":"D","text":"勾结"}],"answer":"C","explanation":"得到信任，要填含夸奖意味的果断。","verify":"\"果断\""},{"id":"cnc_p303_q4","topicId":"cnc_p303","difficulty":"standard","type":"choice","prompt":"哪一句的词语和感情配得上？","choices":[{"key":"A","text":"同学们勾结起来打扫校园。"},{"key":"B","text":"他坚强地骗过了所有人。"},{"key":"C","text":"他诚实地把错误藏了起来。"},{"key":"D","text":"同学们团结起来打扫校园。"}],"answer":"D","explanation":"打扫校园是好事，用团结。勾结不能用在这里。","verify":"\"同学们团结起来打扫校园。\""}]
