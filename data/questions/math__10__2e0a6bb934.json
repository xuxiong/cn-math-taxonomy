[{"id":"cnm_h032_q1","topicId":"cnm_h032","difficulty":"basic","type":"choice","prompt":"f(x)=2x+1 在实数集上是？","choices":[{"key":"A","text":"减函数"},{"key":"B","text":"增函数"},{"key":"C","text":"先增后减"},{"key":"D","text":"不具有单调性"}],"answer":"B","explanation":"斜率 2 为正，x 增大时 y 增大。","verify":"\"增函数\""},{"id":"cnm_h032_q2","topicId":"cnm_h032","difficulty":"basic","type":"choice","prompt":"f(x)=−3x+1 在实数集上是？","choices":[{"key":"A","text":"增函数"},{"key":"B","text":"先减后增"},{"key":"C","text":"减函数"},{"key":"D","text":"常函数"}],"answer":"C","explanation":"斜率是负数，x 增大时 y 减小。","verify":"\"减函数\""},{"id":"cnm_h032_q3","topicId":"cnm_h032","difficulty":"standard","type":"numeric","prompt":"f(x)=2x+1。f(4)−f(1) 是多少？","answer":"6","explanation":"9−3=6，差为正，与递增一致。","verify":"(2*4+1)-(2*1+1)"},{"id":"cnm_h032_q4","topicId":"cnm_h032","difficulty":"standard","type":"choice","prompt":"y=x² 在 [0，+∞) 上是？","choices":[{"key":"A","text":"增函数"},{"key":"B","text":"减函数"},{"key":"C","text":"先增后减"},{"key":"D","text":"没有单调性"}],"answer":"A","explanation":"顶点在原点，右侧 x 越大，平方越大。","verify":"\"增函数\""},{"id":"cnm_h033_q1","topicId":"cnm_h033","difficulty":"basic","type":"numeric","prompt":"f(x)=3x−1。取 x1=1，x2=4，计算 f(x2)−f(x1)。","answer":"9","explanation":"11−2=9，差为正，这两点符合递增。","verify":"(3*4-1)-(3*1-1)"},{"id":"cnm_h033_q2","topicId":"cnm_h033","difficulty":"basic","type":"numeric","prompt":"f(x)=−x。x2−x1=2 时，f(x2)−f(x1) 等于多少？","answer":"-2","explanation":"f(x2)−f(x1)=−(x2−x1)=−2，差为负，说明递减。","verify":"-2"},{"id":"cnm_h033_q3","topicId":"cnm_h033","difficulty":"standard","type":"numeric","prompt":"证明 f(x)=x+1 递增时，f(x2)−f(x1) 等于 x2−x1。若 x2−x1=5，这个差是多少？","answer":"5","explanation":"差就是 x2−x1，为正，所以递增。","verify":"5"},{"id":"cnm_h033_q4","topicId":"cnm_h033","difficulty":"standard","type":"choice","prompt":"用定义说明 f 在区间上递增，需要对 x1<x2 证明？","choices":[{"key":"A","text":"f(x1)>f(x2)"},{"key":"B","text":"f(x1)<f(x2)"},{"key":"C","text":"f(x1)=f(x2)"},{"key":"D","text":"只对整数成立即可"}],"answer":"B","explanation":"区间上任意的 x1<x2 都要有 f(x1)<f(x2)，不能只看几个点。","verify":"\"f(x1)<f(x2)\""},{"id":"cnm_h034_q1","topicId":"cnm_h034","difficulty":"basic","type":"numeric","prompt":"f(x)=x²，x∈[−1，2]。最大值是多少？","answer":"4","explanation":"端点 −1 和 2 的函数值是 1 和 4，顶点 0 的值是 0。最大是 4。","verify":"2**2"},{"id":"cnm_h034_q2","topicId":"cnm_h034","difficulty":"basic","type":"numeric","prompt":"f(x)=x²，x∈[−1，2]。最小值是多少？","answer":"0","explanation":"顶点 x=0 在区间 [−1，2] 内，f(0)=0；端点值是 1 和 4。最小值是 0。","verify":"min([(-1)**2, 0**2, 2**2])"},{"id":"cnm_h034_q3","topicId":"cnm_h034","difficulty":"standard","type":"numeric","prompt":"f(x)=−(x−1)²+5 的最大值是多少？","answer":"5","explanation":"平方项前是负号，最大值为 5，在 x=1 处取到。","verify":"5"},{"id":"cnm_h034_q4","topicId":"cnm_h034","difficulty":"standard","type":"choice","prompt":"闭区间上的连续函数最值可能在哪里取到？","choices":[{"key":"A","text":"只在端点"},{"key":"B","text":"只在区间中点"},{"key":"C","text":"端点或区间内的顶点、极值点"},{"key":"D","text":"一定在区间外"}],"answer":"C","explanation":"二次函数要比较顶点是否落在区间内，再和端点比较。","verify":"\"端点或区间内的顶点、极值点\""},{"id":"cnm_h035_q1","topicId":"cnm_h035","difficulty":"basic","type":"choice","prompt":"f(x)=x² 是？","choices":[{"key":"A","text":"偶函数"},{"key":"B","text":"奇函数"},{"key":"C","text":"既奇又偶"},{"key":"D","text":"非奇非偶"}],"answer":"A","explanation":"f(−x)=(−x)²=x²=f(x)，定义域关于原点对称，是偶函数。","verify":"\"偶函数\""},{"id":"cnm_h035_q2","topicId":"cnm_h035","difficulty":"basic","type":"choice","prompt":"f(x)=x³ 是？","choices":[{"key":"A","text":"偶函数"},{"key":"B","text":"奇函数"},{"key":"C","text":"既奇又偶"},{"key":"D","text":"非奇非偶"}],"answer":"B","explanation":"f(−x)=−x³=−f(x)，是奇函数。","verify":"\"奇函数\""},{"id":"cnm_h035_q3","topicId":"cnm_h035","difficulty":"standard","type":"numeric","prompt":"f(x)=x²。计算 f(2)+f(−2)。","answer":"8","explanation":"偶函数在相反自变量处的值相同，4+4=8。","verify":"2**2+(-2)**2"},{"id":"cnm_h035_q4","topicId":"cnm_h035","difficulty":"standard","type":"numeric","prompt":"f(x)=x³。计算 f(2)+f(−2)。","answer":"0","explanation":"8+(−8)=0，这是奇函数的特点。","verify":"2**3+(-2)**3"},{"id":"cnm_h036_q1","topicId":"cnm_h036","difficulty":"basic","type":"numeric","prompt":"偶函数 f(2)=7。f(−2) 是多少？","answer":"7","explanation":"偶函数关于 y 轴对称，相反自变量的函数值相等。","verify":"7"},{"id":"cnm_h036_q2","topicId":"cnm_h036","difficulty":"basic","type":"numeric","prompt":"奇函数 f(2)=7。f(−2) 是多少？","answer":"-7","explanation":"奇函数关于原点对称，f(−2)=−f(2)=−7。","verify":"-7"},{"id":"cnm_h036_q3","topicId":"cnm_h036","difficulty":"standard","type":"numeric","prompt":"既是奇函数又是偶函数，且 f(3)=0 已经给出。f(0) 应是多少？","answer":"0","explanation":"奇函数若在 0 处有定义，f(0)=0。既奇又偶的函数只能恒为 0。","verify":"0"},{"id":"cnm_h036_q4","topicId":"cnm_h036","difficulty":"standard","type":"choice","prompt":"f(x)=x²+x 的奇偶性是？","choices":[{"key":"A","text":"非奇非偶"},{"key":"B","text":"奇函数"},{"key":"C","text":"偶函数"},{"key":"D","text":"既奇又偶"}],"answer":"A","explanation":"f(−x)=x²−x，既不等于 f(x)，也不等于 −f(x)。","verify":"\"非奇非偶\""}]
