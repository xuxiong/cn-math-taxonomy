[{"id":"cnp_079_q1","topicId":"cnp_079","difficulty":"basic","type":"choice","prompt":"用试电笔辨别火线和零线时，氖管发光的是哪一根？","choices":[{"key":"A","text":"火线"},{"key":"B","text":"零线"},{"key":"C","text":"地线"},{"key":"D","text":"都会发光"}],"answer":"A","explanation":"接触火线时氖管发光；使用时手要接触笔尾金属体。","verify":"\"火线\""},{"id":"cnp_079_q2","topicId":"cnp_079","difficulty":"basic","type":"choice","prompt":"家庭电路中电流过大的原因是什么？","choices":[{"key":"A","text":"电压过低"},{"key":"B","text":"用电器太少"},{"key":"C","text":"导线太粗"},{"key":"D","text":"短路或用电器总功率过大"}],"answer":"D","explanation":"短路或总功率过大都会使干路电流过大。","verify":"\"短路或用电器总功率过大\""},{"id":"cnp_079_q3","topicId":"cnp_079","difficulty":"standard","type":"choice","prompt":"洗衣机、电冰箱等用电器要使用三线插头，目的是什么？","choices":[{"key":"A","text":"使用电器更省电"},{"key":"B","text":"使插头插得更牢"},{"key":"C","text":"使金属外壳接地，防止外壳带电时触电"},{"key":"D","text":"增大电流"}],"answer":"C","explanation":"三线插头的第三根线把金属外壳与大地相连。","verify":"\"使金属外壳接地，防止外壳带电时触电\""},{"id":"cnp_079_q4","topicId":"cnp_079","difficulty":"standard","type":"choice","prompt":"控制电灯的开关应接在哪根线上？","choices":[{"key":"A","text":"零线"},{"key":"B","text":"地线"},{"key":"C","text":"哪根都可以"},{"key":"D","text":"火线"}],"answer":"D","explanation":"开关接在火线上，断开时灯与火线断开，更换灯泡更安全。","verify":"\"火线\""}]
