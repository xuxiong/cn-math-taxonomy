[{"id":"cne_j072_q1","topicId":"cne_j072","difficulty":"basic","type":"choice","prompt":"多么冷的一天。哪一句正确？","choices":[{"key":"A","text":"What cold day it is!"},{"key":"B","text":"What a cold day it is!"},{"key":"C","text":"How a cold day it is!"},{"key":"D","text":"What a cold day is it?"}],"answer":"B","explanation":"可数单数名词前用 What a，主语 it 在 is 前面。","verify":"\"What a cold day it is!\""},{"id":"cne_j072_q2","topicId":"cne_j072","difficulty":"basic","type":"choice","prompt":"天气真好。哪一句正确？","choices":[{"key":"A","text":"What nice the weather is!"},{"key":"B","text":"How a nice the weather is!"},{"key":"C","text":"How nice the weather is!"},{"key":"D","text":"How nice is the weather!"}],"answer":"C","explanation":"How 后面接形容词，语序仍是陈述语序。","verify":"\"How nice the weather is!\""},{"id":"cne_j072_q3","topicId":"cne_j072","difficulty":"standard","type":"choice","prompt":"What a sunny day! 这句在感叹什么？","choices":[{"key":"A","text":"请在晴天出门"},{"key":"B","text":"今天是星期几"},{"key":"C","text":"太阳在哪里"},{"key":"D","text":"多么晴朗的一天"}],"answer":"D","explanation":"What a sunny day 是感叹晴天。","verify":"\"多么晴朗的一天\""},{"id":"cne_j072_q4","topicId":"cne_j072","difficulty":"standard","type":"choice","prompt":"哪一句是感叹句？","choices":[{"key":"A","text":"How windy it is!"},{"key":"B","text":"It is windy."},{"key":"C","text":"Is it windy?"},{"key":"D","text":"It is not windy."}],"answer":"A","explanation":"How 加形容词加陈述语序是感叹句。","verify":"\"How windy it is!\""},{"id":"cne_j129_q1","topicId":"cne_j129","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「酸奶」？","choices":[{"key":"A","text":"honey"},{"key":"B","text":"spoon"},{"key":"C","text":"yogurt"},{"key":"D","text":"blender"}],"answer":"C","explanation":"yogurt 的意思是酸奶。","verify":"\"yogurt\""},{"id":"cne_j129_q2","topicId":"cne_j129","difficulty":"basic","type":"choice","prompt":"「honey」的中文意思是哪一个？","choices":[{"key":"A","text":"酸奶"},{"key":"B","text":"勺子"},{"key":"C","text":"搅拌器"},{"key":"D","text":"蜂蜜"}],"answer":"D","explanation":"honey 的意思是蜂蜜。","verify":"\"蜂蜜\""},{"id":"cne_j129_q3","topicId":"cne_j129","difficulty":"standard","type":"choice","prompt":"选择表示「勺子」的单词。","choices":[{"key":"A","text":"spoon"},{"key":"B","text":"yogurt"},{"key":"C","text":"honey"},{"key":"D","text":"blender"}],"answer":"A","explanation":"表示勺子的单词是 spoon。","verify":"\"spoon\""},{"id":"cne_j129_q4","topicId":"cne_j129","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「搅拌器」？","choices":[{"key":"A","text":"yogurt"},{"key":"B","text":"blender"},{"key":"C","text":"honey"},{"key":"D","text":"spoon"}],"answer":"B","explanation":"blender 的意思是搅拌器。","verify":"\"blender\""},{"id":"cne_j130_q1","topicId":"cne_j130","difficulty":"basic","type":"choice","prompt":"先把香蕉剥开。哪一句正确？","choices":[{"key":"A","text":"First, peeling the bananas."},{"key":"B","text":"First, to peel the bananas."},{"key":"C","text":"First, peeled the bananas."},{"key":"D","text":"First, peel the bananas."}],"answer":"D","explanation":"说明步骤用祈使句，动词用原形。","verify":"\"First, peel the bananas.\""},{"id":"cne_j130_q2","topicId":"cne_j130","difficulty":"basic","type":"choice","prompt":"然后加入蜂蜜。哪一句正确？","choices":[{"key":"A","text":"Then add the honey."},{"key":"B","text":"Then adding the honey."},{"key":"C","text":"Then to add the honey."},{"key":"D","text":"Then added the honey yesterday."}],"answer":"A","explanation":"Then 后面接动词原形。","verify":"\"Then add the honey.\""},{"id":"cne_j130_q3","topicId":"cne_j130","difficulty":"standard","type":"choice","prompt":"哪一个词用来连接下一个步骤？","choices":[{"key":"A","text":"Yesterday"},{"key":"B","text":"Next"},{"key":"C","text":"Because"},{"key":"D","text":"Although"}],"answer":"B","explanation":"Next 表示接下来。","verify":"\"Next\""},{"id":"cne_j130_q4","topicId":"cne_j130","difficulty":"standard","type":"choice","prompt":"最后把奶昔倒进杯子。哪一句正确？","choices":[{"key":"A","text":"Finally, pours the milk shake into a glass."},{"key":"B","text":"Finally, pouring the milk shake into a glass."},{"key":"C","text":"Finally, pour the milk shake into a glass."},{"key":"D","text":"Finally, to pour the milk shake into a glass."}],"answer":"C","explanation":"祈使句用 pour，不加 s。","verify":"\"Finally, pour the milk shake into a glass.\""},{"id":"cne_j131_q1","topicId":"cne_j131","difficulty":"basic","type":"choice","prompt":"想问香蕉奶昔怎么做，哪一句合适？","choices":[{"key":"A","text":"How do you make a banana milk shake?"},{"key":"B","text":"How do you makes a banana milk shake?"},{"key":"C","text":"How are you make a banana milk shake?"},{"key":"D","text":"How did you make a banana milk shake tomorrow?"}],"answer":"A","explanation":"How do you make。","verify":"\"How do you make a banana milk shake?\""},{"id":"cne_j131_q2","topicId":"cne_j131","difficulty":"basic","type":"choice","prompt":"需要两勺蜂蜜，应怎么说？","choices":[{"key":"A","text":"We need two spoon of honey."},{"key":"B","text":"We need two spoons of honey."},{"key":"C","text":"We need two spoons of honeys."},{"key":"D","text":"We need two spoon honey."}],"answer":"B","explanation":"two spoons of honey。","verify":"\"We need two spoons of honey.\""},{"id":"cne_j131_q3","topicId":"cne_j131","difficulty":"standard","type":"choice","prompt":"How much yogurt do we need? 这句在问什么？","choices":[{"key":"A","text":"酸奶怎么拼"},{"key":"B","text":"酸奶在哪里卖"},{"key":"C","text":"需要多少酸奶"},{"key":"D","text":"谁喜欢酸奶"}],"answer":"C","explanation":"How much 问不可数名词的量。","verify":"\"需要多少酸奶\""},{"id":"cne_j131_q4","topicId":"cne_j131","difficulty":"standard","type":"choice","prompt":"让对方打开搅拌器，哪一句合适？","choices":[{"key":"A","text":"Turns on the blender."},{"key":"B","text":"Turning on the blender."},{"key":"C","text":"To turn on the blender."},{"key":"D","text":"Turn on the blender."}],"answer":"D","explanation":"祈使句用动词原形。","verify":"\"Turn on the blender.\""},{"id":"cne_j132_q1","topicId":"cne_j132","difficulty":"basic","type":"choice","prompt":"First, peel two bananas. Next, put them into the blender. Then add honey. 第一步做什么？","choices":[{"key":"A","text":"加蜂蜜"},{"key":"B","text":"剥香蕉"},{"key":"C","text":"打开杯子"},{"key":"D","text":"倒奶昔"}],"answer":"B","explanation":"First, peel two bananas。","verify":"\"剥香蕉\""},{"id":"cne_j132_q2","topicId":"cne_j132","difficulty":"basic","type":"choice","prompt":"First, peel two bananas. Next, put them into the blender. 香蕉放进哪里？","choices":[{"key":"A","text":"杯子"},{"key":"B","text":"勺子"},{"key":"C","text":"搅拌器"},{"key":"D","text":"冰箱"}],"answer":"C","explanation":"into the blender。","verify":"\"搅拌器\""},{"id":"cne_j132_q3","topicId":"cne_j132","difficulty":"standard","type":"choice","prompt":"We need one spoon of honey and a cup of yogurt. 蜂蜜要多少？","choices":[{"key":"A","text":"一杯"},{"key":"B","text":"两勺"},{"key":"C","text":"不要蜂蜜"},{"key":"D","text":"一勺"}],"answer":"D","explanation":"one spoon of honey。","verify":"\"一勺\""},{"id":"cne_j132_q4","topicId":"cne_j132","difficulty":"standard","type":"choice","prompt":"Finally, pour the milk shake into a glass. 哪一句和食谱一致？","choices":[{"key":"A","text":"The last step is to pour it into a glass."},{"key":"B","text":"The first step is to pour it into a glass."},{"key":"C","text":"We do not use yogurt."},{"key":"D","text":"We peel the honey."}],"answer":"A","explanation":"Finally 是最后一步。","verify":"\"The last step is to pour it into a glass.\""}]
