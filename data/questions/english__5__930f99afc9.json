[{"id":"cne_p133_q1","topicId":"cne_p133","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「起床」？","choices":[{"key":"A","text":"go to school"},{"key":"B","text":"eat dinner"},{"key":"C","text":"get up"},{"key":"D","text":"go to bed"}],"answer":"C","explanation":"get up 的意思是起床。","verify":"\"get up\""},{"id":"cne_p133_q2","topicId":"cne_p133","difficulty":"basic","type":"choice","prompt":"「go to school」的中文意思是哪一个？","choices":[{"key":"A","text":"起床"},{"key":"B","text":"吃晚饭"},{"key":"C","text":"上床睡觉"},{"key":"D","text":"上学"}],"answer":"D","explanation":"go to school 的意思是上学。","verify":"\"上学\""},{"id":"cne_p133_q3","topicId":"cne_p133","difficulty":"standard","type":"choice","prompt":"选择表示「吃晚饭」的单词。","choices":[{"key":"A","text":"eat dinner"},{"key":"B","text":"get up"},{"key":"C","text":"go to school"},{"key":"D","text":"go to bed"}],"answer":"A","explanation":"表示吃晚饭的单词是 eat dinner。","verify":"\"eat dinner\""},{"id":"cne_p133_q4","topicId":"cne_p133","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「上床睡觉」？","choices":[{"key":"A","text":"get up"},{"key":"B","text":"go to bed"},{"key":"C","text":"go to school"},{"key":"D","text":"eat dinner"}],"answer":"B","explanation":"go to bed 的意思是上床睡觉。","verify":"\"go to bed\""},{"id":"cne_p134_q1","topicId":"cne_p134","difficulty":"basic","type":"choice","prompt":"想问「你什么时候起床」，应选哪一句？","choices":[{"key":"A","text":"When does you get up?"},{"key":"B","text":"When do you gets up?"},{"key":"C","text":"What do you get up?"},{"key":"D","text":"When do you get up?"}],"answer":"D","explanation":"you 前面用 When do you。","verify":"\"When do you get up?\""},{"id":"cne_p134_q2","topicId":"cne_p134","difficulty":"basic","type":"choice","prompt":"I get up at 6 o'clock. 几点起床？","choices":[{"key":"A","text":"6 点"},{"key":"B","text":"5 点"},{"key":"C","text":"7 点"},{"key":"D","text":"8 点"}],"answer":"A","explanation":"at 6 o'clock 是 6 点。","verify":"\"6 点\""},{"id":"cne_p134_q3","topicId":"cne_p134","difficulty":"standard","type":"choice","prompt":"I go to bed at 9 o'clock. 几点睡觉？","choices":[{"key":"A","text":"6 点"},{"key":"B","text":"9 点"},{"key":"C","text":"7 点"},{"key":"D","text":"8 点"}],"answer":"B","explanation":"at 9 o'clock 是 9 点。","verify":"\"9 点\""},{"id":"cne_p134_q4","topicId":"cne_p134","difficulty":"standard","type":"choice","prompt":"When do you eat breakfast? 这句是在问什么？","choices":[{"key":"A","text":"你喜欢早饭吗"},{"key":"B","text":"早饭在哪里"},{"key":"C","text":"你什么时候吃早饭"},{"key":"D","text":"早饭多少钱"}],"answer":"C","explanation":"When 问的是什么时候。","verify":"\"你什么时候吃早饭\""},{"id":"cne_p135_q1","topicId":"cne_p135","difficulty":"basic","type":"choice","prompt":"想说自己 7 点去上学，应说哪一句？","choices":[{"key":"A","text":"I go to school at 7 o'clock."},{"key":"B","text":"I get up at 7 o'clock."},{"key":"C","text":"I eat dinner at 7 o'clock."},{"key":"D","text":"I go to bed at 7 o'clock."}],"answer":"A","explanation":"去上学是 go to school。","verify":"\"I go to school at 7 o'clock.\""},{"id":"cne_p135_q2","topicId":"cne_p135","difficulty":"basic","type":"choice","prompt":"When do you eat dinner? 若是 6 点，应回答哪一句？","choices":[{"key":"A","text":"I eat dinner at 9 o'clock."},{"key":"B","text":"I eat dinner at 6 o'clock."},{"key":"C","text":"I go to bed at 6 o'clock."},{"key":"D","text":"I get up at 6 o'clock."}],"answer":"B","explanation":"问的是 eat dinner，时间是 6 点。","verify":"\"I eat dinner at 6 o'clock.\""},{"id":"cne_p135_q3","topicId":"cne_p135","difficulty":"standard","type":"choice","prompt":"I often clean my room on the weekend. 周末经常做什么？","choices":[{"key":"A","text":"起床"},{"key":"B","text":"上学"},{"key":"C","text":"打扫房间"},{"key":"D","text":"吃晚饭"}],"answer":"C","explanation":"clean my room。","verify":"\"打扫房间\""},{"id":"cne_p135_q4","topicId":"cne_p135","difficulty":"standard","type":"choice","prompt":"What do you do on the weekend? 这句是在问什么？","choices":[{"key":"A","text":"你几点起床"},{"key":"B","text":"你星期几有英语课"},{"key":"C","text":"你的老师什么样"},{"key":"D","text":"你周末做什么"}],"answer":"D","explanation":"on the weekend。","verify":"\"你周末做什么\""},{"id":"cne_p136_q1","topicId":"cne_p136","difficulty":"basic","type":"choice","prompt":"读一读：I get up at 6 o'clock. I go to school at 7 o'clock. 几点去上学？","choices":[{"key":"A","text":"6 点"},{"key":"B","text":"7 点"},{"key":"C","text":"8 点"},{"key":"D","text":"9 点"}],"answer":"B","explanation":"go to school at 7。","verify":"\"7 点\""},{"id":"cne_p136_q2","topicId":"cne_p136","difficulty":"basic","type":"numeric","prompt":"读一读：I eat dinner at 6 o'clock and go to bed at 9 o'clock. 几点睡觉？","answer":"9","explanation":"go to bed at 9。","verify":"9"},{"id":"cne_p136_q3","topicId":"cne_p136","difficulty":"standard","type":"choice","prompt":"读一读：On the weekend I often wash my clothes. 哪一句和短文一致？","choices":[{"key":"A","text":"周末我经常上学。"},{"key":"B","text":"我 6 点洗衣服。"},{"key":"C","text":"我从不洗衣服。"},{"key":"D","text":"周末我经常洗衣服。"}],"answer":"D","explanation":"often wash my clothes on the weekend。","verify":"\"周末我经常洗衣服。\""},{"id":"cne_p136_q4","topicId":"cne_p136","difficulty":"standard","type":"choice","prompt":"读一读：Sarah says, \"I get up at 6:30.\" Sarah 几点起床？","choices":[{"key":"A","text":"6:30"},{"key":"B","text":"6:00"},{"key":"C","text":"7:00"},{"key":"D","text":"9:00"}],"answer":"A","explanation":"引号里是 6:30。","verify":"\"6:30\""},{"id":"cne_p258_q1","topicId":"cne_p258","difficulty":"basic","type":"choice","prompt":"often 的意思是？","choices":[{"key":"A","text":"经常"},{"key":"B","text":"从不"},{"key":"C","text":"有时"},{"key":"D","text":"总是"}],"answer":"A","explanation":"often 是经常。","verify":"\"经常\""},{"id":"cne_p258_q2","topicId":"cne_p258","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「有时」？","choices":[{"key":"A","text":"always"},{"key":"B","text":"never"},{"key":"C","text":"usually"},{"key":"D","text":"sometimes"}],"answer":"D","explanation":"sometimes 是有时。","verify":"\"sometimes\""},{"id":"cne_p258_q3","topicId":"cne_p258","difficulty":"standard","type":"choice","prompt":"「从不」用哪个词？","choices":[{"key":"A","text":"often"},{"key":"B","text":"usually"},{"key":"C","text":"never"},{"key":"D","text":"always"}],"answer":"C","explanation":"never 是从不。","verify":"\"never\""},{"id":"cne_p258_q4","topicId":"cne_p258","difficulty":"challenge","type":"choice","prompt":"读一读：I usually get up early. I never go to bed late. 哪一句一致？","choices":[{"key":"A","text":"我不早起。"},{"key":"B","text":"我从不晚睡。"},{"key":"C","text":"我总是晚睡。"},{"key":"D","text":"我从不早起。"}],"answer":"B","explanation":"never go to bed late。","verify":"\"我从不晚睡。\""},{"id":"cne_p259_q1","topicId":"cne_p259","difficulty":"basic","type":"choice","prompt":"想说「我通常六点起床」，应选哪一句？","choices":[{"key":"A","text":"I usually get up at 6 o'clock."},{"key":"B","text":"I usually gets up at 6 o'clock."},{"key":"C","text":"I usual get up at 6."},{"key":"D","text":"I get usually up at 6."}],"answer":"A","explanation":"usually 放在实义动词前。","verify":"\"I usually get up at 6 o'clock.\""},{"id":"cne_p259_q2","topicId":"cne_p259","difficulty":"basic","type":"choice","prompt":"I sometimes eat dinner at 7. 我怎样吃晚饭？","choices":[{"key":"A","text":"从不吃"},{"key":"B","text":"总是九点吃"},{"key":"C","text":"没有晚饭"},{"key":"D","text":"有时七点吃"}],"answer":"D","explanation":"sometimes … at 7。","verify":"\"有时七点吃\""},{"id":"cne_p259_q3","topicId":"cne_p259","difficulty":"standard","type":"choice","prompt":"哪一句正确？","choices":[{"key":"A","text":"She cleans often her room."},{"key":"B","text":"She often cleaning her room."},{"key":"C","text":"She often cleans her room on the weekend."},{"key":"D","text":"She often clean her room on the weekend."}],"answer":"C","explanation":"三单 cleans；often 在动词前。","verify":"\"She often cleans her room on the weekend.\""},{"id":"cne_p259_q4","topicId":"cne_p259","difficulty":"challenge","type":"choice","prompt":"读一读：Mike always goes to school at 7. He never late for class. 哪句与短文最贴近？","choices":[{"key":"A","text":"他总是迟到。"},{"key":"B","text":"他总是七点去上学。"},{"key":"C","text":"他从不去上学。"},{"key":"D","text":"他有时七点去。"}],"answer":"B","explanation":"always … at 7。","verify":"\"他总是七点去上学。\""}]
