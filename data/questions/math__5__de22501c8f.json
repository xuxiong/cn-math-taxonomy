[{"difficulty":"basic","type":"numeric","prompt":"1.6 乘 2.4 的积，用四舍五入法保留一位小数是多少？（用小数作答）","answer":"3.8","explanation":"1.6×2.4＝3.84，百分位是 4，保留一位小数是 3.8。","verify":"Fraction(int(Fraction(16,10)*Fraction(24,10)*10+Fraction(1,2)),10)","id":"cnm_p135_q1","topicId":"cnm_p135"},{"difficulty":"basic","type":"numeric","prompt":"1.9 乘 0.4 的积，用四舍五入法保留一位小数是多少？（用小数作答）","answer":"0.8","explanation":"1.9×0.4＝0.76，百分位是 6，向十分位进 1，得 0.8。","verify":"Fraction(int(Fraction(19,10)*Fraction(4,10)*10+Fraction(1,2)),10)","id":"cnm_p135_q2","topicId":"cnm_p135"},{"difficulty":"standard","type":"numeric","prompt":"1.25 乘 1.3 的积，用四舍五入法保留两位小数是多少？（用小数作答）","answer":"1.63","explanation":"1.25×1.3＝1.625，千分位是 5，保留两位小数是 1.63。","verify":"Fraction(int(Fraction(125,100)*Fraction(13,10)*100+Fraction(1,2)),100)","id":"cnm_p135_q3","topicId":"cnm_p135"},{"difficulty":"challenge","type":"numeric","prompt":"每米彩带 2.37 元，买 1.6 米。总价用四舍五入法保留两位小数，大约多少元？（用小数作答）","answer":"3.79","explanation":"2.37×1.6＝3.792，千分位是 2，不去进位，保留两位小数是 3.79 元。","verify":"Fraction(int(Fraction(237,100)*Fraction(16,10)*100+Fraction(1,2)),100)","id":"cnm_p135_q4","topicId":"cnm_p135"},{"difficulty":"basic","type":"numeric","prompt":"下面 4 个式子：①x＋3＝8　②5＋2＝7　③x－4＞1　④9－x＝2。其中是方程的有几个？","answer":"2","explanation":"方程是含有未知数的等式。①和④是方程，②没有未知数，③不是等式。","verify":"2","id":"cnm_p143_q1","topicId":"cnm_p143"},{"difficulty":"basic","type":"choice","prompt":"方程必须同时满足哪两个条件？","choices":[{"key":"A","text":"含有未知数，并且是等式"},{"key":"B","text":"只要是等式就行"},{"key":"C","text":"只要含有字母就行"}],"answer":"A","explanation":"含有未知数的等式才叫方程。","verify":"'含有未知数，并且是等式'","id":"cnm_p143_q2","topicId":"cnm_p143"},{"difficulty":"standard","type":"choice","prompt":"下面哪个式子是方程？","choices":[{"key":"A","text":"12＋8＝20"},{"key":"B","text":"x＋9＞12"},{"key":"C","text":"x＋9＝30"},{"key":"D","text":"30－9＜25"}],"answer":"C","explanation":"x＋9＝30 既含有未知数，又是等式。","verify":"'x＋9＝30'","id":"cnm_p143_q3","topicId":"cnm_p143"},{"difficulty":"challenge","type":"numeric","prompt":"下面 5 个式子：①3x＝12　②7＋5＝12　③x÷2＝4　④