[{"id":"cnp_057_q1","topicId":"cnp_057","difficulty":"basic","type":"choice","prompt":"汽油机的哪个冲程把内能转化为机械能？","choices":[{"key":"A","text":"做功冲程"},{"key":"B","text":"压缩冲程"},{"key":"C","text":"吸气冲程"},{"key":"D","text":"排气冲程"}],"answer":"A","explanation":"做功冲程中燃气推动活塞做功，内能转化为机械能；压缩冲程则相反。","verify":"\"做功冲程\""},{"id":"cnp_057_q2","topicId":"cnp_057","difficulty":"basic","type":"choice","prompt":"汽油机的压缩冲程中，能量是怎样转化的？","choices":[{"key":"A","text":"内能转化为机械能"},{"key":"B","text":"机械能转化为内能"},{"key":"C","text":"化学能转化为电能"},{"key":"D","text":"没有能量转化"}],"answer":"B","explanation":"活塞压缩气体做功，机械能转化为内能，气体温度升高。","verify":"\"机械能转化为内能\""},{"id":"cnp_057_q3","topicId":"cnp_057","difficulty":"standard","type":"numeric","prompt":"某单缸四冲程汽油机飞轮转速为 1800 r/min，它每秒对外做功多少次？（只填数值）","answer":"15","explanation":"每秒转 30 圈；一个工作循环飞轮转 2 圈、做功 1 次，所以每秒做功 15 次。","verify":"1800/60/2"},{"id":"cnp_057_q4","topicId":"cnp_057","difficulty":"standard","type":"choice","prompt":"汽油机一个工作循环中，有几个冲程？","choices":[{"key":"A","text":"2 个"},{"key":"B","text":"1 个"},{"key":"C","text":"4 个"},{"key":"D","text":"3 个"}],"answer":"C","explanation":"一个工作循环包括吸气、压缩、做功、排气四个冲程。","verify":"4"}]
