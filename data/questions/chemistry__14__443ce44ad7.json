[{"id":"cnk_h095_q1","topicId":"cnk_h095","difficulty":"basic","type":"choice","prompt":"葡萄糖的分子式是？","choices":[{"key":"A","text":"C6H12O6"},{"key":"B","text":"C2H6O"},{"key":"C","text":"C2H4"},{"key":"D","text":"C2H4O2"}],"answer":"A","explanation":"葡萄糖是含六个碳的单糖，分子式为 C6H12O6。另三个分别接近乙醇、乙烯和乙酸。","verify":"\"C6H12O6\""},{"id":"cnk_h095_q2","topicId":"cnk_h095","difficulty":"basic","type":"choice","prompt":"下列属于还原糖的是？","choices":[{"key":"A","text":"蔗糖"},{"key":"B","text":"葡萄糖"},{"key":"C","text":"聚乙烯"},{"key":"D","text":"甲烷"}],"answer":"B","explanation":"葡萄糖能发生银镜反应，是还原糖。蔗糖本身不能，聚乙烯和甲烷也不是糖。","verify":"\"葡萄糖\""},{"id":"cnk_h095_q3","topicId":"cnk_h095","difficulty":"standard","type":"numeric","prompt":"葡萄糖的分子式是 C6H12O6。相对原子质量按 C 12、H 1、O 16，相对分子质量是多少？","answer":"180","explanation":"12×6+12+16×6＝72+12+96＝180。","verify":"12 * 6 + 1 * 12 + 16 * 6"},{"id":"cnk_h095_q4","topicId":"cnk_h095","difficulty":"challenge","type":"choice","prompt":"淀粉遇碘液变蓝；蔗糖不能发生银镜反应，水解后可以。这说明？","choices":[{"key":"A","text":"蔗糖本身就是还原糖，水解前后完全一样"},{"key":"B","text":"淀粉变蓝说明它是醛"},{"key":"C","text":"碘液变蓝是酸碱中和"},{"key":"D","text":"淀粉有能与碘作用的结构；蔗糖本身不是还原糖，水解生成的单糖才有还原性"}],"answer":"D","explanation":"淀粉与碘形成蓝色物质。蔗糖要先水解成葡萄糖和果糖，产物才能表现还原性。","verify":"\"淀粉有能与碘作用的结构；蔗糖本身不是还原糖，水解生成的单糖才有还原性\""}]
