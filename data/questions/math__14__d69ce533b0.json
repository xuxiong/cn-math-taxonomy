[{"id":"cnm_h252_q1","topicId":"cnm_h252","difficulty":"basic","type":"numeric","prompt":"X 取值 1、2、3，概率分别是 1/2、1/3、1/6。X 的均值是多少？","answer":"5/3","explanation":"1/2+2/3+1/2=5/3。","verify":"1*Fraction(1,2)+2*Fraction(1,3)+3*Fraction(1,6)"},{"id":"cnm_h252_q2","topicId":"cnm_h252","difficulty":"basic","type":"numeric","prompt":"X 取值 0、1，概率分别是 3/4、1/4。均值是多少？","answer":"1/4","explanation":"均值等于 1/4。","verify":"0*Fraction(3,4)+1*Fraction(1,4)"},{"id":"cnm_h252_q3","topicId":"cnm_h252","difficulty":"standard","type":"choice","prompt":"离散型随机变量的均值是怎样平均的？","choices":[{"key":"A","text":"把所有取值直接相加"},{"key":"B","text":"只取概率最大的那个值"},{"key":"C","text":"用取值的个数去除最大值"},{"key":"D","text":"用概率做权，把取值加权相加"}],"answer":"D","explanation":"概率大的取值对均值影响更大。","verify":"\"用概率做权，把取值加权相加\""},{"id":"cnm_h252_q4","topicId":"cnm_h252","difficulty":"standard","type":"numeric","prompt":"X 取值 2 和 4，概率都是 1/2。均值是多少？","answer":"3","explanation":"1+2=3。","verify":"2*Fraction(1,2)+4*Fraction(1,2)"},{"id":"cnm_h253_q1","topicId":"cnm_h253","difficulty":"basic","type":"numeric","prompt":"X 取值 0 和 1，概率都是 1/2。方差是多少？","answer":"1/4","explanation":"均值是 1/2。两个平方都是 1/4，再各乘 1/2，方差是 1/4。","verify":"(0-Fraction(1,2))**2*Fraction(1,2)+(1-Fraction(1,2))**2*Fraction(1,2)"},{"id":"cnm_h253_q2","topicId":"cnm_h253","difficulty":"basic","type":"numeric","prompt":"X 取值 1 和 3，概率都是 1/2。方差是多少？","answer":"1","explanation":"均值是 2。两个偏差平方都是 1，加权后方差是 1。","verify":"(1-2)**2*Fraction(1,2)+(3-2)**2*Fraction(1,2)"},{"id":"cnm_h253_q3","topicId":"cnm_h253","difficulty":"standard","type":"choice","prompt":"方差描述的是什么？","choices":[{"key":"A","text":"取值相对均值的离散程度"},{"key":"B","text":"取值的个数"},{"key":"C","text":"最大取值"},{"key":"D","text":"概率之和"}],"answer":"A","explanation":"离均值越远、而且这种偏离的概率越大，方差越大。","verify":"\"取值相对均值的离散程度\""},{"id":"cnm_h253_q4","topicId":"cnm_h253","difficulty":"standard","type":"numeric","prompt":"X 总是取 5，也就是 P(X=5)=1。方差是多少？","answer":"0","explanation":"取值没有偏离均值，方差是 0。","verify":"(5-5)**2*1"}]
