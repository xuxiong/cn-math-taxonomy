[{"id":"cnp_056_q1","topicId":"cnp_056","difficulty":"basic","type":"choice","prompt":"能量守恒定律指出，在能量转化和转移的过程中，能量的总量怎样？","choices":[{"key":"A","text":"逐渐减少"},{"key":"B","text":"逐渐增加"},{"key":"C","text":"先增后减"},{"key":"D","text":"保持不变"}],"answer":"D","explanation":"能量既不会凭空消灭也不会凭空产生，总量保持不变。","verify":"\"保持不变\""},{"id":"cnp_056_q2","topicId":"cnp_056","difficulty":"basic","type":"choice","prompt":"电风扇工作时，主要的能量转化是什么？","choices":[{"key":"A","text":"机械能转化为电能"},{"key":"B","text":"内能转化为电能"},{"key":"C","text":"电能转化为机械能"},{"key":"D","text":"化学能转化为电能"}],"answer":"C","explanation":"电风扇消耗电能，扇叶转动获得机械能。","verify":"\"电能转化为机械能\""},{"id":"cnp_056_q3","topicId":"cnp_056","difficulty":"standard","type":"choice","prompt":"为什么“永动机”不可能制成？","choices":[{"key":"A","text":"违背了能量守恒定律"},{"key":"B","text":"材料不够结实"},{"key":"C","text":"技术还不够先进"},{"key":"D","text":"需要的电太多"}],"answer":"A","explanation":"不消耗能量却源源不断对外做功，违背能量守恒定律。","verify":"\"违背了能量守恒定律\""},{"id":"cnp_056_q4","topicId":"cnp_056","difficulty":"standard","type":"choice","prompt":"汽车刹车时，车的动能主要转化成了什么？","choices":[{"key":"A","text":"电能"},{"key":"B","text":"化学能"},{"key":"C","text":"内能"},{"key":"D","text":"重力势能"}],"answer":"C","explanation":"刹车片与车轮摩擦生热，动能转化为内能，而且这部分能量不能自动再变回动能（能量转化有方向性）。","verify":"\"内能\""}]
