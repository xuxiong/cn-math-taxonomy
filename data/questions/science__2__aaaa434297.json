[{"id":"cns_p054_q1","topicId":"cns_p054","difficulty":"basic","type":"choice","prompt":"磁铁能吸起下面哪个物品？","choices":[{"key":"A","text":"橡皮"},{"key":"B","text":"木块"},{"key":"C","text":"纸片"},{"key":"D","text":"铁回形针"}],"answer":"D","explanation":"铁做的回形针能被磁铁吸引。","verify":"\"铁回形针\""},{"id":"cns_p054_q2","topicId":"cns_p054","difficulty":"basic","type":"choice","prompt":"磁铁不能吸起下面哪个物品？","choices":[{"key":"A","text":"塑料尺"},{"key":"B","text":"铁钉"},{"key":"C","text":"铁丝"},{"key":"D","text":"大头针"}],"answer":"A","explanation":"塑料不能被磁铁吸引。","verify":"\"塑料尺\""},{"id":"cns_p054_q3","topicId":"cns_p054","difficulty":"standard","type":"choice","prompt":"磁铁能吸引的物体，通常含有什么？","choices":[{"key":"A","text":"木头"},{"key":"B","text":"铁"},{"key":"C","text":"塑料"},{"key":"D","text":"玻璃"}],"answer":"B","explanation":"磁铁吸引铁一类的物体。","verify":"\"铁\""},{"id":"cns_p054_q4","topicId":"cns_p054","difficulty":"challenge","type":"choice","prompt":"一枚铝做的易拉罐拉环和一枚铁钉，哪个能被磁铁吸起？","choices":[{"key":"A","text":"铝拉环"},{"key":"B","text":"两个都能"},{"key":"C","text":"铁钉"},{"key":"D","text":"两个都不能"}],"answer":"C","explanation":"并不是所有金属都能被吸，铝就不能被磁铁吸引。","verify":"\"铁钉\""},{"id":"cns_p055_q1","topicId":"cns_p055","difficulty":"basic","type":"choice","prompt":"条形磁铁哪里吸住的回形针最多？","choices":[{"key":"A","text":"两端"},{"key":"B","text":"正中间"},{"key":"C","text":"到处一样多"},{"key":"D","text":"侧面中间"}],"answer":"A","explanation":"磁铁两端磁力最强，叫磁极。","verify":"\"两端\""},{"id":"cns_p055_q2","topicId":"cns_p055","difficulty":"basic","type":"choice","prompt":"磁铁磁力最强的部位叫什么？","choices":[{"key":"A","text":"磁心"},{"key":"B","text":"磁极"},{"key":"C","text":"磁边"},{"key":"D","text":"磁面"}],"answer":"B","explanation":"磁极是磁力最强的地方。","verify":"\"磁极\""},{"id":"cns_p055_q3","topicId":"cns_p055","difficulty":"standard","type":"choice","prompt":"比较两块磁铁磁力大小，下面哪个方法好？","choices":[{"key":"A","text":"看谁颜色深"},{"key":"B","text":"看谁更大"},{"key":"C","text":"看谁吸起的同样回形针多"},{"key":"D","text":"看谁更重"}],"answer":"C","explanation":"吸起回形针越多，磁力越大。","verify":"\"看谁吸起的同样回形针多\""},{"id":"cns_p055_q4","topicId":"cns_p055","difficulty":"challenge","type":"choice","prompt":"一块磁铁吸起 8 枚回形针，另一块吸起 3 枚，下面说法正确的是？","choices":[{"key":"A","text":"后一块磁力更大"},{"key":"B","text":"两块一样"},{"key":"C","text":"无法比较"},{"key":"D","text":"前一块磁力更大"}],"answer":"D","explanation":"同样的回形针，吸得多说明磁力大。","verify":"\"前一块磁力更大\""},{"id":"cns_p056_q1","topicId":"cns_p056","difficulty":"basic","type":"choice","prompt":"隔着一张纸，磁铁还能吸住回形针吗？","choices":[{"key":"A","text":"不能"},{"key":"B","text":"能"},{"key":"C","text":"只能吸塑料"},{"key":"D","text":"纸会被吸走"}],"answer":"B","explanation":"磁力能穿过纸。","verify":"\"能\""},{"id":"cns_p056_q2","topicId":"cns_p056","difficulty":"basic","type":"choice","prompt":"杯里的水中有一枚铁钉，不伸手进水怎样把它取出？","choices":[{"key":"A","text":"把水烧开"},{"key":"B","text":"大声喊"},{"key":"C","text":"用磁铁在杯外沿杯壁把它吸上来"},{"key":"D","text":"用纸盖住"}],"answer":"C","explanation":"磁力能隔着玻璃和水吸引铁钉。","verify":"\"用磁铁在杯外沿杯壁把它吸上来\""},{"id":"cns_p056_q3","topicId":"cns_p056","difficulty":"standard","type":"choice","prompt":"隔着的东西越来越厚，磁铁吸回形针会怎样？","choices":[{"key":"A","text":"越来越容易"},{"key":"B","text":"一点不变"},{"key":"C","text":"回形针会变大"},{"key":"D","text":"越来越难吸住"}],"answer":"D","explanation":"距离越远，磁力越弱。","verify":"\"越来越难吸住\""},{"id":"cns_p056_q4","topicId":"cns_p056","difficulty":"challenge","type":"choice","prompt":"下面哪个现象利用了「隔物吸铁」？","choices":[{"key":"A","text":"冰箱贴隔着照片吸在冰箱门上"},{"key":"B","text":"用胶水粘纸"},{"key":"C","text":"用绳子挂衣服"},{"key":"D","text":"用钉子钉木板"}],"answer":"A","explanation":"冰箱贴里的磁铁隔着照片吸住铁门。","verify":"\"冰箱贴隔着照片吸在冰箱门上\""},{"id":"cns_p057_q1","topicId":"cns_p057","difficulty":"basic","type":"choice","prompt":"磁铁钓鱼玩具里，「小鱼」上要装什么？","choices":[{"key":"A","text":"橡皮"},{"key":"B","text":"纸条"},{"key":"C","text":"回形针"},{"key":"D","text":"棉花"}],"answer":"C","explanation":"鱼上装铁的回形针，才能被磁铁吸住。","verify":"\"回形针\""},{"id":"cns_p057_q2","topicId":"cns_p057","difficulty":"basic","type":"choice","prompt":"钓鱼竿的「鱼钩」用什么做？","choices":[{"key":"A","text":"木棍头"},{"key":"B","text":"塑料片"},{"key":"C","text":"布"},{"key":"D","text":"磁铁"}],"answer":"D","explanation":"鱼钩是一块磁铁。","verify":"\"磁铁\""},{"id":"cns_p057_q3","topicId":"cns_p057","difficulty":"standard","type":"choice","prompt":"小鱼钓不起来，最可能的原因是？","choices":[{"key":"A","text":"鱼身上的回形针掉了"},{"key":"B","text":"鱼的颜色太浅"},{"key":"C","text":"鱼太好看"},{"key":"D","text":"绳子太长了一点"}],"answer":"A","explanation":"没有铁，磁铁吸不住。","verify":"\"鱼身上的回形针掉了\""},{"id":"cns_p057_q4","topicId":"cns_p057","difficulty":"challenge","type":"choice","prompt":"钓鱼比赛时，为什么大家要用同样的鱼竿和同样多的鱼？","choices":[{"key":"A","text":"为了好看"},{"key":"B","text":"比赛才公平"},{"key":"C","text":"鱼不够"},{"key":"D","text":"没有原因"}],"answer":"B","explanation":"条件相同，比较技术才公平。","verify":"\"比赛才公平\""},{"id":"cns_p058_q1","topicId":"cns_p058","difficulty":"basic","type":"choice","prompt":"一块磁铁有几个磁极？","choices":[{"key":"A","text":"一个"},{"key":"B","text":"三个"},{"key":"C","text":"没有"},{"key":"D","text":"两个"}],"answer":"D","explanation":"每块磁铁都有 N 极和 S 极两个磁极。","verify":"\"两个\""},{"id":"cns_p058_q2","topicId":"cns_p058","difficulty":"basic","type":"choice","prompt":"磁铁的 N 极又叫什么极？","choices":[{"key":"A","text":"北极"},{"key":"B","text":"南极"},{"key":"C","text":"东极"},{"key":"D","text":"西极"}],"answer":"A","explanation":"N 极指北，又叫北极。","verify":"\"北极\""},{"id":"cns_p058_q3","topicId":"cns_p058","difficulty":"standard","type":"choice","prompt":"把条形磁铁吊起来让它自由转动，停下时会怎样？","choices":[{"key":"A","text":"随便停在哪个方向"},{"key":"B","text":"一端指南，一端指北"},{"key":"C","text":"一直不停地转"},{"key":"D","text":"一端指东一端指西"}],"answer":"B","explanation":"自由转动的磁铁会指南北。","verify":"\"一端指南，一端指北\""},{"id":"cns_p058_q4","topicId":"cns_p058","difficulty":"challenge","type":"choice","prompt":"把一块条形磁铁从中间断开，每一段有几个磁极？","choices":[{"key":"A","text":"一个"},{"key":"B","text":"零个"},{"key":"C","text":"两个"},{"key":"D","text":"四个"}],"answer":"C","explanation":"断开后每段仍然有 N 极和 S 极。","verify":"\"两个\""},{"id":"cns_p059_q1","topicId":"cns_p059","difficulty":"basic","type":"choice","prompt":"两块磁铁的 N 极靠近时会怎样？","choices":[{"key":"A","text":"互相排斥"},{"key":"B","text":"互相吸引"},{"key":"C","text":"没有反应"},{"key":"D","text":"粘在一起"}],"answer":"A","explanation":"同极相斥。","verify":"\"互相排斥\""},{"id":"cns_p059_q2","topicId":"cns_p059","difficulty":"basic","type":"choice","prompt":"磁铁的 N 极和 S 极靠近会怎样？","choices":[{"key":"A","text":"互相排斥"},{"key":"B","text":"互相吸引"},{"key":"C","text":"没有反应"},{"key":"D","text":"变成一块"}],"answer":"B","explanation":"异极相吸。","verify":"\"互相吸引\""},{"id":"cns_p059_q3","topicId":"cns_p059","difficulty":"standard","type":"choice","prompt":"小车上装着磁铁，用另一块磁铁的同极去靠近，小车会怎样？","choices":[{"key":"A","text":"被拉过来"},{"key":"B","text":"原地不动"},{"key":"C","text":"被推着向前走"},{"key":"D","text":"翻过来"}],"answer":"C","explanation":"同极相斥，小车被推开。","verify":"\"被推着向前走\""},{"id":"cns_p059_q4","topicId":"cns_p059","difficulty":"challenge","type":"choice","prompt":"一块磁铁的两极标记看不清了，怎样用一块标好的磁铁找出它的 N 极？","choices":[{"key":"A","text":"看哪端颜色深"},{"key":"B","text":"用手摸"},{"key":"C","text":"放进水里"},{"key":"D","text":"靠近标好的 N 极，被排斥的一端就是 N 极"}],"answer":"D","explanation":"同极相斥，被 N 极推开的就是 N 极。","verify":"\"靠近标好的 N 极，被排斥的一端就是 N 极\""},{"id":"cns_p060_q1","topicId":"cns_p060","difficulty":"basic","type":"choice","prompt":"下面哪一样东西用到了磁铁？","choices":[{"key":"A","text":"铅笔芯"},{"key":"B","text":"冰箱门封条"},{"key":"C","text":"木头椅子"},{"key":"D","text":"玻璃杯"}],"answer":"B","explanation":"冰箱门封条里有磁条，能把门吸紧。","verify":"\"冰箱门封条\""},{"id":"cns_p060_q2","topicId":"cns_p060","difficulty":"basic","type":"choice","prompt":"有的文具盒盖子能「啪」地自动吸住，里面装了什么？","choices":[{"key":"A","text":"胶水"},{"key":"B","text":"弹簧"},{"key":"C","text":"小磁铁"},{"key":"D","text":"海绵"}],"answer":"C","explanation":"盒盖和盒身里的磁铁互相吸引。","verify":"\"小磁铁\""},{"id":"cns_p060_q3","topicId":"cns_p060","difficulty":"standard","type":"choice","prompt":"能帮助人们辨别方向的磁铁工具是什么？","choices":[{"key":"A","text":"放大镜"},{"key":"B","text":"温度计"},{"key":"C","text":"天平"},{"key":"D","text":"指南针"}],"answer":"D","explanation":"指南针里的磁针会指南北。","verify":"\"指南针\""},{"id":"cns_p060_q4","topicId":"cns_p060","difficulty":"challenge","type":"choice","prompt":"为什么不能把磁铁靠近手机、银行卡？","choices":[{"key":"A","text":"磁铁可能影响它们正常工作"},{"key":"B","text":"磁铁会变色"},{"key":"C","text":"手机会变重"},{"key":"D","text":"磁铁会碎"}],"answer":"A","explanation":"强磁铁可能损坏磁条卡或干扰电子设备。","verify":"\"磁铁可能影响它们正常工作\""}]
