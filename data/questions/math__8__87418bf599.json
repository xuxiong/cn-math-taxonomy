[{"id":"cnm_152_q1","topicId":"cnm_152","difficulty":"basic","type":"choice","prompt":"分解 4x²-9。","answer":"B","choices":[{"key":"A","text":"(2x-3)²"},{"key":"B","text":"(2x+3)(2x-3)"},{"key":"C","text":"(4x+3)(x-3)"},{"key":"D","text":"(4x+9)(x-1)"}],"explanation":"4x²-9=(2x)²-3²=(2x+3)(2x-3)。"},{"id":"cnm_152_q2","topicId":"cnm_152","difficulty":"basic","type":"numeric","prompt":"已知 x²-16=(x+4)(x-a)，求 a 的值。","answer":"4","explanation":"x²-16=x²-4²=(x+4)(x-4)，所以 a=4。","verify":"isqrt(16)"},{"id":"cnm_152_q3","topicId":"cnm_152","difficulty":"standard","type":"choice","prompt":"下列多项式中，能用平方差公式分解因式的是：","answer":"A","choices":[{"key":"A","text":"-x²+y²"},{"key":"B","text":"x²+y²"},{"key":"C","text":"-x²-y²"},{"key":"D","text":"x²-2y"}],"explanation":"-x²+y²=y²-x²=(y+x)(y-x)；平方差要求两项异号且都是平方项。"},{"id":"cnm_152_q4","topicId":"cnm_152","difficulty":"standard","type":"numeric","prompt":"已知 a+b=5，a-b=2，求 a²-b² 的值。","answer":"10","explanation":"a²-b²=(a+b)(a-b)=5×2=10。","verify":"5*2"},{"id":"cnm_152_q5","topicId":"cnm_152","difficulty":"advanced","type":"choice","prompt":"分解因式 x^4-16，结果（分解彻底）是：","answer":"A","choices":[{"key":"A","text":"(x^2+4)(x+2)(x-2)"},{"key":"B","text":"(x^2+4)(x^2-4)"},{"key":"C","text":"(x+2)^2(x-2)^2"},{"key":"D","text":"(x^2-4)^2"}],"explanation":"x^4-16=(x^2+4)(x^2-4)，其中 x^2-4 还能继续分解为 (x+2)(x-2)，x^2+4 不能再分。"},{"id":"cnm_153_q1","topicId":"cnm_153","difficulty":"basic","type":"choice","prompt":"分解 x²-6x+9。","answer":"D","choices":[{"key":"A","text":"(x+3)²"},{"key":"B","text":"(x-3)(x+3)"},{"key":"C","text":"(x-9)(x+1)"},{"key":"D","text":"(x-3)²"}],"explanation":"x²-6x+9=x²-2·x·3+3²=(x-3)²。"},{"id":"cnm_153_q2","topicId":"cnm_153","difficulty":"basic","type":"numeric","prompt":"已知 x²+10x+25=(x+a)²，求 a 的值。","answer":"5","explanation":"x²+10x+25=x²+2·x·5+5²=(x+5)²，所以 a=5。","verify":"10//2"},{"id":"cnm_153_q3","topicId":"cnm_153","difficulty":"standard","type":"choice","prompt":"下列多项式中，是完全平方式的是：","answer":"C","choices":[{"key":"A","text":"x²+2x-1"},{"key":"B","text":"x²+4x+16"},{"key":"C","text":"x²-4x+4"},{"key":"D","text":"x²+x+1"}],"explanation":"x²-4x+4=x²-2·x·2+2²=(x-2)²；x²+4x+16 中间项应为 ±8x，其余几个也不满足 a²±2ab+b² 的结构。"},{"id":"cnm_153_q4","topicId":"cnm_153","difficulty":"standard","type":"numeric","prompt":"若 x²+kx+16 是完全平方式，求 k 的值（多个答案用逗号隔开）。","answer":"8，-8","unordered":true,"explanation":"16=4²，所以中间项 kx=±2·x·4=±8x，k=8 或 -8。","verify":"[-2*isqrt(16), 2*isqrt(16)]"},{"id":"cnm_153_q5","topicId":"cnm_153","difficulty":"advanced","type":"numeric","prompt":"已知 x²+y²-4x+6y+13=0，求 x+y 的值。","answer":"-1","explanation":"配方：(x-2)²+(y+3)²=0，所以 x=2，y=-3，x+y=-1。","verify":"isqrt(4)+(-isqrt(9))"},{"id":"cnm_154_q1","topicId":"cnm_154","difficulty":"basic","type":"choice","prompt":"分解 2x³-8x。","answer":"C","choices":[{"key":"A","text":"2x(x²-4)"},{"key":"B","text":"2x(x-2)²"},{"key":"C","text":"2x(x+2)(x-2)"},{"key":"D","text":"2(x³-4x)"}],"explanation":"先提公因式 2x 得 2x(x²-4)，再用平方差分解 x²-4=(x+2)(x-2)，直到不能再分。"},{"id":"cnm_154_q2","topicId":"cnm_154","difficulty":"basic","type":"numeric","prompt":"分解因式 3x²-12=3(x+a)(x-a)，其中 a>0，求 a 的值。","answer":"2","explanation":"3x²-12=3(x²-4)=3(x+2)(x-2)，所以 a=2。","verify":"isqrt(12//3)"},{"id":"cnm_154_q3","topicId":"cnm_154","difficulty":"standard","type":"numeric","prompt":"已知 x=51，y=49，求 3x²-3y² 的值。","answer":"600","explanation":"3x²-3y²=3(x+y)(x-y)=3×100×2=600。","verify":"3*(51+49)*(51-49)"},{"id":"cnm_154_q4","topicId":"cnm_154","difficulty":"advanced","type":"choice","prompt":"分解因式 -x³+2x²-x，结果（分解彻底）是：","answer":"A","choices":[{"key":"A","text":"-x(x-1)²"},{"key":"B","text":"x(x-1)²"},{"key":"C","text":"-x(x+1)²"},{"key":"D","text":"-x(x²-2x+1)"}],"explanation":"先提公因式 -x 得 -x(x²-2x+1)，括号内是完全平方式，继续分解为 (x-1)²。"}]
