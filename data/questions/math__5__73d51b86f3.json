[{"difficulty":"basic","type":"choice","prompt":"长方体有几个面？","choices":[{"key":"A","text":"6 个"},{"key":"B","text":"4 个"},{"key":"C","text":"8 个"}],"answer":"A","explanation":"长方体有 6 个面、12 条棱、8 个顶点。","verify":"'6 个'","id":"cnm_p160_q1","topicId":"cnm_p160"},{"difficulty":"basic","type":"choice","prompt":"正方体的每条棱怎样？","choices":[{"key":"A","text":"一样长"},{"key":"B","text":"只有 4 条一样长"},{"key":"C","text":"长短都不一样"}],"answer":"A","explanation":"正方体 12 条棱都相等，它是特殊的长方体。","verify":"'一样长'","id":"cnm_p160_q2","topicId":"cnm_p160"},{"difficulty":"standard","type":"numeric","prompt":"一个长方体相对的两个面完全相同。形状大小完全相同的面有几对？","answer":"3","explanation":"6 个面分成 3 对相对的面。","verify":"6//2","id":"cnm_p160_q3","topicId":"cnm_p160"},{"difficulty":"challenge","type":"numeric","prompt":"一个长方体长 5 厘米、宽 4 厘米、高 3 厘米。12 条棱的长度一共是多少厘米？","answer":"48","explanation":"长、宽、高各有 4 条：4×（5＋4＋3）＝48（厘米）。","verify":"4*(5+4+3)","id":"cnm_p160_q4","topicId":"cnm_p160"},{"difficulty":"basic","type":"numeric","prompt":"长 5 厘米、宽 4 厘米、高 3 厘米的长方体，表面积是多少平方厘米？","answer":"94","explanation":"（5×4＋5×3＋4×3）×2＝94（平方厘米）。","verify":"(5*4+5*3+4*3)*2","id":"cnm_p161_q1","topicId":"cnm_p161"},{"difficulty":"basic","type":"numeric","prompt":"棱长 3 厘米的正方体，表面积是多少平方厘米？","answer":"54","explanation":"一个面是 3×3＝9，6 个面：9×6＝54（平方厘米）。","verify":"3*3*6","id":"cnm_p161_q2","topicId":"cnm_p161"},{"difficulty":"standard","type":"numeric","prompt":"一个正方体棱长 2 厘米。表面积是多少平方厘米？","answer":"24","explanation":"一个面是 2×2＝4，6 个面：4×6＝24（平方厘米）。","verify":"2*2*6","id":"cnm_p161_q3","topicId":"cnm_p161"},{"difficulty":"challenge","type":"numeric","prompt":"做一个无盖的长方体纸盒，长 6 厘米、宽 4 厘米、高 3 厘米。至少需要多少平方厘米的纸？","answer":"84","explanation":"完整表面积是 108 平方厘米，去掉上面 6×4＝24，还要 108－24＝84。","verify":"(6*4+6*3+4*3)*2-6*4","id":"cnm_p161_q4","topicId":"cnm_p161"},{"difficulty":"basic","type":"choice","prompt":"体积要用什么来表示？","choices":[{"key":"A","text":"体积单位"},{"key":"B","text":"长度单位"},{"key":"C","text":"只写一个数，不用单位"}],"answer":"A","explanation":"体积要用立方厘米、立方分米或立方米来表示。","verify":"'体积单位'","id":"cnm_p162_q1","topicId":"cnm_p162"},{"difficulty":"basic","type":"numeric","prompt":"1 立方分米＝1000 立方厘米。2 立方分米等于多少立方厘米？","answer":"2000","explanation":"2×1000＝2000（立方厘米）。","verify":"2*1000","id":"cnm_p162_q2","topicId":"cnm_p162"},{"difficulty":"standard","type":"numeric","prompt":"1 立方米＝1000 立方分米。3 立方米是多少立方分米？","answer":"3000","explanation":"3×1000＝3000（立方分米）。","verify":"3*1000","id":"cnm_p162_q3","topicId":"cnm_p162"},{"difficulty":"challenge","type":"numeric","prompt":"1 立方米＝1000 立方分米，1 立方分米＝1000 立方厘米。1 立方米等于多少立方厘米？","answer":"1000000","explanation":"1000×1000＝1000000（立方厘米）。","verify":"1000*1000","id":"cnm_p162_q4","topicId":"cnm_p162"},{"difficulty":"basic","type":"numeric","prompt":"长 5 厘米、宽 4 厘米、高 3 厘米的长方体，体积是多少立方厘米？","answer":"60","explanation":"长×宽×高＝5×4×3＝60。","verify":"5*4*3","id":"cnm_p163_q1","topicId":"cnm_p163"},{"difficulty":"basic","type":"numeric","prompt":"棱长 3 厘米的正方体，体积是多少立方厘米？","answer":"27","explanation":"棱长×棱长×棱长＝3×3×3＝27。","verify":"3*3*3","id":"cnm_p163_q2","topicId":"cnm_p163"},{"difficulty":"standard","type":"numeric","prompt":"一个长方体纸盒长 8 厘米、宽 5 厘米、高 2 厘米。体积是多少立方厘米？","answer":"80","explanation":"8×5×2＝80（立方厘米）。","verify":"8*5*2","id":"cnm_p163_q3","topicId":"cnm_p163"},{"difficulty":"challenge","type":"numeric","prompt":"棱长 4 厘米的正方体，比长 8 厘米、宽 5 厘米、高 2 厘米的长方体，体积少多少立方厘米？","answer":"16","explanation":"正方体 4×4×4＝64，长方体 8×5×2＝80，80－64＝16。","verify":"8*5*2-4*4*4","id":"cnm_p163_q4","topicId":"cnm_p163"},{"difficulty":"basic","type":"choice","prompt":"容积指的是什么？","choices":[{"key":"A","text":"容器里面能容纳物体的体积"},{"key":"B","text":"容器外面的表面积"},{"key":"C","text":"容器壁有多厚"}],"answer":"A","explanation":"容积是容器所能容纳的体积。","verify":"'容器里面能容纳物体的体积'","id":"cnm_p164_q1","topicId":"cnm_p164"},{"difficulty":"basic","type":"numeric","prompt":"1 升＝1000 毫升。2 升等于多少毫升？","answer":"2000","explanation":"2×1000＝2000（毫升）。","verify":"2*1000","id":"cnm_p164_q2","topicId":"cnm_p164"},{"difficulty":"standard","type":"choice","prompt":"一瓶饮料 500 毫升，2 瓶一共是多少升？","choices":[{"key":"A","text":"1 升"},{"key":"B","text":"2 升"},{"key":"C","text":"10 升"},{"key":"D","text":"100 升"}],"answer":"A","explanation":"500×2＝1000（毫升）＝1 升。","verify":"'1 升'","id":"cnm_p164_q3","topicId":"cnm_p164"},{"difficulty":"challenge","type":"numeric","prompt":"一个长方体水箱从里面量，长 5 分米、宽 4 分米、高 3 分米。最多能装多少升水？1 立方分米＝1 升。","answer":"60","explanation":"容积是 5×4×3＝60（立方分米），也就是 60 升。","verify":"5*4*3","id":"cnm_p164_q4","topicId":"cnm_p164"}]
