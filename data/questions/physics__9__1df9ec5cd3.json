[{"id":"cnp_077_q1","topicId":"cnp_077","difficulty":"basic","type":"numeric","prompt":"电流 2 A 通过 10 Ω 的电阻，通电 60 s 产生多少 J 的热量？（只填数值）","answer":"2400","explanation":"Q = I²Rt = 2² × 10 × 60 = 2400 J。","verify":"2**2*10*60"},{"id":"cnp_077_q2","topicId":"cnp_077","difficulty":"basic","type":"choice","prompt":"电炉丝热得发红，与它连接的导线却不怎么热，主要原因是什么？","choices":[{"key":"A","text":"导线中电流比电炉丝中小"},{"key":"B","text":"导线电阻比电炉丝小得多"},{"key":"C","text":"导线散热快"},{"key":"D","text":"导线中没有电流"}],"answer":"B","explanation":"二者串联电流相等，由 Q = I²Rt，电阻大的电炉丝产生的热量多。","verify":"\"导线电阻比电炉丝小得多\""},{"id":"cnp_077_q3","topicId":"cnp_077","difficulty":"standard","type":"choice","prompt":"下列用电器中，利用电流热效应工作的是哪一个？","choices":[{"key":"A","text":"电风扇"},{"key":"B","text":"电视机"},{"key":"C","text":"电冰箱"},{"key":"D","text":"电饭锅"}],"answer":"D","explanation":"电饭锅把电能主要转化为内能；电风扇主要转化为机械能。","verify":"\"电饭锅\""},{"id":"cnp_077_q4","topicId":"cnp_077","difficulty":"standard","type":"choice","prompt":"电流不变时，把电阻丝的通电时间增加到原来的 2 倍，产生的热量变为原来的多少倍？","choices":[{"key":"A","text":"2 倍"},{"key":"B","text":"4 倍"},{"key":"C","text":"1 倍"},{"key":"D","text":"0.5 倍"}],"answer":"A","explanation":"由 Q = I²Rt，热量与时间成正比。","verify":"\"2 倍\""}]
