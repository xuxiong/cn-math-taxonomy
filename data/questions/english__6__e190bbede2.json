[{"id":"cne_p155_q1","topicId":"cne_p155","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「医院」？","choices":[{"key":"A","text":"hospital"},{"key":"B","text":"cinema"},{"key":"C","text":"bookstore"},{"key":"D","text":"post office"}],"answer":"A","explanation":"hospital 的意思是医院。","verify":"\"hospital\""},{"id":"cne_p155_q2","topicId":"cne_p155","difficulty":"basic","type":"choice","prompt":"「cinema」的中文意思是哪一个？","choices":[{"key":"A","text":"医院"},{"key":"B","text":"电影院"},{"key":"C","text":"书店"},{"key":"D","text":"邮局"}],"answer":"B","explanation":"cinema 的意思是电影院。","verify":"\"电影院\""},{"id":"cne_p155_q3","topicId":"cne_p155","difficulty":"standard","type":"choice","prompt":"选择表示「书店」的单词。","choices":[{"key":"A","text":"hospital"},{"key":"B","text":"cinema"},{"key":"C","text":"bookstore"},{"key":"D","text":"post office"}],"answer":"C","explanation":"表示书店的单词是 bookstore。","verify":"\"bookstore\""},{"id":"cne_p155_q4","topicId":"cne_p155","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「邮局」？","choices":[{"key":"A","text":"hospital"},{"key":"B","text":"cinema"},{"key":"C","text":"bookstore"},{"key":"D","text":"post office"}],"answer":"D","explanation":"post office 的意思是邮局。","verify":"\"post office\""},{"id":"cne_p156_q1","topicId":"cne_p156","difficulty":"basic","type":"choice","prompt":"想说「在书店左转」，应选哪一句？","choices":[{"key":"A","text":"Turn right at the bookstore."},{"key":"B","text":"Turn left at the bookstore."},{"key":"C","text":"Go straight at the bookstore."},{"key":"D","text":"Turn bookstore left."}],"answer":"B","explanation":"左转是 Turn left。","verify":"\"Turn left at the bookstore.\""},{"id":"cne_p156_q2","topicId":"cne_p156","difficulty":"basic","type":"choice","prompt":"Where is the hospital? 这句是在问什么？","choices":[{"key":"A","text":"医院是谁的"},{"key":"B","text":"医院里有什么"},{"key":"C","text":"医院在哪里"},{"key":"D","text":"怎么去电影院"}],"answer":"C","explanation":"Where is 问地点。","verify":"\"医院在哪里\""},{"id":"cne_p156_q3","topicId":"cne_p156","difficulty":"standard","type":"choice","prompt":"Go straight. 这句是在说什么？","choices":[{"key":"A","text":"左转"},{"key":"B","text":"右转"},{"key":"C","text":"停下"},{"key":"D","text":"直行"}],"answer":"D","explanation":"Go straight 是直行。","verify":"\"直行\""},{"id":"cne_p156_q4","topicId":"cne_p156","difficulty":"standard","type":"choice","prompt":"Turn right at the cinema. 在电影院怎么走？","choices":[{"key":"A","text":"右转"},{"key":"B","text":"左转"},{"key":"C","text":"直行"},{"key":"D","text":"往回走"}],"answer":"A","explanation":"Turn right 是右转。","verify":"\"右转\""},{"id":"cne_p157_q1","topicId":"cne_p157","difficulty":"basic","type":"choice","prompt":"想问怎么去医院，应说哪一句？","choices":[{"key":"A","text":"Where is a turn left?"},{"key":"B","text":"What is the hospital like?"},{"key":"C","text":"How can I get to the hospital?"},{"key":"D","text":"When is the hospital?"}],"answer":"C","explanation":"问路说 How can I get to。","verify":"\"How can I get to the hospital?\""},{"id":"cne_p157_q2","topicId":"cne_p157","difficulty":"basic","type":"choice","prompt":"The bookstore is next to the cinema. 书店在哪里？","choices":[{"key":"A","text":"在医院里"},{"key":"B","text":"在邮局对面很远"},{"key":"C","text":"在学校里面"},{"key":"D","text":"在电影院旁边"}],"answer":"D","explanation":"next to the cinema 是在电影院旁边。","verify":"\"在电影院旁边\""},{"id":"cne_p157_q3","topicId":"cne_p157","difficulty":"standard","type":"choice","prompt":"Turn left at the post office. 在邮局怎样走？","choices":[{"key":"A","text":"左转"},{"key":"B","text":"右转"},{"key":"C","text":"直行"},{"key":"D","text":"停下"}],"answer":"A","explanation":"Turn left。","verify":"\"左转\""},{"id":"cne_p157_q4","topicId":"cne_p157","difficulty":"standard","type":"choice","prompt":"Is it far? 若很近，应回答哪一句？","choices":[{"key":"A","text":"Yes. It is far."},{"key":"B","text":"No. It is near."},{"key":"C","text":"Turn right."},{"key":"D","text":"Go to the hospital."}],"answer":"B","explanation":"近是 near，所以用 No。","verify":"\"No. It is near.\""},{"id":"cne_p158_q1","topicId":"cne_p158","difficulty":"basic","type":"choice","prompt":"读一读：Go straight. Turn left at the bookstore. The hospital is on the right. 在书店怎样走？","choices":[{"key":"A","text":"右转"},{"key":"B","text":"停下"},{"key":"C","text":"往回走"},{"key":"D","text":"左转"}],"answer":"D","explanation":"Turn left at the bookstore。","verify":"\"左转\""},{"id":"cne_p158_q2","topicId":"cne_p158","difficulty":"basic","type":"choice","prompt":"读一读：The cinema is next to the hospital. 电影院在哪里？","choices":[{"key":"A","text":"在医院旁边"},{"key":"B","text":"在书店里面"},{"key":"C","text":"在邮局里"},{"key":"D","text":"离医院很远"}],"answer":"A","explanation":"next to the hospital。","verify":"\"在医院旁边\""},{"id":"cne_p158_q3","topicId":"cne_p158","difficulty":"standard","type":"choice","prompt":"读一读：How can I get to the post office? Turn right at the cinema. 去邮局要在哪里右转？","choices":[{"key":"A","text":"在书店"},{"key":"B","text":"在电影院"},{"key":"C","text":"在医院"},{"key":"D","text":"在学校"}],"answer":"B","explanation":"Turn right at the cinema。","verify":"\"在电影院\""},{"id":"cne_p158_q4","topicId":"cne_p158","difficulty":"standard","type":"choice","prompt":"读一读：It is not far. Go straight and you can see it. 哪一句和短文一致？","choices":[{"key":"A","text":"很远，要左转。"},{"key":"B","text":"在书店左转。"},{"key":"C","text":"不远，直行就能看见。"},{"key":"D","text":"医院在右边。"}],"answer":"C","explanation":"not far，Go straight。","verify":"\"不远，直行就能看见。\""},{"id":"cne_p185_q1","topicId":"cne_p185","difficulty":"basic","type":"choice","prompt":"clean 的过去式是哪一个？","choices":[{"key":"A","text":"cleans"},{"key":"B","text":"cleaning"},{"key":"C","text":"cleaned"},{"key":"D","text":"clean"}],"answer":"C","explanation":"规则动词 clean 的过去式是 cleaned。","verify":"\"cleaned\""},{"id":"cne_p185_q2","topicId":"cne_p185","difficulty":"basic","type":"choice","prompt":"哪一句表示「我上周末打扫了房间」？","choices":[{"key":"A","text":"I clean my room last weekend."},{"key":"B","text":"I cleaning my room last weekend."},{"key":"C","text":"I cleans my room last weekend."},{"key":"D","text":"I cleaned my room last weekend."}],"answer":"D","explanation":"last weekend 要和过去式 cleaned 一起用。","verify":"\"I cleaned my room last weekend.\""},{"id":"cne_p185_q3","topicId":"cne_p185","difficulty":"standard","type":"choice","prompt":"watched 是哪个动词的过去式？","choices":[{"key":"A","text":"watch"},{"key":"B","text":"wash"},{"key":"C","text":"walk"},{"key":"D","text":"want"}],"answer":"A","explanation":"watched 来自 watch。","verify":"\"watch\""},{"id":"cne_p185_q4","topicId":"cne_p185","difficulty":"standard","type":"choice","prompt":"I stayed at home. 这句说的是什么时候的事？","choices":[{"key":"A","text":"正在发生的事"},{"key":"B","text":"已经发生的事"},{"key":"C","text":"将要做的事"},{"key":"D","text":"每天的习惯"}],"answer":"B","explanation":"stayed 是过去式。","verify":"\"已经发生的事\""},{"id":"cne_p186_q1","topicId":"cne_p186","difficulty":"basic","type":"choice","prompt":"____ you clean your room? 问过去的事，横线上应填哪个词？","choices":[{"key":"A","text":"Do"},{"key":"B","text":"Does"},{"key":"C","text":"Are"},{"key":"D","text":"Did"}],"answer":"D","explanation":"问过去用 Did。","verify":"\"Did\""},{"id":"cne_p186_q2","topicId":"cne_p186","difficulty":"basic","type":"choice","prompt":"Did you watch TV? 肯定回答应选哪一句？","choices":[{"key":"A","text":"Yes, I did."},{"key":"B","text":"Yes, I do."},{"key":"C","text":"Yes, I was."},{"key":"D","text":"Yes, I watched."}],"answer":"A","explanation":"Did 的肯定回答是 Yes, I did。","verify":"\"Yes, I did.\""},{"id":"cne_p186_q3","topicId":"cne_p186","difficulty":"standard","type":"choice","prompt":"哪一句是正确的？","choices":[{"key":"A","text":"Did he washed his clothes?"},{"key":"B","text":"Did he wash his clothes?"},{"key":"C","text":"Does he washed his clothes?"},{"key":"D","text":"Did he washes his clothes?"}],"answer":"B","explanation":"Did 后面用动词原形 wash。","verify":"\"Did he wash his clothes?\""},{"id":"cne_p186_q4","topicId":"cne_p186","difficulty":"standard","type":"choice","prompt":"I did not stay at home. 这句的意思是？","choices":[{"key":"A","text":"我待在家里"},{"key":"B","text":"我正待在家里"},{"key":"C","text":"我没有待在家里"},{"key":"D","text":"我将待在家里"}],"answer":"C","explanation":"did not stay 表示过去没有待着。","verify":"\"我没有待在家里\""},{"id":"cne_p189_q1","topicId":"cne_p189","difficulty":"basic","type":"choice","prompt":"go 的过去式是哪一个？","choices":[{"key":"A","text":"goed"},{"key":"B","text":"goes"},{"key":"C","text":"went"},{"key":"D","text":"going"}],"answer":"C","explanation":"go 的过去式是 went。","verify":"\"went\""},{"id":"cne_p189_q2","topicId":"cne_p189","difficulty":"basic","type":"choice","prompt":"see 的过去式是哪一个？","choices":[{"key":"A","text":"seed"},{"key":"B","text":"seen"},{"key":"C","text":"sees"},{"key":"D","text":"saw"}],"answer":"D","explanation":"see 的过去式是 saw。","verify":"\"saw\""},{"id":"cne_p189_q3","topicId":"cne_p189","difficulty":"standard","type":"choice","prompt":"哪一句是正确的？","choices":[{"key":"A","text":"I went to the park."},{"key":"B","text":"I goed to the park."},{"key":"C","text":"I go to the park yesterday."},{"key":"D","text":"I going to the park yesterday."}],"answer":"A","explanation":"过去去了某地说 went。","verify":"\"I went to the park.\""},{"id":"cne_p189_q4","topicId":"cne_p189","difficulty":"standard","type":"choice","prompt":"eat 的过去式是哪一个？","choices":[{"key":"A","text":"eated"},{"key":"B","text":"ate"},{"key":"C","text":"eats"},{"key":"D","text":"eating"}],"answer":"B","explanation":"eat 的过去式是 ate。","verify":"\"ate\""},{"id":"cne_p190_q1","topicId":"cne_p190","difficulty":"basic","type":"choice","prompt":"想问对方去了哪里，应说哪一句？","choices":[{"key":"A","text":"Where do you go?"},{"key":"B","text":"Where are you going?"},{"key":"C","text":"Where did you went?"},{"key":"D","text":"Where did you go?"}],"answer":"D","explanation":"问过去去向用 Where did you go?","verify":"\"Where did you go?\""},{"id":"cne_p190_q2","topicId":"cne_p190","difficulty":"basic","type":"choice","prompt":"I went to Xinjiang. 去了哪里？","choices":[{"key":"A","text":"新疆"},{"key":"B","text":"北京"},{"key":"C","text":"上海"},{"key":"D","text":"海南"}],"answer":"A","explanation":"Xinjiang 是新疆。","verify":"\"新疆\""},{"id":"cne_p190_q3","topicId":"cne_p190","difficulty":"standard","type":"choice","prompt":"What did you do there? 这句是在问什么？","choices":[{"key":"A","text":"你要去哪里"},{"key":"B","text":"你在那里做了什么"},{"key":"C","text":"你正在做什么"},{"key":"D","text":"你喜欢那里吗"}],"answer":"B","explanation":"did you do there 问过去在那里做的事。","verify":"\"你在那里做了什么\""},{"id":"cne_p190_q4","topicId":"cne_p190","difficulty":"standard","type":"choice","prompt":"I saw grapes and ate good food. 做了什么？","choices":[{"key":"A","text":"只去了公园"},{"key":"B","text":"洗了衣服"},{"key":"C","text":"看见了葡萄，还吃了好吃的"},{"key":"D","text":"看了电影"}],"answer":"C","explanation":"saw grapes and ate good food。","verify":"\"看见了葡萄，还吃了好吃的\""},{"id":"cne_p191_q1","topicId":"cne_p191","difficulty":"basic","type":"choice","prompt":"读一读：I went to Hainan. I saw the beach. 去了哪里？","choices":[{"key":"A","text":"海南"},{"key":"B","text":"新疆"},{"key":"C","text":"北京"},{"key":"D","text":"上海"}],"answer":"A","explanation":"went to Hainan。","verify":"\"海南\""},{"id":"cne_p191_q2","topicId":"cne_p191","difficulty":"basic","type":"choice","prompt":"读一读：We ate fresh food and took pictures. 哪一句和日记一致？","choices":[{"key":"A","text":"我们没有吃东西。"},{"key":"B","text":"我们吃了新鲜的食物，还拍了照片。"},{"key":"C","text":"我们去了学校。"},{"key":"D","text":"我们洗了衣服。"}],"answer":"B","explanation":"ate fresh food and took pictures。","verify":"\"我们吃了新鲜的食物，还拍了照片。\""},{"id":"cne_p191_q3","topicId":"cne_p191","difficulty":"standard","type":"choice","prompt":"读一读：Where did you go? I went to a forest. 去了什么地方？","choices":[{"key":"A","text":"一片海滩"},{"key":"B","text":"一家医院"},{"key":"C","text":"一片森林"},{"key":"D","text":"一家商店"}],"answer":"C","explanation":"a forest。","verify":"\"一片森林\""},{"id":"cne_p191_q4","topicId":"cne_p191","difficulty":"standard","type":"choice","prompt":"读一读：I saw a mule. It was interesting. 看见了什么？","choices":[{"key":"A","text":"一匹马"},{"key":"B","text":"一只猫"},{"key":"C","text":"一条狗"},{"key":"D","text":"一头骡子"}],"answer":"D","explanation":"a mule 是骡子。","verify":"\"一头骡子\""}]
