[{"id":"cnd_p013_q1","topicId":"cnd_p013","difficulty":"basic","type":"choice","prompt":"在图书馆应怎么做？","choices":[{"key":"A","text":"大声打电话"},{"key":"B","text":"追逐嬉戏"},{"key":"C","text":"轻声说话或保持安静"},{"key":"D","text":"把书摔得很响"}],"answer":"C","explanation":"安静场所要保持安静。","verify":"\"轻声说话或保持安静\""},{"id":"cnd_p013_q2","topicId":"cnd_p013","difficulty":"basic","type":"choice","prompt":"看电影时合适做法是？","choices":[{"key":"A","text":"一直讲解剧情"},{"key":"B","text":"把零食袋捏得很响"},{"key":"C","text":"站起来挡后面的人"},{"key":"D","text":"手机静音，不大声讲话"}],"answer":"D","explanation":"要顾及他人。","verify":"\"手机静音，不大声讲话\""},{"id":"cnd_p013_q3","topicId":"cnd_p013","difficulty":"standard","type":"choice","prompt":"家里有人休息，你应？","choices":[{"key":"A","text":"放轻脚步和声音"},{"key":"B","text":"电视开最大"},{"key":"C","text":"走廊踢球"},{"key":"D","text":"用力摔门"}],"answer":"A","explanation":"有人休息要安静。","verify":"\"放轻脚步和声音\""},{"id":"cnd_p013_q4","topicId":"cnd_p013","difficulty":"challenge","type":"choice","prompt":"公共场合为什么要小点儿声？","choices":[{"key":"A","text":"永远不能说话"},{"key":"B","text":"不影响他人学习和休息"},{"key":"C","text":"只是老师随便规定"},{"key":"D","text":"小声代表胆小"}],"answer":"B","explanation":"顾及他人是公共文明。","verify":"\"不影响他人学习和休息\""},{"id":"cnd_p014_q1","topicId":"cnd_p014","difficulty":"basic","type":"choice","prompt":"学校课桌椅属于？","choices":[{"key":"A","text":"谁先坐就是谁的"},{"key":"B","text":"可随便带回家"},{"key":"C","text":"坏了就可乱画"},{"key":"D","text":"公物，大家共同使用"}],"answer":"D","explanation":"课桌椅是公共财物。","verify":"\"公物，大家共同使用\""},{"id":"cnd_p014_q2","topicId":"cnd_p014","difficulty":"basic","type":"choice","prompt":"有人在课桌乱刻，应？","choices":[{"key":"A","text":"劝阻并告诉老师"},{"key":"B","text":"一起刻花"},{"key":"C","text":"装作没看见"},{"key":"D","text":"卸掉桌腿"}],"answer":"A","explanation":"要爱护公物。","verify":"\"劝阻并告诉老师\""},{"id":"cnd_p014_q3","topicId":"cnd_p014","difficulty":"standard","type":"choice","prompt":"借用班级跳绳用完应？","choices":[{"key":"A","text":"扔在角落"},{"key":"B","text":"放回原处"},{"key":"C","text":"带回家不还"},{"key":"D","text":"绕成死结扔掉"}],"answer":"B","explanation":"借用要归还。","verify":"\"放回原处\""},{"id":"cnd_p014_q4","topicId":"cnd_p014","difficulty":"challenge","type":"choice","prompt":"为什么爱护公物？","choices":[{"key":"A","text":"公物坏了与我无关"},{"key":"B","text":"只爱护私人物品"},{"key":"C","text":"公物服务大家，损坏影响所有人"},{"key":"D","text":"爱护公物只是口号"}],"answer":"C","explanation":"公物属于集体。","verify":"\"公物服务大家，损坏影响所有人\""},{"id":"cnd_p015_q1","topicId":"cnd_p015","difficulty":"basic","type":"choice","prompt":"零食包装袋应怎么处理？","choices":[{"key":"A","text":"扔进垃圾桶"},{"key":"B","text":"随手扔路边"},{"key":"C","text":"塞进绿化带"},{"key":"D","text":"扔进河里"}],"answer":"A","explanation":"垃圾进垃圾桶。","verify":"\"扔进垃圾桶\""},{"id":"cnd_p015_q2","topicId":"cnd_p015","difficulty":"basic","type":"choice","prompt":"公园找不到垃圾桶，较好做法？","choices":[{"key":"A","text":"扔草丛"},{"key":"B","text":"暂存自己袋中带走再扔"},{"key":"C","text":"埋土里"},{"key":"D","text":"扔给小动物"}],"answer":"B","explanation":"可暂存带走。","verify":"\"暂存自己袋中带走再扔\""},{"id":"cnd_p015_q3","topicId":"cnd_p015","difficulty":"standard","type":"choice","prompt":"看见地上有垃圾，可以？","choices":[{"key":"A","text":"再踩一脚"},{"key":"B","text":"踢得更远"},{"key":"C","text":"捡起来扔进垃圾桶"},{"key":"D","text":"只嘲笑别人自己不捡"}],"answer":"C","explanation":"人人动手环境更好。","verify":"\"捡起来扔进垃圾桶\""},{"id":"cnd_p015_q4","topicId":"cnd_p015","difficulty":"challenge","type":"choice","prompt":"垃圾分类的主要目的是？","choices":[{"key":"A","text":"让垃圾桶更好看"},{"key":"B","text":"为难小朋友"},{"key":"C","text":"没有实际作用"},{"key":"D","text":"便于回收利用，减少污染"}],"answer":"D","explanation":"分类有助回收和环保。","verify":"\"便于回收利用，减少污染\""},{"id":"cnd_p016_q1","topicId":"cnd_p016","difficulty":"basic","type":"choice","prompt":"打饭时人多，正确做法是？","choices":[{"key":"A","text":"从旁边挤到最前"},{"key":"B","text":"自觉排队，不插队"},{"key":"C","text":"让同学帮占好几个位置"},{"key":"D","text":"推开别人冲进去"}],"answer":"B","explanation":"公共场合要排队。","verify":"\"自觉排队，不插队\""},{"id":"cnd_p016_q2","topicId":"cnd_p016","difficulty":"basic","type":"choice","prompt":"排队时突然有急事，较好做法？","choices":[{"key":"A","text":"硬挤到最前面"},{"key":"B","text":"大吵大闹"},{"key":"C","text":"礼貌说明情况请大家谅解，或稍后办理"},{"key":"D","text":"把别人推开"}],"answer":"C","explanation":"有特殊情况要礼貌沟通。","verify":"\"礼貌说明情况请大家谅解，或稍后办理\""},{"id":"cnd_p016_q3","topicId":"cnd_p016","difficulty":"standard","type":"choice","prompt":"为什么要排好队？","choices":[{"key":"A","text":"排队浪费时间所以不该排"},{"key":"B","text":"力气大的应优先"},{"key":"C","text":"熟人可以随便插队"},{"key":"D","text":"秩序更好，大家更公平、更安全"}],"answer":"D","explanation":"排队体现公平和秩序。","verify":"\"秩序更好，大家更公平、更安全\""},{"id":"cnd_p016_q4","topicId":"cnd_p016","difficulty":"challenge","type":"choice","prompt":"上下楼梯人多时，应？","choices":[{"key":"A","text":"靠右走，依次上下，不推挤"},{"key":"B","text":"从左侧猛跑超越"},{"key":"C","text":"手拉手横排挡道"},{"key":"D","text":"从扶手上滑下去"}],"answer":"A","explanation":"楼梯防拥挤很重要。","verify":"\"靠右走，依次上下，不推挤\""}]
