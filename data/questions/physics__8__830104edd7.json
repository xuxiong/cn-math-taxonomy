[{"id":"cnp_021_q1","topicId":"cnp_021","difficulty":"basic","type":"choice","prompt":"照相机成的是什么像？","choices":[{"key":"A","text":"倒立、放大的实像"},{"key":"B","text":"正立、放大的虚像"},{"key":"C","text":"倒立、缩小的实像"},{"key":"D","text":"正立、缩小的虚像"}],"answer":"C","explanation":"照相机物距大于 2 倍焦距，成倒立、缩小的实像。","verify":"\"倒立、缩小的实像\""},{"id":"cnp_021_q2","topicId":"cnp_021","difficulty":"basic","type":"choice","prompt":"用放大镜看邮票时，看到的是什么像？","choices":[{"key":"A","text":"倒立、放大的实像"},{"key":"B","text":"正立、缩小的虚像"},{"key":"C","text":"正立、放大的虚像"},{"key":"D","text":"倒立、缩小的实像"}],"answer":"C","explanation":"物体在放大镜焦点以内时，成正立、放大的虚像。","verify":"\"正立、放大的虚像\""},{"id":"cnp_021_q3","topicId":"cnp_021","difficulty":"standard","type":"choice","prompt":"投影仪在屏幕上成的是什么像？","choices":[{"key":"A","text":"倒立、放大的实像"},{"key":"B","text":"正立、放大的虚像"},{"key":"C","text":"倒立、缩小的实像"},{"key":"D","text":"正立、放大的实像"}],"answer":"A","explanation":"投影仪物距在 1 倍和 2 倍焦距之间，成倒立、放大的实像，所以投影片要倒着放。","verify":"\"倒立、放大的实像\""},{"id":"cnp_021_q4","topicId":"cnp_021","difficulty":"standard","type":"choice","prompt":"实像和虚像最主要的区别是什么？","choices":[{"key":"A","text":"实像都是放大的"},{"key":"B","text":"虚像都是倒立的"},{"key":"C","text":"实像能用光屏承接，虚像不能"},{"key":"D","text":"实像只能用眼睛看到"}],"answer":"C","explanation":"实像由实际光线会聚而成，能在光屏上呈现；虚像不能。","verify":"\"实像能用光屏承接，虚像不能\""}]
