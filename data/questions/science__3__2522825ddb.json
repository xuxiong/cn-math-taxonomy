[{"id":"cns_p067_q1","topicId":"cns_p067","difficulty":"basic","type":"choice","prompt":"湿衣服晾干后，水到哪里去了？","choices":[{"key":"A","text":"变成水蒸气跑到空气中"},{"key":"B","text":"被衣服吃掉了"},{"key":"C","text":"流到地下"},{"key":"D","text":"变成冰"}],"answer":"A","explanation":"水蒸发成看不见的水蒸气。","verify":"\"变成水蒸气跑到空气中\""},{"id":"cns_p067_q2","topicId":"cns_p067","difficulty":"basic","type":"choice","prompt":"水蒸气是什么状态的水？","choices":[{"key":"A","text":"固态"},{"key":"B","text":"气态"},{"key":"C","text":"液态"},{"key":"D","text":"粉末"}],"answer":"B","explanation":"水蒸气是气体。","verify":"\"气态\""},{"id":"cns_p067_q3","topicId":"cns_p067","difficulty":"standard","type":"choice","prompt":"下面哪种情况湿衣服干得最快？","choices":[{"key":"A","text":"阴天，叠起来放"},{"key":"B","text":"放在箱子里"},{"key":"C","text":"晴天有风，把衣服展开晾"},{"key":"D","text":"晚上放在屋里不展开"}],"answer":"C","explanation":"温度高、有风、展开晾，蒸发最快。","verify":"\"晴天有风，把衣服展开晾\""},{"id":"cns_p067_q4","topicId":"cns_p067","difficulty":"challenge","type":"choice","prompt":"地上洒了两摊一样多的水，一摊扫开成大片，一摊不动，哪摊先干？","choices":[{"key":"A","text":"不动的那摊"},{"key":"B","text":"一样快"},{"key":"C","text":"都不会干"},{"key":"D","text":"扫开成大片的那摊"}],"answer":"D","explanation":"表面积越大，蒸发越快。","verify":"\"扫开成大片的那摊\""},{"id":"cns_p068_q1","topicId":"cns_p068","difficulty":"basic","type":"choice","prompt":"从冰箱拿出的冷饮瓶外壁出现小水珠，水珠从哪里来？","choices":[{"key":"A","text":"瓶里的饮料渗出来"},{"key":"B","text":"空气中的水蒸气遇冷凝结"},{"key":"C","text":"从天上掉下来"},{"key":"D","text":"瓶子自己出汗"}],"answer":"B","explanation":"空气中的水蒸气遇到冷的瓶壁变成小水珠。","verify":"\"空气中的水蒸气遇冷凝结\""},{"id":"cns_p068_q2","topicId":"cns_p068","difficulty":"basic","type":"choice","prompt":"水蒸气变成水的过程叫什么？","choices":[{"key":"A","text":"蒸发"},{"key":"B","text":"沸腾"},{"key":"C","text":"凝结"},{"key":"D","text":"溶解"}],"answer":"C","explanation":"气态变液态叫凝结。","verify":"\"凝结\""},{"id":"cns_p068_q3","topicId":"cns_p068","difficulty":"standard","type":"choice","prompt":"冬天，教室窗户玻璃的哪一面会出现小水珠？","choices":[{"key":"A","text":"外面"},{"key":"B","text":"两面都没有"},{"key":"C","text":"只有窗框上"},{"key":"D","text":"里面（室内一侧）"}],"answer":"D","explanation":"室内暖湿的水蒸气遇到冷玻璃凝结在内侧。","verify":"\"里面（室内一侧）\""},{"id":"cns_p068_q4","topicId":"cns_p068","difficulty":"challenge","type":"choice","prompt":"清晨草叶上的露珠是怎样形成的？","choices":[{"key":"A","text":"夜里空气中的水蒸气遇冷凝结"},{"key":"B","text":"是下雨留下的"},{"key":"C","text":"是草喝不下吐出来的"},{"key":"D","text":"是冰化的"}],"answer":"A","explanation":"夜晚气温降低，水蒸气凝结成露。","verify":"\"夜里空气中的水蒸气遇冷凝结\""},{"id":"cns_p070_q1","topicId":"cns_p070","difficulty":"basic","type":"choice","prompt":"在通常情况下，水沸腾时的温度约是多少？","choices":[{"key":"A","text":"0℃"},{"key":"B","text":"50℃"},{"key":"C","text":"37℃"},{"key":"D","text":"100℃"}],"answer":"D","explanation":"标准大气压下水的沸点是 100℃。","verify":"\"100℃\""},{"id":"cns_p070_q2","topicId":"cns_p070","difficulty":"basic","type":"choice","prompt":"水沸腾时会出现什么现象？","choices":[{"key":"A","text":"大量气泡上升到水面破裂"},{"key":"B","text":"水变成冰"},{"key":"C","text":"水变红"},{"key":"D","text":"什么都不发生"}],"answer":"A","explanation":"沸腾时内部大量产生气泡。","verify":"\"大量气泡上升到水面破裂\""},{"id":"cns_p070_q3","topicId":"cns_p070","difficulty":"standard","type":"choice","prompt":"水沸腾后继续加热，温度会怎样？","choices":[{"key":"A","text":"一直升高"},{"key":"B","text":"保持不变"},{"key":"C","text":"迅速下降"},{"key":"D","text":"变成 0℃"}],"answer":"B","explanation":"沸腾时继续吸热，但温度保持不变。","verify":"\"保持不变\""},{"id":"cns_p070_q4","topicId":"cns_p070","difficulty":"challenge","type":"choice","prompt":"壶嘴冒出的「白气」是什么？","choices":[{"key":"A","text":"水蒸气本身"},{"key":"B","text":"烟"},{"key":"C","text":"水蒸气遇冷凝结成的小水滴"},{"key":"D","text":"空气"}],"answer":"C","explanation":"水蒸气看不见，白气是凝结成的小水滴。","verify":"\"水蒸气遇冷凝结成的小水滴\""},{"id":"cns_p071_q1","topicId":"cns_p071","difficulty":"basic","type":"choice","prompt":"水在多少摄氏度开始结冰？","choices":[{"key":"A","text":"0℃"},{"key":"B","text":"100℃"},{"key":"C","text":"10℃"},{"key":"D","text":"37℃"}],"answer":"A","explanation":"水的凝固点是 0℃。","verify":"\"0℃\""},{"id":"cns_p071_q2","topicId":"cns_p071","difficulty":"basic","type":"choice","prompt":"水结成冰，是从什么状态变成什么状态？","choices":[{"key":"A","text":"从固态变成液态"},{"key":"B","text":"从液态变成固态"},{"key":"C","text":"从液态变成气态"},{"key":"D","text":"从气态变成液态"}],"answer":"B","explanation":"冰是固态的水。","verify":"\"从液态变成固态\""},{"id":"cns_p071_q3","topicId":"cns_p071","difficulty":"standard","type":"choice","prompt":"装满水的玻璃瓶放进冷冻室，可能发生什么？","choices":[{"key":"A","text":"瓶子变大"},{"key":"B","text":"水变少"},{"key":"C","text":"水结冰后体积变大，把瓶子撑破"},{"key":"D","text":"什么都不会发生"}],"answer":"C","explanation":"水结冰体积膨胀。","verify":"\"水结冰后体积变大，把瓶子撑破\""},{"id":"cns_p071_q4","topicId":"cns_p071","difficulty":"challenge","type":"choice","prompt":"冬天户外的水管为什么要包上保暖材料？","choices":[{"key":"A","text":"让水更凉"},{"key":"B","text":"为了好看"},{"key":"C","text":"让水流得更快"},{"key":"D","text":"防止管里的水结冰把水管冻裂"}],"answer":"D","explanation":"结冰膨胀会胀裂水管。","verify":"\"防止管里的水结冰把水管冻裂\""},{"id":"cns_p072_q1","topicId":"cns_p072","difficulty":"basic","type":"choice","prompt":"冰变成水的过程叫什么？","choices":[{"key":"A","text":"凝固"},{"key":"B","text":"熔化"},{"key":"C","text":"蒸发"},{"key":"D","text":"凝结"}],"answer":"B","explanation":"固态变液态叫熔化。","verify":"\"熔化\""},{"id":"cns_p072_q2","topicId":"cns_p072","difficulty":"basic","type":"choice","prompt":"要让冰块化得更快，可以怎么做？","choices":[{"key":"A","text":"放进冰箱冷冻室"},{"key":"B","text":"用棉被包起来"},{"key":"C","text":"放在温暖的地方"},{"key":"D","text":"放在阴凉处盖好"}],"answer":"C","explanation":"温度越高，冰熔化越快。","verify":"\"放在温暖的地方\""},{"id":"cns_p072_q3","topicId":"cns_p072","difficulty":"standard","type":"choice","prompt":"冰块熔化成水后，质量会怎样？","choices":[{"key":"A","text":"变大"},{"key":"B","text":"变小"},{"key":"C","text":"变成零"},{"key":"D","text":"不变"}],"answer":"D","explanation":"状态变了，物质的多少不变。","verify":"\"不变\""},{"id":"cns_p072_q4","topicId":"cns_p072","difficulty":"challenge","type":"choice","prompt":"冰棍用棉被包住，比不包时化得更快还是更慢？","choices":[{"key":"A","text":"更慢"},{"key":"B","text":"更快"},{"key":"C","text":"一样"},{"key":"D","text":"立刻化掉"}],"answer":"A","explanation":"棉被能阻挡外界的热传进来。","verify":"\"更慢\""},{"id":"cns_p073_q1","topicId":"cns_p073","difficulty":"basic","type":"choice","prompt":"在一杯水里不停加盐并搅拌，最后会怎样？","choices":[{"key":"A","text":"盐永远能溶解"},{"key":"B","text":"水变成盐"},{"key":"C","text":"盐溶解不了，沉在杯底"},{"key":"D","text":"水全没了"}],"answer":"C","explanation":"一定量的水溶解盐的量是有限的。","verify":"\"盐溶解不了，沉在杯底\""},{"id":"cns_p073_q2","topicId":"cns_p073","difficulty":"basic","type":"choice","prompt":"下面哪种物质能溶解在水中？","choices":[{"key":"A","text":"沙子"},{"key":"B","text":"面粉"},{"key":"C","text":"石子"},{"key":"D","text":"食盐"}],"answer":"D","explanation":"食盐能溶于水。","verify":"\"食盐\""},{"id":"cns_p073_q3","topicId":"cns_p073","difficulty":"standard","type":"choice","prompt":"比较盐和小苏打谁在水中溶解得多，水量应该怎样？","choices":[{"key":"A","text":"两杯水一样多"},{"key":"B","text":"一杯多一杯少"},{"key":"C","text":"随便"},{"key":"D","text":"一杯冷一杯热"}],"answer":"A","explanation":"只改变要研究的条件，其他保持相同。","verify":"\"两杯水一样多\""},{"id":"cns_p073_q4","topicId":"cns_p073","difficulty":"challenge","type":"choice","prompt":"50 毫升水大约能溶解 18 克盐，那么 100 毫升同温度的水大约能溶解多少？","choices":[{"key":"A","text":"约 18 克"},{"key":"B","text":"约 36 克"},{"key":"C","text":"约 9 克"},{"key":"D","text":"约 100 克"}],"answer":"B","explanation":"水量加倍，能溶解的盐大约也加倍。","verify":"\"约 36 克\""},{"id":"cns_p074_q1","topicId":"cns_p074","difficulty":"basic","type":"choice","prompt":"下面哪种方法能让糖溶解得更快？","choices":[{"key":"A","text":"盖上盖子"},{"key":"B","text":"放进冰箱"},{"key":"C","text":"静静不动"},{"key":"D","text":"用勺子搅拌"}],"answer":"D","explanation":"搅拌能加快溶解。","verify":"\"用勺子搅拌\""},{"id":"cns_p074_q2","topicId":"cns_p074","difficulty":"basic","type":"choice","prompt":"冰糖块和白砂糖，哪个在水里溶解得快？","choices":[{"key":"A","text":"白砂糖"},{"key":"B","text":"冰糖块"},{"key":"C","text":"一样快"},{"key":"D","text":"都不溶解"}],"answer":"A","explanation":"颗粒小，接触水的面积大，溶解快。","verify":"\"白砂糖\""},{"id":"cns_p074_q3","topicId":"cns_p074","difficulty":"standard","type":"choice","prompt":"一杯热水和一杯冷水里各放一块方糖，哪个先溶解完？","choices":[{"key":"A","text":"冷水里的"},{"key":"B","text":"热水里的"},{"key":"C","text":"同时"},{"key":"D","text":"都不会"}],"answer":"B","explanation":"温度高溶解快。","verify":"\"热水里的\""},{"id":"cns_p074_q4","topicId":"cns_p074","difficulty":"challenge","type":"choice","prompt":"研究「温度对溶解快慢的影响」，下面哪个设计公平？","choices":[{"key":"A","text":"一杯搅拌一杯不搅拌"},{"key":"B","text":"糖不一样大"},{"key":"C","text":"糖一样、水量一样、都不搅拌，只是水温不同"},{"key":"D","text":"水量不同"}],"answer":"C","explanation":"只改变水温，其他条件相同。","verify":"\"糖一样、水量一样、都不搅拌，只是水温不同\""},{"id":"cns_p075_q1","topicId":"cns_p075","difficulty":"basic","type":"choice","prompt":"把沙子和盐的混合物分开，第一步应该做什么？","choices":[{"key":"A","text":"倒入水中让盐溶解"},{"key":"B","text":"用磁铁吸"},{"key":"C","text":"用手挑"},{"key":"D","text":"放进冰箱"}],"answer":"A","explanation":"盐溶于水，沙子不溶，先溶解。","verify":"\"倒入水中让盐溶解\""},{"id":"cns_p075_q2","topicId":"cns_p075","difficulty":"basic","type":"choice","prompt":"用滤纸把沙子从盐水里分出来，这叫什么方法？","choices":[{"key":"A","text":"蒸发"},{"key":"B","text":"过滤"},{"key":"C","text":"沉淀"},{"key":"D","text":"熔化"}],"answer":"B","explanation":"过滤能把不溶的固体和液体分开。","verify":"\"过滤\""},{"id":"cns_p075_q3","topicId":"cns_p075","difficulty":"standard","type":"choice","prompt":"把过滤后的盐水加热，水蒸发掉后剩下什么？","choices":[{"key":"A","text":"沙子"},{"key":"B","text":"什么也没有"},{"key":"C","text":"盐"},{"key":"D","text":"糖"}],"answer":"C","explanation":"蒸发掉水，盐留了下来。","verify":"\"盐\""},{"id":"cns_p075_q4","topicId":"cns_p075","difficulty":"challenge","type":"choice","prompt":"铁屑、沙子混在一起，最简单的分离方法是？","choices":[{"key":"A","text":"加水溶解"},{"key":"B","text":"加热蒸发"},{"key":"C","text":"用筛子"},{"key":"D","text":"用磁铁吸出铁屑"}],"answer":"D","explanation":"磁铁能吸铁，不能吸沙子。","verify":"\"用磁铁吸出铁屑\""}]
