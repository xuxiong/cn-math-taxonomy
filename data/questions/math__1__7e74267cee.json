[{"difficulty":"basic","type":"numeric","prompt":"9 的后面一个数是几？","answer":"10","explanation":"9 再添 1 是 10。","verify":"9+1","id":"cnm_p008_q1","topicId":"cnm_p008"},{"difficulty":"basic","type":"numeric","prompt":"8 的前面一个数是几？","answer":"7","explanation":"8 的前面是 7。","verify":"8-1","id":"cnm_p008_q2","topicId":"cnm_p008"},{"difficulty":"standard","type":"numeric","prompt":"10 是由几个一组成的？","answer":"10","explanation":"10 里面有 10 个一。","verify":"10","id":"cnm_p008_q3","topicId":"cnm_p008"},{"difficulty":"challenge","type":"numeric","prompt":"从 6 数到 10，6、7、8、9、10 一共有多少个数？","answer":"5","explanation":"6 到 10 把两头都算上，一共 5 个数。","verify":"10-6+1","id":"cnm_p008_q4","topicId":"cnm_p008"},{"difficulty":"basic","type":"choice","prompt":"比 7 大又比 9 小的数是几？","choices":[{"key":"A","text":"6"},{"key":"B","text":"7"},{"key":"C","text":"8"},{"key":"D","text":"9"}],"answer":"C","explanation":"8 在 7 和 9 中间。","verify":"'8'","id":"cnm_p009_q1","topicId":"cnm_p009"},{"difficulty":"basic","type":"numeric","prompt":"10 比 8 大几？","answer":"2","explanation":"10－8＝2，10 比 8 大 2。","verify":"10-8","id":"cnm_p009_q2","topicId":"cnm_p009"},{"difficulty":"standard","type":"numeric","prompt":"一串有 10 颗珠子，另一串有 6 颗。10 颗的比 6 颗的多几颗？","answer":"4","explanation":"比较两串的颗数：10－6＝4。","verify":"10-6","id":"cnm_p009_q3","topicId":"cnm_p009"},{"difficulty":"challenge","type":"numeric","prompt":"9、5、8、6 这四个数里，最小的是几？","answer":"5","explanation":"先看谁最靠前。5 比 6、8、9 都小。","verify":"5","id":"cnm_p009_q4","topicId":"cnm_p009"},{"difficulty":"basic","type":"numeric","prompt":"有 6 支铅笔，又放进 3 支。一共有几支？","answer":"9","explanation":"6＋3＝9（支）。","verify":"6+3","id":"cnm_p010_q1","topicId":"cnm_p010"},{"difficulty":"basic","type":"numeric","prompt":"7 个皮球，再拿来 2 个。一共有几个？","answer":"9","explanation":"7＋2＝9（个）。","verify":"7+2","id":"cnm_p010_q2","topicId":"cnm_p010"},{"difficulty":"standard","type":"numeric","prompt":"池塘里有 4 只鸭子，又游来 5 只。现在有几只？","answer":"9","explanation":"4＋5＝9（只）。","verify":"4+5","id":"cnm_p010_q3","topicId":"cnm_p010"},{"difficulty":"challenge","type":"numeric","prompt":"红花 4 朵、黄花 3 朵，旁边还有 5 片叶子。花一共有几朵？","answer":"7","explanation":"花是 4＋3＝7。叶子不是花。","verify":"4+3","id":"cnm_p010_q4","topicId":"cnm_p010"},{"difficulty":"basic","type":"numeric","prompt":"有 10 颗糖，拿走 3 颗。还剩几颗？","answer":"7","explanation":"10－3＝7（颗）。","verify":"10-3","id":"cnm_p011_q1","topicId":"cnm_p011"},{"difficulty":"basic","type":"numeric","prompt":"9 个气球飞走了 4 个。还剩几个？","answer":"5","explanation":"9－4＝5（个）。","verify":"9-4","id":"cnm_p011_q2","topicId":"cnm_p011"},{"difficulty":"standard","type":"numeric","prompt":"8 支笔，借出 2 支。还剩几支？","answer":"6","explanation":"8－2＝6（支）。","verify":"8-2","id":"cnm_p011_q3","topicId":"cnm_p011"},{"difficulty":"challenge","type":"numeric","prompt":"一共 10 个果子，其中梨有 3 个，其余都是苹果。苹果有几个？","answer":"7","explanation":"苹果是总数里去掉梨：10－3＝7。","verify":"10-3","id":"cnm_p011_q4","topicId":"cnm_p011"},{"difficulty":"basic","type":"numeric","prompt":"先有 2 只鸟，又飞来 3 只，再飞来 4 只。现在有几只？","answer":"9","explanation":"连加要从左往右：2＋3＝5，5＋4＝9。","verify":"2+3+4","id":"cnm_p012_q1","topicId":"cnm_p012"},{"difficulty":"basic","type":"numeric","prompt":"有 9 块饼干，吃了 2 块，又吃了 3 块。还剩几块？","answer":"4","explanation":"连减从左往右：9－2＝7，7－3＝4。","verify":"9-2-3","id":"cnm_p012_q2","topicId":"cnm_p012"},{"difficulty":"standard","type":"numeric","prompt":"树上先停 1 只鸟，又飞来 6 只，再飞来 2 只。现在有几只？","answer":"9","explanation":"1＋6＝7，7＋2＝9。","verify":"1+6+2","id":"cnm_p012_q3","topicId":"cnm_p012"},{"difficulty":"challenge","type":"numeric","prompt":"有 10 颗珠子，先拿走 2 颗，再拿走 3 颗，最后拿走 1 颗。还剩几颗？","answer":"4","explanation":"10－2＝8，8－3＝5，5－1＝4。","verify":"10-2-3-1","id":"cnm_p012_q4","topicId":"cnm_p012"},{"difficulty":"basic","type":"numeric","prompt":"有 5 支笔，又买来 3 支，送出 2 支。还剩几支？","answer":"6","explanation":"从左往右：5＋3＝8，8－2＝6。","verify":"5+3-2","id":"cnm_p013_q1","topicId":"cnm_p013"},{"difficulty":"basic","type":"numeric","prompt":"8 个苹果，吃了 3 个，又买来 2 个。现在有几个？","answer":"7","explanation":"8－3＝5，5＋2＝7。","verify":"8-3+2","id":"cnm_p013_q2","topicId":"cnm_p013"},{"dif