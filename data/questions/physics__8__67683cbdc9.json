[{"id":"cnp_008_q1","topicId":"cnp_008","difficulty":"basic","type":"choice","prompt":"声音的强弱等级用什么单位表示？","choices":[{"key":"A","text":"赫兹（Hz）"},{"key":"B","text":"米每秒（m/s）"},{"key":"C","text":"焦耳（J）"},{"key":"D","text":"分贝（dB）"}],"answer":"D","explanation":"人们用分贝来划分声音强弱的等级；赫兹是频率单位。","verify":"\"分贝（dB）\""},{"id":"cnp_008_q2","topicId":"cnp_008","difficulty":"basic","type":"choice","prompt":"在道路两旁植树，是在哪里减弱噪声？","choices":[{"key":"A","text":"传播过程中"},{"key":"B","text":"声源处"},{"key":"C","text":"人耳处"},{"key":"D","text":"以上都不是"}],"answer":"A","explanation":"树木能吸收、反射声音，在传播过程中减弱噪声。","verify":"\"传播过程中\""},{"id":"cnp_008_q3","topicId":"cnp_008","difficulty":"standard","type":"choice","prompt":"摩托车加装消声器，是在哪里控制噪声？","choices":[{"key":"A","text":"声源处"},{"key":"B","text":"传播过程中"},{"key":"C","text":"人耳处"},{"key":"D","text":"接收处"}],"answer":"A","explanation":"消声器直接减小摩托车排气发出的噪声，属于在声源处减弱。","verify":"\"声源处\""},{"id":"cnp_008_q4","topicId":"cnp_008","difficulty":"standard","type":"choice","prompt":"为保证休息和睡眠，声音不能超过多少分贝？","choices":[{"key":"A","text":"90 dB"},{"key":"B","text":"50 dB"},{"key":"C","text":"120 dB"},{"key":"D","text":"0 dB"}],"answer":"B","explanation":"为保证休息和睡眠，声音不能超过 50 dB；为保护听力不能超过 90 dB。0 dB 是人耳刚能听到的声音。","verify":"\"50 dB\""}]
