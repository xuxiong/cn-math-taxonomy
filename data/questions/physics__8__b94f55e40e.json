[{"id":"cnp_043_q1","topicId":"cnp_043","difficulty":"basic","type":"choice","prompt":"实心物体的密度小于液体密度时，放入液体中最终会怎样？","choices":[{"key":"A","text":"下沉"},{"key":"B","text":"悬浮"},{"key":"C","text":"漂浮"},{"key":"D","text":"沉底"}],"answer":"C","explanation":"ρ物 < ρ液 时上浮，最终漂浮；ρ物 = ρ液 时悬浮；ρ物 > ρ液 时下沉。","verify":"\"漂浮\""},{"id":"cnp_043_q2","topicId":"cnp_043","difficulty":"basic","type":"choice","prompt":"潜水艇是靠改变什么来实现上浮和下沉的？","choices":[{"key":"A","text":"受到的浮力"},{"key":"B","text":"海水的密度"},{"key":"C","text":"自身的重力"},{"key":"D","text":"自身的体积"}],"answer":"C","explanation":"潜水艇浸没时浮力不变，通过向水舱充水或排水改变自身重力。","verify":"\"自身的重力\""},{"id":"cnp_043_q3","topicId":"cnp_043","difficulty":"standard","type":"choice","prompt":"一艘轮船从长江驶入大海，它受到的浮力怎样变化？","choices":[{"key":"A","text":"变大"},{"key":"B","text":"不变"},{"key":"C","text":"变小"},{"key":"D","text":"无法判断"}],"answer":"B","explanation":"轮船始终漂浮，F浮 = G船，重力不变，浮力不变；海水密度大，船会上浮一些。","verify":"\"不变\""},{"id":"cnp_043_q4","topicId":"cnp_043","difficulty":"standard","type":"choice","prompt":"一个重 6 N 的木块漂浮在水面上，它受到的浮力是多少？","choices":[{"key":"A","text":"大于 6 N"},{"key":"B","text":"小于 6 N"},{"key":"C","text":"6 N"},{"key":"D","text":"0 N"}],"answer":"C","explanation":"漂浮时浮力等于重力，F浮 = 6 N。","verify":"6"}]
