[{"id":"cnc_p019_q1","topicId":"cnc_p019","difficulty":"basic","type":"choice","prompt":"「白」的韵母是哪一个？","choices":[{"key":"A","text":"复韵母 ai"},{"key":"B","text":"复韵母 ei"},{"key":"C","text":"复韵母 ao"},{"key":"D","text":"复韵母 ou"}],"answer":"A","explanation":"白的韵母是 ai。ei 是「杯」一类的韵母，ao 是「高」，ou 是「欧」。","verify":"\"复韵母 ai\""},{"id":"cnc_p019_q2","topicId":"cnc_p019","difficulty":"basic","type":"choice","prompt":"「高」的韵母是哪一个？","choices":[{"key":"A","text":"复韵母 ou"},{"key":"B","text":"复韵母 ao"},{"key":"C","text":"复韵母 ai"},{"key":"D","text":"复韵母 ei"}],"answer":"B","explanation":"高的韵母是 ao。欧的韵母才是 ou。","verify":"\"复韵母 ao\""},{"id":"cnc_p019_q3","topicId":"cnc_p019","difficulty":"standard","type":"choice","prompt":"「对」的韵母是哪一个？","choices":[{"key":"A","text":"复韵母 iu"},{"key":"B","text":"复韵母 ei"},{"key":"C","text":"复韵母 ui"},{"key":"D","text":"复韵母 ao"}],"answer":"C","explanation":"对是 duì，韵母是 ui。秋才是 iu，飞才是 ei。","verify":"\"复韵母 ui\""},{"id":"cnc_p019_q4","topicId":"cnc_p019","difficulty":"standard","type":"choice","prompt":"「秋」的韵母是哪一个？","choices":[{"key":"A","text":"复韵母 ui"},{"key":"B","text":"复韵母 ou"},{"key":"C","text":"复韵母 ai"},{"key":"D","text":"复韵母 iu"}],"answer":"D","explanation":"秋是 qiū，韵母是 iu。水的韵母才是 ui，狗的韵母才是 ou。","verify":"\"复韵母 iu\""},{"id":"cnc_p020_q1","topicId":"cnc_p020","difficulty":"basic","type":"choice","prompt":"「叶」的韵母是哪一个？","choices":[{"key":"A","text":"复韵母 ei"},{"key":"B","text":"复韵母 ie"},{"key":"C","text":"特殊韵母 er"},{"key":"D","text":"复韵母 üe"}],"answer":"B","explanation":"叶是 yè，韵母是 ie。飞的韵母才是 ei。","verify":"\"复韵母 ie\""},{"id":"cnc_p020_q2","topicId":"cnc_p020","difficulty":"basic","type":"choice","prompt":"「月」的韵母是哪一个？","choices":[{"key":"A","text":"复韵母 ie"},{"key":"B","text":"特殊韵母 er"},{"key":"C","text":"复韵母 üe"},{"key":"D","text":"复韵母 ei"}],"answer":"C","explanation":"月是 yuè，韵母是 üe。叶的韵母才是 ie。","verify":"\"复韵母 üe\""},{"id":"cnc_p020_q3","topicId":"cnc_p020","difficulty":"standard","type":"choice","prompt":"「耳」的韵母是哪一个？","choices":[{"key":"A","text":"复韵母 ie"},{"key":"B","text":"复韵母 ei"},{"key":"C","text":"前鼻韵母 en"},{"key":"D","text":"特殊韵母 er"}],"answer":"D","explanation":"耳是 ěr，韵母是 er。er 不和声母相拼，自己就是一个音节。","verify":"\"特殊韵母 er\""},{"id":"cnc_p020_q4","topicId":"cnc_p020","difficulty":"standard","type":"choice","prompt":"ie 和 ei 哪一个是「叶」的韵母？","choices":[{"key":"A","text":"ie（叶）"},{"key":"B","text":"ei（飞）"},{"key":"C","text":"er（耳）"},{"key":"D","text":"üe（月）"}],"answer":"A","explanation":"叶的韵母是 ie，先 i 后 e。飞才是先 e 后 i 的 ei。","verify":"\"ie（叶）\""},{"id":"cnc_p021_q1","topicId":"cnc_p021","difficulty":"basic","type":"choice","prompt":"「方」的韵母是哪一个？","choices":[{"key":"A","text":"前鼻韵母 an"},{"key":"B","text":"后鼻韵母 eng"},{"key":"C","text":"后鼻韵母 ang"},{"key":"D","text":"前鼻韵母 en"}],"answer":"C","explanation":"方是后鼻韵母 ang。an 是前鼻音，像「翻」的韵母。","verify":"\"后鼻韵母 ang\""},{"id":"cnc_p021_q2","topicId":"cnc_p021","difficulty":"basic","type":"choice","prompt":"「星」的韵母是哪一个？","choices":[{"key":"A","text":"前鼻韵母 in"},{"key":"B","text":"后鼻韵母 eng"},{"key":"C","text":"后鼻韵母 ang"},{"key":"D","text":"后鼻韵母 ing"}],"answer":"D","explanation":"星是后鼻韵母 ing。in 是前鼻音，像「音」，不要读成后鼻音 eng 或 ang。","verify":"\"后鼻韵母 ing\""},{"id":"cnc_p021_q3","topicId":"cnc_p021","difficulty":"standard","type":"choice","prompt":"「安」的韵母是哪一个？","choices":[{"key":"A","text":"前鼻韵母 an"},{"key":"B","text":"后鼻韵母 ang"},{"key":"C","text":"前鼻韵母 en"},{"key":"D","text":"后鼻韵母 eng"}],"answer":"A","explanation":"安是 ān，前鼻韵母 an。昂才是后鼻韵母 ang。","verify":"\"前鼻韵母 an\""},{"id":"cnc_p021_q4","topicId":"cnc_p021","difficulty":"standard","type":"choice","prompt":"「云」的韵母是哪一个？","choices":[{"key":"A","text":"后鼻韵母 ing"},{"key":"B","text":"前鼻韵母 ün"},{"key":"C","text":"后鼻韵母 eng"},{"key":"D","text":"前鼻韵母 an"}],"answer":"B","explanation":"云是 yún，韵母是 ün。英才是后鼻韵母 ing。","verify":"\"前鼻韵母 ün\""},{"id":"cnc_p022_q1","topicId":"cnc_p022","difficulty":"basic","type":"choice","prompt":"声母 b 和韵母 ā 拼出来，是哪个字的读音？","choices":[{"key":"A","text":"爸（bà，第四声）"},{"key":"B","text":"拔（bá，第二声）"},{"key":"C","text":"把（bǎ，第三声）"},{"key":"D","text":"八（bā，第一声）"}],"answer":"D","explanation":"b 加 ā 是第一声 bā，就是「八」。爸是第四声 bà。","verify":"\"八（bā，第一声）\""},{"id":"cnc_p022_q2","topicId":"cnc_p022","difficulty":"basic","type":"choice","prompt":"「鱼」写出来是哪一个？","choices":[{"key":"A","text":"yú（鱼，第二声）"},{"key":"B","text":"yū（第一声）"},{"key":"C","text":"yǔ（雨，第三声）"},{"key":"D","text":"yù（玉，第四声）"}],"answer":"A","explanation":"鱼是第二声 yú。雨是第三声 yǔ，玉是第四声 yù。","verify":"\"yú（鱼，第二声）\""},{"id":"cnc_p022_q3","topicId":"cnc_p022","difficulty":"standard","type":"choice","prompt":"j、q、x 和 ü 相拼时，ü 上的两点怎样？","choices":[{"key":"A","text":"两点保留，改读 u"},{"key":"B","text":"两点去掉，仍读 ü"},{"key":"C","text":"改读成 i"},{"key":"D","text":"改读成 e"}],"answer":"B","explanation":"ju、qu、xu 里面的 u 实际读 ü，写的时候去掉两点，不能读成乌的 u。","verify":"\"两点去掉，仍读 ü\""},{"id":"cnc_p022_q4","topicId":"cnc_p022","difficulty":"standard","type":"choice","prompt":"「门」的音节是哪一个？","choices":[{"key":"A","text":"mēn（第一声）"},{"key":"B","text":"méng（萌，后鼻音）"},{"key":"C","text":"mén（门，前鼻音）"},{"key":"D","text":"mèng（梦，后鼻音）"}],"answer":"C","explanation":"门是第二声 mén，韵母是前鼻音 en。méng、mèng 是后鼻音，不要读混。","verify":"\"mén（门，前鼻音）\""},{"id":"cnc_p023_q1","topicId":"cnc_p023","difficulty":"basic","type":"choice","prompt":"「高」gāo 的声调标在哪里？","choices":[{"key":"A","text":"标在 a 上"},{"key":"B","text":"标在 o 上"},{"key":"C","text":"标在 g 上"},{"key":"D","text":"这个音节不标声调"}],"answer":"A","explanation":"韵母 ao 里有 a，声调标在 a 上，所以是 gāo。","verify":"\"标在 a 上\""},{"id":"cnc_p023_q2","topicId":"cnc_p023","difficulty":"basic","type":"choice","prompt":"「飞」fēi 的声调标在哪里？","choices":[{"key":"A","text":"标在 i 上"},{"key":"B","text":"标在 e 上"},{"key":"C","text":"标在 f 上"},{"key":"D","text":"标在 a 上"}],"answer":"B","explanation":"飞的韵母是 ei，没有 a，有 e，声调标在 e 上。","verify":"\"标在 e 上\""},{"id":"cnc_p023_q3","topicId":"cnc_p023","difficulty":"standard","type":"choice","prompt":"「水」shuǐ 的韵母是 ui，声调标在哪里？","choices":[{"key":"A","text":"标在前面的 u 上"},{"key":"B","text":"标在 sh 上"},{"key":"C","text":"标在后面的 i 上"},{"key":"D","text":"标在 a 上"}],"answer":"C","explanation":"i 和 u 并列，声调标在后面一个。ui 的后面是 i，所以是 shuǐ。","verify":"\"标在后面的 i 上\""},{"id":"cnc_p023_q4","topicId":"cnc_p023","difficulty":"standard","type":"choice","prompt":"「鸟」niǎo 的声调标在哪里？","choices":[{"key":"A","text":"标在 i 上"},{"key":"B","text":"标在 o 上"},{"key":"C","text":"标在 n 上"},{"key":"D","text":"标在 a 上"}],"answer":"D","explanation":"鸟的韵母是 iao，有 a 就标在 a 上，不标在 i 或 o 上。","verify":"\"标在 a 上\""}]
