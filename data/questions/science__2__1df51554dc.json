[{"id":"cns_p031_q1","topicId":"cns_p031","difficulty":"basic","type":"choice","prompt":"小鸟的家通常叫什么？","choices":[{"key":"A","text":"鸟巢"},{"key":"B","text":"蜂巢"},{"key":"C","text":"洞穴"},{"key":"D","text":"蚁穴"}],"answer":"A","explanation":"鸟用树枝、草等搭鸟巢。","verify":"\"鸟巢\""},{"id":"cns_p031_q2","topicId":"cns_p031","difficulty":"basic","type":"choice","prompt":"蜜蜂的家叫什么？","choices":[{"key":"A","text":"鸟窝"},{"key":"B","text":"蜂巢"},{"key":"C","text":"树洞"},{"key":"D","text":"贝壳"}],"answer":"B","explanation":"蜜蜂住在由一个个六边形小格组成的蜂巢里。","verify":"\"蜂巢\""},{"id":"cns_p031_q3","topicId":"cns_p031","difficulty":"standard","type":"choice","prompt":"动物的家对动物有什么用？","choices":[{"key":"A","text":"只是为了好看"},{"key":"B","text":"用来装玩具"},{"key":"C","text":"遮风挡雨、躲避敌人、养育后代"},{"key":"D","text":"没有用"}],"answer":"C","explanation":"家能保护动物和它们的幼崽。","verify":"\"遮风挡雨、躲避敌人、养育后代\""},{"id":"cns_p031_q4","topicId":"cns_p031","difficulty":"challenge","type":"choice","prompt":"蜂巢的小格子是什么形状？","choices":[{"key":"A","text":"圆形"},{"key":"B","text":"三角形"},{"key":"C","text":"正方形"},{"key":"D","text":"六边形"}],"answer":"D","explanation":"蜂巢由许多六边形小格组成，既结实又省材料。","verify":"\"六边形\""},{"id":"cns_p032_q1","topicId":"cns_p032","difficulty":"basic","type":"choice","prompt":"房子上能挡雨的部分是哪里？","choices":[{"key":"A","text":"窗户"},{"key":"B","text":"屋顶"},{"key":"C","text":"地板"},{"key":"D","text":"门把手"}],"answer":"B","explanation":"屋顶在最上面，能挡雨挡雪。","verify":"\"屋顶\""},{"id":"cns_p032_q2","topicId":"cns_p032","difficulty":"basic","type":"choice","prompt":"窗户的主要作用是什么？","choices":[{"key":"A","text":"挡住所有光"},{"key":"B","text":"只为了装饰"},{"key":"C","text":"通风和采光"},{"key":"D","text":"用来走路"}],"answer":"C","explanation":"窗户让空气和阳光进入房间。","verify":"\"通风和采光\""},{"id":"cns_p032_q3","topicId":"cns_p032","difficulty":"standard","type":"choice","prompt":"房子的墙有什么作用？","choices":[{"key":"A","text":"让屋子漏雨"},{"key":"B","text":"只是为了画画"},{"key":"C","text":"让声音更大"},{"key":"D","text":"支撑屋顶、隔开房间"}],"answer":"D","explanation":"墙能承重、分隔空间、挡风。","verify":"\"支撑屋顶、隔开房间\""},{"id":"cns_p032_q4","topicId":"cns_p032","difficulty":"challenge","type":"choice","prompt":"多雨的地方，很多房子屋顶做成斜的，主要是为什么？","choices":[{"key":"A","text":"让雨水快快流下去"},{"key":"B","text":"为了晒被子"},{"key":"C","text":"为了让人站在上面"},{"key":"D","text":"为了更省钱"}],"answer":"A","explanation":"斜屋顶不积水，雨水能顺坡流走。","verify":"\"让雨水快快流下去\""},{"id":"cns_p033_q1","topicId":"cns_p033","difficulty":"basic","type":"choice","prompt":"菜刀的刀刃通常用什么材料做？","choices":[{"key":"A","text":"塑料"},{"key":"B","text":"纸"},{"key":"C","text":"钢铁"},{"key":"D","text":"布"}],"answer":"C","explanation":"钢铁硬，能做锋利的刀刃。","verify":"\"钢铁\""},{"id":"cns_p033_q2","topicId":"cns_p033","difficulty":"basic","type":"choice","prompt":"下面哪一样适合用来做窗帘？","choices":[{"key":"A","text":"铁板"},{"key":"B","text":"砖头"},{"key":"C","text":"玻璃"},{"key":"D","text":"布"}],"answer":"D","explanation":"布柔软、能挡光、可折叠。","verify":"\"布\""},{"id":"cns_p033_q3","topicId":"cns_p033","difficulty":"standard","type":"choice","prompt":"锅柄常用木头或塑料包着，主要是因为？","choices":[{"key":"A","text":"它们不容易烫手"},{"key":"B","text":"它们更重"},{"key":"C","text":"它们更亮"},{"key":"D","text":"它们会导电"}],"answer":"A","explanation":"木头、塑料传热慢，拿着不烫手。","verify":"\"它们不容易烫手\""},{"id":"cns_p033_q4","topicId":"cns_p033","difficulty":"challenge","type":"choice","prompt":"想做一个能看到窗外又能挡风的窗户，应选哪种材料？","choices":[{"key":"A","text":"木板"},{"key":"B","text":"透明玻璃"},{"key":"C","text":"厚布"},{"key":"D","text":"铁皮"}],"answer":"B","explanation":"玻璃透明能透光，又能挡风。","verify":"\"透明玻璃\""},{"id":"cns_p034_q1","topicId":"cns_p034","difficulty":"basic","type":"choice","prompt":"设计小房子时，第一步应该做什么？","choices":[{"key":"A","text":"马上开始剪纸"},{"key":"B","text":"先涂颜色"},{"key":"C","text":"先展示给大家"},{"key":"D","text":"想清楚房子要满足哪些要求"}],"answer":"D","explanation":"先明确要求，再画图、选材料。","verify":"\"想清楚房子要满足哪些要求\""},{"id":"cns_p034_q2","topicId":"cns_p034","difficulty":"basic","type":"choice","prompt":"画设计图有什么用？","choices":[{"key":"A","text":"让大家按图制作，少走弯路"},{"key":"B","text":"只是为了好看"},{"key":"C","text":"代替制作"},{"key":"D","text":"不需要设计图"}],"answer":"A","explanation":"设计图把想法画清楚，方便制作。","verify":"\"让大家按图制作，少走弯路\""},{"id":"cns_p034_q3","topicId":"cns_p034","difficulty":"standard","type":"choice","prompt":"小房子要能站得稳，墙最好用哪种材料？","choices":[{"key":"A","text":"薄面巾纸"},{"key":"B","text":"硬纸板"},{"key":"C","text":"棉花"},{"key":"D","text":"保鲜膜"}],"answer":"B","explanation":"硬纸板较硬，能立起来。","verify":"\"硬纸板\""},{"id":"cns_p034_q4","topicId":"cns_p034","difficulty":"challenge","type":"choice","prompt":"设计图上画了窗户，做好后却没有窗户，应该怎么办？","choices":[{"key":"A","text":"不管它"},{"key":"B","text":"把设计图撕掉"},{"key":"C","text":"对照设计图补做窗户"},{"key":"D","text":"改成画一个窗户贴上就算"}],"answer":"C","explanation":"制作要按设计图来，漏了要补上。","verify":"\"对照设计图补做窗户\""},{"id":"cns_p035_q1","topicId":"cns_p035","difficulty":"basic","type":"choice","prompt":"建造小房子时，使用剪刀要注意什么？","choices":[{"key":"A","text":"刀口不对着人"},{"key":"B","text":"拿着剪刀跑"},{"key":"C","text":"用剪刀玩耍"},{"key":"D","text":"把剪刀扔给同学"}],"answer":"A","explanation":"安全使用工具，刀口不对人。","verify":"\"刀口不对着人\""},{"id":"cns_p035_q2","topicId":"cns_p035","difficulty":"basic","type":"choice","prompt":"小组建造小房子时，最好的做法是？","choices":[{"key":"A","text":"一个人全做"},{"key":"B","text":"分工合作"},{"key":"C","text":"谁也不管"},{"key":"D","text":"抢材料"}],"answer":"B","explanation":"分工合作效率高。","verify":"\"分工合作\""},{"id":"cns_p035_q3","topicId":"cns_p035","difficulty":"standard","type":"choice","prompt":"小房子的墙一放上屋顶就倒了，可以怎样改进？","choices":[{"key":"A","text":"把屋顶做得更重"},{"key":"B","text":"去掉一面墙"},{"key":"C","text":"在墙角加三角形支撑"},{"key":"D","text":"不放屋顶"}],"answer":"C","explanation":"三角形结构稳固，能让墙更牢。","verify":"\"在墙角加三角形支撑\""},{"id":"cns_p035_q4","topicId":"cns_p035","difficulty":"challenge","type":"choice","prompt":"用胶带把两张纸板拼成直角墙角，下面哪种做法更牢？","choices":[{"key":"A","text":"只贴一小点"},{"key":"B","text":"不贴胶带直接靠"},{"key":"C","text":"用水粘"},{"key":"D","text":"里外两面都贴上胶带"}],"answer":"D","explanation":"两面都贴，接口更牢固。","verify":"\"里外两面都贴上胶带\""},{"id":"cns_p036_q1","topicId":"cns_p036","difficulty":"basic","type":"choice","prompt":"展示小房子时，应该介绍什么？","choices":[{"key":"A","text":"同学的缺点"},{"key":"B","text":"设计想法、材料和特点"},{"key":"C","text":"自己的零花钱"},{"key":"D","text":"天气"}],"answer":"B","explanation":"介绍设计、材料、特点，让大家了解作品。","verify":"\"设计想法、材料和特点\""},{"id":"cns_p036_q2","topicId":"cns_p036","difficulty":"basic","type":"choice","prompt":"评价别人的小房子，应该怎样说？","choices":[{"key":"A","text":"只说不好"},{"key":"B","text":"什么都不说"},{"key":"C","text":"先说优点，再提改进建议"},{"key":"D","text":"笑话别人"}],"answer":"C","explanation":"评价要友好、具体。","verify":"\"先说优点，再提改进建议\""},{"id":"cns_p036_q3","topicId":"cns_p036","difficulty":"standard","type":"choice","prompt":"一座小房子被风扇一吹就倒，说明它在哪方面需要改进？","choices":[{"key":"A","text":"颜色"},{"key":"B","text":"名字"},{"key":"C","text":"价钱"},{"key":"D","text":"稳固程度"}],"answer":"D","explanation":"被吹倒说明不够稳，需要加固。","verify":"\"稳固程度\""},{"id":"cns_p036_q4","topicId":"cns_p036","difficulty":"challenge","type":"choice","prompt":"展示会后，小组最应该做什么？","choices":[{"key":"A","text":"根据建议改进自己的小房子"},{"key":"B","text":"把房子扔掉"},{"key":"C","text":"不再理会"},{"key":"D","text":"只拍照"}],"answer":"A","explanation":"听取意见并改进是工程的一部分。","verify":"\"根据建议改进自己的小房子\""},{"id":"cns_p037_q1","topicId":"cns_p037","difficulty":"basic","type":"choice","prompt":"下面哪种形状的框架最不容易变形？","choices":[{"key":"A","text":"正方形"},{"key":"B","text":"长方形"},{"key":"C","text":"三角形"},{"key":"D","text":"圆形"}],"answer":"C","explanation":"三角形结构稳定，不易变形。","verify":"\"三角形\""},{"id":"cns_p037_q2","topicId":"cns_p037","difficulty":"basic","type":"choice","prompt":"铁架桥、电线塔上常看到哪种结构？","choices":[{"key":"A","text":"圆形"},{"key":"B","text":"五边形"},{"key":"C","text":"心形"},{"key":"D","text":"三角形"}],"answer":"D","explanation":"三角形结构稳固，常用于建筑和支架。","verify":"\"三角形\""},{"id":"cns_p037_q3","topicId":"cns_p037","difficulty":"standard","type":"choice","prompt":"用吸管做的正方形框架一推就歪，怎样最简单地让它变牢？","choices":[{"key":"A","text":"加一根对角线变成两个三角形"},{"key":"B","text":"再涂一层颜色"},{"key":"C","text":"换一种颜色的吸管"},{"key":"D","text":"把它放在桌上"}],"answer":"A","explanation":"加对角线后形成三角形，就不易变形。","verify":"\"加一根对角线变成两个三角形\""},{"id":"cns_p037_q4","topicId":"cns_p037","difficulty":"challenge","type":"choice","prompt":"搭纸塔时，底部宽、上部窄的塔为什么更稳？","choices":[{"key":"A","text":"它更好看"},{"key":"B","text":"底面大，上面轻，不容易倒"},{"key":"C","text":"它用的纸更少"},{"key":"D","text":"它更高"}],"answer":"B","explanation":"底面大、上轻下重的结构更稳。","verify":"\"底面大，上面轻，不容易倒\""}]
