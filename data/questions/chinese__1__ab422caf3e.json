[{"id":"cnc_p065_q1","topicId":"cnc_p065","difficulty":"basic","type":"choice","prompt":"「小娃撑小艇」的下一句是哪一句？","choices":[{"key":"A","text":"浮萍一道开"},{"key":"B","text":"不解藏踪迹"},{"key":"C","text":"偷采白莲回"},{"key":"D","text":"早有蜻蜓立上头"}],"answer":"C","explanation":"小娃撑着小船，偷偷采了白莲回去。浮萍一道开是最后一句。","verify":"\"偷采白莲回\""},{"id":"cnc_p065_q2","topicId":"cnc_p065","difficulty":"basic","type":"choice","prompt":"「不解藏踪迹」的下一句是哪一句？","choices":[{"key":"A","text":"偷采白莲回"},{"key":"B","text":"小娃撑小艇"},{"key":"C","text":"树阴照水爱晴柔"},{"key":"D","text":"浮萍一道开"}],"answer":"D","explanation":"小孩不知道隐藏踪迹，船过的地方浮萍分开一道。","verify":"\"浮萍一道开\""},{"id":"cnc_p065_q3","topicId":"cnc_p065","difficulty":"standard","type":"choice","prompt":"《池上》的作者是谁？","choices":[{"key":"A","text":"白居易"},{"key":"B","text":"杨万里"},{"key":"C","text":"李白"},{"key":"D","text":"骆宾王"}],"answer":"A","explanation":"《池上》是白居易的诗。《小池》才是杨万里写的。","verify":"\"白居易\""},{"id":"cnc_p065_q4","topicId":"cnc_p065","difficulty":"standard","type":"choice","prompt":"「浮萍一道开」说明了什么？","choices":[{"key":"A","text":"浮萍一朵也没有"},{"key":"B","text":"小船走过，浮萍分开一条痕迹"},{"key":"C","text":"小娃把踪迹藏好了"},{"key":"D","text":"池水全部干了"}],"answer":"B","explanation":"不解藏踪迹，所以水面上留下一道被船分开的浮萍。","verify":"\"小船走过，浮萍分开一条痕迹\""},{"id":"cnc_p066_q1","topicId":"cnc_p066","difficulty":"basic","type":"choice","prompt":"「泉眼无声惜细流」的下一句是哪一句？","choices":[{"key":"A","text":"小荷才露尖尖角"},{"key":"B","text":"早有蜻蜓立上头"},{"key":"C","text":"偷采白莲回"},{"key":"D","text":"树阴照水爱晴柔"}],"answer":"D","explanation":"先写泉眼和树阴，后两句才是小荷和蜻蜓。偷采白莲回是《池上》。","verify":"\"树阴照水爱晴柔\""},{"id":"cnc_p066_q2","topicId":"cnc_p066","difficulty":"basic","type":"choice","prompt":"「小荷才露尖尖角」的下一句是哪一句？","choices":[{"key":"A","text":"早有蜻蜓立上头"},{"key":"B","text":"树阴照水爱晴柔"},{"key":"C","text":"浮萍一道开"},{"key":"D","text":"早有蜻蜓立上头尖"}],"answer":"A","explanation":"小荷刚露出尖尖的角，蜻蜓早就站在上头了。","verify":"\"早有蜻蜓立上头\""},{"id":"cnc_p066_q3","topicId":"cnc_p066","difficulty":"standard","type":"choice","prompt":"《小池》的作者是谁？","choices":[{"key":"A","text":"白居易"},{"key":"B","text":"杨万里"},{"key":"C","text":"李白"},{"key":"D","text":"贺知章"}],"answer":"B","explanation":"《小池》是杨万里的诗。《池上》是白居易的，不要看名字里都有「池」就记混。","verify":"\"杨万里\""},{"id":"cnc_p066_q4","topicId":"cnc_p066","difficulty":"standard","type":"choice","prompt":"蜻蜓站在什么上面？","choices":[{"key":"A","text":"白莲船里"},{"key":"B","text":"浮萍开出的路上"},{"key":"C","text":"才露出尖角的小荷上"},{"key":"D","text":"泉眼旁边的大树上"}],"answer":"C","explanation":"小荷才露尖尖角，早有蜻蜓立上头。","verify":"\"才露出尖角的小荷上\""},{"id":"cnc_p067_q1","topicId":"cnc_p067","difficulty":"basic","type":"choice","prompt":"《浪花》里，「我」在哪里玩？","choices":[{"key":"A","text":"海边的沙滩上"},{"key":"B","text":"高山的雪地上"},{"key":"C","text":"教室的铅笔盒里"},{"key":"D","text":"端午节的龙舟上"}],"answer":"A","explanation":"小朋友走在沙滩上，浪花才跑到脚边来。","verify":"\"海边的沙滩上\""},{"id":"cnc_p067_q2","topicId":"cnc_p067","difficulty":"basic","type":"choice","prompt":"浪花跑到脚边，做了什么？","choices":[{"key":"A","text":"把脚丫咬破"},{"key":"B","text":"给小脚丫挠痒痒"},{"key":"C","text":"把小朋友拖进深海"},{"key":"D","text":"停住以后再也不动"}],"answer":"B","explanation":"浪花一下一下地挠，脚丫又麻又痒。它不是来伤害人的。","verify":"\"给小脚丫挠痒痒\""},{"id":"cnc_p067_q3","topicId":"cnc_p067","difficulty":"standard","type":"choice","prompt":"小朋友这时是什么感觉？","choices":[{"key":"A","text":"害怕得大哭"},{"key":"B","text":"生气得再也不笑"},{"key":"C","text":"又麻又痒，忍不住笑了"},{"key":"D","text":"以为浪花是怪物"}],"answer":"C","explanation":"挠痒痒让人想笑。课文写的是快乐，不是害怕。","verify":"\"又麻又痒，忍不住笑了\""},{"id":"cnc_p067_q4","topicId":"cnc_p067","difficulty":"standard","type":"choice","prompt":"浪花挠过以后怎样了？","choices":[{"key":"A","text":"永远停在脚上一整天"},{"key":"B","text":"变成一条小鱼住进铅笔盒"},{"key":"C","text":"把整片沙滩搬走了"},{"key":"D","text":"又笑着跑开了"}],"answer":"D","explanation":"浪花会再跑开，不是一直站在脚上，也不是怪物。","verify":"\"又笑着跑开了\""},{"id":"cnc_p068_q1","topicId":"cnc_p068","difficulty":"basic","type":"choice","prompt":"小水珠说，荷叶是自己的什么？","choices":[{"key":"A","text":"停机坪"},{"key":"B","text":"摇篮"},{"key":"C","text":"歌台"},{"key":"D","text":"凉伞"}],"answer":"B","explanation":"小水珠躺在荷叶上，说荷叶是我的摇篮。","verify":"\"摇篮\""},{"id":"cnc_p068_q2","topicId":"cnc_p068","difficulty":"basic","type":"choice","prompt":"谁把荷叶当成停机坪？","choices":[{"key":"A","text":"小水珠"},{"key":"B","text":"小青蛙"},{"key":"C","text":"小蜻蜓"},{"key":"D","text":"小鱼儿"}],"answer":"C","explanation":"小蜻蜓立在荷叶上，说荷叶是我的停机坪。","verify":"\"小蜻蜓\""},{"id":"cnc_p068_q3","topicId":"cnc_p068","difficulty":"standard","type":"choice","prompt":"小青蛙把荷叶当成什么？","choices":[{"key":"A","text":"摇篮"},{"key":"B","text":"凉伞"},{"key":"C","text":"小船"},{"key":"D","text":"歌台"}],"answer":"D","explanation":"小青蛙蹲在荷叶上放声歌唱，荷叶是它的歌台。","verify":"\"歌台\""},{"id":"cnc_p068_q4","topicId":"cnc_p068","difficulty":"standard","type":"choice","prompt":"小鱼儿说荷叶是自己的什么？","choices":[{"key":"A","text":"凉伞"},{"key":"B","text":"歌台"},{"key":"C","text":"停机坪"},{"key":"D","text":"摇篮"}],"answer":"A","explanation":"小鱼儿在荷叶下游来游去，说荷叶是我的凉伞。","verify":"\"凉伞\""},{"id":"cnc_p069_q1","topicId":"cnc_p069","difficulty":"basic","type":"choice","prompt":"燕子为什么飞得很低？","choices":[{"key":"A","text":"燕子的翅膀断了"},{"key":"B","text":"燕子在和小白兔比赛爬行"},{"key":"C","text":"要下雨了，虫子飞不高，燕子低飞捉虫"},{"key":"D","text":"天太干，燕子飞不起来"}],"answer":"C","explanation":"空气潮湿，虫子翅膀沾了小水珠，飞不高。燕子正忙着低飞捉虫。","verify":"\"要下雨了，虫子飞不高，燕子低飞捉虫\""},{"id":"cnc_p069_q2","topicId":"cnc_p069","difficulty":"basic","type":"choice","prompt":"小鱼为什么游到水面上来？","choices":[{"key":"A","text":"小鱼想晒太阳睡觉"},{"key":"B","text":"小鱼的尾巴被借走了"},{"key":"C","text":"池里的水已经干了"},{"key":"D","text":"水里闷，要上来透气，因为要下雨了"}],"answer":"D","explanation":"小鱼说水里闷得很，要到水面上透透气。这是要下雨的迹象。","verify":"\"水里闷，要上来透气，因为要下雨了\""},{"id":"cnc_p069_q3","topicId":"cnc_p069","difficulty":"standard","type":"choice","prompt":"蚂蚁在忙什么？","choices":[{"key":"A","text":"把东西往高处搬"},{"key":"B","text":"在低处挖坑接雨"},{"key":"C","text":"跟着兔子一起乱跑"},{"key":"D","text":"教小白兔游泳"}],"answer":"A","explanation":"蚂蚁知道要下雨，正把东西往高处搬，免得被雨淋湿。","verify":"\"把东西往高处搬\""},{"id":"cnc_p069_q4","topicId":"cnc_p069","difficulty":"standard","type":"choice","prompt":"小白兔跑回家告诉妈妈以后，发生了什么？","choices":[{"key":"A","text":"一整天都没有下雨"},{"key":"B","text":"大雨真的下起来了"},{"key":"C","text":"天上出了太阳，一滴雨也没有"},{"key":"D","text":"下的是一场大雪"}],"answer":"B","explanation":"他喊「妈妈，要下雨了」，哗哗哗，大雨真的下起来了。","verify":"\"大雨真的下起来了\""},{"id":"cnc_p070_q1","topicId":"cnc_p070","difficulty":"basic","type":"choice","prompt":"「一（ ）鱼」横线处最合适的是哪一个？","choices":[{"key":"A","text":"只"},{"key":"B","text":"朵"},{"key":"C","text":"头"},{"key":"D","text":"条"}],"answer":"D","explanation":"鱼常用「条」。青蛙常用「只」，花常用「朵」，牛常用「头」。","verify":"\"条\""},{"id":"cnc_p070_q2","topicId":"cnc_p070","difficulty":"basic","type":"choice","prompt":"「一（ ）花」横线处最合适的是哪一个？","choices":[{"key":"A","text":"朵"},{"key":"B","text":"条"},{"key":"C","text":"头"},{"key":"D","text":"群"}],"answer":"A","explanation":"花常用「朵」。条常用来数鱼，头常用来数牛。","verify":"\"朵\""},{"id":"cnc_p070_q3","topicId":"cnc_p070","difficulty":"standard","type":"choice","prompt":"「高高兴兴」是什么意思？","choices":[{"key":"A","text":"有一点高兴"},{"key":"B","text":"非常高兴"},{"key":"C","text":"不高兴"},{"key":"D","text":"又高又兴奋"}],"answer":"B","explanation":"AABB 的重叠表示程度加深，高高兴兴就是非常高兴。","verify":"\"非常高兴\""},{"id":"cnc_p070_q4","topicId":"cnc_p070","difficulty":"standard","type":"choice","prompt":"哪一个重叠词写对了？","choices":[{"key":"A","text":"快乐乐地唱歌"},{"key":"B","text":"快快乐地唱歌"},{"key":"C","text":"快快乐乐地唱歌"},{"key":"D","text":"乐乐快快地唱歌"}],"answer":"C","explanation":"快乐重叠成快快乐乐。不能少写一个字，也不能把顺序颠倒。","verify":"\"快快乐乐地唱歌\""}]
