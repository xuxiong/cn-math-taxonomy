[{"id":"cnm_h188_q1","topicId":"cnm_h188","difficulty":"basic","type":"choice","prompt":"双曲线定义比较的是动点到两焦点距离的什么？","choices":[{"key":"A","text":"和"},{"key":"B","text":"差的绝对值"},{"key":"C","text":"积"},{"key":"D","text":"商"}],"answer":"B","explanation":"双曲线是距离之差的绝对值为常数，椭圆才是距离之和为常数。","verify":"\"差的绝对值\""},{"id":"cnm_h188_q2","topicId":"cnm_h188","difficulty":"basic","type":"numeric","prompt":"双曲线上的点到两焦点距离之差的绝对值是 6。2a=6 时，a 是多少？","answer":"3","explanation":"这个常数是 2a，所以 a=3。","verify":"3"},{"id":"cnm_h188_q3","topicId":"cnm_h188","difficulty":"standard","type":"choice","prompt":"若距离之差的绝对值等于两焦点间的距离，轨迹是什么？","choices":[{"key":"A","text":"双曲线"},{"key":"B","text":"椭圆"},{"key":"C","text":"一个圆"},{"key":"D","text":"两条射线"}],"answer":"D","explanation":"差的绝对值等于焦距时，点落在两焦点连线的延长线上，是两条射线。","verify":"\"两条射线\""},{"id":"cnm_h188_q4","topicId":"cnm_h188","difficulty":"standard","type":"numeric","prompt":"a=4 的双曲线，定义中的常数是多少？","answer":"8","explanation":"常数是 2a=8。","verify":"2*4"},{"id":"cnm_h189_q1","topicId":"cnm_h189","difficulty":"basic","type":"numeric","prompt":"双曲线 x²/9−y²/16=1 中，a 等于多少？","answer":"3","explanation":"x² 下面是 a²=9，a=3。","verify":"isqrt(9)"},{"id":"cnm_h189_q2","topicId":"cnm_h189","difficulty":"basic","type":"numeric","prompt":"双曲线 x²/9−y²/16=1 中，b² 等于多少？","answer":"16","explanation":"y² 项的分母是 b²=16。","verify":"16"},{"id":"cnm_h189_q3","topicId":"cnm_h189","difficulty":"standard","type":"choice","prompt":"方程 x²/4−y²/9=1 表示什么曲线？","choices":[{"key":"A","text":"焦点在 x 轴上的双曲线"},{"key":"B","text":"椭圆"},{"key":"C","text":"焦点在 y 轴上的双曲线"},{"key":"D","text":"抛物线"}],"answer":"A","explanation":"两项相减并且等于 1，x² 在前面，焦点在 x 轴上。","verify":"\"焦点在 x 轴上的双曲线\""},{"id":"cnm_h189_q4","topicId":"cnm_h189","difficulty":"standard","type":"numeric","prompt":"a=5，b=12。标准方程里 a² 是多少？","answer":"25","explanation":"方程是 x²/25−y²/144=1。","verify":"25"},{"id":"cnm_h190_q1","topicId":"cnm_h190","difficulty":"basic","type":"numeric","prompt":"双曲线 a=3，b=4。c 等于多少？","answer":"5","explanation":"双曲线里 c²=a²+b²=9+16=25，c=5。","verify":"isqrt(9+16)"},{"id":"cnm_h190_q2","topicId":"cnm_h190","difficulty":"basic","type":"numeric","prompt":"双曲线 a=3，b=4。实轴长是多少？","answer":"6","explanation":"实轴长是 2a=6。","verify":"2*3"},{"id":"cnm_h190_q3","topicId":"cnm_h190","difficulty":"standard","type":"numeric","prompt":"双曲线 a=5，c=13。b² 等于多少？","answer":"144","explanation":"b²=c²−a²=169−25=144。","verify":"13*13-5*5"},{"id":"cnm_h190_q4","topicId":"cnm_h190","difficulty":"standard","type":"choice","prompt":"双曲线的离心率 c/a 与 1 的大小关系是？","choices":[{"key":"A","text":"大于 0 且小于 1"},{"key":"B","text":"等于 1"},{"key":"C","text":"大于 1"},{"key":"D","text":"小于 0"}],"answer":"C","explanation":"c²=a²+b²>a²，所以 c>a，离心率大于 1。","verify":"\"大于 1\""},{"id":"cnm_h191_q1","topicId":"cnm_h191","difficulty":"basic","type":"numeric","prompt":"双曲线 x²/9−y²/16=1 的一条渐近线斜率的绝对值是多少？","answer":"4/3","explanation":"b=4，a=3，斜率的绝对值是 b/a=4/3。","verify":"Fraction(4,3)"},{"id":"cnm_h191_q2","topicId":"cnm_h191","difficulty":"basic","type":"numeric","prompt":"a=5，b=5 的双曲线，渐近线斜率的绝对值是多少？","answer":"1","explanation":"b/a=1，渐近线是 y=x 和 y=−x。","verify":"Fraction(5,5)"},{"id":"cnm_h191_q3","topicId":"cnm_h191","difficulty":"standard","type":"choice","prompt":"双曲线 x²/a²−y²/b²=1 有几条渐近线？","choices":[{"key":"A","text":"1 条"},{"key":"B","text":"4 条"},{"key":"C","text":"2 条"},{"key":"D","text":"没有渐近线"}],"answer":"C","explanation":"两条直线 y=±(b/a)x。","verify":"\"2 条\""},{"id":"cnm_h191_q4","topicId":"cnm_h191","difficulty":"standard","type":"numeric","prompt":"渐近线为 y=±2x 的双曲线若 a=3，则 b 是多少？","answer":"6","explanation":"b/a=2，b=6。","verify":"6"}]
