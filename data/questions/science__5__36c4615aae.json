[{"id":"cns_p180_q1","topicId":"cns_p180","difficulty":"basic","type":"choice","prompt":"冰在常温下变成水，是因为它怎样？","choices":[{"key":"A","text":"放出了热量"},{"key":"B","text":"吸收了热量"},{"key":"C","text":"变重了"},{"key":"D","text":"被压扁了"}],"answer":"B","explanation":"熔化要吸热。","verify":"\"吸收了热量\""},{"id":"cns_p180_q2","topicId":"cns_p180","difficulty":"basic","type":"choice","prompt":"水变成冰时，是吸热还是放热？","choices":[{"key":"A","text":"吸热"},{"key":"B","text":"既不吸热也不放热"},{"key":"C","text":"放热"},{"key":"D","text":"先吸后放"}],"answer":"C","explanation":"凝固时放出热量。","verify":"\"放热\""},{"id":"cns_p180_q3","topicId":"cns_p180","difficulty":"standard","type":"choice","prompt":"水的三种状态是哪三种？","choices":[{"key":"A","text":"冷态、热态、温态"},{"key":"B","text":"大态、中态、小态"},{"key":"C","text":"透明态、白态、黑态"},{"key":"D","text":"固态、液态、气态"}],"answer":"D","explanation":"冰、水、水蒸气。","verify":"\"固态、液态、气态\""},{"id":"cns_p180_q4","topicId":"cns_p180","difficulty":"challenge","type":"choice","prompt":"冬天，窗玻璃内侧出现的美丽冰花，是什么直接变成固态形成的？","choices":[{"key":"A","text":"室内的水蒸气"},{"key":"B","text":"室外的雨"},{"key":"C","text":"玻璃里的水"},{"key":"D","text":"窗帘上的水"}],"answer":"A","explanation":"水蒸气遇到极冷的玻璃，直接凝华成冰晶。","verify":"\"室内的水蒸气\""},{"id":"cns_p181_q1","topicId":"cns_p181","difficulty":"basic","type":"choice","prompt":"游泳上岸后，风一吹觉得冷，原因是什么？","choices":[{"key":"A","text":"风本身是冰的"},{"key":"B","text":"水在放热"},{"key":"C","text":"身上的水蒸发时吸收热量"},{"key":"D","text":"身体变重了"}],"answer":"C","explanation":"蒸发吸热，使皮肤温度降低。","verify":"\"身上的水蒸发时吸收热量\""},{"id":"cns_p181_q2","topicId":"cns_p181","difficulty":"basic","type":"choice","prompt":"自然界中，云和雨的形成与什么过程有关？","choices":[{"key":"A","text":"风把海水吹到天上直接落下"},{"key":"B","text":"树木喷水"},{"key":"C","text":"岩石熔化"},{"key":"D","text":"水蒸发后在高空遇冷凝结"}],"answer":"D","explanation":"这是水循环的一部分。","verify":"\"水蒸发后在高空遇冷凝结\""},{"id":"cns_p181_q3","topicId":"cns_p181","difficulty":"standard","type":"choice","prompt":"水循环中，下面哪个环节是水从海洋到大气？","choices":[{"key":"A","text":"蒸发"},{"key":"B","text":"降水"},{"key":"C","text":"径流"},{"key":"D","text":"下渗"}],"answer":"A","explanation":"海水蒸发成水蒸气进入大气。","verify":"\"蒸发\""},{"id":"cns_p181_q4","topicId":"cns_p181","difficulty":"challenge","type":"choice","prompt":"医生给发烧的病人用酒精擦身体降温，利用了什么？","choices":[{"key":"A","text":"酒精燃烧放热"},{"key":"B","text":"酒精蒸发吸热"},{"key":"C","text":"酒精凝固"},{"key":"D","text":"酒精有颜色"}],"answer":"B","explanation":"酒精蒸发快，吸热降温。","verify":"\"酒精蒸发吸热\""},{"id":"cns_p182_q1","topicId":"cns_p182","difficulty":"basic","type":"choice","prompt":"把热水杯放进冷水盆里，热会怎样传递？","choices":[{"key":"A","text":"从冷水传到热水杯"},{"key":"B","text":"不传递"},{"key":"C","text":"两边同时变热"},{"key":"D","text":"从热水杯传到冷水中"}],"answer":"D","explanation":"热从高温物体传向低温物体。","verify":"\"从热水杯传到冷水中\""},{"id":"cns_p182_q2","topicId":"cns_p182","difficulty":"basic","type":"choice","prompt":"过一段时间后，热水和冷水的温度会怎样？","choices":[{"key":"A","text":"逐渐接近"},{"key":"B","text":"相差越来越大"},{"key":"C","text":"都变成 100℃"},{"key":"D","text":"都变成 0℃"}],"answer":"A","explanation":"热传递直到温度相同。","verify":"\"逐渐接近\""},{"id":"cns_p182_q3","topicId":"cns_p182","difficulty":"standard","type":"choice","prompt":"用手握住一个冰块，手会感到冷，这是因为什么？","choices":[{"key":"A","text":"冰把冷传给了手"},{"key":"B","text":"手上的热传给了冰块"},{"key":"C","text":"手变成了冰"},{"key":"D","text":"冰块在发热"}],"answer":"B","explanation":"热从手传给冰。","verify":"\"手上的热传给了冰块\""},{"id":"cns_p182_q4","topicId":"cns_p182","difficulty":"challenge","type":"choice","prompt":"把一勺 80℃ 的水倒入一大桶 20℃ 的水中，混合后的温度最可能是多少？","choices":[{"key":"A","text":"80℃"},{"key":"B","text":"100℃"},{"key":"C","text":"略高于 20℃"},{"key":"D","text":"低于 20℃"}],"answer":"C","explanation":"大量冷水吸收少量热水的热量，温度只升高一点。","verify":"\"略高于 20℃\""},{"id":"cns_p183_q1","topicId":"cns_p183","difficulty":"basic","type":"choice","prompt":"用酒精灯加热金属条的一端，涂在上面的蜡会怎样熔化？","choices":[{"key":"A","text":"从加热处向远处依次熔化"},{"key":"B","text":"从远处向加热处熔化"},{"key":"C","text":"同时全部熔化"},{"key":"D","text":"都不熔化"}],"answer":"A","explanation":"热从加热点向四周传递。","verify":"\"从加热处向远处依次熔化\""},{"id":"cns_p183_q2","topicId":"cns_p183","difficulty":"basic","type":"choice","prompt":"热通过直接接触从高温部分传到低温部分，叫什么？","choices":[{"key":"A","text":"热对流"},{"key":"B","text":"热传导"},{"key":"C","text":"热辐射"},{"key":"D","text":"蒸发"}],"answer":"B","explanation":"固体中主要靠热传导。","verify":"\"热传导\""},{"id":"cns_p183_q3","topicId":"cns_p183","difficulty":"standard","type":"choice","prompt":"加热一块金属圆片的中心，热会怎样传递？","choices":[{"key":"A","text":"只向一个方向"},{"key":"B","text":"从边缘向中心"},{"key":"C","text":"从中心向四周传开"},{"key":"D","text":"不传"}],"answer":"C","explanation":"热向四周传递。","verify":"\"从中心向四周传开\""},{"id":"cns_p183_q4","topicId":"cns_p183","difficulty":"challenge","type":"choice","prompt":"铁锅的手柄常用木头或塑料做，是为了什么？","choices":[{"key":"A","text":"让锅更重"},{"key":"B","text":"让锅更快热"},{"key":"C","text":"为了导电"},{"key":"D","text":"它们导热慢，防止烫手"}],"answer":"D","explanation":"木头、塑料是热的不良导体。","verify":"\"它们导热慢，防止烫手\""},{"id":"cns_p184_q1","topicId":"cns_p184","difficulty":"basic","type":"choice","prompt":"加热试管底部的水，水的温度怎样变化？","choices":[{"key":"A","text":"只有底部热"},{"key":"B","text":"热水上升，冷水下降，整管水都变热"},{"key":"C","text":"只有上面热"},{"key":"D","text":"水不会变热"}],"answer":"B","explanation":"热水向上流、冷水向下流，形成对流。","verify":"\"热水上升，冷水下降，整管水都变热\""},{"id":"cns_p184_q2","topicId":"cns_p184","difficulty":"basic","type":"choice","prompt":"热在液体和气体中主要靠什么方式传递？","choices":[{"key":"A","text":"传导"},{"key":"B","text":"辐射"},{"key":"C","text":"对流"},{"key":"D","text":"反射"}],"answer":"C","explanation":"流动的液体、气体把热带走。","verify":"\"对流\""},{"id":"cns_p184_q3","topicId":"cns_p184","difficulty":"standard","type":"choice","prompt":"烧水时，为什么要从锅底加热，而不是从水面加热？","choices":[{"key":"A","text":"从上面加热更快"},{"key":"B","text":"锅底更好看"},{"key":"C","text":"没有区别"},{"key":"D","text":"底部加热能形成对流，整锅水都热起来"}],"answer":"D","explanation":"对流让热量在水中循环。","verify":"\"底部加热能形成对流，整锅水都热起来\""},{"id":"cns_p184_q4","topicId":"cns_p184","difficulty":"challenge","type":"choice","prompt":"暖气片通常装在房间的什么位置更合理？","choices":[{"key":"A","text":"靠近地面的低处"},{"key":"B","text":"天花板上"},{"key":"C","text":"门外"},{"key":"D","text":"窗户外面"}],"answer":"A","explanation":"热空气上升，从低处加热能形成对流。","verify":"\"靠近地面的低处\""},{"id":"cns_p185_q1","topicId":"cns_p185","difficulty":"basic","type":"choice","prompt":"金属、塑料、木头中，传热最快的是哪个？","choices":[{"key":"A","text":"塑料"},{"key":"B","text":"木头"},{"key":"C","text":"金属"},{"key":"D","text":"一样快"}],"answer":"C","explanation":"金属是热的良导体。","verify":"\"金属\""},{"id":"cns_p185_q2","topicId":"cns_p185","difficulty":"basic","type":"choice","prompt":"下面哪种材料是热的不良导体？","choices":[{"key":"A","text":"铜"},{"key":"B","text":"铝"},{"key":"C","text":"铁"},{"key":"D","text":"泡沫塑料"}],"answer":"D","explanation":"泡沫塑料传热慢，保温好。","verify":"\"泡沫塑料\""},{"id":"cns_p185_q3","topicId":"cns_p185","difficulty":"standard","type":"choice","prompt":"做保温杯时，杯子外面包一层棉布或泡沫，目的是什么？","choices":[{"key":"A","text":"减慢热量散失"},{"key":"B","text":"让水更快变凉"},{"key":"C","text":"让杯子更重"},{"key":"D","text":"为了好看"}],"answer":"A","explanation":"不良导体能阻止热传递。","verify":"\"减慢热量散失\""},{"id":"cns_p185_q4","topicId":"cns_p185","difficulty":"challenge","type":"choice","prompt":"测试两个自制保温杯哪个保温好，下面哪种做法公平？","choices":[{"key":"A","text":"一个装热水一个装冷水"},{"key":"B","text":"装同样多、同样温度的热水，同时间后测温"},{"key":"C","text":"装水量不同"},{"key":"D","text":"测温时间不同"}],"answer":"B","explanation":"其他条件相同，只比保温杯本身。","verify":"\"装同样多、同样温度的热水，同时间后测温\""}]
