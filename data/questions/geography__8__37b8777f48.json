[{"id":"cng_j046_q1","topicId":"cng_j046","difficulty":"basic","type":"choice","prompt":"我国四大地理区域是？","choices":[{"key":"A","text":"只有东部和西部"},{"key":"B","text":"七大洲的别称"},{"key":"C","text":"没有区域差异"},{"key":"D","text":"北方地区、南方地区、西北地区、青藏地区"}],"answer":"D","explanation":"综合自然和人文地理特征，划分为这四大区域。","verify":"\"北方地区、南方地区、西北地区、青藏地区\""},{"id":"cng_j046_q2","topicId":"cng_j046","difficulty":"basic","type":"choice","prompt":"北方地区和南方地区的分界线大致是？","choices":[{"key":"A","text":"秦岭—淮河一线"},{"key":"B","text":"长城"},{"key":"C","text":"黄河"},{"key":"D","text":"北回归线"}],"answer":"A","explanation":"该线与 1 月 0℃等温线、800 毫米年等降水量线大体一致。","verify":"\"秦岭—淮河一线\""},{"id":"cng_j046_q3","topicId":"cng_j046","difficulty":"standard","type":"choice","prompt":"西北地区与北方地区的分界，大致相当于？","choices":[{"key":"A","text":"赤道"},{"key":"B","text":"400 毫米年等降水量线"},{"key":"C","text":"南极圈"},{"key":"D","text":"海岸线"}],"answer":"B","explanation":"400 毫米等降水量线大致是季风区与非季风区、农耕区与畜牧区的界线。","verify":"\"400 毫米年等降水量线\""},{"id":"cng_j046_q4","topicId":"cng_j046","difficulty":"challenge","type":"choice","prompt":"青藏地区与其他地区的分界主要依据是？","choices":[{"key":"A","text":"经度完全相同"},{"key":"B","text":"人口数量完全相等"},{"key":"C","text":"地势第一级阶梯的边缘"},{"key":"D","text":"与地形无关的铁路"}],"answer":"C","explanation":"昆仑山—祁连山—横断山脉一线既是阶梯分界，也是青藏地区的边界。","verify":"\"地势第一级阶梯的边缘\""}]
