[{"id":"cnm_h014_q1","topicId":"cnm_h014","difficulty":"basic","type":"choice","prompt":"命题「所有实数的平方都大于或等于 0」的量词是？","choices":[{"key":"A","text":"存在量词"},{"key":"B","text":"没有量词"},{"key":"C","text":"既是全称又是存在"},{"key":"D","text":"全称量词"}],"answer":"D","explanation":"「所有」是全称量词。这个命题是真命题。","verify":"\"全称量词\""},{"id":"cnm_h014_q2","topicId":"cnm_h014","difficulty":"basic","type":"choice","prompt":"命题「存在一个实数，它的平方等于 −1」是？","choices":[{"key":"A","text":"假命题"},{"key":"B","text":"真命题"},{"key":"C","text":"全称命题而且为真"},{"key":"D","text":"无法判断"}],"answer":"A","explanation":"实数的平方不会是负数，所以不存在这样的实数，命题为假。","verify":"\"假命题\""},{"id":"cnm_h014_q3","topicId":"cnm_h014","difficulty":"standard","type":"numeric","prompt":"在集合 {1，2，3} 中，满足 x>2 的元素有几个？用来判断「存在 x>2」。","answer":"1","explanation":"只有 3 大于 2，有 1 个，所以「存在」成立。","verify":"len([3])"},{"id":"cnm_h014_q4","topicId":"cnm_h014","difficulty":"standard","type":"choice","prompt":"「有的直角三角形是等腰三角形」使用的量词是？","choices":[{"key":"A","text":"全称量词"},{"key":"B","text":"否定量词"},{"key":"C","text":"存在量词"},{"key":"D","text":"不含量词"}],"answer":"C","explanation":"「有的」表示至少存在一个，是存在量词。等腰直角三角形确实存在。","verify":"\"存在量词\""},{"id":"cnm_h015_q1","topicId":"cnm_h015","difficulty":"basic","type":"choice","prompt":"「所有实数都大于 0」的否定是？","choices":[{"key":"A","text":"存在一个实数不大于 0"},{"key":"B","text":"所有实数都不大于 0"},{"key":"C","text":"存在一个实数大于 0"},{"key":"D","text":"所有实数都小于 0"}],"answer":"A","explanation":"全称命题的否定是存在命题，而且把结论否定。不是把「所有」改成「所有都不」。","verify":"\"存在一个实数不大于 0\""},{"id":"cnm_h015_q2","topicId":"cnm_h015","difficulty":"basic","type":"choice","prompt":"「存在整数是偶数」的否定是？","choices":[{"key":"A","text":"存在整数不是偶数"},{"key":"B","text":"所有整数都不是偶数"},{"key":"C","text":"所有整数都是偶数"},{"key":"D","text":"不存在整数是奇数"}],"answer":"B","explanation":"存在命题的否定是全称命题，结论改为「不是偶数」。","verify":"\"所有整数都不是偶数\""},{"id":"cnm_h015_q3","topicId":"cnm_h015","difficulty":"standard","type":"numeric","prompt":"命题「1>0」为真时，把它的真值记为 1。它的否定的真值应记为多少？","answer":"0","explanation":"真命题的否定是假命题，真值记 0。","verify":"0"},{"id":"cnm_h015_q4","topicId":"cnm_h015","difficulty":"standard","type":"choice","prompt":"否定「存在 x∈R，使 x²<0」时，量词应变成？","choices":[{"key":"A","text":"仍是存在量词"},{"key":"B","text":"去掉量词"},{"key":"C","text":"变成两个存在量词"},{"key":"D","text":"全称量词"}],"answer":"D","explanation":"存在的否定是全称。原命题为假，它的否定「所有实数的平方都大于或等于 0」为真。","verify":"\"全称量词\""}]
