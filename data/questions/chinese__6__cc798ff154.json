[{"id":"cnc_p491_q1","topicId":"cnc_p491","difficulty":"basic","type":"choice","prompt":"「京口瓜洲一水间」的下一句是哪一句？","choices":[{"key":"A","text":"钟山只隔数重山"},{"key":"B","text":"春风又绿江南岸"},{"key":"C","text":"钟山只隔数重山外"},{"key":"D","text":"明月何时照我还"}],"answer":"A","explanation":"京口和瓜洲隔着一条江，钟山也不过隔着几重山。照我还是最后一句。","verify":"\"钟山只隔数重山\""},{"id":"cnc_p491_q2","topicId":"cnc_p491","difficulty":"basic","type":"choice","prompt":"「春风又绿江南岸」的下一句是哪一句？","choices":[{"key":"A","text":"明月何时照我归"},{"key":"B","text":"明月何时照我还"},{"key":"C","text":"春风又到江南岸"},{"key":"D","text":"两山排闼送青来"}],"answer":"B","explanation":"绿是吹绿。下句是照我还，不是照我归。又到、排闼都不是这首。","verify":"\"明月何时照我还\""},{"id":"cnc_p491_q3","topicId":"cnc_p491","difficulty":"standard","type":"choice","prompt":"这首诗的作者是谁？","choices":[{"key":"A","text":"杜甫"},{"key":"B","text":"叶绍翁"},{"key":"C","text":"王安石"},{"key":"D","text":"王维"}],"answer":"C","explanation":"泊船瓜洲是王安石的。他在上册还有《书湖阴先生壁》，两首不要并成一首。","verify":"\"王安石\""},{"id":"cnc_p491_q4","topicId":"cnc_p491","difficulty":"standard","type":"choice","prompt":"「绿」在「春风又绿江南岸」里是什么意思？","choices":[{"key":"A","text":"绿色的名词，没有动作"},{"key":"B","text":"再来一次"},{"key":"C","text":"把山推开"},{"key":"D","text":"吹绿"}],"answer":"D","explanation":"春风使江南的岸又变绿了。绿在这里是动词。排闼送青是《书湖阴先生壁》。","verify":"\"吹绿\""},{"id":"cnc_p492_q1","topicId":"cnc_p492","difficulty":"basic","type":"choice","prompt":"「应怜屐齿印苍苔」的下一句是哪一句？","choices":[{"key":"A","text":"春色满园关不住"},{"key":"B","text":"小扣柴扉久不开"},{"key":"C","text":"小叩柴门久不开"},{"key":"D","text":"一枝红杏出墙来"}],"answer":"B","explanation":"大概是爱惜地上的苍苔，所以柴门敲了很久也不开。诗中是小扣、柴扉，不是小叩、柴门。","verify":"\"小扣柴扉久不开\""},{"id":"cnc_p492_q2","topicId":"cnc_p492","difficulty":"basic","type":"choice","prompt":"「春色满园关不住」的下一句是哪一句？","choices":[{"key":"A","text":"一枝红杏出墙外"},{"key":"B","text":"小扣柴扉久不开"},{"key":"C","text":"一枝红杏出墙来"},{"key":"D","text":"一枝红杏出墙头"}],"answer":"C","explanation":"园门关得住，春色关不住，一枝红杏伸到墙外来。诗中是出墙来。","verify":"\"一枝红杏出墙来\""},{"id":"cnc_p492_q3","topicId":"cnc_p492","difficulty":"standard","type":"choice","prompt":"《游园不值》的作者是谁？","choices":[{"key":"A","text":"王安石"},{"key":"B","text":"杜甫"},{"key":"C","text":"叶绍翁的老师苏轼"},{"key":"D","text":"叶绍翁"}],"answer":"D","explanation":"这首是叶绍翁的。春风又绿是王安石，不要因为都写春天记成一个人。","verify":"\"叶绍翁\""},{"id":"cnc_p492_q4","topicId":"cnc_p492","difficulty":"standard","type":"choice","prompt":"「不值」在诗题里是什么意思？","choices":[{"key":"A","text":"没有遇到要访的人"},{"key":"B","text":"园子不值钱"},{"key":"C","text":"花开得不值一看"},{"key":"D","text":"主人不值得拜访"}],"answer":"A","explanation":"值是相遇。游园不值，就是来游园，却没遇见主人。","verify":"\"没有遇到要访的人\""},{"id":"cnc_p493_q1","topicId":"cnc_p493","difficulty":"basic","type":"choice","prompt":"「水是眼波横」的下一句是哪一句？","choices":[{"key":"A","text":"山是眉峰竖"},{"key":"B","text":"欲问行人去那边"},{"key":"C","text":"山是眉峰聚"},{"key":"D","text":"眉眼盈盈处"}],"answer":"C","explanation":"水像横着的眼波，山像聚着的眉峰。去那边是再后面的问句。","verify":"\"山是眉峰聚\""},{"id":"cnc_p493_q2","topicId":"cnc_p493","difficulty":"basic","type":"choice","prompt":"「欲问行人去那边」的下一句是哪一句？","choices":[{"key":"A","text":"眉眼盈盈处去"},{"key":"B","text":"才始送春归"},{"key":"C","text":"千万和春住"},{"key":"D","text":"眉眼盈盈处"}],"answer":"D","explanation":"要问行人去哪里，就是去山水相接、像眉眼那样的地方。不要在盈盈处后面加字。","verify":"\"眉眼盈盈处\""},{"id":"cnc_p493_q3","topicId":"cnc_p493","difficulty":"standard","type":"choice","prompt":"「若到江南赶上春」的下一句是哪一句？","choices":[{"key":"A","text":"千万和春住"},{"key":"B","text":"千万与春住"},{"key":"C","text":"又送君归去"},{"key":"D","text":"劝君更尽一杯酒"}],"answer":"A","explanation":"赶上了江南的春天，就千万和春天待在一起。更尽一杯酒是王维的诗。","verify":"\"千万和春住\""},{"id":"cnc_p493_q4","topicId":"cnc_p493","difficulty":"standard","type":"choice","prompt":"这首词的作者是谁？","choices":[{"key":"A","text":"王维"},{"key":"B","text":"王观"},{"key":"C","text":"辛弃疾"},{"key":"D","text":"苏轼"}],"answer":"B","explanation":"送鲍浩然去浙东的是王观。王维写的是《送元二使安西》，两首送别不要记成一个人。","verify":"\"王观\""}]
