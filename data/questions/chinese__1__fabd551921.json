[{"id":"cnc_p024_q1","topicId":"cnc_p024","difficulty":"basic","type":"choice","prompt":"《秋天》里，树叶变成了什么颜色，然后怎样了？","choices":[{"key":"A","text":"变红了，还长在树上"},{"key":"B","text":"变黄了，从树上落下来"},{"key":"C","text":"变绿了，越长越多"},{"key":"D","text":"变成白色，飞到天上"}],"answer":"B","explanation":"课文写天气凉了，树叶黄了，一片片叶子从树上落下来。","verify":"\"变黄了，从树上落下来\""},{"id":"cnc_p024_q2","topicId":"cnc_p024","difficulty":"basic","type":"choice","prompt":"大雁往哪个方向飞？","choices":[{"key":"A","text":"往北飞"},{"key":"B","text":"往东飞"},{"key":"C","text":"往南飞"},{"key":"D","text":"停在树上不过冬"}],"answer":"C","explanation":"天气凉了，一群大雁往南飞。","verify":"\"往南飞\""},{"id":"cnc_p024_q3","topicId":"cnc_p024","difficulty":"standard","type":"choice","prompt":"大雁排队，课文写到了哪两种样子？","choices":[{"key":"A","text":"「大」字和「小」字"},{"key":"B","text":"「口」字和「日」字"},{"key":"C","text":"圆圈和方块"},{"key":"D","text":"「人」字和「一」字"}],"answer":"D","explanation":"大雁一会儿排成个「人」字，一会儿排成个「一」字。","verify":"\"「人」字和「一」字\""},{"id":"cnc_p024_q4","topicId":"cnc_p024","difficulty":"standard","type":"choice","prompt":"课文里的天空是什么样的？","choices":[{"key":"A","text":"又蓝又高"},{"key":"B","text":"又灰又低"},{"key":"C","text":"布满乌云"},{"key":"D","text":"下起了大雪"}],"answer":"A","explanation":"课文说天空那么蓝，那么高。这是秋天的天空。","verify":"\"又蓝又高\""},{"id":"cnc_p025_q1","topicId":"cnc_p025","difficulty":"basic","type":"choice","prompt":"「鱼戏莲叶间」的下一句是哪一句？","choices":[{"key":"A","text":"鱼戏莲叶西"},{"key":"B","text":"鱼戏莲叶南"},{"key":"C","text":"鱼戏莲叶东"},{"key":"D","text":"鱼戏莲叶北"}],"answer":"C","explanation":"课文接着按东、西、南、北来写，紧跟着的是「鱼戏莲叶东」。","verify":"\"鱼戏莲叶东\""},{"id":"cnc_p025_q2","topicId":"cnc_p025","difficulty":"basic","type":"choice","prompt":"「鱼戏莲叶东」的下一句是哪一句？","choices":[{"key":"A","text":"鱼戏莲叶南"},{"key":"B","text":"鱼戏莲叶北"},{"key":"C","text":"鱼戏莲叶间"},{"key":"D","text":"鱼戏莲叶西"}],"answer":"D","explanation":"东的后面是西，然后才是南和北。「间」已经在前面出现过了。","verify":"\"鱼戏莲叶西\""},{"id":"cnc_p025_q3","topicId":"cnc_p025","difficulty":"standard","type":"choice","prompt":"「莲叶何田田」写的是什么？","choices":[{"key":"A","text":"荷叶长得又密又亮"},{"key":"B","text":"鱼儿很少"},{"key":"C","text":"江南没有荷叶"},{"key":"D","text":"小朋友在采菱"}],"answer":"A","explanation":"田田形容荷叶一片连着一片，又茂盛又好看。","verify":"\"荷叶长得又密又亮\""},{"id":"cnc_p025_q4","topicId":"cnc_p025","difficulty":"standard","type":"choice","prompt":"《江南》主要写人们在做什么？","choices":[{"key":"A","text":"在池塘里游泳"},{"key":"B","text":"采莲，看鱼在莲叶间游"},{"key":"C","text":"把荷叶全部摘光"},{"key":"D","text":"在岸上放风筝"}],"answer":"B","explanation":"开头就是「江南可采莲」。鱼在莲叶东、西、南、北游来游去。","verify":"\"采莲，看鱼在莲叶间游\""},{"id":"cnc_p026_q1","topicId":"cnc_p026","difficulty":"basic","type":"choice","prompt":"小鸡画的是什么？","choices":[{"key":"A","text":"梅花"},{"key":"B","text":"枫叶"},{"key":"C","text":"月牙"},{"key":"D","text":"竹叶"}],"answer":"D","explanation":"小鸡的脚印像竹叶。梅花是小狗画的。","verify":"\"竹叶\""},{"id":"cnc_p026_q2","topicId":"cnc_p026","difficulty":"basic","type":"choice","prompt":"谁画的是梅花？","choices":[{"key":"A","text":"小狗"},{"key":"B","text":"小鸡"},{"key":"C","text":"小鸭"},{"key":"D","text":"小马"}],"answer":"A","explanation":"小狗的脚印像梅花。小鸡画竹叶，小鸭画枫叶，小马画月牙。","verify":"\"小狗\""},{"id":"cnc_p026_q3","topicId":"cnc_p026","difficulty":"standard","type":"choice","prompt":"小鸭和小马各画了什么？","choices":[{"key":"A","text":"小鸭画月牙，小马画枫叶"},{"key":"B","text":"小鸭画枫叶，小马画月牙"},{"key":"C","text":"小鸭画梅花，小马画竹叶"},{"key":"D","text":"小鸭画竹叶，小马画梅花"}],"answer":"B","explanation":"课文是小鸭画枫叶，小马画月牙。不要把两样对换。","verify":"\"小鸭画枫叶，小马画月牙\""},{"id":"cnc_p026_q4","topicId":"cnc_p026","difficulty":"standard","type":"choice","prompt":"青蛙为什么没有参加？","choices":[{"key":"A","text":"他不会走路"},{"key":"B","text":"雪地里不许青蛙来"},{"key":"C","text":"他在洞里睡着了"},{"key":"D","text":"他把颜料用完了"}],"answer":"C","explanation":"课文问青蛙为什么没参加，回答是：他在洞里睡着啦。","verify":"\"他在洞里睡着了\""},{"id":"cnc_p027_q1","topicId":"cnc_p027","difficulty":"basic","type":"choice","prompt":"草芽尖尖，他对小鸟说自己是哪个季节？","choices":[{"key":"A","text":"春天"},{"key":"B","text":"夏天"},{"key":"C","text":"秋天"},{"key":"D","text":"冬天"}],"answer":"A","explanation":"草芽尖尖说：我是春天。荷叶才说自己是夏天。","verify":"\"春天\""},{"id":"cnc_p027_q2","topicId":"cnc_p027","difficulty":"basic","type":"choice","prompt":"谁说「我是夏天」？","choices":[{"key":"A","text":"草芽"},{"key":"B","text":"荷叶"},{"key":"C","text":"谷穗"},{"key":"D","text":"雪人"}],"answer":"B","explanation":"荷叶圆圆，他对青蛙说：我是夏天。","verify":"\"荷叶\""},{"id":"cnc_p027_q3","topicId":"cnc_p027","difficulty":"standard","type":"choice","prompt":"谷穗弯弯，说自己是哪个季节？","choices":[{"key":"A","text":"春天"},{"key":"B","text":"夏天"},{"key":"C","text":"秋天"},{"key":"D","text":"冬天"}],"answer":"C","explanation":"谷穗弯弯，鞠着躬说：我是秋天。雪人才说冬天。","verify":"\"秋天\""},{"id":"cnc_p027_q4","topicId":"cnc_p027","difficulty":"standard","type":"choice","prompt":"雪人怎样介绍自己？","choices":[{"key":"A","text":"尖着声音说「我是春天」"},{"key":"B","text":"对青蛙说「我是夏天」"},{"key":"C","text":"鞠着躬说「我是秋天」"},{"key":"D","text":"大肚子一挺，说「我就是冬天」"}],"answer":"D","explanation":"雪人大肚子一挺，顽皮地说：我就是冬天。鞠躬的是谷穗。","verify":"\"大肚子一挺，说「我就是冬天」\""},{"id":"cnc_p028_q1","topicId":"cnc_p028","difficulty":"basic","type":"choice","prompt":"哪一句把意思说完整了？","choices":[{"key":"A","text":"小鸭。"},{"key":"B","text":"小鸭在河里游泳。"},{"key":"C","text":"游泳。"},{"key":"D","text":"河里。"}],"answer":"B","explanation":"完整的句子要说出谁、在哪里、做什么。只说一个词还不完整。","verify":"\"小鸭在河里游泳。\""},{"id":"cnc_p028_q2","topicId":"cnc_p028","difficulty":"basic","type":"choice","prompt":"看图说话：小兔在草地上吃萝卜。哪一种说法最好？","choices":[{"key":"A","text":"小兔吃。"},{"key":"B","text":"草地。"},{"key":"C","text":"小兔在草地上吃萝卜。"},{"key":"D","text":"萝卜小兔草地。"}],"answer":"C","explanation":"先说谁，再说在哪里、做什么，别人一听就明白。","verify":"\"小兔在草地上吃萝卜。\""},{"id":"cnc_p028_q3","topicId":"cnc_p028","difficulty":"standard","type":"choice","prompt":"下面哪一句是完整的句子？","choices":[{"key":"A","text":"小鸟飞"},{"key":"B","text":"天上"},{"key":"C","text":"飞小鸟在"},{"key":"D","text":"小鸟在天上飞。"}],"answer":"D","explanation":"「小鸟在天上飞」有谁、有地方、有动作。","verify":"\"小鸟在天上飞。\""},{"id":"cnc_p028_q4","topicId":"cnc_p028","difficulty":"standard","type":"choice","prompt":"「月儿像小船」这样说，好在哪里？","choices":[{"key":"A","text":"说清了月儿像什么"},{"key":"B","text":"只写了一个「月」字"},{"key":"C","text":"没有写出月儿的样子"},{"key":"D","text":"把「船」换成了「车」"}],"answer":"A","explanation":"把谁、什么样、像什么说出来，句子才完整。","verify":"\"说清了月儿像什么\""}]
