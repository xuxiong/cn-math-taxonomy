[{"id":"cnp_051_q1","topicId":"cnp_051","difficulty":"basic","type":"choice","prompt":"旗杆顶部的滑轮是什么滑轮？它有什么作用？","choices":[{"key":"A","text":"动滑轮，省力"},{"key":"B","text":"定滑轮，改变力的方向"},{"key":"C","text":"定滑轮，省力"},{"key":"D","text":"动滑轮，改变力的方向"}],"answer":"B","explanation":"旗杆顶的滑轮不随旗移动，是定滑轮，能改变力的方向。","verify":"\"定滑轮，改变力的方向\""},{"id":"cnp_051_q2","topicId":"cnp_051","difficulty":"basic","type":"choice","prompt":"用一个动滑轮匀速提起重 100 N 的物体（不计滑轮重和摩擦），拉力是多少？","choices":[{"key":"A","text":"100 N"},{"key":"B","text":"200 N"},{"key":"C","text":"25 N"},{"key":"D","text":"50 N"}],"answer":"D","explanation":"动滑轮省一半力，F = G/2 = 50 N。","verify":"100/2"},{"id":"cnp_051_q3","topicId":"cnp_051","difficulty":"standard","type":"numeric","prompt":"用滑轮组提升重 240 N 的物体，承担物重的绳子有 3 段，动滑轮重 30 N（不计绳重和摩擦），拉力是多少 N？（只填数值）","answer":"90","explanation":"F = (G + G动)/n = (240 + 30) ÷ 3 = 90 N。","verify":"(240+30)/3"},{"id":"cnp_051_q4","topicId":"cnp_051","difficulty":"standard","type":"choice","prompt":"用承重绳子为 3 段的滑轮组把物体提高 2 m，绳子自由端要拉过多长？","choices":[{"key":"A","text":"2 m"},{"key":"B","text":"3 m"},{"key":"C","text":"0.67 m"},{"key":"D","text":"6 m"}],"answer":"D","explanation":"s = nh = 3 × 2 = 6 m，省力但费距离。","verify":"3*2"}]
