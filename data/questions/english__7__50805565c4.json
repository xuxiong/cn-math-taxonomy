[{"id":"cne_j027_q1","topicId":"cne_j027","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「香蕉」？","choices":[{"key":"A","text":"banana"},{"key":"B","text":"hamburger"},{"key":"C","text":"salad"},{"key":"D","text":"ice-cream"}],"answer":"A","explanation":"banana 的意思是香蕉。","verify":"\"banana\""},{"id":"cne_j027_q2","topicId":"cne_j027","difficulty":"basic","type":"choice","prompt":"「hamburger」的中文意思是哪一个？","choices":[{"key":"A","text":"香蕉"},{"key":"B","text":"汉堡包"},{"key":"C","text":"沙拉"},{"key":"D","text":"冰激凌"}],"answer":"B","explanation":"hamburger 的意思是汉堡包。","verify":"\"汉堡包\""},{"id":"cne_j027_q3","topicId":"cne_j027","difficulty":"standard","type":"choice","prompt":"选择表示「沙拉」的单词。","choices":[{"key":"A","text":"banana"},{"key":"B","text":"hamburger"},{"key":"C","text":"salad"},{"key":"D","text":"ice-cream"}],"answer":"C","explanation":"表示沙拉的单词是 salad。","verify":"\"salad\""},{"id":"cne_j027_q4","topicId":"cne_j027","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「冰激凌」？","choices":[{"key":"A","text":"banana"},{"key":"B","text":"hamburger"},{"key":"C","text":"salad"},{"key":"D","text":"ice-cream"}],"answer":"D","explanation":"ice-cream 的意思是冰激凌。","verify":"\"ice-cream\""},{"id":"cne_j028_q1","topicId":"cne_j028","difficulty":"basic","type":"choice","prompt":"banana 是可数名词。哪一句正确？","choices":[{"key":"A","text":"I like a bananas."},{"key":"B","text":"I like bananas."},{"key":"C","text":"I likes bananas."},{"key":"D","text":"I like an bananas."}],"answer":"B","explanation":"可数名词复数是 bananas。","verify":"\"I like bananas.\""},{"id":"cne_j028_q2","topicId":"cne_j028","difficulty":"basic","type":"choice","prompt":"milk 是不可数名词。哪一句正确？","choices":[{"key":"A","text":"I like a milk."},{"key":"B","text":"I like milks."},{"key":"C","text":"I like milk."},{"key":"D","text":"I like an milk."}],"answer":"C","explanation":"不可数名词不加 a，也不加 s。","verify":"\"I like milk.\""},{"id":"cne_j028_q3","topicId":"cne_j028","difficulty":"standard","type":"choice","prompt":"想要一些沙拉，哪一句正确？","choices":[{"key":"A","text":"I want a salads."},{"key":"B","text":"I want some salads the count."},{"key":"C","text":"I want an salad."},{"key":"D","text":"I want some salad."}],"answer":"D","explanation":"salad 在这里作不可数食物，用 some salad。","verify":"\"I want some salad.\""},{"id":"cne_j028_q4","topicId":"cne_j028","difficulty":"standard","type":"choice","prompt":"哪一个是不可数名词？","choices":[{"key":"A","text":"milk"},{"key":"B","text":"banana"},{"key":"C","text":"hamburger"},{"key":"D","text":"apple"}],"answer":"A","explanation":"milk 不可数；香蕉、汉堡和苹果可数。","verify":"\"milk\""},{"id":"cne_j030_q1","topicId":"cne_j030","difficulty":"basic","type":"choice","prompt":"想问对方喜不喜欢沙拉，哪一句合适？","choices":[{"key":"A","text":"Are you like salad?"},{"key":"B","text":"Does you like salad?"},{"key":"C","text":"Do you likes salad?"},{"key":"D","text":"Do you like salad?"}],"answer":"D","explanation":"you 用 Do you like。","verify":"\"Do you like salad?\""},{"id":"cne_j030_q2","topicId":"cne_j030","difficulty":"basic","type":"choice","prompt":"你喜欢香蕉，应怎么说？","choices":[{"key":"A","text":"I like bananas."},{"key":"B","text":"I likes bananas."},{"key":"C","text":"I like banana's."},{"key":"D","text":"I am like bananas."}],"answer":"A","explanation":"I like 加可数名词复数。","verify":"\"I like bananas.\""},{"id":"cne_j030_q3","topicId":"cne_j030","difficulty":"standard","type":"choice","prompt":"对方说 I don't like hamburgers. 这句话的意思是什么？","choices":[{"key":"A","text":"我有汉堡"},{"key":"B","text":"我不喜欢汉堡"},{"key":"C","text":"我正在吃汉堡"},{"key":"D","text":"汉堡在桌子上"}],"answer":"B","explanation":"don't like 表示不喜欢。","verify":"\"我不喜欢汉堡\""},{"id":"cne_j030_q4","topicId":"cne_j030","difficulty":"standard","type":"choice","prompt":"想建议一起吃冰激凌，哪一句合适？","choices":[{"key":"A","text":"Let's has some ice-cream."},{"key":"B","text":"Let have an ice-cream the."},{"key":"C","text":"Let's have some ice-cream."},{"key":"D","text":"Let's having ice-cream."}],"answer":"C","explanation":"Let's 后面用动词原形 have。","verify":"\"Let's have some ice-cream.\""},{"id":"cne_j031_q1","topicId":"cne_j031","difficulty":"basic","type":"choice","prompt":"Gina likes bananas and milk. She doesn't like hamburgers. Gina 喜欢汉堡吗？","choices":[{"key":"A","text":"不喜欢"},{"key":"B","text":"喜欢"},{"key":"C","text":"只在学校喜欢"},{"key":"D","text":"短文没说"}],"answer":"A","explanation":"She doesn't like hamburgers。","verify":"\"不喜欢\""},{"id":"cne_j031_q2","topicId":"cne_j031","difficulty":"basic","type":"choice","prompt":"Gina likes bananas and milk. She doesn't like hamburgers. 她喜欢喝什么？","choices":[{"key":"A","text":"沙拉"},{"key":"B","text":"牛奶"},{"key":"C","text":"汉堡"},{"key":"D","text":"茶"}],"answer":"B","explanation":"likes milk 是喜欢牛奶。","verify":"\"牛奶\""},{"id":"cne_j031_q3","topicId":"cne_j031","difficulty":"standard","type":"choice","prompt":"Tom likes salad. He doesn't like ice-cream. His sister likes ice-cream. 谁喜欢冰激凌？","choices":[{"key":"A","text":"Tom"},{"key":"B","text":"Gina"},{"key":"C","text":"Tom 的姐姐或妹妹"},{"key":"D","text":"Tom 的爸爸"}],"answer":"C","explanation":"His sister likes ice-cream。","verify":"\"Tom 的姐姐或妹妹\""},{"id":"cne_j031_q4","topicId":"cne_j031","difficulty":"standard","type":"choice","prompt":"Tom likes salad. He doesn't like ice-cream. 哪一句和短文一致？","choices":[{"key":"A","text":"Tom likes ice-cream."},{"key":"B","text":"Tom doesn't like salad."},{"key":"C","text":"Tom has no sister in this text and he likes hamburgers."},{"key":"D","text":"Tom likes salad."}],"answer":"D","explanation":"第一句就是 Tom likes salad。干扰项里后半句短文没有说到汉堡。","verify":"\"Tom likes salad.\""},{"id":"cne_j083_q1","topicId":"cne_j083","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「面条」？","choices":[{"key":"A","text":"noodle"},{"key":"B","text":"mutton"},{"key":"C","text":"cabbage"},{"key":"D","text":"dumpling"}],"answer":"A","explanation":"noodle 的意思是面条。","verify":"\"noodle\""},{"id":"cne_j083_q2","topicId":"cne_j083","difficulty":"basic","type":"choice","prompt":"「mutton」的中文意思是哪一个？","choices":[{"key":"A","text":"面条"},{"key":"B","text":"羊肉"},{"key":"C","text":"卷心菜"},{"key":"D","text":"饺子"}],"answer":"B","explanation":"mutton 的意思是羊肉。","verify":"\"羊肉\""},{"id":"cne_j083_q3","topicId":"cne_j083","difficulty":"standard","type":"choice","prompt":"选择表示「卷心菜」的单词。","choices":[{"key":"A","text":"noodle"},{"key":"B","text":"mutton"},{"key":"C","text":"cabbage"},{"key":"D","text":"dumpling"}],"answer":"C","explanation":"表示卷心菜的单词是 cabbage。","verify":"\"cabbage\""},{"id":"cne_j083_q4","topicId":"cne_j083","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「饺子」？","choices":[{"key":"A","text":"noodle"},{"key":"B","text":"mutton"},{"key":"C","text":"cabbage"},{"key":"D","text":"dumpling"}],"answer":"D","explanation":"dumpling 的意思是饺子。","verify":"\"dumpling\""},{"id":"cne_j084_q1","topicId":"cne_j084","difficulty":"basic","type":"choice","prompt":"我想要一碗牛肉面。哪一句正确？","choices":[{"key":"A","text":"I would like a bowl of beef noodle."},{"key":"B","text":"I would like a bowl of beef noodles."},{"key":"C","text":"I would like to a bowl of beef noodles."},{"key":"D","text":"I like would a bowl of beef noodles."}],"answer":"B","explanation":"would like 后面直接加名词；noodles 常用复数。","verify":"\"I would like a bowl of beef noodles.\""},{"id":"cne_j084_q2","topicId":"cne_j084","difficulty":"basic","type":"choice","prompt":"你想要什么？哪一句正确？","choices":[{"key":"A","text":"What would you like to?"},{"key":"B","text":"What do you would like?"},{"key":"C","text":"What would you like?"},{"key":"D","text":"What would you like it?"}],"answer":"C","explanation":"What would you like。","verify":"\"What would you like?\""},{"id":"cne_j084_q3","topicId":"cne_j084","difficulty":"standard","type":"choice","prompt":"疑问句里用 any 还是 some？哪一句正确？","choices":[{"key":"A","text":"Would you like any dumplings?"},{"key":"B","text":"Would you like some dumpling?"},{"key":"C","text":"Do you would like some dumplings?"},{"key":"D","text":"Would you like some dumplings?"}],"answer":"D","explanation":"would like 的问句表示邀请，仍常用 some。","verify":"\"Would you like some dumplings?\""},{"id":"cne_j084_q4","topicId":"cne_j084","difficulty":"standard","type":"choice","prompt":"She would like mutton cabbage dumplings. 她想要什么馅的饺子？","choices":[{"key":"A","text":"羊肉白菜"},{"key":"B","text":"牛肉"},{"key":"C","text":"只有卷心菜、没有肉"},{"key":"D","text":"鱼肉"}],"answer":"A","explanation":"mutton cabbage 是羊肉白菜。","verify":"\"羊肉白菜\""},{"id":"cne_j085_q1","topicId":"cne_j085","difficulty":"basic","type":"choice","prompt":"服务员问 May I take your order? 你想要面条，哪一句合适？","choices":[{"key":"A","text":"I like beef noodles every day."},{"key":"B","text":"I would like to beef noodles."},{"key":"C","text":"I'd like beef noodles, please."},{"key":"D","text":"I'd like beef noodle, please."}],"answer":"C","explanation":"点餐用 I'd like，noodles 用复数。","verify":"\"I'd like beef noodles, please.\""},{"id":"cne_j085_q2","topicId":"cne_j085","difficulty":"basic","type":"choice","prompt":"想问有哪些种类的饺子，哪一句合适？","choices":[{"key":"A","text":"What kind of dumplings would you like to?"},{"key":"B","text":"What kind dumplings you like?"},{"key":"C","text":"How kind of dumplings would you like?"},{"key":"D","text":"What kind of dumplings would you like?"}],"answer":"D","explanation":"What kind of 问哪一种。","verify":"\"What kind of dumplings would you like?\""},{"id":"cne_j085_q3","topicId":"cne_j085","difficulty":"standard","type":"choice","prompt":"Are there any vegetables in the soup? 这句在问什么？","choices":[{"key":"A","text":"汤里有蔬菜吗"},{"key":"B","text":"汤多少钱"},{"key":"C","text":"你想要汤吗"},{"key":"D","text":"汤是谁做的"}],"answer":"A","explanation":"Are there any 问是否有。","verify":"\"汤里有蔬菜吗\""},{"id":"cne_j085_q4","topicId":"cne_j085","difficulty":"standard","type":"choice","prompt":"A large bowl, please. 这句话的意思是什么？","choices":[{"key":"A","text":"请来一小碗"},{"key":"B","text":"请来一大碗"},{"key":"C","text":"不要碗"},{"key":"D","text":"碗在桌子底下"}],"answer":"B","explanation":"large bowl 是大碗。","verify":"\"请来一大碗\""},{"id":"cne_j086_q1","topicId":"cne_j086","difficulty":"basic","type":"choice","prompt":"Waiter: What would you like? Tom: I'd like a large bowl of mutton noodles. Tom 要什么面？","choices":[{"key":"A","text":"牛肉面"},{"key":"B","text":"白菜面"},{"key":"C","text":"鸡蛋面"},{"key":"D","text":"羊肉面"}],"answer":"D","explanation":"mutton noodles 是羊肉面。","verify":"\"羊肉面\""},{"id":"cne_j086_q2","topicId":"cne_j086","difficulty":"basic","type":"choice","prompt":"Waiter: What would you like? Tom: I'd like a large bowl of mutton noodles. 他要多大的碗？","choices":[{"key":"A","text":"大碗"},{"key":"B","text":"小碗"},{"key":"C","text":"中碗"},{"key":"D","text":"不要碗"}],"answer":"A","explanation":"a large bowl。","verify":"\"大碗\""},{"id":"cne_j086_q3","topicId":"cne_j086","difficulty":"standard","type":"choice","prompt":"Gina would like some cabbage dumplings. She would not like any meat. Gina 要肉吗？","choices":[{"key":"A","text":"要羊肉"},{"key":"B","text":"不要"},{"key":"C","text":"要牛肉"},{"key":"D","text":"短文没说"}],"answer":"B","explanation":"would not like any meat。","verify":"\"不要\""},{"id":"cne_j086_q4","topicId":"cne_j086","difficulty":"standard","type":"choice","prompt":"Gina would like some cabbage dumplings. 哪一句和短文一致？","choices":[{"key":"A","text":"Gina wants mutton dumplings."},{"key":"B","text":"Gina wants a bowl of soup only."},{"key":"C","text":"Gina wants cabbage dumplings."},{"key":"D","text":"Gina does not want dumplings."}],"answer":"C","explanation":"cabbage dumplings 是白菜饺子。","verify":"\"Gina wants cabbage dumplings.\""},{"id":"cne_j248_q1","topicId":"cne_j248","difficulty":"basic","type":"choice","prompt":"— Do you like apples or bananas? — ____","choices":[{"key":"A","text":"Yes, I do."},{"key":"B","text":"No, I don't."},{"key":"C","text":"Yes, I like."},{"key":"D","text":"I like bananas."}],"answer":"D","explanation":"选择疑问句不用 yes 或 no 回答。","verify":"\"I like bananas.\""},{"id":"cne_j248_q2","topicId":"cne_j248","difficulty":"basic","type":"choice","prompt":"用 or 连接，选出正确的选择疑问句。","choices":[{"key":"A","text":"Is it a carrot or a potato?"},{"key":"B","text":"Is it a carrot and a potato?"},{"key":"C","text":"It is a carrot or a potato?"},{"key":"D","text":"Is it a carrot but a potato?"}],"answer":"A","explanation":"or 连接两个选项，句子用疑问语序。","verify":"\"Is it a carrot or a potato?\""},{"id":"cne_j248_q3","topicId":"cne_j248","difficulty":"standard","type":"choice","prompt":"Which is healthier, fruit ____ candy?","choices":[{"key":"A","text":"but"},{"key":"B","text":"and"},{"key":"C","text":"so"},{"key":"D","text":"or"}],"answer":"D","explanation":"Which ..., A or B 问哪一个。","verify":"\"or\""},{"id":"cne_j248_q4","topicId":"cne_j248","difficulty":"standard","type":"choice","prompt":"Do you eat breakfast at home or at school? 这句问的是？","choices":[{"key":"A","text":"几点吃早饭"},{"key":"B","text":"早饭吃什么"},{"key":"C","text":"吃不吃早饭"},{"key":"D","text":"在哪里吃早饭"}],"answer":"D","explanation":"or 前后是两个地点。","verify":"\"在哪里吃早饭\""}]
