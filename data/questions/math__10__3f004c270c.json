[{"id":"cnm_h066_q1","topicId":"cnm_h066","difficulty":"basic","type":"numeric","prompt":"y=sin x 的最大值是多少？","answer":"1","explanation":"正弦的最大值为 1。","verify":"1"},{"id":"cnm_h066_q2","topicId":"cnm_h066","difficulty":"basic","type":"numeric","prompt":"y=sin x 的最小值是多少？","answer":"-1","explanation":"正弦的最小值为 −1。","verify":"-1"},{"id":"cnm_h066_q3","topicId":"cnm_h066","difficulty":"standard","type":"numeric","prompt":"y=sin x（x 为弧度）的最小正周期除以 π，结果是多少？","answer":"2","explanation":"最小正周期是 2π，除以 π 得 2。","verify":"2"},{"id":"cnm_h066_q4","topicId":"cnm_h066","difficulty":"standard","type":"choice","prompt":"y=sin x 的定义域是？","choices":[{"key":"A","text":"全体正数"},{"key":"B","text":"不等于 π/2 的实数"},{"key":"C","text":"全体实数"},{"key":"D","text":"0 到 π"}],"answer":"C","explanation":"任意实数都有正弦。正切才在 π/2 等处没有定义。","verify":"\"全体实数\""},{"id":"cnm_h067_q1","topicId":"cnm_h067","difficulty":"basic","type":"choice","prompt":"y=sin x 在 [−π/2，π/2] 上是？","choices":[{"key":"A","text":"增函数"},{"key":"B","text":"减函数"},{"key":"C","text":"先增后减"},{"key":"D","text":"先减后增"}],"answer":"A","explanation":"这一段从最小值 −1 升到最大值 1。","verify":"\"增函数\""},{"id":"cnm_h067_q2","topicId":"cnm_h067","difficulty":"basic","type":"numeric","prompt":"求 sin0°。","answer":"0","explanation":"0° 的终边在 x 轴正方向，纵坐标是 0。","verify":"sin(radians(0))"},{"id":"cnm_h067_q3","topicId":"cnm_h067","difficulty":"standard","type":"numeric","prompt":"求 sin(−90°)，也就是 −π/2 弧度的正弦。","answer":"-1","explanation":"正弦是奇函数，sin(−90°)=−sin90°=−1。","verify":"sin(radians(-90))"},{"id":"cnm_h067_q4","topicId":"cnm_h067","difficulty":"standard","type":"choice","prompt":"y=sin x 在 [π/2，3π/2] 上整体是？","choices":[{"key":"A","text":"增函数"},{"key":"B","text":"先减后增"},{"key":"C","text":"常函数"},{"key":"D","text":"减函数"}],"answer":"D","explanation":"这一段正弦从 1 减到 −1，余弦不为正，整个区间递减。","verify":"\"减函数\""},{"id":"cnm_h068_q1","topicId":"cnm_h068","difficulty":"basic","type":"numeric","prompt":"求 cos0°。","answer":"1","explanation":"单位圆交点 (1，0)，余弦是 1。","verify":"cos(radians(0))"},{"id":"cnm_h068_q2","topicId":"cnm_h068","difficulty":"basic","type":"numeric","prompt":"求 cos60°。","answer":"1/2","explanation":"cos60°=1/2。","verify":"cos(radians(60))"},{"id":"cnm_h068_q3","topicId":"cnm_h068","difficulty":"standard","type":"numeric","prompt":"求 cos180°。","answer":"-1","explanation":"交点 (−1，0)，余弦是 −1。","verify":"cos(radians(180))"},{"id":"cnm_h068_q4","topicId":"cnm_h068","difficulty":"standard","type":"choice","prompt":"y=cos x 的奇偶性是？","choices":[{"key":"A","text":"偶函数"},{"key":"B","text":"奇函数"},{"key":"C","text":"既奇又偶"},{"key":"D","text":"非奇非偶"}],"answer":"A","explanation":"cos(−x)=cos x，图象关于 y 轴对称。","verify":"\"偶函数\""},{"id":"cnm_h069_q1","topicId":"cnm_h069","difficulty":"basic","type":"numeric","prompt":"求 tan0°。","answer":"0","explanation":"sin0°=0，cos0°=1，正切是 0。","verify":"tan(radians(0))"},{"id":"cnm_h069_q2","topicId":"cnm_h069","difficulty":"basic","type":"numeric","prompt":"求 tan45°。","answer":"1","explanation":"sin45° 与 cos45° 相等，正切是 1。","verify":"tan(radians(45))"},{"id":"cnm_h069_q3","topicId":"cnm_h069","difficulty":"standard","type":"numeric","prompt":"在 0° 到 90° 之间，tan x=1 的角度数是多少？","answer":"45","explanation":"45° 的正切等于 1，这一范围内没有第二个解。","verify":"45"},{"id":"cnm_h069_q4","topicId":"cnm_h069","difficulty":"standard","type":"choice","prompt":"y=tan x 在 x=90° 处？","choices":[{"key":"A","text":"等于 0"},{"key":"B","text":"没有定义"},{"key":"C","text":"等于 1"},{"key":"D","text":"等于 −1"}],"answer":"B","explanation":"90° 的余弦是 0，正切的分母为 0，没有定义。","verify":"\"没有定义\""}]
