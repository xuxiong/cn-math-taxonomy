[{"id":"cns_p087_q1","topicId":"cns_p087","difficulty":"basic","type":"choice","prompt":"下面哪种动物身体里有脊椎骨？","choices":[{"key":"A","text":"鲫鱼"},{"key":"B","text":"蚯蚓"},{"key":"C","text":"蜗牛"},{"key":"D","text":"蝴蝶"}],"answer":"A","explanation":"鱼有脊椎；蚯蚓、蜗牛、蝴蝶没有。","verify":"\"鲫鱼\""},{"id":"cns_p087_q2","topicId":"cns_p087","difficulty":"basic","type":"choice","prompt":"下面哪种动物是哺乳动物？","choices":[{"key":"A","text":"鲨鱼"},{"key":"B","text":"鲸"},{"key":"C","text":"海龟"},{"key":"D","text":"企鹅"}],"answer":"B","explanation":"鲸胎生、哺乳，属于哺乳动物。","verify":"\"鲸\""},{"id":"cns_p087_q3","topicId":"cns_p087","difficulty":"standard","type":"choice","prompt":"身上有羽毛、卵生、大多会飞的动物是哪一类？","choices":[{"key":"A","text":"鱼类"},{"key":"B","text":"昆虫"},{"key":"C","text":"鸟类"},{"key":"D","text":"哺乳类"}],"answer":"C","explanation":"羽毛是鸟类的特征。","verify":"\"鸟类\""},{"id":"cns_p087_q4","topicId":"cns_p087","difficulty":"challenge","type":"choice","prompt":"蝙蝠会飞，为什么不是鸟类？","choices":[{"key":"A","text":"它不会飞"},{"key":"B","text":"它太小"},{"key":"C","text":"它喜欢晚上活动"},{"key":"D","text":"它胎生、用乳汁哺育幼崽，是哺乳动物"}],"answer":"D","explanation":"分类要看主要特征，不是看会不会飞。","verify":"\"它胎生、用乳汁哺育幼崽，是哺乳动物\""},{"id":"cns_p088_q1","topicId":"cns_p088","difficulty":"basic","type":"choice","prompt":"鸡的繁殖方式是什么？","choices":[{"key":"A","text":"胎生"},{"key":"B","text":"卵生"},{"key":"C","text":"分裂"},{"key":"D","text":"发芽"}],"answer":"B","explanation":"鸡下蛋，孵出小鸡，是卵生。","verify":"\"卵生\""},{"id":"cns_p088_q2","topicId":"cns_p088","difficulty":"basic","type":"choice","prompt":"下面哪种动物是胎生的？","choices":[{"key":"A","text":"青蛙"},{"key":"B","text":"蝴蝶"},{"key":"C","text":"狗"},{"key":"D","text":"鸭子"}],"answer":"C","explanation":"狗直接生出小狗，是胎生。","verify":"\"狗\""},{"id":"cns_p088_q3","topicId":"cns_p088","difficulty":"standard","type":"choice","prompt":"动物繁殖后代有什么意义？","choices":[{"key":"A","text":"让动物变小"},{"key":"B","text":"只是为了好玩"},{"key":"C","text":"让动物不吃东西"},{"key":"D","text":"让这种动物一代代延续下去"}],"answer":"D","explanation":"繁殖使物种得以延续。","verify":"\"让这种动物一代代延续下去\""},{"id":"cns_p088_q4","topicId":"cns_p088","difficulty":"challenge","type":"choice","prompt":"鸭嘴兽会下蛋，又用乳汁喂养幼崽，它的繁殖方式属于哪一种？","choices":[{"key":"A","text":"卵生"},{"key":"B","text":"胎生"},{"key":"C","text":"分裂生殖"},{"key":"D","text":"无法繁殖"}],"answer":"A","explanation":"鸭嘴兽产卵孵化，所以是卵生，但它也哺乳。","verify":"\"卵生\""},{"id":"cns_p089_q1","topicId":"cns_p089","difficulty":"basic","type":"choice","prompt":"蚕宝宝是从什么里孵出来的？","choices":[{"key":"A","text":"蛹"},{"key":"B","text":"茧壳外面的叶子"},{"key":"C","text":"蚕卵"},{"key":"D","text":"土里"}],"answer":"C","explanation":"蚕的一生从卵开始。","verify":"\"蚕卵\""},{"id":"cns_p089_q2","topicId":"cns_p089","difficulty":"basic","type":"choice","prompt":"蚕最喜欢吃什么？","choices":[{"key":"A","text":"青菜"},{"key":"B","text":"米饭"},{"key":"C","text":"树皮"},{"key":"D","text":"桑叶"}],"answer":"D","explanation":"家蚕吃桑叶。","verify":"\"桑叶\""},{"id":"cns_p089_q3","topicId":"cns_p089","difficulty":"standard","type":"choice","prompt":"蚕吐丝结茧后，在茧里变成了什么？","choices":[{"key":"A","text":"蛹"},{"key":"B","text":"卵"},{"key":"C","text":"蚂蚁"},{"key":"D","text":"蝴蝶"}],"answer":"A","explanation":"蚕在茧中化蛹。","verify":"\"蛹\""},{"id":"cns_p089_q4","topicId":"cns_p089","difficulty":"challenge","type":"choice","prompt":"蚕的一生按顺序经过哪几个阶段？","choices":[{"key":"A","text":"卵→蛹→幼虫→成虫"},{"key":"B","text":"卵→幼虫→蛹→成虫"},{"key":"C","text":"幼虫→卵→成虫→蛹"},{"key":"D","text":"蛹→卵→幼虫→成虫"}],"answer":"B","explanation":"蚕是完全变态发育。","verify":"\"卵→幼虫→蛹→成虫\""},{"id":"cns_p090_q1","topicId":"cns_p090","difficulty":"basic","type":"choice","prompt":"幼蚕长大要经过什么过程？","choices":[{"key":"A","text":"开花"},{"key":"B","text":"结果"},{"key":"C","text":"冬眠"},{"key":"D","text":"蜕皮"}],"answer":"D","explanation":"幼蚕要蜕几次皮才能长大。","verify":"\"蜕皮\""},{"id":"cns_p090_q2","topicId":"cns_p090","difficulty":"basic","type":"choice","prompt":"幼蚕一般蜕几次皮后开始吐丝结茧？","choices":[{"key":"A","text":"4 次"},{"key":"B","text":"1 次"},{"key":"C","text":"10 次"},{"key":"D","text":"不蜕皮"}],"answer":"A","explanation":"家蚕幼虫一般蜕 4 次皮。","verify":"\"4 次\""},{"id":"cns_p090_q3","topicId":"cns_p090","difficulty":"standard","type":"choice","prompt":"喂养幼蚕时，桑叶应该怎样？","choices":[{"key":"A","text":"湿淋淋的"},{"key":"B","text":"干净、没有水珠"},{"key":"C","text":"放了很多天发黄的"},{"key":"D","text":"洒上农药的"}],"answer":"B","explanation":"湿叶、坏叶会让蚕生病。","verify":"\"干净、没有水珠\""},{"id":"cns_p090_q4","topicId":"cns_p090","difficulty":"challenge","type":"choice","prompt":"连续测量一条蚕的体长：第 1 天 1 厘米，第 7 天 3 厘米，第 14 天 6 厘米。这说明什么？","choices":[{"key":"A","text":"蚕在变小"},{"key":"B","text":"蚕不会长"},{"key":"C","text":"蚕在不断长大"},{"key":"D","text":"测量错了"}],"answer":"C","explanation":"体长逐渐增加，说明蚕在生长。","verify":"\"蚕在不断长大\""},{"id":"cns_p091_q1","topicId":"cns_p091","difficulty":"basic","type":"choice","prompt":"从茧里钻出来的是什么？","choices":[{"key":"A","text":"蚕蛾"},{"key":"B","text":"蚕卵"},{"key":"C","text":"蝴蝶"},{"key":"D","text":"蜜蜂"}],"answer":"A","explanation":"蛹羽化成蚕蛾，从茧里钻出。","verify":"\"蚕蛾\""},{"id":"cns_p091_q2","topicId":"cns_p091","difficulty":"basic","type":"choice","prompt":"蚕蛾有几对翅、几条腿？","choices":[{"key":"A","text":"一对翅，四条腿"},{"key":"B","text":"两对翅，六条腿"},{"key":"C","text":"没有翅，八条腿"},{"key":"D","text":"三对翅，十条腿"}],"answer":"B","explanation":"蚕蛾是昆虫，有两对翅、三对足。","verify":"\"两对翅，六条腿\""},{"id":"cns_p091_q3","topicId":"cns_p091","difficulty":"standard","type":"choice","prompt":"蝗虫的一生经过卵、若虫、成虫，没有蛹期，它属于什么发育？","choices":[{"key":"A","text":"完全变态"},{"key":"B","text":"不发育"},{"key":"C","text":"不完全变态"},{"key":"D","text":"胎生"}],"answer":"C","explanation":"没有蛹期的叫不完全变态。","verify":"\"不完全变态\""},{"id":"cns_p091_q4","topicId":"cns_p091","difficulty":"challenge","type":"choice","prompt":"下面哪种昆虫和蚕一样，要经过蛹期？","choices":[{"key":"A","text":"蝗虫"},{"key":"B","text":"蟋蟀"},{"key":"C","text":"蟑螂"},{"key":"D","text":"蝴蝶"}],"answer":"D","explanation":"蝴蝶是完全变态发育。","verify":"\"蝴蝶\""},{"id":"cns_p092_q1","topicId":"cns_p092","difficulty":"basic","type":"choice","prompt":"动物的生命周期一般包括哪些阶段？","choices":[{"key":"A","text":"只有出生"},{"key":"B","text":"出生、生长发育、繁殖、死亡"},{"key":"C","text":"只有长大"},{"key":"D","text":"只会繁殖"}],"answer":"B","explanation":"所有动物都要经历这些阶段。","verify":"\"出生、生长发育、繁殖、死亡\""},{"id":"cns_p092_q2","topicId":"cns_p092","difficulty":"basic","type":"choice","prompt":"下面哪种动物的寿命最短？","choices":[{"key":"A","text":"大象"},{"key":"B","text":"乌龟"},{"key":"C","text":"家蚕"},{"key":"D","text":"人"}],"answer":"C","explanation":"家蚕一生只有大约两个月。","verify":"\"家蚕\""},{"id":"cns_p092_q3","topicId":"cns_p092","difficulty":"standard","type":"choice","prompt":"青蛙的一生是怎样的顺序？","choices":[{"key":"A","text":"蝌蚪→卵→成蛙→幼蛙"},{"key":"B","text":"卵→成蛙→蝌蚪"},{"key":"C","text":"成蛙→卵→幼蛙→蝌蚪"},{"key":"D","text":"卵→蝌蚪→幼蛙→成蛙"}],"answer":"D","explanation":"青蛙从卵孵出蝌蚪，再长成青蛙。","verify":"\"卵→蝌蚪→幼蛙→成蛙\""},{"id":"cns_p092_q4","topicId":"cns_p092","difficulty":"challenge","type":"choice","prompt":"为什么说繁殖是生命周期中最重要的环节之一？","choices":[{"key":"A","text":"没有繁殖，物种就会消失"},{"key":"B","text":"繁殖让动物长寿"},{"key":"C","text":"繁殖让动物变大"},{"key":"D","text":"繁殖后动物不会死"}],"answer":"A","explanation":"个体会死亡，繁殖让生命一代代延续。","verify":"\"没有繁殖，物种就会消失\""}]
