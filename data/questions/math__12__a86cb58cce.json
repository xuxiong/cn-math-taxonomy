[{"id":"cnm_h183_q1","topicId":"cnm_h183","difficulty":"basic","type":"choice","prompt":"椭圆定义里，动点到两个焦点的距离有什么关系？","choices":[{"key":"A","text":"和等于一个大于焦距的常数"},{"key":"B","text":"差等于常数"},{"key":"C","text":"积等于常数"},{"key":"D","text":"和等于焦距"}],"answer":"A","explanation":"和为常数，并且常数要大于两焦点之间的距离，轨迹才是椭圆。","verify":"\"和等于一个大于焦距的常数\""},{"id":"cnm_h183_q2","topicId":"cnm_h183","difficulty":"basic","type":"numeric","prompt":"椭圆上任意一点到两个焦点的距离之和是 10。这个和等于 2a 时，a 是多少？","answer":"5","explanation":"2a=10，a=5。","verify":"5"},{"id":"cnm_h183_q3","topicId":"cnm_h183","difficulty":"standard","type":"choice","prompt":"若距离之和等于两焦点间的距离，轨迹是什么？","choices":[{"key":"A","text":"椭圆"},{"key":"B","text":"双曲线"},{"key":"C","text":"两焦点之间的线段"},{"key":"D","text":"整个平面"}],"answer":"C","explanation":"和等于焦距时，点只能落在两焦点的连线段上，不能形成椭圆。","verify":"\"两焦点之间的线段\""},{"id":"cnm_h183_q4","topicId":"cnm_h183","difficulty":"standard","type":"numeric","prompt":"焦点在 x 轴上，a=5。椭圆上的点到两焦点的距离之和是多少？","answer":"10","explanation":"由定义，距离之和是 2a=10。","verify":"2*5"},{"id":"cnm_h184_q1","topicId":"cnm_h184","difficulty":"basic","type":"numeric","prompt":"椭圆 x²/25+y²/16=1 中，a 等于多少？","answer":"5","explanation":"x² 下面是 a²=25，a=5。","verify":"isqrt(25)"},{"id":"cnm_h184_q2","topicId":"cnm_h184","difficulty":"basic","type":"numeric","prompt":"椭圆 x²/25+y²/16=1 中，b 等于多少？","answer":"4","explanation":"y² 下面是 b²=16，b=4。","verify":"isqrt(16)"},{"id":"cnm_h184_q3","topicId":"cnm_h184","difficulty":"standard","type":"numeric","prompt":"a=3，b=2，焦点在 x 轴上。标准方程中 a² 是多少？","answer":"9","explanation":"方程是 x²/9+y²/4=1，a²=9。","verify":"3*3"},{"id":"cnm_h184_q4","topicId":"cnm_h184","difficulty":"standard","type":"choice","prompt":"方程 x²/9+y²/4=1 表示的曲线是？","choices":[{"key":"A","text":"焦点在 x 轴上的椭圆"},{"key":"B","text":"焦点在 y 轴上的椭圆"},{"key":"C","text":"双曲线"},{"key":"D","text":"抛物线"}],"answer":"A","explanation":"两项都是正的且等于 1，x² 的分母更大，焦点在 x 轴上。","verify":"\"焦点在 x 轴上的椭圆\""},{"id":"cnm_h185_q1","topicId":"cnm_h185","difficulty":"basic","type":"numeric","prompt":"椭圆 a=5，b=4。c 等于多少？","answer":"3","explanation":"c²=a²−b²=25−16=9，c=3。","verify":"isqrt(25-16)"},{"id":"cnm_h185_q2","topicId":"cnm_h185","difficulty":"basic","type":"numeric","prompt":"椭圆 a=5，c=3。离心率是多少？","answer":"3/5","explanation":"离心率 e=c/a=3/5。","verify":"Fraction(3,5)"},{"id":"cnm_h185_q3","topicId":"cnm_h185","difficulty":"standard","type":"numeric","prompt":"椭圆 a=13，b=5。焦距 2c 是多少？","answer":"24","explanation":"c²=169−25=144，c=12，焦距是 24。","verify":"2*isqrt(169-25)"},{"id":"cnm_h185_q4","topicId":"cnm_h185","difficulty":"standard","type":"choice","prompt":"椭圆离心率的范围是？","choices":[{"key":"A","text":"大于 1"},{"key":"B","text":"大于 0 且小于 1"},{"key":"C","text":"等于 1"},{"key":"D","text":"小于 0"}],"answer":"B","explanation":"0<c<a，所以 0<e<1。e 越接近 1，椭圆越扁。","verify":"\"大于 0 且小于 1\""},{"id":"cnm_h186_q1","topicId":"cnm_h186","difficulty":"basic","type":"numeric","prompt":"椭圆 x²/25+y²/9=1 的长轴长是多少？","answer":"10","explanation":"a=5，长轴长 2a=10。","verify":"2*5"},{"id":"cnm_h186_q2","topicId":"cnm_h186","difficulty":"basic","type":"numeric","prompt":"椭圆 x²/25+y²/9=1 的短轴长是多少？","answer":"6","explanation":"b=3，短轴长 2b=6。","verify":"2*3"},{"id":"cnm_h186_q3","topicId":"cnm_h186","difficulty":"standard","type":"numeric","prompt":"椭圆 x²/25+y²/9=1 上点的横坐标最大是多少？","answer":"5","explanation":"x 的范围是 −5 到 5，最大横坐标是 5。","verify":"5"},{"id":"cnm_h186_q4","topicId":"cnm_h186","difficulty":"standard","type":"choice","prompt":"焦点在 x 轴上的椭圆，长轴在哪一条直线上？","choices":[{"key":"A","text":"y 轴"},{"key":"B","text":"直线 y=x"},{"key":"C","text":"x 轴"},{"key":"D","text":"任意直线"}],"answer":"C","explanation":"焦点所在的轴是长轴，这里长轴在 x 轴上。","verify":"\"x 轴\""},{"id":"cnm_h187_q1","topicId":"cnm_h187","difficulty":"basic","type":"numeric","prompt":"椭圆形跑道可看成椭圆，长半轴 5，短半轴 4。轨道上一点到两个焦点的距离之和是多少？","answer":"10","explanation":"定义给出距离之和等于 2a=10。","verify":"2*5"},{"id":"cnm_h187_q2","topicId":"cnm_h187","difficulty":"basic","type":"numeric","prompt":"长半轴 5、短半轴 4 的椭圆，焦点到中心的距离是多少？","answer":"3","explanation":"c=√(25−16)=3。","verify":"isqrt(25-16)"},{"id":"cnm_h187_q3","topicId":"cnm_h187","difficulty":"standard","type":"numeric","prompt":"椭圆镜片 a=10，b=8。离心率的分子 c 是多少？","answer":"6","explanation":"c=√(100−64)=√36=6。","verify":"isqrt(100-64)"},{"id":"cnm_h187_q4","topicId":"cnm_h187","difficulty":"standard","type":"choice","prompt":"用椭圆描述行星轨道时，太阳通常放在哪里？","choices":[{"key":"A","text":"长轴的端点上"},{"key":"B","text":"短轴的端点上"},{"key":"C","text":"椭圆外部"},{"key":"D","text":"一个焦点上"}],"answer":"D","explanation":"这是椭圆定义的一个常见应用：到两焦点距离之和为定值，太阳在其中一个焦点。","verify":"\"一个焦点上\""}]
