[{"difficulty":"basic","type":"numeric","prompt":"6 的 3 倍是多少？","answer":"18","explanation":"3 倍就是 3 个 6，6×3＝18。","verify":"6*3","id":"cnm_p073_q1","topicId":"cnm_p073"},{"difficulty":"basic","type":"numeric","prompt":"8 的 4 倍是多少？","answer":"32","explanation":"8×4＝32。","verify":"8*4","id":"cnm_p073_q2","topicId":"cnm_p073"},{"difficulty":"standard","type":"numeric","prompt":"红花有 7 朵，黄花的朵数是红花的 5 倍。黄花有多少朵？","answer":"35","explanation":"7×5＝35（朵）。","verify":"7*5","id":"cnm_p073_q3","topicId":"cnm_p073"},{"difficulty":"challenge","type":"numeric","prompt":"红花 6 朵，黄花是红花的 3 倍。黄花比红花多几朵？","answer":"12","explanation":"黄花有 6×3＝18 朵，比红花多 18－6＝12 朵。","verify":"6*3-6","id":"cnm_p073_q4","topicId":"cnm_p073"},{"difficulty":"basic","type":"choice","prompt":"集合图里两边都有的人或物画在哪里？","choices":[{"key":"A","text":"两个圈重叠的部分"},{"key":"B","text":"两个圈的外面"},{"key":"C","text":"只画在左边"}],"answer":"A","explanation":"两类都有的，画在两个圈重叠的地方。","verify":"'两个圈重叠的部分'","id":"cnm_p081_q1","topicId":"cnm_p081"},{"difficulty":"basic","type":"numeric","prompt":"语文小组 10 人，其中 4 人两个小组都参加。只参加语文小组的有几人？","answer":"6","explanation":"重叠的 4 人已经算在 10 人里，只参加语文的是 10－4＝6。","verify":"10-4","id":"cnm_p081_q2","topicId":"cnm_p081"},{"difficulty":"standard","type":"numeric","prompt":"语文小组 10 人，数学小组 9 人，两个小组都参加的有 4 人。只算一次的话，一共有多少人？","answer":"15","explanation":"10＋9－4＝15。重叠部分不能加两次。","verify":"10+9-4","id":"cnm_p081_q3","topicId":"cnm_p081"},{"difficulty":"challenge","type":"numeric","prompt":"语文小组 10 人，数学小组 9 人，两个小组都参加的有 4 人。只参加一个小组的有多少人？","answer":"11","explanation":"只参加语文 10－4＝6 人，只参加数学 9－4＝5 人，一共 11 人。","verify":"(10-4)+(9-4)","id":"cnm_p081_q4","topicId":"cnm_p081"},{"difficulty":"basic","type":"choice","prompt":"数两种事物的搭配时，怎样才不会重复，也不会漏掉？","choices":[{"key":"A","text":"按顺序一种一种地配"},{"key":"B","text":"只配第一种就停止"},{"key":"C","text":"把两种东西的个数相加"}],"answer":"A","explanation":"要有顺序地配，每一种都配到，而且不重复。","verify":"'按顺序一种一种地配'","id":"cnm_p095_q1","topicId":"cnm_p095"},{"difficulty":"basic","type":"numeric","prompt":"2 件上衣和 3 条裤子，每件上衣配每条裤子。一共有多少种搭配？","answer":"6","explanation":"2×3＝6（种）。","verify":"2*3","id":"cnm_p095_q2","topicId":"cnm_p095"},{"difficulty":"standard","type":"numeric","prompt":"3 种面包和 2 种饮料，每种面包配每种饮料。一共有多少种搭配？","answer":"6","explanation":"3×2＝6（种）。","verify":"3*2","id":"cnm_p095_q3","topicId":"cnm_p095"},{"difficulty":"challenge","type":"numeric","prompt":"原来有 2 件上衣、3 条裤子。又添了 1 件上衣，每件上衣仍配每条裤子。现在有多少种搭配？","answer":"9","explanation":"上衣变成 3 件，3×3＝9（种）。","verify":"3*3","id":"cnm_p095_q4","topicId":"cnm_p095"}]
