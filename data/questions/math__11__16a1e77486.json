[{"id":"cnm_h123_q1","topicId":"cnm_h123","difficulty":"basic","type":"choice","prompt":"想知道一批灯泡的使用寿命，又不能把灯泡全部用坏。更合适的是？","choices":[{"key":"A","text":"抽样试验"},{"key":"B","text":"对所有灯泡做普查"},{"key":"C","text":"只问一个人的感觉"},{"key":"D","text":"不收集数据"}],"answer":"A","explanation":"寿命试验是破坏性的，适合抽样，而不是把全部产品试完。","verify":"\"抽样试验\""},{"id":"cnm_h123_q2","topicId":"cnm_h123","difficulty":"basic","type":"choice","prompt":"查看统计局已经公布的人口数据，属于？","choices":[{"key":"A","text":"随机试验"},{"key":"B","text":"查阅资料"},{"key":"C","text":"面对面问卷调查"},{"key":"D","text":"设计新的实验"}],"answer":"B","explanation":"资料已经存在，直接查阅即可。","verify":"\"查阅资料\""},{"id":"cnm_h123_q3","topicId":"cnm_h123","difficulty":"standard","type":"numeric","prompt":"一个班 40 人，如果做普查，要收集多少人的数据？","answer":"40","explanation":"普查是全体都收集，这里是 40。","verify":"40"},{"id":"cnm_h123_q4","topicId":"cnm_h123","difficulty":"standard","type":"choice","prompt":"获取数据之前首先要明确？","choices":[{"key":"A","text":"先画直方图"},{"key":"B","text":"先计算方差"},{"key":"C","text":"先写结论"},{"key":"D","text":"要研究的问题"}],"answer":"D","explanation":"问题决定收集什么、向谁收集。","verify":"\"要研究的问题\""},{"id":"cnm_h124_q1","topicId":"cnm_h124","difficulty":"basic","type":"numeric","prompt":"总体有 20 人，用简单随机抽样抽 1 人。每个人被抽到的概率是多少？","answer":"1/20","explanation":"每个人机会相同，概率是 1/20。","verify":"Fraction(1,20)"},{"id":"cnm_h124_q2","topicId":"cnm_h124","difficulty":"basic","type":"numeric","prompt":"总体 10 件，简单随机抽取 2 件。不同的抽法有多少种？","answer":"45","explanation":"组合数 C(10,2)=45。","verify":"comb(10,2)"},{"id":"cnm_h124_q3","topicId":"cnm_h124","difficulty":"standard","type":"choice","prompt":"简单随机抽样要求？","choices":[{"key":"A","text":"只抽成绩好的"},{"key":"B","text":"按班级比例抽"},{"key":"C","text":"样本必须等于总体"},{"key":"D","text":"每个个体被抽到的可能性相同"}],"answer":"D","explanation":"机会均等是简单随机抽样的要点。按比例是分层抽样。","verify":"\"每个个体被抽到的可能性相同\""},{"id":"cnm_h124_q4","topicId":"cnm_h124","difficulty":"standard","type":"choice","prompt":"抽签法要把号码？","choices":[{"key":"A","text":"充分混合后抽取"},{"key":"B","text":"按从小到大的顺序只取前面的"},{"key":"C","text":"只取偶数"},{"key":"D","text":"重复抽取同一个人直到满意"}],"answer":"A","explanation":"不混合就会让后面的号码几乎抽不到。","verify":"\"充分混合后抽取\""},{"id":"cnm_h125_q1","topicId":"cnm_h125","difficulty":"basic","type":"numeric","prompt":"甲层 40 人、乙层 60 人，按 1/10 分层抽样。甲层应抽多少人？","answer":"4","explanation":"40×1/10=4。","verify":"40/10"},{"id":"cnm_h125_q2","topicId":"cnm_h125","difficulty":"basic","type":"numeric","prompt":"甲层 40 人、乙层 60 人，按 1/10 分层抽样。乙层应抽多少人？","answer":"6","explanation":"按各层人数的 1/10 分配，乙层 60×1/10=6。","verify":"60/10"},{"id":"cnm_h125_q3","topicId":"cnm_h125","difficulty":"standard","type":"numeric","prompt":"两层合起来的样本量是多少？","answer":"10","explanation":"4+6=10，也等于总人数 100 的 1/10。","verify":"40/10+60/10"},{"id":"cnm_h125_q4","topicId":"cnm_h125","difficulty":"standard","type":"choice","prompt":"分层抽样适用于？","choices":[{"key":"A","text":"总体只有 2 个个体"},{"key":"B","text":"总体由差异明显的几层组成"},{"key":"C","text":"每个个体都完全相同"},{"key":"D","text":"不能分组的连续生产"}],"answer":"B","explanation":"层内比较整齐、层间差异大时，按比例抽更能代表总体。","verify":"\"总体由差异明显的几层组成\""},{"id":"cnm_h126_q1","topicId":"cnm_h126","difficulty":"basic","type":"choice","prompt":"学校三个年级人数差很多，要了解全校每天的作业时间。更合适的是？","choices":[{"key":"A","text":"只抽一个年级"},{"key":"B","text":"把三个年级混在一起却不看人数"},{"key":"C","text":"只调查老师"},{"key":"D","text":"分层随机抽样"}],"answer":"D","explanation":"年级之间可能不同，应按人数比例分层。","verify":"\"分层随机抽样\""},{"id":"cnm_h126_q2","topicId":"cnm_h126","difficulty":"basic","type":"choice","prompt":"20 支钢笔放在同一个盒子里，除了外观没有其他分层信息。抽 4 支检查，用？","choices":[{"key":"A","text":"简单随机抽样"},{"key":"B","text":"必须分层"},{"key":"C","text":"普查"},{"key":"D","text":"只抽第一支"}],"answer":"A","explanation":"没有明显的层，简单随机抽样即可。","verify":"\"简单随机抽样\""},{"id":"cnm_h126_q3","topicId":"cnm_h126","difficulty":"standard","type":"numeric","prompt":"样本量为 8，不表示总体只有 8。若总体是 80，样本量是总体的几分之一？","answer":"1/10","explanation":"8/80=1/10。","verify":"Fraction(8,80)"},{"id":"cnm_h126_q4","topicId":"cnm_h126","difficulty":"standard","type":"choice","prompt":"抽样推断的结果？","choices":[{"key":"A","text":"一定等于总体参数"},{"key":"B","text":"不能用来做任何判断"},{"key":"C","text":"是估计，不一定等于总体的精确值"},{"key":"D","text":"只对样本里的人有效、与总体无关"}],"answer":"C","explanation":"样本提供估计，带有随机误差。","verify":"\"是估计，不一定等于总体的精确值\""}]
