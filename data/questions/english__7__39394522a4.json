[{"id":"cne_j007_q1","topicId":"cne_j007","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「家庭」？","choices":[{"key":"A","text":"family"},{"key":"B","text":"parent"},{"key":"C","text":"sister"},{"key":"D","text":"brother"}],"answer":"A","explanation":"family 的意思是家庭。","verify":"\"family\""},{"id":"cne_j007_q2","topicId":"cne_j007","difficulty":"basic","type":"choice","prompt":"「parent」的中文意思是哪一个？","choices":[{"key":"A","text":"家庭"},{"key":"B","text":"父或母"},{"key":"C","text":"姐姐或妹妹"},{"key":"D","text":"哥哥或弟弟"}],"answer":"B","explanation":"parent 的意思是父或母。","verify":"\"父或母\""},{"id":"cne_j007_q3","topicId":"cne_j007","difficulty":"standard","type":"choice","prompt":"选择表示「姐姐或妹妹」的单词。","choices":[{"key":"A","text":"family"},{"key":"B","text":"parent"},{"key":"C","text":"sister"},{"key":"D","text":"brother"}],"answer":"C","explanation":"表示姐姐或妹妹的单词是 sister。","verify":"\"sister\""},{"id":"cne_j007_q4","topicId":"cne_j007","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「哥哥或弟弟」？","choices":[{"key":"A","text":"family"},{"key":"B","text":"parent"},{"key":"C","text":"sister"},{"key":"D","text":"brother"}],"answer":"D","explanation":"brother 的意思是哥哥或弟弟。","verify":"\"brother\""},{"id":"cne_j011_q1","topicId":"cne_j011","difficulty":"basic","type":"choice","prompt":"想把姐姐介绍给同学，哪一句合适？","choices":[{"key":"A","text":"This is my sister."},{"key":"B","text":"These are my sister."},{"key":"C","text":"She is my parent?"},{"key":"D","text":"I am your sister."}],"answer":"A","explanation":"介绍一个人用 This is。","verify":"\"This is my sister.\""},{"id":"cne_j011_q2","topicId":"cne_j011","difficulty":"basic","type":"choice","prompt":"对方问 Who is he? 他是你的弟弟，应回答什么？","choices":[{"key":"A","text":"She is my brother."},{"key":"B","text":"He is my brother."},{"key":"C","text":"He are my brother."},{"key":"D","text":"This are my brother."}],"answer":"B","explanation":"弟弟是 he，用 is。","verify":"\"He is my brother.\""},{"id":"cne_j011_q3","topicId":"cne_j011","difficulty":"standard","type":"choice","prompt":"These are my parents. 说话人在介绍谁？","choices":[{"key":"A","text":"同学"},{"key":"B","text":"老师"},{"key":"C","text":"父母"},{"key":"D","text":"朋友的书"}],"answer":"C","explanation":"parents 是父母。","verify":"\"父母\""},{"id":"cne_j011_q4","topicId":"cne_j011","difficulty":"standard","type":"choice","prompt":"哪一句能用来介绍照片里的一家人？","choices":[{"key":"A","text":"This is my schoolbag."},{"key":"B","text":"These are my pens."},{"key":"C","text":"This are my family."},{"key":"D","text":"This is my family."}],"answer":"D","explanation":"family 是家庭。","verify":"\"This is my family.\""},{"id":"cne_j012_q1","topicId":"cne_j012","difficulty":"basic","type":"choice","prompt":"This is my family. These are my parents. This is my sister, Gina. 说话人的姐姐是谁？","choices":[{"key":"A","text":"Tom"},{"key":"B","text":"Gina"},{"key":"C","text":"Alice"},{"key":"D","text":"Jack"}],"answer":"B","explanation":"This is my sister, Gina 说明姐姐是 Gina。","verify":"\"Gina\""},{"id":"cne_j012_q2","topicId":"cne_j012","difficulty":"basic","type":"choice","prompt":"This is my family. These are my parents. This is my sister, Gina. 哪一句和短文一致？","choices":[{"key":"A","text":"Gina is the speaker's brother."},{"key":"B","text":"The speaker has no parents."},{"key":"C","text":"Gina is the speaker's sister."},{"key":"D","text":"Gina is a parent."}],"answer":"C","explanation":"短文说 This is my sister, Gina。","verify":"\"Gina is the speaker's sister.\""},{"id":"cne_j012_q3","topicId":"cne_j012","difficulty":"standard","type":"choice","prompt":"I have a brother. His name is Tom. I have no sister. 说话人有姐姐吗？","choices":[{"key":"A","text":"有一个"},{"key":"B","text":"有两个"},{"key":"C","text":"短文没说"},{"key":"D","text":"没有"}],"answer":"D","explanation":"I have no sister 是没有姐姐或妹妹。","verify":"\"没有\""},{"id":"cne_j012_q4","topicId":"cne_j012","difficulty":"standard","type":"choice","prompt":"I have a brother. His name is Tom. I have no sister. Tom 是谁？","choices":[{"key":"A","text":"说话人的弟弟或哥哥"},{"key":"B","text":"说话人的姐姐"},{"key":"C","text":"说话人的父母"},{"key":"D","text":"说话人的老师"}],"answer":"A","explanation":"His name is Tom 指 brother。","verify":"\"说话人的弟弟或哥哥\""},{"id":"cne_j024_q1","topicId":"cne_j024","difficulty":"basic","type":"choice","prompt":"___ you have a soccer ball? 横线处填哪一个？","choices":[{"key":"A","text":"Does"},{"key":"B","text":"Do"},{"key":"C","text":"Are"},{"key":"D","text":"Is"}],"answer":"B","explanation":"you 用 Do。","verify":"\"Do\""},{"id":"cne_j024_q2","topicId":"cne_j024","difficulty":"basic","type":"choice","prompt":"___ she have a tennis ball? 横线处填哪一个？","choices":[{"key":"A","text":"Do"},{"key":"B","text":"Is"},{"key":"C","text":"Does"},{"key":"D","text":"Has"}],"answer":"C","explanation":"she 用 Does，后面动词用原形 have。","verify":"\"Does\""},{"id":"cne_j024_q3","topicId":"cne_j024","difficulty":"standard","type":"choice","prompt":"他没有篮球。哪一句正确？","choices":[{"key":"A","text":"He don't have a basketball."},{"key":"B","text":"He doesn't has a basketball."},{"key":"C","text":"He not have a basketball."},{"key":"D","text":"He doesn't have a basketball."}],"answer":"D","explanation":"doesn't 后面用动词原形 have。","verify":"\"He doesn't have a basketball.\""},{"id":"cne_j024_q4","topicId":"cne_j024","difficulty":"standard","type":"choice","prompt":"Do they have a volleyball? 肯定简答是哪一句？","choices":[{"key":"A","text":"Yes, they do."},{"key":"B","text":"Yes, they have."},{"key":"C","text":"Yes, they does."},{"key":"D","text":"Yes, they are."}],"answer":"A","explanation":"Do 提问用 do 回答。","verify":"\"Yes, they do.\""},{"id":"cne_j079_q1","topicId":"cne_j079","difficulty":"basic","type":"choice","prompt":"哪个单词的意思是「身高」？","choices":[{"key":"A","text":"height"},{"key":"B","text":"heavy"},{"key":"C","text":"glasses"},{"key":"D","text":"handsome"}],"answer":"A","explanation":"height 的意思是身高。","verify":"\"height\""},{"id":"cne_j079_q2","topicId":"cne_j079","difficulty":"basic","type":"choice","prompt":"「heavy」的中文意思是哪一个？","choices":[{"key":"A","text":"身高"},{"key":"B","text":"重的"},{"key":"C","text":"眼镜"},{"key":"D","text":"英俊的"}],"answer":"B","explanation":"heavy 的意思是重的。","verify":"\"重的\""},{"id":"cne_j079_q3","topicId":"cne_j079","difficulty":"standard","type":"choice","prompt":"选择表示「眼镜」的单词。","choices":[{"key":"A","text":"height"},{"key":"B","text":"heavy"},{"key":"C","text":"glasses"},{"key":"D","text":"handsome"}],"answer":"C","explanation":"表示眼镜的单词是 glasses。","verify":"\"glasses\""},{"id":"cne_j079_q4","topicId":"cne_j079","difficulty":"standard","type":"choice","prompt":"哪个单词的意思是「英俊的」？","choices":[{"key":"A","text":"height"},{"key":"B","text":"heavy"},{"key":"C","text":"glasses"},{"key":"D","text":"handsome"}],"answer":"D","explanation":"handsome 的意思是英俊的。","verify":"\"handsome\""},{"id":"cne_j080_q1","topicId":"cne_j080","difficulty":"basic","type":"choice","prompt":"他很高。哪一句正确？","choices":[{"key":"A","text":"He has tall."},{"key":"B","text":"He is tall."},{"key":"C","text":"He is a tall."},{"key":"D","text":"He wears tall."}],"answer":"B","explanation":"高用 be 加形容词，不用 have。","verify":"\"He is tall.\""},{"id":"cne_j080_q2","topicId":"cne_j080","difficulty":"basic","type":"choice","prompt":"她留着长发。哪一句正确？","choices":[{"key":"A","text":"She is long hair."},{"key":"B","text":"She has long hairs."},{"key":"C","text":"She has long hair."},{"key":"D","text":"She is has long hair."}],"answer":"C","explanation":"有某种头发用 has，hair 通常不可数。","verify":"\"She has long hair.\""},{"id":"cne_j080_q3","topicId":"cne_j080","difficulty":"standard","type":"choice","prompt":"他戴着眼镜。哪一句正确？","choices":[{"key":"A","text":"He wears glass."},{"key":"B","text":"He is wear glasses."},{"key":"C","text":"He wears a glasses."},{"key":"D","text":"He wears glasses."}],"answer":"D","explanation":"glasses 是复数形式，不加 a。","verify":"\"He wears glasses.\""},{"id":"cne_j080_q4","topicId":"cne_j080","difficulty":"standard","type":"choice","prompt":"What does he look like? 这句在问什么？","choices":[{"key":"A","text":"他长什么样"},{"key":"B","text":"他喜欢什么"},{"key":"C","text":"他看起来在看书"},{"key":"D","text":"他来自哪里"}],"answer":"A","explanation":"look like 问外貌，不是问喜好。","verify":"\"他长什么样\""},{"id":"cne_j081_q1","topicId":"cne_j081","difficulty":"basic","type":"choice","prompt":"想问那位老师长什么样，哪一句合适？","choices":[{"key":"A","text":"What does your teacher like?"},{"key":"B","text":"What is your teacher look like?"},{"key":"C","text":"What does your teacher look like?"},{"key":"D","text":"How does your teacher look like?"}],"answer":"C","explanation":"问外貌用 What does ... look like。What does he like 是问喜好。","verify":"\"What does your teacher look like?\""},{"id":"cne_j081_q2","topicId":"cne_j081","difficulty":"basic","type":"choice","prompt":"他中等身高，应怎么说？","choices":[{"key":"A","text":"He has of medium height."},{"key":"B","text":"He is medium height of."},{"key":"C","text":"He is of medium high."},{"key":"D","text":"He is of medium height."}],"answer":"D","explanation":"of medium height 表示中等身高。","verify":"\"He is of medium height.\""},{"id":"cne_j081_q3","topicId":"cne_j081","difficulty":"standard","type":"choice","prompt":"She has curly hair. 这句话的意思是什么？","choices":[{"key":"A","text":"她留着卷发"},{"key":"B","text":"她很高"},{"key":"C","text":"她戴眼镜"},{"key":"D","text":"她很瘦"}],"answer":"A","explanation":"curly hair 是卷发。","verify":"\"她留着卷发\""},{"id":"cne_j081_q4","topicId":"cne_j081","difficulty":"standard","type":"choice","prompt":"想说那个男孩又瘦又英俊，哪一句合适？","choices":[{"key":"A","text":"The boy is thin and handsome hair."},{"key":"B","text":"The boy is thin and handsome."},{"key":"C","text":"The boy has thin and handsome."},{"key":"D","text":"The boy are thin and handsome."}],"answer":"B","explanation":"is 加两个形容词。","verify":"\"The boy is thin and handsome.\""},{"id":"cne_j082_q1","topicId":"cne_j082","difficulty":"basic","type":"choice","prompt":"My friend Jack is tall and thin. He has short black hair. He wears glasses. Jack 戴眼镜吗？","choices":[{"key":"A","text":"不戴"},{"key":"B","text":"只在学校戴，短文没写"},{"key":"C","text":"短文说他不戴"},{"key":"D","text":"戴"}],"answer":"D","explanation":"wears glasses。","verify":"\"戴\""},{"id":"cne_j082_q2","topicId":"cne_j082","difficulty":"basic","type":"choice","prompt":"My friend Jack is tall and thin. He has short black hair. 他的头发是什么样的？","choices":[{"key":"A","text":"短的黑发"},{"key":"B","text":"长的卷发"},{"key":"C","text":"金色短发"},{"key":"D","text":"没有头发"}],"answer":"A","explanation":"short black hair。","verify":"\"短的黑发\""},{"id":"cne_j082_q3","topicId":"cne_j082","difficulty":"standard","type":"choice","prompt":"Lisa is of medium height. She has long curly hair. She is a little heavy. Lisa 胖还是瘦？","choices":[{"key":"A","text":"很瘦"},{"key":"B","text":"有点重"},{"key":"C","text":"中等身高所以不谈体重"},{"key":"D","text":"短文没说体重"}],"answer":"B","explanation":"a little heavy 是有点重。","verify":"\"有点重\""},{"id":"cne_j082_q4","topicId":"cne_j082","difficulty":"standard","type":"choice","prompt":"Lisa is of medium height. She has long curly hair. 哪一句和短文一致？","choices":[{"key":"A","text":"Lisa is very short."},{"key":"B","text":"Lisa has short hair."},{"key":"C","text":"Lisa's hair is long and curly."},{"key":"D","text":"Lisa wears glasses in this text."}],"answer":"C","explanation":"long curly hair。短文没有说眼镜。","verify":"\"Lisa's hair is long and curly.\""},{"id":"cne_j246_q1","topicId":"cne_j246","difficulty":"basic","type":"choice","prompt":"This is ____ bike. 这是 Lucy 的自行车。","choices":[{"key":"A","text":"Lucy's"},{"key":"B","text":"Lucys"},{"key":"C","text":"Lucy"},{"key":"D","text":"Lucys'"}],"answer":"A","explanation":"单个人名后加 's。","verify":"\"Lucy's\""},{"id":"cne_j246_q2","topicId":"cne_j246","difficulty":"basic","type":"choice","prompt":"「我父母的房间」正确写法是？","choices":[{"key":"A","text":"my parents's room"},{"key":"B","text":"my parents room's"},{"key":"C","text":"my parent's room"},{"key":"D","text":"my parents' room"}],"answer":"D","explanation":"以 s 结尾的复数名词只加 '。","verify":"\"my parents' room\""},{"id":"cne_j246_q3","topicId":"cne_j246","difficulty":"standard","type":"choice","prompt":"Jack's sister is 12. 句中 's 表示？","choices":[{"key":"A","text":"所属关系「的」"},{"key":"B","text":"复数"},{"key":"C","text":"is 的缩写"},{"key":"D","text":"has 的缩写"}],"answer":"A","explanation":"Jack's sister 是杰克的姐姐。","verify":"\"所属关系「的」\""},{"id":"cne_j246_q4","topicId":"cne_j246","difficulty":"standard","type":"choice","prompt":"Lily and Lucy's room 表示？","choices":[{"key":"A","text":"两人共有的一个房间"},{"key":"B","text":"Lucy 不在房间"},{"key":"C","text":"Lily 一人的房间"},{"key":"D","text":"两人各自的房间"}],"answer":"A","explanation":"共有只在最后一个名词后加 's。","verify":"\"两人共有的一个房间\""}]
