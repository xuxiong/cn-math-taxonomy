[{"id":"cnd_p155_q1","topicId":"cnd_p155","difficulty":"basic","type":"choice","prompt":"公共场所应做到？","choices":[{"key":"A","text":"文明言行，遵守秩序，照顾他人"},{"key":"B","text":"大声喧哗妨碍别人"},{"key":"C","text":"乱扔垃圾"},{"key":"D","text":"损坏公共设施"}],"answer":"A","explanation":"公共生活靠大家文明。","verify":"\"文明言行，遵守秩序，照顾他人\""},{"id":"cnd_p155_q2","topicId":"cnd_p155","difficulty":"basic","type":"choice","prompt":"生活中的规则作用是？","choices":[{"key":"A","text":"专门欺负小朋友"},{"key":"B","text":"保障安全与公平，维护秩序"},{"key":"C","text":"可随便违反"},{"key":"D","text":"只约束别人不约束自己"}],"answer":"B","explanation":"规则保护每个人。","verify":"\"保障安全与公平，维护秩序\""},{"id":"cnd_p155_q3","topicId":"cnd_p155","difficulty":"standard","type":"choice","prompt":"看到有人需要帮助且自己能帮，应？","choices":[{"key":"A","text":"冷漠走开还录像取笑"},{"key":"B","text":"起哄看热闹"},{"key":"C","text":"在安全前提下热心帮助或求助大人"},{"key":"D","text":"趁机拿别人东西"}],"answer":"C","explanation":"做热心但注意安全。","verify":"\"在安全前提下热心帮助或求助大人\""},{"id":"cnd_p155_q4","topicId":"cnd_p155","difficulty":"challenge","type":"choice","prompt":"学会倾听，最重要的是？","choices":[{"key":"A","text":"边听边玩手机"},{"key":"B","text":"只听自己想听的部分"},{"key":"C","text":"打断并嘲笑对方"},{"key":"D","text":"认真听对方把话说完，不随意打断"}],"answer":"D","explanation":"倾听是交往的基本能力。","verify":"\"认真听对方把话说完，不随意打断\""},{"id":"cnd_p156_q1","topicId":"cnd_p156","difficulty":"basic","type":"choice","prompt":"爱护地球，我们可以？","choices":[{"key":"A","text":"随意浪费资源"},{"key":"B","text":"节约资源、保护环境、应对灾害有准备"},{"key":"C","text":"破坏植被"},{"key":"D","text":"忽视安全预警"}],"answer":"B","explanation":"地球是共同家园。","verify":"\"节约资源、保护环境、应对灾害有准备\""},{"id":"cnd_p156_q2","topicId":"cnd_p156","difficulty":"basic","type":"choice","prompt":"面对地震等自然灾害预警，应？","choices":[{"key":"A","text":"跑去危险区域看热闹"},{"key":"B","text":"完全无视预警"},{"key":"C","text":"听从指挥，掌握基本避险方法"},{"key":"D","text":"传播恐慌谣言"}],"answer":"C","explanation":"科学避险。","verify":"\"听从指挥，掌握基本避险方法\""},{"id":"cnd_p156_q3","topicId":"cnd_p156","difficulty":"standard","type":"choice","prompt":"尊重不同文化，正确态度是？","choices":[{"key":"A","text":"嘲笑与自己不同的习俗"},{"key":"B","text":"强迫别人接受自己全部习惯"},{"key":"C","text":"拒绝了解其他文化"},{"key":"D","text":"平等尊重，欣赏多样魅力"}],"answer":"D","explanation":"文化多样，相互尊重。","verify":"\"平等尊重，欣赏多样魅力\""},{"id":"cnd_p156_q4","topicId":"cnd_p156","difficulty":"challenge","type":"choice","prompt":"我们爱和平，小学生可以？","choices":[{"key":"A","text":"与同学友好相处，反对欺凌，了解和平的意义"},{"key":"B","text":"鼓动打架"},{"key":"C","text":"歧视外国同学"},{"key":"D","text":"认为武力解决一切问题"}],"answer":"A","explanation":"从小树立爱和平的观念。","verify":"\"与同学友好相处，反对欺凌，了解和平的意义\""}]
