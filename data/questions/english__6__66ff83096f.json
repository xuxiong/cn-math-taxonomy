[{"id":"cne_p223_q1","topicId":"cne_p223","difficulty":"basic","type":"choice","prompt":"「骑马」的过去式短语是？","choices":[{"key":"A","text":"rode a horse"},{"key":"B","text":"ride a horse"},{"key":"C","text":"rided a horse"},{"key":"D","text":"went a horse"}],"answer":"A","explanation":"ride 的过去式是 rode。","verify":"\"rode a horse\""},{"id":"cne_p223_q2","topicId":"cne_p223","difficulty":"basic","type":"choice","prompt":"went camping 的意思是？","choices":[{"key":"A","text":"去钓鱼了"},{"key":"B","text":"受伤了"},{"key":"C","text":"买礼物了"},{"key":"D","text":"去野营了"}],"answer":"D","explanation":"went camping 是去野营。","verify":"\"去野营了\""},{"id":"cne_p223_q3","topicId":"cne_p223","difficulty":"standard","type":"choice","prompt":"「拍了很多照片」用哪一组？","choices":[{"key":"A","text":"taked pictures"},{"key":"B","text":"bought pictures"},{"key":"C","text":"took pictures"},{"key":"D","text":"take pictures"}],"answer":"C","explanation":"take 的过去式是 took。","verify":"\"took pictures\""},{"id":"cne_p223_q4","topicId":"cne_p223","difficulty":"standard","type":"choice","prompt":"hurt my foot 是在说什么？","choices":[{"key":"A","text":"买了鞋"},{"key":"B","text":"伤了脚"},{"key":"C","text":"洗了脚"},{"key":"D","text":"看了脚"}],"answer":"B","explanation":"hurt 可作过去式「伤了」。","verify":"\"伤了脚\""},{"id":"cne_p224_q1","topicId":"cne_p224","difficulty":"basic","type":"choice","prompt":"想问「你去了哪里？」，应选哪一句？","choices":[{"key":"A","text":"Where did you go?"},{"key":"B","text":"Where do you go?"},{"key":"C","text":"Where did you went?"},{"key":"D","text":"Where are you go?"}],"answer":"A","explanation":"Did 后用动词原形 go。","verify":"\"Where did you go?\""},{"id":"cne_p224_q2","topicId":"cne_p224","difficulty":"basic","type":"choice","prompt":"I ____ to the park last Sunday.","choices":[{"key":"A","text":"go"},{"key":"B","text":"goes"},{"key":"C","text":"going"},{"key":"D","text":"went"}],"answer":"D","explanation":"过去式用 went。","verify":"\"went\""},{"id":"cne_p224_q3","topicId":"cne_p224","difficulty":"standard","type":"choice","prompt":"哪一句正确？","choices":[{"key":"A","text":"Where do they went?"},{"key":"B","text":"Where they did go?"},{"key":"C","text":"Where did they go over the holiday?"},{"key":"D","text":"Where did they went over the holiday?"}],"answer":"C","explanation":"did + 主语 + 动词原形。","verify":"\"Where did they go over the holiday?\""},{"id":"cne_p224_q4","topicId":"cne_p224","difficulty":"standard","type":"choice","prompt":"—Where did you go? —I went to Sanya. 答句去了哪里？","choices":[{"key":"A","text":"医院"},{"key":"B","text":"三亚"},{"key":"C","text":"公园"},{"key":"D","text":"学校"}],"answer":"B","explanation":"Sanya 是三亚。","verify":"\"三亚\""},{"id":"cne_p225_q1","topicId":"cne_p225","difficulty":"basic","type":"choice","prompt":"想问「你在那里做了什么？」，应选哪一句？","choices":[{"key":"A","text":"What did you do there?"},{"key":"B","text":"What did you did there?"},{"key":"C","text":"What do you did there?"},{"key":"D","text":"What you did there?"}],"answer":"A","explanation":"What did you do …","verify":"\"What did you do there?\""},{"id":"cne_p225_q2","topicId":"cne_p225","difficulty":"basic","type":"choice","prompt":"I rode a bike in the forest park. 我做了什么？","choices":[{"key":"A","text":"骑马"},{"key":"B","text":"钓鱼"},{"key":"C","text":"野营"},{"key":"D","text":"骑自行车"}],"answer":"D","explanation":"rode a bike。","verify":"\"骑自行车\""},{"id":"cne_p225_q3","topicId":"cne_p225","difficulty":"standard","type":"choice","prompt":"哪一句回答「做了什么」？","choices":[{"key":"A","text":"I going fishing."},{"key":"B","text":"I goed fishing."},{"key":"C","text":"I went fishing."},{"key":"D","text":"I go fishing yesterday."}],"answer":"C","explanation":"went fishing。","verify":"\"I went fishing.\""},{"id":"cne_p225_q4","topicId":"cne_p225","difficulty":"standard","type":"choice","prompt":"—What did you do? —I ____ gifts.","choices":[{"key":"A","text":"buying"},{"key":"B","text":"bought"},{"key":"C","text":"buy"},{"key":"D","text":"buys"}],"answer":"B","explanation":"过去式 bought。","verify":"\"bought\""},{"id":"cne_p226_q1","topicId":"cne_p226","difficulty":"basic","type":"choice","prompt":"想问「你怎么去的？」，应选哪一句？","choices":[{"key":"A","text":"How did you go there?"},{"key":"B","text":"How did you went there?"},{"key":"C","text":"How do you went there?"},{"key":"D","text":"How you go there yesterday?"}],"answer":"A","explanation":"How did you go …","verify":"\"How did you go there?\""},{"id":"cne_p226_q2","topicId":"cne_p226","difficulty":"basic","type":"choice","prompt":"We went there by plane. 我们怎么去的？","choices":[{"key":"A","text":"坐火车步行"},{"key":"B","text":"骑自行车"},{"key":"C","text":"没写方式"},{"key":"D","text":"坐飞机"}],"answer":"D","explanation":"by plane。","verify":"\"坐飞机\""},{"id":"cne_p226_q3","topicId":"cne_p226","difficulty":"standard","type":"choice","prompt":"想问「你和谁一起去的？」应选？","choices":[{"key":"A","text":"Who do you go with yesterday?"},{"key":"B","text":"With who you go?"},{"key":"C","text":"Who did you go with?"},{"key":"D","text":"Who did you went with?"}],"answer":"C","explanation":"Who did you go with?","verify":"\"Who did you go with?\""},{"id":"cne_p226_q4","topicId":"cne_p226","difficulty":"standard","type":"choice","prompt":"—Who did you go with? —____.","choices":[{"key":"A","text":"I took pictures"},{"key":"B","text":"My parents"},{"key":"C","text":"By plane"},{"key":"D","text":"It was warm"}],"answer":"B","explanation":"问同伴用人物回答。","verify":"\"My parents\""},{"id":"cne_p227_q1","topicId":"cne_p227","difficulty":"basic","type":"choice","prompt":"对话：—Where did you go over the holiday? —____.","choices":[{"key":"A","text":"I went to Hangzhou."},{"key":"B","text":"I go to Hangzhou."},{"key":"C","text":"I goes to Hangzhou."},{"key":"D","text":"I going to Hangzhou."}],"answer":"A","explanation":"用 went to 回答。","verify":"\"I went to Hangzhou.\""},{"id":"cne_p227_q2","topicId":"cne_p227","difficulty":"basic","type":"choice","prompt":"It was so warm in Sanya. 三亚怎么样？","choices":[{"key":"A","text":"很冷"},{"key":"B","text":"在下雪"},{"key":"C","text":"没有天气信息"},{"key":"D","text":"很暖和"}],"answer":"D","explanation":"so warm。","verify":"\"很暖和\""},{"id":"cne_p227_q3","topicId":"cne_p227","difficulty":"standard","type":"choice","prompt":"哪一组句子能完整谈一次旅行？","choices":[{"key":"A","text":"I going Xinjiang."},{"key":"B","text":"Xinjiang go I."},{"key":"C","text":"I went to Xinjiang. I rode a horse."},{"key":"D","text":"I go to Xinjiang. I ride a horse yesterday."}],"answer":"C","explanation":"过去式 went / rode。","verify":"\"I went to Xinjiang. I rode a horse.\""},{"id":"cne_p227_q4","topicId":"cne_p227","difficulty":"standard","type":"choice","prompt":"—How was your holiday? —____.","choices":[{"key":"A","text":"Yes, I do every day."},{"key":"B","text":"It was good."},{"key":"C","text":"It is tomorrow."},{"key":"D","text":"I am a holiday."}],"answer":"B","explanation":"用 It was … 评价过去假期。","verify":"\"It was good.\""},{"id":"cne_p228_q1","topicId":"cne_p228","difficulty":"basic","type":"choice","prompt":"读一读：Last holiday I went to Sanya with my parents by plane. I went swimming. 我去了哪里？","choices":[{"key":"A","text":"三亚"},{"key":"B","text":"杭州"},{"key":"C","text":"新疆"},{"key":"D","text":"公园"}],"answer":"A","explanation":"went to Sanya。","verify":"\"三亚\""},{"id":"cne_p228_q2","topicId":"cne_p228","difficulty":"basic","type":"choice","prompt":"读一读：We saw lots of grapes in Turpan, but we couldn't eat them. 在吐鲁番看到了什么？","choices":[{"key":"A","text":"很多马"},{"key":"B","text":"很多礼物"},{"key":"C","text":"很多雪"},{"key":"D","text":"很多葡萄"}],"answer":"D","explanation":"lots of grapes。","verify":"\"很多葡萄\""},{"id":"cne_p228_q3","topicId":"cne_p228","difficulty":"standard","type":"choice","prompt":"读一读：John hurt his foot and couldn't come to school. 约翰怎么了？","choices":[{"key":"A","text":"他买了礼物"},{"key":"B","text":"他骑马了"},{"key":"C","text":"脚受伤了"},{"key":"D","text":"他去游泳了"}],"answer":"C","explanation":"hurt his foot。","verify":"\"脚受伤了\""},{"id":"cne_p228_q4","topicId":"cne_p228","difficulty":"standard","type":"choice","prompt":"读一读：I took lots of pictures and bought gifts for my friends. 哪一句一致？","choices":[{"key":"A","text":"我只待在家里。"},{"key":"B","text":"我拍了很多照片，还买了礼物。"},{"key":"C","text":"我什么都没买。"},{"key":"D","text":"我没有拍照。"}],"answer":"B","explanation":"took pictures … bought gifts。","verify":"\"我拍了很多照片，还买了礼物。\""}]
