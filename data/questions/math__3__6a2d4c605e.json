[{"difficulty":"basic","type":"choice","prompt":"长方形的对边怎样？","choices":[{"key":"A","text":"对边相等"},{"key":"B","text":"四条边都不相等"},{"key":"C","text":"没有直角"}],"answer":"A","explanation":"长方形两组对边分别相等。","verify":"'对边相等'","id":"cnm_p077_q1","topicId":"cnm_p077"},{"difficulty":"basic","type":"choice","prompt":"长方形的四个角怎样？","choices":[{"key":"A","text":"都是锐角"},{"key":"B","text":"都是直角"},{"key":"C","text":"只有两个是直角"}],"answer":"B","explanation":"长方形的四个角都是直角。","verify":"'都是直角'","id":"cnm_p077_q2","topicId":"cnm_p077"},{"difficulty":"standard","type":"numeric","prompt":"正方形的一条边长 6 厘米。和它相对的另一条边长多少厘米？","answer":"6","explanation":"正方形四条边都相等，对边也是 6 厘米。","verify":"6","id":"cnm_p077_q3","topicId":"cnm_p077"},{"difficulty":"challenge","type":"numeric","prompt":"长方形长 8 厘米、宽 5 厘米。两条长边一共长多少厘米？","answer":"16","explanation":"长方形对边相等，两条长边都是 8 厘米，8＋8＝16 厘米。","verify":"8+8","id":"cnm_p077_q4","topicId":"cnm_p077"},{"difficulty":"basic","type":"choice","prompt":"周长是什么？","choices":[{"key":"A","text":"图形一周边线的长度"},{"key":"B","text":"图形里面的大小"},{"key":"C","text":"一条边的长度"}],"answer":"A","explanation":"周长是围一圈的长度。","verify":"'图形一周边线的长度'","id":"cnm_p078_q1","topicId":"cnm_p078"},{"difficulty":"basic","type":"numeric","prompt":"长 6 厘米、宽 4 厘米的长方形，周长是多少厘米？","answer":"20","explanation":"（6＋4）×2＝20（厘米）。","verify":"(6+4)*2","id":"cnm_p078_q2","topicId":"cnm_p078"},{"difficulty":"standard","type":"numeric","prompt":"边长 5 厘米的正方形，周长是多少厘米？","answer":"20","explanation":"5×4＝20（厘米）。","verify":"5*4","id":"cnm_p078_q3","topicId":"cnm_p078"},{"difficulty":"challenge","type":"numeric","prompt":"一个长方形周长是 20 厘米，长是 6 厘米。宽是多少厘米？","answer":"4","explanation":"长加宽是 20÷2＝10 厘米，宽是 10－6＝4 厘米。","verify":"20//2-6","id":"cnm_p078_q4","topicId":"cnm_p078"},{"difficulty":"basic","type":"numeric","prompt":"五边形有几条边？","answer":"5","explanation":"几边形就有几条边，五边形有 5 条边。","verify":"5","id":"cnm_p229_q1","topicId":"cnm_p229"},{"difficulty":"basic","type":"numeric","prompt":"六边形有几个角？","answer":"6","explanation":"几边形就有几个角，六边形有 6 个角。","verify":"6","id":"cnm_p229_q2","topicId":"cnm_p229"},{"difficulty":"standard","type":"choice","prompt":"由 4 条线段围成的封闭图形叫什么？","choices":[{"key":"A","text":"四边形"},{"key":"B","text":"三角形"},{"key":"C","text":"五边形"}],"answer":"A","explanation":"4 条边围成的是四边形。","verify":"'四边形'","id":"cnm_p229_q3","topicId":"cnm_p229"},{"difficulty":"challenge","type":"numeric","prompt":"一个多边形有 6 条边。它有几个角？","answer":"6","explanation":"多边形的边数和角数相同，6 条边就有 6 个角。","verify":"6","id":"cnm_p229_q4","topicId":"cnm_p229"},{"difficulty":"basic","type":"choice","prompt":"用几个同样的小正方形拼成一个更大的正方形。下面哪种说法对？","choices":[{"key":"A","text":"拼成后外边一圈的长度是新图形的周长"},{"key":"B","text":"拼完就没有周长了"},{"key":"C","text":"周长一定变短"}],"answer":"A","explanation":"拼成的新图形仍有一周的边线，那就是周长。","verify":"'拼成后外边一圈的长度是新图形的周长'","id":"cnm_p283_q1","topicId":"cnm_p283"},{"difficulty":"basic","type":"numeric","prompt":"用 4 个边长 1 厘米的小正方形拼成一个大正方形。大正方形边长多少厘米？","answer":"2","explanation":"每边 2 个小正方形，边长 2 厘米。","verify":"2","id":"cnm_p283_q2","topicId":"cnm_p283"},{"difficulty":"standard","type":"numeric","prompt":"用 2 个长 3 厘米、宽 2 厘米的长方形拼成一个更大的长方形（长边对齐）。新长方形的长是多少厘米？","answer":"6","explanation":"长边对齐拼，长变成 3＋3＝6 厘米。","verify":"3+3","id":"cnm_p283_q3","topicId":"cnm_p283"},{"difficulty":"challenge","type":"numeric","prompt":"用 4 个边长 2 厘米的小正方形拼成大正方形。大正方形的周长是多少厘米？","answer":"16","explanation":"大正方形边长 4 厘米，周长 4×4＝16 厘米。","verify":"4*4","id":"cnm_p283_q4","topicId":"cnm_p283"}]
