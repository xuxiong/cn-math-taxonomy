[{"id":"cng_j010_q1","topicId":"cng_j010","difficulty":"basic","type":"choice","prompt":"“今天多云，明天有中雨”描述的是？","choices":[{"key":"A","text":"气候"},{"key":"B","text":"地形"},{"key":"C","text":"洋流"},{"key":"D","text":"天气"}],"answer":"D","explanation":"天气是短时间的大气状况，气候是长时间的平均状况。","verify":"\"天气\""},{"id":"cng_j010_q2","topicId":"cng_j010","difficulty":"basic","type":"choice","prompt":"天气预报里，带雨点的云朵符号通常表示？","choices":[{"key":"A","text":"降雨"},{"key":"B","text":"沙尘暴"},{"key":"C","text":"大雾"},{"key":"D","text":"霜冻"}],"answer":"A","explanation":"云加雨点是降雨天气符号。","verify":"\"降雨\""},{"id":"cng_j010_q3","topicId":"cng_j010","difficulty":"standard","type":"choice","prompt":"空气质量指数（AQI）数值越大，通常表示？","choices":[{"key":"A","text":"气温越高"},{"key":"B","text":"空气污染越重"},{"key":"C","text":"风力越大"},{"key":"D","text":"空气越清洁"}],"answer":"B","explanation":"AQI 用来表示空气质量，数值越大污染越重。","verify":"\"空气污染越重\""},{"id":"cng_j010_q4","topicId":"cng_j010","difficulty":"challenge","type":"choice","prompt":"下列叙述属于气候的是？","choices":[{"key":"A","text":"今晚有雷阵雨"},{"key":"B","text":"明天最低气温 8℃"},{"key":"C","text":"昆明四季如春"},{"key":"D","text":"刚才刮起了大风"}],"answer":"C","explanation":"“四季如春”是长期大气状况，属于气候；其余都是短时天气。","verify":"\"昆明四季如春\""},{"id":"cng_j011_q1","topicId":"cng_j011","difficulty":"basic","type":"choice","prompt":"一天中，陆地最高气温通常出现在？","choices":[{"key":"A","text":"午后 2 时左右"},{"key":"B","text":"正午 12 时整"},{"key":"C","text":"日出前后"},{"key":"D","text":"午夜 0 时"}],"answer":"A","explanation":"地面热量积累到午后达到最高，陆地最高气温多在 14 时左右。","verify":"\"午后 2 时左右\""},{"id":"cng_j011_q2","topicId":"cng_j011","difficulty":"basic","type":"choice","prompt":"世界气温分布的基本规律是？","choices":[{"key":"A","text":"由高纬向低纬递减"},{"key":"B","text":"由低纬向高纬递减"},{"key":"C","text":"只随经度变化"},{"key":"D","text":"全球各地完全相同"}],"answer":"B","explanation":"太阳辐射由赤道向两极递减，气温大致由低纬向高纬降低。","verify":"\"由低纬向高纬递减\""},{"id":"cng_j011_q3","topicId":"cng_j011","difficulty":"standard","type":"choice","prompt":"同纬度地区，海拔每升高 1000 米，气温大约？","choices":[{"key":"A","text":"上升 6℃"},{"key":"B","text":"下降 1℃"},{"key":"C","text":"下降 6℃"},{"key":"D","text":"不变"}],"answer":"C","explanation":"对流层气温随海拔升高而降低，大约每千米下降 6℃。","verify":"\"下降 6℃\""},{"id":"cng_j011_q4","topicId":"cng_j011","difficulty":"challenge","type":"choice","prompt":"等温线在北半球陆地 1 月向南凸出，主要说明？","choices":[{"key":"A","text":"同纬度陆地比海洋更热"},{"key":"B","text":"海拔越高气温越高"},{"key":"C","text":"该地一定位于南半球"},{"key":"D","text":"同纬度陆地比海洋更冷"}],"answer":"D","explanation":"1 月是北半球冬季，陆地降温快，同纬度陆地气温低于海洋，等温线向低纬（南）凸出。","verify":"\"同纬度陆地比海洋更冷\""},{"id":"cng_j012_q1","topicId":"cng_j012","difficulty":"basic","type":"choice","prompt":"赤道附近地区年降水量通常？","choices":[{"key":"A","text":"非常稀少"},{"key":"B","text":"很丰富"},{"key":"C","text":"全年为零"},{"key":"D","text":"只在冬季较多"}],"answer":"B","explanation":"赤道地区空气对流旺盛，多对流雨，是世界多雨带。","verify":"\"很丰富\""},{"id":"cng_j012_q2","topicId":"cng_j012","difficulty":"basic","type":"choice","prompt":"副热带地区的大陆西岸和内陆，降水往往？","choices":[{"key":"A","text":"非常丰富"},{"key":"B","text":"全年阴雨"},{"key":"C","text":"较少"},{"key":"D","text":"只在夜间下雨"}],"answer":"C","explanation":"副热带高气压控制下气流下沉，加上大陆内部水汽少，降水稀少。","verify":"\"较少\""},{"id":"cng_j012_q3","topicId":"cng_j012","difficulty":"standard","type":"choice","prompt":"温带海洋性气候的降水特点是？","choices":[{"key":"A","text":"夏季暴雨、冬季滴雨没有"},{"key":"B","text":"全年干旱"},{"key":"C","text":"只有春季下雨"},{"key":"D","text":"全年湿润，各月比较均匀"}],"answer":"D","explanation":"西风常年影响，降水季节分配较均匀。","verify":"\"全年湿润，各月比较均匀\""},{"id":"cng_j012_q4","topicId":"cng_j012","difficulty":"challenge","type":"choice","prompt":"迎风坡降水往往多于背风坡，主要是因为？","choices":[{"key":"A","text":"湿润气流被迫抬升冷却致雨"},{"key":"B","text":"背风坡一定没有河流"},{"key":"C","text":"迎风坡海拔一定更低"},{"key":"D","text":"地球自转在迎风坡停止"}],"answer":"A","explanation":"地形雨：湿润气流沿山坡上升冷却凝结，背风坡气流下沉增温，降水减少。","verify":"\"湿润气流被迫抬升冷却致雨\""},{"id":"cng_j013_q1","topicId":"cng_j013","difficulty":"basic","type":"choice","prompt":"热带雨林气候主要分布在？","choices":[{"key":"A","text":"南北极圈以内"},{"key":"B","text":"青藏高原"},{"key":"C","text":"赤道附近"},{"key":"D","text":"回归线穿过的大陆西岸"}],"answer":"C","explanation":"赤道附近终年高温多雨，形成热带雨林气候。","verify":"\"赤道附近\""},{"id":"cng_j013_q2","topicId":"cng_j013","difficulty":"basic","type":"choice","prompt":"地中海气候的特征是？","choices":[{"key":"A","text":"全年高温多雨"},{"key":"B","text":"冬季严寒漫长"},{"key":"C","text":"全年寒冷干燥"},{"key":"D","text":"夏季炎热干燥，冬季温和多雨"}],"answer":"D","explanation":"地中海气候受副高和西风交替控制，雨热不同期。","verify":"\"夏季炎热干燥，冬季温和多雨\""},{"id":"cng_j013_q3","topicId":"cng_j013","difficulty":"standard","type":"choice","prompt":"亚洲东部季风气候显著，其降水主要集中在？","choices":[{"key":"A","text":"夏季"},{"key":"B","text":"冬季"},{"key":"C","text":"春秋两季平均且极少"},{"key":"D","text":"全年各月都几乎无雨"}],"answer":"A","explanation":"夏季风从海洋带来大量水汽，雨热同期。","verify":"\"夏季\""},{"id":"cng_j013_q4","topicId":"cng_j013","difficulty":"challenge","type":"choice","prompt":"温带海洋性气候主要分布在？","choices":[{"key":"A","text":"赤道两侧"},{"key":"B","text":"南北纬 40°–60°的大陆西岸"},{"key":"C","text":"中亚内陆"},{"key":"D","text":"南极大陆内部"}],"answer":"B","explanation":"这里常年受西风和暖流影响，冬暖夏凉、降水均匀。","verify":"\"南北纬 40°–60°的大陆西岸\""}]
