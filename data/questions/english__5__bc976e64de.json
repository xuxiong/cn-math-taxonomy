[{"id":"cne_p147_q1","topicId":"cne_p147","difficulty":"basic","type":"choice","prompt":"这支钢笔是我的，应选哪一句？","choices":[{"key":"A","text":"The pen is mine."},{"key":"B","text":"The pen is my."},{"key":"C","text":"The pen is me."},{"key":"D","text":"The pen is I."}],"answer":"A","explanation":"名词性物主代词用 mine，不说 is my。","verify":"\"The pen is mine.\""},{"id":"cne_p147_q2","topicId":"cne_p147","difficulty":"basic","type":"choice","prompt":"Whose book is this? It is hers. 书是谁的？","choices":[{"key":"A","text":"他的"},{"key":"B","text":"她的"},{"key":"C","text":"我的"},{"key":"D","text":"你的"}],"answer":"B","explanation":"hers 是她的。","verify":"\"她的\""},{"id":"cne_p147_q3","topicId":"cne_p147","difficulty":"standard","type":"choice","prompt":"The bag is yours. 包是谁的？","choices":[{"key":"A","text":"我的"},{"key":"B","text":"他的"},{"key":"C","text":"你的"},{"key":"D","text":"他们的"}],"answer":"C","explanation":"yours 是你的。","verify":"\"你的\""},{"id":"cne_p147_q4","topicId":"cne_p147","difficulty":"standard","type":"choice","prompt":"哪一句是正确的？","choices":[{"key":"A","text":"The dog is our."},{"key":"B","text":"The dog is we."},{"key":"C","text":"The dog is us."},{"key":"D","text":"The dog is ours."}],"answer":"D","explanation":"我们的用 ours。","verify":"\"The dog is ours.\""},{"id":"cne_p148_q1","topicId":"cne_p148","difficulty":"basic","type":"choice","prompt":"He ____ reading. 横线上应填哪个词？","choices":[{"key":"A","text":"am"},{"key":"B","text":"is"},{"key":"C","text":"are"},{"key":"D","text":"be"}],"answer":"B","explanation":"He 和 is 搭配，后面接 reading。","verify":"\"is\""},{"id":"cne_p148_q2","topicId":"cne_p148","difficulty":"basic","type":"choice","prompt":"哪一句表示「他们正在吃晚饭」？","choices":[{"key":"A","text":"They are eat dinner."},{"key":"B","text":"They eating dinner."},{"key":"C","text":"They are eating dinner."},{"key":"D","text":"They is eating dinner."}],"answer":"C","explanation":"They 用 are，动词用 eating。","verify":"\"They are eating dinner.\""},{"id":"cne_p148_q3","topicId":"cne_p148","difficulty":"standard","type":"choice","prompt":"I am singing. 这句的意思是？","choices":[{"key":"A","text":"我喜欢唱歌"},{"key":"B","text":"我会唱歌"},{"key":"C","text":"我昨天唱歌"},{"key":"D","text":"我正在唱歌"}],"answer":"D","explanation":"am singing 是正在唱歌。","verify":"\"我正在唱歌\""},{"id":"cne_p148_q4","topicId":"cne_p148","difficulty":"standard","type":"choice","prompt":"What is she doing? 这句是在问什么？","choices":[{"key":"A","text":"她正在做什么"},{"key":"B","text":"她是谁"},{"key":"C","text":"她会做什么"},{"key":"D","text":"她喜欢做什么"}],"answer":"A","explanation":"What is she doing 问正在做的事。","verify":"\"她正在做什么\""},{"id":"cne_p149_q1","topicId":"cne_p149","difficulty":"basic","type":"choice","prompt":"问「这是谁的狗」，应说哪一句？","choices":[{"key":"A","text":"Who dog is it?"},{"key":"B","text":"Where dog is it?"},{"key":"C","text":"Whose dog is it?"},{"key":"D","text":"What dog is it?"}],"answer":"C","explanation":"问属于谁用 Whose。","verify":"\"Whose dog is it?\""},{"id":"cne_p149_q2","topicId":"cne_p149","difficulty":"basic","type":"choice","prompt":"Whose book is this? 若是我的，应回答哪一句？","choices":[{"key":"A","text":"It is my."},{"key":"B","text":"It is me."},{"key":"C","text":"It is I."},{"key":"D","text":"It is mine."}],"answer":"D","explanation":"我的用 mine。","verify":"\"It is mine.\""},{"id":"cne_p149_q3","topicId":"cne_p149","difficulty":"standard","type":"choice","prompt":"The dog is his. 狗是谁的？","choices":[{"key":"A","text":"他的"},{"key":"B","text":"她的"},{"key":"C","text":"我的"},{"key":"D","text":"你的"}],"answer":"A","explanation":"his 是他的。","verify":"\"他的\""},{"id":"cne_p149_q4","topicId":"cne_p149","difficulty":"standard","type":"choice","prompt":"They are playing in the park. The picture is ours. 照片是谁的？","choices":[{"key":"A","text":"他们的"},{"key":"B","text":"我们的"},{"key":"C","text":"你的"},{"key":"D","text":"她的"}],"answer":"B","explanation":"ours 是我们的。","verify":"\"我们的\""},{"id":"cne_p150_q1","topicId":"cne_p150","difficulty":"basic","type":"choice","prompt":"读一读：John is eating lunch. Amy is reading a book. John 正在做什么？","choices":[{"key":"A","text":"看书"},{"key":"B","text":"睡觉"},{"key":"C","text":"画画"},{"key":"D","text":"吃午饭"}],"answer":"D","explanation":"John is eating lunch。","verify":"\"吃午饭\""},{"id":"cne_p150_q2","topicId":"cne_p150","difficulty":"basic","type":"choice","prompt":"读一读：Look! The dog is sleeping. 狗正在做什么？","choices":[{"key":"A","text":"睡觉"},{"key":"B","text":"吃东西"},{"key":"C","text":"跑"},{"key":"D","text":"玩"}],"answer":"A","explanation":"is sleeping。","verify":"\"睡觉\""},{"id":"cne_p150_q3","topicId":"cne_p150","difficulty":"standard","type":"choice","prompt":"读一读：Whose picture is it? It is mine. I am drawing. 谁在画画？","choices":[{"key":"A","text":"John"},{"key":"B","text":"我"},{"key":"C","text":"Amy"},{"key":"D","text":"狗"}],"answer":"B","explanation":"I am drawing，而且 picture is mine。","verify":"\"我\""},{"id":"cne_p150_q4","topicId":"cne_p150","difficulty":"standard","type":"choice","prompt":"读一读：They are playing football. 哪一句和短文一致？","choices":[{"key":"A","text":"他们会踢足球。"},{"key":"B","text":"他们昨天踢了足球。"},{"key":"C","text":"他们正在踢足球。"},{"key":"D","text":"他们不喜欢足球。"}],"answer":"C","explanation":"are playing 是正在踢。","verify":"\"他们正在踢足球。\""},{"id":"cne_p268_q1","topicId":"cne_p268","difficulty":"basic","type":"choice","prompt":"run 的现在分词是？","choices":[{"key":"A","text":"running"},{"key":"B","text":"runing"},{"key":"C","text":"runs"},{"key":"D","text":"ran"}],"answer":"A","explanation":"重读闭音节双写 n 再加 ing。","verify":"\"running\""},{"id":"cne_p268_q2","topicId":"cne_p268","difficulty":"basic","type":"choice","prompt":"write 的现在分词是？","choices":[{"key":"A","text":"writeing"},{"key":"B","text":"writting"},{"key":"C","text":"writes"},{"key":"D","text":"writing"}],"answer":"D","explanation":"去 e 加 ing。","verify":"\"writing\""},{"id":"cne_p268_q3","topicId":"cne_p268","difficulty":"standard","type":"choice","prompt":"哪一组正确？","choices":[{"key":"A","text":"swim → swimmings"},{"key":"B","text":"swim → swam"},{"key":"C","text":"swim → swimming"},{"key":"D","text":"swim → swiming"}],"answer":"C","explanation":"双写 m 加 ing。","verify":"\"swim → swimming\""},{"id":"cne_p268_q4","topicId":"cne_p268","difficulty":"challenge","type":"choice","prompt":"读一读：He is ____ (take) pictures. 横线应填？","choices":[{"key":"A","text":"took"},{"key":"B","text":"taking"},{"key":"C","text":"takeing"},{"key":"D","text":"takinge"}],"answer":"B","explanation":"take → taking。","verify":"\"taking\""},{"id":"cne_p269_q1","topicId":"cne_p269","difficulty":"basic","type":"choice","prompt":"想问「它正在做什么？」，应选哪一句？","choices":[{"key":"A","text":"What is it doing?"},{"key":"B","text":"What is it do?"},{"key":"C","text":"What are it doing?"},{"key":"D","text":"What it is doing?"}],"answer":"A","explanation":"What is it doing?","verify":"\"What is it doing?\""},{"id":"cne_p269_q2","topicId":"cne_p269","difficulty":"basic","type":"choice","prompt":"—Whose dog is it? —____. —What's it doing? —It's running.","choices":[{"key":"A","text":"It's my"},{"key":"B","text":"It's me"},{"key":"C","text":"It's I"},{"key":"D","text":"It's mine"}],"answer":"D","explanation":"名词性物主代词 mine。","verify":"\"It's mine\""},{"id":"cne_p269_q3","topicId":"cne_p269","difficulty":"standard","type":"choice","prompt":"哪一组问答正确？","choices":[{"key":"A","text":"Whose cat is it? It's hers. It sleep."},{"key":"B","text":"Who cat is it? It's hers."},{"key":"C","text":"Whose cat is it? It's hers. It's sleeping."},{"key":"D","text":"Whose cat is it? It's her. It sleeping."}],"answer":"C","explanation":"hers + is sleeping。","verify":"\"Whose cat is it? It's hers. It's sleeping.\""},{"id":"cne_p269_q4","topicId":"cne_p269","difficulty":"challenge","type":"choice","prompt":"读一读：The dog is John's. It is eating. Whose dog is eating?","choices":[{"key":"A","text":"无人的狗"},{"key":"B","text":"约翰的狗"},{"key":"C","text":"我的狗"},{"key":"D","text":"她的猫"}],"answer":"B","explanation":"John's dog is eating。","verify":"\"约翰的狗\""}]
