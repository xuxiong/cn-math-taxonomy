[{"id":"cnc_p060_q1","topicId":"cnc_p060","difficulty":"basic","type":"choice","prompt":"谁在半空展翅飞？","choices":[{"key":"A","text":"蚯蚓"},{"key":"B","text":"蜻蜓"},{"key":"C","text":"蚂蚁"},{"key":"D","text":"蝌蚪"}],"answer":"B","explanation":"蜻蜓半空展翅飞。蚯蚓在土里，蚂蚁在地上，蝌蚪在池中。","verify":"\"蜻蜓\""},{"id":"cnc_p060_q2","topicId":"cnc_p060","difficulty":"basic","type":"choice","prompt":"谁在土里造宫殿？","choices":[{"key":"A","text":"蝴蝶"},{"key":"B","text":"蜘蛛"},{"key":"C","text":"蚯蚓"},{"key":"D","text":"蜻蜓"}],"answer":"C","explanation":"蚯蚓土里造宫殿。蝴蝶在花间，蜘蛛在房前结网。","verify":"\"蚯蚓\""},{"id":"cnc_p060_q3","topicId":"cnc_p060","difficulty":"standard","type":"choice","prompt":"蚂蚁在做什么？","choices":[{"key":"A","text":"在花间捉迷藏"},{"key":"B","text":"在房前结网"},{"key":"C","text":"在池中游来游去"},{"key":"D","text":"在地上运食粮"}],"answer":"D","explanation":"蚂蚁地上运食粮。捉迷藏的是蝴蝶，结网的是蜘蛛。","verify":"\"在地上运食粮\""},{"id":"cnc_p060_q4","topicId":"cnc_p060","difficulty":"standard","type":"choice","prompt":"谁在房前结网忙？","choices":[{"key":"A","text":"蜘蛛"},{"key":"B","text":"蝌蚪"},{"key":"C","text":"蝴蝶"},{"key":"D","text":"蚯蚓"}],"answer":"A","explanation":"蜘蛛房前结网忙。蝌蚪在池中游，不在房前结网。","verify":"\"蜘蛛\""},{"id":"cnc_p061_q1","topicId":"cnc_p061","difficulty":"basic","type":"choice","prompt":"「古对今」后面紧接着的是哪一组？","choices":[{"key":"A","text":"严寒对酷暑"},{"key":"B","text":"晨对暮"},{"key":"C","text":"圆对方"},{"key":"D","text":"桃对李"}],"answer":"C","explanation":"课文先写古对今、圆对方，后面才是严寒对酷暑。","verify":"\"圆对方\""},{"id":"cnc_p061_q2","topicId":"cnc_p061","difficulty":"basic","type":"choice","prompt":"「严寒」对的是什么？","choices":[{"key":"A","text":"春暖"},{"key":"B","text":"秋凉"},{"key":"C","text":"细雨"},{"key":"D","text":"酷暑"}],"answer":"D","explanation":"严寒对酷暑。春暖对的是秋凉，和风对的是细雨。","verify":"\"酷暑\""},{"id":"cnc_p061_q3","topicId":"cnc_p061","difficulty":"standard","type":"choice","prompt":"「和风对细雨」后面紧接着的是哪一组？","choices":[{"key":"A","text":"朝霞对夕阳"},{"key":"B","text":"莺歌对燕舞"},{"key":"C","text":"鸟语对花香"},{"key":"D","text":"雪对霜"}],"answer":"A","explanation":"和风对细雨，朝霞对夕阳。莺歌对燕舞在更后面。","verify":"\"朝霞对夕阳\""},{"id":"cnc_p061_q4","topicId":"cnc_p061","difficulty":"standard","type":"choice","prompt":"「莺歌」对的是什么？","choices":[{"key":"A","text":"花香"},{"key":"B","text":"燕舞"},{"key":"C","text":"柳杨"},{"key":"D","text":"鸟语"}],"answer":"B","explanation":"莺歌对燕舞。鸟语对的是花香，不是莺歌。","verify":"\"燕舞\""},{"id":"cnc_p062_q1","topicId":"cnc_p062","difficulty":"basic","type":"choice","prompt":"「打、拔、拍」这三个字都是什么旁？","choices":[{"key":"A","text":"足字旁"},{"key":"B","text":"言字旁"},{"key":"C","text":"三点水"},{"key":"D","text":"提手旁"}],"answer":"D","explanation":"打、拔、拍都和手的动作有关，是提手旁。","verify":"\"提手旁\""},{"id":"cnc_p062_q2","topicId":"cnc_p062","difficulty":"basic","type":"choice","prompt":"「跳、跑、踢」这三个字都是什么旁？","choices":[{"key":"A","text":"足字旁"},{"key":"B","text":"提手旁"},{"key":"C","text":"口字旁"},{"key":"D","text":"木字旁"}],"answer":"A","explanation":"跳、跑、踢都和脚有关，是足字旁。","verify":"\"足字旁\""},{"id":"cnc_p062_q3","topicId":"cnc_p062","difficulty":"standard","type":"choice","prompt":"下面哪一项主要是用脚做的？","choices":[{"key":"A","text":"拍皮球"},{"key":"B","text":"踢足球"},{"key":"C","text":"拔河"},{"key":"D","text":"打球"}],"answer":"B","explanation":"课文把踢足球和跳、跑放在一起。拍、拔、打是提手旁，和手有关。","verify":"\"踢足球\""},{"id":"cnc_p062_q4","topicId":"cnc_p062","difficulty":"standard","type":"choice","prompt":"课文里，打球、跑步这些活动是在哪里进行的？","choices":[{"key":"A","text":"池塘里"},{"key":"B","text":"沙洲坝的井边"},{"key":"C","text":"操场上"},{"key":"D","text":"荷叶上"}],"answer":"C","explanation":"课文题目就是操场上，写的是同学们在操场上活动。","verify":"\"操场上\""},{"id":"cnc_p063_q1","topicId":"cnc_p063","difficulty":"basic","type":"choice","prompt":"「人之初」的下一句是哪一句？","choices":[{"key":"A","text":"性本善"},{"key":"B","text":"习相远"},{"key":"C","text":"非所宜"},{"key":"D","text":"不知义"}],"answer":"A","explanation":"人之初，性本善。性相近、习相远是后面的句子。","verify":"\"性本善\""},{"id":"cnc_p063_q2","topicId":"cnc_p063","difficulty":"basic","type":"choice","prompt":"「性相近」的下一句是哪一句？","choices":[{"key":"A","text":"性本善"},{"key":"B","text":"习相远"},{"key":"C","text":"老何为"},{"key":"D","text":"不成器"}],"answer":"B","explanation":"性相近，习相远。意思是本性相近，习惯会差得很远。","verify":"\"习相远\""},{"id":"cnc_p063_q3","topicId":"cnc_p063","difficulty":"standard","type":"choice","prompt":"「玉不琢」的下一句是哪一句？","choices":[{"key":"A","text":"不知义"},{"key":"B","text":"非所宜"},{"key":"C","text":"不成器"},{"key":"D","text":"性本善"}],"answer":"C","explanation":"玉不琢，不成器。人不学，不知义。不要把这两句接错。","verify":"\"不成器\""},{"id":"cnc_p063_q4","topicId":"cnc_p063","difficulty":"standard","type":"choice","prompt":"「子不学，非所宜」是在说什么？","choices":[{"key":"A","text":"玉石不用雕琢"},{"key":"B","text":"人的本性很远"},{"key":"C","text":"老了才开始学最好"},{"key":"D","text":"小孩子不学习是不应该的"}],"answer":"D","explanation":"子不学，非所宜。幼不学，老何为。都是劝人从小学习。","verify":"\"小孩子不学习是不应该的\""},{"id":"cnc_p064_q1","topicId":"cnc_p064","difficulty":"basic","type":"choice","prompt":"邀请别人一起玩，哪一句最合适？","choices":[{"key":"A","text":"不许你玩"},{"key":"B","text":"我们一起做游戏，好吗"},{"key":"C","text":"你不能问规则"},{"key":"D","text":"游戏"}],"answer":"B","explanation":"先发出邀请，态度客气。只说一个词，别人不知道玩什么。","verify":"\"我们一起做游戏，好吗\""},{"id":"cnc_p064_q2","topicId":"cnc_p064","difficulty":"basic","type":"choice","prompt":"开始玩之前，应该先做什么？","choices":[{"key":"A","text":"不说规则就抢着玩"},{"key":"B","text":"先把别人推开"},{"key":"C","text":"把规则说清楚"},{"key":"D","text":"先宣布只有自己能赢"}],"answer":"C","explanation":"大家要先知道怎样玩，游戏才做得成。","verify":"\"把规则说清楚\""},{"id":"cnc_p064_q3","topicId":"cnc_p064","difficulty":"standard","type":"choice","prompt":"玩的时候，哪一种做法对？","choices":[{"key":"A","text":"别人还没完就去抢"},{"key":"B","text":"输了就哭闹，不让别人继续"},{"key":"C","text":"故意不遵守刚刚说好的规则"},{"key":"D","text":"按说好的规则轮流玩"}],"answer":"D","explanation":"一起玩要守规则、会轮流。抢和哭闹都会让游戏进行不下去。","verify":"\"按说好的规则轮流玩\""},{"id":"cnc_p064_q4","topicId":"cnc_p064","difficulty":"standard","type":"choice","prompt":"下面哪一种不适合一起做游戏？","choices":[{"key":"A","text":"一个人临时改规则，还不许别人说话"},{"key":"B","text":"先讲清怎么玩"},{"key":"C","text":"大家轮流来"},{"key":"D","text":"玩完还可以再邀请别人"}],"answer":"A","explanation":"规则要大家知道，也不能不许别人开口。另外三种都是在好好一起玩。","verify":"\"一个人临时改规则，还不许别人说话\""}]
