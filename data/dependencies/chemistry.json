d","reason":"常见的盐用化学式表示，要先会写化学式。"},{"topicId":"cnk_j043","prerequisiteId":"cnk_j039","strength":"hard","reason":"酸的化学性质实验，检验的是酸与指示剂、金属、金属氧化物等的反应。"},{"topicId":"cnk_j043","prerequisiteId":"cnk_j040","strength":"hard","reason":"碱的化学性质实验，检验的是碱与指示剂、非金属氧化物等的反应。"},{"topicId":"cnk_j043","prerequisiteId":"cnk_j004","strength":"hard","reason":"完成酸、碱性质实验，要先会基本操作。"},{"topicId":"cnk_j044","prerequisiteId":"cnk_j011","strength":"hard","reason":"讨论人体中的元素，要先认识元素。"},{"topicId":"cnk_j045","prerequisiteId":"cnk_j026","strength":"hard","reason":"化学与可持续发展里的能源问题，接在化石能源的合理利用之后。"},{"topicId":"cnk_j045","prerequisiteId":"cnk_j044","strength":"hard","reason":"材料与健康同属化学与社会，可持续发展要连着人体健康来看化学的作用。"}]
